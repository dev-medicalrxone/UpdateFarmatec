        'n administration and is designed to release active and/or inert ' +
        'ingredient(s) at a controlled prolonged rate so as to reduce dos' +
        'ing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
