  object OTC_INVENTORY_CONTROL: TFDQuery
    AfterExecute = OTC_INVENTORY_CONTROLAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[OTC_INVENTORY_CONTROL] @OTCNUMBER INT, @' +
        'DELETE BIT'
      'AS'
      'DECLARE @QTY DECIMAL(18,2)'
      'DECLARE @PRODUCTID INT'
      'DECLARE @NDC CHAR(11)'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9'SELECT @QTY = QTY,  @NDC = NDC, @PRODUCTID = PRODUCT_ID FROM OT' +
        'C WHERE OTCNUMBER = @OTCNUMBER;'
      #9'if @NDC <> '#39'00000000000'#39' '
      #9'begin'
      #9#9'if @DELETE = 1 '
      #9#9'begin'
      #9#9#9'Select @QTY = -abs(@QTY);'
      #9#9'end;'
      
        #9#9'Update InventarioPiso set QTYINVENTARIO = QTYINVENTARIO - @QTY' +
        ' where PRODUCTNO = @PRODUCTID;'
      #9'end'
      #9'else'
      #9'begin'
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT CANTIDADDESPACHADA, PRODUCT' +
        '_ID from OTCMEZCLAS where NUMEROOTC = @OTCNUMBER;'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @QTY,@PRODUCTID'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      #9#9#9'if @DELETE = 1 set @QTY = -abs(@QTY);--@QTY-(@QTY+@QTY);'
      
        #9#9#9'Update InventarioPiso set QTYINVENTARIO = QTYINVENTARIO - @QT' +
        'Y where PRODUCTNO = @PRODUCTID;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9'INTO @QTY,@PRODUCTID'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'
      #9'end;'
      #9'COMMIT'
      'END')
    Left = 4368
    Top = 312
  end
