    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[CLONE_PRODUCT] @PRODUCTNO INTEGER, @BARC' +
        'ODE NCHAR(14),  @PRODUCTID INTEGER OUTPUT'
      'AS'
      'BEGIN'
      '  BEGIN TRANSACTION'
