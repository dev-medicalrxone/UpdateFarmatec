  object RX_ADD_EDIT_RX_BYPHONE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[RX_ADD_EDIT_RX_BYPHONE] (@NORX BIGINT, @' +
        'PHDATE SMALLDATETIME, @PH_TIME VARCHAR(15), @ID_PATIENT INT,'
      
        '@ID_DOCTOR INT, @ID_DRUG INT, @OTAKENBY VARCHAR(30), @OGIVENBY V' +
        'ARCHAR(30), @NOTES VARCHAR(300))'
      'AS'
      'DECLARE @COUNT bigint'
      'BEGIN'
      '   BEGIN TRANSACTION'
      
        '   Select @COUNT = COUNT(*) from Prescriptions_ByPhone where rxn' +
        'um = @norx;'
      '   if @COUNT = 0'
      '   begin'
      '     INSERT INTO [dbo].[Prescriptions_ByPhone]'
      '           ([RXNUM]'
      '           ,[PH_DATE]'
      '           ,[PH_TIME]'
      '           ,[ID_PATIENT]'
      '           ,[ID_DOCTOR]'
      '           ,[ID_DRUG]'
      '           ,[OTAKENBY]'
      '           ,[OGIVENBY]'
      '           ,[NOTES])'
      '     VALUES'
      '           (@NORX'
      '           ,@PHDATE'
      '           ,@PH_TIME'
      '           ,@ID_PATIENT'
      '           ,@ID_DOCTOR'
      '           ,@ID_DRUG'
      '           ,@OTAKENBY'
      '           ,@OGIVENBY'
      '           ,@NOTES)'
      #9'end'
      #9'else'
      #9'begin'
      #9'   UPDATE [dbo].[Prescriptions_ByPhone]'
      #9'   SET [PH_DATE] = @PHDATE'
      #9#9'  ,[PH_TIME] = @PH_TIME'
      #9#9'  ,[ID_PATIENT] = @ID_PATIENT'
      #9#9'  ,[ID_DOCTOR] = @ID_DOCTOR'
      #9#9'  ,[ID_DRUG] = @ID_DRUG'
      #9#9'  ,[OTAKENBY] = @OTAKENBY'
      #9#9'  ,[OGIVENBY] = @OGIVENBY'
      #9#9'  ,[NOTES] = @NOTES'
      #9'  WHERE RXNUM = @NORX;'
      #9'end;'
      #9'COMMIT;'
      'END;')
    Left = 6264
    Top = 984
  end
