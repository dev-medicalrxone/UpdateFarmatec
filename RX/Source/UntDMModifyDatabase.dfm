  object DOCTOR_CREATE_UPDATE: TFDQuery
    AfterExecute = DOCTOR_CREATE_UPDATEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[DOCTOR_CREATE_UPDATE] (@CREATE_UPDATE CH' +
        'AR(1), @NUMERODOCTOR INT, @APELLIDO_MATERNO varchar(15)'
      '      ,@APELLIDO_PATERNO varchar(15)'
      '      ,@NOMBRE varchar(12)'
      '      ,@DIRECCION varchar(30)'
      '      ,@INFOADICIONAL text'
      '      ,@TELEFONO char(13)'
      '      ,@ESPECIALIDAD char(30)'
      '      ,@FAX char(13)'
      '      ,@DESCA varchar(15)'
      '      ,@DEA_FEDERAL varchar(15)'
      '      ,@LICENCIA varchar(15)'
      '      ,@PRESCRIBER_ID_QUALIFIER char(2)'
      '      ,@LOCATION_CODE char(3)'
      '      ,@NPI varchar(15)'
      '      ,@ESTADO nchar(2)'
      '      ,@CODIGO_POSTAL nchar(15)'
      '      ,@DIRECCION2 nchar(20)'
      '      ,@email nchar(80)'
      '      ,@CELULAR nchar(13)'
      '      ,@CITY nchar(20)'
      '      ,@WP_EXTENSION nchar(5)'
      '      ,@SUFFIX_NAME nchar(10)'
      '      ,@PREFIX_NAME nchar(10)'
      '      ,@MIDDLENAME nchar(35)'
      '      ,@PHONEALT1 nchar(25)'
      '      ,@PHONEALT2 nchar(25)'
      '      ,@PHONEALT3 nchar(25)'
      '      ,@PHONEALT4 nchar(25)'
      '      ,@PHONEALT5 nchar(25)'
      '      ,@SPI nchar(13)'
      '      ,@MEDICARE_NUMBER nchar(35)'
      '      ,@MEDICAID_NUMBER nchar(35)'
      '      ,@PPO_NUMBER nchar(35)'
      '      ,@DENTIS_LICENSE_NO nchar(35)'
      '      ,@UPIN nchar(35)'
      '      ,@ClinicName nchar(35)'
      '      ,@ServiceLevel nchar(5)'
      '      ,@ActiveStartTime nchar(22)'
      '      ,@ActiveEndTime nchar(22))'
      'AS'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  begin transaction'
      '  IF @CREATE_UPDATE = '#39'I'#39' '
      '  begin'
      '    INSERT INTO [dbo].[DOCTOR]'
      '           ([APELLIDO_MATERNO]'
      '           ,[APELLIDO_PATERNO]'
      '           ,[NOMBRE]'
      '           ,[DIRECCION]'
      '           ,[INFOADICIONAL]'
      '           ,[TELEFONO]'
      '           ,[ESPECIALIDAD]'
      '           ,[FAX]'
      '           ,[DESCA]'
      '           ,[DEA_FEDERAL]'
      '           ,[LICENCIA]'
      '           ,[PRESCRIBER_ID_QUALIFIER]'
      '           ,[LOCATION_CODE]'
      '           ,[NPI]'
      '           ,[ESTADO]'
      '           ,[CODIGO_POSTAL]'
      '           ,[DIRECCION2]'
      '           ,[email]'
      '           ,[CELULAR]'
      '           ,[CITY]'
      '           ,[WP_EXTENSION]'
      '           ,[SUFFIX_NAME]'
      '           ,[PREFIX_NAME]'
      '           ,[MIDDLENAME]'
      '           ,[PHONEALT1]'
      '           ,[PHONEALT2]'
      '           ,[PHONEALT3]'
      '           ,[PHONEALT4]'
      '           ,[PHONEALT5]'
      '           ,[SPI]'
      '           ,[MEDICARE_NUMBER]'
      '           ,[MEDICAID_NUMBER]'
      '           ,[PPO_NUMBER]'
      '           ,[DENTIS_LICENSE_NO]'
      '           ,[UPIN]'
      '           ,[ClinicName]'
      '           ,[ServiceLevel]'
      '           ,[ActiveStartTime]'
      '           ,[ActiveEndTime])'
      '     VALUES'
      '           (@APELLIDO_MATERNO'
      '           ,@APELLIDO_PATERNO'
      '           ,@NOMBRE'
      '           ,@DIRECCION'
      '           ,@INFOADICIONAL'
      '           ,@TELEFONO'
      '           ,@ESPECIALIDAD'
      '           ,@FAX'
      '           ,@DESCA'
      '           ,@DEA_FEDERAL'
      '           ,@LICENCIA'
      '           ,@PRESCRIBER_ID_QUALIFIER'
      '           ,@LOCATION_CODE'
      '           ,@NPI'
      '           ,@ESTADO'
      '           ,@CODIGO_POSTAL'
      '           ,@DIRECCION2'
      '           ,@email'
      '           ,@CELULAR'
      '           ,@CITY'
      '           ,@WP_EXTENSION'
      '           ,@SUFFIX_NAME'
      '           ,@PREFIX_NAME'
      '           ,@MIDDLENAME'
      '           ,@PHONEALT1'
      '           ,@PHONEALT2'
      '           ,@PHONEALT3'
      '           ,@PHONEALT4'
      '           ,@PHONEALT5'
      '           ,@SPI'
      '           ,@MEDICARE_NUMBER'
      '           ,@MEDICAID_NUMBER'
      '           ,@PPO_NUMBER'
      '           ,@DENTIS_LICENSE_NO'
      '           ,@UPIN'
      '           ,@ClinicName'
      '           ,@ServiceLevel'
      '           ,@ActiveStartTime'
      '           ,@ActiveEndTime)'
      '  end;'
      '  IF @CREATE_UPDATE = '#39'U'#39
      '  begin  '
      '     UPDATE [dbo].[DOCTOR] SET '
      '      --[APELLIDO_MATERNO] = @APELLIDO_MATERNO'
      '      --,[APELLIDO_PATERNO] = @APELLIDO_PATERNO'
      '      --,[NOMBRE] = @NOMBRE'
      '       [DIRECCION] = @DIRECCION'
      '      ,[INFOADICIONAL] = @INFOADICIONAL'
      '      ,[TELEFONO] = @TELEFONO'
      '      ,[ESPECIALIDAD] = @ESPECIALIDAD'
      '      ,[FAX] = @FAX'
      '      ,[DESCA] = @DESCA'
      '      ,[DEA_FEDERAL] = @DEA_FEDERAL'
      '      ,[LICENCIA] = @LICENCIA'
      '      ,[PRESCRIBER_ID_QUALIFIER] = @PRESCRIBER_ID_QUALIFIER'
      '      ,[LOCATION_CODE] = @LOCATION_CODE'
      '      ,[NPI] = @NPI'
      '      ,[ESTADO] = @ESTADO'
      '      ,[CODIGO_POSTAL] = @CODIGO_POSTAL'
      '      ,[DIRECCION2] = @DIRECCION2'
      '      ,[email] = @email'
      '      ,[CELULAR] = @CELULAR'
      '      ,[CITY] = @CITY'
      '      ,[WP_EXTENSION] = @WP_EXTENSION'
      '      ,[SUFFIX_NAME] = @SUFFIX_NAME'
      '      ,[PREFIX_NAME] = @PREFIX_NAME'
      '      ,[MIDDLENAME] = @MIDDLENAME'
      '      ,[PHONEALT1] = @PHONEALT1'
      '      ,[PHONEALT2] = @PHONEALT2'
      '      ,[PHONEALT3] = @PHONEALT3'
      '      ,[PHONEALT4] = @PHONEALT4'
      '      ,[PHONEALT5] = @PHONEALT5'
      '      ,[SPI] = @SPI'
      '      ,[MEDICARE_NUMBER] = @MEDICARE_NUMBER'
      '      ,[MEDICAID_NUMBER] = @MEDICAID_NUMBER'
      '      ,[PPO_NUMBER] = @PPO_NUMBER'
      '      ,[DENTIS_LICENSE_NO] = @DENTIS_LICENSE_NO'
      '      ,[UPIN] = @UPIN'
      '      ,[ClinicName] = @ClinicName'
      '      ,[ServiceLevel] = @ServiceLevel'
      '      ,[ActiveStartTime] = @ActiveStartTime'
      '      ,[ActiveEndTime] = @ActiveEndTime'
      '      WHERE NUMERODOCTOR = @NUMERODOCTOR;'
      '  end;  '
      '  commit;'
      'END;')
    Left = 2880
    Top = 864
  end
  object INSERT_APPRISS: TFDQuery
    AfterExecute = INSERT_APPRISSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE procedure [dbo].[INSERT_APPRISS] @FROM DATE, @TO DATE'
      'AS'
      'BEGIN'
      '  BEGIN TRANSACTION'
      '  DELETE FROM APPRISS;'
      
        '  INSERT INTO APPRISS (OTCNUMBER, NUMERORECETA, PICKED_UP, DRUG,' +
        ' QTY, CONTROLADO, WF_SIGNATURE, NDC, COMPOUND, SENT, VOID) '
      
        '  SELECT OTCNUMBER, NUMERORECETA, PICKED_UP, SUBSTRING(DRUG,1,30' +
        '), QTY, SUBSTRING(CONTROLADO,1,4), SUBSTRING(WF_SIGNATURE,1,30),' +
        '  '
      
        '  SUBSTRING(NDC,1,11), 0, isNull(APPRISS_SENT,0), isnull(APPRISS' +
        '_VOID,0) FROM APPRISS_VIEW WHERE PICKED_UP BETWEEN @FROM AND @TO'
      '  AND NUMERORECETA > 0 AND QTY > 0;'
      ''
      
        '  INSERT INTO APPRISS (OTCNUMBER, NUMERORECETA, PICKED_UP, DRUG,' +
        ' QTY, CONTROLADO, WF_SIGNATURE, NDC, COMPOUND, SENT, VOID) '
      
        '  SELECT distinct OTCNUMBER, NUMERORECETA, PICKED_UP, SUBSTRING(' +
        'DRUG,1,30), QTY, SUBSTRING(CONTROLADO,1,4), SUBSTRING(WF_SIGNATU' +
        'RE,1,30), '
      
        '  SUBSTRING(NDC,1,11), 1, isNull(APPRISS_SENT,0), isnull(APPRISS' +
        '_VOID,0) FROM APPRISS_VIEW_COMPOUNDS WHERE PICKED_UP BETWEEN @FR' +
        'OM AND @TO'
      '  AND NUMERORECETA > 0 AND QTY > 0;'
      '  COMMIT;'
      'END')
    Left = 2880
    Top = 944
  end
  object RX_VIEW_NOT_COMPOUNDS: TFDQuery
    AfterExecute = RX_VIEW_NOT_COMPOUNDSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RX_VIEW_NOT_COMPOUNDS]'
      'AS'
      
        'SELECT        dbo.OTC.OTCNUMBER, dbo.OTC.MEDICAMENTO AS DRUG, db' +
        'o.OTC.NDC, dbo.OTC.WF_SIGNATURE, dbo.OTC.QTY, dbo.OTC.NUMERORECE' +
        'TA, dbo.OTC.CONTROLADO, '
      
        '                         dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_D' +
        'ATE AS PICKED_UP'
      'FROM            dbo.OTC INNER JOIN'
      
        '                         dbo.PRESCRIPTION_ESIGNATURE ON dbo.OTC.' +
        'SIGNATURE_LINK = dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_LINK')
    Left = 2872
    Top = 1016
  end
  object APPRISS_VIEW: TFDQuery
    AfterExecute = APPRISS_VIEWAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[APPRISS_VIEW]'
      'AS'
      
        'SELECT        dbo.OTC.OTCNUMBER, dbo.OTC.NUMERORECETA, dbo.OTC.M' +
        'EDICAMENTO AS DRUG, dbo.OTC.NDC, dbo.OTC.WF_SIGNATURE, dbo.OTC.Q' +
        'TY, dbo.OTC.APPRISS_SENT, '
      
        '                         dbo.OTC.APPRISS_VOID, dbo.PRESCRIPTION_' +
        'ESIGNATURE.SIGNATURE_DATE AS PICKED_UP, '
      
        '                         dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_L' +
        'INK, dbo.INVENTARIOPISO.CONTROLADO'
      'FROM            dbo.OTC INNER JOIN'
      
        '                         dbo.PRESCRIPTION_ESIGNATURE ON dbo.OTC.' +
        'SIGNATURE_LINK = dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_LINK INNE' +
        'R JOIN'
      
        '                         dbo.INVENTARIOPISO ON dbo.OTC.PRODUCT_I' +
        'D = dbo.INVENTARIOPISO.PRODUCTNO'
      
        '                         where .dbo.INVENTARIOPISO.CONTROLADO <>' +
        ' '#39'RX'#39' AND dbo.INVENTARIOPISO.CONTROLADO IS NOT NULL AND'
      
        '                         dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_L' +
        'INK > 0 AND'
      
        '                         LTRIM(dbo.INVENTARIOPISO.CONTROLADO) <>' +
        ' '#39#39' AND dbo.OTC.NDC <> '#39'00000000000'#39)
    Left = 3016
    Top = 944
  end
  object APPRISS_VIEW_COMPOUNDS: TFDQuery
    AfterExecute = APPRISS_VIEW_COMPOUNDSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[APPRISS_VIEW_COMPOUNDS]'
      'AS'
      
        'SELECT        dbo.MEZCLAS.CANTIDADDESPACHADA AS QTY, dbo.MEZCLAS' +
        '.NUMERORECETA,  dbo.INVENTARIOPISO.NDC,   '
      
        '                          dbo.INVENTARIOPISO.DESCRIPCION AS DRUG' +
        ',  '
      
        '                          dbo.INVENTARIOPISO.CONTROLADO, dbo.OTC' +
        '.WF_SIGNATURE, dbo.OTC.OTCNUMBER, dbo.OTC.SIGNATURE_LINK, dbo.OT' +
        'C.APPRISS_SENT,'
      
        #9'          dbo.OTC.APPRISS_VOID, dbo.PRESCRIPTION_ESIGNATURE.SIG' +
        'NATURE_DATE AS PICKED_UP'
      'FROM            dbo.MEZCLAS INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON dbo.MEZCLAS.NDC =' +
        ' dbo.INVENTARIOPISO.NDC INNER JOIN'
      
        '                         dbo.OTC ON dbo.MEZCLAS.OTCNUMBER = dbo.' +
        'OTC.OTCNUMBER INNER JOIN'
      
        '                         dbo.PRESCRIPTION_ESIGNATURE ON dbo.OTC.' +
        'SIGNATURE_LINK = dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_LINK'
      
        '                         where .dbo.INVENTARIOPISO.CONTROLADO <>' +
        ' '#39'RX'#39' AND dbo.INVENTARIOPISO.CONTROLADO IS NOT NULL AND'
      
        '                         dbo.PRESCRIPTION_ESIGNATURE.SIGNATURE_L' +
        'INK > 0 AND'
      
        '                         LTRIM(dbo.INVENTARIOPISO.CONTROLADO) <>' +
        ' '#39#39' AND dbo.OTC.NDC = '#39'00000000000'#39)
    Left = 3024
    Top = 1024
  end
