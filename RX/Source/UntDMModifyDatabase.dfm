        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68944'#39', N'#39'Capsule 24 Hour ' +
        'Sustained Release'#39', N'#39'A capsule designed to release active and/o' +
        'r inert ingredient(s) slowly so as to achieve a constant circula' +
        'ting concentration of the ingredient over a 24 hour time interva' +
        'l.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45414'#39', N'#39'Cement'#39', N'#39'A bas' +
        'e composed of bonding agents intermingled with active and/or ine' +
        'rt ingredient(s) which rapidly hardens into a firm mass upon app' +
        'lication.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42892'#39', N'#39'Chewable Bar'#39', N' +
        #39'A bar designed to be chewed to release active and/or inert ingr' +
        'edient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64876'#39', N'#39'Chewable Capsule' +
        #39', N'#39'A capsule designed to be chewed to release the active and/o' +
        'r inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42893'#39', N'#39'Chewable Tablet'#39 +
        ', N'#39'A tablet that must be chewed to release the active and/or in' +
        'ert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42894'#39', N'#39'Chewing Gum'#39', N'#39 +
        'A semi-solid composed of synthetic polymerized polysaccharide an' +
        'd flavorings intended to be chewed to release active and/or iner' +
        't ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42678'#39', N'#39'Cigarette'#39', N'#39'A ' +
        'solid composed of active and/or inert ingredient(s) wrapped in a' +
        ' paper cylinder whereby one end is burned. The ingredient is rel' +
        'eased in a smoke form which is inhaled.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60884'#39', N'#39'Cloth'#39', N'#39'A soli' +
        'd composed active and/or inert ingredient(s) in a woven absorben' +
