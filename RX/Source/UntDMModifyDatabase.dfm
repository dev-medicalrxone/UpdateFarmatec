  object INSERT_MEZLCA: TFDQuery
    AfterExecute = INSERT_MEZLCAAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_MEZLCA]'
      '    @MEDICAMENTO NCHAR(30),'
      '    @PRECIOVENTA FLOAT,'
      '    @AWP FLOAT,'
      '    @COSTO FLOAT,'
      '    @PRODUCT_ID_QUALIFIER CHAR(2),'
      '    @ING_BASIS_OFCOST_DET CHAR(2),'
      '    @NDC CHAR(11),'
      '    @PRODUCT_ID INT,'
      '    @NUMERORECETA BIGINT,'
      '    @FECHA_MEZCLA NCHAR(11),'
      '    @CANTIDADRECETADA FLOAT,'
      '    @CANTIDADDESPACHADA FLOAT,'
      '    @NO_TRANS INT,'
      '    @COMPDOSAGE_FORM_DESC_CODE NCHAR(2),'
      '    @COMPDISP_UNIT_FORM_INDI NCHAR(1),'
      '    @COMPROUTE_OF_ADMINISTRATION NCHAR(11),'
      '    @OTCNUMBER INT,'
      '    @COMPING_COMP_COUNT INT,'
      '    @FECHA_EXPIRACION CHAR(10),'
      '    @LOTE CHAR(12),'
      '    @TCosto FLOAT OUTPUT,'
      '    @TPrecioVenta FLOAT OUTPUT,'
      '    @TAWP FLOAT OUTPUT,'
      '    @TQTY FLOAT OUTPUT,'
      '    @TRx INTEGER OUTPUT,'
      '    @MEZCLASNO INT,'
      '    @TRecetado FLOAT OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      '        IF EXISTS ('
      '            SELECT 1'
      '            FROM dbo.MEZCLAS'
      '            WHERE MEZCLASNO = @MEZCLASNO'
      '              AND OTCNUMBER = @OTCNUMBER'
      '        )'
      '        BEGIN'
      '            UPDATE dbo.MEZCLAS'
      '            SET MEDICAMENTO = @MEDICAMENTO,'
      '                METRICQUANTITY = @CANTIDADDESPACHADA * 1000,'
      '                PRECIOVENTA = @PRECIOVENTA,'
      '                AWP = @AWP,'
      '                COSTO = @COSTO,'
      '                PRODUCT_ID_QUALIFIER = @PRODUCT_ID_QUALIFIER,'
      '                ING_BASIS_OFCOST_DET = @ING_BASIS_OFCOST_DET,'
      '                NDC = @NDC,'
      '                PRODUCT_ID = @PRODUCT_ID,'
      '                NO_TRANS = @NO_TRANS,'
      '                NUMERORECETA = @NUMERORECETA,'
      '                FECHA_MEZCLA = @FECHA_MEZCLA,'
      '                CANTIDADRECETADA = @CANTIDADRECETADA,'
      '                CANTIDADDESPACHADA = @CANTIDADDESPACHADA,'
      '                LOTE = @LOTE,'
      '                FECHA_EXPIRACION = @FECHA_EXPIRACION,'
      '                OTCNUMBER = @OTCNUMBER'
      '            WHERE MEZCLASNO = @MEZCLASNO'
      '              AND OTCNUMBER = @OTCNUMBER;'
      '        END'
      '        ELSE'
      '        BEGIN'
      '            INSERT INTO dbo.MEZCLAS'
      '            ('
      '                MEDICAMENTO,'
      '                METRICQUANTITY,'
      '                PRECIOVENTA,'
      '                AWP,'
      '                COSTO,'
      '                PRODUCT_ID_QUALIFIER,'
      '                ING_BASIS_OFCOST_DET,'
      '                NDC,'
      '                PRODUCT_ID,'
      '                NO_TRANS,'
      '                NUMERORECETA,'
      '                FECHA_MEZCLA,'
      '                CANTIDADRECETADA,'
      '                CANTIDADDESPACHADA,'
      '                OTCNUMBER,'
      '                LOTE,'
      '                FECHA_EXPIRACION'
      '            )'
      '            VALUES'
      '            ('
      '                @MEDICAMENTO,'
      '                @CANTIDADDESPACHADA * 1000,'
      '                @PRECIOVENTA,'
      '                @AWP,'
      '                @COSTO,'
      '                @PRODUCT_ID_QUALIFIER,'
      '                @ING_BASIS_OFCOST_DET,'
      '                @NDC,'
      '                @PRODUCT_ID,'
      '                @NO_TRANS,'
      '                @NUMERORECETA,'
      '                @FECHA_MEZCLA,'
      '                @CANTIDADRECETADA,'
      '                @CANTIDADDESPACHADA,'
      '                @OTCNUMBER,'
      '                @LOTE,'
      '                @FECHA_EXPIRACION'
      '            );'
      ''
      '            SET @MEZCLASNO = SCOPE_IDENTITY();'
      '        END;'
      ''
      '        SELECT'
      '            @TQTY = ISNULL(SUM(CANTIDADDESPACHADA), 0),'
      '            @TCosto = ISNULL(SUM(COSTO), 0),'
      '            @TPrecioVenta = ISNULL(SUM(PRECIOVENTA), 0),'
      '            @TRx = COUNT(*),'
      '            @TRecetado = ISNULL(SUM(CANTIDADRECETADA), 0),'
      '            @TAWP = ISNULL(SUM(AWP), 0)'
      '        FROM dbo.MEZCLAS'
      '        WHERE OTCNUMBER = @OTCNUMBER;'
      ''
      '        UPDATE dbo.OTC'
      
        '        SET COMPDOSAGE_FORM_DESC_CODE = @COMPDOSAGE_FORM_DESC_CO' +
        'DE,'
      '            COMPDISP_UNIT_FORM_INDI = @COMPDISP_UNIT_FORM_INDI,'
      '            ROUTEOFADMIN_995_E2 = @COMPROUTE_OF_ADMINISTRATION,'
      '            QTY = @TQTY,'
      '            COSTOVENTA = @TCosto,'
      '            TOTAL = @TPrecioVenta,'
      '            PRECIOFACTURACION = @TAWP,'
      '            COMPING_COMP_COUNT = @TRx'
      '        WHERE OTCNUMBER = @OTCNUMBER;'
      ''
      '        UPDATE dbo.PRESCRIPTIONS'
      '        SET CANTIDADRECETADA = @TRecetado'
      '        WHERE NUMERORECETA = @NUMERORECETA;'
      ''
      '        COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        THROW;'
      '    END CATCH;'
      'END')
    Left = 2688
    Top = 448
  end
