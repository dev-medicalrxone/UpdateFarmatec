        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91227'#39', N'#39'Auto-Injector'#39', ' +
        'N'#39'Active and/or inert ingredient(s) in a device that is automate' +
