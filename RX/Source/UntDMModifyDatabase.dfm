  object UPDATE_OTC_RXPAID2: TFDQuery
    AfterExecute = UPDATE_OTC_RXPAID2AfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_OTC_RXPAID2] @GUID VARCHAR(36)'
      'AS'
      'DECLARE @OTCNUMBER INT;'
      'BEGIN  '
      #9'SET NOCOUNT ON;'
      #9'-- HARD STOP: do not run if GUID is NULL or blank'
      #9'IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9'BEGIN'
      
        #9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or b' +
        'lank.'#39', 16, 1);'
      #9#9'RETURN;'
      #9'END;'
      #9'if RTRIM(@GUID) > '#39#39
      #9'begin'
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT OTCNUMBER FROM OTC WHERE GU' +
        'ID = @GUID and CLAIM_STATUS = 1 order by NumeroReceta;'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @OTCNUMBER '
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN  '#9' '#9#9
      
        #9#9#9'UPDATE OTC SET GUID = '#39#39', RECORD_LOCKED = 0, INSTANCIA = 0 WH' +
        'ERE OTCNUMBER = @OTCNUMBER;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9'INTO @OTCNUMBER'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'
      #9'end;'
      'END;')
    Left = 1632
    Top = 64
  end
  object SysColumns: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'SELECT '
      '    c.name '#39'Column Name'#39','
      '    t.Name '#39'Data type'#39','
      '    c.max_length '#39'Max Length'#39','
      '    c.precision ,'
      '    c.scale ,'
      '    c.is_nullable,'
      '    ISNULL(i.is_primary_key, 0) '#39'Primary Key'#39
      'FROM    '
      '    sys.columns c'
      'INNER JOIN '
      '    sys.types t ON c.user_type_id = t.user_type_id'
      'LEFT OUTER JOIN '
      
        '    sys.index_columns ic ON ic.object_id = c.object_id AND ic.co' +
        'lumn_id = c.column_id'
      'LEFT OUTER JOIN '
      
        '    sys.indexes i ON ic.object_id = i.object_id AND ic.index_id ' +
        '= i.index_id'
      'WHERE'
      '    c.object_id = OBJECT_ID('#39'Passwords'#39')')
    Left = 5192
    Top = 304
  end
