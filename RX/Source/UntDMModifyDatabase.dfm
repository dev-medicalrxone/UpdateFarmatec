  object Processor_Master: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      '/* ============================================================'
      '   DROP TABLE IF EXISTS'
      '============================================================ */'
      ''
      'IF OBJECT_ID('#39'dbo.Processor_Master'#39', '#39'U'#39') IS NOT NULL'
      '    DROP TABLE dbo.Processor_Master;'
      ';'
      ''
      ''
      '/* ============================================================'
      '   CREATE TABLE'
      '============================================================ */'
      ''
      'CREATE TABLE dbo.Processor_Master'
      '('
      '    ProcessorMasterID INT IDENTITY(1,1) PRIMARY KEY,'
      ''
      '    Processor            VARCHAR(100) NOT NULL,'
      '    BIN                  VARCHAR(50)  NOT NULL,'
      '    PCN                  VARCHAR(100) NOT NULL,'
      ''
      '    SoftwareVendorID     VARCHAR(50) NULL,'
      '    [Version]            VARCHAR(20) NULL,'
      ''
      '    IsActive             BIT NOT NULL DEFAULT(1),'
      ''
      '    CreatedOn            DATETIME NOT NULL DEFAULT(GETDATE()),'
      '    UpdatedOn            DATETIME NULL'
      ');'
      ';'
      ''
      ''
      '/* ============================================================'
      '   UNIQUE KEY'
      '============================================================ */'
      ''
      'ALTER TABLE dbo.Processor_Master'
      'ADD CONSTRAINT UQ_ProcessorMaster UNIQUE'
      '('
      '    Processor,'
      '    BIN,'
      '    PCN'
      ');'
      ';'
      ''
      ''
      '/* ============================================================'
      '   LOAD DATA'
      '============================================================ */'
      ''
      'TRUNCATE TABLE dbo.Processor_Master;'
      ';'
      ''
      'INSERT INTO dbo.Processor_Master'
      '('
      '    Processor,'
      '    BIN,'
      '    PCN,'
      '    SoftwareVendorID,'
      '    [Version]'
      ')'
      'SELECT'
      '    UPPER(LTRIM(RTRIM(a.PROCESSOR))) AS Processor,'
      '    UPPER(LTRIM(RTRIM(a.BIN))) AS BIN,'
      '    UPPER(LTRIM(RTRIM(a.PCN))) AS PCN,'
      
        '    MAX(UPPER(LTRIM(RTRIM(ISNULL(b.SOFTWARE_VENDOR_ID, '#39'522073'#39')' +
        ')))) AS SoftwareVendorID,'
      
        '    MAX(ISNULL(NULLIF(LTRIM(RTRIM(a.[Version])), '#39#39'), '#39'D0'#39')) AS ' +
        '[Version]'
      'FROM dbo.Insurance_Master a'
      'LEFT JOIN dbo.PLANESMEDICOS b'
      
        '    ON UPPER(LTRIM(RTRIM(a.BIN))) = UPPER(LTRIM(RTRIM(b.BINNUMBE' +
        'R)))'
      
        '   AND UPPER(LTRIM(RTRIM(a.PCN))) = UPPER(LTRIM(RTRIM(b.PROCESSO' +
        'RCONTROL)))'
      'WHERE ISNULL(LTRIM(RTRIM(a.PROCESSOR)), '#39#39') <> '#39#39
      '  AND ISNULL(LTRIM(RTRIM(a.BIN)), '#39#39') <> '#39#39
      '  AND ISNULL(LTRIM(RTRIM(a.PCN)), '#39#39') <> '#39#39
      'GROUP BY'
      '    UPPER(LTRIM(RTRIM(a.PROCESSOR))),'
      '    UPPER(LTRIM(RTRIM(a.BIN))),'
      '    UPPER(LTRIM(RTRIM(a.PCN)));'
      ';'
      ''
      '/* ============================================================'
      '   REMOVE DUPLICATES (safety)'
      '============================================================ */'
      ''
      'WITH CTE AS'
      '('
      '    SELECT *,'
      '           ROW_NUMBER() OVER'
      '           ('
      '             PARTITION BY Processor, BIN, PCN'
      '             ORDER BY ProcessorMasterID'
      '           ) RN'
      '    FROM dbo.Processor_Master'
      ')'
      'DELETE FROM CTE'
      'WHERE RN > 1;'
      ';'
      ''
      ''
      '/* ============================================================'
      '   UPDATE BLANK VENDOR IDs'
      '============================================================ */'
      ''
      'UPDATE dbo.Processor_Master'
      'SET SoftwareVendorID = '#39'522073'#39
      'WHERE ISNULL(SoftwareVendorID,'#39#39') = '#39#39';'
      ';'
      ''
      ''
      '/* ============================================================'
      '   INDEXES'
      '============================================================ */'
      ''
      'CREATE INDEX IX_ProcessorMaster_BIN_PCN'
      'ON dbo.Processor_Master(BIN, PCN);'
      ';'
      ''
      'CREATE INDEX IX_ProcessorMaster_Processor'
      'ON dbo.Processor_Master(Processor);'
      ';'
      ''
      ''
      '/* ============================================================'
      '   VALIDATION'
      '============================================================ */'
      ''
      'SELECT COUNT(*) AS TotalRows'
      'FROM dbo.Processor_Master;'
      ';'
      ''
      'SELECT Processor, BIN, PCN, COUNT(*) AS Cnt'
      'FROM dbo.Processor_Master'
      'GROUP BY Processor, BIN, PCN'
      'HAVING COUNT(*) > 1;'
      ''
      'SELECT  *'
      'FROM dbo.Processor_Master'
      'ORDER BY Processor, BIN, PCN;'
      ';'
      '')
    Left = 7728
    Top = 1408
  end
  object PLANESMEDICOSupdatefromInsurance_Master: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      '/* ============================================================'
      '   PLANESMEDICOS update from Insurance_Master'
      ''
      '   Preserve old local values:'
      '     Processor     = old SOFTWARE_VENDOR_ID'
      '     ProcessorCode = old ABREVIATURA'
      ''
      '   Update active fields:'
      '     SOFTWARE_VENDOR_ID = Insurance_Master.Processor'
      '     ABREVIATURA        = Insurance_Master.ProcessorCode'
      '     [Group]            = Insurance_Master.[Group]'
      '     Network            = Insurance_Master.Network'
      '============================================================ */'
      ''
      'BEGIN TRAN;'
      ''
      '-- 1) Increase column size to avoid truncation'
      
        'IF COL_LENGTH('#39'dbo.PLANESMEDICOS'#39', '#39'SOFTWARE_VENDOR_ID'#39') IS NOT ' +
        'NULL'
      'BEGIN'
      '    ALTER TABLE dbo.PLANESMEDICOS'
      '    ALTER COLUMN SOFTWARE_VENDOR_ID VARCHAR(50) NULL;'
      'END;'
      ''
      '-- 2) Add new columns if missing'
      'IF COL_LENGTH('#39'dbo.PLANESMEDICOS'#39', '#39'Processor'#39') IS NULL'
      
        '    ALTER TABLE dbo.PLANESMEDICOS ADD Processor VARCHAR(150) NUL' +
        'L;'
      ''
      'IF COL_LENGTH('#39'dbo.PLANESMEDICOS'#39', '#39'ProcessorCode'#39') IS NULL'
      
        '    ALTER TABLE dbo.PLANESMEDICOS ADD ProcessorCode VARCHAR(100)' +
        ' NULL;'
      ''
      'IF COL_LENGTH('#39'dbo.PLANESMEDICOS'#39', '#39'Group'#39') IS NULL'
      '    ALTER TABLE dbo.PLANESMEDICOS ADD [Group] VARCHAR(100) NULL;'
      ''
      'IF COL_LENGTH('#39'dbo.PLANESMEDICOS'#39', '#39'Network'#39') IS NULL'
      '    ALTER TABLE dbo.PLANESMEDICOS ADD Network VARCHAR(100) NULL;'
      ''
      '-- 3) Preserve old local values BEFORE updating active fields'
      '--    Processor / ProcessorCode are review/audit fields only.'
      'UPDATE dbo.PLANESMEDICOS'
      'SET'
      
        '    Processor     = LEFT(NULLIF(LTRIM(RTRIM(SOFTWARE_VENDOR_ID))' +
        ', '#39#39'), 150),'
      
        '    ProcessorCode = LEFT(NULLIF(LTRIM(RTRIM(ABREVIATURA)), '#39#39'), ' +
        '100);'
      ''
      '-- 4) Update active/local routing values from Insurance_Master'
      '--    Match condition: exact normalized BIN + PCN'
      ';WITH MasterOne AS'
      '('
      '    SELECT'
      '        UPPER(LTRIM(RTRIM(ISNULL(BIN, '#39#39')))) AS BIN_NORM,'
      '        UPPER(LTRIM(RTRIM(ISNULL(PCN, '#39#39')))) AS PCN_NORM,'
      '        Processor,'
      '        ProcessorCode,'
      '        [Group],'
      '        Network,'
      '        [Description],'
      '        ROW_NUMBER() OVER'
      '        ('
      '            PARTITION BY'
      '                UPPER(LTRIM(RTRIM(ISNULL(BIN, '#39#39')))),'
      '                UPPER(LTRIM(RTRIM(ISNULL(PCN, '#39#39'))))'
      '            ORDER BY'
      '                Processor,'
      '                ProcessorCode,'
      '                [Description]'
      '        ) AS RN'
      '    FROM dbo.Insurance_Master'
      '    WHERE ISNULL(LTRIM(RTRIM(BIN)), '#39#39') <> '#39#39
      '      AND ISNULL(LTRIM(RTRIM(PCN)), '#39#39') <> '#39#39
      ')'
      'UPDATE P'
      'SET'
      
        '    P.SOFTWARE_VENDOR_ID = LEFT(NULLIF(LTRIM(RTRIM(M.Processor))' +
        ', '#39#39'), 50),'
      
        '    P.ABREVIATURA        = LEFT(NULLIF(LTRIM(RTRIM(M.ProcessorCo' +
        'de)), '#39#39'), 3),'
      
        '    P.[Group]            = LEFT(NULLIF(LTRIM(RTRIM(M.[Group])), ' +
        #39#39'), 100),'
      
        '    P.Network            = LEFT(NULLIF(LTRIM(RTRIM(M.Network)), ' +
        #39#39'), 100)'
      'FROM dbo.PLANESMEDICOS P'
      'JOIN MasterOne M'
      '    ON M.BIN_NORM = UPPER(LTRIM(RTRIM(ISNULL(P.BINNUMBER, '#39#39'))))'
      
        '   AND M.PCN_NORM = UPPER(LTRIM(RTRIM(ISNULL(P.PROCESSORCONTROL,' +
        ' '#39#39'))))'
      '   AND M.RN = 1;'
      ''
      'SELECT @@ROWCOUNT AS UpdatedRows;'
      '-- 263 rows'
      ''
      '-- 5) Verify updated count'
      'SELECT'
      '    COUNT(*) AS TotalRows,'
      
        '    SUM(CASE WHEN [Group] IS NOT NULL THEN 1 ELSE 0 END) AS Grou' +
        'pUpdatedRows,'
      
        '    SUM(CASE WHEN Network IS NOT NULL THEN 1 ELSE 0 END) AS Netw' +
        'orkUpdatedRows,'
      
        '    SUM(CASE WHEN Processor IS NOT NULL THEN 1 ELSE 0 END) AS Ol' +
        'dProcessorPreservedRows,'
      
        '    SUM(CASE WHEN ProcessorCode IS NOT NULL THEN 1 ELSE 0 END) A' +
        'S OldProcessorCodePreservedRows'
      'FROM dbo.PLANESMEDICOS;'
      ''
      '-- 6) Review updated rows'
      'SELECT TOP 5000'
      '    PLANESMEDICOSNO,'
      '    BINNUMBER,'
      '    PROCESSORCONTROL,'
      '    SOFTWARE_VENDOR_ID,'
      '    Processor AS Old_SOFTWARE_VENDOR_ID,'
      '    ABREVIATURA,'
      '    ProcessorCode AS Old_ABREVIATURA,'
      '    [Group],'
      '    Network,'
      '    NOMBRE'
      'FROM dbo.PLANESMEDICOS'
      'WHERE [Group] IS NOT NULL'
      '   OR Network IS NOT NULL'
      
        'ORDER BY SOFTWARE_VENDOR_ID, BINNUMBER, PROCESSORCONTROL, NOMBRE' +
        ';'
      ''
      '-- 7) Matched count based on exact BIN + PCN'
      'SELECT COUNT(*) AS MatchedRows'
      'FROM dbo.PLANESMEDICOS P'
      'WHERE EXISTS'
      '('
      '    SELECT 1'
      '    FROM dbo.Insurance_Master M'
      '    WHERE UPPER(LTRIM(RTRIM(ISNULL(M.BIN, '#39#39')))) ='
      '          UPPER(LTRIM(RTRIM(ISNULL(P.BINNUMBER, '#39#39'))))'
      '      AND UPPER(LTRIM(RTRIM(ISNULL(M.PCN, '#39#39')))) ='
      '          UPPER(LTRIM(RTRIM(ISNULL(P.PROCESSORCONTROL, '#39#39'))))'
      ');'
      ''
      
        '-- 8) Review unmatched rows: no exact BIN + PCN match in Insuran' +
        'ce_Master'
      'SELECT'
      '    P.PLANESMEDICOSNO,'
      '    P.BINNUMBER,'
      '    P.PROCESSORCONTROL,'
      '    P.SOFTWARE_VENDOR_ID,'
      '    P.ABREVIATURA,'
      '    P.NOMBRE'
      'FROM dbo.PLANESMEDICOS P'
      'WHERE NOT EXISTS'
      '('
      '    SELECT 1'
      '    FROM dbo.Insurance_Master M'
      '    WHERE UPPER(LTRIM(RTRIM(ISNULL(M.BIN, '#39#39')))) ='
      '          UPPER(LTRIM(RTRIM(ISNULL(P.BINNUMBER, '#39#39'))))'
      '      AND UPPER(LTRIM(RTRIM(ISNULL(M.PCN, '#39#39')))) ='
      '          UPPER(LTRIM(RTRIM(ISNULL(P.PROCESSORCONTROL, '#39#39'))))'
      ')'
      'ORDER BY'
      '    P.BINNUMBER,'
      '    P.PROCESSORCONTROL,'
      '    P.NOMBRE;'
      ''
      'SELECT  * '
      'FROM dbo.Insurance_Master'
      'WHERE'#9#9'BIN = '#39'003585'#39' '
      #9#9'--AND PCN = '#39'24002'#39
      'ORDER BY PCN'
      ''
      '-- 9) Review old vs new values for updated rows'
      'SELECT'
      '    UPPER(ISNULL(BINNUMBER, '#39#39')) AS BIN,'
      '    UPPER(ISNULL(PROCESSORCONTROL, '#39#39')) AS PCN,'
      '    ISNULL(SOFTWARE_VENDOR_ID, '#39#39') AS SOFTWARE_VENDOR_ID,'
      '    Processor AS SOFTWARE_VENDOR_ID_OLD,'
      '    UPPER(ISNULL(ABREVIATURA, '#39#39')) AS ABREVIATURA,'
      '    ProcessorCode AS ABREVIATURA_OLD,'
      '    [Group],'
      '    Network,'
      '    NOMBRE'
      'FROM dbo.PLANESMEDICOS'
      'WHERE [Group] IS NOT NULL'
      '   OR Network IS NOT NULL'
      'ORDER BY SOFTWARE_VENDOR_ID, BINNUMBER, PROCESSORCONTROL;'
      ''
      '-- 10) Cross-check with Insurance_Master'
      'SELECT DISTINCT'
      '    ISNULL(a.PROCESSOR, '#39#39') AS MASTER_PROCESSOR,'
      
        '    ISNULL(b.SOFTWARE_VENDOR_ID, '#39#39') AS LOCAL_SOFTWARE_VENDOR_ID' +
        ','
      '    b.Processor AS OLD_SOFTWARE_VENDOR_ID,'
      '    UPPER(ISNULL(a.BIN, '#39#39')) AS MASTER_BIN,'
      '    UPPER(ISNULL(b.BINNUMBER, '#39#39')) AS LOCAL_BIN,'
      '    UPPER(ISNULL(a.PCN, '#39#39')) AS MASTER_PCN,'
      '    UPPER(ISNULL(b.PROCESSORCONTROL, '#39#39')) AS LOCAL_PCN,'
      '    UPPER(ISNULL(a.ProcessorCode, '#39#39')) AS MASTER_ABR,'
      '    UPPER(ISNULL(b.ABREVIATURA, '#39#39')) AS LOCAL_ABR,'
      '    b.ProcessorCode AS OLD_ABREVIATURA,'
      '    a.[Group] AS MASTER_GROUP,'
      '    b.[Group] AS LOCAL_GROUP,'
      '    a.Network AS MASTER_NETWORK,'
      '    b.Network AS LOCAL_NETWORK--,'
      '    --b.NOMBRE AS LocalInsuranceDescription,'
      '    --a.[Description] AS MasterInsuranceDescription'
      'FROM dbo.Insurance_Master a'
      'JOIN dbo.PLANESMEDICOS b'
      '    ON UPPER(LTRIM(RTRIM(ISNULL(a.BIN, '#39#39')))) ='
      '       UPPER(LTRIM(RTRIM(ISNULL(b.BINNUMBER, '#39#39'))))'
      '   AND UPPER(LTRIM(RTRIM(ISNULL(a.PCN, '#39#39')))) ='
      '       UPPER(LTRIM(RTRIM(ISNULL(b.PROCESSORCONTROL, '#39#39'))))'
      'ORDER BY'
      '    MASTER_PROCESSOR,'
      '    MASTER_BIN,'
      '    MASTER_PCN;'
      ''
      ';WITH MasterOne AS'
      '('
      '    SELECT'
      '        *,'
      '        ROW_NUMBER() OVER'
      '        ('
      '            PARTITION BY'
      '                UPPER(LTRIM(RTRIM(ISNULL(BIN, '#39#39')))),'
      '                UPPER(LTRIM(RTRIM(ISNULL(PCN, '#39#39'))))'
      '            ORDER BY Processor, ProcessorCode, [Description]'
      '        ) AS RN'
      '    FROM dbo.Insurance_Master'
      ')'
      'SELECT'
      '    M.BIN AS MASTER_BIN,'
      '    P.BINNUMBER AS LOCAL_BIN,'
      '    M.PCN AS MASTER_PCN,'
      '    P.PROCESSORCONTROL AS LOCAL_PCN,'
      #9'M.Processor AS MASTER_PROCESSOR,'
      '    P.SOFTWARE_VENDOR_ID AS LOCAL_SOFTWARE_VENDOR_ID,'
      #9'P.Processor AS LOCAL_SOFTWARE_VENDOR_ID_OLD,'
      '    M.ProcessorCode AS MASTER_ABR,'
      '    P.ABREVIATURA AS LOCAL_ABR,'
      #9'P.ProcessorCode AS LOCAL_ABR_OLD,'
      '    M.[Group] AS MASTER_GROUP,'
      '    P.[Group] AS LOCAL_GROUP,'
      '    M.Network AS MASTER_NETWORK,'
      '    P.Network AS LOCAL_NETWORK,'
      '    P.NOMBRE'
      'FROM dbo.PLANESMEDICOS P'
      'JOIN MasterOne M'
      '    ON UPPER(LTRIM(RTRIM(ISNULL(M.BIN, '#39#39')))) ='
      '       UPPER(LTRIM(RTRIM(ISNULL(P.BINNUMBER, '#39#39'))))'
      '   AND UPPER(LTRIM(RTRIM(ISNULL(M.PCN, '#39#39')))) ='
      '       UPPER(LTRIM(RTRIM(ISNULL(P.PROCESSORCONTROL, '#39#39'))))'
      '   AND M.RN = 1'
      'ORDER BY M.Processor, M.BIN, M.PCN;'
      ''
      'SELECT'
      '    BIN,'
      '    PCN,'
      '    COUNT(*) AS MasterRows,'
      '    COUNT(DISTINCT [Group]) AS DistinctGroups'
      'FROM dbo.Insurance_Master'
      'GROUP BY BIN, PCN'
      'HAVING COUNT(DISTINCT [Group]) > 1'
      'ORDER BY BIN, PCN;'
      ''
      '-- If verification is correct:'
      '-- COMMIT;'
      ''
      '-- If anything looks wrong:'
      '-- ROLLBACK;')
    Left = 7736
    Top = 1512
  end
  object UPDATE_INVENTORIYINFO: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_INVENTORIYINFO] '
      #9'@pOPC INT,'
      #9'@pSPI VARCHAR(10)='#39'0'#39','
      #9'@pGENERIC_LNK INT=0,'
      #9'@pPRODUCTNO INT=0,'
      #9'@pNDC VARCHAR(15),'
      #9'@result BIT OUTPUT '#9
      'AS'
      'BEGIN'
      ''
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9'if @pOPC =1 '
      #9'begin'
      
        #9#9'IF (SELECT count(ndc) FROM INVENTARIOPISO where NDC=@pNDC)>0 A' +
        'ND RTRIM(@pNDC)<>'#39#39
      #9#9'BEGIN'
      
        #9#9#9'UPDATE INVENTARIOPISO SET SPI=iif(@pSPI='#39#39' or @pSPI='#39'0'#39', SPI,' +
        ' @pSPI),GENERIC_LNK=@pGENERIC_LNK,MAIN_NDC=IIF(PRODUCTNO=@pGENER' +
        'IC_LNK,1,0)'
      #9#9#9'WHERE NDC=@pNDC'
      #9#9#9'SET @result=1'
      #9#9'END'
      #9#9'ELSE'
      #9#9#9'SET @result=0'
      #9'end'
      #9'else if @pOPC =2 --REMOVE GENERIC LINK'
      #9'begin'
      
        #9#9'IF (SELECT count(ndc) FROM INVENTARIOPISO where NDC=@pNDC)>0 A' +
        'ND RTRIM(@pNDC)<>'#39#39
      #9#9'BEGIN'
      
        #9#9#9'UPDATE INVENTARIOPISO SET GENERIC_LNK=PRODUCTNO,MAIN_NDC=1 WH' +
        'ERE NDC=@pNDC'
      #9#9#9'SET @result=1'
      #9#9'END'
      #9#9'ELSE'
      #9#9#9'SET @result=0'
      #9'end'
      #9'else if @pOPC =3 --PLACE AS MAIN NDC'
      #9'begin'
      
        #9#9'IF (SELECT count(ndc) FROM INVENTARIOPISO where NDC=@pNDC)>0 A' +
        'ND RTRIM(@pNDC)<>'#39#39
      #9#9'BEGIN'
      
        #9#9#9'UPDATE INVENTARIOPISO SET GENERIC_LNK=@pPRODUCTNO,MAIN_NDC=II' +
        'F(PRODUCTNO=@pPRODUCTNO,1,0) WHERE GENERIC_LNK=@pGENERIC_LNK'
      #9#9#9'SET @result=1'
      #9#9'END'
      #9#9'ELSE'
      #9#9#9'SET @result=0'
      #9'end'
      #9'commit;'
      'END')
    Left = 7736
    Top = 1648
  end
  object UpdatePlanesMedicosSwitch: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'SET NOCOUNT ON;'
      'IF NOT EXISTS (SELECT 1 FROM PLANESMEDICOS_SWITCH)'
      'BEGIN'
      ''
      '    -- Priority 1 (Primary Switch = 3)'
      '    INSERT INTO PLANESMEDICOS_SWITCH'
      '    ('
      '        PLANESMEDICOSNO,'
      '        SWITCH_ID,'
      '        PRIORITY_ORDER,'
      '        ACTIVE,'
      '        CREATED_AT,'
      '        UPDATED_AT'
      '    )'
      '    SELECT'
      '        P.PLANESMEDICOSNO,'
      '        3,'
      '        1,'
      '        1,'
      '        GETDATE(),'
      '        GETDATE()'
      '    FROM PLANESMEDICOS P;'
      ''
      '    -- Priority 2 (Secondary Switch = 2)'
      '    INSERT INTO PLANESMEDICOS_SWITCH'
      '    ('
      '        PLANESMEDICOSNO,'
      '        SWITCH_ID,'
      '        PRIORITY_ORDER,'
      '        ACTIVE,'
      '        CREATED_AT,'
      '        UPDATED_AT'
      '    )'
      '    SELECT'
      '        P.PLANESMEDICOSNO,'
      '        2,'
      '        2,'
      '        1,'
      '        GETDATE(),'
      '        GETDATE()'
      '    FROM PLANESMEDICOS P;'
      ''
      '    -- Priority 3 (Tertiary Switch = 1)'
      '    INSERT INTO PLANESMEDICOS_SWITCH'
      '    ('
      '        PLANESMEDICOSNO,'
      '        SWITCH_ID,'
      '        PRIORITY_ORDER,'
      '        ACTIVE,'
      '        CREATED_AT,'
      '        UPDATED_AT'
      '    )'
      '    SELECT'
      '        P.PLANESMEDICOSNO,'
      '        1,'
      '        3,'
      '        1,'
      '        GETDATE(),'
      '        GETDATE()'
      '    FROM PLANESMEDICOS P;'
      ''
      'END;')
    Left = 7912
    Top = 384
  end
  object GET_CONTROLLED_RX_AUDIT_TRAIL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[GET_CONTROLLED_RX_AUDIT_TRAIL]'
      '  @RX_NUMBER  bigint = NULL,'
      '  @OTCNUMBER  int = NULL,'
      '  @MESSAGE_ID varchar(100) = NULL'
      'AS'
      'BEGIN'
      '  SET NOCOUNT ON;'
      ''
      '  SELECT *'
      '  FROM'
      '  ('
      '    SELECT'
      '      L.FECHA AS EVENT_TIME,'
      '      '#39'LOG'#39' AS SOURCE_TABLE,'
      '      CASE L.CODIGO'
      '        WHEN '#39'D'#39' THEN '#39'Delete'#39
      '        WHEN '#39'U'#39' THEN '#39'Update'#39
      '        WHEN '#39'M'#39' THEN '#39'Update'#39
      '        WHEN '#39'A'#39' THEN '#39'Append'#39
      '        WHEN '#39'B'#39' THEN '#39'Backup'#39
      '        WHEN '#39'P'#39' THEN '#39'Print'#39
      '        WHEN '#39'E'#39' THEN '#39'Error'#39
      '        ELSE L.CODIGO'
      '      END AS EVENT_TYPE,'
      ''
      '      L.NO_RX AS RX_NUMBER,'
      '      L.OTCNUMBER,'
      '      O.MessageID AS MESSAGE_ID,'
      ''
      '      L.DRUG_ID,'
      '      COALESCE(L.NDC_BARCODE, CL.NDC, O.NDC, P.NDC) AS NDC,'
      
        '      COALESCE(CL.DRUG, O.MEDICAMENTO, P.MEDICAMENTO, L.DESCRIPC' +
        'ION) AS DRUG_NAME,'
      '      CL.SCHEDULE_TYPE,'
      ''
      '      L.CUSTOMER_ID AS PATIENT_ID,'
      '      CL.PATIENT_SUPPLIER AS PATIENT_NAME,'
      ''
      
        '      COALESCE(NULLIF(L.PRESCRIBER_ID, 0), P.NumeroDoctor, CL.PR' +
        'ESCRIBER_NUMBER) AS PRESCRIBER_ID,'
      '      CL.PRESCRIBER AS PRESCRIBER_NAME,'
      '      D.DEA_Federal AS DEA,'
      ''
      '      L.USUARIO AS USER_INITIALS,'
      '      L.SUPERVISOR AS PHARMACIST,'
      '      L.SUCCESSFUL,'
      '      L.DESCRIPCION AS DESCRIPTION,'
      '      L.NOTE'
      '    FROM LOG L'
      '    LEFT JOIN OTC O'
      '      ON O.OTCNUMBER = L.OTCNUMBER'
      '    LEFT JOIN Prescriptions P'
      '      ON P.NumeroReceta = L.NO_RX'
      '    OUTER APPLY'
      '    ('
      '      SELECT TOP 1 C.*'
      '      FROM CONTROLED_LOG C'
      '      WHERE'
      '        (L.OTCNUMBER > 0 AND C.OTCNUMBER = L.OTCNUMBER)'
      '        OR (L.NO_RX > 0 AND C.RX_NUMBER = L.NO_RX)'
      '      ORDER BY C.[DATE] DESC'
      '    ) CL'
      '    LEFT JOIN Doctor D'
      
        '      ON D.NumeroDoctor = COALESCE(NULLIF(L.PRESCRIBER_ID, 0), P' +
        '.NumeroDoctor, CL.PRESCRIBER_NUMBER)'
      '    WHERE L.CONTROLLED = 1'
      '      AND (@RX_NUMBER IS NULL OR L.NO_RX = @RX_NUMBER)'
      '      AND (@OTCNUMBER IS NULL OR L.OTCNUMBER = @OTCNUMBER)'
      '      AND (@MESSAGE_ID IS NULL OR O.MessageID = @MESSAGE_ID)'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      C.[DATE] AS EVENT_TIME,'
      '      '#39'CONTROLED_LOG'#39' AS SOURCE_TABLE,'
      '      CASE'
      
        '        WHEN ISNULL(C.QTY_SOLD, 0) > 0 THEN '#39'Controlled Dispense' +
        'd'#39
      
        '        WHEN ISNULL(C.QTY_PURCHASED, 0) > 0 THEN '#39'Controlled Pur' +
        'chased'#39
      '        ELSE '#39'Controlled Log'#39
      '      END AS EVENT_TYPE,'
      ''
      '      C.RX_NUMBER,'
      '      C.OTCNUMBER,'
      '      O.MessageID AS MESSAGE_ID,'
      ''
      '      NULL AS DRUG_ID,'
      '      C.NDC,'
      '      C.DRUG AS DRUG_NAME,'
      '      C.SCHEDULE_TYPE,'
      ''
      '      C.PATIENT_NUMBER AS PATIENT_ID,'
      '      C.PATIENT_SUPPLIER AS PATIENT_NAME,'
      ''
      '      C.PRESCRIBER_NUMBER AS PRESCRIBER_ID,'
      '      C.PRESCRIBER AS PRESCRIBER_NAME,'
      '      D.DEA_Federal AS DEA,'
      ''
      '      C.EMPLOYEE AS USER_INITIALS,'
      '      C.PHARMACIST,'
      '      CAST(1 AS bit) AS SUCCESSFUL,'
      '      C.DRUG AS DESCRIPTION,'
      '      CONCAT('
      '        '#39'Schedule: '#39', C.SCHEDULE_TYPE,'
      '        '#39'; Qty Sold: '#39', C.QTY_SOLD,'
      '        '#39'; Qty Purchased: '#39', C.QTY_PURCHASED,'
      '        '#39'; Balance: '#39', C.BALANCE'
      '      ) AS NOTE'
      '    FROM CONTROLED_LOG C'
      '    LEFT JOIN OTC O'
      '      ON O.OTCNUMBER = C.OTCNUMBER'
      '    LEFT JOIN Doctor D'
      '      ON D.NumeroDoctor = C.PRESCRIBER_NUMBER'
      '    WHERE (@RX_NUMBER IS NULL OR C.RX_NUMBER = @RX_NUMBER)'
      '      AND (@OTCNUMBER IS NULL OR C.OTCNUMBER = @OTCNUMBER)'
      '      AND (@MESSAGE_ID IS NULL OR O.MessageID = @MESSAGE_ID)'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      S.DateReceived AS EVENT_TIME,'
      '      '#39'SURESCRIPTS'#39' AS SOURCE_TABLE,'
      '      '#39'ePrescribe Received'#39' AS EVENT_TYPE,'
      ''
      '      S.RxReferenceNumber AS RX_NUMBER,'
      '      O.OTCNUMBER,'
      '      S.MessageID AS MESSAGE_ID,'
      ''
      '      S.MedicationID AS DRUG_ID,'
      '      O.NDC,'
      '      S.Medication AS DRUG_NAME,'
      '      CL.SCHEDULE_TYPE,'
      ''
      '      S.PatientID AS PATIENT_ID,'
      '      S.Patient AS PATIENT_NAME,'
      ''
      '      S.PrescriberID AS PRESCRIBER_ID,'
      '      S.Prescriber AS PRESCRIBER_NAME,'
      '      D.DEA_Federal AS DEA,'
      ''
      '      S.Atendida_por AS USER_INITIALS,'
      '      NULL AS PHARMACIST,'
      '      CAST(1 AS bit) AS SUCCESSFUL,'
      '      S.Medication AS DESCRIPTION,'
      '      CONCAT('
      '        '#39'Transaction Type: '#39', S.TransactionType,'
      '        '#39'; Patient: '#39', S.Patient,'
      '        '#39'; Prescriber: '#39', S.Prescriber,'
      '        '#39'; Rx Status: '#39', S.Rx_Status'
      '      ) AS NOTE'
      '    FROM Surescripts S'
      '    LEFT JOIN OTC O'
      '      ON O.NumeroReceta = S.RxReferenceNumber'
      '    OUTER APPLY'
      '    ('
      '      SELECT TOP 1 C.*'
      '      FROM CONTROLED_LOG C'
      '      WHERE C.RX_NUMBER = S.RxReferenceNumber'
      '      ORDER BY C.[DATE] DESC'
      '    ) CL'
      '    LEFT JOIN Doctor D'
      
        '      ON D.NumeroDoctor = COALESCE(S.PrescriberID, CL.PRESCRIBER' +
        '_NUMBER)'
      
        '    WHERE (@RX_NUMBER IS NULL OR S.RxReferenceNumber = @RX_NUMBE' +
        'R)'
      '      AND (@OTCNUMBER IS NULL OR O.OTCNUMBER = @OTCNUMBER)'
      '      AND (@MESSAGE_ID IS NULL OR S.MessageID = @MESSAGE_ID)'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      LS.[TIME] AS EVENT_TIME,'
      '      '#39'LOG_SURESCRIPTS'#39' AS SOURCE_TABLE,'
      '      CASE LS.CODE'
      '        WHEN '#39'D'#39' THEN '#39'ePrescribe Deleted'#39
      '        WHEN '#39'U'#39' THEN '#39'ePrescribe Updated'#39
      '        WHEN '#39'M'#39' THEN '#39'ePrescribe Updated'#39
      '        WHEN '#39'A'#39' THEN '#39'ePrescribe Appended'#39
      '        WHEN '#39'B'#39' THEN '#39'ePrescribe Backup'#39
      '        WHEN '#39'P'#39' THEN '#39'ePrescribe Printed'#39
      '        ELSE LS.CODE'
      '      END AS EVENT_TYPE,'
      ''
      '      S.RxReferenceNumber AS RX_NUMBER,'
      '      O.OTCNUMBER,'
      '      LS.MESSAGE_ID,'
      ''
      '      S.MedicationID AS DRUG_ID,'
      '      O.NDC,'
      '      S.Medication AS DRUG_NAME,'
      '      CL.SCHEDULE_TYPE,'
      ''
      '      S.PatientID AS PATIENT_ID,'
      '      S.Patient AS PATIENT_NAME,'
      ''
      '      S.PrescriberID AS PRESCRIBER_ID,'
      '      S.Prescriber AS PRESCRIBER_NAME,'
      '      D.DEA_Federal AS DEA,'
      ''
      '      LS.TYPIST AS USER_INITIALS,'
      '      NULL AS PHARMACIST,'
      '      CAST(1 AS bit) AS SUCCESSFUL,'
      '      LS.NOTE AS DESCRIPTION,'
      '      LS.NOTE'
      '    FROM LOG_SURESCRIPTS LS'
      '    LEFT JOIN Surescripts S'
      '      ON S.MessageID = LS.MESSAGE_ID'
      '    LEFT JOIN OTC O'
      '      ON O.NumeroReceta = S.RxReferenceNumber'
      '    OUTER APPLY'
      '    ('
      '      SELECT TOP 1 C.*'
      '      FROM CONTROLED_LOG C'
      '      WHERE C.RX_NUMBER = S.RxReferenceNumber'
      '      ORDER BY C.[DATE] DESC'
      '    ) CL'
      '    LEFT JOIN Doctor D'
      
        '      ON D.NumeroDoctor = COALESCE(S.PrescriberID, CL.PRESCRIBER' +
        '_NUMBER)'
      
        '    WHERE (@RX_NUMBER IS NULL OR S.RxReferenceNumber = @RX_NUMBE' +
        'R)'
      '      AND (@OTCNUMBER IS NULL OR O.OTCNUMBER = @OTCNUMBER)'
      '      AND (@MESSAGE_ID IS NULL OR LS.MESSAGE_ID = @MESSAGE_ID)'
      '  ) AuditTrail'
      '  ORDER BY EVENT_TIME DESC;'
      'END')
    Left = 7912
    Top = 488
  end
  object Insurance_Master_data: TFDQuery
