  object DELETE_RXTEMP1NORX: TFDQuery
    AfterExecute = DELETE_RXTEMP1NORXAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[DELETE_RXTEMP1NORX] @GUID VARCHAR(36), @' +
        'PRINTER_ID INT, @OTCNUMBER INT, @LABEL_NAME NCHAR(50)'
      'AS'
      'DECLARE @IMPRIMIR BIT'
      'DECLARE @PLANMEDICO CHAR(3)'
      'DECLARE @ATENDIDAPOR CHAR(4) '
      'DECLARE @PAPER_CLAIM BIT'
      'DECLARE @MessageID varchar(50);'
      'DECLARE @NUMERORECETA BIGINT;'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @RX_STATUS CHAR(1)'
      'declare @TotalRows int = 1'
      'declare @counter int'
      'SET NOCOUNT ON'
      'begin'
      ' begin transaction'#9
      #9'if @OTCNUMBER > 0'
      #9'begin'
      
        #9'  UPDATE OTC SET GUID = '#39#39', RECORD_LOCKED = 0, INSTANCIA = 0 WH' +
        'ERE OTCNUMBER = @OTCNUMBER;'
      #9'end'
      #9'else'
      #9'begin'
      #9'  -- HARD STOP: do not run if GUID is NULL or blank'
      #9'  IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9'  BEGIN'
      
        #9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or b' +
        'lank.'#39', 16, 1);'
      #9#9'RETURN;'
      #9'  END;'
      #9'  if @GUID > '#39#39
      #9'  begin'
      #9#9'set @TotalRows = 0;'
      
        #9#9'SELECT @TotalRows = COUNT(*) FROM OTC WHERE GUID = @GUID and C' +
        'LAIM_STATUS <> 1 AND TERMINADA = 0;'
      #9#9'set @counter = 1;'
      #9#9'while @counter <= @TotalRows'
      #9#9'begin '
      
        #9#9#9'SELECT @OTCNUMBER = OTCNUMBER, @IMPRIMIR = IMPRIMIR, @PLANMED' +
        'ICO = PLAN_MEDICO, @ATENDIDAPOR = ATENDIDOPOR, '
      #9#9#9'@NUMERORECETA = NUMERORECETA, @RX_STATUS = RX_STATUS '
      
        #9#9#9'FROM OTC WHERE GUID = @GUID and CLAIM_STATUS <> 1 AND TERMINA' +
        'DA = 0 '
      #9#9#9'ORDER BY [NUMERORECETA]'
      #9#9#9'OFFSET @counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      
        #9#9#9'SELECT @MessageID = LTRIM(MessageID), @SPI = SPI FROM PRESCRI' +
        'PTIONS WHERE NUMERORECETA = @NUMERORECETA;'
      #9#9#9'IF @RX_STATUS = '#39'C'#39
      #9#9#9'begin'
      #9#9#9#9'DELETE FROM OTC WHERE OTCNUMBER = @OTCNUMBER'
      #9#9#9'end'
      #9#9#9'else'
      #9#9#9'begin'
      
        #9#9#9#9'UPDATE OTC SET RECORD_LOCKED = 0, INSTANCIA = 0, GUID = '#39#39', ' +
        'BATCH_NUMBER_BILLING = 0 WHERE OTCNUMBER = @OTCNUMBER;'
      #9#9#9#9'DELETE FROM COB_A WHERE OTCNUMBER = @OTCNUMBER;'
      #9#9#9'end;'
      
        #9#9#9'SELECT @PAPER_CLAIM = ISNULL(PAPER_CLAIM, 0) FROM PLANESMEDIC' +
        'OS WHERE ABREVIATURA = @PLANMEDICO;'
      #9#9#9'if (@IMPRIMIR = 1) '
      #9#9#9'begin'#9
      #9#9#9#9'IF (LTRIM(RTRIM(@PLANMEDICO)) = '#39'CAS'#39') OR (@PAPER_CLAIM = 1)'
      #9#9#9#9'begin'
      
        #9#9#9#9'IF (LTRIM(RTRIM(@LABEL_NAME)) = '#39#39') SELECT @LABEL_NAME = '#39'DE' +
        'FAULT'#39';   '
      #9#9#9#9'INSERT INTO [dbo].[PRINT_QUERIES]'
      #9#9#9#9#9'([RX_ID]'
      #9#9#9#9#9',[COPIES]'
      #9#9#9#9#9',[RX_OTC]'
      #9#9#9#9#9',[LABEL_NAME]'
      #9#9#9#9#9',[TYPIST]'
      #9#9#9#9#9',[PRINTTOSCREEN]'
      #9#9#9#9#9',[PRINTER_ID])'
      #9#9#9#9'VALUES'
      
        #9#9#9#9#9'(@OTCNUMBER, 1, '#39'RX'#39', @LABEL_NAME, @ATENDIDAPOR, 0, @PRINTE' +
        'R_ID)'
      #9#9#9#9'end;'
      #9#9#9'end;'
      #9#9#9'set @counter = @counter + 1;'
      #9#9'end;'
      #9'  end;'
      '    end;'
      ' commit;  '
      'end;')
    Left = 840
    Top = 216
  end
