        #9'DELETE FROM SURESCRIPTS_IP_CLIENTLIST WHERE CONVERT(VARCHAR, RE' +
        'PORTING_DATE, 101) < CONVERT(VARCHAR, GETDATE()-1, 101);'
      
        #9'SELECT @COUNT_IP = COUNT(*) FROM SURESCRIPTS_IP_CLIENTLIST WHER' +
        'E IP = @IP AND PORT = @PORT;'
