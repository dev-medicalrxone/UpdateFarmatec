  object UPDATE_MEZCLAS_OTCNUMBER: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE UPDATE_MEZCLAS_OTCNUMBER'
      'AS'
      'DECLARE @OTCNUMBER INTEGER;'
      'DECLARE @NO_TRANS INT;'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      
        #9'DECLARE MyCursor CURSOR FOR select NO_TRANS from MEZCLAS where ' +
        'NO_TRANS > 0 and (OTCNUMBER = 0 or OTCNUMBER is null) and FECHA_' +
        'MEZCLA > GETDATE()-360;'
      #9'OPEN MyCursor'
      #9'FETCH NEXT FROM MyCursor'
      #9'INTO @NO_TRANS'
      #9'WHILE @@FETCH_STATUS = 0'
      #9'BEGIN'#9'    '
      
        #9#9'Select @OTCNUMBER = otcnumber from otc where MEZCLA_TRAN_NO = ' +
        '@NO_TRANS;'
      #9#9'IF @OTCNUMBER > 0 '
      #9#9'begin'
      
        #9#9'  Update MEZCLAS set otcnumber = @OTCNUMBER where no_trans = @' +
        'NO_TRANS and OTCNUMBER = 0;'
      #9#9'end;'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @NO_TRANS'
      #9'END'
      #9'CLOSE MyCursor'
      #9'DEALLOCATE MyCursor'
      'END;')
    Left = 5400
    Top = 1448
  end
