    SQL.Strings = (
      
        'Create PROCEDURE [dbo].[DOCTOR_CREATE_UPDATE61] (@CREATE_UPDATE ' +
        'CHAR(1), @NUMERODOCTOR INT, @APELLIDO_MATERNO varchar(15)'
      '      ,@APELLIDO_PATERNO varchar(15)'
      '      ,@NOMBRE varchar(12)'
      '      ,@DIRECCION varchar(30)'
      '      ,@INFOADICIONAL text'
      '      ,@TELEFONO char(13)'
      '      ,@ESPECIALIDAD char(30)'
      '      ,@FAX char(13)'
      '      ,@DESCA varchar(15)'
      '      ,@DEA_FEDERAL varchar(15)'
      '      ,@LICENCIA varchar(15)'
      '      ,@PRESCRIBER_ID_QUALIFIER char(2)'
      '      ,@LOCATION_CODE char(3)'
      '      ,@NPI varchar(15)'
      '      ,@ESTADO nchar(2)'
      '      ,@CODIGO_POSTAL nchar(15)'
      '      ,@DIRECCION2 nchar(20)'
      '      ,@email nchar(80)'
      '      ,@CELULAR nchar(13)'
      '      ,@CITY nchar(20)'
      '      ,@WP_EXTENSION nchar(8)'
      '      ,@SUFFIX_NAME nchar(10)'
      '      ,@PREFIX_NAME nchar(10)'
      '      ,@MIDDLENAME nchar(35)'
      '      ,@PHONEALT1 Text'
      '      ,@SPI nchar(13)'
      '      ,@MEDICARE_NUMBER nchar(35)'
      '      ,@MEDICAID_NUMBER nchar(35)'
      '      ,@UPIN nchar(35)'
      '      ,@ClinicName nchar(35)'
      '      ,@ServiceLevel text'
      '      ,@ActiveStartTime nchar(22)'
      '      ,@ActiveEndTime nchar(22))'
      'AS'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  begin transaction'
      '  IF @CREATE_UPDATE = '#39'I'#39' '
      '  begin'
      '    INSERT INTO [dbo].[DOCTOR]'
      '           ([APELLIDO_MATERNO]'
      '           ,[APELLIDO_PATERNO]'
      '           ,[NOMBRE]'
      '           ,[DIRECCION]'
      '           ,[INFOADICIONAL]'
      '           ,[TELEFONO]'
      '           ,[Specialty]'
      '           ,[FAX]'
      '           ,[DESCA]'
      '           ,[DEA_FEDERAL]'
      '           ,[LICENCIA]'
      '           ,[PRESCRIBER_ID_QUALIFIER]'
      '           ,[LOCATION_CODE]'
      '           ,[NPI]'
      '           ,[ESTADO]'
      '           ,[CODIGO_POSTAL]'
      '           ,[DIRECCION2]'
      '           ,[email]'
      '           ,[CELULAR]'
      '           ,[CITY]'
      '           ,[WP_EXTENSION]'
      '           ,[SUFFIX_NAME]'
      '           ,[PREFIX_NAME]'
      '           ,[MIDDLENAME]'
      '           ,[AlternatePhoneNumbers]'
      '           ,[SPI]'
      '           ,[MEDICARE_NUMBER]'
      '           ,[MEDICAID_NUMBER]'
      '           ,[UPIN]'
      '           ,[ClinicName]'
      '           ,[ServiceLevel]'
      '           ,[ActiveStartTime]'
      '           ,[ActiveEndTime])'
      '     VALUES'
      '           (@APELLIDO_MATERNO'
      '           ,@APELLIDO_PATERNO'
      '           ,@NOMBRE'
      '           ,@DIRECCION'
      '           ,@INFOADICIONAL'
      '           ,@TELEFONO'
      '           ,@ESPECIALIDAD'
      '           ,@FAX'
      '           ,@DESCA'
      '           ,@DEA_FEDERAL'
      '           ,@LICENCIA'
      '           ,@PRESCRIBER_ID_QUALIFIER'
      '           ,@LOCATION_CODE'
      '           ,@NPI'
      '           ,@ESTADO'
      '           ,@CODIGO_POSTAL'
      '           ,@DIRECCION2'
      '           ,@email'
      '           ,@CELULAR'
      '           ,@CITY'
      '           ,@WP_EXTENSION'
      '           ,@SUFFIX_NAME'
      '           ,@PREFIX_NAME'
      '           ,@MIDDLENAME'
      '           ,@PHONEALT1'
      '           ,@SPI'
      '           ,@MEDICARE_NUMBER'
      '           ,@MEDICAID_NUMBER'
      '           ,@UPIN'
      '           ,@ClinicName'
      '           ,@ServiceLevel'
      '           ,@ActiveStartTime'
      '           ,@ActiveEndTime)'
      '  end;'
      '  IF @CREATE_UPDATE = '#39'U'#39
      '  begin  '
      '     UPDATE [dbo].[DOCTOR] SET '
      '       [DIRECCION] = @DIRECCION'
      '      ,[INFOADICIONAL] = @INFOADICIONAL'
      '      ,[TELEFONO] = @TELEFONO'
      '      ,[Specialty] = @ESPECIALIDAD'
      '      ,[FAX] = @FAX'
      '      ,[DESCA] = @DESCA'
      '      ,[DEA_FEDERAL] = @DEA_FEDERAL'
      '      ,[LICENCIA] = @LICENCIA'
      '      ,[PRESCRIBER_ID_QUALIFIER] = @PRESCRIBER_ID_QUALIFIER'
      '      ,[LOCATION_CODE] = @LOCATION_CODE'
      '      ,[NPI] = @NPI'
      '      ,[ESTADO] = @ESTADO'
      '      ,[CODIGO_POSTAL] = @CODIGO_POSTAL'
      '      ,[DIRECCION2] = @DIRECCION2'
      '      ,[email] = @email'
      '      ,[CELULAR] = @CELULAR'
      '      ,[CITY] = @CITY'
      '      ,[WP_EXTENSION] = @WP_EXTENSION'
      '      ,[SUFFIX_NAME] = @SUFFIX_NAME'
      '      ,[PREFIX_NAME] = @PREFIX_NAME'
      '      ,[MIDDLENAME] = @MIDDLENAME'
      '      ,[AlternatePhoneNumbers] = @PHONEALT1'
      '      ,[SPI] = @SPI'
      '      ,[MEDICARE_NUMBER] = @MEDICARE_NUMBER'
      '      ,[MEDICAID_NUMBER] = @MEDICAID_NUMBER'
      '      ,[UPIN] = @UPIN'
      '      ,[ClinicName] = @ClinicName'
      '      ,[ServiceLevel] = @ServiceLevel'
      '      ,[ActiveStartTime] = @ActiveStartTime'
      '      ,[ActiveEndTime] = @ActiveEndTime'
      '      WHERE NUMERODOCTOR = @NUMERODOCTOR;'
      '  end;  '
      '  commit;'
      'END;')
