      #9#9'   ,[inventory]'
      #9#9'   ,[NDC]'
      #9#9'   ,[qty_max]'
      #9#9'   ,[qty_min]'
      #9#9'   ,[retail_price]'
      #9#9'   ,[inv_qty_todate])'
      '     VALUES'
      #9#9'(@description,'
      #9#9'@strenght,'
      #9#9'@form,'
      #9#9'isnull(@size,0), '
      #9#9'isnull(@qty_orderd,0), '
      #9#9'isnull(@qty_received,0),'
      #9#9'isnull(@qty_sold,0),'
