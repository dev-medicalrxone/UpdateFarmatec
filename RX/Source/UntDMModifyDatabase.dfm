        #39'A tablet that is suspended in liquid prior to administration to' +
        ' the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68945'#39', N'#39'Enteric Coated C' +
        'apsule'#39', N'#39'A capsule covered with a substance that is designed t' +
        'o delay the release of active and/or inert ingredient(s) until t' +
        'he capsule passes into the intestines.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42758'#39', N'#39'Enteric Coated T' +
        'ablet'#39', N'#39'A tablet covered with a substance that is designed to ' +
        'delay the release of active and/or inert ingredient(s) until the' +
        ' tablet passes into the intestines.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42742'#39', N'#39'Erosion Controll' +
        'ed Extended Release'#39', N'#39'A solid semi-solid solution or suspensio' +
        'n in which active and/or inert ingredient(s) release is controll' +
        'ed by the erosion rate of a carrier matrix which is designed to ' +
        'release ingredients at a controlled prolonged rate so as to redu' +
        'ce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42713'#39', N'#39'Extended Release' +
        #39', N'#39'A solid semi-solid solution or suspension designed to relea' +
        'se active and/or inert ingredient(s) at a controlled prolonged r' +
        'ate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C43451'#39', N'#39'Extended Release' +
        ' Bead Implant'#39', N'#39'A solid in the shape of a small sphere intende' +
        'd to be embedded securely in the body and designed to release ac' +
        'tive and/or inert ingredient(s) at a controlled prolonged rate s' +
        'o as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42916'#39', N'#39'Extended Release' +
