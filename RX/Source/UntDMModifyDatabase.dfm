        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60988'#39', N'#39'Ring'#39', N'#39'A solid' +
        ' composed active and/or inert ingredient(s) of in the shape of a' +
