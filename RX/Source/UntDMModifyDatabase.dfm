  object INSERT_CLAIM: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_CLAIM]'
      '    @NORX       BIGINT,'
      '    @GUID       VARCHAR(36),'
      '    @CLAIM_STR  VARCHAR(MAX),'
      '    @TYPIST     NCHAR(4)'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    -- Validate BEFORE opening a transaction'
      '    IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      '    BEGIN'
      
        '        RAISERROR('#39'Parameter @GUID is required and cannot be NUL' +
        'L or blank.'#39', 16, 1);'
      '        RETURN;'
      '    END;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      '        DECLARE @OTCNUMBER INT;'
      ''
      '        SELECT @OTCNUMBER = o.OTCNUMBER'
      '        FROM dbo.OTC o'
      '        WHERE o.NUMERORECETA = @NORX'
      '          AND o.GUID = @GUID;'
      ''
      '        IF @OTCNUMBER IS NULL'
      '        BEGIN'
      
        '            RAISERROR('#39'No OTC record found for the given @NORX a' +
        'nd @GUID.'#39', 16, 1);'
      '        END'
      ''
      
        '        INSERT INTO dbo.CLAIM (RX_NUMBER, SERVICEDATE, CLAIM, OT' +
        'CNUMBER, TYPIST)'
      
        '        VALUES (@NORX, GETDATE(), @CLAIM_STR, @OTCNUMBER, @TYPIS' +
        'T);'
      ''
      '        COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        -- rethrow original error with full details'
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 104
    Top = 752
  end
  object UPDATE_OTC: TFDQuery
    AfterExecute = UPDATE_OTCAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_OTC]'
      
        #9'@ATENDIDAPOR NCHAR(4), @NDC NCHAR(11), @MEDICAMENTO NCHAR(30), ' +
        '@PRODUCT_ID INT,'
      
        #9'@LOTE NCHAR(12), @QTY FLOAT, @TOTAL FLOAT, @FECHAOTC DATE, @COS' +
        'TOVENTA FLOAT,'
      
        #9'@PHARMACIST NCHAR(3), @DAYS_SUPPLY INT, @PLAN_MEDICO NCHAR(3), ' +
        '@PRICE_TABLE_ID INT,'
      
        #9'@MEZCLA_TRAN_NO INT, @FACILITY_ID INT, @OTCNUMBER INT, @NUMEROP' +
        'LAN INT, '
      
        #9'@NUMERORECETA BIGINT, @UNIT_PRICE FLOAT, @FECHA_EXPI DATE, @PLA' +
        'NESMEDICOSNO int'
      'AS'
      'DECLARE @WF_BILLED NCHAR(30)'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  begin transaction'
      
        '  Select @WF_BILLED = @ATENDIDAPOR + '#39' '#39' + FORMAT (getdate(), '#39'M' +
        'M/dd/yyyy, hh:mm:ss tt'#39');'
      
        '  UPDATE OTC SET ATENDIDOPOR = @ATENDIDAPOR, NDC = @NDC, MEDICAM' +
        'ENTO = @MEDICAMENTO,'
      
        '  PRODUCT_ID = @PRODUCT_ID, LOTE = @LOTE, QTY = @QTY, TOTAL = @T' +
        'OTAL, FECHAOTC = @FECHAOTC,'
      
        '  TIME_RX = GETDATE(), COSTOVENTA = @COSTOVENTA, PHARMACIST = @P' +
        'HARMACIST, DAYS_SUPPLY = @DAYS_SUPPLY,'
      
        '  PLAN_MEDICO = @PLAN_MEDICO, PRICE_TABLE_ID = @PRICE_TABLE_ID, ' +
        'MEZCLA_TRAN_NO = @MEZCLA_TRAN_NO,'
      
        '  FACILITY_ID = @FACILITY_ID, NUMEROPLAN = @NUMEROPLAN, CLAIM_ST' +
        'ATUS = 0, SIGNATURE_LINK = 1,'
      
        '  UNIT_PRICE = @UNIT_PRICE, WF_BILLED = @WF_BILLED, WF_PRINTED =' +
        ' @WF_BILLED, FECHAEXPIRACION = @FECHA_EXPI,'
      '  PLANESMEDICOSNO = @PLANESMEDICOSNO'
      '  WHERE OTCNUMBER = @OTCNUMBER;'
      
        '  UPDATE PRESCRIPTIONS SET FECHAULTIMOREFILL = GETDATE() WHERE N' +
        'UMERORECETA = @NUMERORECETA;'
      '  commit;'
      'END;')
    Left = 336
    Top = 328
  end
  object UPDATE_OTC_RXPAID: TFDQuery
    AfterExecute = UPDATE_OTC_RXPAIDAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_OTC_RXPAID]'
      '('
      '    @PATPAID FLOAT,'
      '    @PAGOPLAN FLOAT,'
      '    @NOAUTH CHAR(20),'
      '    @NORX BIGINT,'
      '    @ING_COST_PAID FLOAT,'
      '    @INC_FEE_PAID FLOAT,'
      '    @DISP_FEE_PAID FLOAT,'
      '    @OTHER_AM_PAID FLOAT,'
      '    @AMO_COPAY FLOAT,'
      '    @PS_521_FL FLOAT,'
      '    @PS_523_FN FLOAT,'
      '    @PS_512_FC FLOAT,'
      '    @PS_513_FD FLOAT,'
      '    @PS_514_FE FLOAT,'
      '    @PS_517_FH FLOAT,'
      '    @PS_518_FI FLOAT,'
      '    @PS_520_FK FLOAT,'
      '    @PS_346_HH FLOAT,'
      '    @PS_347_HJ FLOAT,'
      '    @PS_348_HK FLOAT,'
      '    @PS_571_NZ FLOAT,'
      '    @PS_575_EQ FLOAT,'
      '    @PS_574_2Y FLOAT,'
      '    @PS_572_4U FLOAT,'
      '    @PS_577_G3 FLOAT,'
      '    @PS_133_UJ FLOAT,'
      '    @PS_134_UK FLOAT,'
      '    @PS_135_UM FLOAT,'
      '    @PS_136_UN FLOAT,'
      '    @PS_137_UP FLOAT,'
      '    @WF_BILLED NCHAR(30),'
      '    @ATENDIDAPOR NCHAR(3),'
      '    @ROBOT BIT,'
      '    @LABELNAME NCHAR(20),'
      '    @PRINTERID INT,'
      '    @CLAIMEDFROM NCHAR(20),'
      '    @OTCNUMBER INT,'
      '    @DAYS_SUPPLY INT,'
      '    @MessageID VARCHAR(50) OUTPUT,'
      '    @PRINTERIP NCHAR(15),'
      '    @REBATE FLOAT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    DECLARE @PRODUCT_ID INT;'
      '    DECLARE @ROBOT_NDC NCHAR(11);'
      '    DECLARE @IMPRIMIR_TF BIT;'
      '    DECLARE @PHARMACIST NCHAR(3);'
      '    DECLARE @NDC NCHAR(11);'
      '    DECLARE @RX_STATUS CHAR(1);'
      '    DECLARE @COSTO FLOAT;'
      '    DECLARE @QTY_TEMP FLOAT;'
      '    DECLARE @MYREFILL_UPDATE_SMARTPICKUP BIT;'
      '    DECLARE @CONTROLLED CHAR(4);'
      '    DECLARE @ISCONTROLLED BIT;'
      '    DECLARE @CUST_ID INT;'
      '    DECLARE @MEDICAMENTO CHAR(30);'
      '    DECLARE @CODIGOREFILLNUEVO SMALLINT;'
      '    DECLARE @INV_QTY_TODATE DECIMAL(18,2);'
      ''
      '    BEGIN TRY'
      ''
      '        BEGIN TRANSACTION;'
      ''
      '        SET @REBATE = ISNULL(@REBATE, 0);'
      '        SET @MessageID = '#39#39';'
      ''
      '        SELECT '
      
        '            @MYREFILL_UPDATE_SMARTPICKUP = ISNULL(MYREFILL_UPDAT' +
        'E_SMARTPICKUP, 0)'
      '        FROM dbo.CREDITDEBITSETUP;'
      ''
      '        SELECT '
      '            @QTY_TEMP = QTY_TEMP,'
      '            @RX_STATUS = RX_STATUS,'
      '            @PRODUCT_ID = PRODUCT_ID,'
      '            @IMPRIMIR_TF = IMPRIMIR,'
      '            @PHARMACIST = PHARMACIST,'
      '            @NDC = NDC,'
      '            @COSTO = COSTOVENTA,'
      '            @MessageID = RTRIM(ISNULL(MessageID, '#39#39')),'
      '            @CONTROLLED = CONTROLADO,'
      '            @CUST_ID = NUMEROCLIENTE,'
      '            @MEDICAMENTO = MEDICAMENTO,'
      '            @CODIGOREFILLNUEVO = CODIGOREFILLNUEVO'
      '        FROM dbo.OTC'
      '        WHERE OTCNUMBER = @OTCNUMBER;'
      ''
      '        IF @@ROWCOUNT = 0'
      '        BEGIN'
      
        '            RAISERROR('#39'OTC record was not found for the supplied' +
        ' OTCNUMBER.'#39', 16, 1);'
      '            ROLLBACK TRANSACTION;'
      '            RETURN;'
      '        END;'
      ''
      '        SELECT '
      '            @ROBOT = ROBOT,'
      '            @ROBOT_NDC = ROBOT_NDC,'
      '            @INV_QTY_TODATE = QTYINVENTARIO'
      '        FROM dbo.INVENTARIOPISO'
      '        WHERE PRODUCTNO = @PRODUCT_ID;'
      ''
      
        '        IF RTRIM(ISNULL(@CONTROLLED, '#39#39')) IN ('#39'RX'#39', '#39'OTC'#39', '#39'DME'#39 +
        ')'
      '            SET @ISCONTROLLED = 0;'
      '        ELSE'
      '            SET @ISCONTROLLED = 1;'
      ''
      '        IF @RX_STATUS = '#39'C'#39
      '            SET @QTY_TEMP = 0;'
      ''
      '        UPDATE dbo.OTC'
      '        SET '
      '            INV_QTY_TODATE = @INV_QTY_TODATE,'
      '            DEDUCIBLE = @PATPAID,'
      '            PAGO_PLAN = @PAGOPLAN,'
      '            NUMERO_AUTORIZACION = @NOAUTH,'
      '            INGREDIENT_COST_PAID = @ING_COST_PAID,'
      '            INCENTIVE_FEE_PAID = @INC_FEE_PAID,'
      '            DISPENSING_FEE_PAID = @DISP_FEE_PAID,'
      '            OTHER_AMOUNT_PAID = @OTHER_AM_PAID,'
      '            AMOUNT_COPAY_COINS = @AMO_COPAY,'
      '            PS_521_FL = @PS_521_FL,'
      '            PS_523_FN = @PS_523_FN,'
      '            PS_512_FC = @PS_512_FC,'
      '            PS_513_FD = @PS_513_FD,'
      '            PS_514_FE = @PS_514_FE,'
      '            PS_517_FH = @PS_517_FH,'
      '            PS_518_FI = @PS_518_FI,'
      '            PS_520_FK = @PS_520_FK,'
      '            PS_346_HH = @PS_346_HH,'
      '            PS_347_HJ = @PS_347_HJ,'
      '            PS_348_HK = @PS_348_HK,'
      '            PS_571_NZ = @PS_571_NZ,'
      '            PS_575_EQ = @PS_575_EQ,'
      '            PS_574_2Y = @PS_574_2Y,'
      '            PS_572_4U = @PS_572_4U,'
      '            PS_577_G3 = @PS_577_G3,'
      '            PS_133_UJ = @PS_133_UJ,'
      '            PS_134_UK = @PS_134_UK,'
      '            PS_135_UM = @PS_135_UM,'
      '            PS_136_UN = @PS_136_UN,'
      '            PS_137_UP = @PS_137_UP,'
      '            WF_BILLED = @WF_BILLED,'
      '            CLAIM_STATUS = 1,'
      '            PDN_SENT = 1,'
      '            TERMINADA = 1,'
      '            ATENDIDOPOR = @ATENDIDAPOR,'
      '            GUID = '#39#39','
      '            RECORD_LOCKED = 0,'
      '            INSTANCIA = 0,'
      '            QTY = @QTY_TEMP,'
      
        '            GANANCIA = (@PAGOPLAN + @PATPAID) - ISNULL(@COSTO, 0' +
        '),'
      '            REBATE = @REBATE'
      '        WHERE OTCNUMBER = @OTCNUMBER'
      '          AND ISNULL(CLAIM_STATUS, 0) <> 1;'
      ''
      
        '        IF (@RX_STATUS = '#39'N'#39') AND (ISNULL(@CODIGOREFILLNUEVO, 0)' +
        ' = 0)'
      '        BEGIN'
      '            UPDATE dbo.PRESCRIPTIONS'
      '            SET '
      '                MEDICAMENTO = @MEDICAMENTO,'
      '                NDC = @NDC,'
      '                PRODUCT_ID = @PRODUCT_ID,'
      '                NUMEROCLIENTE = @CUST_ID'
      '            WHERE NUMERORECETA = @NORX;'
      '        END;'
      ''
      '        IF RTRIM(ISNULL(@MessageID, '#39#39')) <> '#39#39
      '        BEGIN'
      '            UPDATE dbo.Surescripts'
      '            SET Rx_Status = 1'
      '            WHERE MessageID = @MessageID;'
      '        END;'
      ''
      '        IF ISNULL(@MYREFILL_UPDATE_SMARTPICKUP, 0) = 0'
      '        BEGIN'
      '            EXEC dbo.RX_UPDATE_REFILL_QUERY @NORX;'
      '        END;'
      ''
      '        IF @RX_STATUS <> '#39'C'#39
      '        BEGIN'
      '            IF (@ROBOT = 1)'
      '               AND (RTRIM(LTRIM(ISNULL(@ROBOT_NDC, '#39#39'))) <> '#39#39')'
      '               AND NOT EXISTS'
      '               ('
      '                    SELECT 1'
      
        '                    FROM dbo.PARATA_QUERIE WITH (UPDLOCK, HOLDLO' +
        'CK)'
      '                    WHERE OTCNUMBER = @OTCNUMBER'
      '               )'
      '            BEGIN'
      '                INSERT INTO dbo.PARATA_QUERIE'
      '                ('
      '                    OTCNUMBER,'
      '                    PROCESSED'
      '                )'
      '                VALUES'
      '                ('
      '                    @OTCNUMBER,'
      '                    0'
      '                );'
      '            END;'
      ''
      '            EXEC dbo.INVENTORY_CONTROL'
      '                @OTC_NUMBER = @OTCNUMBER,'
      '                @LABEL_NAME = @LABELNAME,'
      '                @IMPRIMIR = @IMPRIMIR_TF,'
      '                @PRINTER_ID = @PRINTERID,'
      '                @REVERSAL = 0,'
      '                @PRINTER_IP = @PRINTERIP;'
      '        END;'
      ''
      '        EXEC dbo.INSERT_LOG'
      '            @CLAIMEDFROM,'
      '            '#39'M'#39','
      '            @NDC,'
      '            @ATENDIDAPOR,'
      '            @PHARMACIST,'
      '            @NORX,'
      '            @OTCNUMBER,'
      '            0,'
      '            @CUST_ID,'
      '            0,'
      '            0,'
      '            0,'
      '            @PRODUCT_ID,'
      '            '#39'R'#39','
      '            '#39'Prescription was Adjudicated'#39','
      '            @ISCONTROLLED,'
      '            1;'
      ''
      '        COMMIT TRANSACTION;'
      ''
      '    END TRY'
      '    BEGIN CATCH'
      ''
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        DECLARE @ErrMsg NVARCHAR(4000);'
      '        DECLARE @ErrSeverity INT;'
      '        DECLARE @ErrState INT;'
      ''
      '        SELECT '
      '            @ErrMsg = ERROR_MESSAGE(),'
      '            @ErrSeverity = ERROR_SEVERITY(),'
      '            @ErrState = ERROR_STATE();'
      ''
      '        RAISERROR(@ErrMsg, @ErrSeverity, @ErrState);'
      ''
      '    END CATCH;'
      'END;')
    Left = 2120
    Top = 32
  end
  object ADDUPDATEOTC: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[ADDUPDATEOTC] @INSTANCIA INT, @TERMINADA' +
        ' BIT, @NUMERORECETA BIGINT'
      'AS'
      'DECLARE @NORX INT'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  IF @NUMERORECETA > 0'
      '  BEGIN'
      
        '    DECLARE MyCursor CURSOR FOR Select NUMERORECETA FROM RXTEMP1' +
        ' WHERE NUMERORECETA = @NUMERORECETA;'
      '  END'
      '  ELSE'
      '  BEGIN'
      '    if @TERMINADA <> 1'
      
        '      DECLARE MyCursor CURSOR FOR Select NUMERORECETA from RxTem' +
        'p1 where Instancia = @INSTANCIA  order by NumeroReceta'
      '    else'
      
        '      DECLARE MyCursor CURSOR FOR Select NUMERORECETA from RxTem' +
        'p1 where Instancia = @INSTANCIA and Terminada = @TERMINADA order' +
        ' by NumeroReceta'
      '  END;'
      '  OPEN MyCursor'
      '  FETCH NEXT FROM MyCursor'
      '  INTO @NORX'
      '  WHILE @@FETCH_STATUS = 0'
      '  BEGIN'
      '   DELETE FROM RXTEMP1 WHERE NUMERORECETA = @NORX;'
      '   FETCH NEXT FROM MyCursor'
      '   INTO @NORX'
      '  END'
      '  CLOSE MyCursor'
      '  DEALLOCATE MyCursor    '
      'END')
    Left = 1992
    Top = 16
  end
  object UPDATE_PRESCRIPTION: TFDQuery
    AfterExecute = UPDATE_PRESCRIPTIONAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_PRESCRIPTION] '
      #9'(@MEDICAMENTO varchar(30), '
      #9'  @NDC NCHAR(11),'
      #9'  @FECHARECETA DATE,'
      #9'  @CANTIDADRECETADA FLOAT,'
      #9'  @LICENCIA VARCHAR(15),'
      #9'  @PRESCRIBERIDQUALIFIER VARCHAR(2),'
      #9'  @COMPOUNDCODE INT,'
      #9'  @NUMEROREFILLSAUTORIZADOS INT,'
      #9'  @ETIQUETA NCHAR(296),'
      #9'  @SIG NCHAR(296),'
      #9'  @INFORMACION_EXT TEXT,'
      #9'  @RXORIGINCODE VARCHAR(1),'
      #9'  @ACTIVE BIT,'
      #9'  @NUMERORECETA BIGINT,'
      #9'  @VETERINARY BIT,'
      #9'  @NUMERODOCTOR INT,'
      #9'  @SPI NCHAR(13),'
      #9'  @generic_drug_exchange BIT,'
      #9'  @AUTOMATIC_REFILL BIT,'
      #9'  @LTC BIT,'
      #9'  @340B bit)'
      'AS'
      'DECLARE @TDISPENSADO FLOAT'
      'DECLARE @TRECETADO FLOAT'
      'BEGIN'
      'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9'Select @TDISPENSADO = ISNULL(sum(qty),0) from OTC where NUMEROR' +
        'ECETA = @NUMERORECETA AND RX_STATUS <> '#39'C'#39';'
      #9'if (Select @NUMEROREFILLSAUTORIZADOS) > 0  '
      #9'begin'
      
        #9#9'select @TRECETADO = @CANTIDADRECETADA + (@CANTIDADRECETADA * @' +
        'NUMEROREFILLSAUTORIZADOS)                    '
      #9'end'
      #9'UPDATE PRESCRIPTIONS SET MEDICAMENTO = @MEDICAMENTO, '
      #9'NDC = @NDC, SPI = @SPI, NUMERODOCTOR = @NUMERODOCTOR,   '
      
        #9'FECHARECETA = @FECHARECETA, CANTIDADRECETADA = @CANTIDADRECETAD' +
        'A,'
      
        #9'LICENCIA = @LICENCIA, PRESCRIBERIDQUALIFIER = @PRESCRIBERIDQUAL' +
        'IFIER,'
      #9'NUMEROREFILLSAUTORIZADOS = @NUMEROREFILLSAUTORIZADOS,'
      
        #9'ETIQUETA = @ETIQUETA, SIG = @SIG, INFORMACION_EXT = @INFORMACIO' +
        'N_EXT,'
      
        #9'RXORIGINCODE = @RXORIGINCODE, ACTIVE = @ACTIVE, AUTOMATIC_REFIL' +
        'L = @AUTOMATIC_REFILL,'
      
        #9'CANTIDAD_DISPONIBLE = ISNULL(@TRECETADO - @TDISPENSADO, 0), VET' +
        'ERINARY = @VETERINARY,'
      
        #9'generic_drug_exchange = @generic_drug_exchange, LTC = @LTC, F34' +
        '0B = @340B'
      #9'WHERE NUMERORECETA = @NUMERORECETA;'
      #9'COMMIT'
      'END;')
    Left = 2296
    Top = 32
  end
  object CAMBIAR_MEDICAMENTO: TFDQuery
    AfterExecute = CAMBIAR_MEDICAMENTOAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[CAMBIAR_MEDICAMENTO] (@PRODUCT_NO INT, @' +
        'OTCNUMBER INT, @NORX BIGINT,'
      
        '@ATENDIDAPOR NCHAR(3), @PHARMACIST NCHAR(3), @NOTE VARCHAR(MAX))' +
        ' '
      'AS'
      'DECLARE @MEDICAMENTO NCHAR(30)'
      'DECLARE @NDC NCHAR(11)'
      'DECLARE @LOTE NCHAR(12)'
      'DECLARE @FECHAEXPI DATE'
      'DECLARE @CLAIM_STATUS INT'
      'DECLARE @TOTAL_RX INT'
      'DECLARE @CONTROLADO CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'BEGIN'
      '   BEGIN TRANSACTION;'
      '   SET NOCOUNT ON;'
      
        '   SELECT @MEDICAMENTO = SUBSTRING(isnull(LTRIM(RTRIM(DESCRIPCIO' +
        'N)),'#39#39') + '#39' '#39' + ISNULL(LTRIM(RTRIM(STRENGTH)),'#39#39') ,1, 30), @NDC ' +
        '= NDC, @LOTE = LOTE, @FECHAEXPI = FECHA_EXPIRACION, @CONTROLADO ' +
        '= CONTROLADO FROM INVENTARIOPISO WHERE PRODUCTNO = @PRODUCT_NO;'
      
        '   UPDATE OTC SET MEDICAMENTO = @MEDICAMENTO, NDC = @NDC, LOTE =' +
        ' @LOTE, PRODUCT_ID = @PRODUCT_NO, CONTROLADO = @CONTROLADO WHERE' +
        ' OTCNUMBER = @OTCNUMBER;'
      #9'IF (RTRIM(@CONTROLADO) = '#39'RX'#39') or'
      #9'(RTRIM(@CONTROLADO) = '#39'OTC'#39') or'
      
        #9'(RTRIM(@CONTROLADO) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @IS' +
        'CONTROLLED = 1;'
      ''
      
        '   SELECT @TOTAL_RX = COUNT(*) FROM OTC WHERE NUMERORECETA = @NO' +
        'RX;'
      '   IF @TOTAL_RX = 1'
      '   BEGIN'
      
        '     SELECT @CLAIM_STATUS = CLAIM_STATUS FROM OTC WHERE OTCNUMBE' +
        'R = @OTCNUMBER;'
      '     IF (@CLAIM_STATUS <> 1)'
      '     BEGIN'
      
        '       UPDATE PRESCRIPTIONS SET MEDICAMENTO = @MEDICAMENTO, NDC ' +
        '= @NDC, PRODUCT_ID = @PRODUCT_NO'
      #9'   WHERE NUMERORECETA = @NORX;'
      '     END;'
      '   END;'
      
        '   EXECUTE INSERT_LOG '#39'DRUG CHANGED'#39', '#39'M'#39', @NDC, @ATENDIDAPOR, @' +
        'PHARMACIST, @NORX, @OTCNUMBER,0,0,0,0,0,0,'#39'R'#39',@NOTE,@ISCONTROLLE' +
        'D,1;'
      '   COMMIT;'#9'  '
      'END;')
    Left = 2296
    Top = 112
  end
  object UPDATE_RX_SCANED_RXLINK: TFDQuery
    AfterExecute = UPDATE_RX_SCANED_RXLINKAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_RX_SCANED_RXLINK] @NORX BIGINT, @' +
        'SCANEDRXLINK INT, @SCANNER_NUMBER INT, '
      '@TYPIST NCHAR(3) '
      'AS'
      'DECLARE @QUEUECOLOR bit'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9#9'SELECT @QUEUECOLOR = SCAN_COLOR FROM  CREDITDEBITSETUP; '
      
        #9#9'UPDATE PRESCRIPTIONS SET SCANED_RX_LINK = @SCANEDRXLINK WHERE ' +
        'NUMERORECETA = @NORX;'
      
        #9#9'INSERT INTO SCANED_QUEUE (SCANNER_NUMBER, SCANED_RX_LINK, STAT' +
        'US, COLOR, TYPIST, RX_NUMBER)'
      
        #9#9'VALUES (@SCANNER_NUMBER, @SCANEDRXLINK, '#39'O'#39', @QUEUECOLOR, @TYP' +
        'IST, @NORX);'
      #9'COMMIT;'
      'END')
    Left = 2304
    Top = 192
  end
