  object RX_INSERT_REFILL_QUERY: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE Procedure [dbo].[RX_INSERT_REFILL_QUERY] @TELEFONO NCHAR(' +
        '10), @PICKUP_DELIVERY_TYPE NCHAR(2),'
      
        '@CALLDATE NCHAR(23), @PICKUP_DATE NCHAR(23), @PICKUP_TIME NCHAR(' +
        '23), @CALL_BACK_NUMBER NCHAR(13),'
      
        '@NUMERORECETA BIGINT, @RX_STATUS INT, @ORDER_ORIGINATION NCHAR(1' +
        '), @DATE_CREATED DATE,'
      
        '@PICKUP_REMINDER INT, @PR_PATIENT_NAME NCHAR(45), @CALLTIME NCHA' +
        'R(45), @EMAIL NCHAR(80),'
      
        '@DOB NCHAR(10), @SMS_BODY NCHAR(160), @SCAN_RX_LINK INT, @PATIEN' +
        'T_ID INT, @REFILL_QUERY_ID int OUTPUT'
      'AS'
      'declare @RecordsFound int'
      'BEGIN'
      '  BEGIN TRANSACTION'
      
        #9'Select @RecordsFound = count(*) from REFILL_QUERY where NUMEROT' +
        'RANSACCION = @REFILL_QUERY_ID;'
      '    if (@RecordsFound > 0) '
      #9'begin'
      '        UPDATE [dbo].[REFILL_QUERY]'
      '           SET [TELEFONO] = @TELEFONO,'
      #9#9'   [PICKUP_DELIVERY_TYPE] = @PICKUP_DELIVERY_TYPE,'
      #9#9'   --[CALLDATE] = @CALLDATE,'
      #9#9'   [PICKUP_DATE] = @PICKUP_DATE,'
      #9#9'   [PICKUP_TIME] = @PICKUP_TIME,'
      #9#9'   [CALL_BACK_NUMBER] = @CALL_BACK_NUMBER,'
      #9#9'   [NOTE] = @SMS_BODY,'
      #9#9'   [NUMERORECETA] = 0,'
      #9#9'   [RX_STATUS] = @RX_STATUS,'
      #9#9'   [ORDER_ORIGINATION] = @ORDER_ORIGINATION,'
      #9#9'   --[DATE_CREATED] = @DATE_CREATED,'
      #9#9'   [PICKUP_REMINDER] = @PICKUP_REMINDER,'
      #9#9'   [PR_PATIENT_NAME] = @PR_PATIENT_NAME,'
      #9'   '#9'   [PICKED_UP] = 0, '
      #9#9'   --[CALLTIME] = @CALLTIME,'
      #9#9'   [EMAIL] = @EMAIL, '
      #9#9'   [DOB] = @DOB, '
      #9#9'   [SCAN_RX_LINK] = @SCAN_RX_LINK, '
      #9#9'   [PATIENT_ID] = @PATIENT_ID'
      '           --WHERE SCAN_RX_LINK = @SCAN_RX_LINK;'
      #9#9'   WHERE NUMEROTRANSACCION = @REFILL_QUERY_ID;'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'INSERT INTO REFILL_QUERY ([TELEFONO]'
      
        #9#9',[PICKUP_DELIVERY_TYPE],[CALLDATE],[PICKUP_DATE],[PICKUP_TIME]' +
        ',[CALL_BACK_NUMBER]'
      #9#9',[NOTE],[NUMERORECETA],[RX_STATUS],[ORDER_ORIGINATION]'
      #9#9',[DATE_CREATED],[PICKUP_REMINDER]'
      #9#9',[PR_PATIENT_NAME]'
      
        #9#9',[PICKED_UP],[CALLTIME],[EMAIL], [DOB], [SCAN_RX_LINK], [PATIE' +
        'NT_ID])'
      #9#9'VALUES '
      
        #9#9'(@TELEFONO, @PICKUP_DELIVERY_TYPE, @CALLDATE, @PICKUP_DATE, @P' +
        'ICKUP_TIME,@CALL_BACK_NUMBER,'
      #9#9'@SMS_BODY, @NUMERORECETA, @RX_STATUS, @ORDER_ORIGINATION, '
      #9#9'@DATE_CREATED, @PICKUP_REMINDER, @PR_PATIENT_NAME,'
      
        #9#9'0, @CALLTIME, @EMAIL, @DOB, ISNULL(@SCAN_RX_LINK,0), ISNULL(@P' +
        'ATIENT_ID, 0));'
      #9#9'set @REFILL_QUERY_ID = SCOPE_IDENTITY();'
      #9'end;'
      '  COMMIT'
      'END;')
    Left = 5816
    Top = 896
  end
  object RX_REFILL_NOTIFIED: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE RX_REFILL_NOTIFIED '
      'AS'
      'DECLARE @DAYS_TO_Q INT'
      'DECLARE @DATE_ DATE'
      'declare @PAT_CLIENT_NUMBER int'
      'declare @RX_NUMBER INT'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'#9'       '
      
        #9#9'SELECT @DAYS_TO_Q = DAYS_TO_REFILL_REMIND FROM CREDITDEBITSETU' +
        'P'
      #9#9'SET @DATE_ = CAST(GETDATE()+@DAYS_TO_Q AS DATE);'#9' '#9
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT distinct PAT_CLIENT_NUMBER,' +
        ' RX_NUMBER'
      
        #9#9'FROM dbo.PRESCRIPTION_FULL WHERE (RX_NUMBER IS NOT NULL AND RX' +
        '_QTY_AVAILABLE > 0) and '
      
        #9#9'(RX_CONTROL = '#39'RX'#39') and CAST(RX_LAST_REFILL_DATE + DAYS_SUPPLY' +
        ' AS DATE) = @DATE_ and (@DATE_< (RX_DATE + 180)) '
      
        #9#9'and RX_ACTIVE = 1 and RX_REF_AUTHORIZED > 0 and NOTIFICATION_M' +
        'ODE_SMS = 1  '
      #9#9'and (REFILL_NOTIFIED is Null or REFILL_NOTIFIED = 0) and '
      #9#9'Claim_Status = 1 Order by PAT_CLIENT_NUMBER '
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @PAT_CLIENT_NUMBER, @RX_NUMBER'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      
        #9#9#9'UPDATE OTC SET REFILL_NOTIFIED = 1 WHERE NUMERORECETA = @RX_N' +
        'UMBER;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9'INTO @PAT_CLIENT_NUMBER, @RX_NUMBER'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor  '
      #9'commit;'
      'END')
    Left = 5816
    Top = 992
  end
