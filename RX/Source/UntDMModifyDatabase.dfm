      '         @BRANDSTR                 CHAR(1),'
      '         @TXR_EXTENSIONSTR         CHAR(14),'
      '         @IMAGE_CODESTR            CHAR(9))'
      'AS'
      'SET NOCOUNT ON'
      'begin'
      '  begin transaction'
      
        '  Insert into InventarioPiso (TIPO, COSTO, RBP, PRECIO, QTYINVEN' +
        'TARIO, NDC, CODIGOBARRA, FOODITEM, NONEBC,'
      
        '                           DESCRIPCION, CASA_FARMACEUTICA, ROUTE' +
        'OFADMINISTRATION,'
      
