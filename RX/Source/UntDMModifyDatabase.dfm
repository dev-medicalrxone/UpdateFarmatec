  object INSERT_ESIGNATURE: TFDQuery
    AfterExecute = INSERT_ESIGNATUREAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_ESIGNATURE]'
      '('
      '@ENCRIPPTED_SIGNATURE TEXT,'
      '@SIGNATURE_DATE DATE,'
      '@SIGNATURE_USER NCHAR(3),'
      '@PICKEDUP_BY_RELATION SMALLINT,'
      '@PICKEDUP_ID NCHAR(20),'
      '@NUMEROCLIENTE INT,'
      '@SAVE_PAT_SIGNATURE BIT,'
      '@PICKEDUP_BY NCHAR(45),'
      '@NORX BIGINT,'
      '@OTCNUMBER INT,'
      '@INSTANCIA INT,'
      '@SIGNATURE_LINK INT'
      ')'
      'AS'
      'DECLARE @TOKEN NCHAR(30)'
      'declare @Existingdate datetime'
      ''
      'SET NOCOUNT ON'
      'BEGIN '
      '  begin transaction'
      '    INSERT INTO [dbo].[PRESCRIPTION_ESIGNATURE]'
      '           ([ENCRIPPTED_SIGNATURE]'
      '           ,[SIGNATURE_DATE]'
      '           ,[SIGNATURE_USER]'
      '           ,[SIGNATURE_LINK]'
      '           ,[PICKEDUP_BY_RELATION]'
      '           ,[PICKEDUP_ID]'
      #9'   ,PICKEDUP_BY)'
      '     VALUES'
      '           (@ENCRIPPTED_SIGNATURE,'
      '           @SIGNATURE_DATE,'
      '           @SIGNATURE_USER,'
      '           @SIGNATURE_LINK,'
      '           @PICKEDUP_BY_RELATION,'
      '           @PICKEDUP_ID,'
      '           @PICKEDUP_BY)'
      ''
      #9'IF @SAVE_PAT_SIGNATURE = 1 '
      #9'begin'
      
        #9#9'UPDATE PACIENTES SET SIGNATURE_RX_LINK = @SIGNATURE_LINK WHERE' +
        ' NUMEROCLIENTE = @NUMEROCLIENTE AND SIGNATURE_RX_LINK IS NULL;'
      #9'end;'
      #9'Set @Existingdate=GETDATE()'#9#9
      #9'select FORMAT(@Existingdate,'#39'MM/dd/yyyy hh:mm:s tt'#39')'
      #9'SELECT @TOKEN = CONCAT(@SIGNATURE_USER, '#39' '#39', @Existingdate);'#9#9' '
      
        #9'DECLARE MyCursor CURSOR FOR SELECT NUMERORECETA, OTCNUMBER from' +
        ' PICK_UP where Instancia = @INSTANCIA;'
      #9'OPEN MyCursor'
      #9'FETCH NEXT FROM MyCursor'
      #9'INTO @NORX, @OTCNumber '
      #9'WHILE @@FETCH_STATUS = 0'
      #9'BEGIN'
      
        #9#9'Update OTC set Signature_link = @SIGNATURE_LINK, WF_SIGNATURE ' +
        '= @TOKEN where OTCNumber = @OTCNumber;'
      
        #9#9'EXECUTE INSERT_LOG '#39'PATIENT SIGNATURE CAPTURED'#39', '#39'A'#39', '#39#39', @SIG' +
        'NATURE_USER, '#39#39', @NORX, @OTCNUMBER,0,0,0,0,0,0,'#39'R'#39','#39#39',0,1;'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @NORX, @OTCNumber'
      #9'END'
      #9'CLOSE MyCursor'
      #9'DEALLOCATE MyCursor    '
      #9'Delete from Pick_up where Instancia = @Instancia;'
      #9'Delete from Pick_up where Fecha < GETDATE()-1;'
      '  commit;'
      'END;')
    Left = 992
    Top = 56
  end
  object INSERT_OTC: TFDQuery
    AfterExecute = INSERT_OTCAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_OTC]'
      '(@NDC  char(11),'
      ' @MEDICAMENTO  char(30),'
      ' @TOTAL  FLOAT,'
      ' @ATENDIDOPOR  char(3),'
      ' @COBRADO  char(1),'
      ' @FECHAOTC DATE,'
      ' @NUMERORECETA  bigint,'
      ' @RX  char(1),'
      ' @COSTOVENTA  real,'
      ' @QTY  real,'
      ' @NUMEROCLIENTE  int,'
      ' @MEDICAMENTOMIX  char(120),'
      ' @NUMEROTRANSACCION  int,'
      ' @PAGO_PLAN  float,'
      ' @DEDUCIBLE  float,'
      ' @NUMERO_AUTORIZACION  char(20),'
      ' @PARTIAL_COMPLETION  char(1),'
      ' @RX_STATUS  char(1),'
      ' @NO_REF_DISPENSADO  int,'
      ' @INGREDIENT_COST_PAID  float,'
      ' @INCENTIVE_FEE_PAID  float,'
      ' @DISPENSING_FEE_PAID  float,'
      ' @OTHER_AMOUNT_PAID  float,'
      ' @AMOUNT_COPAY_COINS  float,'
      ' @GANANCIA  float,'
      ' @PHARMACIST  char(3),'
      ' @DAYS_SUPPLY  int,'
      ' @PAGADA  char(1),'
      ' @PRECIOFACTURACION  float,'
      ' @PLAN_MEDICO  char(3),'
      ' @PRODUCT_ID  int,'
      ' @NO_HORA  int,'
      ' @NUMEROPLAN  int,'
      ' @LOTE CHAR(12),'
      ' @BATCH_REFILLREQ_DATE DATE,'
      ' @PRICE_TABLE_ID INTEGER,'
      ' @RX_OTC NCHAR(2),'
      ' @WF_TYPED NCHAR(30),'
      ' @MEZCLA_TRAN_NO int,'
      ' @FACILITY_ID int,'
      ' @FECHAULTIMOREFILL BIT,'
      ' @BATCH_NUMBER_BILLING INT,'
      ' @BATCH_NUMBER INT,'
      ' @INSTANCIA INT, '
      ' @IMPRIMIR BIT,'
      ' @GROSSAMOUNTDUE FLOAT,'
      ' @OTHERAMOUNTCLAIMEDSUBCOUNT int,'
      ' @OTAMCLDSUBCOUNTQUAL nchar(2),'
      ' @OTHERAMOUNTCLAIMEDSUB Float,'
      ' @CLAIM_STATUS INT,'
      ' @TERMINADA BIT,'
      ' @FECHAEXPIRACION DATE,'
      ' @DISPENSINGFEE float,'
      ' @COMPDOSAGE_FORM_DESC_CODE CHAR(2),'
      ' @COMPDISP_UNIT_FORM_INDI CHAR(1),'
      ' @DAW INT,'
      ' @OTHERCOVERAGECODE CHAR(1),'
      ' @ALCHEMY_PRODUCTID int,'
      ' @marketedproductid int,'
      ' @PLANESMEDICOSNO int,'
      ' @MESSAGEID NCHAR(40),'
      ' @OTCCurrent_Identity INT OUTPUT,'
      ' @ADHERENCE BIT,'
      ' @DELIVERY BIT,'
      ' @LEVEL_OF_SERVICE INT,'
      ' @GUID VARCHAR(36),'
      ' @UNIT_PRICE FLOAT,'
      ' @RELATED_OTC_NUMBER INT,'
      ' @PRODUCTSERVIDQUAL char(2),'
      ' @MedRestrict_ID int = 0'
      ')'
      'AS'
      'DECLARE @Current_Identity INTEGER;'
      'DECLARE @NOREFILL INTEGER;'
      'DECLARE @QTY_TO_INSERT FLOAT;'
      'DECLARE @CONTROLADO CHAR(4);'
      'DECLARE @PAPER_CLAIM bit;'
      'DECLARE @ISCONTROLLED BIT;'
      'DECLARE @TIME_RX datetime;'
      'DECLARE @OTCNUMBER INTEGER;'
      'DECLARE @INV_QTY_TODATE DECIMAL(18,2);'
      'DECLARE @SUB_CLARIF_CODE CHAR(2);'
      'DECLARE @MYREFILL_UPDATE_SMARTPICKUP BIT;'
      'SET NOCOUNT ON'
      'BEGIN'
      #9'begin transaction '
      
        #9'SELECT @MYREFILL_UPDATE_SMARTPICKUP = MYREFILL_UPDATE_SMARTPICK' +
        'UP FROM CREDITDEBITSETUP;'
      
        #9'set @TIME_RX = CONVERT(DATETIME, CONVERT(CHAR(8), @FECHAOTC, 11' +
        '2) + '#39' '#39' + CONVERT(CHAR(8), GETDATE(), 108))'
      
        #9'Select @CONTROLADO = CONTROLADO, @INV_QTY_TODATE = QTYINVENTARI' +
        'O FROM INVENTARIOPISO WHERE PRODUCTNO = @PRODUCT_ID;'
      #9'IF (RTRIM(@CONTROLADO) = '#39'RX'#39') or'
      #9'(RTRIM(@CONTROLADO) = '#39'OTC'#39') or'
      
        #9'(RTRIM(@CONTROLADO) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @IS' +
        'CONTROLLED = 1;'
      
        #9'SELECT @PAPER_CLAIM = PAPER_CLAIM, @SUB_CLARIF_CODE = SCC_420_D' +
        'K FROM PLANESMEDICOS WHERE PLANESMEDICOSNO = @PLANESMEDICOSNO;--' +
        'ABREVIATURA = @PLAN_MEDICO;'
      #9'IF @RX_STATUS = '#39'R'#39
      
        #9#9'Select @NOREFILL = count(*) + 1 from OTC where NumeroReceta = ' +
        '@NUMERORECETA and RX_STATUS = '#39'R'#39' AND PLAN_MEDICO <> '#39'CAS'#39' and R' +
        'X_STATUS <> '#39'P'#39
      #9'ELSE'
      #9#9'Select @NOREFILL = 0;'
      #9'IF ( @PLAN_MEDICO = '#39'CAS'#39' ) OR ( @PAPER_CLAIM = 1 )'
      #9#9'Select @QTY_TO_INSERT = @QTY'
      #9'else'
      #9#9'Select @QTY_TO_INSERT = 0;'
      '        if @RX_STATUS = '#39'C'#39
      ' '#9'begin'
      
        #9'  SELECT @OTCNUMBER =  MAX(OTCNUMBER) FROM OTC  where numerorec' +
        'eta = @NUMERORECETA; '
      
        #9'  select @NOREFILL = CODIGOREFILLNUEVO FROM OTC WHERE OTCNUMBER' +
        ' = @OTCNUMBER; '
      #9'end;'
      
        #9'INSERT INTO OTC (NDC, MEDICAMENTO, TOTAL, ATENDIDOPOR, COBRADO,' +
        ' FECHAOTC,'
      
        #9'NUMERORECETA, RX, COSTOVENTA, QTY, QTY_TEMP, METRICDECIMALQUANT' +
        'ITY, NUMEROCLIENTE, MEDICAMENTOMIX,  NUMEROTRANSACCION,'
      
        #9'PAGO_PLAN, DEDUCIBLE, NUMERO_AUTORIZACION, PARTIAL_COMPLETION, ' +
        'RX_STATUS, NO_REF_DISPENSADO,'
      
        #9'INGREDIENT_COST_PAID, INCENTIVE_FEE_PAID, DISPENSING_FEE_PAID, ' +
        'OTHER_AMOUNT_PAID, AMOUNT_COPAY_COINS,'
      
        #9'GANANCIA, PHARMACIST, DAYS_SUPPLY, PAGADA, PRECIOFACTURACION, P' +
