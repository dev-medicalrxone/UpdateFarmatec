        #9'  ESTADO, AUSPICIO, SOCIO, ORIENTACION, IDENTIFICACION, SMOKER,' +
        ' LOCATION, EMPLOYER_ID,'
      
        #9'  PATIENT_ID_QUAL, PREGNANCY_IDICATOR, DEUDA_WEB, LANGUAGE, INF' +
