  object INSERT_OTC_MEZCAS: TFDQuery
    AfterExecute = INSERT_OTC_MEZCASAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE Procedure [dbo].[INSERT_OTC_MEZCAS] @QTY CHAR(10), @MEDIC' +
        'AMENTO CHAR(30), @PRECIOVENTA REAL, @COSTO REAL, @NDC CHAR(11), ' +
        '@OTCNUMBER INT, @PRODUCT_ID INT, '
      
        '@TQTY REAL OUTPUT, @TPrecioVenta REAL OUTPUT, @TCosto REAL OUTPU' +
        'T, @TRx INT'
      'AS'
      'DECLARE @QTY_NEW DECIMAL(18,2)'
      'begin'
      #9'begin transaction'
      #9'SET @QTY_NEW = CAST(@QTY AS DECIMAL(18,2))'
      #9'INSERT INTO [dbo].[OTCMEZCLAS]'
      '           ([CANTIDADDESPACHADA]'
      '           ,[MEDICAMENTO]'
      '           ,[PRECIOVENTA]'
      '           ,[COSTO]'
      '           ,[NDC]'
      '           ,[NUMEROOTC]'
      '           ,[PRODUCT_ID])'
      '     VALUES'
      '           (@QTY_NEW'
      '           ,@MEDICAMENTO'
      '           ,@PRECIOVENTA'
      '           ,@COSTO'
      '           ,@NDC'
      '           ,@OTCNUMBER'
      '           ,@PRODUCT_ID)'
      
        #9'Select @TQty = Sum(CantidadDespachada), @TPrecioVenta = sum(Pre' +
        'cioVenta),  @TCosto = sum(Costo), @TRx = count(*) from OTCMezcla' +
        's where NumeroOTC = @OTCNUMBER;'
      
        #9'Select @TQTY = isNull(@TQTY + QTY,0), @TPrecioVenta = isNull(@T' +
        'PrecioVenta + TOTAL,0), @TCosto = isnull(@TCosto + COSTOVENTA,0)' +
        '  FROM OTC WHERE OTCNUMBER = @OTCNUMBER;'
      #9'commit;'
      'end;')
    Left = 4384
    Top = 392
  end
