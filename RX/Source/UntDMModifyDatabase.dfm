      '           ,[PRECIO_CAJA]'
      '           ,[QTY_CAJA]'
      '           ,[DESCUENTO]'
      '           ,[IMAGE_CODE]'
      '           ,[PACKAGESIZE]'
      '           ,[TXR_EXTENSION]'
      '           ,[STATUS]'
      '           ,[TAXABLE]'
      '           ,[TAXABLE_ESTATAL]'
      '           ,[PRECIO2]'
      '           ,[PO]'
      '           ,[isbn]'
      '           ,[SHOWINDIVIDUAL]'
      '           ,[PRECIO_DACO]'
      '           ,[NDC]'
      '           ,[METRIC_UNIT]'
      '           ,[ROBOT]'
      '           ,[ROBOT_NDC]'
      '           ,[PATROCINIO]'
      '           ,[COBRAR_TAX]'
      '           ,[ALCHEMY_PRODUCTID]'
      '           ,[MARKET_STATUS]'
      '           ,[OUTERPACKAGEUNIT]'
      '           ,[PAKAGE_ID]'
      '           ,[REVENUE_CODE]'
      '           ,[HCPCS]'
      '           ,[CASA_FARMACEUTICA]'
      '           ,[VERSION_DESCRIPTION]'
      '           ,[PAKAGE_DESCRIPTION]'
      '           ,[AllowControledRefills]'
      '           ,[PRECIOVENTA2]'
