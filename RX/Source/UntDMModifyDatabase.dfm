        'g frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42922'#39', N'#39'Extended Release' +
        ' Insert'#39', N'#39'An insert designed to release active and/or inert in' +
        'gredient(s) at a controlled prolonged rate so as to reduce dosin' +
        'g frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
