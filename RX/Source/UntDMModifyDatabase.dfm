        #9#9#9#9'if @GroupNumber > '#39#39' set @send_str += @FS + '#39'C1'#39'+ rtrim(uppe' +
        'r(@GroupNumber)); -- 3'#216'1-C1  '
      
        #9#9#9#9'if @medigap_id > '#39#39' set @send_str += @FS + '#39'2A'#39' + rtrim(uppe' +
        'r(@medigap_id)); -- 359-2A'
      #9#9#9'end'
      #9#9#9'else'
      #9#9#9'begin'#9#9#9#9
      
        #9#9#9#9'if @CardHolderID > '#39#39' set @send_str += @FS + '#39'C2'#39' + rtrim(up' +
        'per(@CardHolderID)); -- 3'#216'2-C2'
      
        #9#9#9#9'if @ch_first_name > '#39#39' set @send_str += @FS + '#39'CC'#39' + rtrim(u' +
        'pper(@ch_first_name)); -- 312-CC '
      
        #9#9#9#9'if @ch_last_name > '#39#39' set @send_str += @FS + '#39'CD'#39' + rtrim(up' +
        'per(@ch_last_name)); -- 313-CD'
      
