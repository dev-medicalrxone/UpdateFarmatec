        ') at a controlled prolonged rate so as to reduce dosing frequenc' +
        'y.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42918'#39', N'#39'Extended Release' +
