        #9'PERCENTAGE_SALES_TAX_SUB = @PERCENTAGE_SALES_TAX_SUB, PERCENTAG' +
        'E_SALES_TAX_RATE = @PERCENTAGE_SALES_TAX_RATE, '
      
        #9'PER_SALESTAX_BASIS_SUB = @PER_SALESTAX_BASIS_SUB, INCENTIVE_AMO' +
        'UNT_SUB = @INCENTIVE_AMOUNT_SUB,'
      
        '        OTHERAMOUNTCLAIMEDSUBCOUNT = @OTHERAMOUNTCLAIMEDSUBCOUNT' +
        ', OTAMCLDSUBCOUNTQUAL = @OTAMCLDSUBCOUNTQUAL, '
      
        #9'OTHERAMOUNTCLAIMEDSUB = @OTHERAMOUNTCLAIMEDSUB,  TOTAL = @PRECI' +
        'OVENTA, BASISOFCOST = @BASISOFCOST, '
      
        #9'GROSSAMOUNTDUE = @GROSSAMOUNTDUE, MEDICAID_PAID_AMOUNT = @MEDIC' +
        'AID_PAID_AMOUNT '
      #9'WHERE OTCNUMBER = @OTCNUMBER '
      #9'COMMIT;'
      'END')
    Left = 2512
    Top = 672
  end
