  object MedRestrict_Prescriber: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'MedRestr' +
        'ict_Prescriber'#39'  )'
