      '@UNIT_OF_MEASURE CHAR(2),'
      '@HCPCS_CODE NCHAR(11),'
      '@PRODUCTSERVIDQUAL CHAR(2)'
      'AS'
      'DECLARE @ISCONTROLLED BIT'
      ''
      'BEGIN'
      '  begin transaction'
      #9'IF (RTRIM(@CONTROLADO) = '#39'RX'#39') or'
      #9'(RTRIM(@CONTROLADO) = '#39'OTC'#39') or'
      
        #9'(RTRIM(@CONTROLADO) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @IS' +
        'CONTROLLED = 1; '
      '  IF @PRODUCTNO > 0  '
      '  BEGIN'
      #9'   UPDATE [dbo].[INVENTARIOPISO]'
      #9'   SET [TIPO] = @TIPO'
      #9#9'  ,[FECHA_EXPIRACION] = @FECHA_EXPIRACION'
