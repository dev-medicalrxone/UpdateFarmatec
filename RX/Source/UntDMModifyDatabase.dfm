object DMModifyDatabase: TDMModifyDatabase
  OnCreate = DataModuleCreate
  Height = 2012
  Width = 8030
  object QAlterViewRxControladas: TFDQuery
    AfterExecute = QAlterViewRxControladasAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'ALTER VIEW [dbo].[RXCONTROLADAS]'
      'AS'
      
        'SELECT        PACIENTES_1.NOMBRE, PACIENTES_1.CARDHOLDERID, PACI' +
        'ENTES_1.APELLIDOPATERNO, PACIENTES_1.APELLIDOMATERNO, PACIENTES_' +
        '1.TELEFONO, PACIENTES_1.NUMEROCLIENTE, '
      
        '                         PACIENTES_1.DIRECCION1, PACIENTES_1.DIR' +
        'ECCION2, PACIENTES_1.IDENTIFICACION, PACIENTES_1.FECHANACIMIENTO' +
        ', PACIENTES_1.SEXO, PACIENTES_1.CODIGOPOSTAL, OTC_1.NUMERORECETA' +
        ', '
      
        '                         OTC_1.MEDICAMENTO, OTC_1.NUMEROTRANSACC' +
        'ION, OTC_1.FECHAOTC AS FECHAVENTA, OTC_1.QTY AS CANTIDADDESPACHA' +
        'DA, OTC_1.PLAN_MEDICO AS PLANMEDICO, OTC_1.NDC, '
      
        '                         OTC_1.ATENDIDOPOR AS ATENDIDAPOR, OTC_1' +
        '.PRECIOFACTURACION, OTC_1.TOTAL AS PRECIOVENTA, OTC_1.DEDUCIBLE,' +
        ' OTC_1.DISPENSING_FEE_PAID AS DISPENSINGFEE, '
      
        '                         OTC_1.PAGO_PLAN AS PAGOPLAN, OTC_1.NO_R' +
        'EF_DISPENSADO AS NUMEROREFILLSDISPENSADOS, dbo.INVENTARIOPISO.PR' +
        'ODUCTNO, dbo.INVENTARIOPISO.TIPO, dbo.PRODUCTCODE.DESCRIPCION, '
      
        '                         dbo.INVENTARIOPISO.REVENUE_CODE, dbo.IN' +
        'VENTARIOPISO.HCPCS, dbo.INVENTARIOPISO.FECHA_EXPIRACION, OTC_1.U' +
        'NIT_PRICE'
      'FROM            dbo.PACIENTES AS PACIENTES_1 INNER JOIN'
      
        '                         dbo.OTC AS OTC_1 ON OTC_1.NUMEROCLIENTE' +
        ' = PACIENTES_1.NUMEROCLIENTE INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON OTC_1.PRODUCT_ID ' +
        '= dbo.INVENTARIOPISO.PRODUCTNO INNER JOIN'
      
        '                         dbo.PRODUCTCODE ON dbo.INVENTARIOPISO.T' +
        'IPO = dbo.PRODUCTCODE.CODE'
      '')
    Left = 328
    Top = 232
  end
