        'X],[REVENUE_CODE],[DAW]'
      
        '           ,[BATCH_NUMBER_BILLING],[TERMINADA],[MEDICAID_PAID_AM' +
        'OUNT],[PMC_459_ER],[PMCC_458_SE]'
      
        '           ,[SPIDN_454_EK],[IATID_463_EW],[CONTROLADO],[DAYS_SUP' +
        'LY],[CODIGOREFILLNUEVO],[RXNUMBERSRNQ]'
      
        '           ,[TRANSACTION_CODE],[MEDICAMENTOORIGINAL],[ROBOT],[LA' +
        'BEL_NAME],[FECHAEXPIRACION],[IMPRIMIR]'
      
        '           ,[INSTANCIA],[ORG_PROS_PROD_SERVID],[ORG_PRESC_QTY],[' +
