  object UPDATE_BILLING_REJECTED_RX: TFDQuery
    AfterExecute = UPDATE_BILLING_REJECTED_RXAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_BILLING_REJECTED_RX] @GUID NCHAR(' +
        '36)'
      'AS'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9#9'-- HARD STOP: do not run if GUID is NULL or blank'
      #9#9'IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9#9'BEGIN'
      
        #9#9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or ' +
        'blank.'#39', 16, 1);'
      #9#9#9'RETURN;'
      #9#9'END;'
      
        #9#9'Update OTC set CLAIM_STATUS = 0 where GUID = @GUID AND CLAIM_S' +
        'TATUS = 2;'
      #9'COMMIT;'
      'END;')
    Left = 5632
    Top = 696
  end
