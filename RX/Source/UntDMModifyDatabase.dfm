  object ADD_EDIT_USERS_RX: TFDQuery
    AfterExecute = ADD_EDIT_USERS_RXAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[ADD_EDIT_USERS_RX] @ACTIVATE bit, @USERN' +
        'AME VARCHAR(35),'
      '@INICIALES VARCHAR(3), @ANADIRRECETAS bit,'
      '@HISTORIALRECETAS bit, @REPORTES bit, @INVENTARIORX bit,'
      '@DOCTORES bit, @PACIENTES bit, @OTC bit, @SUPLIDORES bit,'
      '@PEDIDOSMERCANCIA bit, @THIRDPARTY bit, @CAMBIARPASSWORD bit,'
      '@SETUP bit, @BORRARRECETAS bit, @BORRARINVENTARIO bit,'
      
        '@BORRARPACIENTE bit, @BORRAR_CANTIDA_RX bit, @REVERSAL bit, @BOR' +
        'RARRECETAS_CASH bit,'
      
        '@QUICKENTRY bit, @DUR bit, @BORRAR_FIRMA bit, @CAPTURAR_FIRMA bi' +
        't, @CONFIGURAR_SCANNER bit,'
      
        '@BACKUP_PERMIT bit, @BORRAR_PAT_PLAN bit, @MERGE_PAT_DOC bit, @L' +
        'OG_DATA bit,@EDITAR_NOMBRE bit,'
      
        '@RPT_POS bit, @RPT_RECETARIO bit, @RPT_INVENTARIO bit, @RPT_CLIE' +
        'NTES bit, @RPT_RECONCILIACION bit,'
      
        '@CELULAR nchar(13), @HOME_PHONE nchar(13), @ADDRESS1 nchar(30), ' +
        '@ADDRESS2 nchar(30), @CITY nchar(20), @ZIP_CODE nchar(15),'
      
        '@STATE nchar(2), @MERGE_INV_QTY bit, @SIGNATURE text, @PHARMACIS' +
        'T BIT, '
      '@EDITAR_INVENTARIO bit, @CAMBIARCOSTOYPRECIOVENTA bit '
      
        ',@SETUP_PRINTERS bit,@SETUP_SETUP bit,@SETUP_LABEL bit,@SETUP_IN' +
        'TERNET_BILLING bit'
      
        ',@SETUP_MISCELLANEOUS bit ,@SETUP_SURESCRIPT bit,@SETUP_CONFIGUR' +
        'ATION bit, @BORRAR_EPRESCRIBE bit,@ACTIVE bit'
      
        ',@BORRAR_RXTEMP1 bit,@RX_CHANGE_REFILL bit,@RX_CAMBIARPRECIO_RX ' +
        'bit,@PASSWORD_COL nchar(30),@WORKFLOW bit'
      
        ',@FACTURAS_WESCOM bit,@RX_ATIVE bit,@RX_NO_EDIT_HISTORY bit,@RX_' +
        'EDIT_SIG bit,@OVERRIDE_GENERIC bit,@RX_CHANGE_QTY bit'
      
        ',@APPRISS bit,@PHARMACIST_NPI varchar(15),@TIME_CARD bit,@DAILY_' +
        'EMAIL_REPORTS bit,@EMAIL varchar(80),@RECALL_LOCKED_RX bit'
      
        ',@RX_CONTROLLED_ANOTATE bit,@RX_CONTROLLED_MODIFY bit,@RX_CONTRO' +
        'LLED_DELETE bit,@RX_RECALL_EPRESRIBE_HIST bit,@RX_SEC_LEVEL smal' +
        'lint'
      
        ',@CONTROLLED_SUBSTANCE bit,@RX_COTROLLED_LOG bit,@ADMINISTRATOR ' +
        'bit,@USERNO int,@USER CHAR(3),@NOTE VARCHAR(MAX)'
      
        ',@RX_UPDATE_INV_BROWSE BIT, @MAIN_ACCTS bit, @RX_PRESCRIPTION_NO' +
        'TE bit, @PHARMACIST_LICENCE CHAR(15), @HOLD_RECALL_EPRESCRIBE bi' +
        't'
      
        ',@RX_CHANGE_ORIGINCODE bit, @RX_CHANGE_PRICETABLE bit, @INV_CHAN' +
        'GE_FACILITY bit, @LTC bit'
      'AS'
      'BEGIN'
      '   BEGIN TRANSACTION'
      '   if @ACTIVATE = 1'
      '   begin'
      #9#9'Update Passwords set Active = @ACTIVE where userno = @USERNO;'
      
        #9#9'EXECUTE INSERT_LOG '#39'USER ACTIVATED'#39', '#39'M'#39', '#39#39', @USER,  '#39#39', 0,0,' +
        '0,0,0,0,0,0,'#39'R'#39', @NOTE,0,1;'
      '   end'
      '   else'
      '   begin'
      #9'if @USERNO > 0 '
      #9'begin'
      #9#9'UPDATE [dbo].[PASSWORDS]'
