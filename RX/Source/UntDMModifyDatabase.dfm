  object cdsPriceTable: TClientDataSet
    Aggregates = <>
    Params = <>
    ProviderName = 'dspPriceTable'
    AfterPost = cdsPriceTableAfterPost
    BeforeDelete = cdsPriceTableAfterPost
    Left = 280
    Top = 656
