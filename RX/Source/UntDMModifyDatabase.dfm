        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42968'#39', N'#39'Patch'#39', N'#39'A soli' +
        'd composed of an impermeable occlusive backing and a formulation' +
        ' matrix in which the active and/or inert ingredient(s) are disso' +
        'lved or dispersed; possibly includes an adhesive layer.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69042'#39', N'#39'Pediatric Liquid' +
        #39', N'#39'A solution or suspension intended for use in children.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64887'#39', N'#39'Pediatric Suppos' +
        'itory'#39', N'#39'A suppository intended for administration to children.' +
        #39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42969'#39', N'#39'Pellet'#39', N'#39'A sol' +
        'id composed of a small granular or compressed mass that contains' +
        ' highly purified active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42636'#39', N'#39'Pharmaceutical'#39',' +
        ' N'#39'The form in which active and/or inert ingredient(s) are physi' +
        'cally presented.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C25394'#39', N'#39'Pill'#39', N'#39'A solid' +
        ' composed of a small round object composed of active and/or iner' +
        't ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42970'#39', N'#39'Plaster'#39', N'#39'A se' +
        'mi-solid composed of a soft smooth mass with relatively thick co' +
        'nsistency and strong adhesiveness that becomes solid when dry.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42736'#39', N'#39'Polymeric Micros' +
        'phere'#39', N'#39'Polymeric microspheres composed of biocompatible polym' +
        'er that contains active and/or inert ingredient(s) designed for ' +
        'release at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47913'#39', N'#39'Poultice'#39', N'#39'A s' +
        'emi-solid composed of a soft moist mass that is made by wetting ' +
        'an absorbent solid substance.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42972'#39', N'#39'Powder'#39', N'#39'A sol' +
        'id composed of a mixture of dry finely divided active and/or ine' +
        'rt ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42971'#39', N'#39'Powder Aerosol'#39',' +
        ' N'#39'A powder composed of active and/or inert ingredient(s) and pa' +
        'ckaged under pressure. Ingredients are released upon activation ' +
        'of an appropriate valve system.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42977'#39', N'#39'Powder for Injec' +
        'table Extended Release Suspension'#39', N'#39'A powder intended for inje' +
        'ction following reconstitution to form a suspension that is desi' +
        'gned to release active and/or inert ingredient(s) at a controlle' +
        'd prolonged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42974'#39', N'#39'Powder for Injec' +
        'table Solution'#39', N'#39'A powder intended for injection following rec' +
        'onstitution to form a solution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42976'#39', N'#39'Powder for Injec' +
        'table Suspension'#39', N'#39'A powder intended for injection following r' +
        'econstitution to form a suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69069'#39', N'#39'Powder for Injec' +
        'tion'#39', N'#39'A powder intended for injection following reconstitutio' +
        'n to form a solution or suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64907'#39', N'#39'Powder for Oral ' +
        'Solution'#39', N'#39'A powder that yields a solution intended for oral a' +
        'dministration following reconstitution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64908'#39', N'#39'Powder for Oral ' +
        'Suspension'#39', N'#39'A powder that yields a suspension intended for or' +
        'al administration following reconstitution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69070'#39', N'#39'Powder for Recon' +
        'stitution'#39', N'#39'A powder mixed with a liquid to form a solution or' +
        ' suspension before administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
