    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[REFILL_VALUESD0]'
      '@NO_TRANS integer, '
      
        '@TCosto FLOAT OUTPUT, @TPrecioVenta FLOAT OUTPUT, @TAWP FLOAT OU' +
        'TPUT,'
      '@TQTY FLOAT OUTPUT, @TRX INTEGER OUTPUT'
      'AS'
      'begin'
      '  begin transaction'
      
        '  select @TQTY = sum(CANTIDADDESPACHADA), @TCosto = SUM(Costo), ' +
        '@TPrecioVenta = Sum(PrecioVenta), @TRx = COUNT(*),  @TAWP = Sum(' +
        'AWP)  from MEZCLAS where NO_TRANS = @NO_TRANS;'
      '  commit'
      'end;')
    Left = 1312
    Top = 392
  end
  object SCANED_RX_LINK: TFDQuery
    AfterExecute = SCANED_RX_LINKAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[SCANED_RX_LINK] @SCANED_RX_LINK INTEGER ' +
        'OUTPUT'
      'AS'
      'begin'
      '  begin transaction'
      '  Update NEXT_RXNUMBER SET SCANED_RX_LINK = SCANED_RX_LINK + 1;'
      '  Select @SCANED_RX_LINK = (SCANED_RX_LINK) FROM NEXT_RXNUMBER;'
      '  commit'
      'end')
    Left = 1312
    Top = 488
  end
  object SENDTOHISTORY: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SENDTOHISTORY] ('
      
        '    @NORX            BIGINT,           -- kept for compatibility' +
        ' (not used for per-row log)'
      '    @ATENDIDAPOR     CHAR(3),'
      '    @PHARMACIST      CHAR(3),'
      '    @OTCNUMBER       INT = NULL,'
      '    @POST_DATE       DATE,'
      '    @CLAIM_STATUS    INT,'
      '    @MessageID       VARCHAR(50) = NULL,'
      '    @NUMEROCLIENTE   INT,'
      '    @GUID            VARCHAR(36) = NULL,'
      ''
      '    -- Safety controls (batch is typically 10'#8211'15)'
      '    @MAX_MATCHES     INT = 25,          -- NULL = no cap'
      
        '    @DRY_RUN         BIT = 0            -- 1 = no updates, only ' +
        'show matches'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    -- Prevent matching guid = '#39#39' (common mass-update cause)'
      '    SET @GUID = NULLIF(LTRIM(RTRIM(@GUID)), '#39#39');'
      ''
      '    -- Require a selector'
      '    IF (@OTCNUMBER IS NULL AND @GUID IS NULL)'
      
        '        THROW 50001, '#39'SENDTOHISTORY requires @OTCNUMBER (single)' +
        ' or @GUID (batch).'#39', 1;'
      ''
      '    -- If both supplied, prefer SINGLE (safer) and ignore GUID'
      '    IF (@OTCNUMBER IS NOT NULL AND @GUID IS NOT NULL)'
      '        SET @GUID = NULL;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      
        '        IF OBJECT_ID('#39'tempdb..#Targets'#39') IS NOT NULL DROP TABLE ' +
        '#Targets;'
      ''
      
        '        -- Build target set (single by OTCNUMBER OR batch by GUI' +
        'D)'
      '        SELECT'
      '            o.OTCNUMBER,'
      '            o.NUMERORECETA,'
      '            o.NUMEROCLIENTE,'
      '            o.CLAIM_STATUS'
      '        INTO #Targets'
      '        FROM dbo.OTC o WITH (HOLDLOCK)'
      
        '        WHERE (@OTCNUMBER IS NOT NULL AND o.OTCNUMBER = @OTCNUMB' +
        'ER)'
      '           OR (@GUID      IS NOT NULL AND o.[GUID]    = @GUID);'
      ''
      
        '        DECLARE @MatchCount INT = (SELECT COUNT(*) FROM #Targets' +
        ');'
      ''
      '        IF (@MatchCount = 0)'
      
        '            THROW 50002, '#39'No OTC rows matched the selector. Abor' +
        'ting.'#39', 1;'
      ''
      
        '        IF (@MAX_MATCHES IS NOT NULL AND @MatchCount > @MAX_MATC' +
        'HES)'
      
        '            THROW 50003, '#39'Safety stop: too many OTC rows matched' +
        ' for this batch. Aborting.'#39', 1;'
      ''
      '        DECLARE @EligibleCount INT ='
      
        '            (SELECT COUNT(*) FROM #Targets WHERE CLAIM_STATUS NO' +
        'T IN (1,91,9,51));'
      ''
      '        /* DRY RUN */'
      '        IF (@DRY_RUN = 1)'
      '        BEGIN'
      '            SELECT'
      
        '                CASE WHEN @OTCNUMBER IS NOT NULL THEN '#39'SINGLE (O' +
        'TCNUMBER)'#39
      '                     ELSE '#39'BATCH (GUID)'#39' END AS Mode,'
      '                @MatchCount     AS MatchedOTCRows,'
      '                @EligibleCount  AS EligibleOTCUpdates,'
      '                MIN(OTCNUMBER)  AS MinOTCNUMBER,'
      '                MAX(OTCNUMBER)  AS MaxOTCNUMBER'
      '            FROM #Targets;'
      ''
      '            SELECT'
      
        '                OTCNUMBER, NUMERORECETA, NUMEROCLIENTE, CLAIM_ST' +
        'ATUS'
      '            FROM #Targets'
      '            ORDER BY OTCNUMBER;'
      ''
      '            ROLLBACK TRANSACTION;'
      '            RETURN;'
      '        END;'
      ''
      '        /* 1) PRESCRIPTIONS update (set-based) */'
      '        UPDATE p'
      '        SET p.NumeroCliente = @NUMEROCLIENTE'
      '        FROM dbo.PRESCRIPTIONS p'
      '        JOIN (SELECT DISTINCT NUMERORECETA FROM #Targets) t'
      '          ON t.NUMERORECETA = p.NUMERORECETA'
      '        WHERE p.NumeroCliente = 0;'
      ''
      '        DECLARE @Rows_Prescriptions INT = @@ROWCOUNT;'
      ''
      '        /* 2) OTC update (set-based) */'
      '        UPDATE o'
      '        SET o.[GUID] = '#39#39','
      '            o.QTY = 0,'
      '            o.TOTAL = 0,'
      '            o.PRECIOFACTURACION = 0,'
      '            o.TERMINADA = 1,'
      '            o.COSTOVENTA = 0,'
      '            o.IMPRIMIR = 0,'
      '            o.BILL_LATTER = 1,'
      '            o.FECHAOTC = @POST_DATE,'
      '            o.TIME_RX = @POST_DATE,'
      '            o.CLAIM_STATUS = @CLAIM_STATUS,'
      '            o.RECORD_LOCKED = 0'
      '        FROM dbo.OTC o'
      '        JOIN #Targets t ON t.OTCNUMBER = o.OTCNUMBER'
      '        WHERE o.CLAIM_STATUS NOT IN (1,91,9,51);'
      ''
      '        DECLARE @Rows_OTC INT = @@ROWCOUNT;'
      ''
      '        /* 3) Related tables (set-based) */'
      '        UPDATE s'
      '        SET s.Rx_Status = 1'
      '        FROM dbo.Surescripts s'
      '        JOIN (SELECT DISTINCT NUMERORECETA FROM #Targets) t'
      '          ON t.NUMERORECETA = s.RxReferenceNumber;'
      ''
      '        DECLARE @Rows_Surescripts INT = @@ROWCOUNT;'
      ''
      '        UPDATE m'
      '        SET m.CANTIDADDESPACHADA = 0'
      '        FROM dbo.Mezclas m'
      '        JOIN #Targets t ON t.OTCNUMBER = m.OTCNumber;'
      ''
      '        DECLARE @Rows_Mezclas INT = @@ROWCOUNT;'
      ''
      
        '        /* 4) Per-prescription logging + per-prescription extra ' +
        'updates (if desired)'
      '              Your original proc also did:'
      
        '                UPDATE Surescripts ... WHERE RxReferenceNumber =' +
        ' @NORX_LOCAL;'
      '                UPDATE Mezclas ... WHERE OTCNumber = @rxid;'
      
        '              We already did those set-based above, but logging ' +
        'must be per row.'
      '        */'
      '        DECLARE @rxid INT, @NORX_LOCAL BIGINT;'
      ''
      '        DECLARE cur CURSOR LOCAL FAST_FORWARD FOR'
      '            SELECT OTCNUMBER, NUMERORECETA'
      '            FROM #Targets'
      '            ORDER BY OTCNUMBER;'
      ''
      '        OPEN cur;'
      '        FETCH NEXT FROM cur INTO @rxid, @NORX_LOCAL;'
      ''
      '        WHILE @@FETCH_STATUS = 0'
      '        BEGIN'
      '            -- '#9989' Log per prescription / per OTC row'
      '            EXEC dbo.INSERT_LOG'
      
        '                '#39'Sent to history'#39', '#39'M'#39', '#39#39', @ATENDIDAPOR, @PHARM' +
        'ACIST,'
      '                @NORX_LOCAL,      -- <-- IMPORTANT: per-row NORX'
      '                @rxid,            -- OTCNUMBER'
      '                0, @NUMEROCLIENTE,'
      '                0, 0, 0, 0, '#39'R'#39', '#39#39', 0, 1;'
      ''
      '            FETCH NEXT FROM cur INTO @rxid, @NORX_LOCAL;'
      '        END'
      ''
      '        CLOSE cur;'
      '        DEALLOCATE cur;'
      ''
      '        COMMIT TRANSACTION;'
      ''
      '        /* Summary */'
      '        SELECT'
      
        '            CASE WHEN @OTCNUMBER IS NOT NULL THEN '#39'SINGLE (OTCNU' +
        'MBER)'#39
      '                 ELSE '#39'BATCH (GUID)'#39' END AS Mode,'
      '            @MatchCount           AS MatchedOTCRows,'
      '            @EligibleCount        AS EligibleOTCUpdates,'
      '            @Rows_OTC             AS UpdatedOTCRows,'
      '            @Rows_Prescriptions   AS UpdatedPrescriptionRows,'
      '            @Rows_Surescripts     AS UpdatedSurescriptsRows,'
      '            @Rows_Mezclas         AS UpdatedMezclasRows;'
      ''
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;'
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 1320
    Top = 648
  end
  object TRANSACTIONDETAIL_CANCELTRANS: TFDQuery
    AfterExecute = TRANSACTIONDETAIL_CANCELTRANSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[TRANSACTIONDETAIL_CANCELTRANS] @TRANNO I' +
        'NT'
      'AS'
      'SET NOCOUNT ON'
      'BEGIN  '
      #9'begin transaction'
      #9'if @TRANNO > 1'
      #9'begin'
      
        #9#9'delete from TRANSACTIONHEADER_TEMP where TRANSACTIONNUMBER = @' +
        'TRANNO;'
      
        #9#9'DELETE FROM TRANSACTIONDETAIL_TEMP WHERE TransactionNumber = @' +
        'TRANNO;'
      
        #9#9'UPDATE TRANSACTIONHEADER SET VOIDED = 1 WHERE TRANSACTIONNUMBE' +
        'R = @TRANNO;'
      
        #9#9'UPDATE TRANSACTIONDETAIL SET VOIDED = 1 WHERE TRANSACTIONNUMBE' +
        'R = @TRANNO;'
      #9#9'Delete From CLIENTTRANSACTIONS where TransNo = @TRANNO;'
      #9#9'Exec CANCEL_TABS @TRANNO; '
      #9#9'end;'
      #9'commit'
      'END')
    Left = 1312
    Top = 720
  end
  object TRANSACTIONDETAIL_DELETE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE  PROCEDURE [dbo].[TRANSACTIONDETAIL_DELETE] @REGISTER INT' +
        ', @TNUMBER INT'
      'AS'
      'DECLARE @ID INT'
      'DECLARE @QTY FLOAT'
      'DECLARE @PRODUCTID INT'
      '  SET NOCOUNT ON'
      'BEGIN'
      '  begin transaction'
      '  INSERT INTO TRANSACTIONHEADER'
      '   SELECT *'
      
        '   FROM TRANSACTIONHEADER_TEMP WHERE TRANSACTIONNUMBER = @TNUMBE' +
        'R;'
      
        '  DELETE FROM TRANSACTIONHEADER_TEMP WHERE TRANSACTIONNUMBER = @' +
        'TNUMBER;'
      '  INSERT INTO TRANSACTIONDETAIL'
      
        '    SELECT * FROM TRANSACTIONDETAIL_TEMP WHERE TRANSACTIONNUMBER' +
        ' = @TNUMBER;'
      
        '  DELETE FROM TRANSACTIONDETAIL_TEMP WHERE OPENED = '#39'T'#39' AND TRAN' +
        'SACTIONNUMBER = @TNUMBER;   '
      
        '  --DELETE FROM TRANSACTIONHEADER_TEMP WHERE OPENED <> '#39'S'#39' AND O' +
        'PENED <> '#39'H'#39' AND TRANSACTIONNUMBER = @TNUMBER;'
      
        '  --DELETE FROM TRANSACTIONHEADER_TEMP WHERE OPENED <> '#39'S'#39' AND O' +
        'PENED <> '#39'H'#39' and TRANSACTIONDATE < dateadd(day, -4, getdate());'
      
        '  --DELETE FROM TRANSACTIONDETAIL_TEMP WHERE OPENED <> '#39'S'#39' AND O' +
        'PENED <> '#39'H'#39' and FECHAVENTA < dateadd(day, -4, getdate());'
      '  Exec CANCEL_TABS @TNUMBER;'
      '  commit'
      'END;')
    Left = 1320
    Top = 800
  end
  object TRANSACTIONDETAIL_DELETE_PRODUCT: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[TRANSACTIONDETAIL_DELETE_PRODUCT] @IDNUM' +
        'BER INT, @NO_RX INT, @TRIPLES_BALANCE real output, @DBName nchar' +
        '(20)  '
      'AS'
      '  set nocount on'
      '  DECLARE @TRANS_NO INTEGER;'
      '  DECLARE @MAIN_COURSE_ID INTEGER;'
      '  DECLARE @PRODUCT_NO INTEGER;'
      '  DECLARE @HAS_MODIFIER BIT;'
      '  DECLARE @OTCNUMBER Integer;'
      '  DECLARE @RECORDCOUNT INTEGER;'
      '  DECLARE @BAG_NUMBER INT;'
      '  DECLARE @SQL NVARCHAR(500);'
      ''
      'BEGIN'
      #9'begin transaction    '
      
        #9#9'SELECT @OTCNUMBER = OTC_NUMBER, @BAG_NUMBER = BAG_NUMBER, @TRA' +
        'NS_NO = TransactionNumber, @PRODUCT_NO = PRODUCTNO, @MAIN_COURSE' +
        '_ID = MAIN_COURSE_ID FROM TRANSACTIONDETAIL_TEMP WHERE IDNUMBER ' +
        '= @IDNUMBER;'
      
        #9#9'SELECT @HAS_MODIFIER = HAS_MODIFIER FROM INVENTARIOPISO WHERE ' +
        'PRODUCTNO = @PRODUCT_NO; '
      #9#9'IF @HAS_MODIFIER = 1'
      #9#9'begin'
      
        #9#9#9'DELETE FROM TRANSACTIONDETAIL_TEMP WHERE MAIN_COURSE_ID = @MA' +
        'IN_COURSE_ID;'
      
        #9#9#9'--DELETE FROM TRANSACTIONDETAIL WHERE MAIN_COURSE_ID = @MAIN_' +
        'COURSE_ID;'
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      
        #9#9#9'DELETE FROM TRANSACTIONDETAIL_TEMP WHERE IDNUMBER = @IDNUMBER' +
        ';'
      #9#9#9'--DELETE FROM TRANSACTIONDETAIL WHERE IDNUMBER = @IDNUMBER;'
      #9#9'end;'
      
        #9#9'SELECT @RECORDCOUNT = COUNT(*) FROM TRANSACTIONDETAIL_TEMP WHE' +
        'RE TRANSACTIONNUMBER = @TRANS_NO;'
      #9#9'IF @RECORDCOUNT = 0'
      #9#9'begin'
      #9#9#9'Exec CANCEL_TABS @TRANS_NO; '
      #9#9'end;'#9#9
      #9#9'set @TRIPLES_BALANCE = 0;'
      
        #9#9'exec CALC_TRIPLES_TAX @TRANS_NO, @TOTAL_BALANCE_PLUS_TAX = @TR' +
        'IPLES_BALANCE OUTPUT;'
      #9#9'IF @BAG_NUMBER > 0'
      #9#9'BEGIN'
      
        #9#9'   UPDATE WILLCALL SET POS_PICKUP = 0 WHERE OTC_NUMBER = @OTCN' +
        'UMBER;'#9#9'   '
      #9#9'END;'
      #9#9'IF @OTCNUMBER > 0'
      #9#9'begin'
      
        #9#9'  SET @SQL = '#39'Update ['#39' + @DBName + '#39'].dbo.OTC set WF_CASHIER ' +
        '= NULL, Cobrado = NULL, WC_PICKUP = 0, SIGNATURE_LINK = 1  where' +
        ' OTCNumber = @OTCNUMBER'#39';'
      #9#9'  Exec sp_executesql @SQL, N'#39'@OTCNUMBER INTEGER'#39', @OTCNUMBER;'
      #9#9'end;'
      #9'commit'
      'END')
    Left = 1328
    Top = 872
  end
  object TRANSACTIONDETAIL_UPDATEPRICE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[TRANSACTIONDETAIL_UPDATEPRICE] @IDNUMBER' +
        ' INT, @TRANSNO INT, @PRODUCTNO INT, @PRICE FLOAT, @QTY FLOAT, @T' +
        'AXRATE FLOAT, @SUPER CHAR(3), @UPDATE_PRICE BIT'
      'AS'
      'DECLARE @PRODUCT_COUNT FLOAT'
      'DECLARE @ID_ONFILE INT'
      'DECLARE @TAX_RATE FLOAT;'
      'DECLARE @PREV_PRICE DECIMAL(18,2)'
      'DECLARE @SALESMAN NCHAR(3)'
      'DECLARE @COMMISSION1 DECIMAL(18,2)'
      'DECLARE @COMMISSION2 DECIMAL(18,2)'
      'DECLARE @COMMISSION3 DECIMAL(18,2)'
      'DECLARE @PRICE1 DECIMAL(18,2)'
      'DECLARE @PRICE2 DECIMAL(18,2)'
      'DECLARE @PRICE3 DECIMAL(18,2)'
      'DECLARE @COMMISSION_VALUE FLOAT'
      'DECLARE @TOTAL_VALUE FLOAT'
      'DECLARE @IS_COMMISSION_ACTIVE BIT'
      'SET NOCOUNT ON'
      'BEGIN'
      #9'begin transaction'
      
        #9'    Select @IS_COMMISSION_ACTIVE = ACTIVE_COMMISSIONS from CRED' +
        'ITDEBITSETUP;'
      #9#9'IF @IS_COMMISSION_ACTIVE = 1 '
      #9#9'begin'
      
        #9#9'  Exec @COMMISSION_VALUE = dbo.CALC_COMMISSION @PRODUCTNO, @PR' +
        'ICE, @QTY;'
      '              end'
      #9#9'else'
      #9#9'begin'
      #9#9'  Select @COMMISSION_VALUE = 0; '
      #9#9'end; '
      
        #9#9'IF (SELECT @TAXRATE) > 0  SELECT @TOTAL_VALUE = ISNULL((@Price' +
        ' * @QTY) * @TaxRate,  0);'
      
        #9#9'UPDATE TransactionDetaiL SET PRICE = @PRICE, TOTAL = @PRICE * ' +
        '@QTY, TOTAL_VALUE = @TOTAL_VALUE,'
      #9#9'QTY = @QTY, SUPERVISOR = @SUPER'
      #9#9'Where IDNUMBER = @IDNUMBER;'
      
        #9#9'UPDATE TransactionDetaiL_TEMP SET PRICE = @PRICE, TOTAL = @PRI' +
        'CE * @QTY,'
      
        #9#9'QTY = @QTY, SUPERVISOR = @SUPER, COMMISSION = @COMMISSION_VALU' +
        'E'
      #9#9'Where IDNUMBER = @IDNUMBER;'
      #9#9'IF @UPDATE_PRICE = 1'
      #9#9'begin'
      
        #9#9'  Update INVENTARIOPISO set PRECIO = @PRICE WHERE PRODUCTNO = ' +
        '@PRODUCTNO;'
      #9#9'end;'
      #9'commit'
      'END')
    Left = 1432
    Top = 64
  end
