  object UPDATE_PRESCRIPTIONS_NOCLIENTE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_PRESCRIPTIONS_NOCLIENTE] (@NOCLIE' +
        'NTETO   INTEGER,'
      '         @NOCLIENTEFROM INTEGER,'
      #9#9' @ATENDIDAPOR CHAR(3),'
      #9#9' @PHARMACIST char(3),'
      #9#9' @DELETE_PATIENT BIT,'
      #9#9' @UPDATE_PAT_PAN BIT)'
      'AS'
      ' DECLARE @NOTE VARCHAR(MAX)'
      ' DECLARE @CUSTOMERFROM NCHAR(45)'
      ' DECLARE @CUSTOMERTO NCHAR(45)'
      ' SET NOCOUNT ON'
      ''
      'begin'
      '  begin transaction'
      
        '  SELECT @CUSTOMERFROM = CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39' , RT' +
        'RIM(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE)) from PACIENTES WHERE N' +
        'UMEROCLIENTE = @NOCLIENTEFROM; '
      
        '  SELECT @CUSTOMERTO = CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39' , RTRI' +
        'M(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE)) from PACIENTES WHERE NUM' +
        'EROCLIENTE = @NOCLIENTETO; '
      
        '  SET @NOTE = CONCAT('#39'PATIENT '#39', @CUSTOMERFROM, '#39' PRESCRIPTIONS ' +
        'TRANSFERED TO '#39', @CUSTOMERTO); '
      
        '  Update Prescriptions set NumeroCliente = @NoclienteTo where Nu' +
        'meroCliente = @NoClienteFrom;'
      
        '  Update OTC set NUMEROCLIENTE = @NoclienteTo where NumeroClient' +
        'e = @NoClienteFrom;'
      
        '  EXECUTE INSERT_LOG '#39'MERGED ALL PATIENT DATA'#39', '#39'M'#39', @NOCLIENTET' +
        'O, @ATENDIDAPOR,  @PHARMACIST, @NoClienteFrom,0,0, @NOCLIENTETO,' +
        '0,0,0,0,'#39'R'#39',@NOTE,0,1; '
      '  IF @UPDATE_PAT_PAN = 1 '
      '  begin'
      
        '    Update PatPlan set NumeroCliente = @NoclienteTo Where Numero' +
        'Cliente = @NoClienteFrom;'
      
        #9'EXECUTE INSERT_LOG '#39'HELTH PLAN MERGED'#39', '#39'M'#39', 0, @ATENDIDAPOR,  ' +
        '@PHARMACIST, @NoClienteFrom, 0,0,@NoclienteTo,0,0,0,0,'#39'R'#39',@NOTE,' +
        '0,1;'
      '  end;'
      '  IF @DELETE_PATIENT = 1'
      '  begin'
      
        '    delete from pacientes where numerocliente = @NoClienteFrom; ' +
        '  '
      '    Delete from patplan where numerocliente = @NoClienteFrom;'
      
        '    EXECUTE INSERT_LOG '#39'PATIENT AND HELTH PLAN DELETED'#39', '#39'D'#39', 0,' +
        ' @ATENDIDAPOR,  @PHARMACIST, 0, 0,0,@NoClienteFrom,0,0,0,0,'#39'R'#39',@' +
        'NOTE,0,1;'
      '  end;'
      '  commit'
      'end')
    Left = 1488
    Top = 480
  end
  object UPDATE_PRESCRIPTIONS_NORX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_PRESCRIPTIONS_NORX] (@NORX BIGINT' +
        ','
      '         @NOCLIENTEFROM INTEGER,'
      '         @NOCLIENTETO   INTEGER,'
      #9#9' @ATENDIDAPOR CHAR(3),'
      #9#9' @PHARMACIST char(3))'
      'AS'
      ' DECLARE @NOTE VARCHAR(MAX)'
      ' DECLARE @CUSTOMERFROM NCHAR(45)'
      ' DECLARE @CUSTOMERTO NCHAR(45)'
      ' SET NOCOUNT ON'
      'begin'
      '  begin transaction'
      
        #9'SELECT @CUSTOMERFROM = CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39' , RTR' +
        'IM(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE)) from PACIENTES WHERE NU' +
        'MEROCLIENTE = @NOCLIENTEFROM; '
      
        #9'SELECT @CUSTOMERTO = CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39' , RTRIM' +
        '(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE)) from PACIENTES WHERE NUME' +
        'ROCLIENTE = @NOCLIENTETO; '
      
        #9'SET @NOTE = CONCAT('#39'PATIENT '#39', @CUSTOMERFROM, '#39' PRESCRIPTIONS T' +
        'RANSFERED TO '#39', @CUSTOMERTO); '
      
        #9'Update Prescriptions set NumeroCliente = @NoclienteTo where Num' +
        'eroCliente = @NoClienteFrom and NumeroReceta = @NoRx;'
      
        #9'Update OTC set NUMEROCLIENTE = @NoclienteTo where NumeroReceta ' +
        '= @NoRx;'
      
        #9'EXECUTE INSERT_LOG '#39'MERGED SINGLE PATIENT DATA'#39', '#39'M'#39', '#39#39', @ATEN' +
        'DIDAPOR,  @PHARMACIST, @NORX, 0,0,@NoClienteFrom,0,0,0,0,'#39'R'#39',@NO' +
        'TE,0,1;'
      '  commit'
      'end')
    Left = 1496
    Top = 568
  end
  object UPDATE_RX_REJECTED: TFDQuery
    AfterExecute = UPDATE_RX_REJECTEDAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_RX_REJECTED] (@NUMERORECETA BIGIN' +
        'T, @OTCNUMBER INTEGER, @WF_BILLED nchar(30), '
      '@USER CHAR(3), @PHARMACIST CHAR(3), @REJECTED_FROM CHAR(30))'
      'AS'
      'DECLARE @CONTROLLED CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @CUSTOMERID INT'
      'DECLARE @PRODUCTID INT'
      'DECLARE @MAXOTCNUMBER INT'
      'DECLARE @FECHAULTIMOREFILL DATETIME'
      'DECLARE @CLAIM_SATUS INT'
      'SET NOCOUNT ON'
      'begin'
      #9'begin transaction'
      
        #9#9'SELECT @MAXOTCNUMBER = MAX(OTCNUMBER) from OTC WHERE CLAIM_STA' +
        'TUS = 1 AND NUMERORECETA = @NUMERORECETA;'
      
        #9#9'SELECT  @FECHAULTIMOREFILL = FECHAOTC FROM OTC WHERE OTCNUMBER' +
        ' = @MAXOTCNUMBER; '
      
        #9#9'SELECT @CONTROLLED = CONTROLADO, @CUSTOMERID = NUMEROCLIENTE, ' +
        '@PRODUCTID = PRODUCT_ID, @CLAIM_SATUS = CLAIM_STATUS FROM OTC WH' +
        'ERE OTCNUMBER = @OTCNUMBER;'
      #9#9'IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9#9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9#9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @I' +
        'SCONTROLLED = 1;'
      #9#9'if @CLAIM_SATUS <> 1'
      #9#9'begin'
      
        #9#9#9'UPDATE OTC SET CLAIM_STATUS = 2, WF_BILLED = @WF_BILLED, ATEN' +
        'DIDOPOR = @USER, PHARMACIST = @PHARMACIST'
      #9#9#9'WHERE OTCNUMBER = @OTCNUMBER AND PLAN_MEDICO <> '#39'CAS'#39';'
      #9#9#9'if @CUSTOMERID > 0'
      #9#9#9'begin'
      
        #9#9#9#9'UPDATE PRESCRIPTIONS SET NUMEROCLIENTE = @CUSTOMERID, FECHAU' +
        'LTIMOREFILL = @FECHAULTIMOREFILL WHERE NUMERORECETA = @NUMEROREC' +
        'ETA;'#9#9
      #9#9#9'end'
      #9#9#9'else'
      #9#9#9'begin'
      
        #9#9#9#9'UPDATE PRESCRIPTIONS SET FECHAULTIMOREFILL = @FECHAULTIMOREF' +
        'ILL WHERE NUMERORECETA = @NUMERORECETA;'
      #9#9#9'end;'
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      
        #9#9'  update otc set RECORD_LOCKED = 0, GUID = '#39#39', INSTANCIA = 0, ' +
        'BATCH_NUMBER_BILLING = 0 where OTCNUMBER = @OTCNUMBER; '
      #9#9'end;'
      #9'commit'
      #9'begin transaction'
      
        #9#9'EXEC INSERT_LOG  @REJECTED_FROM, '#39'U'#39', '#39#39', @USER, @PHARMACIST, ' +
        '@NUMERORECETA, @OTCNUMBER,0,@CUSTOMERID,0,0,0,@PRODUCTID,'#39'R'#39','#39'Pr' +
        'escription was Rejected'#39',@ISCONTROLLED,1;'
      #9'commit'
      'end;')
    Left = 1496
    Top = 648
  end
  object UPDATE_RX_REVERSAL: TFDQuery
    AfterExecute = UPDATE_RX_REVERSALAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_RX_REVERSAL] (@OTCNUMBER INTEGER,' +
        ' @NoAutho nchar(20), @ATENDIDAPOR NCHAR(3), @REVERSEDFROM CHAR(3' +
        '0), @SIGNATURE_LINK INT)'
      'AS'
      'SET NOCOUNT ON'
      'DECLARE @NORX BIGINT'
      'DECLARE @FECHA_VENTA DATE'
      'DECLARE @PLAN_MEDICO NCHAR(3)'
      'DECLARE @NUMEROAUTO NCHAR(20)'
      'DECLARE @MEDICAMENTO NCHAR(35)'
      'DECLARE @QTY FLOAT'
      'DECLARE @PRODUCTID INT'
      'DECLARE @MyField INT;'
      'Declare @MEZCLA_TRAN_NO int'
      'DECLARE @DAYSSUPPLY INT'
      'DECLARE @PHARMACIST NCHAR(3)'
      'DECLARE @NDC NCHAR(11)'
      'DECLARE @FECHAULTIMOREFILL DATETIME'
      'DECLARE @MAXOTCNUMBER INT'
      'DECLARE @RX_STATUS CHAR(1)'
      'DECLARE @CONTROLLED CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @WF_CANCEL_CHECKED_ONREVERSAL BIT'
      ''
      'begin'
      '  begin transaction'
      
        '    EXEC dbo.INVENTORY_CONTROL @OTC_NUMBER = @OTCNUMBER, @LABEL_' +
        'NAME = '#39#39', @IMPRIMIR = 0, @PRINTER_ID = 0, @REVERSAL = 1, @PRINT' +
        'ER_IP = '#39#39';'
      
        '    Select @NORX = NUMERORECETA, @DAYSSUPPLY = DAYS_SUPPLY, @QTY' +
        ' = QTY, '
      
        '    @MEZCLA_TRAN_NO = MEZCLA_TRAN_NO, @FECHA_VENTA = FECHAOTC, @' +
        'PRODUCTID = PRODUCT_ID,'
      
        '    @PLAN_MEDICO = SUBSTRING (PLAN_MEDICO,1,3), @MEDICAMENTO = S' +
        'UBSTRING (MEDICAMENTO,1,35),'
      '    @PHARMACIST = PHARMACIST, @CONTROLLED = CONTROLADO '
      '    FROM OTC WITH (NOLOCK) WHERE OTCNUMBER = @OTCNUMBER;'
      '    IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @IS' +
        'CONTROLLED = 1;'
      
        '    EXECUTE INSERT_LOG @REVERSEDFROM, '#39'U'#39', @NDC, @ATENDIDAPOR,  ' +
        '@PHARMACIST, @NORX, @OTCNUMBER,0,0,0,0,0,@PRODUCTID,'#39'R'#39','#39#39',@ISCO' +
        'NTROLLED,1;'
      '  COMMIT;'
      '  begin transaction'
      
        '    SELECT @WF_CANCEL_CHECKED_ONREVERSAL = WF_CANCEL_CHECKED_ONR' +
        'EVERSAL FROM CREDITDEBITSETUP;'
      #9'if @WF_CANCEL_CHECKED_ONREVERSAL = 1'
      #9'BEGIN '
      
        #9#9'UPDATE OTC SET ATENDIDOPOR = @ATENDIDAPOR, NUMERO_AUTORIZACION' +
        ' = @NoAutho, PAGO_PLAN = 0, INGREDIENT_COST_PAID = 0, SIGNATURE_' +
        'LINK = @SIGNATURE_LINK,'
      
        #9#9'INCENTIVE_FEE_PAID = 0, DISPENSING_FEE_PAID = 0, AMOUNT_COPAY_' +
        'COINS = 0, WF_CHECKED = '#39#39', GUID = '#39#39','
      
        #9#9'CLAIM_STATUS = 3, QTY = 0, DEDUCIBLE = 0, IMPRIMIR = 0, RECORD' +
        '_LOCKED = 0  WHERE OTCNUMBER = @OTCNUMBER;'
      #9'END'
      #9'ELSE'
      #9'BEGIN'
      
        #9#9'UPDATE OTC SET ATENDIDOPOR = @ATENDIDAPOR, NUMERO_AUTORIZACION' +
        ' = @NoAutho, PAGO_PLAN = 0, INGREDIENT_COST_PAID = 0, SIGNATURE_' +
        'LINK = @SIGNATURE_LINK,'
      
        #9#9'INCENTIVE_FEE_PAID = 0, DISPENSING_FEE_PAID = 0, AMOUNT_COPAY_' +
        'COINS = 0, GUID = '#39#39','
      
        #9#9'CLAIM_STATUS = 3, QTY = 0, DEDUCIBLE = 0, IMPRIMIR = 0, RECORD' +
        '_LOCKED = 0  WHERE OTCNUMBER = @OTCNUMBER;'
      #9'END;'
      '  COMMIT;'
      '  begin transaction'
      
        '    INSERT INTO REVERSAL_LOG([USUARIO],[FECHA_VENTA],[FECHA_REVE' +
        'RSAL],[PLANMEDICO]'
      '           ,[NUMEROAUTORIZACION],[MEDICAMENTO],[NUMERORECETA])'
      '     VALUES'
      '           (@ATENDIDAPOR,@FECHA_VENTA,GETDATE(),@PLAN_MEDICO,'
      '           @NoAutho,@MEDICAMENTO,@NORX);'
      '  commit'
      'end;')
    Left = 1504
    Top = 728
  end
  object UPDATE_RXTEMP1_MEZCLA: TFDQuery
    AfterExecute = UPDATE_RXTEMP1_MEZCLAAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_RXTEMP1_MEZCLA]('
      '    @PRECIOVENTA FLOAT,'
      '    @COSTOVENTA FLOAT,'
      '    @PRECIOFACTURACION FLOAT,'
      '    @METRICQUANTITY FLOAT,'
      '    @CANTIDAD FLOAT,'
      '    @CANTIDADRECETADA FLOAT,'
      '    @METRICDECIMALQUANTITY FLOAT,'
      '    @MEDICAMENTOMIX1 TEXT,'
      '    @GROSSAMOUNTDUE FLOAT,'
      '    @BASISOFCOST CHAR(2),'
      '    @NUMERORECETA BIGINT,'
      '    @CDFDC CHAR(2),'
      '    @CRA CHAR(2),'
      '    @CDUFI CHAR(1),'
      '    @CICC Int,'
      '    @ROUTEOFADMIN NCHAR(11),'
      '    @MEZCLA_TRAN_NO'#9'INTEGER,'
      '    @NOT_PLAN BIT,'
      '    @DISPENSINGFEE FLOAT,'
      '    @OTCNUMBER INT,'
      '    @UPDATE_RX BIT)'
      'AS'
      'DECLARE @QTY FLOAT'
      'SET NOCOUNT ON'
      'BEGIN'
      ' begin transaction '
      
        '   if @NOT_PLAN = 1 SELECT @QTY = @CANTIDAD ELSE SELECT @QTY = 0' +
        ';'
      
        '   UPDATE OTC SET TOTAL = @PRECIOVENTA, COSTOVENTA = @COSTOVENTA' +
        ', PRECIOFACTURACION = @PRECIOFACTURACION,  '
      
        '   QTY_TEMP = @CANTIDAD, METRICDECIMALQUANTITY = @METRICDECIMALQ' +
        'UANTITY, QTY = @QTY, '
      '   GROSSAMOUNTDUE = @GROSSAMOUNTDUE, BASISOFCOST = @BASISOFCOST,'
      
        '   COMPDOSAGE_FORM_DESC_CODE = @CDFDC, COMPROUTE_OF_ADMINISTRATI' +
        'ON = @CRA,'
      
        '   COMPDISP_UNIT_FORM_INDI = @CDUFI, COMPING_COMP_COUNT = @CICC,' +
        ' '
      
        '   ROUTEOFADMIN_995_E2 = @ROUTEOFADMIN, MEZCLA_TRAN_NO = @MEZCLA' +
        '_TRAN_NO,'
      '   DISPENSINGFEE = @DISPENSINGFEE  '
      '   WHERE OTCNUMBER = @OTCNUMBER;'
      '   IF @UPDATE_RX = 1'
      '   begin'
      
        '     Update PRESCRIPTIONS set cantidadrecetada = @CANTIDADRECETA' +
        'DA, COMPOUNDCODE = 2 where NUMERORECETA = @NUMERORECETA;'
      '   end;'
      ' commit'
      'END')
    Left = 1680
    Top = 488
  end
  object UPDATE_WC_STATUS: TFDQuery
    AfterExecute = UPDATE_WC_STATUSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_WC_STATUS]'
      
        '(@NOTIFICATION INTEGER, @NOTIFICATIONMODE NCHAR(10), @ID INTEGER' +
        ')'
      'AS'
      'SET NOCOUNT ON'
      'BEGIN'
      '  begin transaction'
      '  IF @NOTIFICATION = 0'
      
        '    Update WillCall_Status set NOTIFICATION0 = 1, NOTIFICATION0_' +
        'DATE = SYSDATETIME(), NOTIFICATION0_MODE = @NOTIFICATIONMODE Whe' +
        're ID = @ID'
      '  IF @NOTIFICATION = 1'
      
        '    Update WillCall_Status set Reminder1 = 1, REMINDER1_DATE = S' +
        'YSDATETIME(), R1_NOTIFICATION_MODE = @NOTIFICATIONMODE Where ID ' +
        '= @ID'
      '  IF @NOTIFICATION = 2'
      
        '    Update WillCall_Status set Reminder2 = 1, REMINDER2_DATE = S' +
        'YSDATETIME(), R2_NOTIFICATION_MODE = @NOTIFICATIONMODE Where ID ' +
        '= @ID'
      '  IF @NOTIFICATION = 3'
      
        '    Update WillCall_Status set Reminder3 = 1, REMINDER3_DATE = S' +
        'YSDATETIME(), R3_NOTIFICATION_MODE = @NOTIFICATIONMODE Where ID ' +
        '= @ID'
      '  commit'
      'END')
    Left = 1504
    Top = 904
  end
  object WILLCALL_DELETE: TFDQuery
    AfterExecute = WILLCALL_DELETEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[WILLCALL_DELETE] @TNUMBER INT, @ID INT'
      'AS'
      'Declare @NoRecords int'
      'Set NOCOUNT ON'
      'begin'
      '  begin transaction '
      '  INSERT INTO WillCallHistory'
      '    SELECT * FROM WillCall WHERE TRANSACTION_NUMBER = @TNUMBER;'#9
      '    DELETE FROM WILLCALL WHERE TRANSACTION_NUMBER = @TNUMBER; '#9
      
        #9'SELECT @NoRecords = COUNT(*) from WillCall where BATCH_NUMBER =' +
        ' @ID;  '
      #9'IF @NoRecords = 0 '
      #9'begin'
      #9'  DELETE FROM WILLCALL_STATUS WHERE ID = @ID; '
      
        #9'  UPDATE WILLCALL_STATUS_HISTORY SET STATUS = 1, DATE_PICKUP_RT' +
        'S = GETDATE() WHERE ID = @ID;'
      '    end;'
      '  commit'
      'END')
    Left = 1808
    Top = 72
  end
