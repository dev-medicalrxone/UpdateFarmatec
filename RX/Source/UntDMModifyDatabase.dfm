  object GET_ACTIVE_PATIENT_NDCS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE OR ALTER PROCEDURE dbo.GET_ACTIVE_PATIENT_NDCS'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @AsOfDate      DATE = NULL,   -- default: today'
      
        '    @GraceDays     INT  = 3        -- allow a few days late refi' +
        'lls'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF @AsOfDate IS NULL'
      '        SET @AsOfDate = CONVERT(date, GETDATE());'
      ''
      '    ;WITH last_fill AS'
      '    ('
      '        SELECT'
      '            o.NUMERORECETA,'
      '            o.NDC,'
      '            o.FECHAOTC,'
      '            o.DAYS_SUPPLY,'
      '            rn = ROW_NUMBER() OVER'
      '                 ('
      '                    PARTITION BY o.NUMERORECETA'
      '                    ORDER BY o.FECHAOTC DESC, o.OTCNUMBER DESC'
      '                 )'
      '        FROM dbo.OTC o'
      '        WHERE o.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND o.NDC IS NOT NULL'
      '          AND LTRIM(RTRIM(o.NDC)) <> '#39#39
      '          AND o.FECHAOTC IS NOT NULL'
      '          AND ISNULL(o.DAYS_SUPPLY, 0) > 0'
      
        '          -- Optional: exclude reversed/voided transactions (adj' +
        'ust codes)'
      '          -- AND ISNULL(o.RX_STATUS,'#39#39') NOT IN ('#39'R'#39','#39'V'#39','#39'X'#39')'
      '    ),'
      '    current_rx AS'
      '    ('
      '        SELECT'
      '            lf.NDC,'
      
        '            RunOutDate = DATEADD(DAY, lf.DAYS_SUPPLY - 1, CONVER' +
        'T(date, lf.FECHAOTC))'
      '        FROM last_fill lf'
      '        WHERE lf.rn = 1'
      '    )'
      '    SELECT DISTINCT'
      '        c.NDC'
      '    FROM current_rx c'
      '    WHERE c.RunOutDate >= DATEADD(DAY, -@GraceDays, @AsOfDate)'
      '    ORDER BY c.NDC;'
      'END')
    Left = 6960
    Top = 472
  end
  object fn_GetBatchClinicalSignatureHash: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE function dbo.fn_GetBatchClinicalSignatureHash'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @GUID VARCHAR(50)'
      ')'
      'RETURNS VARCHAR(128)'
      'AS'
      'BEGIN'
      '    DECLARE @RAW NVARCHAR(MAX);'
      '    DECLARE @HASH VARBINARY(64);'
      ''
      '    SELECT @RAW ='
      '      STUFF(('
      '        SELECT '#39'||'#39' + CAST(A.ALERT_KEY AS NVARCHAR(MAX))'
      '        FROM dbo.RX_CLINICAL_ALERT A'
      '        WHERE A.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND A.GUID = @GUID'
      '          AND A.REVIEW_REQUIRED = 1'
      '          AND ISNULL(A.RESOLVED, 0) = 0'
      '        ORDER BY A.ALERT_KEY'
      '        FOR XML PATH('#39#39'), TYPE'
      '      ).value('#39'.'#39', '#39'nvarchar(max)'#39'), 1, 2, '#39#39');'
      ''
      '    IF @RAW IS NULL OR LTRIM(RTRIM(@RAW)) = '#39#39
      '      RETURN NULL;'
      ''
      '    SET @HASH = HASHBYTES('#39'SHA2_256'#39', @RAW);'
      ''
      '    RETURN CONVERT(VARCHAR(128), @HASH, 2);'
      'END')
    Left = 6960
    Top = 624
  end
