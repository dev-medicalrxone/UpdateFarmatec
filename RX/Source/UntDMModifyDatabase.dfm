        'ion'#39', N'#39'A powder that yields a solution following reconstitution' +
        ' with an appropriate liquid.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42975'#39', N'#39'Powder for Suspe' +
        'nsion'#39', N'#39'A powder that forms a suspension when reconstituted wi' +
        'th a liquid solution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91139'#39', N'#39'Powder Inhaler'#39',' +
        ' N'#39'Powder intended for oral inhalation.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68983'#39', N'#39'Powder Like Non-' +
        'Effervescent Granule'#39', N'#39'A granule composed of a mixture of smal' +
        'l (powder like) dry particles or grains which does not have the ' +
        'ability to release gas upon contact with water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91179'#39', N'#39'Prefilled Applic' +
        'ator'#39', N'#39'Active and/or inert ingredients in an applicator delive' +
        'red as a single measured dose.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C97717'#39', N'#39'Pre-filled Pen S' +
        'yringe'#39', N'#39'Pre-filled Pen Syringe'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91180'#39', N'#39'Prefilled Syring' +
        'e'#39', N'#39'A solution or suspension intended to be injected in a syri' +
        'nge cartridge or pen.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68972'#39', N'#39'Pudding'#39', N'#39'A se' +
        'mi-solid having a relatively thick consistency intended for oral' +
