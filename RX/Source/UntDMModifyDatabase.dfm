      #9#9#9',[NUMEROSUPLIDOR] '
      #9#9#9',[SUB_DEPARTAMENTO] '
      #9#9#9',[DESCRIPCION] '
      #9#9#9',[ROUTEOFADMINISTRATION] '
      #9#9#9',[CONTROLADO] '
      #9#9#9',[STRENGTH] '
      #9#9#9',[INFOADICIONAL] '
      #9#9#9',[METRICSIZE] '
      #9#9#9',[GENERICNAME] '
      #9#9#9',[BRAND] '
      #9#9#9',[RECETARIO] '
      #9#9#9',[PACKAGESIZE] '
      #9#9#9',[STATUS] '
      #9#9#9',[NDC] '
      #9#9#9',[ROBOT] '
      #9#9#9',[ROBOT_NDC] '
      #9#9#9',[REVENUE_CODE] '
      #9#9#9',[HCPCS] '
      #9#9#9',[CASA_FARMACEUTICA] '
      #9#9#9',[AllowControledRefills] '
      #9#9#9',[PRICE_TABLE_ID] '
      #9#9#9',[OVERRIDE_SYSTEM_DEFAULT_PRICE] '
      #9#9#9',[WAC_PRICE] '
      #9#9#9',[MAC_PRICE] '
      #9#9#9',[DIRECT_PRICE] '
