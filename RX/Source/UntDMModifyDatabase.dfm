  object OTC_DeleteCleanup: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER dbo.OTC_DeleteCleanup'
      'ON dbo.OTC'
      'AFTER DELETE'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF NOT EXISTS (SELECT 1 FROM deleted)'
      '        RETURN;'
      ''
      '    -- Create temp table'
      '    CREATE TABLE #d ('
      '        OTCNUMBER INT,'
      '        NUMERORECETA BIGINT'
      '    );'
      ''
      '    INSERT INTO #d (OTCNUMBER, NUMERORECETA)'
      '    SELECT DISTINCT OTCNUMBER, NUMERORECETA'
      '    FROM deleted;'
      ''
      '    -- OTCNUMBER-based deletes'
      
        '    DELETE t FROM dbo.RXDATA t JOIN #d d ON d.OTCNUMBER = t.OTCN' +
        'UMBER;'
      
        '    DELETE t FROM dbo.CLINICAL_SEGMENT t JOIN #d d ON d.OTCNUMBE' +
        'R = t.OTCNUMBER;'
      
        '    DELETE t FROM dbo.CLINICAL_SEGMENT_INFO t JOIN #d d ON d.OTC' +
        'NUMBER = t.OTCNUMBER;'
      
        '    DELETE t FROM dbo.PRIOR_AUTH t JOIN #d d ON d.OTCNUMBER = t.' +
        'OTCNUMBER;'
      
        '    DELETE t FROM dbo.FACILITY_ID t JOIN #d d ON d.OTCNUMBER = t' +
        '.OTCNUMBER;'
      
        '    DELETE t FROM dbo.PROCEDURE_MODIFIER_CODE t JOIN #d d ON d.O' +
        'TCNUMBER = t.OTCNUMBER;'
      
        '    DELETE t FROM dbo.DUR_PPS t JOIN #d d ON d.OTCNUMBER = t.OTC' +
        'NUMBER;'
      
        '    DELETE t FROM dbo.COB_A t JOIN #d d ON d.OTCNUMBER = t.OTCNU' +
        'MBER;'
      
        '    DELETE t FROM dbo.COB_OTHERPAYMENT t JOIN #d d ON d.OTCNUMBE' +
        'R = t.OTCNUMBER;'
      
        '    DELETE t FROM dbo.SUB_CLARIFICATION_CODE t JOIN #d d ON d.OT' +
        'CNUMBER = t.OTCNUMBER;'
      ''
      '    -- NUMERORECETA-based deletes'
      
        '    DELETE t FROM dbo.DISPILL t JOIN #d d ON d.NUMERORECETA = t.' +
        'NUMERORECETA;'
      
        '    DELETE t FROM dbo.Prescriptions_ByPhone t JOIN #d d ON d.NUM' +
        'ERORECETA = t.RXNUM;'
      'END')
    Left = 488
    Top = 144
  end
  object NDC9_INGREDIENT_MAP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'NDC9_ING' +
        'REDIENT_MAP'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[NDC9_INGREDIENT_MAP]('
      #9'[NDC9] [char](9) NOT NULL,'
      #9'[IngredientId] [int] NOT NULL,'
      #9'[IngredientName] [varchar](200) NOT NULL,'
      #9'[CreatedAt] [datetime2](7) NOT NULL,'
      #9'[UpdatedAt] [datetime2](7) NOT NULL,'
      #9'[CreatedBy] [varchar](50) NULL,'
      #9'[UpdatedBy] [varchar](50) NULL,'
      #9'[Source] [varchar](30) NOT NULL,'
      ' CONSTRAINT [PK_NDC9_INGREDIENT_MAP] PRIMARY KEY CLUSTERED '
      '('
      #9'[NDC9] ASC,'
      #9'[IngredientId] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY];'
      ''
      
        'ALTER TABLE [dbo].[NDC9_INGREDIENT_MAP] ADD  CONSTRAINT [DF_NDC9' +
        '_ING_CreatedAt]  DEFAULT (sysdatetime()) FOR [CreatedAt];'
      
        'ALTER TABLE [dbo].[NDC9_INGREDIENT_MAP] ADD  CONSTRAINT [DF_NDC9' +
        '_ING_UpdatedAt]  DEFAULT (sysdatetime()) FOR [UpdatedAt];'
      
        'ALTER TABLE [dbo].[NDC9_INGREDIENT_MAP] ADD  CONSTRAINT [DF_NDC9' +
        '_ING_Source]  DEFAULT ('#39'GoldStandard'#39') FOR [Source];'
      'end;')
    Left = 6936
    Top = 80
  end
  object UpsertNdc9Ingredient: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UpsertNdc9Ingredient]'
      '  @NDC9 char(9),'
      '  @IngredientId int,'
      '  @IngredientName varchar(200),'
      '  @User varchar(50) = NULL'
      'AS'
      'BEGIN'
      '  SET NOCOUNT ON;'
      ''
      '  BEGIN TRY'
      
        '    INSERT dbo.NDC9_INGREDIENT_MAP (NDC9, IngredientId, Ingredie' +
        'ntName, CreatedAt, UpdatedAt, CreatedBy, UpdatedBy, Source)'
      
        '    VALUES (@NDC9, @IngredientId, @IngredientName, sysdatetime()' +
        ', sysdatetime(), @User, @User, '#39'GoldStandard'#39');'
      '  END TRY'
      '  BEGIN CATCH'
      '    IF ERROR_NUMBER() IN (2601, 2627) -- duplicate key'
      '    BEGIN'
      '      UPDATE dbo.NDC9_INGREDIENT_MAP'
      '      SET IngredientName = @IngredientName,'
      '          UpdatedAt = sysdatetime(),'
      '          UpdatedBy = @User'
      '      WHERE NDC9 = @NDC9 AND IngredientId = @IngredientId;'
      '    END'
      '    ELSE'
      '      THROW;'
      '  END CATCH'
      'END;')
    Left = 6944
    Top = 176
  end
  object WC_CHECK_ACTIVE_DUPLICATE_INGREDIENTS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE   PROCEDURE [dbo].[WC_CHECK_ACTIVE_DUPLICATE_INGREDIENTS]'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @NewNDC        VARCHAR(20),'
      '    @AsOfDate      DATE = NULL,'
      '    @GraceDays     INT  = 0'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF @AsOfDate IS NULL'
      '        SET @AsOfDate = CAST(GETDATE() AS date);'
      ''
      
        '    -- Basic cleanup (handles most real-world inputs: hyphens/sp' +
        'aces)'
      '    DECLARE @NewNDC_Clean VARCHAR(30) ='
      
        '        REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(@NewNDC)), '#39'-'#39', '#39#39'),' +
        ' '#39' '#39', '#39#39'), '#39'.'#39', '#39#39');'
      ''
      '    DECLARE @NewNDC9 CHAR(9) = LEFT(@NewNDC_Clean, 9);'
      ''
      '    IF @NewNDC9 IS NULL OR LEN(@NewNDC9) < 9'
      '    BEGIN'
      '        SELECT TOP 0'
      '            OTCNUMBER = CAST(NULL AS INT),'
      '            FECHAOTC = CAST(NULL AS DATETIME),'
      '            NUMEROCLIENTE = CAST(NULL AS INT),'
      '            NUMERORECETA = CAST(NULL AS BIGINT),'
      '            MEDICAMENTO = CAST(NULL AS VARCHAR(100)),'
      '            NDC9 = CAST(NULL AS CHAR(9)),'
      '            DAYS_SUPPLY = CAST(NULL AS INT),'
      '            CoverageEndDate = CAST(NULL AS DATE),'
      '            MatchedIngredientId = CAST(NULL AS INT),'
      '            MatchedIngredientName = CAST(NULL AS VARCHAR(200));'
      '        RETURN;'
      '    END;'
      ''
      '    ;WITH NewDrugIngredients AS ('
      '        SELECT DISTINCT IngredientId'
      '        FROM dbo.NDC9_INGREDIENT_MAP'
      '        WHERE NDC9 = @NewNDC9'
      '    ),'
      '    ActivePatientOTC AS ('
      '        SELECT'
      '            o.OTCNUMBER,'
      '            o.FECHAOTC,'
      '            o.NUMEROCLIENTE,'
      '            o.NUMERORECETA,'
      '            o.MEDICAMENTO,'
      
        '            NDC_Clean = REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(o.ND' +
        'C)), '#39'-'#39', '#39#39'), '#39' '#39', '#39#39'), '#39'.'#39', '#39#39'),'
      '            o.DAYS_SUPPLY'
      '        FROM dbo.OTC o'
      '        WHERE o.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND o.NDC IS NOT NULL'
      '          AND o.QTY > 0'
      '          AND ISNULL(o.DAYS_SUPPLY, 0) > 0'
      '    ),'
      '    ActivePatientOTC2 AS ('
      '        SELECT'
      '            a.OTCNUMBER,'
      '            a.FECHAOTC,'
      '            a.NUMEROCLIENTE,'
      '            a.NUMERORECETA,'
      '            a.MEDICAMENTO,'
      '            NDC9 = LEFT(a.NDC_Clean, 9),'
      '            a.DAYS_SUPPLY,'
      
        '            CoverageEndDate = DATEADD(DAY, (a.DAYS_SUPPLY - 1) +' +
        ' @GraceDays, CAST(a.FECHAOTC AS date))'
      '        FROM ActivePatientOTC a'
      '        WHERE LEN(a.NDC_Clean) >= 9'
      
        '          AND @AsOfDate <= DATEADD(DAY, (a.DAYS_SUPPLY - 1) + @G' +
        'raceDays, CAST(a.FECHAOTC AS date))'
      '    )'
      '    SELECT DISTINCT'
      '        a.OTCNUMBER,'
      '        a.FECHAOTC,'
      '        a.NUMEROCLIENTE,'
      '        a.NUMERORECETA,'
      '        a.MEDICAMENTO,'
      '        a.NDC9,'
      '        a.DAYS_SUPPLY,'
      '        a.CoverageEndDate,'
      '        MatchedIngredientId   = m2.IngredientId,'
      '        MatchedIngredientName = m2.IngredientName'
      '    FROM ActivePatientOTC2 a'
      '    JOIN dbo.NDC9_INGREDIENT_MAP m2'
      '      ON m2.NDC9 = a.NDC9'
      '    JOIN NewDrugIngredients ni'
      '      ON ni.IngredientId = m2.IngredientId'
      '    ORDER BY a.FECHAOTC DESC;'
      'END;')
    Left = 6944
    Top = 256
  end
  object WC_GET_MISSING_ACTIVE_NDC9_MAP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE  PROCEDURE [dbo].[WC_GET_MISSING_ACTIVE_NDC9_MAP]'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @AsOfDate      DATE = NULL,'
      '    @GraceDays     INT  = 0,'
      
        '    @DefaultDaysSupply INT = 0   -- 0 = do NOT default; set 30 i' +
        'f you want fallback when DAYS_SUPPLY=0'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF @AsOfDate IS NULL'
      '        SET @AsOfDate = CAST(GETDATE() AS date);'
      ''
      '    ;WITH ActiveOTC AS ('
      '        SELECT DISTINCT'
      '            NDC9 = LEFT(o.NDC, 9),'
      '            o.MEDICAMENTO,'
      '            o.FECHAOTC,'
      '            DaysEff = CASE'
      
        '                        WHEN ISNULL(o.DAYS_SUPPLY,0) > 0 THEN o.' +
        'DAYS_SUPPLY'
      
        '                        WHEN @DefaultDaysSupply > 0 THEN @Defaul' +
        'tDaysSupply'
      '                        ELSE 0'
      '                      END'
      '        FROM dbo.OTC o'
      '        WHERE o.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND o.NDC IS NOT NULL'
      '          AND LEN(o.NDC) >= 9'
      '          AND o.QTY > 0'
      '          AND ('
      '                (ISNULL(o.DAYS_SUPPLY,0) > 0)'
      '                OR (@DefaultDaysSupply > 0)'
      '              )'
      '          AND @AsOfDate <= DATEADD(DAY, (CASE'
      
        '                                            WHEN ISNULL(o.DAYS_S' +
        'UPPLY,0) > 0 THEN o.DAYS_SUPPLY'
      
        '                                            ELSE @DefaultDaysSup' +
        'ply'
      
        '                                         END - 1) + @GraceDays, ' +
        'CAST(o.FECHAOTC AS date))'
      '    )'
      '    SELECT DISTINCT'
      '        a.NDC9,'
      '        a.MEDICAMENTO,'
      '        LastDispensed = MAX(a.FECHAOTC)'
      '    FROM ActiveOTC a'
      '    LEFT JOIN dbo.NDC9_INGREDIENT_MAP m'
      '      ON m.NDC9 = a.NDC9'
      '    WHERE m.NDC9 IS NULL'
      '    GROUP BY a.NDC9, a.MEDICAMENTO'
      '    ORDER BY LastDispensed DESC;'
      'END;                                                   ')
    Left = 6952
    Top = 352
  end
  object PRESCRIPTION_FULL_CREATEINDEX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        '-- OTC join + PLAN join (and commonly filtered by date/status in' +
        ' reporting)'
      'CREATE INDEX IX_OTC_NUMERORECETA'
      'ON dbo.OTC (NUMERORECETA)'
      'INCLUDE (FECHAOTC, DAYS_SUPPLY, PLANESMEDICOSNO, RX_STATUS);'
      ''
      '-- PRESCRIPTIONS join to OTC + joins to PACIENTES/DOCTOR'
      'CREATE INDEX IX_PRESCRIPTIONS_NUMERORECETA'
      'ON dbo.PRESCRIPTIONS (NUMERORECETA)'
      'INCLUDE (NUMEROCLIENTE, NUMERODOCTOR, FECHARECETA, ACTIVE);'
      ''
      '-- PACIENTES join'
      '-- (Usually NUMEROCLIENTE is already PK/unique; if not:)'
      'CREATE INDEX IX_PACIENTES_NUMEROCLIENTE'
      'ON dbo.PACIENTES (NUMEROCLIENTE);'
      ''
      '-- DOCTOR join'
      '-- (Usually NUMERODOCTOR is PK/unique; if not:)'
      'CREATE INDEX IX_DOCTOR_NUMERODOCTOR'
      'ON dbo.DOCTOR (NUMERODOCTOR);'
      ''
      '-- PLANESMEDICOS join'
      '-- (Usually PLANESMEDICOSNO is PK/unique; if not:)'
      'CREATE INDEX IX_PLANESMEDICOS_PLANESMEDICOSNO'
      'ON dbo.PLANESMEDICOS (PLANESMEDICOSNO);'
      '')
    Left = 664
    Top = 472
  end
  object GET_ACTIVE_PATIENT_NDCS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE OR ALTER PROCEDURE dbo.GET_ACTIVE_PATIENT_NDCS'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @AsOfDate      DATE = NULL,   -- default: today'
      
        '    @GraceDays     INT  = 3        -- allow a few days late refi' +
        'lls'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF @AsOfDate IS NULL'
      '        SET @AsOfDate = CONVERT(date, GETDATE());'
      ''
      '    ;WITH last_fill AS'
      '    ('
      '        SELECT'
      '            o.NUMERORECETA,'
      '            o.NDC,'
      '            o.FECHAOTC,'
      '            o.DAYS_SUPPLY,'
      '            rn = ROW_NUMBER() OVER'
      '                 ('
      '                    PARTITION BY o.NUMERORECETA'
      '                    ORDER BY o.FECHAOTC DESC, o.OTCNUMBER DESC'
      '                 )'
      '        FROM dbo.OTC o'
      '        WHERE o.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND o.NDC IS NOT NULL'
      '          AND LTRIM(RTRIM(o.NDC)) <> '#39#39
      '          AND o.FECHAOTC IS NOT NULL'
      '          AND ISNULL(o.DAYS_SUPPLY, 0) > 0'
      
        '          -- Optional: exclude reversed/voided transactions (adj' +
        'ust codes)'
      '          -- AND ISNULL(o.RX_STATUS,'#39#39') NOT IN ('#39'R'#39','#39'V'#39','#39'X'#39')'
      '    ),'
      '    current_rx AS'
      '    ('
      '        SELECT'
      '            lf.NDC,'
      
        '            RunOutDate = DATEADD(DAY, lf.DAYS_SUPPLY - 1, CONVER' +
        'T(date, lf.FECHAOTC))'
      '        FROM last_fill lf'
      '        WHERE lf.rn = 1'
      '    )'
      '    SELECT DISTINCT'
      '        c.NDC'
      '    FROM current_rx c'
      '    WHERE c.RunOutDate >= DATEADD(DAY, -@GraceDays, @AsOfDate)'
      '    ORDER BY c.NDC;'
      'END')
    Left = 6960
    Top = 472
  end
  object fn_GetBatchClinicalSignatureHash: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE dbo.fn_GetBatchClinicalSignatureHash'
      '('
      '    @NUMEROCLIENTE INT,'
      '    @GUID VARCHAR(50)'
      ')'
      'RETURNS VARCHAR(128)'
      'AS'
      'BEGIN'
      '    DECLARE @RAW NVARCHAR(MAX);'
      '    DECLARE @HASH VARBINARY(64);'
      ''
      '    SELECT @RAW ='
      '      STUFF(('
      '        SELECT '#39'||'#39' + CAST(A.ALERT_KEY AS NVARCHAR(MAX))'
      '        FROM dbo.RX_CLINICAL_ALERT A'
      '        WHERE A.NUMEROCLIENTE = @NUMEROCLIENTE'
      '          AND A.GUID = @GUID'
      '          AND A.REVIEW_REQUIRED = 1'
      '          AND ISNULL(A.RESOLVED, 0) = 0'
      '        ORDER BY A.ALERT_KEY'
      '        FOR XML PATH('#39#39'), TYPE'
      '      ).value('#39'.'#39', '#39'nvarchar(max)'#39'), 1, 2, '#39#39');'
      ''
      '    IF @RAW IS NULL OR LTRIM(RTRIM(@RAW)) = '#39#39
      '      RETURN NULL;'
      ''
      '    SET @HASH = HASHBYTES('#39'SHA2_256'#39', @RAW);'
      ''
      '    RETURN CONVERT(VARCHAR(128), @HASH, 2);'
      'END')
    Left = 6960
    Top = 624
  end
  object RX_CLINICAL_ALERT: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'RX_CLINI' +
        'CAL_ALERT'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[RX_CLINICAL_ALERT]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[OTCNUMBER] [int] NOT NULL,'
      #9'[NUMEROCLIENTE] [int] NOT NULL,'
      #9'[RX_ID] [int] NULL,'
      #9'[ALERT_TYPE] [varchar](30) NOT NULL,'
      #9'[ALERT_SEVERITY] [int] NOT NULL,'
      #9'[ALERT_TEXT] [varchar](max) NULL,'
      #9'[DRUG1] [varchar](200) NULL,'
      #9'[DRUG2] [varchar](200) NULL,'
      #9'[ALERT_KEY] [varchar](500) NULL,'
      #9'[REVIEW_REQUIRED] [bit] NOT NULL,'
      #9'[RESOLVED] [bit] NOT NULL,'
      #9'[APPROVAL_ID] [int] NULL,'
      #9'[CREATED_AT] [datetime] NOT NULL,'
      #9'[GUID] [varchar](50) NULL,'
      #9'[ALERT_SOURCE] [varchar](20) NULL,'
      #9'[REVIEW_STAGE] [varchar](20) NULL,'
      'PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY] TEXTIMAGE_ON [PRIMARY]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_ALERT] ADD  DEFAULT ((0)) FOR [RE' +
        'VIEW_REQUIRED]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_ALERT] ADD  DEFAULT ((0)) FOR [RE' +
        'SOLVED]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_ALERT] ADD  DEFAULT (getdate()) F' +
        'OR [CREATED_AT]'
      ';'
      'END;')
    Left = 6960
    Top = 728
  end
  object RX_CLINICAL_APPROVAL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'RX_CLINI' +
        'CAL_APPROVAL'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[RX_CLINICAL_APPROVAL]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[OTCNUMBER] [int] NULL,'
      #9'[NUMEROCLIENTE] [int] NOT NULL,'
      #9'[RX_ID] [int] NULL,'
      #9'[ALERT_SIGNATURE] [varchar](900) NOT NULL,'
      #9'[MAX_SEVERITY] [int] NULL,'
      #9'[HAS_INTERACTION] [bit] NOT NULL,'
      #9'[HAS_ALLERGY] [bit] NOT NULL,'
      #9'[HAS_DUPTHERAPY] [bit] NOT NULL,'
      #9'[PHARMACIST] [varchar](50) NOT NULL,'
      #9'[APPROVED] [bit] NOT NULL,'
      #9'[APPROVAL_ACTION] [varchar](50) NULL,'
      #9'[OVERRIDE_REASON] [varchar](500) NULL,'
      #9'[CREATED_AT] [datetime] NOT NULL,'
      #9'[GUID] [varchar](50) NULL,'
      'PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_APPROVAL] ADD  DEFAULT ((0)) FOR ' +
        '[HAS_INTERACTION]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_APPROVAL] ADD  DEFAULT ((0)) FOR ' +
        '[HAS_ALLERGY]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_APPROVAL] ADD  DEFAULT ((0)) FOR ' +
        '[HAS_DUPTHERAPY]'
      ';'
      
        'ALTER TABLE [dbo].[RX_CLINICAL_APPROVAL] ADD  DEFAULT (getdate()' +
        ') FOR [CREATED_AT]'
      ';'
      'END;')
    Left = 6968
