  object AUSPICIO: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE VIEW [dbo].[AUSPICIO](NOMBRE,CARDHOLDERID,FECHANACIMIENTO' +
        ',SEXO,DIRECCION1,DIRECCION2,ULTTRANS,DEUDA,LIMITECREDITO,NUMEROC' +
        'LIENTE,APELLIDOPATERNO,APELLIDOMATERNO,TELEFONO,CODIGOPOSTAL,FAX' +
        ',CELULAR,EMAIL,LAWAY,ESTADO,AUSPICIO,SOCIO,IDENTIFICACION,CODE,A' +
        'MOUNT,DATEOFTRANS,ATTENDEDBY,CLIENTNO,TRANSNO,PAIDAMOUNT,'
      'BALANCE) AS SELECT PACIENTES_1.NOMBRE, PACIENTES_1.CARDHOLDERID,'
      
        'PACIENTES_1.FECHANACIMIENTO, PACIENTES_1.SEXO, PACIENTES_1.DIREC' +
        'CION1,'
      'PACIENTES_1.DIRECCION2, PACIENTES_1.ULTTRANS, PACIENTES_1.DEUDA,'
      'PACIENTES_1.LIMITECREDITO, PACIENTES_1.NUMEROCLIENTE,'
      'PACIENTES_1.APELLIDOPATERNO, PACIENTES_1.APELLIDOMATERNO,'
      'PACIENTES_1.TELEFONO, PACIENTES_1.CODIGOPOSTAL, PACIENTES_1.FAX,'
      'PACIENTES_1.CELULAR, PACIENTES_1.EMAIL, PACIENTES_1.LAWAY,'
      'PACIENTES_1.ESTADO, PACIENTES_1.AUSPICIO, PACIENTES_1.SOCIO,'
      'PACIENTES_1.IDENTIFICACION, CLIENTTRANSACTIONS_1.CODE,'
      'CLIENTTRANSACTIONS_1.AMOUNT, CLIENTTRANSACTIONS_1.DATEOFTRANS,'
      'CLIENTTRANSACTIONS_1.ATTENDEDBY, CLIENTTRANSACTIONS_1.CLIENTNO,'
      'CLIENTTRANSACTIONS_1.TRANSNO, CLIENTTRANSACTIONS_1.PAIDAMOUNT,'
      
        'CLIENTTRANSACTIONS_1.BALANCE FROM PACIENTES PACIENTES_1 INNER JO' +
        'IN'
      'CLIENTTRANSACTIONS CLIENTTRANSACTIONS_1 ON'
      '(CLIENTTRANSACTIONS_1.CLIENTNO = PACIENTES_1.NUMEROCLIENTE)')
    Left = 2000
    Top = 248
  end
  object AUSPICIOTOTAL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE VIEW [dbo].[AUSPICIOTOTAL](SOCIO,APELLIDOPATERNO,APELLIDO' +
        'MATERNO,NOMBRE,AMOUNT,DATEOFTRANS) AS SELECT pacientes.socio, pa' +
        'cientes.apellidopaterno, pacientes.apellidomaterno, pacientes.no' +
        'mbre, SUM(amount), ClientTransactions.DATEOFTRANS FROM clienttra' +
        'nsactions INNER JOIN pacientes ON clienttransactions.clientno = ' +
        'pacientes.numerocliente WHERE code = '#39'AU'#39' AND pacientes.socio > ' +
        #39'0'#39' GROUP BY pacientes.socio, pacientes.apellidopaterno, pacient' +
        'es.apellidomaterno, pacientes.nombre, CLIENTTRANSACTIONS.DATEOFT' +
        'RANS')
    Left = 2008
    Top = 336
  end
  object BESTRX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[BESTRX]'
      'AS'
      
        'SELECT        INVENTARIO_1.TIPO, OTC_1.COSTOVENTA, OTC_1.NUMEROR' +
        'ECETA, OTC_1.MEDICAMENTO, INVENTARIO_1.CONTROLADO, OTC_1.NUMEROT' +
        'RANSACCION, OTC_1.FECHAOTC AS FECHAVENTA, OTC_1.QTY, '
      
        '                         OTC_1.PLAN_MEDICO AS PLANMEDICO, OTC_1.' +
        'NDC, OTC_1.ATENDIDOPOR AS ATENDIDAPOR, OTC_1.PRECIOFACTURACION, ' +
        'OTC_1.TOTAL AS PRECIOVENTA, OTC_1.DEDUCIBLE, '
      
        '                         OTC_1.DISPENSING_FEE_PAID AS DISPENSING' +
        'FEE, OTC_1.PAGO_PLAN AS PAGOPLAN, OTC_1.PAGO_PLAN + OTC_1.DEDUCI' +
        'BLE - OTC_1.COSTOVENTA AS GANANCIA_PM, '
      
        '                         OTC_1.TOTAL - OTC_1.COSTOVENTA AS GANAN' +
        'CIA_CASH, INVENTARIO_1.RECETARIO'
      'FROM            dbo.INVENTARIOPISO AS INVENTARIO_1 INNER JOIN'
      
        '                         dbo.OTC AS OTC_1 ON INVENTARIO_1.PRODUC' +
        'TNO = OTC_1.PRODUCT_ID')
    Left = 2008
    Top = 408
  end
  object BRAND_RX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[BRAND_RX]'
      'AS'
      
        'SELECT dbo.INVENTARIOPISO.PRODUCTNO, dbo.OTC.MEDICAMENTO, dbo.OT' +
        'C.NDC, dbo.OTC.QTY, dbo.INVENTARIOPISO.BRAND, dbo.OTC.FECHAOTC, ' +
        'dbo.OTC.NUMERORECETA'
      'FROM dbo.OTC INNER JOIN'
      
        ' dbo.INVENTARIOPISO ON dbo.OTC.PRODUCT_ID = dbo.INVENTARIOPISO.P' +
        'RODUCTNO')
    Left = 2008
    Top = 504
  end
  object OTCCONTROLADOS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[OTCCONTROLADOS]'
      'AS'
      
        'SELECT        OTC_1.OTCNUMBER, OTC_1.NDC, OTC_1.MEDICAMENTO, OTC' +
        '_1.NUMEROTRANSACCION, OTC_1.TOTAL, OTC_1.ATENDIDOPOR, OTC_1.COBR' +
        'ADO, OTC_1.FECHAOTC, OTC_1.NUMERORECETA, OTC_1.RX, '
      
        '                         OTC_1.COSTOVENTA, OTC_1.QTY, INVENTARIO' +
        '_1.CONTROLADO'
      'FROM            dbo.OTC AS OTC_1 INNER JOIN'
      
        '                         dbo.INVENTARIOPISO AS INVENTARIO_1 ON I' +
        'NVENTARIO_1.NDC = OTC_1.NDC'
      
        'WHERE        (OTC_1.CONTROLADO <> '#39'RX'#39') AND (OTC_1.CONTROLADO <>' +
        ' '#39#39')')
    Left = 2008
    Top = 592
  end
  object OTCHISTORY: TFDQuery
    AfterExecute = OTCHISTORYAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[OTCHISTORY]'
      'AS'
      
        'SELECT     PACIENTES_1.NOMBRE, PACIENTES_1.CARDHOLDERID, PACIENT' +
        'ES_1.APELLIDOPATERNO, PACIENTES_1.APELLIDOMATERNO, PACIENTES_1.T' +
        'ELEFONO, '
      
        '                      PACIENTES_1.NUMEROCLIENTE, PACIENTES_1.DIR' +
        'ECCION1, PACIENTES_1.DIRECCION2, PACIENTES_1.IDENTIFICACION, PAC' +
        'IENTES_1.FECHANACIMIENTO, '
      
        '                      PACIENTES_1.SEXO, PACIENTES_1.CODIGOPOSTAL' +
        ', OTC_1.OTCNUMBER, OTC_1.NUMEROTRANSACCION, OTC_1.NDC, OTC_1.MED' +
        'ICAMENTO, OTC_1.TOTAL, '
      
        '                      OTC_1.ATENDIDOPOR, OTC_1.COBRADO, OTC_1.FE' +
        'CHAOTC, OTC_1.NUMERORECETA, OTC_1.RX, OTC_1.COSTOVENTA, OTC_1.QT' +
        'Y, OTC_1.MEDICAMENTOMIX, '
      
        '                      OTC_1.PAGO_PLAN, OTC_1.DEDUCIBLE, OTC_1.PL' +
        'AN_MEDICO'
      'FROM         dbo.PACIENTES AS PACIENTES_1 INNER JOIN'
      
        '                      dbo.OTC AS OTC_1 ON OTC_1.NUMEROCLIENTE = ' +
        'PACIENTES_1.NUMEROCLIENTE')
    Left = 2000
    Top = 664
  end
  object PACIENTES_PLANES: TFDQuery
    AfterExecute = PACIENTES_PLANESAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[PACIENTES_PLANES]'
      'AS'
      
        'SELECT        paciente1.NUMEROCLIENTE, paciente1.NOMBRE, pacient' +
        'e1.APELLIDOPATERNO, paciente1.APELLIDOMATERNO, paciente1.TELEFON' +
        'O, patplan1.PLANMEDICO, paciente1.ADHERENCE, paciente1.DECEASED,' +
        ' '
      '                         patplan1.ACTIVO'
      'FROM            dbo.PACIENTES AS paciente1 INNER JOIN'
      
        '                         dbo.PATPLAN AS patplan1 ON paciente1.NU' +
        'MEROCLIENTE = patplan1.NUMEROCLIENTE')
    Left = 2008
    Top = 744
  end
  object PRODUCTSALES: TFDQuery
    AfterExecute = PRODUCTSALESAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE VIEW [dbo].[PRODUCTSALES](PROD_DESC,POD_UPC,T_SOLD,PROD_D' +
        'PT,PROD_SUP,PROD_FECHAVENTA) '
      
        '  AS SELECT ProdDescription, UPC ,SUM(Qty), PRODDEPARTMENT, Supl' +
        'idor, FechaVenta  '
      
        '  FROM transactiondetail WHERE ProdDepartment <> '#39'RECETAS'#39' AND P' +
        'rodDepartment <> '#39'OTC'#39' AND ProdDepartment <> '#39'PAGO'#39' '
      
        '  GROUP BY ProdDescription, UPC, ProdDepartment, Suplidor, Fecha' +
        'Venta')
    Left = 2008
    Top = 816
  end
  object RX_PROCESADAS: TFDQuery
    AfterExecute = RX_PROCESADASAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RX_PROCESADAS]'
      'AS'
      
        'SELECT        PRESCRIPTIONS_1.FECHAULTIMOREFILL, PRESCRIPTIONS_1' +
        '.AUTOMATIC_REFILL, PRESCRIPTIONS_1.COMPOUNDCODE, PRESCRIPTIONS_1' +
        '.CANTIDAD_DISPONIBLE, PRESCRIPTIONS_1.NUMERODOCTOR, OTC_1.DAW, '
      
        '                         PRESCRIPTIONS_1.NUMEROCLIENTE, OTC_1.NO' +
        '_HORA, PRESCRIPTIONS_1.CANTIDADRECETADA, PRESCRIPTIONS_1.CANTIDA' +
        'D_DISPONIBLE AS DISPONIBLE, '
      
        '                         OTC_1.NO_REF_DISPENSADO AS NUMEROREFILL' +
        'SDISPENSADOS, PRESCRIPTIONS_1.LICENCIA, PRESCRIPTIONS_1.NUMERORE' +
        'FILLSAUTORIZADOS, OTC_1.PLAN_MEDICO, OTC_1.NUMERORECETA, OTC_1.F' +
        'ECHAOTC, '
      
        '                         OTC_1.QTY, OTC_1.DEDUCIBLE, OTC_1.PAGO_' +
        'PLAN, OTC_1.DAYS_SUPPLY, OTC_1.NUMERO_AUTORIZACION, OTC_1.GANANC' +
        'IA, OTC_1.MEDICAMENTO, OTC_1.COSTOVENTA, OTC_1.PRECIOFACTURACION' +
        ', '
      
        '                         OTC_1.PAGO_PLAN + OTC_1.DEDUCIBLE - OTC' +
        '_1.COSTOVENTA AS PAGOPLAN_DEDUCIBLE_Costo, OTC_1.ATENDIDOPOR, OT' +
        'C_1.PAGADA, OTC_1.PLAN_MEDICO AS PLANMEDICO, OTC_1.TOTAL AS PREC' +
        'IOVENTA, '
      
        '                         OTC_1.OTCNUMBER, OTC_1.COBRADO, OTC_1.N' +
        'UMEROPLAN, OTC_1.LOTE, OTC_1.SIGNATURE_LINK, OTC_1.PRODUCT_ID, O' +
        'TC_1.RX_STATUS, dbo.PACIENTES.NOMBRE, dbo.PACIENTES.APELLIDOPATE' +
        'RNO, '
      
        '                         dbo.PACIENTES.APELLIDOMATERNO, dbo.PACI' +
        'ENTES.TELEFONO, OTC_1.TIME_RX, OTC_1.REFILL_NOTIFIED, OTC_1.PHAR' +
        'MACIST, PRESCRIPTIONS_1.RXORIGINCODE, PRESCRIPTIONS_1.ACTIVE, '
      
        '                         dbo.PACIENTES.ADHERENCE, dbo.PACIENTES.' +
        'SSN, dbo.PACIENTES.CELULAR, OTC_1.CLAIM_STATUS, OTC_1.NDC, dbo.I' +
        'NVENTARIOPISO.CONTROLADO, dbo.INVENTARIOPISO.MARKETEDPRODUCTID, '
      
        '                         PRESCRIPTIONS_1.PROXIMOREFILL, dbo.PATP' +
        'LAN.CARDHOLDERID'
      'FROM            dbo.PRESCRIPTIONS AS PRESCRIPTIONS_1 INNER JOIN'
      
        '                         dbo.OTC AS OTC_1 ON OTC_1.NUMERORECETA ' +
        '= PRESCRIPTIONS_1.NUMERORECETA INNER JOIN'
      
        '                         dbo.PACIENTES ON PRESCRIPTIONS_1.NUMERO' +
        'CLIENTE = dbo.PACIENTES.NUMEROCLIENTE INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON OTC_1.PRODUCT_ID ' +
        '= dbo.INVENTARIOPISO.PRODUCTNO INNER JOIN'
      
        '                         dbo.PATPLAN ON OTC_1.NUMEROPLAN = dbo.P' +
        'ATPLAN.NUMEROPLAN')
    Left = 2016
    Top = 888
  end
  object RX_VIEW: TFDQuery
    AfterExecute = RX_VIEWAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RX_VIEW]'
      'AS'
      
        'SELECT        dbo.OTC.QTY, dbo.OTC.NUMERORECETA, dbo.OTC.COSTOVE' +
        'NTA, dbo.OTC.FECHAOTC, dbo.OTC.TOTAL, dbo.INVENTARIOPISO.NDC, db' +
        'o.INVENTARIOPISO.METRICSIZE, dbo.INVENTARIOPISO.TIPO, '
      
        '                         dbo.INVENTARIOPISO.METRIC_UNIT, dbo.INV' +
        'ENTARIOPISO.STATUS, dbo.INVENTARIOPISO.DESCRIPCION AS MEDICAMENT' +
        'O, dbo.OTC.NDC AS Expr1, dbo.INVENTARIOPISO.RECETARIO, '
      
        '                         dbo.INVENTARIOPISO.STRENGTH, dbo.INVENT' +
        'ARIOPISO.PRODUCTNO, dbo.INVENTARIOPISO.COSTO'
      'FROM            dbo.OTC INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON dbo.OTC.NDC = dbo' +
        '.INVENTARIOPISO.NDC')
    Left = 2120
    Top = 104
  end
  object RXCONTROLADAS: TFDQuery
    AfterExecute = RXCONTROLADASAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RXCONTROLADAS]'
      'AS'
      
        'SELECT        PACIENTES_1.NOMBRE, PACIENTES_1.CARDHOLDERID, PACI' +
        'ENTES_1.APELLIDOPATERNO, PACIENTES_1.APELLIDOMATERNO, PACIENTES_' +
        '1.TELEFONO, PACIENTES_1.NUMEROCLIENTE, '
      
        '                         PACIENTES_1.DIRECCION1, PACIENTES_1.DIR' +
        'ECCION2, PACIENTES_1.IDENTIFICACION, PACIENTES_1.FECHANACIMIENTO' +
        ', PACIENTES_1.SEXO, PACIENTES_1.CODIGOPOSTAL, OTC_1.NUMERORECETA' +
        ', '
      
        '                         OTC_1.MEDICAMENTO, OTC_1.NUMEROTRANSACC' +
        'ION, OTC_1.FECHAOTC AS FECHAVENTA, OTC_1.QTY AS CANTIDADDESPACHA' +
        'DA, OTC_1.PLAN_MEDICO AS PLANMEDICO, OTC_1.NDC, '
      
        '                         OTC_1.ATENDIDOPOR AS ATENDIDAPOR, OTC_1' +
        '.PRECIOFACTURACION, OTC_1.TOTAL AS PRECIOVENTA, OTC_1.DEDUCIBLE,' +
        ' OTC_1.DISPENSING_FEE_PAID AS DISPENSINGFEE, '
      
        '                         OTC_1.PAGO_PLAN AS PAGOPLAN, OTC_1.NO_R' +
        'EF_DISPENSADO AS NUMEROREFILLSDISPENSADOS, dbo.INVENTARIOPISO.PR' +
        'ODUCTNO, dbo.INVENTARIOPISO.TIPO, dbo.PRODUCTCODE.DESCRIPCION, '
      
        '                         dbo.INVENTARIOPISO.REVENUE_CODE, dbo.IN' +
        'VENTARIOPISO.HCPCS, dbo.INVENTARIOPISO.FECHA_EXPIRACION, OTC_1.U' +
        'NIT_PRICE'
      'FROM            dbo.PACIENTES AS PACIENTES_1 INNER JOIN'
      
        '                         dbo.OTC AS OTC_1 ON OTC_1.NUMEROCLIENTE' +
        ' = PACIENTES_1.NUMEROCLIENTE INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON OTC_1.PRODUCT_ID ' +
        '= dbo.INVENTARIOPISO.PRODUCTNO INNER JOIN'
      
        '                         dbo.PRODUCTCODE ON dbo.INVENTARIOPISO.T' +
        'IPO = dbo.PRODUCTCODE.CODE')
    Left = 2136
    Top = 248
  end
  object RX_VIEW_COMPOUNDS: TFDQuery
    AfterExecute = RX_VIEW_COMPOUNDSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RX_VIEW_COMPOUNDS]'
      'AS'
      
        'SELECT        dbo.MEZCLAS.CANTIDADDESPACHADA, dbo.MEZCLAS.NUMERO' +
        'RECETA, dbo.MEZCLAS.COSTO, dbo.MEZCLAS.FECHA_MEZCLA, dbo.INVENTA' +
        'RIOPISO.NDC, dbo.INVENTARIOPISO.METRICSIZE, '
      
        '                         dbo.INVENTARIOPISO.TIPO, dbo.INVENTARIO' +
        'PISO.METRIC_UNIT, dbo.INVENTARIOPISO.STATUS, dbo.INVENTARIOPISO.' +
        'DESCRIPCION AS MEDICAMENTO, dbo.INVENTARIOPISO.RECETARIO, '
      
        '                         dbo.INVENTARIOPISO.STRENGTH, dbo.INVENT' +
        'ARIOPISO.CONTROLADO, dbo.OTC.WF_SIGNATURE, dbo.OTC.OTCNUMBER, db' +
        'o.INVENTARIOPISO.COSTO AS EXTENDED_COST, dbo.PACIENTES.NOMBRE, '
      
        '                         dbo.PACIENTES.APELLIDOPATERNO, dbo.PACI' +
        'ENTES.APELLIDOMATERNO'
      'FROM            dbo.MEZCLAS INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON dbo.MEZCLAS.NDC =' +
        ' dbo.INVENTARIOPISO.NDC INNER JOIN'
      
        '                         dbo.OTC ON dbo.MEZCLAS.OTCNUMBER = dbo.' +
        'OTC.OTCNUMBER INNER JOIN'
      
        '                         dbo.PACIENTES ON dbo.OTC.NUMEROCLIENTE ' +
        '= dbo.PACIENTES.NUMEROCLIENTE')
    Left = 2120
    Top = 160
  end
  object RXDEPT: TFDQuery
    AfterExecute = RXDEPTAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE VIEW [dbo].[RXDEPT](NORX,MEDICAMENTO,CANTIDAD_DISPONIBLE,' +
        'FECHAVENTA,PRODID,PLANMEDICO,DEPT,PRODUCTID) AS SELECT PRESCRIPT' +
        'IONS_1.NUMERORECETA, PRESCRIPTIONS_1.MEDICAMENTO, PRESCRIPTIONS_' +
        '1.CANTIDAD_DISPONIBLE, PRESCRIPTIONS_1.FECHAVENTA, PRESCRIPTIONS' +
        '_1.PRODUCT_ID, PRESCRIPTIONS_1.PLANMEDICO, INVENTARIO_1.DEPARTAM' +
        'ENTO, INVENTARIO_1.PRODUCTNO FROM PRESCRIPTIONS PRESCRIPTIONS_1 ' +
        'INNER JOIN INVENTARIOPISO INVENTARIO_1 ON (INVENTARIO_1.PRODUCTN' +
        'O = PRESCRIPTIONS_1.PRODUCT_ID)')
    Left = 2128
    Top = 336
  end
  object TEMP: TFDQuery
    AfterExecute = TEMPAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[TEMP]'
      'AS'
      
        'SELECT        dbo.OTC.NUMERORECETA, dbo.OTC.MEDICAMENTO, dbo.PAC' +
        'IENTES.NOMBRE, dbo.DOCTOR.APELLIDO_PATERNO, dbo.PLANESMEDICOS.AB' +
        'REVIATURA'
      'FROM            dbo.PRESCRIPTIONS INNER JOIN'
      
        '                         dbo.OTC ON dbo.PRESCRIPTIONS.NUMERORECE' +
        'TA = dbo.OTC.NUMERORECETA INNER JOIN'
      
        '                         dbo.PACIENTES ON dbo.PRESCRIPTIONS.NUME' +
        'ROCLIENTE = dbo.PACIENTES.NUMEROCLIENTE INNER JOIN'
      
        '                         dbo.DOCTOR ON dbo.PRESCRIPTIONS.NUMEROD' +
        'OCTOR = dbo.DOCTOR.NUMERODOCTOR INNER JOIN'
      
        '                         dbo.PLANESMEDICOS ON dbo.OTC.PLAN_MEDIC' +
        'O = dbo.PLANESMEDICOS.ABREVIATURA')
    Left = 2136
    Top = 416
  end
  object TOTAL_POS_TRANS: TFDQuery
    AfterExecute = TOTAL_POS_TRANSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[TOTAL_POS_TRANS]'
      'AS'
      
        'SELECT        dbo.TRANSACTIONHEADER.TOTAL, dbo.TRANSACTIONHEADER' +
        '.TRANSACTIONTIME, dbo.TRANSACTIONDETAIL.PRODDEPARTMENT, dbo.TRAN' +
        'SACTIONHEADER.TRANSACTIONDATE'
      'FROM            dbo.TRANSACTIONDETAIL INNER JOIN'
      
        '                         dbo.TRANSACTIONHEADER ON dbo.TRANSACTIO' +
        'NDETAIL.TRANSACTIONNUMBER = dbo.TRANSACTIONHEADER.TRANSACTIONNUM' +
        'BER')
    Left = 2144
    Top = 504
  end
  object VERTRANSACCIONES: TFDQuery
    AfterExecute = VERTRANSACCIONESAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[VERTRANSACCIONES]'
      'AS'
      
        'SELECT        TH.ID, TH.TRANSACTIONNUMBER, TH.TRANSACTIONDATE, T' +
        'H.NUMBERITEMS, TH.SUBTOTAL, TH.TAX, TH.TOTAL, TH.CHANGE, TH.PAYM' +
        'ENTTYPE1, TH.CREDITCARD1, TH.OPENED, TH.CUSTOMERID, TH.TRANSACTI' +
        'ONTIME, TH.PAID, '
      
        '                         TH.PAYMENTTYPE2, TH.CREDITCARD2, TH.PAY' +
        'AMOUNT1, TH.PAYAMOUNT2, TH.REGTOTAL, TH.FOODTOTAL, TH.SHIFT, TH.' +
        'EMPLOYNUMBER, TH.REGISTER, TD.IDNUMBER, TD.UPC, TD.QTY, TD.VOIDE' +
        'D, '
      
        '                         TD.SUBDETAIL, TD.PRODDESCRIPTION, TD.PR' +
        'ODDEPARTMENT, TD.FOOD, TD.PRICE, TD.REGPRICE, TD.MODIFIED, TD.DI' +
        'SCOUNT, TD.COSTO, TD.FECHAVENTA, TD.SUPLIDOR, TD.SUPERVISOR, TD.' +
        'TAX_MUNICIPAL, '
      
        '                         TD.TAX_ESTATAL, TD.SUBDEPARTAMENTO, TD.' +
        'BARCODEALTERNO2, TD.BARCODEALTERNO1, TD.UTILIDAD, TD.NOTE, TH.TI' +
        'P, TH.SALESMAN, TD.COMMISSION, TD.TAX_PROCESSED_FOOD, TH.TOTAL_T' +
        'AX,'
      #9#9#9#9#9#9' TD.TOTAL AS DETAIL_TOTAL'
      ''
      'FROM            dbo.TRANSACTIONHEADER AS TH INNER JOIN'
      
        '                         dbo.TRANSACTIONDETAIL AS TD ON TD.TRANS' +
        'ACTIONNUMBER = TH.TRANSACTIONNUMBER')
    Left = 2152
    Top = 600
  end
