        '                         dbo.INVENTARIOPISO.TIPO, dbo.INVENTARIO' +
        'PISO.METRIC_UNIT, dbo.INVENTARIOPISO.STATUS, dbo.INVENTARIOPISO.' +
        'DESCRIPCION AS MEDICAMENTO, dbo.INVENTARIOPISO.RECETARIO, '
      
        '                         dbo.INVENTARIOPISO.STRENGTH, dbo.INVENT' +
        'ARIOPISO.CONTROLADO, dbo.OTC.WF_SIGNATURE, dbo.OTC.OTCNUMBER, db' +
        'o.INVENTARIOPISO.COSTO AS EXTENDED_COST, dbo.PACIENTES.NOMBRE, '
      
        '                         dbo.PACIENTES.APELLIDOPATERNO, dbo.PACI' +
        'ENTES.APELLIDOMATERNO'
      'FROM            dbo.MEZCLAS INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON dbo.MEZCLAS.NDC =' +
        ' dbo.INVENTARIOPISO.NDC INNER JOIN'
      
        '                         dbo.OTC ON dbo.MEZCLAS.OTCNUMBER = dbo.' +
        'OTC.OTCNUMBER INNER JOIN'
      
        '                         dbo.PACIENTES ON dbo.OTC.NUMEROCLIENTE ' +
        '= dbo.PACIENTES.NUMEROCLIENTE')
    Left = 2120
    Top = 160
