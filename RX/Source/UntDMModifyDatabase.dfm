        #9'  (TIPO, CODIGO,COSTO,RBP,ESPECIAL,DEPARTAMENTO,LOTE,PRECIO,POR' +
        'CIENTODESCUENTO,ULTIMOCAMBIO,QTYINVENTARIO,CMAXINVENTARIO,CMININ' +
