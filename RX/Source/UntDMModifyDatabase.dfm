  object VW_RX_CLINICAL_ALERT_APPROVAL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[VW_RX_CLINICAL_ALERT_APPROVAL]'
      'AS'
      'WITH LAST_APPROVAL AS'
      '('
      '    SELECT'
      '        P.*,'
      '        RN = ROW_NUMBER() OVER'
      '        ('
      '            PARTITION BY'
      '                P.NUMEROCLIENTE,'
      '                ISNULL(P.GUID, '#39#39'),'
      '                ISNULL(P.RX_ID, 0),'
      '                ISNULL(P.OTCNUMBER, 0)'
      '            ORDER BY P.CREATED_AT DESC, P.ID DESC'
      '        )'
      '    FROM dbo.RX_CLINICAL_APPROVAL P'
      ')'
      'SELECT'
      '    A.ID                        AS ALERT_ID,'
      '    A.OTCNUMBER,'
      '    A.NUMEROCLIENTE,'
      '    A.RX_ID,'
      '    A.GUID,'
      ''
      '    A.ALERT_TYPE,'
      '    A.ALERT_SEVERITY,'
      '    A.ALERT_TEXT,'
      '    A.DRUG1,'
      '    A.DRUG2,'
      '    A.ALERT_KEY,'
      '    A.REVIEW_REQUIRED,'
      '    A.RESOLVED,'
      '    A.APPROVAL_ID               AS ALERT_APPROVAL_ID,'
      '    A.CREATED_AT                AS ALERT_CREATED_AT,'
      '    A.ALERT_SOURCE,'
      '    A.REVIEW_STAGE,'
      ''
      '    P.ID                        AS APPROVAL_ID,'
      '    P.ALERT_SIGNATURE,'
      '    P.MAX_SEVERITY,'
      '    P.HAS_INTERACTION,'
      '    P.HAS_ALLERGY,'
      '    P.HAS_DUPTHERAPY,'
      '    P.PHARMACIST,'
      '    P.APPROVED,'
      '    P.APPROVAL_ACTION,'
      '    P.OVERRIDE_REASON,'
      '    P.CREATED_AT                AS APPROVAL_CREATED_AT,'
      ''
      '    CASE'
      '        WHEN ISNULL(P.APPROVED, 0) = 1 THEN '#39'APPROVED'#39
      '        WHEN P.ID IS NOT NULL THEN '#39'REVIEWED_NOT_APPROVED'#39
      '        ELSE '#39'PENDING'#39
      '    END AS APPROVAL_STATUS,'
      ''
      '    CASE'
      '        WHEN A.ALERT_SEVERITY = 1 THEN '#39'CRITICAL'#39
      '        WHEN A.ALERT_SEVERITY = 2 THEN '#39'HIGH'#39
      '        WHEN A.ALERT_SEVERITY = 3 THEN '#39'MODERATE'#39
      '        WHEN A.ALERT_SEVERITY = 4 THEN '#39'INFO'#39
      '        ELSE '#39'UNKNOWN'#39
      '    END AS ALERT_SEVERITY_TEXT'
      ''
      'FROM dbo.RX_CLINICAL_ALERT A'
      'LEFT JOIN LAST_APPROVAL P'
      '    ON P.NUMEROCLIENTE = A.NUMEROCLIENTE'
      '   AND ISNULL(P.OTCNUMBER, 0) = ISNULL(A.OTCNUMBER, 0)'
      '   AND P.RN = 1;')
    Left = 6976
    Top = 936
  end
