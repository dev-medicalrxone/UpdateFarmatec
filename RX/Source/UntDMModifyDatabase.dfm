  object CHANGE_PATIENT: TFDQuery
    AfterExecute = CHANGE_PATIENTAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE  PROCEDURE [dbo].[CHANGE_PATIENT] @NUMEROCLIENTE INT,  @O' +
        'LDPATNO INT,  @GUID VARCHAR(36), @PAT_PLAN_NO INT, @ATENDIDAPOR ' +
        'CHAR(3),'
      '@PRICE_TABLE_ID INT'
      'AS'
      'DECLARE @OVERRIDE_SYSTEM_DEFAULT_PRICE BIT'
      'DECLARE @Facility_ID INT'
      'DECLARE @ADHERENCE BIT '
      'DECLARE @PLAN_MEDICO CHAR(3)'
      'DECLARE @CLAIM_STATUS INT'
      'DECLARE @PHARMACIST CHAR(3) '
      'DECLARE @NORX BIGINT'
      'DECLARE @OTC_NUMBER INT'
      'DECLARE @CONTROLLED CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @OLDPAT CHAR(70)'
      'DECLARE @NEWPAT CHAR(70)'
      'DECLARE @NOTE VARCHAR(MAX)'
      ''
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9'-- HARD STOP: do not run if GUID is NULL or blank'
      #9'IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9'BEGIN'
      
        #9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or b' +
        'lank.'#39', 16, 1);'
      #9#9'RETURN;'
      #9'END;'
      #9'if RTRIM(@GUID) > '#39#39
      #9'begin'
      
        #9'    SELECT @OLDPAT = RTRIM(CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39', ' +
        'RTRIM(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE), '#39' Customer Number: '#39 +
        ', RTRIM(CONVERT(varchar(5), NUMEROCLIENTE)))) FROM PACIENTES WHE' +
        'RE NUMEROCLIENTE = @OLDPATNO;'
      
        #9#9'SELECT @NEWPAT = RTRIM(CONCAT(RTRIM(APELLIDOPATERNO), '#39' '#39', RTR' +
        'IM(APELLIDOMATERNO), '#39' '#39', RTRIM(NOMBRE), '#39' Customer Number: '#39', R' +
        'TRIM(CONVERT(varchar(5), NUMEROCLIENTE)))),  @Facility_ID = FACI' +
        'LITY_ID, @ADHERENCE = ADHERENCE, '
      
        #9#9'@OVERRIDE_SYSTEM_DEFAULT_PRICE = OVERRIDE_SYSTEM_DEFAULT_PRICE' +
        ' FROM PACIENTES WHERE NUMEROCLIENTE = @NUMEROCLIENTE;'#9#9
      
        #9#9'UPDATE OTC SET NUMEROCLIENTE = @NUMEROCLIENTE, FACILITY_ID = @' +
        'Facility_ID, ADHERENCE = @ADHERENCE, NUMEROPLAN = @PAT_PLAN_NO '
      #9#9'WHERE GUID = RTRIM(@GUID) and CLAIM_STATUS <> 1;'
      ''
      
        #9#9'Exec RX_CHANGE_PATIENT_PLAN @PAT_PLAN_NO, @GUID, @PRICE_TABLE_' +
        'ID;'
      ''
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT PHARMACIST, NUMERORECETA, O' +
        'TCNUMBER, CONTROLADO from OTC WHERE GUID = RTRIM(@GUID);'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @PHARMACIST, @NORX, @OTC_NUMBER, @CONTROLLED'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      
        #9#9'    UPDATE PRESCRIPTIONS SET NUMEROCLIENTE = @NUMEROCLIENTE WH' +
        'ERE NUMERORECETA = @NORX;'
      #9#9#9'IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9#9#9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9#9#9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @' +
        'ISCONTROLLED = 1;'
      
        #9#9#9'SET @NOTE = CONCAT('#39'PATIENT '#39', RTRIM(@OLDPAT), '#39' WAS CHANGED ' +
        'FOR '#39', RTRIM(@NEWPAT));  '
      
        #9#9#9'EXECUTE INSERT_LOG '#39'PATIENT CHANGED ON NEW RX'#39', '#39'M'#39', '#39#39', @ATE' +
        'NDIDAPOR,  @PHARMACIST, @NORX, @OTC_NUMBER,0,0,0,0,0,0,'#39'R'#39',@NOTE' +
        ',@ISCONTROLLED,1;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9'INTO @PHARMACIST, @NORX, @OTC_NUMBER, @CONTROLLED'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'
      #9'end;'
      #9'commit'#9
      'END;')
    Left = 2832
    Top = 40
  end
  object CHANGE_PRESCRIBER: TFDQuery
    AfterExecute = CHANGE_PRESCRIBERAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[CHANGE_PRESCRIBER] @NUMERODOCTOR INT, @O' +
        'LDPRESCNO INT,  @GUID VARCHAR(36), @ATENDIDAPOR CHAR(3)'
      'AS'
      'DECLARE @SPI CHAR(13)'
      'DECLARE @LICENCIA CHAR(15)'
      'DECLARE @PRESCRIBERIDQUALIFIER CHAR(2)'
      'DECLARE @PHARMACIST CHAR(3) '
      'DECLARE @NORX BIGINT'
      'DECLARE @OTC_NUMBER INT'
      'DECLARE @CONTROLLED CHAR(3)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @PRODUCTID INT'
      'DECLARE @CUSTOMER_ID INT'
      'DECLARE @OLDDOC CHAR(70)'
      'DECLARE @NEWDOC CHAR(70)'
      'DECLARE @NOTE VARCHAR(MAX)'
      'BEGIN'
      'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9'if RTRIM(@GUID) > '#39#39
      #9'begin'
      
        #9'    Select @OLDDOC = RTRIM(CONCAT(RTRIM(APELLIDO_PATERNO), '#39' '#39',' +
        ' RTRIM(APELLIDO_MATERNO), '#39' '#39', RTRIM(NOMBRE), '#39' Prescriber Numbe' +
        'r: '#39', RTRIM(CONVERT(varchar(5), NUMERODOCTOR))))'
      #9#9'FROM DOCTOR WHERE NUMERODOCTOR = @OLDPRESCNO;'
      ''
      
        #9#9'Select @NEWDOC = RTRIM(CONCAT(RTRIM(APELLIDO_PATERNO), '#39' '#39', RT' +
        'RIM(APELLIDO_MATERNO), '#39' '#39', RTRIM(NOMBRE), '#39' Prescriber Number: ' +
        #39', RTRIM(CONVERT(varchar(5), NUMERODOCTOR)))),'
      
        #9#9'@SPI = SPI, @LICENCIA = NPI, @PRESCRIBERIDQUALIFIER = PRESCRIB' +
        'ER_ID_QUALIFIER FROM DOCTOR WHERE NUMERODOCTOR = @NUMERODOCTOR; ' +
        #9'  '#9#9#9#9
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT PHARMACIST, NUMERORECETA, O' +
        'TCNUMBER, CONTROLADO, PRODUCT_ID, NUMEROCLIENTE from OTC WHERE G' +
        'UID = @GUID;'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      
        #9#9'INTO @PHARMACIST, @NORX, @OTC_NUMBER, @CONTROLLED, @PRODUCTID,' +
        ' @CUSTOMER_ID'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      #9#9#9'IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9#9#9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9#9#9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @' +
        'ISCONTROLLED = 1;'
      
        #9#9'    UPDATE PRESCRIPTIONS SET NUMERODOCTOR = @NUMERODOCTOR, LIC' +
        'ENCIA = @LICENCIA, SPI = @SPI, PRESCRIBERIDQUALIFIER = @PRESCRIB' +
        'ERIDQUALIFIER  WHERE NUMERORECETA = @NORX;'
      
        #9#9#9'SET @NOTE = CONCAT('#39'PRESCRIBER '#39', RTRIM(@OLDDOC), '#39' WAS CHANG' +
        'ED FOR '#39', RTRIM(@NEWDOC)); '
      
        #9#9#9'EXECUTE INSERT_LOG '#39'PRESCRIBER CHANGED ON NEW RX'#39', '#39'M'#39', '#39#39', @' +
        'ATENDIDAPOR,  @PHARMACIST, @NORX, @OTC_NUMBER,@NUMERODOCTOR,@CUS' +
        'TOMER_ID,0,0,0,@PRODUCTID,'#39'R'#39',@NOTE,@ISCONTROLLED,1;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      
        #9#9#9'INTO @PHARMACIST, @NORX, @OTC_NUMBER, @CONTROLLED, @PRODUCTID' +
        ', @CUSTOMER_ID'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'#9
      #9'end;'#9#9
      #9'COMMIT'
      'END')
    Left = 2832
    Top = 112
  end
