  object D0_GetFloatCharacter: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'create procedure [dbo].[D0_GetFloatCharacter] @tokenvalue varcha' +
        'r(20), @outputToken varchar(20) output'
      'as'
      'declare @token varchar(20)'
      'declare @len int'
      'declare @last_chr varchar(1)'
      'declare @str_output varchar(20)'
      'declare @spec_character char(1)'
      'begin'
      '  if rtrim(@tokenvalue) = '#39'0.00'#39
      '  begin'
      '    set @outputToken = '#39'{'#39';'
      '  end'
      '  else'
      '  begin'
      #9'set @tokenvalue = CONVERT(DECIMAL(10,2),@tokenvalue);'
      #9'set @last_chr = '#39#39';'
      #9'set @token = replace(@tokenvalue, '#39'.'#39', '#39#39');'
      #9'set @len = LEN(@token);'
      #9'set @last_chr = substring(@token,@len,1);   '
      #9'set @str_output = SUBSTRING(@token,1,@len-1);'
      #9'if @last_chr = '#39'0'#39' set @spec_character = '#39'{'#39';'
      #9'if @last_chr = '#39'1'#39' set @spec_character = '#39'A'#39';'
      #9'if @last_chr = '#39'2'#39' set @spec_character = '#39'B'#39';'
      #9'if @last_chr = '#39'3'#39' set @spec_character = '#39'C'#39';'
      #9'if @last_chr = '#39'4'#39' set @spec_character = '#39'D'#39';'
      #9'if @last_chr = '#39'5'#39' set @spec_character = '#39'E'#39';'
      #9'if @last_chr = '#39'6'#39' set @spec_character = '#39'F'#39';'
      #9'if @last_chr = '#39'7'#39' set @spec_character = '#39'G'#39';'
      #9'if @last_chr = '#39'8'#39' set @spec_character = '#39'H'#39';'
      #9'if @last_chr = '#39'9'#39' set @spec_character = '#39'I'#39';'
      #9'set @outputToken = @str_output + @spec_character;'
      '  end;'
      'end;'
      ''
      '')
    Left = 6048
    Top = 616
  end
  object D0_COB_segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'Create Procedure [dbo].[D0_COB_segment] @otc_number int, @billin' +
        'g_type char(2),  @COB_string varchar(4000) OUTPUT'
      'as'
      'declare @temp_value char(20)'
      '-- COB_A ----------------------------'
      'declare @NumberRecords int'
      'declare @segment_separator char(1);'
      'declare @FS char(1);'
      'declare @COB_338_5C char(2)'
      'declare @COB_339_6C char(2)'
      'declare @COB_340_7C char(10)'
      'declare @COB_443_E8 date '
      'declare @COB_993_A7 nchar(30)'
      'declare @COB_Bcount int'
      'declare @notrans int'
      '--COB_B------------------------------'
      'declare @COB_342_HC char(2)'
      'declare @COB_431_DV float'
      '--COB_C------------------------------'
      'declare @COB_Ccount int'
      'declare @COB_472_6E NCHAR(3)'
      '--COB_D------------------------------'
      'declare @COB_Dcount int '
      'declare @COB_351_NP char(2)'
      'declare @COB_352_NQ float'
      'declare @cob_segment_string varchar(500)'
      '--COB_E-------------------------------'
      'declare @COB_Ecount int'
      'declare @COB_393_MV char(2)'
      'declare @COB_394_MW float'
      'declare @RowCounter int'
      'begin'
      '  '#9'SET NOCOUNT ON;'
      '    set @RowCounter = 0;'
      
        #9'select @NumberRecords = count(*) from COB_A where otcnumber = @' +
        'otc_number;'
      #9'if @NumberRecords > 0'
      #9'begin'
      #9#9'set @segment_separator = char(30);'
      #9#9'set @FS = char(28);'
      #9#9'set @COB_string = @segment_separator + @FS + '#39'AM'#39' + '#39'05'#39';'
      #9#9
      
        #9#9'DECLARE MyCursor_COBA CURSOR FOR Select COB_338_5C, COB_339_6C' +
        ', COB_340_7C, COB_443_E8, '
      #9#9#9#9'COB_993_A7, NOTRANS from COB_A where OTCNUMBER = @otc_number'
      #9#9'OPEN MyCursor_COBA'
      #9#9'FETCH NEXT FROM MyCursor_COBA'
      
        #9#9'INTO @COB_338_5C, @COB_339_6C, @COB_340_7C, @COB_443_E8, @COB_' +
        '993_A7, @notrans'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      
        #9#9#9'Select @COB_338_5C = COB_338_5C, @COB_339_6C = COB_339_6C, @C' +
        'OB_340_7C = COB_340_7C, @COB_443_E8 = COB_443_E8, '
      
        #9#9#9#9'@COB_993_A7 = COB_993_A7, @notrans = NOTRANS  from COB_A whe' +
        're OTCNUMBER = @otc_number;'#9'    '
      
        #9#9#9'set @COB_string += @FS + '#39'4C'#39' + rtrim(CAST(@NumberRecords AS ' +
        'VARCHAR(2))) ; -- 337-4C'
      
        #9#9#9'if @COB_338_5C > '#39#39' set @COB_string += @FS + '#39'5C'#39' + rtrim(upp' +
        'er(@COB_338_5C)); -- 338-5C'
      #9#9#9'if @billing_type <> '#39'B2'#39
      #9#9#9'begin'
      
        #9#9#9#9'if @COB_339_6C > '#39#39' set @COB_string += @FS + '#39'6C'#39' + rtrim(up' +
        'per(@COB_339_6C)); -- 339-6C '
      
        #9#9#9#9'if @COB_340_7C > '#39#39' set @COB_string += @FS + '#39'7C'#39' + rtrim(up' +
        'per(@COB_340_7C)); -- 34'#216'-7C'
      
        #9#9#9#9'set @COB_string += @FS + '#39'E8'#39' + FORMAT(@COB_443_E8, '#39'yyyyMMd' +
        'd'#39'); -- 443-E8 '
      
        #9#9#9#9'if @COB_993_A7 > '#39#39' set @COB_string += @FS + '#39'7C'#39' + rtrim(up' +
        'per(@COB_340_7C)); -- 34'#216'-7C '
      ''
      
        #9#9#9#9'--COB_B ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_B where NOTRANS = ' +
        '@notrans;'
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'HB'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))) ; -- 341-HB'
      
        #9#9#9#9#9'DECLARE MyCursor_COBB CURSOR FOR Select COB_342_HC, COB_431' +
        '_DV from COB_B where NOTRANS = @notrans'
      #9#9#9#9#9'OPEN MyCursor_COBB'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBB'
      #9#9#9#9#9'INTO @COB_342_HC, @COB_431_DV '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_342_HC > '#39#39' set @COB_string += @FS + '#39'HC'#39' + rtrim(' +
        'upper(@COB_342_HC)); -- 342-HC   '
      #9#9#9#9#9#9'if @COB_431_DV >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_431_DV, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'DV'#39' + rtrim(@temp_value); -- 43' +
        '1-DV'
      #9#9#9#9#9#9'end;'#9#9#9#9
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBB'
      #9#9#9#9#9#9'INTO @COB_342_HC, @COB_431_DV '
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBB'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBB'
      #9#9#9#9' end;'#9#9
      
        #9#9#9#9'--COB_C ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_C where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'#9#9#9#9
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'5E'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --471-5E'
      
        #9#9#9#9#9'DECLARE MyCursor_COBC CURSOR FOR Select COB_472_6E FROM COB' +
        '_C where NOTRANS = @notrans;'
      #9#9#9#9#9'OPEN MyCursor_COBC'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBC'
      #9#9#9#9#9'INTO @COB_472_6E '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_472_6E > '#39#39' set @COB_string += @FS + '#39'6E'#39' + rtrim(' +
        'upper(@COB_472_6E)); -- 472-6E  '
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBC'
      #9#9#9#9#9#9'INTO @COB_472_6E '
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBC'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBC'
      #9#9#9#9'end;'#9
      
        #9#9#9#9'--COB_D ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_D where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'NR'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --353-NR'
      
        #9#9#9#9#9'DECLARE MyCursor_COBD CURSOR FOR Select COB_351_NP, COB_352' +
        '_NQ  FROM COB_D where NOTRANS = @notrans;'
      #9#9#9#9#9'OPEN MyCursor_COBD'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBD'
      #9#9#9#9#9'INTO @COB_351_NP, @COB_352_NQ  '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_351_NP > '#39#39' set @COB_string += @FS + '#39'NP'#39' + rtrim(' +
        'upper(@COB_351_NP)); -- 351-NP'
      #9#9#9#9#9#9'if @COB_352_NQ >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_352_NQ, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'NQ'#39' + rtrim(@temp_value); -- 35' +
        '2-NQ'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBD'
      #9#9#9#9#9#9'INTO @COB_351_NP, @COB_352_NQ'
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBD'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBD'
      #9#9#9#9'end;'
      
        #9#9#9#9'--COB_E-----------------------------------------------------' +
        '-------------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_E where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'#9#9#9#9
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'MU'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --392-MU'
      
        #9#9#9#9#9'DECLARE MyCursor_COBE CURSOR FOR SELECT COB_393_MV, COB_394' +
        '_MW FROM COB_E where NOTRANS = @notrans'
      #9#9#9#9#9'OPEN MyCursor_COBE'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBE'
      #9#9#9#9#9'INTO @COB_393_MV, @COB_394_MW  '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_393_MV > '#39#39' set @COB_string += @FS + '#39'MV'#39' + rtrim(' +
        'upper(@COB_393_MV)); -- 393-MV'
      #9#9#9#9#9#9'if @COB_394_MW >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_394_MW, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'MW'#39' + rtrim(@temp_value); -- 39' +
        '4-MW'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBE'
      #9#9#9#9#9#9'INTO @COB_393_MV, @COB_394_MW'
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBE'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBE'
      #9#9#9#9'end;'
      #9#9#9'end;'
      
        #9#9#9'-------------------------------------------------------------' +
        '-----------------'
      #9#9#9'FETCH NEXT FROM MyCursor_COBA'
      
        #9#9#9'INTO @COB_338_5C, @COB_339_6C, @COB_340_7C, @COB_443_E8, @COB' +
        '_993_A7, @notrans'
      #9#9'END;'
      #9#9'CLOSE MyCursor_COBA'
      #9#9'DEALLOCATE MyCursor_COBA'
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @COB_string = '#39#39';'
      #9'end;'
      'end;')
    Left = 6056
    Top = 720
  end
  object D0_DUR_Segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[D0_DUR_Segment] @otcnumber int, @billing' +
        '_type char(2), @dur_str varchar(500) output '
      'AS'
      'declare @dur_count int'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @reasonfor_servcode char(2)'
      'declare @prof_serv_code char(2)'
      'declare @resu_ofserv_code char(2)'
      'declare @dur_ppslevel_ofeffort char(2)'
      'declare @dur_coagent_idqual char(2)'
      'declare @dur_coagent_id char(19)'
      'declare @counter int'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      #9'set @counter = 1;'
      
        #9'Select @dur_count = count(*) from DUR_PPS with (NOLOCK) where O' +
        'TCNUMBER = @otcnumber;'
      #9'if @dur_count > 0'
      #9'begin'
      #9#9'set @dur_str = @segment_separator + @FS + '#39'AM'#39' + '#39'08'#39';'#9#9
      
        #9#9'DECLARE MyCursorDUR CURSOR FOR SELECT REASONFOR_SERVCODE, PROF' +
        '_SERVICE_CODE, RESULT_OFSERVICE_CODE,'
      #9#9'DUR_PPSLEVELOFEFFORT, DUR_COAGENT_IDQUAL, DUR_COAGENTID'
      #9#9'from DUR_PPS where OTCNUMBER = @otcnumber;'
      #9#9'OPEN MyCursorDUR'
      #9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9'INTO @reasonfor_servcode, @prof_serv_code, @resu_ofserv_code,'
      #9#9'@dur_ppslevel_ofeffort, @dur_coagent_idqual, @dur_coagent_id'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'begin'#9#9#9
      
        #9#9'    set @dur_str += @FS + '#39'7E'#39' +  cast(@counter as varchar) --' +
        ' 473-7E;'
      
        #9#9#9'if @reasonfor_servcode > '#39#39' set @dur_str += @FS + '#39'E4'#39' + rtri' +
        'm(upper(@reasonfor_servcode)); -- 44'#216'-E4'
      
        #9#9#9'if @prof_serv_code > '#39#39' set @dur_str += @FS + '#39'E5'#39' + rtrim(up' +
        'per(@prof_serv_code)); -- 44'#216'-E5  '
      
        #9#9#9'if @resu_ofserv_code > '#39#39' set @dur_str += @FS + '#39'E6'#39' + rtrim(' +
        'upper(@resu_ofserv_code)); -- 441-E6'
      
        #9#9#9'if @dur_ppslevel_ofeffort > '#39#39' set @dur_str += @FS + '#39'E8'#39' + r' +
        'trim(upper(@dur_ppslevel_ofeffort)); -- 474-8E'
      #9#9#9'-- Not used for reversal'
      #9#9#9'if @billing_type = '#39'B1'#39
      #9#9#9'begin'
      
        #9#9#9#9'if @dur_coagent_idqual > '#39#39' set @dur_str += @FS + '#39'J9'#39' + rtr' +
        'im(upper(@dur_coagent_idqual)); -- 475-J9'
      
        #9#9#9#9'if @dur_coagent_id > '#39#39' set @dur_str += @FS + '#39'H6'#39' + rtrim(u' +
        'pper(@dur_coagent_id)); -- 476-H6'
      #9#9#9'end;'
      #9#9#9'set @counter = @counter+1;'
      #9#9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9#9'INTO @reasonfor_servcode, @prof_serv_code, @resu_ofserv_code,'
      #9#9#9'@dur_ppslevel_ofeffort, @dur_coagent_idqual, @dur_coagent_id'
      #9#9'end;'
      #9#9'CLOSE MyCursorDUR'
      #9#9'DEALLOCATE MyCursorDUR'
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @dur_str = '#39#39';'
      #9'end;'
      'END;')
    Left = 6064
    Top = 824
  end
  object D0_Workers_compensation: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE D0_Workers_compensation @otcnumber int, @worker' +
        's_comp_str varchar(1000) output '
      'AS'
      'declare @count int'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @date_of_injury date'
      'declare @emp_name nchar(30)'
      'declare @emp_street_add nchar(30)'
      'declare @emp_city nchar(20)'
      'declare @emp_state char(2)'
      'declare @emp_zip nchar(15)'
      'declare @emp_phone nchar(10)'
      'declare @emp_contact_name nchar(30)'
      'declare @carrier_id nchar(10)'
      'declare @claim_ref_id nchar(30)'
      'declare @bill_entity_typeindi char(2)'
      'declare @pay_to_qual char(2)'
      'declare @pay_to_id nchar(15)'
      'declare @pay_to_name nchar(20)'
      'declare @pay_to_street nchar(30)'
      'declare @pay_to_city nchar(20)'
      'declare @pay_to_state char(2)'
      'declare @pay_to_zip nchar(15)'
      'declare @gen_eq_prodid_qual char(2)'
      'declare @gen_eq_prodid nchar(19)'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      
        #9'select @count = count(*) from WORKERS_COMPENSATION_SEGMENT wher' +
        'e OTC_NUMBER = @otcnumber;'
      #9'set @workers_comp_str = '#39#39';'
      #9'if @count > 0'
      #9'begin'
      
        #9#9'set @workers_comp_str = @segment_separator + @FS + '#39'AM'#39' + '#39'06'#39 +
        ';'
      
        #9'  '#9'DECLARE MyCursorDUR CURSOR FOR SELECT DATE_OF_INJURY, EMPLOY' +
        'ER_NAME, EMP_STREET_ADDRESS,'
      
        #9#9'EMP_CITY, EMP_STATE, EMP_ZIP, EMP_PHONE, EMP_CONTACT_NAME, CAR' +
        'RIER_ID, '
      
        #9#9'CLAIM_REFERENCE_ID, BILLING_ENTITY_TYPE_INDICATOR, PAY_TO_QUAL' +
        'IFIER, '
      
        #9#9'PAY_TO_ID, PAY_TO_NAME, PAY_TO_STREET_ADDRESS, PAY_TO_CITY_ADD' +
        'RESS,'
      
        #9#9'PAY_TO_STATE, PAY_TO_ZIP, GENERIC_EQUIVALENT_PRODUCT_ID_QUALIF' +
        'IER, GENERIC_EQUIVALENT_PRODUCT_ID'
      
        #9#9'from WORKERS_COMPENSATION_SEGMENT where OTC_NUMBER = @otcnumbe' +
        'r;'
      #9#9'OPEN MyCursorDUR'
      #9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9'INTO @date_of_injury, @emp_name, @emp_street_add, '
      
        #9#9'@emp_city, @emp_state, @emp_zip, @emp_phone, @emp_contact_name' +
        ', @carrier_id, '#9#9
      #9#9'@claim_ref_id, @bill_entity_typeindi, @pay_to_qual,'
      #9#9'@pay_to_id, @pay_to_name, @pay_to_street, @pay_to_city,'
      
        #9#9'@pay_to_state, @pay_to_zip, @gen_eq_prodid_qual, @gen_eq_prodi' +
        'd'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'begin'#9#9#9
      
        #9#9#9'set @workers_comp_str += @FS + '#39'DY'#39' + FORMAT(@date_of_injury,' +
        ' '#39'yyyyMMdd'#39'); --434-DY '
      
        #9#9#9'if @emp_name > '#39#39' set @workers_comp_str += @FS + '#39'CF'#39' + rtrim' +
        '(upper(@emp_name)); -- 315-CF'
      
        #9#9#9'if @emp_street_add > '#39#39' set @workers_comp_str += @FS + '#39'CG'#39' +' +
        ' rtrim(upper(@emp_street_add)); -- 316-CG'
      
        #9#9#9'if @emp_city > '#39#39' set @workers_comp_str += @FS + '#39'CH'#39' + rtrim' +
        '(upper(@emp_city)); -- 317-CH'
      
        #9#9#9'if @emp_state > '#39#39' set @workers_comp_str += @FS + '#39'CI'#39' + rtri' +
        'm(upper(@emp_state)); -- 318-CI'
      
        #9#9#9'if @emp_zip > '#39#39' set @workers_comp_str += @FS + '#39'CJ'#39' + rtrim(' +
        'upper(@emp_zip)); -- 319-CJ '
      
        #9#9#9'if @emp_phone > '#39#39' set @workers_comp_str += @FS + '#39'CK'#39' + rtri' +
        'm(upper(@emp_phone)); -- 32'#216'-CK '
      
        #9#9#9'if @emp_contact_name > '#39#39' set @workers_comp_str += @FS + '#39'CL'#39 +
        ' + rtrim(upper(@emp_contact_name)); -- 321-CL '
      
        #9#9#9'if @carrier_id > '#39#39' set @workers_comp_str += @FS + '#39'CR'#39' + rtr' +
        'im(upper(@carrier_id)); -- 327-CR '
      
        #9#9#9'if @claim_ref_id > '#39#39' set @workers_comp_str += @FS + '#39'DZ'#39' + r' +
        'trim(upper(@claim_ref_id)); -- 435-DZ  '
      #9#9#9
      
        #9#9#9'if @bill_entity_typeindi > '#39#39' set @workers_comp_str += @FS + ' +
        #39'TR'#39' + rtrim(upper(@bill_entity_typeindi)); -- 117-TR'
      
        #9#9#9'if @pay_to_qual > '#39#39' set @workers_comp_str += @FS + '#39'TS'#39' + rt' +
        'rim(upper(@pay_to_qual)); -- 118-TS'
      
        #9#9#9'if @pay_to_id > '#39#39' set @workers_comp_str += @FS + '#39'TT'#39' + rtri' +
        'm(upper(@pay_to_id)); -- 119-TT'
      
        #9#9#9'if @pay_to_name > '#39#39' set @workers_comp_str += @FS + '#39'TU'#39' + rt' +
        'rim(upper(@pay_to_name)); -- 12'#216'-TU'
      
        #9#9#9'if @pay_to_street > '#39#39' set @workers_comp_str += @FS + '#39'TV'#39' + ' +
        'rtrim(upper(@pay_to_street)); -- 121-TV '
      
        #9#9#9'if @pay_to_city > '#39#39' set @workers_comp_str += @FS + '#39'TW'#39' + rt' +
        'rim(upper(@pay_to_city)); -- 122-TW '
      
        #9#9#9'if @pay_to_state > '#39#39' set @workers_comp_str += @FS + '#39'TX'#39' + r' +
        'trim(upper(@pay_to_state)); -- 123-TX '
      
        #9#9#9'if @pay_to_zip > '#39#39' set @workers_comp_str += @FS + '#39'TY'#39' + rtr' +
        'im(upper(@pay_to_state)); -- 124-TY'
      
        #9#9#9'if @gen_eq_prodid_qual > '#39#39' set @workers_comp_str += @FS + '#39'T' +
        'Z'#39' + rtrim(upper(@pay_to_state)); -- 125-TZ '
      
        #9#9#9'if @gen_eq_prodid > '#39#39' set @workers_comp_str += @FS + '#39'UA'#39' + ' +
        'rtrim(upper(@gen_eq_prodid)); -- 126-UA  '
      #9#9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9#9'INTO @date_of_injury, @emp_name, @emp_street_add, '
      
        #9#9#9'@emp_city, @emp_state, @emp_zip, @emp_phone, @emp_contact_nam' +
        'e,'
      
        #9#9#9'@carrier_id, @claim_ref_id, @bill_entity_typeindi, @pay_to_qu' +
        'al,'
      #9#9#9'@pay_to_id, @pay_to_name, @pay_to_street, @pay_to_city,'
      
        #9#9#9'@pay_to_state, @pay_to_zip, @gen_eq_prodid_qual, @gen_eq_prod' +
        'id'
      #9#9'end;'
      #9#9'CLOSE MyCursorDUR'
      #9#9'DEALLOCATE MyCursorDUR'
      #9'end;'
      '    '
      'END')
    Left = 6064
    Top = 928
  end
  object D0_Compound_segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_Compound_segment]'
      '    @otcnumber     INT,'
      '    @compound_str  VARCHAR(4000) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @count                   INT,'
      '            @segment_separator       CHAR(1),'
      '            @FS                      CHAR(1),'
      '            @comp_dos_form_des_code  CHAR(2),'
      '            @comp_unit_form_indi     CHAR(1),'
      '            @prod_id_qual            CHAR(2),'
      '            @ndc                     VARCHAR(19),'
      '            @met_qty                 DECIMAL(18,3),'
      '            @awp                     FLOAT,'
      '            @temp_value              VARCHAR(50),'
      '            @ing_basis_ofcost_det    CHAR(2);'
      ''
      '    SET @segment_separator = CHAR(30);'
      '    SET @FS = CHAR(28);'
      '    SET @compound_str = '#39#39';'
      ''
      '    SELECT @count = COUNT(*)'
      '    FROM dbo.MEZCLAS'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    IF ISNULL(@count, 0) <= 0'
      '        RETURN;'
      ''
      '    SELECT'
      '        @comp_dos_form_des_code = COMPDOSAGE_FORM_DESC_CODE,'
      '        @comp_unit_form_indi    = COMPDISP_UNIT_FORM_INDI'
      '    FROM dbo.OTC'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    -- Compound Segment ID'
      
        '    SET @compound_str = @compound_str + @segment_separator + @FS' +
        ' + '#39'AM10'#39';'
      ''
      '    -- 450-EF Compound Dosage Form Description Code'
      '    IF ISNULL(LTRIM(RTRIM(@comp_dos_form_des_code)), '#39#39') <> '#39#39
      
        '        SET @compound_str = @compound_str + @FS + '#39'EF'#39' + UPPER(R' +
        'TRIM(@comp_dos_form_des_code));'
      ''
      '    -- 451-EG Compound Dispensing Unit Form Indicator'
      '    IF ISNULL(LTRIM(RTRIM(@comp_unit_form_indi)), '#39#39') <> '#39#39
      
        '        SET @compound_str = @compound_str + @FS + '#39'EG'#39' + UPPER(R' +
        'TRIM(@comp_unit_form_indi));'
      ''
      '    -- 447-EC Compound Ingredient Component Count'
      
        '    SET @compound_str = @compound_str + @FS + '#39'EC'#39' + CAST(@count' +
        ' AS VARCHAR(10));'
      ''
      '    DECLARE MyCursorComp CURSOR LOCAL FAST_FORWARD FOR'
      '        SELECT'
      '            PRODUCT_ID_QUALIFIER,'
      '            NDC,'
      '            METRICQUANTITY,'
      '            AWP,'
      '            ING_BASIS_OFCOST_DET'
      '        FROM dbo.MEZCLAS'
      '        WHERE OTCNUMBER = @otcnumber'
      '        ORDER BY NDC, PRODUCT_ID_QUALIFIER;'
      ''
      '    OPEN MyCursorComp;'
      ''
      '    FETCH NEXT FROM MyCursorComp'
      
        '    INTO @prod_id_qual, @ndc, @met_qty, @awp, @ing_basis_ofcost_' +
        'det;'
      ''
      '    WHILE @@FETCH_STATUS = 0'
      '    BEGIN'
      '        -- 488-RE Product ID Qualifier'
      '        IF ISNULL(LTRIM(RTRIM(@prod_id_qual)), '#39#39') <> '#39#39
      
        '            SET @compound_str = @compound_str + @FS + '#39'RE'#39' + UPP' +
        'ER(RTRIM(@prod_id_qual));'
      ''
      '        -- 489-TE Product ID'
      '        IF ISNULL(LTRIM(RTRIM(@ndc)), '#39#39') <> '#39#39
      
        '            SET @compound_str = @compound_str + @FS + '#39'TE'#39' + UPP' +
        'ER(RTRIM(@ndc));'
      ''
      '        -- 448-ED Metric Quantity'
      '        IF @met_qty IS NOT NULL'
      '        BEGIN'
      '            EXEC dbo.D0_GetFloatCharacter'
      '                @InputValue = @met_qty,'
      '                @outputToken = @temp_value OUTPUT;'
      ''
      
        '            SET @compound_str = @compound_str + @FS + '#39'ED'#39' + RTR' +
        'IM(@temp_value);'
      '        END'
      ''
      '        -- 449-EE Ingredient Drug Cost'
      '        IF @awp IS NOT NULL AND @awp > 0'
      '        BEGIN'
      '            EXEC dbo.D0_GetFloatCharacter'
      '                @InputValue = @awp,'
      '                @outputToken = @temp_value OUTPUT;'
      ''
      
        '            SET @compound_str = @compound_str + @FS + '#39'EE'#39' + RTR' +
        'IM(@temp_value);'
      '        END'
      ''
      '        -- 490-UE Ingredient Basis of Cost Determination'
      '        IF ISNULL(LTRIM(RTRIM(@ing_basis_ofcost_det)), '#39#39') <> '#39#39
      
        '            SET @compound_str = @compound_str + @FS + '#39'UE'#39' + UPP' +
        'ER(RTRIM(@ing_basis_ofcost_det));'
      ''
      '        FETCH NEXT FROM MyCursorComp'
      
        '        INTO @prod_id_qual, @ndc, @met_qty, @awp, @ing_basis_ofc' +
        'ost_det;'
      '    END;'
      ''
      '    CLOSE MyCursorComp;'
      '    DEALLOCATE MyCursorComp;'
      'END;')
    Left = 6064
    Top = 1024
  end
  object D0_Clinical_Segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_Clinical_Segment]'
      '      @otcnumber INT'
      '    , @clinical_str VARCHAR(1000) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @work_str VARCHAR(MAX) = '#39#39';'
      ''
      '    DECLARE @DiagnosisCount INT = 0;'
      '    DECLARE @InfoCount INT = 0;'
      ''
      '    SET @clinical_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Count diagnosis rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT @DiagnosisCount = COUNT(*)'
      '    FROM dbo.CLINICAL_SEGMENT'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    IF ISNULL(@DiagnosisCount, 0) = 0'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str = @SEG + @FS + '#39'AM13'#39';'
      
        '    SET @work_str += @FS + '#39'VE'#39' + CAST(@DiagnosisCount AS VARCHA' +
        'R(10)); -- 491-VE'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Diagnosis rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    ;WITH D AS'
      '    ('
      '        SELECT'
      '              rn = ROW_NUMBER() OVER (ORDER BY OTCNUMBER)'
      
        '            , DIAGNOSIS_CODE_QUAL = ISNULL(DIAGNOSIS_CODE_QUAL, ' +
        #39#39')'
      '            , DIAGNOSIS_CODE      = ISNULL(DIAGNOSIS_CODE, '#39#39')'
      '        FROM dbo.CLINICAL_SEGMENT'
      '        WHERE OTCNUMBER = @otcnumber'
      '    )'
      '    SELECT @work_str += ISNULL('
      '    ('
      '        SELECT'
      '              CASE'
      '                  WHEN RTRIM(D.DIAGNOSIS_CODE_QUAL) <> '#39#39
      
        '                      THEN @FS + '#39'WE'#39' + RTRIM(UPPER(D.DIAGNOSIS_' +
        'CODE_QUAL)) -- 492-WE'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      '                  WHEN RTRIM(D.DIAGNOSIS_CODE) <> '#39#39
      
        '                      THEN @FS + '#39'DO'#39' + RTRIM(UPPER(D.DIAGNOSIS_' +
        'CODE))      -- 424-DO'
      '                  ELSE '#39#39
      '              END'
      '        FROM D'
      '        ORDER BY D.rn'
      '        FOR XML PATH('#39#39'), TYPE'
      '    ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Clinical measurement/info rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT @InfoCount = COUNT(*)'
      '    FROM dbo.CLINICAL_SEGMENT_INFO'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    IF ISNULL(@InfoCount, 0) > 0'
      '    BEGIN'
      '        ;WITH I AS'
      '        ('
      '            SELECT'
      '                  rn = ROW_NUMBER() OVER (ORDER BY OTCNUMBER)'
      '                , MEASUREMENT_DATE      = MEASUREMENT_DATE'
      
        '                , MEASUREMENT_TIME      = ISNULL(MEASUREMENT_TIM' +
        'E, '#39#39')'
      
        '                , MEASUREMENT_DIMENSION = ISNULL(MEASUREMENT_DIM' +
        'ENSION, '#39#39')'
      
        '                , MEASUREMENT_UNIT      = ISNULL(MEASUREMENT_UNI' +
        'T, '#39#39')'
      
        '                , MEASUREMENT_VALUE     = ISNULL(MEASUREMENT_VAL' +
        'UE, '#39#39')'
      '            FROM dbo.CLINICAL_SEGMENT_INFO'
      '            WHERE OTCNUMBER = @otcnumber'
      '        )'
      '        SELECT @work_str += ISNULL('
      '        ('
      '            SELECT'
      
        '                  @FS + '#39'XE'#39' + CAST(I.rn AS VARCHAR(10))        ' +
        '              -- 493-XE'
      '                + CASE'
      '                      WHEN I.MEASUREMENT_DATE IS NOT NULL'
      
        '                          THEN @FS + '#39'ZE'#39' + CONVERT(CHAR(8), I.M' +
        'EASUREMENT_DATE, 112) -- 494-ZE'
      '                      ELSE '#39#39
      '                  END'
      '                + CASE'
      '                      WHEN RTRIM(I.MEASUREMENT_TIME) <> '#39#39
      
        '                          THEN @FS + '#39'H1'#39' + RTRIM(UPPER(I.MEASUR' +
        'EMENT_TIME))  -- 495-H1'
      '                      ELSE '#39#39
      '                  END'
      '                + CASE'
      '                      WHEN RTRIM(I.MEASUREMENT_DIMENSION) <> '#39#39
      
        '                          THEN @FS + '#39'H2'#39' + RTRIM(UPPER(I.MEASUR' +
        'EMENT_DIMENSION)) -- 496-H2'
      '                      ELSE '#39#39
      '                  END'
      '                + CASE'
      '                      WHEN RTRIM(I.MEASUREMENT_UNIT) <> '#39#39
      
        '                          THEN @FS + '#39'H3'#39' + RTRIM(UPPER(I.MEASUR' +
        'EMENT_UNIT))  -- 497-H3'
      '                      ELSE '#39#39
      '                  END'
      '                + CASE'
      '                      WHEN RTRIM(I.MEASUREMENT_VALUE) <> '#39#39
      
        '                          THEN @FS + '#39'H4'#39' + RTRIM(UPPER(I.MEASUR' +
        'EMENT_VALUE)) -- 499-H4'
      '                      ELSE '#39#39
      '                  END'
      '            FROM I'
      '            ORDER BY I.rn'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      '    END'
      ''
      '    SET @clinical_str = LEFT(@work_str, 1000);'
      'END')
    Left = 6064
    Top = 1128
  end
  object SOFTWARE_VERSION: TFDQuery
