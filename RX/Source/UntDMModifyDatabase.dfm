        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42927'#39', N'#39'Extended Release' +
        ' Tablet'#39', N'#39'A tablet designed to release active and/or inert ing' +
        'redient(s) at a controlled prolonged rate so as to reduce dosing' +
        ' frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42929'#39', N'#39'Extract'#39', N'#39'A di' +
        'stillate composed of active and/or inert ingredient(s) extracted' +
        ' from plant or animal matter and represented in concentrated for' +
        'm.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42932'#39', N'#39'Film'#39', N'#39'A thin ' +
        'layer of water soluble or insoluble polymer intended to coat the' +
        ' site of administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42930'#39', N'#39'Film Coated Exte' +
        'nded Release Tablet'#39', N'#39'A tablet covered with a thin layer of wa' +
        'ter soluble or insoluble polymer and is designed to release acti' +
        've and/or inert ingredient(s) at a controlled prolonged rate so ' +
        'as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42931'#39', N'#39'Film Coated Tabl' +
        'et'#39', N'#39'A tablet covered with a thin layer of water soluble or in' +
        'soluble polymer.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68982'#39', N'#39'Flake'#39', N'#39'A soli' +
        'd composed of active and/or inert ingredient(s) that resembles s' +
        'mall thin chips.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64898'#39', N'#39'Foam'#39', N'#39'An aera' +
        'ted solution or suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64899'#39', N'#39'Foam Bath'#39', N'#39'A ' +
        'solution or suspension that produces dense bubbles when combined' +
        ' with water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60927'#39', N'#39'for Solution'#39', N' +
        #39'A substance intended for administration as a solution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68991'#39', N'#39'Fluid Extract'#39', ' +
        'N'#39'A solution or suspension distillate composed of active and/or ' +
        'inert ingredient(s) extracted from plant or animal matter and al' +
        'cohol as the solvent and/or preservative. Fluid extract is prepa' +
        'red by percolation and subsequent evaporation such that the ingr' +
        'edient in each milliliter of the fluid extract is equivalent to ' +
        '1 gram of the dried plant or animal derived matter.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60928'#39', N'#39'for Suspension'#39',' +
        ' N'#39'A substance intended for administration as a suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68966'#39', N'#39'Frozen Premix In' +
        'travenous Piggyback Solution'#39', N'#39'A solution that is reconstitute' +
        'd from a frozen pre-mixed form intended for intravenous administ' +
        'ration simultaneously with an established compatible maintenance' +
        ' infusion drug by a mutual intravenous access.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C78748'#39', N'#39'Gargle'#39', N'#39'A sol' +
        'ution or suspension taken orally and moved around the back of th' +
        'e throat by tilting the head back and forcing air from the lungs' +
        ' through the solution. Unless specifically directed the solution' +
        ' is expelled and not swallowed.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42933'#39', N'#39'Gas'#39', N'#39'An elast' +
        'ic aeriform fluid in which the molecules are separated from one ' +
        'another and have freedom of movement.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42934'#39', N'#39'Gel'#39', N'#39'A semi-s' +
        'olid composed of a solid three dimensional cross linked matrix o' +
        'f polymers within a liquid yielding a jelly-like material unable' +
        ' to flow at steady state.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60994'#39', N'#39'Gel Forming Drop' +
        ' Solution'#39', N'#39'A solution intended for administration in a drop-w' +
        'ise fashion; it becomes gelatinous upon administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68973'#39', N'#39'Gel Forming Solu' +
        'tion'#39', N'#39'A solution that becomes a gelatinous liquid after admin' +
        'istration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42936'#39', N'#39'Gelatin Coated C' +
        'apsule'#39', N'#39'A capsule covered with a thin layer of gelatin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64872'#39', N'#39'Gelatin Coated T' +
        'ablet'#39', N'#39'A tablet covered with a layer of gelatin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C48193'#39', N'#39'Generator'#39', N'#39'An' +
        ' apparatus that converts solutions suspensions or solids compose' +
        'd of active and/or inert ingredient(s) into a vapor or gas by he' +
        'at or chemical reaction.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42937'#39', N'#39'Globule'#39', N'#39'A so' +
        'lid composed of sucrose lactose or other polysaccharides formed ' +
        'into small globular pellets impregnated with active and/or inert' +
        ' ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45416'#39', N'#39'Graft'#39', N'#39'A soli' +
        'd composed of a piece of skin or other tissue intended for impla' +
        'ntation into or on the body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42938'#39', N'#39'Granule'#39', N'#39'A so' +
        'lid composed of small particles or grains.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69066'#39', N'#39'Granule for Reco' +
        'nstitution'#39', N'#39'A solid in the shape of a small particle or grain' +
        ' mixed with a liquid to form a solution or suspension before adm' +
        'inistration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42939'#39', N'#39'Granule for Solu' +
        'tion'#39', N'#39'A granule intended for administration as a solution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42940'#39', N'#39'Granule for Susp' +
        'ension'#39', N'#39'A granule intended for administration as a suspension' +
        '.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42941'#39', N'#39'Gum'#39', N'#39'A semi-s' +
        'olid composed of a sticky mucilaginous polysaccharide.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64904'#39', N'#39'Hard Capsule'#39', N' +
        #39'A capsule covered with a rigid outer shell.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64882'#39', N'#39'Homeopathic Glob' +
        'ule'#39', N'#39'A solid composed of sucrose lactose or other polysacchar' +
        'ides formed into small globular pellets of uniform size which ca' +
        'n be classified as homeopathic.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42752'#39', N'#39'Hypodermic Table' +
        't'#39', N'#39'A tablet dissolved in solvent and intended for administrat' +
        'ion by hypodermic injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42669'#39', N'#39'Immediate Releas' +
        'e'#39', N'#39'A solid semi-solid solution or suspension that is designed' +
        ' to release its active and/or inert ingredient(s) upon administr' +
        'ation with no enhanced delayed or extended release effect.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42942'#39', N'#39'Implant'#39', N'#39'A so' +
        'lid intended for insertion securely within the body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42943'#39', N'#39'Implantable Pell' +
        'et'#39', N'#39'A pellet intended for insertion securely within the body.' +
        #39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42944'#39', N'#39'Inhalant'#39', N'#39'Vap' +
        'orized active and/or inert ingredient(s) intended for administra' +
        'tion by inhalation.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91142'#39', N'#39'Inhalant Powder'#39 +
        ', N'#39'Powdered medication inhaled as a measured dose.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91143'#39', N'#39'Inhalant Solutio' +
        'n'#39', N'#39'Liquid medication intended to be inhaled.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64879'#39', N'#39'Inhaler Capsule'#39 +
        ', N'#39'A capsule composed of powders intended for oral inhalation. ' +
        'This dose form may also refer to capsules that are intended for ' +
        'use in inhalers.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42946'#39', N'#39'Injectable'#39', N'#39'A' +
        ' substance intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42926'#39', N'#39'Injectable Exten' +
        'ded Release Suspension'#39', N'#39'A suspension intended for injection t' +
        'hat is designed to release active and/or inert ingredient(s) at ' +
        'a controlled prolonged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42950'#39', N'#39'Injectable Lipid' +
        ' Complex'#39', N'#39'A substance composed of complexed active and/or ine' +
        'rt ingredient(s) with natural or synthetic lipids that is intend' +
        'ed for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42951'#39', N'#39'Injectable Lipos' +
        'omal Suspension'#39', N'#39'A suspension composed of active and/or inert' +
        ' ingredient(s) encapsulated in liposomes and intended for inject' +
        'ion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69037'#39', N'#39'Injectable Lyoph' +
        'ilized Powder'#39', N'#39'A freeze dried powder intended for injection f' +
        'ollowing reconstitution with a suitable solvent.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42945'#39', N'#39'Injectable Solut' +
        'ion'#39', N'#39'A solution intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42988'#39', N'#39'Injectable Sonic' +
        'ated Suspension'#39', N'#39'A suspension intended for injection and is s' +
        'onicated while a gas is bubbled through the suspension resulting' +
        ' in the creation of microspheres by the solid particles.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42995'#39', N'#39'Injectable Suspe' +
        'nsion'#39', N'#39'A suspension intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60933'#39', N'#39'Insert'#39', N'#39'A sol' +
        'id or semi-solid intended for administration within the body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C78793'#39', N'#39'Internal Powder'#39 +
        ', N'#39'A powder intended for use within the body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68971'#39', N'#39'Intraperitoneal ' +
        'Solution'#39', N'#39'A solution intended for administration into the int' +
        'raperitoneal cavity.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47915'#39', N'#39'Intrauterine Dev' +
        'ice'#39', N'#39'A solid intended for placement within the uterine cavity' +
        ' where active and/or inert ingredient(s) are released from an ap' +
        'paratus at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68967'#39', N'#39'Intravenous Pigg' +
        'yback Solution'#39', N'#39'A solution intended for intravenous administr' +
        'ation simultaneously with an established compatible maintenance ' +
        'infusion drug by a mutual intravenous access.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68965'#39', N'#39'Intravenous Solu' +
        'tion'#39', N'#39'A solution composed of a homogenous liquid that contain' +
        's active and/or inert ingredient(s) dissolved in a suitable solv' +
        'ent or mixture of mutually miscible solvents.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42947'#39', N'#39'Irrigant'#39', N'#39'A s' +
        'olution or suspension used to bathe or flush open wounds or body' +
        ' cavities.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42948'#39', N'#39'Jelly'#39', N'#39'A semi' +
        '-solid composed of suspensions of active and/or inert ingredient' +
        '(s) in any type of highly viscous material including gelatin or ' +
        'gel. The structural matrix of the jelly contains high levels of ' +
        'liquid.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47916'#39', N'#39'Kit'#39', N'#39'A collec' +
        'tion of unrelated materials that are used together to orchestrat' +
        'e dosage administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42949'#39', N'#39'Liniment'#39', N'#39'A s' +
        'emi-solid with viscosity similar to that of a lotion which is in' +
        'tended for topical use and must be rubbed into the site of admin' +
        'istration to release the active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60931'#39', N'#39'Liposomal Inject' +
        'ion'#39', N'#39'A substance composed of active and/or inert ingredient(s' +
        ') encapsulated in liposomes and intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42952'#39', N'#39'Lipstick'#39', N'#39'A s' +
        'olid or semi-solid with a waxy consistency in the shape of a sti' +
        'ck and intended for use on the lips.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42953'#39', N'#39'Liquid'#39', N'#39'A sub' +
        'stance in the fluid state of matter having no fixed shape but a ' +
        'fixed volume.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42954'#39', N'#39'Liquid Filled Ca' +
        'psule'#39', N'#39'A capsule composed of liquid covered with an outer she' +
        'll which is usually prepared from gelatin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68953'#39', N'#39'Liquid Soap'#39', N'#39 +
        'A solution or suspension composed of an anionic surfactant used ' +
        'for cleansing.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69068'#39', N'#39'Lollipop'#39', N'#39'A s' +
        'olid composed of a sugared medicated candy mounted to a stick wh' +
        'ich can be held while sucking or chewing on the candy.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C29167'#39', N'#39'Lotion'#39', N'#39'A sem' +
        'i-solid composed of an oil in water emulsion with lower viscosit' +
        'y than cream or gel.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60958'#39', N'#39'Lotion Shampoo'#39',' +
        ' N'#39'A lotion composed of anionic surfactant intended for administ' +
        'ration to the hair or scalp.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42955'#39', N'#39'Lozenge'#39', N'#39'A so' +
        'lid composed of active and/or inert ingredient(s) sweeteners oth' +
        'er flavorings and mucilage intended for oral administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42956'#39', N'#39'Lyophilized Powd' +
        'er for Extended Release Injectable Suspension'#39', N'#39'A freeze dried' +
        ' powder intended for injection following reconstitution with a s' +
        'uitable solvent to form a suspension that is designed to release' +
        ' active and/or inert ingredient(s) at a controlled prolonged rat' +
        'e so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42959'#39', N'#39'Lyophilized Powd' +
        'er for Injectable Liposomal Suspension'#39', N'#39'A freeze dried powder' +
        ' composed of active and/or inert ingredient(s) encapsulated in l' +
        'iposomes and intended for injection following reconstitution wit' +
        'h a suitable solvent to form a suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42957'#39', N'#39'Lyophilized Powd' +
        'er for Injectable Solution'#39', N'#39'A freeze dried powder intended fo' +
        'r injection following reconstitution with a suitable solvent to ' +
        'form a solution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42958'#39', N'#39'Lyophilized Powd' +
        'er for Injectable Suspension'#39', N'#39'A freeze dried powder intended ' +
        'for injection following reconstitution with a suitable solvent t' +
        'o form a suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68988'#39', N'#39'Medicated Adhesi' +
        've Patch'#39', N'#39'A solid composed of an impermeable occlusive backin' +
        'g a formulation matrix in which the active and/or inert ingredie' +
        'nt(s) are dissolved or dispersed and an adhesive layer. It is in' +
        'tended for external application.'#39')'
      
