      #9#9'Patient = @Patient '
      #9#9'and Prescriber = @Prescriber '
      #9#9'and RTRIM(TransactionType) <> '#39'CancelRx'#39' '
      #9#9'and EffectiveDate <= convert(varchar, GETDATE(), 101) '
      #9#9'and RxDate = @RxDate;'
