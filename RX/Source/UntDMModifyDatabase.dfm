  object RX_PROCESADAS: TFDQuery
    AfterExecute = RX_PROCESADASAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[RX_PROCESADAS]'
      'AS'
      
        'SELECT        PRESCRIPTIONS_1.FECHAULTIMOREFILL, PRESCRIPTIONS_1' +
        '.AUTOMATIC_REFILL, PRESCRIPTIONS_1.COMPOUNDCODE, PRESCRIPTIONS_1' +
        '.CANTIDAD_DISPONIBLE, PRESCRIPTIONS_1.NUMERODOCTOR, OTC_1.DAW, '
      
        '                         PRESCRIPTIONS_1.NUMEROCLIENTE, OTC_1.NO' +
        '_HORA, PRESCRIPTIONS_1.CANTIDADRECETADA, PRESCRIPTIONS_1.CANTIDA' +
        'D_DISPONIBLE AS DISPONIBLE, '
      
        '                         OTC_1.NO_REF_DISPENSADO AS NUMEROREFILL' +
        'SDISPENSADOS, PRESCRIPTIONS_1.LICENCIA, PRESCRIPTIONS_1.NUMERORE' +
        'FILLSAUTORIZADOS, OTC_1.PLAN_MEDICO, OTC_1.NUMERORECETA, OTC_1.F' +
        'ECHAOTC, '
      
        '                         OTC_1.QTY, OTC_1.DEDUCIBLE, OTC_1.PAGO_' +
        'PLAN, OTC_1.DAYS_SUPPLY, OTC_1.NUMERO_AUTORIZACION, OTC_1.GANANC' +
        'IA, OTC_1.MEDICAMENTO, OTC_1.COSTOVENTA, OTC_1.PRECIOFACTURACION' +
        ', '
      
        '                         OTC_1.PAGO_PLAN + OTC_1.DEDUCIBLE - OTC' +
        '_1.COSTOVENTA AS PAGOPLAN_DEDUCIBLE_Costo, OTC_1.ATENDIDOPOR, OT' +
        'C_1.PAGADA, OTC_1.PLAN_MEDICO AS PLANMEDICO, OTC_1.TOTAL AS PREC' +
        'IOVENTA, '
      
        '                         OTC_1.OTCNUMBER, OTC_1.COBRADO, OTC_1.N' +
        'UMEROPLAN, OTC_1.LOTE, OTC_1.SIGNATURE_LINK, OTC_1.PRODUCT_ID, O' +
        'TC_1.RX_STATUS, dbo.PACIENTES.NOMBRE, dbo.PACIENTES.APELLIDOPATE' +
        'RNO, '
      
        '                         dbo.PACIENTES.APELLIDOMATERNO, dbo.PACI' +
        'ENTES.TELEFONO, OTC_1.TIME_RX, OTC_1.REFILL_NOTIFIED, OTC_1.PHAR' +
        'MACIST, PRESCRIPTIONS_1.RXORIGINCODE, PRESCRIPTIONS_1.ACTIVE, '
      
        '                         dbo.PACIENTES.ADHERENCE, dbo.PACIENTES.' +
        'SSN, dbo.PACIENTES.CELULAR, OTC_1.CLAIM_STATUS, OTC_1.NDC, dbo.I' +
        'NVENTARIOPISO.CONTROLADO, dbo.INVENTARIOPISO.MARKETEDPRODUCTID, '
      
        '                         PRESCRIPTIONS_1.PROXIMOREFILL, dbo.PATP' +
        'LAN.CARDHOLDERID'
      'FROM            dbo.PRESCRIPTIONS AS PRESCRIPTIONS_1 INNER JOIN'
      
        '                         dbo.OTC AS OTC_1 ON OTC_1.NUMERORECETA ' +
        '= PRESCRIPTIONS_1.NUMERORECETA INNER JOIN'
      
        '                         dbo.PACIENTES ON PRESCRIPTIONS_1.NUMERO' +
        'CLIENTE = dbo.PACIENTES.NUMEROCLIENTE INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON OTC_1.PRODUCT_ID ' +
        '= dbo.INVENTARIOPISO.PRODUCTNO INNER JOIN'
      
        '                         dbo.PATPLAN ON OTC_1.NUMEROPLAN = dbo.P' +
        'ATPLAN.NUMEROPLAN')
    Left = 2016
    Top = 888
  end
