        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42919'#39', N'#39'Extended Release' +
        ' Core'#39', N'#39'A solid or liquid core composed of active and/or inert' +
        ' ingredient(s) enclosed by a polymer coated shell. It is designe' +
        'd to release active and/or inert ingredient(s) at a controlled p' +
        'rolonged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91140'#39', N'#39'Extended Release' +
        ' Enteric Coated Capsule'#39', N'#39'An extended release capsule covered ' +
        'with a substance that is designed to delay the release of active' +
        ' and/or inert ingredient(s) until the capsule passes into the in' +
