      #9#9'  ,[HCPCS] = @HCPCS'
      #9#9'  ,[CASA_FARMACEUTICA] = @CASA_FARMACEUTICA'
      #9#9'  ,[AllowControledRefills] = @AllowControledRefills'
      #9#9'  ,[PRICE_TABLE_ID] = @PRICE_TABLE_ID'
      
        #9#9'  ,[OVERRIDE_SYSTEM_DEFAULT_PRICE] = @OVERRIDE_SYSTEM_DEFAULT_' +
        'PRICE'
