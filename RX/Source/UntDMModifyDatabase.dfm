        'r of individual items packaged as a unit.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47887'#39', N'#39'Packing'#39', N'#39'A so' +
        'lid composed of a material that contains active and/or inert ing' +
        'redient(s) which is intended to be placed in a cavity or depress' +
        'ion within the body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69016'#39', N'#39'Pad'#39', N'#39'A solid ' +
        'composed of a soft non-adhesive and absorbent piece of fabric or' +
