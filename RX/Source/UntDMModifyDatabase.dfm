  object WORKSTATION_PRINTER_MAP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'IF OBJECT_ID('#39'dbo.WORKSTATION_PRINTER_MAP'#39', '#39'U'#39') IS NOT NULL'
      '    DROP TABLE dbo.WORKSTATION_PRINTER_MAP;'
      ''
      ''
      'CREATE TABLE dbo.WORKSTATION_PRINTER_MAP'
      '('
      '    ID INT IDENTITY(1,1) PRIMARY KEY,'
      ''
      '    -- Workstation Info'
      '    WORKSTATION_NAME NVARCHAR(100) NOT NULL,'
      '    WORKSTATION_IP   VARCHAR(50) NULL,'
      ''
      '    -- Label Mapping'
      '    LABEL_NAME NVARCHAR(100) NOT NULL,'
      ''
      '    -- Printer Mapping'
      '    PRINTER_ID   INT NULL,'
      '    PRINTER_NAME NVARCHAR(255) NOT NULL,'
      '    PRINTER_IP   VARCHAR(50) NULL,'
      '    PRINTER_PORT INT NULL,'
      ''
      '    -- Control Flag'
      '    IS_ACTIVE BIT NOT NULL DEFAULT 1,'
      ''
      '    -- Audit Columns'
      '    CREATED_ON DATETIME NOT NULL DEFAULT GETDATE(),'
      '    CREATED_BY NVARCHAR(100) NULL,'
      '    UPDATED_ON DATETIME NULL,'
      '    UPDATED_BY NVARCHAR(100) NULL'
      ');'
      ''
      ''
      'CREATE NONCLUSTERED INDEX IDX_WPM_LOOKUP'
      
        'ON dbo.WORKSTATION_PRINTER_MAP (WORKSTATION_NAME, LABEL_NAME, IS' +
        '_ACTIVE);'
      ''
      ''
      'CREATE UNIQUE NONCLUSTERED INDEX UX_WPM_UNIQUE_ACTIVE'
      'ON dbo.WORKSTATION_PRINTER_MAP (WORKSTATION_NAME, LABEL_NAME)'
      'WHERE IS_ACTIVE = 1;'
      ''
      ''
      'ALTER TABLE dbo.WORKSTATION_PRINTER_MAP'
      
        'ADD PRINT_CONTEXT VARCHAR(20) NOT NULL CONSTRAINT DF_WPM_PRINT_C' +
        'ONTEXT DEFAULT '#39'ALL'#39';'
      ''
      ''
      'DROP INDEX UX_WPM_UNIQUE_ACTIVE ON dbo.WORKSTATION_PRINTER_MAP;'
      ''
      ''
      'CREATE UNIQUE NONCLUSTERED INDEX UX_WPM_UNIQUE_ACTIVE'
      'ON dbo.WORKSTATION_PRINTER_MAP (WORKSTATION_NAME, PRINT_CONTEXT)'
      'WHERE IS_ACTIVE = 1;'
      '')
    Left = 7248
    Top = 1096
  end
  object GET_INVENTORIYINFO: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE   PROCEDURE [dbo].[GET_INVENTORIYINFO] '
      #9'@pOPC INT'
      #9',@GENERIC_LNK INT'#9
      'AS'
      ''
      'BEGIN'
      ''
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9'if @pOPC =1 '
      #9'begin'
      
        #9#9'SELECT  SUM(QTYINVENTARIO) INVREG, SUM(INVLTC_QT) INVLTC, SUM(' +
        'INV340B_QT) INV340B '
      #9#9'FROM INVENTARIOPISO '
      #9#9'where GENERIC_LNK = @GENERIC_LNK'
      ''
      #9'end'
      #9'commit;'
      'END'
      ';')
    Left = 7248
    Top = 1184
  end
