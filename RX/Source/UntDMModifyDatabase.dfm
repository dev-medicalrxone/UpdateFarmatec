        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C78750'#39', N'#39'Wax'#39', N'#39'A semi-s' +
        'olid composed of lipids made up of hydrocarbons or esters of fat' +
        'ty acids; active and/or inert ingredient(s) are commonly suspend' +
        'ed within the wax matrix layer.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64910'#39', N'#39'Wound Stick'#39', N'#39 +
        'A relatively long and often cylindrical solid composed of active' +
        ' and/or inert ingredient(s) intended for wound application.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89509'#39', N'#39'C70518'#39', N'#39'Attocurie'#39', N'#39'A ' +
        'unit of radioactivity defined as 3.7E-8 atomic disintegrations o' +
        'r other nuclear transformations per second or one quintillionth ' +
        'of curie (10E-18 curie).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89509'#39', N'#39'C42562'#39', N'#39'Becquerel'#39', N'#39'A ' +
        'SI derived unit of activity of a radionuclide equal to one nucle' +
        'ar disintegration or other nuclear transition from a particular ' +
        'energy state occurring in an amount of a radionuclide during one' +
        ' second-long time interval.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89509'#39', N'#39'C70515'#39', N'#39'Centicurie'#39', N'#39'A' +
        ' unit of radioactivity defined as 3.7 E8 atomic disintegrations ' +
        'or other nuclear transformations per second. One centicurie is e' +
        'qual to 0.37 gigabecquerel.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89509'#39', N'#39'C48466'#39', N'#39'Curie'#39', N'#39'A unit' +
        ' of radioactivity in the CGS system defined as 3.7 E10 atomic di' +
        'sintegrations or other nuclear transformations per second. One c' +
        'urie is equal to 37 gigabecquerels.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89509'#39', N'#39'C25301'#39', N'#39'Day'#39', N'#39'The time' +
        ' for Earth to make a complete rotation on its axis; ordinarily d' +
        'ivided into twenty-four hours equal to 86 400 seconds. This also' +
