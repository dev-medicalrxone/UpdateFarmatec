      'CREATE NONCLUSTERED INDEX [NC_NOCLIENTE] ON [dbo].[PATPLAN]'
      '('
      #9'[NUMEROCLIENTE] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TE' +
        'MPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS =' +
        ' ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY]')
