        'id composed of a mixture of dry finely divided active and/or ine' +
        'rt ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42971'#39', N'#39'Powder Aerosol'#39',' +
        ' N'#39'A powder composed of active and/or inert ingredient(s) and pa' +
        'ckaged under pressure. Ingredients are released upon activation ' +
        'of an appropriate valve system.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42977'#39', N'#39'Powder for Injec' +
        'table Extended Release Suspension'#39', N'#39'A powder intended for inje' +
        'ction following reconstitution to form a suspension that is desi' +
        'gned to release active and/or inert ingredient(s) at a controlle' +
        'd prolonged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42974'#39', N'#39'Powder for Injec' +
        'table Solution'#39', N'#39'A powder intended for injection following rec' +
