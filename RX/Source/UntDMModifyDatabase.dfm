        #9#9#9'--Header-----------------------------------------------------' +
        '--------------------'
      #9#9#9'if @LTC = 0 --FALSE'
      #9#9#9'begin'
      
        #9#9'   '#9#9'Set @send_str = @bin_number + '#39'D0'#39' + @TransactionCode + @' +
