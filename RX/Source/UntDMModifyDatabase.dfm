        #9#9'Select @UnitPrice = isNull(((@RetailPrice / @PackageSize) /  @' +
        'MetricSize) * 1,0);'
      
        #9#9'Select @INV_RBP = isNull(((@PrecioaVenderHP / @PackageSize) / ' +
