        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69007'#39', N'#39'Sustained Releas' +
        'e Buccal Tablet'#39', N'#39'A tablet intended for administration between' +
