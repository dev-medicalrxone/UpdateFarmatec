      '@CLAIM_REFERENCE_ID char(30),'
      '@BILLING_ENTITY_TYPE_INDICATOR CHAR(2), '
      '@PAY_TO_QUALIFIER nchar(2),'
      '@PAY_TO_ID nchar(15),'
      '@PAY_TO_NAME nchar(20), '
      '@PAY_TO_STREET_ADDRESS nchar(30), '
      '@PAY_TO_CITY_ADDRESS nchar(20), '
      '@PAY_TO_STATE nchar(2), '
      '@PAY_TO_ZIP nchar(15),'
      '@GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER nchar(2), '
      '@GENERIC_EQUIVALENT_PRODUCT_ID nchar(19),'
      '@OTCNUMBER INT'
      #9
      'AS'
      'DECLARE @NO_RECORDS INT'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      
        #9'SELECT @NO_RECORDS = COUNT(*) FROM WORKERS_COMPENSATION_SEGMENT' +
        ' WHERE OTC_NUMBER = @OTCNUMBER;'
      #9'IF @NO_RECORDS > 0'
      #9'BEGIN'
      
        #9#9'Update WORKERS_COMPENSATION_SEGMENT set DATE_OF_INJURY = @DATE' +
        '_OF_INJURY, '
      #9#9'EMPLOYER_NAME = @EMPLOYER_NAME,'
      #9#9'EMP_STREET_ADDRESS = @EMP_STREET_ADDRESS,'
      #9#9'EMP_CITY = @EMP_CITY, '
      #9#9'EMP_STATE = @EMP_STATE, '
      #9#9'EMP_ZIP = @EMP_ZIP, '
      #9#9'EMP_PHONE = @EMP_PHONE, '
      #9#9'EMP_CONTACT_NAME = @EMP_CONTACT_NAME, '
      #9#9'CARRIER_ID = @CARRIER_ID, '
      #9#9'CLAIM_REFERENCE_ID = @CLAIM_REFERENCE_ID,'
      
        #9#9'BILLING_ENTITY_TYPE_INDICATOR = @BILLING_ENTITY_TYPE_INDICATOR' +
        ', '
      #9#9'PAY_TO_QUALIFIER = @PAY_TO_QUALIFIER, '
      #9#9'PAY_TO_ID = @PAY_TO_ID, '
      #9#9'PAY_TO_NAME = @PAY_TO_NAME, '
      #9#9'PAY_TO_STREET_ADDRESS = @PAY_TO_STREET_ADDRESS, '
      #9#9'PAY_TO_CITY_ADDRESS = @PAY_TO_CITY_ADDRESS, '
      #9#9'PAY_TO_STATE = @PAY_TO_STATE, '
      #9#9'PAY_TO_ZIP = @PAY_TO_ZIP, '
      
        #9#9'GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER = @GENERIC_EQUIVALENT_' +
        'PRODUCT_ID_QUALIFIER, '
      
        #9#9'GENERIC_EQUIVALENT_PRODUCT_ID = @GENERIC_EQUIVALENT_PRODUCT_ID' +
        ' '
      #9#9'WHERE OTC_NUMBER = @OTCNUMBER;'
      #9'END'
      #9'ELSE'
      #9'BEGIN'
      #9#9'INSERT INTO [dbo].[WORKERS_COMPENSATION_SEGMENT]'
      '           ([DATE_OF_INJURY]'
      '           ,[EMPLOYER_NAME]'
      '           ,[EMP_STREET_ADDRESS]'
      '           ,[EMP_CITY]'
      '           ,[EMP_STATE]'
      '           ,[EMP_ZIP]'
      '           ,[EMP_PHONE]'
      '           ,[EMP_CONTACT_NAME]'
      '           ,[CARRIER_ID]'
      '           ,[CLAIM_REFERENCE_ID]'
      '           ,[BILLING_ENTITY_TYPE_INDICATOR]'
      '           ,[PAY_TO_QUALIFIER]'
      '           ,[PAY_TO_ID]'
      '           ,[PAY_TO_NAME]'
      '           ,[PAY_TO_STREET_ADDRESS]'
      '           ,[PAY_TO_CITY_ADDRESS]'
      '           ,[PAY_TO_STATE]'
      '           ,[PAY_TO_ZIP]'
      '           ,[GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER]'
      '           ,[GENERIC_EQUIVALENT_PRODUCT_ID]'
      '           ,[OTC_NUMBER])'
      '     VALUES'
      '           (@DATE_OF_INJURY'
      '           ,@EMPLOYER_NAME'
      '           ,@EMP_STREET_ADDRESS'
      '           ,@EMP_CITY'
      '           ,@EMP_STATE'
      '           ,@EMP_ZIP'
      '           ,@EMP_PHONE'
      '           ,@EMP_CONTACT_NAME'
      '           ,@CARRIER_ID'
      '           ,@CLAIM_REFERENCE_ID'
      '           ,@BILLING_ENTITY_TYPE_INDICATOR'
      '           ,@PAY_TO_QUALIFIER'
      '           ,@PAY_TO_ID'
      '           ,@PAY_TO_NAME'
      '           ,@PAY_TO_STREET_ADDRESS'
      '           ,@PAY_TO_CITY_ADDRESS'
      '           ,@PAY_TO_STATE'
      '           ,@PAY_TO_ZIP'
      '           ,@GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER'
      '           ,@GENERIC_EQUIVALENT_PRODUCT_ID'
      '           ,@OTCNUMBER)'#9'     '#9'  '
      #9'END;'#9
      #9'commit'
      'end;')
    Left = 3968
    Top = 56
  end
