        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42636'#39', N'#39'Pharmaceutical'#39',' +
        ' N'#39'The form in which active and/or inert ingredient(s) are physi' +
        'cally presented.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
