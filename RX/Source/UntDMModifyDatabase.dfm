    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SURESCRIPTS_RX_RENEW] '
      #9'@RelatedMessageID VARCHAR(50), @Message_ID Varchar(50) output'
      'AS'
      'DECLARE @PATIENT VARCHAR(75)'
      'DECLARE @Prescriber VARCHAR(75)'
      'DECLARE @Medication varchar(81)'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @PATDOB DATE'
      'DECLARE @PrescriberOrderNumber NCHAR(35)'
      'DECLARE @RxReferenceNumber bigint'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'Begin Transaction;'
      #9'Update NEXT_RXNUMBER SET MessageID = MessageID + 1;'
      #9'Select @MESSAGE_ID = (MessageID) FROM NEXT_RXNUMBER;'
      
        #9'SELECT @PATIENT = Patient, @Medication = Medication, @SPI = SPI' +
        ', @PATDOB = PatDOB, @Prescriber = Prescriber,'
      
        #9'@PrescriberOrderNumber = PrescriberOrderNumber, @RxReferenceNum' +
        'ber = RxReferenceNumber FROM Surescripts WHERE MessageID = @Rela' +
        'tedMessageID'
      
        #9'Insert into Surescripts (MessageID, RelatedMessageID, Patient, ' +
        'Prescriber, Medication, DateReceived, Rx_Status, SPI, PatDOB, '
      #9'TransactionType, PrescriberOrderNumber, RxReferenceNumber)'
      
        #9'values (@MESSAGE_ID, @RelatedMessageID,  @PATIENT, @Prescriber,' +
        ' @Medication, getdate(), 1, @SPI, @PATDOB, '#39'RxRenewalRequest'#39', @' +
        'PrescriberOrderNumber, @RxReferenceNumber);'
      #9'Commit;'
      'END')
    Left = 3968
    Top = 376
  end
