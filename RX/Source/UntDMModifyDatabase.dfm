        'to impede the immediate release of the active and/or inert ingre' +
        'dient(s) after administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42903'#39', N'#39'Delayed Release ' +
        'Granule'#39', N'#39'A solid composed of small particles or grains and ha' +
        've been coated with a substance that is designed to impede the i' +
        'mmediate release of the active and/or inert ingredient(s) after ' +
        'administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42997'#39', N'#39'Delayed Release ' +
        'Particle Tablet'#39', N'#39'A tablet composed of individual fragments ha' +
        've been coated with a substance that is designed to impede the i' +
        'mmediate release of the active and/or inert ingredient(s) after ' +
        'administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42904'#39', N'#39'Delayed Release ' +
        'Pellet in Capsule'#39', N'#39'A capsule composed of active and/or inert ' +
        'ingredient(s) small spherical structures that have been coated w' +
        'ith a substance that is designed to impede the immediate release' +
        ' of the active and/or inert ingredient(s) after administration.'#39 +
        ')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42905'#39', N'#39'Delayed Release ' +
        'Tablet'#39', N'#39'A tablet that has been coated with a substance that i' +
        's designed to impede the immediate release of the active and/or ' +
        'inert ingredient(s) after administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69059'#39', N'#39'Dental'#39', N'#39'An su' +
        'bstance intended for use on the teeth or gingiva in the oral cav' +
        'ity.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68954'#39', N'#39'Dental Cone'#39', N'#39 +
        'A solid bounded by a circular base converging upon a single vert' +
        'ex and intended for administration to the teeth and gingiva in t' +
        'he oral cavity.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45413'#39', N'#39'Dental Liner'#39', N' +
        #39'A resinous film-forming agent dissolved in a solvent or a calci' +
        'um hydroxide suspension within a synthetic resin solution which ' +
        'rapidly hardens into a firm mass upon administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42906'#39', N'#39'Dentifrice Gel'#39',' +
        ' N'#39'A gel intended for use in the oral cavity to clean the teeth ' +
        'and maintain oral hygiene.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42907'#39', N'#39'Dentifrice Paste' +
        #39', N'#39'A paste of mild abrasives detergents flavoring agents binde' +
        'rs fluoride and other active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42908'#39', N'#39'Dentifrice Powde' +
        'r'#39', N'#39'A powder composed of a mild abrasives detergents flavoring' +
        ' agents binders fluoride and other active and/or inert ingredien' +
        't(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C43525'#39', N'#39'Disc'#39', N'#39'A flat ' +
        'circular shaped form composed of a solid or powder that contains' +
        ' active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69071'#39', N'#39'Disintegrating T' +
        'ablet'#39', N'#39'A tablet that dissolves or melts quickly (usually with' +
        'in a matter of seconds) when it comes into contact with a liquid' +
        '.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42756'#39', N'#39'Dispensing Table' +
        't'#39', N'#39'A tablet composed of a large amount of active and/or inert' +
        ' ingredient(s) that can be used in compounding prescriptions to ' +
        'ensure accurate quantity of ingredient within the final compound' +
        'ed form.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42741'#39', N'#39'Dissolution Cont' +
        'rolled Extended Release'#39', N'#39'A solid semi-solid solution or suspe' +
        'nsion composed of active and/or inert ingredient(s) covered with' +
        ' or contained within a polymeric matrix such that dissolution is' +
        ' determined by the solubility rate of the given polymer. It is d' +
        'esigned to release ingredients at a controlled prolonged rate so' +
        ' as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42740'#39', N'#39'Diffusion Contro' +
        'lled Extended Release'#39', N'#39'A solid semi-solid solution or suspens' +
        'ion covered with an outer permeable polymeric membrane designed ' +
        'to release active and/or inert ingredient(s) at a controlled pro' +
        'longed rate so as to reduce dosing frequency. Water permeates th' +
        'rough the membrane to the core to dissolve the ingredient(s) whi' +
        'ch subsequently exit the membrane at a rate determined by their ' +
        'solubility and the thickness and porosity of the membrane.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42679'#39', N'#39'Douche'#39', N'#39'A sub' +
        'stance intended for use as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69033'#39', N'#39'Douche Powder'#39', ' +
        'N'#39'A powder which may be mixed with a liquid intended for adminis' +
        'tration as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69032'#39', N'#39'Douche Solution'#39 +
        ', N'#39'A solution intended for use as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42763'#39', N'#39'Dressing'#39', N'#39'A s' +
        'ubstance intended for administration in or on a wound.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C29012'#39', N'#39'Drop'#39', N'#39'A subst' +
        'ance intended for administration in a drop-wise fashion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60992'#39', N'#39'Drop Solution'#39', ' +
        'N'#39'A solution intended for administration in a drop-wise fashion.' +
        #39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60995'#39', N'#39'Drop Suspension'#39 +
        ', N'#39'A suspension intended for administration in a drop-wise fash' +
        'ion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68997'#39', N'#39'Drop Suspension ' +
        'Final'#39', N'#39'A suspension prepared immediately prior to dispensing ' +
        'or administration in a drop-wise fashion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64883'#39', N'#39'Dusting Powder'#39',' +
        ' N'#39'A powder intended to be dusted over the outer surface of the ' +
        'body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42909'#39', N'#39'Effervescent Gra' +
        'nule'#39', N'#39'A granule composed of active and/or inert ingredient(s)' +
        ' and a mixture of acids and sodium bicarbonate which release car' +
        'bon dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64884'#39', N'#39'Effervescent Pow' +
        'der'#39', N'#39'A powder composed of active and/or inert ingredient(s) a' +
        'nd a mixture of acids and sodium bicarbonate which release carbo' +
        'n dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42910'#39', N'#39'Effervescent Tab' +
        'let'#39', N'#39'A tablet composed of active and/or inert ingredient(s) a' +
        'nd a mixture of acids and sodium bicarbonate which release carbo' +
        'n dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42911'#39', N'#39'Electrically Con' +
        'trolled Extended Release Patch'#39', N'#39'A patch that composed of acti' +
        've and/or inert ingredient(s) whose release is controlled by ele' +
        'ctronic impulses that release ingredients at a controlled prolon' +
        'ged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42912'#39', N'#39'Elixir'#39', N'#39'A sol' +
        'ution composed of a clear sweetened hydroalcoholic liquid in whi' +
        'ch active and/or inert ingredient(s) are dissolved.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42913'#39', N'#39'Emulsion'#39', N'#39'A s' +
        'emi-solid composed of at least two immiscible liquids one of whi' +
        'ch is dispersed as droplets within the other liquid and stabiliz' +
        'ed with one or more emulsifying agents.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42914'#39', N'#39'Emulsion for Inj' +
        'ection'#39', N'#39'An emulsion intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42915'#39', N'#39'Enema'#39', N'#39'A solu' +
        'tion or suspension intended for administration into the rectum.'#39 +
        ')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64885'#39', N'#39'Enema Powder'#39', N' +
        #39'A powder that is suspended in liquid prior to administration to' +
