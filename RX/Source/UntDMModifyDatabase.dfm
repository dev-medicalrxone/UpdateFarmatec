  object Surescripts: TFDQuery
    AfterExecute = SurescriptsAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'Surescri' +
        'pts'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[Surescripts]('
      #9'[MessageID] [varchar](50) NOT NULL,'
