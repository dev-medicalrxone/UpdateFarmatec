        'olid in the shape of a bar composed of active and/or inert ingre' +
        'dient(s) in an anionic surfactant for cleansing.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42890'#39', N'#39'Bead'#39', N'#39'A solid' +
        ' in the shape of a small sphere.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64875'#39', N'#39'Biting Capsule'#39',' +
        ' N'#39'A capsule designed to be bitten to release the active and/or ' +
        'inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42891'#39', N'#39'Block'#39', N'#39'A soli' +
        'd or semi-solid in the shape of a square or rectangle.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64874'#39', N'#39'Buccal Capsule'#39',' +
        ' N'#39'A capsule intended for administration between the cheek and g' +
        'um of the oral cavity. The active and/or inert ingredient(s) are' +
        ' usually absorbed through the oral mucosa.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91138'#39', N'#39'Buccal Film'#39', N'#39 +
        'A thin layer of water soluble or insoluble polymer intended to c' +
        'oat the inner surface of the cheek.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42755'#39', N'#39'Buccal Tablet'#39', ' +
        'N'#39'A tablet intended for administration between the cheek and gum' +
        ' of the oral cavity. The active and/or inert ingredient(s) are u' +
        'sually absorbed through the oral mucosa.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64878'#39', N'#39'Cachet'#39', N'#39'A sol' +
        'id composed of dry powdered active and/or inert ingredient(s) co' +
        'vered by an edible shell. The shell consists of two concave piec' +
        'es of wafer made of flour and water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68951'#39', N'#39'Cake'#39', N'#39'A solid' +
        ' composed of active ingredient(s) excipients (usually electrolyt' +
        'es and bulking agents) and a solvent system which are lyophilize' +
        'd to yield a compressed solid with uniform ingredient distributi' +
        'on. The resulting lyophilized cake maintains its structure and s' +
        'tability over an extended period of time and is intended for rec' +
        'onstitution prior to administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64880'#39', N'#39'Candy'#39', N'#39'A soli' +
        'd or semi-solid with a sweet taste and intended for oral adminis' +
        'tration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C25158'#39', N'#39'Capsule'#39', N'#39'A so' +
        'lid contained within either a hard or soft soluble shell usually' +
        ' prepared from gelatin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68943'#39', N'#39'Capsule 12 Hour ' +
        'Sustained Release'#39', N'#39'A capsule designed to release active and/o' +
        'r inert ingredient(s) slowly so as to achieve a constant circula' +
        'ting concentration of the ingredient over a 12 hour time interva' +
        'l.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68944'#39', N'#39'Capsule 24 Hour ' +
        'Sustained Release'#39', N'#39'A capsule designed to release active and/o' +
        'r inert ingredient(s) slowly so as to achieve a constant circula' +
        'ting concentration of the ingredient over a 24 hour time interva' +
        'l.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45414'#39', N'#39'Cement'#39', N'#39'A bas' +
        'e composed of bonding agents intermingled with active and/or ine' +
        'rt ingredient(s) which rapidly hardens into a firm mass upon app' +
        'lication.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42892'#39', N'#39'Chewable Bar'#39', N' +
        #39'A bar designed to be chewed to release active and/or inert ingr' +
        'edient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64876'#39', N'#39'Chewable Capsule' +
        #39', N'#39'A capsule designed to be chewed to release the active and/o' +
        'r inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42893'#39', N'#39'Chewable Tablet'#39 +
        ', N'#39'A tablet that must be chewed to release the active and/or in' +
        'ert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42894'#39', N'#39'Chewing Gum'#39', N'#39 +
        'A semi-solid composed of synthetic polymerized polysaccharide an' +
        'd flavorings intended to be chewed to release active and/or iner' +
        't ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42678'#39', N'#39'Cigarette'#39', N'#39'A ' +
        'solid composed of active and/or inert ingredient(s) wrapped in a' +
        ' paper cylinder whereby one end is burned. The ingredient is rel' +
        'eased in a smoke form which is inhaled.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60884'#39', N'#39'Cloth'#39', N'#39'A soli' +
        'd composed active and/or inert ingredient(s) in a woven absorben' +
        't material.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42895'#39', N'#39'Coated Capsule'#39',' +
        ' N'#39'A capsule that contains an additional outer layer over the ca' +
        'psule shell.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42896'#39', N'#39'Coated Pellet in' +
        ' Capsule'#39', N'#39'A capsule composed of small globular masses covered' +
        ' with an outer shell.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42897'#39', N'#39'Coated Tablet'#39', ' +
        'N'#39'A tablet whose outer shell is covered with a substance.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69002'#39', N'#39'Compressed Sugar' +
        ' Coated Caplet'#39', N'#39'A tablet that has been compacted into capsule' +
        ' shape and covered in sugar.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60891'#39', N'#39'Concentrated'#39', N' +
        #39'A solution or suspension composed of active and/or inert ingred' +
        'ient(s) with increased strength in a reduced volume which is usu' +
        'ally diluted prior to administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42899'#39', N'#39'Concentrated Inj' +
        'ectable Solution'#39', N'#39'A concentrate which is usually diluted prio' +
        'r to administration by injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69001'#39', N'#39'Concentrated Ora' +
        'l'#39', N'#39'A concentrate that usually requires dilution prior to oral' +
        ' administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42898'#39', N'#39'Concentrated Sol' +
        'ution'#39', N'#39'A concentrate which is usually diluted prior to admini' +
        'stration and exists as a solution in its final form.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42900'#39', N'#39'Cone'#39', N'#39'A solid' +
        ' with a shape bounded by a circular base converging upon a singl' +
        'e vertex.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42731'#39', N'#39'Controlled Relea' +
        'se'#39', N'#39'A solid semi-solid solution or suspension designed to rel' +
        'ease active and/or inert ingredient(s) at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69024'#39', N'#39'Controlled Relea' +
        'se Capsule'#39', N'#39'A capsule designed to release active and/or inert' +
        ' ingredient(s) at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69026'#39', N'#39'Controlled Relea' +
        'se Liquid'#39', N'#39'A solution or suspension designed to release activ' +
        'e and/or inert ingredient(s) at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69025'#39', N'#39'Controlled Relea' +
        'se Tablet'#39', N'#39'A tablet designed to release active and/or inert i' +
        'ngredient(s) at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C28944'#39', N'#39'Cream'#39', N'#39'A semi' +
        '-solid composed of an emulsion of lipids hydrocarbons waxes or p' +
        'olyols in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42901'#39', N'#39'Crystal'#39', N'#39'A so' +
        'lid that consists of naturally produced angular solids composed ' +
        'of singular repeating units that are systematically arranged in ' +
        'an evenly spaced lattice.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64881'#39', N'#39'Cube'#39', N'#39'A solid' +
        ' or semi-solid in the shape of a three dimensional square.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45415'#39', N'#39'Culture'#39', N'#39'A so' +
        'lution suspension or semi-solid composed of media conducive to m' +
        'icrobial growth.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68949'#39', N'#39'Degradable Contr' +
        'olled Release Capsule'#39', N'#39'A capsule designed to dissolve after r' +
        'eleasing the active and/or inert ingredient(s) at a controlled r' +
        'ate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42730'#39', N'#39'Delayed Release'#39 +
        ', N'#39'A solid semi-solid solution or suspension that has been coat' +
        'ed with a substance that is designed to impede the immediate rel' +
        'ease of the active and/or inert ingredient(s) after administrati' +
        'on.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42902'#39', N'#39'Delayed Release ' +
        'Capsule'#39', N'#39'A capsule covered with a substance that is designed ' +
        'to impede the immediate release of the active and/or inert ingre' +
        'dient(s) after administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42903'#39', N'#39'Delayed Release ' +
        'Granule'#39', N'#39'A solid composed of small particles or grains and ha' +
        've been coated with a substance that is designed to impede the i' +
        'mmediate release of the active and/or inert ingredient(s) after ' +
        'administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42997'#39', N'#39'Delayed Release ' +
        'Particle Tablet'#39', N'#39'A tablet composed of individual fragments ha' +
        've been coated with a substance that is designed to impede the i' +
        'mmediate release of the active and/or inert ingredient(s) after ' +
        'administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42904'#39', N'#39'Delayed Release ' +
        'Pellet in Capsule'#39', N'#39'A capsule composed of active and/or inert ' +
        'ingredient(s) small spherical structures that have been coated w' +
        'ith a substance that is designed to impede the immediate release' +
        ' of the active and/or inert ingredient(s) after administration.'#39 +
        ')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42905'#39', N'#39'Delayed Release ' +
        'Tablet'#39', N'#39'A tablet that has been coated with a substance that i' +
        's designed to impede the immediate release of the active and/or ' +
        'inert ingredient(s) after administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69059'#39', N'#39'Dental'#39', N'#39'An su' +
        'bstance intended for use on the teeth or gingiva in the oral cav' +
        'ity.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68954'#39', N'#39'Dental Cone'#39', N'#39 +
        'A solid bounded by a circular base converging upon a single vert' +
        'ex and intended for administration to the teeth and gingiva in t' +
        'he oral cavity.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45413'#39', N'#39'Dental Liner'#39', N' +
        #39'A resinous film-forming agent dissolved in a solvent or a calci' +
        'um hydroxide suspension within a synthetic resin solution which ' +
        'rapidly hardens into a firm mass upon administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42906'#39', N'#39'Dentifrice Gel'#39',' +
        ' N'#39'A gel intended for use in the oral cavity to clean the teeth ' +
        'and maintain oral hygiene.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42907'#39', N'#39'Dentifrice Paste' +
        #39', N'#39'A paste of mild abrasives detergents flavoring agents binde' +
        'rs fluoride and other active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42908'#39', N'#39'Dentifrice Powde' +
        'r'#39', N'#39'A powder composed of a mild abrasives detergents flavoring' +
        ' agents binders fluoride and other active and/or inert ingredien' +
        't(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C43525'#39', N'#39'Disc'#39', N'#39'A flat ' +
        'circular shaped form composed of a solid or powder that contains' +
        ' active and/or inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69071'#39', N'#39'Disintegrating T' +
        'ablet'#39', N'#39'A tablet that dissolves or melts quickly (usually with' +
        'in a matter of seconds) when it comes into contact with a liquid' +
        '.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42756'#39', N'#39'Dispensing Table' +
        't'#39', N'#39'A tablet composed of a large amount of active and/or inert' +
        ' ingredient(s) that can be used in compounding prescriptions to ' +
        'ensure accurate quantity of ingredient within the final compound' +
        'ed form.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42741'#39', N'#39'Dissolution Cont' +
        'rolled Extended Release'#39', N'#39'A solid semi-solid solution or suspe' +
        'nsion composed of active and/or inert ingredient(s) covered with' +
        ' or contained within a polymeric matrix such that dissolution is' +
        ' determined by the solubility rate of the given polymer. It is d' +
        'esigned to release ingredients at a controlled prolonged rate so' +
        ' as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42740'#39', N'#39'Diffusion Contro' +
        'lled Extended Release'#39', N'#39'A solid semi-solid solution or suspens' +
        'ion covered with an outer permeable polymeric membrane designed ' +
        'to release active and/or inert ingredient(s) at a controlled pro' +
        'longed rate so as to reduce dosing frequency. Water permeates th' +
        'rough the membrane to the core to dissolve the ingredient(s) whi' +
        'ch subsequently exit the membrane at a rate determined by their ' +
        'solubility and the thickness and porosity of the membrane.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42679'#39', N'#39'Douche'#39', N'#39'A sub' +
        'stance intended for use as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69033'#39', N'#39'Douche Powder'#39', ' +
        'N'#39'A powder which may be mixed with a liquid intended for adminis' +
        'tration as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69032'#39', N'#39'Douche Solution'#39 +
        ', N'#39'A solution intended for use as a vaginal irrigant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42763'#39', N'#39'Dressing'#39', N'#39'A s' +
        'ubstance intended for administration in or on a wound.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C29012'#39', N'#39'Drop'#39', N'#39'A subst' +
        'ance intended for administration in a drop-wise fashion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60992'#39', N'#39'Drop Solution'#39', ' +
        'N'#39'A solution intended for administration in a drop-wise fashion.' +
        #39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60995'#39', N'#39'Drop Suspension'#39 +
        ', N'#39'A suspension intended for administration in a drop-wise fash' +
        'ion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68997'#39', N'#39'Drop Suspension ' +
        'Final'#39', N'#39'A suspension prepared immediately prior to dispensing ' +
        'or administration in a drop-wise fashion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64883'#39', N'#39'Dusting Powder'#39',' +
        ' N'#39'A powder intended to be dusted over the outer surface of the ' +
        'body.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42909'#39', N'#39'Effervescent Gra' +
        'nule'#39', N'#39'A granule composed of active and/or inert ingredient(s)' +
        ' and a mixture of acids and sodium bicarbonate which release car' +
        'bon dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64884'#39', N'#39'Effervescent Pow' +
        'der'#39', N'#39'A powder composed of active and/or inert ingredient(s) a' +
        'nd a mixture of acids and sodium bicarbonate which release carbo' +
        'n dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42910'#39', N'#39'Effervescent Tab' +
        'let'#39', N'#39'A tablet composed of active and/or inert ingredient(s) a' +
        'nd a mixture of acids and sodium bicarbonate which release carbo' +
        'n dioxide when dissolved in water.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42911'#39', N'#39'Electrically Con' +
        'trolled Extended Release Patch'#39', N'#39'A patch that composed of acti' +
        've and/or inert ingredient(s) whose release is controlled by ele' +
        'ctronic impulses that release ingredients at a controlled prolon' +
        'ged rate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42912'#39', N'#39'Elixir'#39', N'#39'A sol' +
        'ution composed of a clear sweetened hydroalcoholic liquid in whi' +
        'ch active and/or inert ingredient(s) are dissolved.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42913'#39', N'#39'Emulsion'#39', N'#39'A s' +
        'emi-solid composed of at least two immiscible liquids one of whi' +
        'ch is dispersed as droplets within the other liquid and stabiliz' +
        'ed with one or more emulsifying agents.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42914'#39', N'#39'Emulsion for Inj' +
        'ection'#39', N'#39'An emulsion intended for injection.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42915'#39', N'#39'Enema'#39', N'#39'A solu' +
        'tion or suspension intended for administration into the rectum.'#39 +
        ')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64885'#39', N'#39'Enema Powder'#39', N' +
        #39'A powder that is suspended in liquid prior to administration to' +
        ' the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64871'#39', N'#39'Enema Tablet'#39', N' +
        #39'A tablet that is suspended in liquid prior to administration to' +
        ' the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68945'#39', N'#39'Enteric Coated C' +
        'apsule'#39', N'#39'A capsule covered with a substance that is designed t' +
        'o delay the release of active and/or inert ingredient(s) until t' +
        'he capsule passes into the intestines.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42758'#39', N'#39'Enteric Coated T' +
        'ablet'#39', N'#39'A tablet covered with a substance that is designed to ' +
        'delay the release of active and/or inert ingredient(s) until the' +
        ' tablet passes into the intestines.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42742'#39', N'#39'Erosion Controll' +
        'ed Extended Release'#39', N'#39'A solid semi-solid solution or suspensio' +
        'n in which active and/or inert ingredient(s) release is controll' +
        'ed by the erosion rate of a carrier matrix which is designed to ' +
        'release ingredients at a controlled prolonged rate so as to redu' +
        'ce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42713'#39', N'#39'Extended Release' +
        #39', N'#39'A solid semi-solid solution or suspension designed to relea' +
        'se active and/or inert ingredient(s) at a controlled prolonged r' +
        'ate so as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C43451'#39', N'#39'Extended Release' +
        ' Bead Implant'#39', N'#39'A solid in the shape of a small sphere intende' +
        'd to be embedded securely in the body and designed to release ac' +
        'tive and/or inert ingredient(s) at a controlled prolonged rate s' +
        'o as to reduce dosing frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42916'#39', N'#39'Extended Release' +
        ' Capsule'#39', N'#39'A capsule designed to release active and/or inert i' +
        'ngredient(s) at a controlled prolonged rate so as to reduce dosi' +
        'ng frequency.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42917'#39', N'#39'Extended Release' +
