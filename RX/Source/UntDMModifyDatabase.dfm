        #9#9#9'-- Cupon Segment --------------------------------------------' +
        '------------------------------'
      #9#9#9'if (rtrim(@cupon_type) > '#39#39') '
      #9#9#9'begin'
      #9#9#9#9'set @send_str += @Segment_Separator + @FS + '#39'AM'#39' + '#39'09'#39';'
      
        #9#9#9#9'if @cupon_type > '#39#39' set @send_str += @FS + '#39'KE'#39' + rtrim(uppe' +
        'r(@cupon_type)); -- 485-KE'
      
        #9#9#9#9'if @cupon_number > '#39#39' set @send_str += @FS + '#39'ME'#39' + rtrim(up' +
        'per(@cupon_number)); -- 486-ME  '
      #9#9#9#9'if @cupon_amt > 0 '
      #9#9#9#9'begin  '
      
        #9#9#9#9#9'exec dbo.D0_GetFloatCharacter @cupon_amt, @outputToken = @t' +
        'emp_value output;'
      #9#9#9#9#9'set @send_str += @FS + '#39'NE'#39' + rtrim(@temp_value); -- 487-NE'
      #9#9#9#9'end;'
      #9#9#9'end;'
      
        #9#9#9'--Compound Segemnt-------------------------------------------' +
        '-------------------------------'
      
        #9#9#9'exec dbo.D0_Compound_segment @otc_number, @compound_str = @co' +
        'mpoundstr output;'
      #9#9#9'set @send_str += @compoundstr;'#9#9
      
        #9#9#9'--Clinical Segment-------------------------------------------' +
        '-------------------------------'
      
        #9#9#9'exec dbo.D0_Clinical_Segment @otc_number, @clinical_str = @cl' +
        'inicalstr output;'
      #9#9#9'set @send_str += @clinicalstr;'#9#9
      #9#9'end;'
      
        #9#9'--Payload ----------------------------------------------------' +
        '------------------------------'#9#9
      #9#9'if (rtrim(@schedule_drug) = '#39'RX'#39') or '
      #9#9'   (rtrim(@schedule_drug) = '#39'OTC'#39') or'
      #9#9'   (rtrim(@schedule_drug) = '#39'DME'#39')'
      #9#9'  set @rx_expiration_date = dateadd(day, 365, @DateRXWritten)'
      #9#9'else'
      
        #9#9'  set @rx_expiration_date = dateadd(day, 180, @DateRXWritten);' +
        ' '
      #9#9'set @rxpayload += '#39'<ExtraPayloadData>'#39';'
      
        #9#9'set @rxpayload += '#39'<RxNumber>'#39' + rtrim(cast(@norx as varchar(1' +
        '0))) + '#39'</RxNumber>'#39';'
      
        #9#9'set @rxpayload += '#39'<FillNumber>'#39' + rtrim(cast(isnull(@new_ref_' +
        'code,0) as varchar(10))) + '#39'</FillNumber>'#39';'
      
        #9#9'set @rxpayload += '#39'<AWP>'#39' + rtrim(cast(isnull(@gross_amount_du' +
        'e,0) as varchar(10))) + '#39'</AWP>'#39';'
      #9#9'set @rxpayload += '#39'<NHFlag>'#39'+'#39'</NHFlag>'#39';'#9#9
      #9#9'set @rxpayload += '#39'<Language>'#39' +'#39'ENG'#39'+ '#39'</Language>'#39';'
      #9#9'set @rxpayload += '#39'<GenericFlag>'#39' +'#39'Y'#39'+ '#39'</GenericFlag>'#39';'
      
        #9#9'set @rxpayload += '#39'<AAC>'#39' + rtrim(cast(isnull(@ing_cost,0) as ' +
        'varchar(10))) + '#39'</AAC>'#39';'
      
        #9#9'set @rxpayload += '#39'<PatientId>'#39' + rtrim(cast(@pat_id as varcha' +
        'r(10))) + '#39'</PatientId>'#39';'
      
        #9#9'set @rxpayload += '#39'<DrugSig>'#39' + rtrim(@drug_sig) + '#39'</DrugSig>' +
        #39';'
      
        #9#9'set @rxpayload += '#39'<DrugName>'#39' + rtrim(@drug_name) + '#39'</DrugNa' +
        'me>'#39';'
      
        #9#9'set @rxpayload += '#39'<PrescDEA>'#39' + rtrim(isnull(@presc_dea,'#39#39')) ' +
        '+ '#39'</PrescDEA>'#39';'
      
        #9#9'set @rxpayload += '#39'<PrescNPI>'#39' + rtrim(isnull(@presc_npi,'#39#39')) ' +
        '+ '#39'</PrescNPI>'#39';'
      
        #9#9'set @rxpayload += '#39'<PlanName>'#39' + rtrim(isnull(@insurance_name,' +
        #39#39')) + '#39'</PlanName>'#39';'
      
        #9#9'set @rxpayload += '#39'<PlanCode>'#39' + rtrim(isnull(@insurance_code,' +
        #39#39')) + '#39'</PlanCode>'#39';'
      #9#9'set @rxpayload += '#39'<NHPhone></NHPhone>'#39';'
      #9#9'set @rxpayload += '#39'<InvName></InvName>'#39';'
      #9#9'set @rxpayload += '#39'<InvName></InvName>'#39';'
      
        #9#9'set @rxpayload += '#39'<DrugSched>'#39' + rtrim(isnull(@schedule_drug,' +
        #39#39')) + '#39'</DrugSched>'#39';'
      
        #9#9'set @rxpayload += '#39'<RefillsRemain>'#39' + rtrim(cast(isNull(@ref_r' +
        'emaining,0) as varchar(10))) + '#39'</RefillsRemain>'#39';'
      
        #9#9'set @rxpayload += '#39'<ExpirationDate>'#39' + FORMAT (@rx_expiration_' +
        'date, '#39'MM/dd/yyyy'#39')  + '#39'</ExpirationDate>'#39';  '
      
        #9#9'set @rxpayload += '#39'<NHWing></NHWing><NHRoom></NHRoom><NHBed></' +
        'NHBed><RxOtc>R</RxOtc></ExtraPayloadData>'#39';'#9#9#9
      #9#9'set @Count += @Count+1;'
      #9#9'if (@Count = 5) or (@TransactionCount = @count) break;'
      #9#9
      #9#9'  '
      #9#9'FETCH NEXT FROM MyCursorD0'
      
        #9#9'INTO @datefilled, @norx, @primarycareprov_idqual, @ndc, @prod_' +
