    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_CLAIM_SEGMENT] @NORX BIGINT, @OTC' +
        'NUMBER INT, @RXNUMBERSRNQ NCHAR(1),'
      
        '@PRODUCTSERVIDQUAL NCHAR(2), @NDC NCHAR(11), @DAW SMALLINT, @OTH' +
