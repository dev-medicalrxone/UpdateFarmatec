      #9'[PRIORAUTHORIZATION] [varchar](12) NULL,'
      #9'[RXORIGINCODE] [varchar](1) NULL,'
      #9'[PRIMARYPRESCRIBER] [varchar](10) NULL,'
      #9'[BASISOFCOST] [varchar](2) NULL,'
      #9'[DURCONFLICTCODE] [varchar](2) NULL,'
      #9'[DUROUTCOMECODE] [varchar](2) NULL,'
