        #9#9#9'set @gross_amount_due = isNull(@disp_fee,0) + isNull(@ing_cos' +
        't,0) + isNull(@incentive_amount_sub,0) + isNull(@other_amount_cl' +
        'aim_sub,0) + isNull(@prof_serv_fee,0);'
      #9#9#9'if @gross_amount_due >= 0 '
      #9#9#9'begin  '
      #9#9#9'  set @temp_value = 0;'
      
        #9#9#9'  exec dbo.D0_GetFloatCharacter @gross_amount_due, @outputTok' +
        'en = @temp_value output;'
      #9#9#9'  set @send_str += @FS + '#39'DU'#39' + rtrim(@temp_value); -- 43'#216'-DU'
      #9#9#9'end;'
      
        #9#9#9'if @basis_of_cost > '#39#39' set @send_str += @FS + '#39'DN'#39' + rtrim(up' +
        'per(@basis_of_cost)); -- 423-DN'#9#9
      #9#9#9'if @medicaid_paid_amount > 0 '
      #9#9#9'begin  '
      #9#9#9'  set @temp_value = 0;'
      
        #9#9#9'  exec dbo.D0_GetFloatCharacter @medicaid_paid_amount, @outpu' +
        'tToken = @temp_value output;'
      #9#9#9'  set @send_str += @FS + '#39'N3'#39' + rtrim(@temp_value); -- 113-N3'
      #9#9#9'end;'
      #9#9'end;'
      #9#9'/*'
      #9#9'if @TransactionCode = '#39'B2'#39
      #9#9'begin'
      #9#9#9'set @send_str +=  @segment_separator + @FS + '#39'AM11'#39';'
      #9#9#9'if @incentive_amount_sub > 0 '
      #9#9#9'begin '
      #9#9#9#9'set @temp_value = 0;'
      
        #9#9#9#9'exec dbo.D0_GetFloatCharacter @incentive_amount_sub, @output' +
        'Token = @temp_value output;'
      #9#9#9#9'set @send_str += @FS + '#39'E3'#39' + rtrim(@temp_value); -- 438-E3'
      #9#9#9'end;'
      #9#9#9'if @gross_amount_due >= 0 '
      #9#9#9'begin  '
      #9#9#9'  set @temp_value = 0;'
      
        #9#9#9'  exec dbo.D0_GetFloatCharacter @gross_amount_due, @outputTok' +
        'en = @temp_value output;'
      #9#9#9'  set @send_str += @FS + '#39'DU'#39' + rtrim(@temp_value); -- 43'#216'-DU'
      #9#9#9'end;'
      #9#9'end;'
      #9#9'*/'
      
        #9#9'--------------------------------------------------------------' +
        '------------------------------'
      
        #9#9'select @presc_id = licencia, @prescriber_no = numerodoctor fro' +
        'm PRESCRIPTIONS where NUMERORECETA = @norx;'
      
        #9#9'select @presc_id_qualifier = PRESCRIBER_ID_QUALIFIER, @presc_t' +
        'elephone = concat(substring(telefono, 2, 3), substring(telefono,' +
        ' 6, 3), substring(telefono, 10, 4)),'
      
        #9#9'@presc_ln = APELLIDO_PATERNO, @presc_address = DIRECCION, @pre' +
        'sc_city = CITY, @presc_state = ESTADO, @presc_zipcode = SUBSTRIN' +
        'G(CODIGO_POSTAL,1,5),'
      
        #9#9'@presc_name = NOMBRE, @presc_dea = DEA_FEDERAL, @presc_npi = N' +
        'PI'
      #9#9'from DOCTOR where NUMERODOCTOR = @prescriber_no;'
      #9#9'if @claim_reversal = 0'
      #9#9'begin'
      
        #9#9#9'--Pharmacy Provider Segment 02 ------------------------------' +
        '--------------------------'#9#9
      #9#9#9'set @send_str +=  @segment_separator + @FS + '#39'AM02'#39';'
      #9#9#9'set @send_str += @FS + '#39'EY'#39' + @ServiceProvIDQual;'
      #9#9#9'set @send_str += @FS + '#39'E9'#39' + rtrim(upper(@ServiceProvID));'
      
        #9#9#9'-- Prescriber Segment 03 ------------------------------------' +
        '--------------------------'#9#9
      #9#9#9'set @send_str +=  @segment_separator + @FS + '#39'AM03'#39';'
      
        #9#9#9'if @presc_id_qualifier > '#39#39' set @send_str += @FS + '#39'EZ'#39' + rtr' +
        'im(upper(@presc_id_qualifier)); -- 466-EZ'
      
        #9#9#9'if @presc_id > '#39#39' set @send_str += @FS + '#39'DB'#39' + rtrim(upper(@' +
        'presc_id)); -- 411-DB'
      
        #9#9#9'if @presc_ln > '#39#39' set @send_str += @FS + '#39'DR'#39' + rtrim(upper(@' +
        'presc_ln)); -- 427-DR'
      
        #9#9#9'if @presc_telephone > '#39#39' set @send_str += @FS + '#39'PM'#39' + @presc' +
        '_telephone; -- 498-PM'
      
        #9#9#9'if @primarycareprov_idqual > '#39#39' set @send_str += @FS + '#39'2E'#39' +' +
        ' @primarycareprov_idqual; -- 468-2E'
      
        #9#9#9'if @primarycareprov_id > '#39#39' set @send_str += @FS + '#39'DL'#39' + @pr' +
        'imarycareprov_id; -- 421-DL'
      
        #9#9#9'if @primarycareprov_ln > '#39#39' set @send_str += @FS + '#39'4E'#39' + rtr' +
        'im(upper(@primarycareprov_ln)); -- 47'#216'-4E'
      
        #9#9#9'if @presc_name > '#39#39' set @send_str += @FS + '#39'2J'#39' + rtrim(upper' +
        '(@presc_name)); -- 364-2J'
      
        #9#9#9'if @presc_address > '#39#39' set @send_str += @FS + '#39'2K'#39' + rtrim(up' +
        'per(@presc_address)); -- 365-2K '
      
        #9#9#9'if @presc_city > '#39#39' set @send_str += @FS + '#39'2M'#39' + rtrim(upper' +
        '(@presc_city)); -- 366-2M'
      
        #9#9#9'if @presc_state > '#39#39' set @send_str += @FS + '#39'2N'#39' + rtrim(uppe' +
        'r(@presc_state)); -- 367-2N'
      
        #9#9#9'if @presc_zipcode > '#39#39' set @send_str += @FS + '#39'2P'#39' + rtrim(up' +
        'per(@presc_zipcode)); -- 368-2P'
      
        #9#9#9'-------------------------------------------------------------' +
        '-----------------------------------------'
      #9#9'end;'#9#9
      
        #9#9'-- cob Segment -----------------------------------------------' +
        '------------------------------'
      
        #9#9'exec dbo.D0_COB_segment @otc_number, @TransactionCode, @COB_st' +
        'ring = @COBstring output;'
      #9#9'set @send_str += @COBstring;'
      #9
      #9#9'if @TransactionCode = '#39'B1'#39
      #9#9'begin'
      
        #9#9#9'-- Workers Compensation -------------------------------------' +
        '------------------------------'
      
        #9#9#9'exec dbo.D0_Workers_compensation @otc_number, @workers_comp_s' +
        'tr = @workers_compstr output;'
      #9#9#9'set @send_str += @workers_compstr;'
      
        #9#9#9'-- DUR PPS Segment-------------------------------------------' +
        '------------------------------'
      
        #9#9#9'exec dbo.D0_DUR_Segment @otc_number, @TransactionCode, @dur_s' +
        'tr = @dur_pps_segment_str output;'
      #9#9#9'set @send_str += @dur_pps_segment_str;'
      
        #9#9#9'-- Cupon Segment --------------------------------------------' +
        '------------------------------'
      #9#9#9'if (rtrim(@cupon_type) > '#39#39') '
      #9#9#9'begin'
      #9#9#9#9'set @send_str += @Segment_Separator + @FS + '#39'AM'#39' + '#39'09'#39';'
      
        #9#9#9#9'if @cupon_type > '#39#39' set @send_str += @FS + '#39'KE'#39' + rtrim(uppe' +
        'r(@cupon_type)); -- 485-KE'
      
        #9#9#9#9'if @cupon_number > '#39#39' set @send_str += @FS + '#39'ME'#39' + rtrim(up' +
        'per(@cupon_number)); -- 486-ME  '
      #9#9#9#9'if @cupon_amt > 0 '
      #9#9#9#9'begin  '
      
        #9#9#9#9#9'exec dbo.D0_GetFloatCharacter @cupon_amt, @outputToken = @t' +
        'emp_value output;'
      #9#9#9#9#9'set @send_str += @FS + '#39'NE'#39' + rtrim(@temp_value); -- 487-NE'
      #9#9#9#9'end;'
      #9#9#9'end;'
      
        #9#9#9'--Compound Segemnt-------------------------------------------' +
        '-------------------------------'
      
        #9#9#9'exec dbo.D0_Compound_segment @otc_number, @compound_str = @co' +
        'mpoundstr output;'
      #9#9#9'set @send_str += @compoundstr;'#9#9
      
        #9#9#9'--Clinical Segment-------------------------------------------' +
        '-------------------------------'
      
        #9#9#9'exec dbo.D0_Clinical_Segment @otc_number, @clinical_str = @cl' +
        'inicalstr output;'
      #9#9#9'set @send_str += @clinicalstr;'#9#9
      #9#9'end;'
      
        #9#9'--Payload ----------------------------------------------------' +
        '------------------------------'#9#9
      #9#9'if (rtrim(@schedule_drug) = '#39'RX'#39') or '
      #9#9'   (rtrim(@schedule_drug) = '#39'OTC'#39') or'
      #9#9'   (rtrim(@schedule_drug) = '#39'DME'#39')'
      #9#9'  set @rx_expiration_date = dateadd(day, 365, @DateRXWritten)'
      #9#9'else'
      
        #9#9'  set @rx_expiration_date = dateadd(day, 180, @DateRXWritten);' +
        ' '
      #9#9'set @rxpayload += '#39'<ExtraPayloadData>'#39';'
      
        #9#9'set @rxpayload += '#39'<RxNumber>'#39' + rtrim(cast(@norx as varchar(1' +
        '0))) + '#39'</RxNumber>'#39';'
      
        #9#9'set @rxpayload += '#39'<FillNumber>'#39' + rtrim(cast(isnull(@new_ref_' +
        'code,0) as varchar(10))) + '#39'</FillNumber>'#39';'
      
        #9#9'set @rxpayload += '#39'<AWP>'#39' + rtrim(cast(isnull(@gross_amount_du' +
        'e,0) as varchar(10))) + '#39'</AWP>'#39';'
      #9#9'set @rxpayload += '#39'<NHFlag>'#39'+'#39'</NHFlag>'#39';'#9#9
      #9#9'set @rxpayload += '#39'<Language>'#39' +'#39'ENG'#39'+ '#39'</Language>'#39';'
      #9#9'set @rxpayload += '#39'<GenericFlag>'#39' +'#39'Y'#39'+ '#39'</GenericFlag>'#39';'
      
        #9#9'set @rxpayload += '#39'<AAC>'#39' + rtrim(cast(isnull(@ing_cost,0) as ' +
        'varchar(10))) + '#39'</AAC>'#39';'
      
        #9#9'set @rxpayload += '#39'<PatientId>'#39' + rtrim(cast(@pat_id as varcha' +
        'r(10))) + '#39'</PatientId>'#39';'
      
        #9#9'set @rxpayload += '#39'<DrugSig>'#39' + rtrim(@drug_sig) + '#39'</DrugSig>' +
        #39';'
      
        #9#9'set @rxpayload += '#39'<DrugName>'#39' + rtrim(@drug_name) + '#39'</DrugNa' +
        'me>'#39';'
      
        #9#9'set @rxpayload += '#39'<PrescDEA>'#39' + rtrim(isnull(@presc_dea,'#39#39')) ' +
        '+ '#39'</PrescDEA>'#39';'
      
        #9#9'set @rxpayload += '#39'<PrescNPI>'#39' + rtrim(isnull(@presc_npi,'#39#39')) ' +
        '+ '#39'</PrescNPI>'#39';'
      
        #9#9'set @rxpayload += '#39'<PlanName>'#39' + rtrim(isnull(@insurance_name,' +
        #39#39')) + '#39'</PlanName>'#39';'
      
        #9#9'set @rxpayload += '#39'<PlanCode>'#39' + rtrim(isnull(@insurance_code,' +
        #39#39')) + '#39'</PlanCode>'#39';'
      #9#9'set @rxpayload += '#39'<NHPhone></NHPhone>'#39';'
      #9#9'set @rxpayload += '#39'<InvName></InvName>'#39';'
      #9#9'set @rxpayload += '#39'<InvName></InvName>'#39';'
      
        #9#9'set @rxpayload += '#39'<DrugSched>'#39' + rtrim(isnull(@schedule_drug,' +
        #39#39')) + '#39'</DrugSched>'#39';'
      
        #9#9'set @rxpayload += '#39'<RefillsRemain>'#39' + rtrim(cast(isNull(@ref_r' +
        'emaining,0) as varchar(10))) + '#39'</RefillsRemain>'#39';'
      
        #9#9'set @rxpayload += '#39'<ExpirationDate>'#39' + FORMAT (@rx_expiration_' +
        'date, '#39'MM/dd/yyyy'#39')  + '#39'</ExpirationDate>'#39';  '
      
        #9#9'set @rxpayload += '#39'<NHWing></NHWing><NHRoom></NHRoom><NHBed></' +
        'NHBed><RxOtc>R</RxOtc></ExtraPayloadData>'#39';'#9#9#9
      #9#9'set @Count += @Count+1;'
      #9#9'if (@Count = 5) or (@TransactionCount = @count) break;'
      #9#9
      #9#9'  '
      #9#9'FETCH NEXT FROM MyCursorD0'
      
        #9#9'INTO @datefilled, @norx, @primarycareprov_idqual, @ndc, @prod_' +
        'serv_qualifier,'
      
        #9#9'@assc_rx_servirefno, @assc_rx_servirefdate, @met_dec_qty, @new' +
        '_ref_code, @days_supply, @daw, '
      
        #9#9'@OtherCoverageCode, @spec_pack_indi, @org_pres_prod_sidq, @org' +
        '_pros_prod_servid, @org_presc_qty,'
      
        #9#9'@unit_of_meassure, @level_of_service, @prior_auth_type_code, @' +
        'prior_auth, @IATID_463_EW,'
      
        #9#9'@IAID_464_EX, @rx_disp_status, @qty_int_disp, @days_supply_int' +
        '_disp, @DRC_357_NV,'
      #9#9'@PAI_391_MT, @rout_of_admin, @compound_type, @PST_147_U7,'
      
        #9#9'@ing_cost, @disp_fee, @pat_paid_amount, @incentive_amount_sub,' +
        ' @usual_customary_charge,'
      
        #9#9'@gross_amount_due, @basis_of_cost, @medicaid_paid_amount, @oth' +
        'er_amount_count, @other_amount_claim_qual,'
      
        #9#9'@other_amount_claim_sub, @otc_number, @drug_name, @schedule_dr' +
        'ug, @cupon_type, @cupon_number, @cupon_amt,'
      
        #9#9'@insurance_code, @planesmedicosno, @nopatplan, @customer_no, @' +
        'prof_serv_fee, @qty_temp'
      #9'END'
      #9'CLOSE MyCursorD0'
      #9'DEALLOCATE MyCursorD0'#9
      #9'set @SendText = @send_str;'
      #9'set @rxpayload += '#39'</ArrayOfExtraPayloadData>'#39';'
      'end;')
    Left = 6048
    Top = 520
  end
  object D0_GetFloatCharacter: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'create procedure [dbo].[D0_GetFloatCharacter] @tokenvalue varcha' +
        'r(20), @outputToken varchar(20) output'
      'as'
      'declare @token varchar(20)'
      'declare @len int'
      'declare @last_chr varchar(1)'
      'declare @str_output varchar(20)'
      'declare @spec_character char(1)'
      'begin'
      '  if rtrim(@tokenvalue) = '#39'0.00'#39
      '  begin'
      '    set @outputToken = '#39'{'#39';'
      '  end'
      '  else'
      '  begin'
      #9'set @tokenvalue = CONVERT(DECIMAL(10,2),@tokenvalue);'
      #9'set @last_chr = '#39#39';'
      #9'set @token = replace(@tokenvalue, '#39'.'#39', '#39#39');'
      #9'set @len = LEN(@token);'
      #9'set @last_chr = substring(@token,@len,1);   '
      #9'set @str_output = SUBSTRING(@token,1,@len-1);'
      #9'if @last_chr = '#39'0'#39' set @spec_character = '#39'{'#39';'
      #9'if @last_chr = '#39'1'#39' set @spec_character = '#39'A'#39';'
      #9'if @last_chr = '#39'2'#39' set @spec_character = '#39'B'#39';'
      #9'if @last_chr = '#39'3'#39' set @spec_character = '#39'C'#39';'
      #9'if @last_chr = '#39'4'#39' set @spec_character = '#39'D'#39';'
      #9'if @last_chr = '#39'5'#39' set @spec_character = '#39'E'#39';'
      #9'if @last_chr = '#39'6'#39' set @spec_character = '#39'F'#39';'
      #9'if @last_chr = '#39'7'#39' set @spec_character = '#39'G'#39';'
      #9'if @last_chr = '#39'8'#39' set @spec_character = '#39'H'#39';'
      #9'if @last_chr = '#39'9'#39' set @spec_character = '#39'I'#39';'
      #9'set @outputToken = @str_output + @spec_character;'
      '  end;'
      'end;'
      ''
      '')
    Left = 6048
    Top = 616
  end
  object D0_COB_segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'Create Procedure [dbo].[D0_COB_segment] @otc_number int, @billin' +
        'g_type char(2),  @COB_string varchar(4000) OUTPUT'
      'as'
      'declare @temp_value char(20)'
      '-- COB_A ----------------------------'
      'declare @NumberRecords int'
      'declare @segment_separator char(1);'
      'declare @FS char(1);'
      'declare @COB_338_5C char(2)'
      'declare @COB_339_6C char(2)'
      'declare @COB_340_7C char(10)'
      'declare @COB_443_E8 date '
      'declare @COB_993_A7 nchar(30)'
      'declare @COB_Bcount int'
      'declare @notrans int'
      '--COB_B------------------------------'
      'declare @COB_342_HC char(2)'
      'declare @COB_431_DV float'
      '--COB_C------------------------------'
      'declare @COB_Ccount int'
      'declare @COB_472_6E NCHAR(3)'
      '--COB_D------------------------------'
      'declare @COB_Dcount int '
      'declare @COB_351_NP char(2)'
      'declare @COB_352_NQ float'
      'declare @cob_segment_string varchar(500)'
      '--COB_E-------------------------------'
      'declare @COB_Ecount int'
      'declare @COB_393_MV char(2)'
      'declare @COB_394_MW float'
      'declare @RowCounter int'
      'begin'
      '  '#9'SET NOCOUNT ON;'
      '    set @RowCounter = 0;'
      
        #9'select @NumberRecords = count(*) from COB_A where otcnumber = @' +
        'otc_number;'
      #9'if @NumberRecords > 0'
      #9'begin'
      #9#9'set @segment_separator = char(30);'
      #9#9'set @FS = char(28);'
      #9#9'set @COB_string = @segment_separator + @FS + '#39'AM'#39' + '#39'05'#39';'
      #9#9
      
        #9#9'DECLARE MyCursor_COBA CURSOR FOR Select COB_338_5C, COB_339_6C' +
        ', COB_340_7C, COB_443_E8, '
      #9#9#9#9'COB_993_A7, NOTRANS from COB_A where OTCNUMBER = @otc_number'
      #9#9'OPEN MyCursor_COBA'
      #9#9'FETCH NEXT FROM MyCursor_COBA'
      
        #9#9'INTO @COB_338_5C, @COB_339_6C, @COB_340_7C, @COB_443_E8, @COB_' +
        '993_A7, @notrans'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      
        #9#9#9'Select @COB_338_5C = COB_338_5C, @COB_339_6C = COB_339_6C, @C' +
        'OB_340_7C = COB_340_7C, @COB_443_E8 = COB_443_E8, '
      
        #9#9#9#9'@COB_993_A7 = COB_993_A7, @notrans = NOTRANS  from COB_A whe' +
        're OTCNUMBER = @otc_number;'#9'    '
      
        #9#9#9'set @COB_string += @FS + '#39'4C'#39' + rtrim(CAST(@NumberRecords AS ' +
        'VARCHAR(2))) ; -- 337-4C'
      
        #9#9#9'if @COB_338_5C > '#39#39' set @COB_string += @FS + '#39'5C'#39' + rtrim(upp' +
        'er(@COB_338_5C)); -- 338-5C'
      #9#9#9'if @billing_type <> '#39'B2'#39
      #9#9#9'begin'
      
        #9#9#9#9'if @COB_339_6C > '#39#39' set @COB_string += @FS + '#39'6C'#39' + rtrim(up' +
        'per(@COB_339_6C)); -- 339-6C '
      
        #9#9#9#9'if @COB_340_7C > '#39#39' set @COB_string += @FS + '#39'7C'#39' + rtrim(up' +
        'per(@COB_340_7C)); -- 34'#216'-7C'
      
        #9#9#9#9'set @COB_string += @FS + '#39'E8'#39' + FORMAT(@COB_443_E8, '#39'yyyyMMd' +
        'd'#39'); -- 443-E8 '
      
        #9#9#9#9'if @COB_993_A7 > '#39#39' set @COB_string += @FS + '#39'7C'#39' + rtrim(up' +
        'per(@COB_340_7C)); -- 34'#216'-7C '
      ''
      
        #9#9#9#9'--COB_B ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_B where NOTRANS = ' +
        '@notrans;'
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'HB'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))) ; -- 341-HB'
      
        #9#9#9#9#9'DECLARE MyCursor_COBB CURSOR FOR Select COB_342_HC, COB_431' +
        '_DV from COB_B where NOTRANS = @notrans'
      #9#9#9#9#9'OPEN MyCursor_COBB'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBB'
      #9#9#9#9#9'INTO @COB_342_HC, @COB_431_DV '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_342_HC > '#39#39' set @COB_string += @FS + '#39'HC'#39' + rtrim(' +
        'upper(@COB_342_HC)); -- 342-HC   '
      #9#9#9#9#9#9'if @COB_431_DV >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_431_DV, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'DV'#39' + rtrim(@temp_value); -- 43' +
        '1-DV'
      #9#9#9#9#9#9'end;'#9#9#9#9
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBB'
      #9#9#9#9#9#9'INTO @COB_342_HC, @COB_431_DV '
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBB'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBB'
      #9#9#9#9' end;'#9#9
      
        #9#9#9#9'--COB_C ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_C where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'#9#9#9#9
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'5E'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --471-5E'
      
        #9#9#9#9#9'DECLARE MyCursor_COBC CURSOR FOR Select COB_472_6E FROM COB' +
        '_C where NOTRANS = @notrans;'
      #9#9#9#9#9'OPEN MyCursor_COBC'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBC'
      #9#9#9#9#9'INTO @COB_472_6E '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_472_6E > '#39#39' set @COB_string += @FS + '#39'6E'#39' + rtrim(' +
        'upper(@COB_472_6E)); -- 472-6E  '
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBC'
      #9#9#9#9#9#9'INTO @COB_472_6E '
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBC'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBC'
      #9#9#9#9'end;'#9
      
        #9#9#9#9'--COB_D ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_D where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'NR'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --353-NR'
      
        #9#9#9#9#9'DECLARE MyCursor_COBD CURSOR FOR Select COB_351_NP, COB_352' +
        '_NQ  FROM COB_D where NOTRANS = @notrans;'
      #9#9#9#9#9'OPEN MyCursor_COBD'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBD'
      #9#9#9#9#9'INTO @COB_351_NP, @COB_352_NQ  '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_351_NP > '#39#39' set @COB_string += @FS + '#39'NP'#39' + rtrim(' +
        'upper(@COB_351_NP)); -- 351-NP'
      #9#9#9#9#9#9'if @COB_352_NQ >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_352_NQ, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'NQ'#39' + rtrim(@temp_value); -- 35' +
        '2-NQ'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBD'
      #9#9#9#9#9#9'INTO @COB_351_NP, @COB_352_NQ'
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBD'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBD'
      #9#9#9#9'end;'
      
        #9#9#9#9'--COB_E-----------------------------------------------------' +
        '-------------'
      
        #9#9#9#9'select @NumberRecords = count(*) from COB_E where NOTRANS = ' +
        '@notrans; '
      #9#9#9#9'if @NumberRecords > 0'
      #9#9#9#9'begin'#9#9#9#9
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'MU'#39' + rtrim(CAST(@NumberRecords A' +
        'S VARCHAR(2))); --392-MU'
      
        #9#9#9#9#9'DECLARE MyCursor_COBE CURSOR FOR SELECT COB_393_MV, COB_394' +
        '_MW FROM COB_E where NOTRANS = @notrans'
      #9#9#9#9#9'OPEN MyCursor_COBE'
      #9#9#9#9#9'FETCH NEXT FROM MyCursor_COBE'
      #9#9#9#9#9'INTO @COB_393_MV, @COB_394_MW  '
      #9#9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'if @COB_393_MV > '#39#39' set @COB_string += @FS + '#39'MV'#39' + rtrim(' +
        'upper(@COB_393_MV)); -- 393-MV'
      #9#9#9#9#9#9'if @COB_394_MW >= 0 '
      #9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_394_MW, @outputToken =' +
        ' @temp_value output;'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'MW'#39' + rtrim(@temp_value); -- 39' +
        '4-MW'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'FETCH NEXT FROM MyCursor_COBE'
      #9#9#9#9#9#9'INTO @COB_393_MV, @COB_394_MW'
      #9#9#9#9#9'END;'
      #9#9#9#9#9'CLOSE MyCursor_COBE'
      #9#9#9#9#9'DEALLOCATE MyCursor_COBE'
      #9#9#9#9'end;'
      #9#9#9'end;'
      
        #9#9#9'-------------------------------------------------------------' +
        '-----------------'
      #9#9#9'FETCH NEXT FROM MyCursor_COBA'
      
        #9#9#9'INTO @COB_338_5C, @COB_339_6C, @COB_340_7C, @COB_443_E8, @COB' +
        '_993_A7, @notrans'
      #9#9'END;'
      #9#9'CLOSE MyCursor_COBA'
      #9#9'DEALLOCATE MyCursor_COBA'
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @COB_string = '#39#39';'
      #9'end;'
      'end;')
    Left = 6056
    Top = 720
  end
  object D0_DUR_Segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[D0_DUR_Segment] @otcnumber int, @billing' +
        '_type char(2), @dur_str varchar(500) output '
      'AS'
      'declare @dur_count int'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @reasonfor_servcode char(2)'
      'declare @prof_serv_code char(2)'
      'declare @resu_ofserv_code char(2)'
      'declare @dur_ppslevel_ofeffort char(2)'
      'declare @dur_coagent_idqual char(2)'
      'declare @dur_coagent_id char(19)'
      'declare @counter int'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      #9'set @counter = 1;'
      
        #9'Select @dur_count = count(*) from DUR_PPS with (NOLOCK) where O' +
        'TCNUMBER = @otcnumber;'
      #9'if @dur_count > 0'
      #9'begin'
      #9#9'set @dur_str = @segment_separator + @FS + '#39'AM'#39' + '#39'08'#39';'#9#9
      
        #9#9'DECLARE MyCursorDUR CURSOR FOR SELECT REASONFOR_SERVCODE, PROF' +
        '_SERVICE_CODE, RESULT_OFSERVICE_CODE,'
      #9#9'DUR_PPSLEVELOFEFFORT, DUR_COAGENT_IDQUAL, DUR_COAGENTID'
      #9#9'from DUR_PPS where OTCNUMBER = @otcnumber;'
      #9#9'OPEN MyCursorDUR'
      #9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9'INTO @reasonfor_servcode, @prof_serv_code, @resu_ofserv_code,'
      #9#9'@dur_ppslevel_ofeffort, @dur_coagent_idqual, @dur_coagent_id'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'begin'#9#9#9
      
        #9#9'    set @dur_str += @FS + '#39'7E'#39' +  cast(@counter as varchar) --' +
        ' 473-7E;'
      
        #9#9#9'if @reasonfor_servcode > '#39#39' set @dur_str += @FS + '#39'E4'#39' + rtri' +
        'm(upper(@reasonfor_servcode)); -- 44'#216'-E4'
      
        #9#9#9'if @prof_serv_code > '#39#39' set @dur_str += @FS + '#39'E5'#39' + rtrim(up' +
        'per(@prof_serv_code)); -- 44'#216'-E5  '
      
        #9#9#9'if @resu_ofserv_code > '#39#39' set @dur_str += @FS + '#39'E6'#39' + rtrim(' +
        'upper(@resu_ofserv_code)); -- 441-E6'
      
        #9#9#9'if @dur_ppslevel_ofeffort > '#39#39' set @dur_str += @FS + '#39'E8'#39' + r' +
        'trim(upper(@dur_ppslevel_ofeffort)); -- 474-8E'
      #9#9#9'-- Not used for reversal'
      #9#9#9'if @billing_type = '#39'B1'#39
      #9#9#9'begin'
      
        #9#9#9#9'if @dur_coagent_idqual > '#39#39' set @dur_str += @FS + '#39'J9'#39' + rtr' +
        'im(upper(@dur_coagent_idqual)); -- 475-J9'
      
        #9#9#9#9'if @dur_coagent_id > '#39#39' set @dur_str += @FS + '#39'H6'#39' + rtrim(u' +
        'pper(@dur_coagent_id)); -- 476-H6'
      #9#9#9'end;'
      #9#9#9'set @counter = @counter+1;'
      #9#9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9#9'INTO @reasonfor_servcode, @prof_serv_code, @resu_ofserv_code,'
      #9#9#9'@dur_ppslevel_ofeffort, @dur_coagent_idqual, @dur_coagent_id'
      #9#9'end;'
      #9#9'CLOSE MyCursorDUR'
      #9#9'DEALLOCATE MyCursorDUR'
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @dur_str = '#39#39';'
      #9'end;'
      'END;')
    Left = 6064
    Top = 824
  end
  object D0_Workers_compensation: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE D0_Workers_compensation @otcnumber int, @worker' +
        's_comp_str varchar(1000) output '
      'AS'
      'declare @count int'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @date_of_injury date'
      'declare @emp_name nchar(30)'
      'declare @emp_street_add nchar(30)'
      'declare @emp_city nchar(20)'
      'declare @emp_state char(2)'
      'declare @emp_zip nchar(15)'
      'declare @emp_phone nchar(10)'
      'declare @emp_contact_name nchar(30)'
      'declare @carrier_id nchar(10)'
      'declare @claim_ref_id nchar(30)'
      'declare @bill_entity_typeindi char(2)'
      'declare @pay_to_qual char(2)'
      'declare @pay_to_id nchar(15)'
      'declare @pay_to_name nchar(20)'
      'declare @pay_to_street nchar(30)'
      'declare @pay_to_city nchar(20)'
      'declare @pay_to_state char(2)'
      'declare @pay_to_zip nchar(15)'
      'declare @gen_eq_prodid_qual char(2)'
      'declare @gen_eq_prodid nchar(19)'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      
        #9'select @count = count(*) from WORKERS_COMPENSATION_SEGMENT wher' +
        'e OTC_NUMBER = @otcnumber;'
      #9'set @workers_comp_str = '#39#39';'
      #9'if @count > 0'
      #9'begin'
      
        #9#9'set @workers_comp_str = @segment_separator + @FS + '#39'AM'#39' + '#39'06'#39 +
        ';'
      
        #9'  '#9'DECLARE MyCursorDUR CURSOR FOR SELECT DATE_OF_INJURY, EMPLOY' +
        'ER_NAME, EMP_STREET_ADDRESS,'
      
        #9#9'EMP_CITY, EMP_STATE, EMP_ZIP, EMP_PHONE, EMP_CONTACT_NAME, CAR' +
        'RIER_ID, '
      
        #9#9'CLAIM_REFERENCE_ID, BILLING_ENTITY_TYPE_INDICATOR, PAY_TO_QUAL' +
        'IFIER, '
      
        #9#9'PAY_TO_ID, PAY_TO_NAME, PAY_TO_STREET_ADDRESS, PAY_TO_CITY_ADD' +
        'RESS,'
      
        #9#9'PAY_TO_STATE, PAY_TO_ZIP, GENERIC_EQUIVALENT_PRODUCT_ID_QUALIF' +
        'IER, GENERIC_EQUIVALENT_PRODUCT_ID'
      
        #9#9'from WORKERS_COMPENSATION_SEGMENT where OTC_NUMBER = @otcnumbe' +
        'r;'
      #9#9'OPEN MyCursorDUR'
      #9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9'INTO @date_of_injury, @emp_name, @emp_street_add, '
      
        #9#9'@emp_city, @emp_state, @emp_zip, @emp_phone, @emp_contact_name' +
        ', @carrier_id, '#9#9
      #9#9'@claim_ref_id, @bill_entity_typeindi, @pay_to_qual,'
      #9#9'@pay_to_id, @pay_to_name, @pay_to_street, @pay_to_city,'
      
        #9#9'@pay_to_state, @pay_to_zip, @gen_eq_prodid_qual, @gen_eq_prodi' +
        'd'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'begin'#9#9#9
      
        #9#9#9'set @workers_comp_str += @FS + '#39'DY'#39' + FORMAT(@date_of_injury,' +
        ' '#39'yyyyMMdd'#39'); --434-DY '
      
        #9#9#9'if @emp_name > '#39#39' set @workers_comp_str += @FS + '#39'CF'#39' + rtrim' +
        '(upper(@emp_name)); -- 315-CF'
      
        #9#9#9'if @emp_street_add > '#39#39' set @workers_comp_str += @FS + '#39'CG'#39' +' +
        ' rtrim(upper(@emp_street_add)); -- 316-CG'
      
        #9#9#9'if @emp_city > '#39#39' set @workers_comp_str += @FS + '#39'CH'#39' + rtrim' +
        '(upper(@emp_city)); -- 317-CH'
      
        #9#9#9'if @emp_state > '#39#39' set @workers_comp_str += @FS + '#39'CI'#39' + rtri' +
        'm(upper(@emp_state)); -- 318-CI'
      
        #9#9#9'if @emp_zip > '#39#39' set @workers_comp_str += @FS + '#39'CJ'#39' + rtrim(' +
        'upper(@emp_zip)); -- 319-CJ '
      
        #9#9#9'if @emp_phone > '#39#39' set @workers_comp_str += @FS + '#39'CK'#39' + rtri' +
        'm(upper(@emp_phone)); -- 32'#216'-CK '
      
        #9#9#9'if @emp_contact_name > '#39#39' set @workers_comp_str += @FS + '#39'CL'#39 +
        ' + rtrim(upper(@emp_contact_name)); -- 321-CL '
      
        #9#9#9'if @carrier_id > '#39#39' set @workers_comp_str += @FS + '#39'CR'#39' + rtr' +
        'im(upper(@carrier_id)); -- 327-CR '
      
        #9#9#9'if @claim_ref_id > '#39#39' set @workers_comp_str += @FS + '#39'DZ'#39' + r' +
        'trim(upper(@claim_ref_id)); -- 435-DZ  '
      #9#9#9
      
        #9#9#9'if @bill_entity_typeindi > '#39#39' set @workers_comp_str += @FS + ' +
        #39'TR'#39' + rtrim(upper(@bill_entity_typeindi)); -- 117-TR'
      
        #9#9#9'if @pay_to_qual > '#39#39' set @workers_comp_str += @FS + '#39'TS'#39' + rt' +
        'rim(upper(@pay_to_qual)); -- 118-TS'
      
        #9#9#9'if @pay_to_id > '#39#39' set @workers_comp_str += @FS + '#39'TT'#39' + rtri' +
        'm(upper(@pay_to_id)); -- 119-TT'
      
        #9#9#9'if @pay_to_name > '#39#39' set @workers_comp_str += @FS + '#39'TU'#39' + rt' +
        'rim(upper(@pay_to_name)); -- 12'#216'-TU'
      
        #9#9#9'if @pay_to_street > '#39#39' set @workers_comp_str += @FS + '#39'TV'#39' + ' +
        'rtrim(upper(@pay_to_street)); -- 121-TV '
      
        #9#9#9'if @pay_to_city > '#39#39' set @workers_comp_str += @FS + '#39'TW'#39' + rt' +
        'rim(upper(@pay_to_city)); -- 122-TW '
      
        #9#9#9'if @pay_to_state > '#39#39' set @workers_comp_str += @FS + '#39'TX'#39' + r' +
        'trim(upper(@pay_to_state)); -- 123-TX '
      
        #9#9#9'if @pay_to_zip > '#39#39' set @workers_comp_str += @FS + '#39'TY'#39' + rtr' +
        'im(upper(@pay_to_state)); -- 124-TY'
      
        #9#9#9'if @gen_eq_prodid_qual > '#39#39' set @workers_comp_str += @FS + '#39'T' +
        'Z'#39' + rtrim(upper(@pay_to_state)); -- 125-TZ '
      
        #9#9#9'if @gen_eq_prodid > '#39#39' set @workers_comp_str += @FS + '#39'UA'#39' + ' +
        'rtrim(upper(@gen_eq_prodid)); -- 126-UA  '
      #9#9#9'FETCH NEXT FROM MyCursorDUR'
      #9#9#9'INTO @date_of_injury, @emp_name, @emp_street_add, '
      
        #9#9#9'@emp_city, @emp_state, @emp_zip, @emp_phone, @emp_contact_nam' +
        'e,'
      
        #9#9#9'@carrier_id, @claim_ref_id, @bill_entity_typeindi, @pay_to_qu' +
        'al,'
      #9#9#9'@pay_to_id, @pay_to_name, @pay_to_street, @pay_to_city,'
      
        #9#9#9'@pay_to_state, @pay_to_zip, @gen_eq_prodid_qual, @gen_eq_prod' +
        'id'
      #9#9'end;'
      #9#9'CLOSE MyCursorDUR'
      #9#9'DEALLOCATE MyCursorDUR'
      #9'end;'
      '    '
      'END')
    Left = 6064
    Top = 928
  end
  object D0_Compound_segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_Compound_segment]'
      '    @otcnumber     INT,'
      '    @compound_str  VARCHAR(MAX) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE '
      '        @count                   INT,'
      '        @segment_separator       CHAR(1),'
      '        @FS                      CHAR(1),'
      '        @comp_dos_form_des_code  CHAR(2),'
      '        @comp_unit_form_indi     CHAR(1),'
      '        @ingredients_str         VARCHAR(MAX),'
      ''
      '        @product_id_qualifier    VARCHAR(2),'
      '        @ndc                     VARCHAR(11),'
      '        @metricquantity          INT,'
      '        @awp                     DECIMAL(18,2),'
      '        @basis_of_cost           VARCHAR(2),'
      '        @temp_value              VARCHAR(20);'
      ''
      '    SET @segment_separator = CHAR(30);'
      '    SET @FS = CHAR(28);'
      '    SET @compound_str = '#39#39';'
      '    SET @ingredients_str = '#39#39';'
      ''
      '    SELECT @count = COUNT(*)'
      '    FROM dbo.MEZCLAS'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    IF ISNULL(@count, 0) <= 0'
      '        RETURN;'
      ''
      '    SELECT'
      
        '        @comp_dos_form_des_code = ISNULL(COMPDOSAGE_FORM_DESC_CO' +
        'DE, '#39#39'),'
      
        '        @comp_unit_form_indi    = ISNULL(COMPDISP_UNIT_FORM_INDI' +
        ', '#39#39')'
      '    FROM dbo.OTC'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    -- AM10 Compound Segment'
      '    SET @compound_str = @segment_separator + @FS + '#39'AM10'#39';'
      ''
      '    -- 450-EF Compound Dosage Form Description Code'
      '    IF LTRIM(RTRIM(ISNULL(@comp_dos_form_des_code, '#39#39'))) <> '#39#39
      
        '        SET @compound_str = @compound_str + @FS + '#39'EF'#39' + UPPER(R' +
        'TRIM(@comp_dos_form_des_code));'
      ''
      '    -- 451-EG Compound Dispensing Unit Form Indicator'
      '    IF LTRIM(RTRIM(ISNULL(@comp_unit_form_indi, '#39#39'))) <> '#39#39
      
        '        SET @compound_str = @compound_str + @FS + '#39'EG'#39' + UPPER(R' +
        'TRIM(@comp_unit_form_indi));'
      ''
      '    -- 447-EC Compound Ingredient Component Count'
      
        '    SET @compound_str = @compound_str + @FS + '#39'EC'#39' + CAST(@count' +
        ' AS VARCHAR(10));'
      ''
      '    DECLARE CurIngredients CURSOR LOCAL FAST_FORWARD FOR'
      '        SELECT'
      '            ISNULL(PRODUCT_ID_QUALIFIER, '#39#39'),'
      '            ISNULL(NDC, '#39#39'),'
      '            ISNULL(CAST(METRICQUANTITY AS INT), 0),'
      '            ISNULL(CONVERT(DECIMAL(18,2), AWP), 0),'
      '            ISNULL(ING_BASIS_OFCOST_DET, '#39#39')'
      '        FROM dbo.MEZCLAS'
      '        WHERE OTCNUMBER = @otcnumber'
      '        ORDER BY MEZCLASNO;'
      ''
      '    OPEN CurIngredients;'
      ''
      '    FETCH NEXT FROM CurIngredients'
      '    INTO @product_id_qualifier,'
      '         @ndc,'
      '         @metricquantity,'
      '         @awp,'
      '         @basis_of_cost;'
      ''
      '    WHILE @@FETCH_STATUS = 0'
      '    BEGIN'
      '        -- 488-RE Compound Product ID Qualifier'
      '        IF LTRIM(RTRIM(@product_id_qualifier)) <> '#39#39
      
        '            SET @ingredients_str = @ingredients_str + @FS + '#39'RE'#39 +
        ' + UPPER(RTRIM(@product_id_qualifier));'
      ''
      '        -- 489-TE Compound Product ID'
      '        IF LTRIM(RTRIM(@ndc)) <> '#39#39
      
        '            SET @ingredients_str = @ingredients_str + @FS + '#39'TE'#39 +
        ' + UPPER(RTRIM(@ndc));'
      ''
      '        -- 448-ED Compound Ingredient Metric Quantity'
      
        '        -- Your system stores implied decimal. Example: 80000 = ' +
        '80.000'
      '        IF ISNULL(@metricquantity, 0) > 0'
      
        '            SET @ingredients_str = @ingredients_str + @FS + '#39'ED'#39 +
        ' + CAST(@metricquantity AS VARCHAR(20));'
      ''
      '        -- 449-EE Compound Ingredient Drug Cost'
      '        IF ISNULL(@awp, 0) > 0'
      '        BEGIN'
      '            SET @temp_value = '#39#39';'
      '            EXEC dbo.D0_GetFloatCharacter '
      '                 @awp,'
      '                 @outputToken = @temp_value OUTPUT;'
      ''
      
        '            SET @ingredients_str = @ingredients_str + @FS + '#39'EE'#39 +
        ' + RTRIM(@temp_value);'
      '        END;'
      ''
      
        '        -- 490-UE Compound Ingredient Basis of Cost Determinatio' +
        'n'
      '        IF LTRIM(RTRIM(@basis_of_cost)) <> '#39#39
      
        '            SET @ingredients_str = @ingredients_str + @FS + '#39'UE'#39 +
        ' + UPPER(RTRIM(@basis_of_cost));'
      ''
      '        FETCH NEXT FROM CurIngredients'
      '        INTO @product_id_qualifier,'
      '             @ndc,'
      '             @metricquantity,'
      '             @awp,'
      '             @basis_of_cost;'
      '    END;'
      ''
      '    CLOSE CurIngredients;'
      '    DEALLOCATE CurIngredients;'
      ''
      '    SET @compound_str = @compound_str + @ingredients_str;'
      'END;')
    Left = 6064
    Top = 1024
  end
  object D0_Clinical_Segment: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_Clinical_Segment]'
      '      @otcnumber INT'
      '    , @clinical_str VARCHAR(1000) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      ''
      '    DECLARE @SEG_TOKEN VARCHAR(10) = '#39'{SEG}'#39';'
      '    DECLARE @FS_TOKEN  VARCHAR(10) = '#39'{FS}'#39';'
      ''
      '    DECLARE @DiagnosisCount INT = 0;'
      '    DECLARE @InfoCount INT = 0;'
      ''
      '    DECLARE @DiagPart VARCHAR(MAX) = '#39#39';'
      '    DECLARE @InfoPart VARCHAR(MAX) = '#39#39';'
      '    DECLARE @work_str VARCHAR(MAX) = '#39#39';'
      ''
      '    SET @clinical_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Count diagnosis rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT @DiagnosisCount = COUNT(*)'
      '    FROM dbo.CLINICAL_SEGMENT'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      '    IF ISNULL(@DiagnosisCount, 0) = 0'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build diagnosis portion'
      
        '    -- XML-safe because it uses tokens instead of CHAR(28)/CHAR(' +
        '30)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    ;WITH D AS'
      '    ('
      '        SELECT'
      '              rn = ROW_NUMBER() OVER'
      '                   ('
      '                       ORDER BY'
      '                           ISNULL(DIAGNOSIS_CODE_QUAL, '#39#39'),'
      '                           ISNULL(DIAGNOSIS_CODE, '#39#39')'
      '                   )'
      '            , DIAGNOSIS_CODE_QUAL ='
      '                UPPER(LTRIM(RTRIM('
      
        '                    REPLACE(REPLACE(ISNULL(DIAGNOSIS_CODE_QUAL, ' +
        #39#39'), CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                )))'
      '            , DIAGNOSIS_CODE ='
      '                UPPER(LTRIM(RTRIM('
      
        '                    REPLACE(REPLACE(ISNULL(DIAGNOSIS_CODE, '#39#39'), ' +
        'CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                )))'
      '        FROM dbo.CLINICAL_SEGMENT'
      '        WHERE OTCNUMBER = @otcnumber'
      '    )'
      '    SELECT'
      '        @DiagPart ='
      '            STUFF'
      '            ('
      '                ('
      '                    SELECT'
      '                          CASE WHEN D.DIAGNOSIS_CODE_QUAL <> '#39#39
      
        '                               THEN @FS_TOKEN + '#39'WE'#39' + D.DIAGNOS' +
        'IS_CODE_QUAL'
      '                               ELSE '#39#39
      '                          END'
      '                        + CASE WHEN D.DIAGNOSIS_CODE <> '#39#39
      
        '                               THEN @FS_TOKEN + '#39'DO'#39' + D.DIAGNOS' +
        'IS_CODE'
      '                               ELSE '#39#39
      '                          END'
      '                    FROM D'
      '                    ORDER BY D.rn'
      '                    FOR XML PATH('#39#39'), TYPE'
      '                ).value('#39'.'#39', '#39'varchar(max)'#39')'
      '            , 1, 0, '#39#39
      '            );'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Count info rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT @InfoCount = COUNT(*)'
      '    FROM dbo.CLINICAL_SEGMENT_INFO'
      '    WHERE OTCNUMBER = @otcnumber;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build measurement/info portion'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF ISNULL(@InfoCount, 0) > 0'
      '    BEGIN'
      '        ;WITH I AS'
      '        ('
      '            SELECT'
      '                  rn = ROW_NUMBER() OVER'
      '                   ('
      '                       ORDER BY'
      '                           ISNULL(MEASUREMENT_DATE, '#39'19000101'#39'),'
      '                           ISNULL(MEASUREMENT_TIME, '#39#39'),'
      '                           ISNULL(MEASUREMENT_DIMENSION, '#39#39'),'
      '                           ISNULL(MEASUREMENT_UNIT, '#39#39'),'
      '                           ISNULL(MEASUREMENT_VALUE, '#39#39')'
      '                   )'
      '                , MEASUREMENT_DATE = MEASUREMENT_DATE'
      '                , MEASUREMENT_TIME ='
      '                    UPPER(LTRIM(RTRIM('
      
        '                        REPLACE(REPLACE(ISNULL(MEASUREMENT_TIME,' +
        ' '#39#39'), CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                    )))'
      '                , MEASUREMENT_DIMENSION ='
      '                    UPPER(LTRIM(RTRIM('
      
        '                        REPLACE(REPLACE(ISNULL(MEASUREMENT_DIMEN' +
        'SION, '#39#39'), CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                    )))'
      '                , MEASUREMENT_UNIT ='
      '                    UPPER(LTRIM(RTRIM('
      
        '                        REPLACE(REPLACE(ISNULL(MEASUREMENT_UNIT,' +
        ' '#39#39'), CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                    )))'
      '                , MEASUREMENT_VALUE ='
      '                    UPPER(LTRIM(RTRIM('
      
        '                        REPLACE(REPLACE(ISNULL(MEASUREMENT_VALUE' +
        ', '#39#39'), CHAR(28), '#39#39'), CHAR(30), '#39#39')'
      '                    )))'
      '            FROM dbo.CLINICAL_SEGMENT_INFO'
      '            WHERE OTCNUMBER = @otcnumber'
      '        )'
      '        SELECT'
      '            @InfoPart ='
      '                STUFF'
      '                ('
      '                    ('
      '                        SELECT'
      
        '                              @FS_TOKEN + '#39'XE'#39' + CAST(I.rn AS VA' +
        'RCHAR(10))'
      '                            + CASE'
      
        '                                  WHEN I.MEASUREMENT_DATE IS NOT' +
        ' NULL'
      
        '                                      THEN @FS_TOKEN + '#39'ZE'#39' + CO' +
        'NVERT(CHAR(8), I.MEASUREMENT_DATE, 112)'
      '                                  ELSE '#39#39
      '                              END'
      '                            + CASE'
      '                                  WHEN I.MEASUREMENT_TIME <> '#39#39
      
        '                                      THEN @FS_TOKEN + '#39'H1'#39' + I.' +
        'MEASUREMENT_TIME'
      '                                  ELSE '#39#39
      '                              END'
      '                            + CASE'
      
        '                                  WHEN I.MEASUREMENT_DIMENSION <' +
        '> '#39#39
      
        '                                      THEN @FS_TOKEN + '#39'H2'#39' + I.' +
        'MEASUREMENT_DIMENSION'
      '                                  ELSE '#39#39
      '                              END'
      '                            + CASE'
      '                                  WHEN I.MEASUREMENT_UNIT <> '#39#39
      
        '                                      THEN @FS_TOKEN + '#39'H3'#39' + I.' +
        'MEASUREMENT_UNIT'
      '                                  ELSE '#39#39
      '                              END'
      '                            + CASE'
      '                                  WHEN I.MEASUREMENT_VALUE <> '#39#39
      
        '                                      THEN @FS_TOKEN + '#39'H4'#39' + I.' +
        'MEASUREMENT_VALUE'
      '                                  ELSE '#39#39
      '                              END'
      '                        FROM I'
      '                        ORDER BY I.rn'
      '                        FOR XML PATH('#39#39'), TYPE'
      '                    ).value('#39'.'#39', '#39'varchar(max)'#39')'
      '                , 1, 0, '#39#39
      '                );'
      '    END'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build final segment with tokens first'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str ='
      '          @SEG_TOKEN'
      '        + @FS_TOKEN + '#39'AM13'#39
      
        '        + @FS_TOKEN + '#39'VE'#39' + CAST(@DiagnosisCount AS VARCHAR(10)' +
        ')'
      '        + ISNULL(@DiagPart, '#39#39')'
      '        + ISNULL(@InfoPart, '#39#39');'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Replace tokens with real delimiters only at the end'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str = REPLACE(@work_str, @FS_TOKEN,  @FS);'
      '    SET @work_str = REPLACE(@work_str, @SEG_TOKEN, @SEG);'
      ''
      '    SET @clinical_str = LEFT(@work_str, 1000);'
      'END')
    Left = 6064
    Top = 1128
  end
