      '  @CODIGO_POSTAL char(12) ,'
      '  @ESPECIALIDAD char(30) ,'
      '  @FAX char(13) ,'
      '  @DESCA varchar(15) ,'
      '  @DEA_FEDERAL varchar(15) ,'
      '  @LICENCIA varchar(15) ,'
      '  @PRESCRIBER_ID_QUALIFIER char(2) ,'
      '  @LOCATION_CODE char(3)'
      '  as'
      'SET NOCOUNT ON'
      'begin'
      #9'begin transaction'
      
        #9'Insert into Doctor (APELLIDO_MATERNO, APELLIDO_PATERNO, NOMBRE,' +
        ' DIRECCION, DIRECCION2,'
      
        #9'INFOADICIONAL, TELEFONO, CODIGO_POSTAL, ESPECIALIDAD, FAX, DESC' +
        'A, DEA_FEDERAL, LICENCIA,'
      #9'PRESCRIBER_ID_QUALIFIER, LOCATION_CODE)'
      
        #9'Values (@APELLIDO_MATERNO, @APELLIDO_PATERNO, @NOMBRE, @DIRECCI' +
        'ON, @DIRECCION2,'
      
        #9'@INFOADICIONAL, @TELEFONO, @CODIGO_POSTAL, @ESPECIALIDAD, @FAX,' +
        ' @DESCA, @DEA_FEDERAL, @LICENCIA,'
      #9'@PRESCRIBER_ID_QUALIFIER, @LOCATION_CODE)'
      #9'commit;'
      'end;')
    Left = 1016
    Top = 800
