      #9#9#9',@EDITAR_PRECIO'
      #9#9#9',@ALCHEMY_PRODUCTID'
      #9#9#9',@PAKAGE_ID'
      #9#9#9',@MARKETEDPRODUCTID'
      #9#9#9',@MARKET_STATUS'
      #9#9#9',@OUTERPACKAGEUNIT'
      #9#9#9',@PAKAGE_DESCRIPTION'
      #9#9#9',@VERSION_DESCRIPTION'
      #9#9#9',0'
      #9#9#9',0'
      #9#9#9',@COBRAR_TAX'
      #9#9#9',@INV340B_QT'
      #9#9#9',@INVLTC_QT'
      #9#9#9',@GENERIC_LNK'
      #9#9#9',@SPI'
      #9#9#9',@AP_FRM_SIG'
