      '        @FROM DATE,'
      '        @TO DATE,'
      '        @Option Nchar(1),'
      '        @OTCNumber Integer,'
      '        @All bit,'
      #9#9'@Balance_all float output,'
      #9#9'@Balance_by_HP float output'
      'AS'
      'SET NOCOUNT ON'
      'begin  '
      '  begin transaction'
      '    if @Option >'#39#39
      #9'begin'
      #9#9'if @All = 1 '
      #9#9'begin'
      
        #9#9'  Update OTC set Pagada = @Option Where Plan_Medico = @HP and ' +
        'FechaOTC Between @FROM and @TO;'#9'  '
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      
        #9#9'  Update OTC set Pagada = @Option Where OTCNUMBER = @OTCNumber' +
        ';'
      #9#9'end;'
      #9'end;'
      
        #9'Select @Balance_all = Sum(Pago_Plan) from OTC where FechaOTC Be' +
        'tween @FROM and @TO and PAGADA <> '#39'T'#39';'
      #9'set @Balance_by_HP = 0;'
      #9'if @HP > '#39#39
      #9'begin'
      
        #9'  Select @Balance_by_HP = Sum(Pago_Plan) from OTC where Plan_Me' +
        'dico = @HP and FechaOTC Between @FROM and @TO and PAGADA <> '#39'T'#39';'
      #9'end;'
      '  commit'
      'end;')
    Left = 1296
    Top = 224
  end
  object REFILL_VALUES: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE  PROCEDURE [dbo].[REFILL_VALUES]'
      
        '@NO_RX BIGINT, @OTCNUMBER INT, @TCosto FLOAT OUTPUT, @TPrecioVen' +
        'ta FLOAT OUTPUT, @TAWP FLOAT OUTPUT,'
      
        '@TQTY FLOAT OUTPUT, @TDispensado float OUTPUT, @TRx INTEGER OUTP' +
        'UT'
      'AS'
      'begin'
      '  begin transaction'
      
        '    select @TQTY = sum(CANTIDADDESPACHADA), @TCosto = SUM(Costo)' +
        ', @TPrecioVenta = Sum(PrecioVenta),@TRx = COUNT(*),'
      
        '    @TDispensado = SUM(CantidadRecetada), @TAWP = Sum(AWP)  from' +
        ' MEZCLAS where OTCNUMBER = @OTCNUMBER;'
      '  commit'
      'end;')
    Left = 1304
    Top = 304
  end
