        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64903'#39', N'#39'Wash'#39', N'#39'A solut' +
