  object UpdateFromResponse: TFDQuery
    AfterExecute = UpdateFromResponseAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[UpdateFromResponse]'
      '   ON  [dbo].[Surescripts]'
      '   AFTER INSERT'
      'AS '
      'declare @TransactionType nchar(20);'
      'declare @MessageID varchar(50);'
      'declare @RelatedMessageID varchar(50);'
      'declare @Response nchar(20);'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      
        #9'--Change ePrescribe status 0 = waitting,  1 = Processed,  2 = p' +
        'rocessing, 3 = Pending, 4 = Answered, 5 = deleted, 6 = CancelRx'
      #9'begin transaction'
      
        #9'Select @TransactionType = RTRIM(TransactionType), @RelatedMessa' +
        'geID = RTRIM(RelatedMessageID), '
      #9'@Response = RTRIM(Response) from inserted;'
      #9'if RTRIM(LTRIM(@TransactionType)) = '#39'CancelRx'#39' '
      #9'begin'
      
        #9'  Update Surescripts set Rx_Status = 6 where MessageID = @Relat' +
        'edMessageID; '
      
        #9'  Update PRESCRIPTIONS set ACTIVE = 0 where MessageID = @Relate' +
        'dMessageID;'
      #9'end;'
      #9'if RTRIM(LTRIM(@TransactionType)) = '#39'RxRenewalResponse'#39' '
      #9'begin'
      #9'  if (@Response = '#39'Denied'#39') '
      #9'  begin'
      
        #9'    Update Surescripts set Rx_Status = 7 where MessageID = @Rel' +
        'atedMessageID; --7 Denied'#9
      #9'  end'
      #9'  else'
      #9'  begin'
      
        #9'    Update Surescripts set Rx_Status = 1 where MessageID = @Rel' +
        'atedMessageID; '
      #9'  end;'
      #9'end;'
      #9'commit;'
      'END'
      ''
      '')
    Left = 3968
    Top = 560
  end
