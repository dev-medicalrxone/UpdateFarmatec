        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69012'#39', N'#39'Bandage'#39', N'#39'A so' +
        'lid composed of single or multilayered strips of permeable mater' +
