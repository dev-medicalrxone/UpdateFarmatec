        'table Suspension'#39', N'#39'A powder intended for injection following r' +
        'econstitution to form a suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69069'#39', N'#39'Powder for Injec' +
        'tion'#39', N'#39'A powder intended for injection following reconstitutio' +
        'n to form a solution or suspension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64907'#39', N'#39'Powder for Oral ' +
