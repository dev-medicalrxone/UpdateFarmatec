        'CREATE TRIGGER [dbo].[CALC_TRANSFER_TOTAL] ON [dbo].[TRANSFER_DE' +
        'TAIL]'
      'FOR INSERT, UPDATE, DELETE'
      'AS'
      '  DECLARE @STOTAL Float;'
      '  DECLARE @TRANSFERID INT;'
