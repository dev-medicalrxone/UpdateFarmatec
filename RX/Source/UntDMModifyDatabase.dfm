        'T_SIGNATURE.SIGNATURE_DATE, dbo.PRODUCT_SIGNATURE.SIGNATURE_USER' +
        ', dbo.PRODUCT_SIGNATURE.TRANSACTIONNUMBER, dbo.PRODUCT_SIGNATURE' +
