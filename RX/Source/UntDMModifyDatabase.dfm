      #9#9'@expiration_date,'
      #9#9'@inventory,'
      #9#9'@NDC,'
      #9#9'@qty_max,'
      #9#9'@qty_min,'
      #9#9'@retail_price,'
      #9#9'@inv_qty_todate);'
      #9'   commit;'
      'end;')
