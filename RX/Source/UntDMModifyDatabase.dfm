  object PRESCRIPTION_FULL: TFDQuery
    AfterExecute = PRESCRIPTION_FULLAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW dbo.PRESCRIPTION_FULL'
      'AS'
      'SELECT'
      '    o.FECHAOTC                         AS RX_SERVICE_DATE,'
      '    o.COSTOVENTA                       AS SALES_COST,'
      '    o.PAGO_PLAN                        AS PLAN_PAY_AMOUNT,'
      '    o.DEDUCIBLE                        AS PAT_PAY_AMOUNT,'
      '    o.RX_STATUS,'
      '    o.PHARMACIST,'
      '    o.DAYS_SUPPLY,'
      ''
      '    ca.RX_COVERAGE_EXPIRES,'
      ''
      '    o.PRECIOFACTURACION                AS AWP,'
      '    o.NUMERO_AUTORIZACION              AS AUTHORIZATION_NUMBER,'
      '    o.PRICE_TABLE_ID,'
      '    o.MEDICAMENTO                      AS DRUG,'
      '    o.NDC,'
      '    o.ATENDIDOPOR                      AS TYPIST,'
      '    o.LOTE                             AS BATCH_NUMBER,'
      '    o.NUMERORECETA                     AS RX_NUMBER,'
      '    o.QTY,'
      '    o.PRODUCT_ID,'
      '    o.BATCH_NUMBER                     AS OTC_BATCH_NUMBER,'
      ''
      '    p.PROXIMOREFILL,'
      '    p.ETIQUETA                         AS RX_SIG,'
      '    p.FECHARECETA                      AS RX_DATE,'
      '    p.CANTIDADRECETADA                 AS RX_QTY_PRESCRIBED,'
      '    p.AUTOMATIC_REFILL,'
      '    p.NUMEROCLIENTE                    AS PAT_CLIENT_NUMBER,'
      '    p.RXORIGINCODE,'
      ''
      '    pa.NOMBRE                          AS PAT_NAME,'
      '    pa.APELLIDOPATERNO                 AS PAT_LASTNAME,'
      '    pa.APELLIDOMATERNO                 AS PAT_MAIDENNAME,'
      '    pa.TELEFONO                        AS PAT_TELEPHONE,'
      '    pa.CELULAR                         AS PAT_CELULAR,'
      '    pa.SEXO                            AS PAT_SEX,'
      '    pa.FECHANACIMIENTO                 AS PAT_DOB,'
      '    pa.LANGUAGE                        AS PAT_LANGUAGE,'
      '    pa.DIRECCION1                      AS PAT_ADDRESS1,'
      '    pa.DIRECCION2                      AS PAT_ADDRESS2,'
      '    pa.CIUDAD                          AS PAT_CITY,'
      '    pa.ESTADO                          AS PAT_STATE,'
      '    pa.CODIGOPOSTAL                    AS PAT_ZIPCODE,'
      ''
      '    d.NUMERODOCTOR                     AS PRESC_NUMBER,'
      '    d.APELLIDO_MATERNO                 AS PRESC_MAIDENNAME,'
      '    pa.IDENTIFICACION                  AS PAT_IDENTIFICATION,'
      '    pa.NOTIFICATION_MODE_SMS,'
      '    d.APELLIDO_PATERNO                 AS PRESC_LASTNAME,'
      '    d.NOMBRE                           AS PRESC_NAME,'
      '    d.TELEFONO                         AS PRESC_TEL,'
      '    d.FAX                              AS PRESC_FAX,'
      '    d.NPI                              AS PRESC_NPI,'
      '    d.email                            AS PRESC_EMAIL,'
      '    d.DIRECCION                        AS PRESC_ADD1,'
      '    d.ESTADO                           AS PRESC_STATE,'
      '    d.CODIGO_POSTAL                    AS PRESC_ZIP,'
      '    d.DIRECCION2                       AS PRESC_ADDRESS2,'
      '    d.CITY                             AS PRESC_CITY,'
      '    d.CELULAR                          AS PRESC_CEL,'
      '    d.DEA_FEDERAL,'
      ''
      '    pm.NOMBRE                          AS PLAN_NAME,'
      '    pm.BINNUMBER                       AS PLAN_BINNUBER,'
      '    pm.TELEFONO_SERVICIO1              AS PLAN_SUPPORT_TEL,'
      ''
      '    p.NUMEROREFILLSAUTORIZADOS         AS RX_REF_AUTHORIZED,'
      '    p.CANTIDAD_DISPONIBLE              AS RX_QTY_AVAILABLE,'
      '    o.CONTROLADO                       AS RX_CONTROL,'
      '    p.FECHAULTIMOREFILL                AS RX_LAST_REFILL_DATE,'
      ''
      
        '    o.PLAN_MEDICO                      AS Health_plan_abbreviati' +
        'on,'
      ''
      '    o.WF_BILLED,'
      '    o.WF_PRINTED,'
      '    o.WF_FILLED,'
      '    o.WF_CHECKED,'
      '    o.WF_DELIVERED,'
      '    o.WF_TYPED,'
      '    o.TOTAL,'
      '    o.TOTAL                            AS CASH_RETAIL_PRICE,'
      '    o.OTCNUMBER                        AS RX_ID,'
      '    o.MED_CHART,'
      '    o.CLAIM_STATUS,'
      '    o.BILL_LATTER,'
      '    o.FACILITY_ID,'
      '    o.NUMEROPLAN                       AS PATPLAN_NUMBER,'
      ''
      '    p.COMPOUNDCODE,'
      '    p.PRESCRIBERIDQUALIFIER,'
      '    o.METRICDECIMALQUANTITY,'
      '    p.ACTIVE                           AS RX_ACTIVE,'
      '    p.SIG,'
      ''
      
        '    o.DISPENSING_FEE_PAID              AS RX_DISPENSING_FEE_PAID' +
        ','
      '    o.MEDICAMENTOMIX,'
      '    pa.ADHERENCE,'
      '    o.OTHER_AMOUNT_PAID                AS RX_OTHER_AMOUNT_PAID,'
      '    o.WF_STORAGE,'
      '    o.WF_CASHIER,'
      '    o.WF_SIGNATURE,'
      '    o.ALCHEMY_PRODUCTID,'
      '    o.MARKETEDPRODUCTID,'
      '    o.PA,'
      '    o.WF_REVERSE,'
      '    o.REFILL_NOTIFIED,'
      '    p.INFORMACION_EXT                  AS NOTE_STR,'
      '    o.TIME_RX,'
      '    o.MEZCLA_TRAN_NO                   AS RX_COMPOUND_ID,'
      '    o.DAW,'
      '    p.ePRESCRIBE_IDMess,'
      '    o.FECHAEXPIRACION                  AS DRUG_EXPIRATION,'
      '    p.SCANED_RX_LINK,'
      '    p.LICENCIA                         AS PRESC_LICENSE,'
      '    o.CODIGOREFILLNUEVO                AS NO_REF_DISPENSADO,'
      '    o.REBATE,'
      '    o.DELIVERY,'
      '    o.SIGNATURE_LINK,'
      '    p.MessageID,'
      '    o.IOU,'
      '    p.GUID,'
      '    pa.DELIVERY                        AS PAT_DELIVERY,'
      '    pm.PLANESMEDICOSNO,'
      '    p.LTC,'
      '    p.F340B'
      'FROM dbo.PRESCRIPTIONS     AS p'
      
        'JOIN dbo.OTC               AS o  ON o.NUMERORECETA    = p.NUMERO' +
        'RECETA'
      
        'JOIN dbo.PACIENTES         AS pa ON pa.NUMEROCLIENTE  = p.NUMERO' +
        'CLIENTE'
      
        'JOIN dbo.DOCTOR            AS d  ON d.NUMERODOCTOR    = p.NUMERO' +
        'DOCTOR'
      
        'JOIN dbo.PLANESMEDICOS     AS pm ON pm.PLANESMEDICOSNO = o.PLANE' +
        'SMEDICOSNO'
      'CROSS APPLY ('
      '    SELECT RX_COVERAGE_EXPIRES ='
      '        CASE'
      
        '            WHEN o.FECHAOTC IS NULL OR NULLIF(o.DAYS_SUPPLY, 0) ' +
        'IS NULL OR o.DAYS_SUPPLY < 1'
      '                THEN NULL'
      
        '            ELSE DATEADD(DAY, o.DAYS_SUPPLY - 1, CONVERT(date, o' +
        '.FECHAOTC))'
      '        END'
      ') AS ca;')
    Left = 496
    Top = 464
  end
