  object INSERT_PICKUP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INSERT_PICKUP] @NORX BIGINT, @OTCNUMBER ' +
        'INT, @INSTANCIA INT, @FECHA DATETIME, @ALL BIT, @REGISTER_ID INT' +
        ', @INSERTED BIT OUTPUT'
      'AS'
      'DECLARE @NO_RX INT'
      'DECLARE @OTC_NUMBER INT'
      'DECLARE @FE DATETIME'
      'DECLARE @REC_COUNT INT'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9#9'SELECT @REC_COUNT = COUNT(*) FROM PICK_UP WHERE OTCNUMBER = @O' +
        'TCNUMBER;'
      #9#9'IF @REC_COUNT = 0'
      #9#9'BEGIN'
      
        #9#9#9'Insert Into Pick_Up(NUMERORECETA, OTCNUMBER, INSTANCIA, FECHA' +
        ', REGISTER_ID) values (@NORX, @OTCNUMBER, @INSTANCIA, @FECHA, @R' +
        'EGISTER_ID);'
      #9#9#9'SET @INSERTED = 1;'
      #9#9'END'
      #9#9'ELSE'
      #9#9'BEGIN'
      #9#9#9'SET @INSERTED = 0;'
      #9#9'END;'
      #9'COMMIT'
      'END;')
    Left = 5400
    Top = 512
  end
  object INSERT_ESIGNATURE_STAMP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_ESIGNATURE_STAMP]'
      '('
      '@OTCNUMBER INT,'
      '@NORX BIGINT,'
      '@SIGNATURE_USER CHAR(3)'
      ')'
      'AS'
      'DECLARE @TOKEN NCHAR(30)'
      'declare @Existingdate datetime'
      'DECLARE @Pesc_Sig_isIdentity BIT'
      'declare @SIGNATURE_LINK_LOCAL INT'
      'SET NOCOUNT ON'
      'BEGIN   '
      #9#9'begin transaction'
      
        #9#9'select @Pesc_Sig_isIdentity = columnproperty(object_id('#39'PRESCR' +
        'IPTION_ESIGNATURE'#39'),'#39'SIGNATURE_LINK'#39','#39'IsIdentity'#39')'
      #9#9'IF @Pesc_Sig_isIdentity = 1'
      #9#9'Begin'
      #9#9#9'INSERT INTO [dbo].[PRESCRIPTION_ESIGNATURE]'
      #9#9#9#9'   ([SIGNATURE_DATE]'
      #9#9#9#9'   ,[SIGNATURE_USER])'
      #9#9#9' VALUES'
      #9#9#9#9'   (GETDATE(),'
      #9#9#9#9'   @SIGNATURE_USER);'
      #9#9#9'set @SIGNATURE_LINK_LOCAL = SCOPE_IDENTITY();'
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      
        #9#9'    Exec SCANED_RX_LINK @SCANED_RX_LINK = @SIGNATURE_LINK_LOCA' +
        'L OUTPUT;'
      #9#9#9'INSERT INTO [dbo].[PRESCRIPTION_ESIGNATURE]'
      #9#9#9#9'   ([SIGNATURE_DATE]'
      #9#9#9#9'   ,[SIGNATURE_LINK] '
      #9#9#9#9'   ,[SIGNATURE_USER])'
      #9#9#9' VALUES'
      #9#9#9#9'   (GETDATE(),'
      #9#9#9#9'   @SIGNATURE_LINK_LOCAL,'
      #9#9#9#9'   @SIGNATURE_USER);'#9#9'  '
      #9#9'end;'
      #9#9'Set @Existingdate=GETDATE()'#9#9
      #9#9'select FORMAT(@Existingdate,'#39'MM/dd/yyyy hh:mm:s tt'#39')'
      #9#9'SELECT @TOKEN = CONCAT(@SIGNATURE_USER, '#39' '#39', @Existingdate);'#9#9
      
        #9#9'Update OTC set Signature_link = @SIGNATURE_LINK_LOCAL, WF_SIGN' +
        'ATURE = @TOKEN where OTCNumber = @OTCNumber;'
      
        #9#9'EXECUTE INSERT_LOG '#39'PRESCRIPTION STAMPED (SINGED)'#39', '#39'A'#39', '#39#39', @' +
        'SIGNATURE_USER, '#39#39', @NORX, @OTCNUMBER,0,0,0,0,0,0,'#39'R'#39','#39'Prescript' +
        'ion was stamped as signed by technician'#39',0,1;'
      #9#9'commit;'
      'END;')
    Left = 5408
    Top = 600
  end
  object INI_VALUES: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INI_VALUES] @CLASSIC_SIG BIT OUTPUT, @Pe' +
        'sc_Sig_isIdentity BIT OUTPUT, @GSDD_VERSION int output,'
      
        '@BYPASS_PAT_VERIFICATION bit output, @Override_Controled_Rx bit ' +
        'output, @Enforce_rx_Scan bit output,'
      
        '@SILENT_BILLING_NEWRX bit output, @EnforceCustTelUpdate bit outp' +
        'ut, @BYPASS_PRESC_VERIFICATION bit output,'
      
        '@DONOTBILLINACTIVE_PRODUCT bit output, @VerificarTelefonoPacient' +
        'e bit output, @SAVEIMAGETODATABASE bit output,'
      
        '@BYPASS_FIRMA_ELECTRONICA bit output, @WF_ENFORCE_FILL bit outpu' +
        't, @NABP nchar(7) output,'
      
        '@DAW_DEFAULT_VALUE char(1) output, @GoldStandardActive BIT OUTPU' +
        'T, @RX_EXPIRATION_DAYS int output,'
      
        '@RX_CONTROLED_EXPIRATION_DAYS int output, @ENFORCE_LEVEL_OF_SERV' +
        'ICE bit output'
      'AS'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9'select @CLASSIC_SIG = isnull(CLASIC_SIG_CODES,0), @GSDD_VERSION' +
        ' = isnull(GSDD_VERSION,0), '
      #9'@BYPASS_PAT_VERIFICATION = isnull(BYPASS_PAT_VERIFICATION,0), '
      
        #9'@ENFORCE_RX_SCAN = ISNULL(ENFORCE_RX_SCAN,0), @SILENT_BILLING_N' +
        'EWRX = isnull(SILENT_BILLING_NEWRX,0), '
      
        #9'@EnforceCustTelUpdate = isnull(EnforceCustTelUpdate,0), @BYPASS' +
        '_PRESC_VERIFICATION = isnull(BYPASS_PRESC_VERIFICATION,0),'
      
        #9'@DONOTBILLINACTIVE_PRODUCT = isnull(DONOTBILLINACTIVE_PRODUCT,0' +
        '), @VerificarTelefonoPaciente = isnull(VerificarTelefonoPaciente' +
        ',0),'
      
        #9'@SAVEIMAGETODATABASE = isnull(SAVEIMAGETODATABASE,0), @BYPASS_F' +
        'IRMA_ELECTRONICA = isnull(BYPASS_FIRMA_ELECTRONICA,0),'
      
        #9'@WF_ENFORCE_FILL = isnull(WF_ENFORCE_FILL,0), @NABP = NABP, @Ov' +
        'erride_Controled_Rx = isnull(OVERRIDE_CONTROLLED_RX,0),'
      
        #9'@DAW_DEFAULT_VALUE = isnull(DAW_DEFAULT_VALUE,'#39'N'#39'), @GoldStanda' +
        'rdActive = isnull(GoldStandardActive,0),'
      
        #9'@RX_EXPIRATION_DAYS = ISNULL(RX_EXPIRATION_DAYS,0), @RX_CONTROL' +
        'ED_EXPIRATION_DAYS = isnull(RX_CONTROLED_EXPIRATION_DAYS, 0),'
      
        #9'@ENFORCE_LEVEL_OF_SERVICE = isnull(ENFORCE_LEVEL_OF_SERVICE, 0)' +
        ' '
      #9'from CREDITDEBITSETUP;'
      
        #9'select @Pesc_Sig_isIdentity = columnproperty(object_id('#39'PRESCRI' +
        'PTION_ESIGNATURE'#39'),'#39'SIGNATURE_LINK'#39','#39'IsIdentity'#39');'
      #9'COMMIT;'
      'END;')
    Left = 5416
    Top = 696
  end
  object WC_INSERT_NEWPRODUCT_BAG: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.WC_INSERT_NEWPRODUCT_BAG'
      '    @BAG_NUMBER        NCHAR(10),'
      '    @DRUG_DESCRIPTION  NCHAR(35),'
      '    @CUSTOMER_NUMBER   INT,'
      '    @STATUS            INT,'
      '    @RX_DATE           DATE,'
      '    @NDC               NCHAR(11),'
      '    @PRUDUCT_ID        INT,'
      '    @RX_NUMBER         BIGINT,'
      '    @COPAY             FLOAT,'
      '    @COST              FLOAT,'
      '    @PRICE             FLOAT,'
      '    @OTC_ATTENDED_BY   NCHAR(5),'
      '    @USER_NO           INT,'
      '    @CASH_PLAN         SMALLINT,'
      '    @QUANTITY          FLOAT,'
      '    @BATCH_NUMBER      INT,'
      '    @OTC_NUMBER        INT,'
      '    @POS_PICKUP        BIT,'
      '    @USER              NCHAR(3),'
      '    @WF_STORAGE        NCHAR(30),'
      '    @IS_CONTROLED      BIT,'
      '    @FILL_NUMBER       INT,'
      '    @DBName            NCHAR(20)'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    DECLARE @MYREFILL_UPDATE_SMARTPICKUP BIT = 0;'
      '    DECLARE @SQL NVARCHAR(MAX);'
      
        '    DECLARE @QDB SYSNAME = QUOTENAME(LTRIM(RTRIM(@DBName))); -- ' +
        'safe for dynamic DB name'
      ''
      '    BEGIN TRY'
      '        BEGIN TRAN;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        -- Setup flag (TOP 1 avoids errors if table has multiple' +
        ' rows)'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        SELECT TOP (1)'
      
        '            @MYREFILL_UPDATE_SMARTPICKUP = ISNULL(MYREFILL_UPDAT' +
        'E_SMARTPICKUP, 0)'
      '        FROM dbo.CREDITDEBITSETUP;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- WillCall_Status touch (only if it exists)'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        IF EXISTS (SELECT 1 FROM dbo.WillCall_Status WHERE BAG_N' +
        'UMBER = @BAG_NUMBER)'
      '        BEGIN'
      '            UPDATE dbo.WillCall_Status'
      '            SET Date_Created = GETDATE(),'
      '                TIME_CREATED = GETDATE(),'
      '                CUSTOMER_NUMBER = @CUSTOMER_NUMBER'
      '            WHERE BAG_NUMBER = @BAG_NUMBER;'
      '        END'
      '        ELSE'
      '        BEGIN'
      
        '            -- If you actually want a row created when missing, ' +
        'uncomment and adapt columns:'
      
        '            -- INSERT dbo.WillCall_Status (BAG_NUMBER, CUSTOMER_' +
        'NUMBER, Date_Created, TIME_CREATED)'
      
        '            -- VALUES (@BAG_NUMBER, @CUSTOMER_NUMBER, GETDATE(),' +
        ' GETDATE());'
      '            --'
      
        '            -- Otherwise, keep just the WILLCALL_STATUS update b' +
        'elow (it will affect 0 rows).'
      '            UPDATE dbo.WillCall_Status'
      '            SET CUSTOMER_NUMBER = @CUSTOMER_NUMBER'
      '            WHERE BAG_NUMBER = @BAG_NUMBER;'
      '        END'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- Insert into WILLCALL (main row)'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        INSERT INTO dbo.WILLCALL'
      '        ('
      
        '            BAG_NUMBER, DRUG_DESCRIPTION, CUSTOMER_NUMBER, STATU' +
        'S,'
      '            RX_DATE, NDC, PRUDUCT_ID, RX_NUMBER, COPAY, COST,'
      '            PRICE, ATTENDED_BY, USER_NO, CASH_PLAN, QUANTITY,'
      '            BATCH_NUMBER, OTC_NUMBER, WILLCALL_DATE_ENTERED,'
      '            POS_PICKUP, FILL_NUMBER'
      '        )'
      '        VALUES'
      '        ('
      
        '            @BAG_NUMBER, @DRUG_DESCRIPTION, @CUSTOMER_NUMBER, @S' +
        'TATUS,'
      
        '            @RX_DATE, @NDC, @PRUDUCT_ID, @RX_NUMBER, @COPAY, @CO' +
        'ST,'
      
        '            @PRICE, @OTC_ATTENDED_BY, @USER_NO, @CASH_PLAN, @QUA' +
        'NTITY,'
      '            @BATCH_NUMBER, @OTC_NUMBER, GETDATE(),'
      '            @POS_PICKUP, @FILL_NUMBER'
      '        );'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- Optional: update REFILL_QUERY in target DB'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        IF @MYREFILL_UPDATE_SMARTPICKUP = 1'
      '        BEGIN'
      '            SET @SQL = N'#39'UPDATE '#39' + @QDB + N'#39'.dbo.REFILL_QUERY'
      '                        SET RX_STATUS = 3'
      '                        WHERE OTCNUMBER = @OTC_NUMBER;'#39';'
      ''
      '            EXEC sp_executesql'
      '                @SQL,'
      '                N'#39'@OTC_NUMBER INT'#39','
      '                @OTC_NUMBER = @OTC_NUMBER;'
      '        END'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- Update OTC WF_STORAGE in target DB'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        SET @SQL = N'#39'UPDATE '#39' + @QDB + N'#39'.dbo.OTC'
      '                    SET WF_STORAGE = @WF_STORAGE'
      '                    WHERE OTCNUMBER = @OTC_NUMBER;'#39';'
      ''
      '        EXEC sp_executesql'
      '            @SQL,'
      '            N'#39'@WF_STORAGE NCHAR(30), @OTC_NUMBER INT'#39','
      '            @WF_STORAGE = @WF_STORAGE,'
      '            @OTC_NUMBER = @OTC_NUMBER;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        -- Insert LOG in target DB (parameterized; no string con' +
        'catenation)'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        SET @SQL = N'#39'INSERT INTO '#39' + @QDB + N'#39'.dbo.[LOG]'
      
        '                    (CODIGO, USUARIO, FECHA, DESCRIPCION, NO_RX,' +
        ' OTCNUMBER, CUSTOMER_ID, DRUG_ID)'
      '                    VALUES'
      
        '                    (@CODIGO, @USUARIO, GETDATE(), @DESCRIPCION,' +
        ' @NO_RX, @OTCNUMBER, @CUSTOMER_ID, @DRUG_ID);'#39';'
      ''
      '        EXEC sp_executesql'
      '            @SQL,'
      
        '            N'#39'@CODIGO CHAR(1), @USUARIO NCHAR(3), @DESCRIPCION N' +
        'VARCHAR(100),'
      
        '              @NO_RX BIGINT, @OTCNUMBER INT, @CUSTOMER_ID INT, @' +
        'DRUG_ID INT'#39','
      '            @CODIGO = '#39'A'#39','
      '            @USUARIO = @USER,'
      '            @DESCRIPCION = N'#39'SmartPickup Rx. Stored'#39','
      '            @NO_RX = @RX_NUMBER,'
      '            @OTCNUMBER = @OTC_NUMBER,'
      '            @CUSTOMER_ID = @CUSTOMER_NUMBER,'
      '            @DRUG_ID = @PRUDUCT_ID;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- Local willcall log'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        INSERT INTO dbo.WILLCALL_LOG (user_no, Log_Date, Descrip' +
        'tion, Module, BAG_NUMBER, RX_NUMBER)'
      
        '        VALUES (@USER_NO, GETDATE(), CONCAT('#39'Insert Prescription' +
        ' : '#39', @RX_NUMBER), '#39'Load'#39', @BAG_NUMBER, @RX_NUMBER);'
      ''
      '        COMMIT;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF XACT_STATE() <> 0 AND @@TRANCOUNT > 0'
      '            ROLLBACK;'
      ''
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 5416
    Top = 800
  end
  object RX_CHANGE_PATIENT_PLAN: TFDQuery
    AfterExecute = RX_CHANGE_PATIENT_PLANAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[RX_CHANGE_PATIENT_PLAN]'
      '    @PAT_PLAN_NUMBER INT,'
      '    @GUID VARCHAR(36),'
      '    @PRICE_TABLE_ID INT,'
      '    @FACILITY_ID INT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    SET @GUID = NULLIF(LTRIM(RTRIM(@GUID)), '#39#39');'
      ''
      '    IF @GUID IS NULL'
      
        '        THROW 50001, '#39'Parameter @GUID is required and cannot be ' +
        'NULL or blank.'#39', 1;'
      ''
      '    IF ISNULL(@PAT_PLAN_NUMBER, 0) <= 0'
      
        '        THROW 50002, '#39'Parameter @PAT_PLAN_NUMBER is required.'#39', ' +
        '1;'
      ''
      '    DECLARE '
      '        @PM VARCHAR(10),'
      '        @TERMINADA BIT,'
      '        @CLAIM_STATUS INT,'
      '        @HEALTH_PLAN_NUMBER INT,'
      '        @NO_CLIENTE INT,'
      '        @PLAN_F340B BIT = 0,'
      ''
      '        @OTCNUMBER INT,'
      '        @NUMERORECETA BIGINT,'
      '        @QTY_TEMP FLOAT,'
      '        @PRODUCT_ID INT,'
      ''
      '        @UNIT_PRICE FLOAT,'
      '        @Retail_Price FLOAT,'
      '        @Usual_Customary FLOAT,'
      '        @Cost_ FLOAT,'
      '        @Metric_Quantity FLOAT,'
      '        @Metric_DecimalQuantity FLOAT,'
      '        @Billing_Price FLOAT,'
      '        @DISPENSINGFEE FLOAT,'
      '        @GrossAmount_Due FLOAT,'
      '        @QTY_PRICE FLOAT,'
      ''
      '        @PAT_ADHERENCE BIT = 0,'
      '        @PAT_DELIVERY BIT = 0,'
      '        @PAT_LTC BIT = 0,'
      '        @PAT_VETERINARY BIT = 0,'
      '        @PAT_AUTOMATIC_REFILL BIT = 0,'
      '        @PAT_OVERRIDE_DEFAULT_PRICE BIT = 0,'
      '        @PAT_HAS_FACILITY BIT = 0,'
      '        @PAT_340B BIT = 0;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      '        IF NOT EXISTS'
      '        ('
      '            SELECT 1'
      '            FROM dbo.OTC'
      '            WHERE GUID = @GUID'
      '              AND NUMERORECETA IS NOT NULL'
      '        )'
      
        '            THROW 50003, '#39'No OTC prescription records found for ' +
        'the provided GUID.'#39', 1;'
      ''
      '        SELECT '
      '            @PM = RTRIM(PP.PLANMEDICO),'
      '            @HEALTH_PLAN_NUMBER = ISNULL(PP.PLANESMEDICOSNO, 0),'
      '            @NO_CLIENTE = PP.NUMEROCLIENTE'
      '        FROM dbo.PATPLAN PP'
      '        WHERE PP.NUMEROPLAN = @PAT_PLAN_NUMBER;'
      ''
      '        IF ISNULL(@NO_CLIENTE, 0) <= 0'
      
        '            THROW 50004, '#39'Invalid patient plan. Could not determ' +
        'ine NUMEROCLIENTE from PATPLAN.'#39', 1;'
      ''
      '        IF NULLIF(LTRIM(RTRIM(@PM)), '#39#39') IS NULL'
      
        '            THROW 50005, '#39'Invalid patient plan. Could not determ' +
        'ine PLANMEDICO from PATPLAN.'#39', 1;'
      ''
      '        SELECT'
      '            @PLAN_F340B = ISNULL(PM.F340B, 0)'
      '        FROM dbo.PLANESMEDICOS PM'
      '        WHERE PM.PLANESMEDICOSNO = @HEALTH_PLAN_NUMBER;'
      ''
      '        SELECT'
      '            @PAT_ADHERENCE = ISNULL(P.ADHERENCE, 0),'
      '            @PAT_DELIVERY = ISNULL(P.DELIVERY, 0),'
      '            @PAT_LTC = ISNULL(P.LTC, 0),'
      '            --@PAT_VETERINARY = @PAT_VETERINARY,'
      
        '            @PAT_AUTOMATIC_REFILL = ISNULL(P.AUTOMATIC_REFILL, 0' +
        '),'
      
        '            @PAT_OVERRIDE_DEFAULT_PRICE = ISNULL(P.OVERRIDE_SYST' +
        'EM_DEFAULT_PRICE, 0)'
      '        FROM dbo.PACIENTES P'
      '        WHERE P.NUMEROCLIENTE = @NO_CLIENTE;'
      ''
      '        SET @PAT_HAS_FACILITY ='
      '            CASE'
      '                WHEN EXISTS'
      '                ('
      '                    SELECT 1'
      '                    FROM dbo.RELATIONFACILITY_PAT'
      '                    WHERE NUMEROCLIENTE = @NO_CLIENTE'
      '                )'
      '                THEN 1'
      '                ELSE 0'
      '            END;'
      ''
      '        SET @PAT_340B ='
      '            CASE'
      '                WHEN ISNULL(@PAT_LTC, 0) = 0'
      '                 AND ISNULL(@PAT_HAS_FACILITY, 0) = 1'
      '                 AND ISNULL(@PLAN_F340B, 0) = 1'
      '                THEN 1'
      '                ELSE 0'
      '            END;'
      ''
      '        IF @PM = '#39'CAS'#39
      '        BEGIN'
      '            SET @TERMINADA = 1;'
      '            SET @CLAIM_STATUS = 0;'
      '        END'
      '        ELSE'
      '        BEGIN'
      '            SET @TERMINADA = 0;'
      '            SET @CLAIM_STATUS = 5;'
      '        END;'
      ''
      '        DECLARE MyCursor CURSOR LOCAL FAST_FORWARD FOR'
      '            SELECT '
      '                O.NUMERORECETA,'
      '                O.OTCNUMBER,'
      '                O.QTY_TEMP,'
      '                O.PRODUCT_ID'
      '            FROM dbo.OTC O'
      '            WHERE O.GUID = @GUID'
      '              AND O.NUMERORECETA IS NOT NULL;'
      ''
      '        OPEN MyCursor;'
      ''
      '        FETCH NEXT FROM MyCursor'
      '        INTO @NUMERORECETA, @OTCNUMBER, @QTY_TEMP, @PRODUCT_ID;'
      ''
      '        WHILE @@FETCH_STATUS = 0'
      '        BEGIN'
      '            SET @UNIT_PRICE = 0;'
      '            SET @Retail_Price = 0;'
      '            SET @Usual_Customary = 0;'
      '            SET @Cost_ = 0;'
      '            SET @Metric_Quantity = 0;'
      '            SET @Metric_DecimalQuantity = 0;'
      '            SET @Billing_Price = 0;'
      '            SET @DISPENSINGFEE = 0;'
      '            SET @GrossAmount_Due = 0;'
      ''
      '            IF @PM = '#39'CAS'#39
      '                SET @QTY_PRICE = @QTY_TEMP;'
      '            ELSE'
      '                SET @QTY_PRICE = 0;'
      ''
      '            EXEC dbo.RX_CALCULATE_PRICE'
      '                @OTCNUMBER,'
      '                @PRODUCT_ID,'
      '                @QTY_TEMP,'
      '                @PRICE_TABLE_ID,'
      '                @UnitPrice = @UNIT_PRICE OUTPUT,'
      '                @RetailPrice = @Retail_Price OUTPUT,'
      '                @UsualCustomary = @Usual_Customary OUTPUT,'
      '                @Cost = @Cost_ OUTPUT,'
      '                @MetricQuantity = @Metric_Quantity OUTPUT,'
      
        '                @MetricDecimalQuantity = @Metric_DecimalQuantity' +
        ' OUTPUT,'
      '                @BillingPrice = @Billing_Price OUTPUT,'
      '                @Disp_Fee = @DISPENSINGFEE OUTPUT,'
      '                @GossAmountDue = @GrossAmount_Due OUTPUT;'
      ''
      '            IF @PM = '#39'CAS'#39
      '                SET @Usual_Customary = @Retail_Price;'
      ''
      '            UPDATE O'
      '            SET'
      '                O.NUMEROCLIENTE = @NO_CLIENTE,'
      '                O.PLAN_MEDICO = @PM,'
      '                O.NUMEROPLAN = @PAT_PLAN_NUMBER,'
      '                O.TERMINADA = @TERMINADA,'
      '                O.UNIT_PRICE = @UNIT_PRICE,'
      '                O.TOTAL = @Usual_Customary,'
      '                O.COSTOVENTA = @Cost_,'
      '                O.CLAIM_STATUS = @CLAIM_STATUS,'
      '                O.PRECIOFACTURACION = @Billing_Price,'
      '                O.DISPENSINGFEE = @DISPENSINGFEE,'
      '                O.PRICE_TABLE_ID = @PRICE_TABLE_ID,'
      '                O.PLANESMEDICOSNO = @HEALTH_PLAN_NUMBER,'
      '                O.QTY = @QTY_PRICE,'
      '                O.DELIVERY = @PAT_DELIVERY,'
      '                O.ADHERENCE = @PAT_ADHERENCE,'
      '                O.FACILITY_ID = @FACILITY_ID'
      '            FROM dbo.OTC O'
      '            WHERE O.OTCNUMBER = @OTCNUMBER'
      '              AND O.NUMERORECETA = @NUMERORECETA'
      '              AND O.GUID = @GUID;'
      ''
      '            IF @@ROWCOUNT <> 1'
      
        '                THROW 50006, '#39'Update blocked: OTCNUMBER did not ' +
        'match current GUID batch.'#39', 1;'
      ''
      '            UPDATE P'
      '            SET '
      '                P.NUMEROCLIENTE = @NO_CLIENTE,'
      '                P.LTC = @PAT_LTC,'
      '                P.AUTOMATIC_REFILL = @PAT_AUTOMATIC_REFILL,'
      '                --P.VETERINARY = @PAT_VETERINARY,'
      '                P.F340B = @PAT_340B'
      '            FROM dbo.PRESCRIPTIONS P'
      '            WHERE P.NUMERORECETA = @NUMERORECETA'
      '              AND EXISTS'
      '              ('
      '                  SELECT 1'
      '                  FROM dbo.OTC O'
      '                  WHERE O.NUMERORECETA = P.NUMERORECETA'
      '                    AND O.OTCNUMBER = @OTCNUMBER'
      '                    AND O.GUID = @GUID'
      '              );'
      ''
      '            IF @@ROWCOUNT <> 1'
      
        '                THROW 50007, '#39'Update blocked: PRESCRIPTION did n' +
        'ot match current GUID batch.'#39', 1;'
      ''
      '            FETCH NEXT FROM MyCursor'
      
        '            INTO @NUMERORECETA, @OTCNUMBER, @QTY_TEMP, @PRODUCT_' +
        'ID;'
      '        END;'
      ''
      '        CLOSE MyCursor;'
      '        DEALLOCATE MyCursor;'
      ''
      '        COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF CURSOR_STATUS('#39'local'#39', '#39'MyCursor'#39') >= -1'
      '        BEGIN'
      '            CLOSE MyCursor;'
      '            DEALLOCATE MyCursor;'
      '        END;'
      ''
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        THROW;'
      '    END CATCH;'
      'END;')
    Left = 5456
    Top = 904
  end
  object QUICK_RX_INSERT: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[QUICK_RX_INSERT]'
      
        '@PRESCRIBER_ID INT, @PRODUCT_ID INT, @QTY DECIMAL(18,2), @LABELC' +
        'ODESNO INT, @DAYS_SUPPLY INT, @DAW SMALLINT, @SUCCESS INT OUTPUT'
      'AS'
      'DECLARE @COUNT_1 INT'
      'BEGIN'
      #9'BEGIN TRANSACTION'
      
        #9#9'SELECT @COUNT_1 = COUNT(*) FROM QUICK_RX WHERE (PRESCRIBER_ID ' +
        '= @PRESCRIBER_ID) AND (PRODUCT_ID = @PRODUCT_ID) AND'
      
        #9#9'(QTY = @QTY) AND (LABELCODESNO = @LABELCODESNO) AND (DAYS_SUPP' +
        'LY = @DAYS_SUPPLY) AND (DAW = @DAW);'
      #9#9'IF @COUNT_1 = 0 '
      #9#9'BEGIN '
      #9#9#9'INSERT INTO [dbo].[QUICK_RX]'
      #9#9#9#9'([PRESCRIBER_ID]'
      #9#9#9#9',[PRODUCT_ID]'
      #9#9#9#9',[QTY]'
      #9#9#9#9',[LABELCODESNO]'
      #9#9#9#9',[DAYS_SUPPLY]'
      #9#9#9#9',[DAW])'
      #9#9#9'VALUES'
      #9#9#9#9'(@PRESCRIBER_ID'
      #9#9#9#9',@PRODUCT_ID'
      #9#9#9#9',@QTY'
      #9#9#9#9',@LABELCODESNO'
      #9#9#9#9',@DAYS_SUPPLY'
      #9#9#9#9',@DAW);'
      #9#9#9#9'SET @SUCCESS = 1;'
      #9#9'END'
      #9#9'ELSE'
      #9#9'BEGIN'
      #9#9#9'SET @SUCCESS = 0;'
      #9#9'END;'
      #9'COMMIT;'
      'END;')
    Left = 5304
    Top = 1024
  end
  object QUICK_RX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'QUICK_RX' +
        #39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[QUICK_RX]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[PRESCRIBER_ID] [int] NULL,'
      #9'[PRODUCT_ID] [int] NULL,'
      #9'[QTY] [decimal](18, 2) NULL,'
      #9'[LABELCODESNO] [int] NULL,'
      #9'[DAYS_SUPPLY] [int] NULL,'
      #9'[DAW] [smallint] NULL,'
      ' CONSTRAINT [PK_QUICK_RX] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY]'
      'END;')
    Left = 5192
    Top = 1024
  end
  object QUICK_RX_VIEW: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[QUICK_RX_VIEW]'
      'AS'
      
        'SELECT        QUICK_RX_1.PRESCRIBER_ID, dbo.INVENTARIOPISO.DESCR' +
        'IPCION, dbo.INVENTARIOPISO.STRENGTH, dbo.INVENTARIOPISO.NDC, dbo' +
        '.LABELCODES.CODIGOS, dbo.LABELCODES.ENGLISH, '
      
        '                         dbo.LABELCODES.SPANISH, dbo.DOCTOR.APEL' +
        'LIDO_MATERNO, dbo.DOCTOR.APELLIDO_PATERNO, dbo.DOCTOR.NOMBRE, db' +
        'o.DOCTOR.DIRECCION, dbo.DOCTOR.TELEFONO, QUICK_RX_1.QTY, '
      
        '                         QUICK_RX_1.DAYS_SUPPLY, QUICK_RX_1.LABE' +
        'LCODESNO, QUICK_RX_1.DAW, QUICK_RX_1.ID'
      'FROM            dbo.QUICK_RX AS QUICK_RX_1 INNER JOIN'
      
        '                         dbo.INVENTARIOPISO ON QUICK_RX_1.PRODUC' +
        'T_ID = dbo.INVENTARIOPISO.PRODUCTNO INNER JOIN'
      
        '                         dbo.LABELCODES ON QUICK_RX_1.LABELCODES' +
        'NO = dbo.LABELCODES.LABELCODESNO INNER JOIN'
      
        '                         dbo.DOCTOR ON QUICK_RX_1.PRESCRIBER_ID ' +
        '= dbo.DOCTOR.NUMERODOCTOR')
    Left = 5432
    Top = 1024
  end
  object CUSTOMER_CLASSIFICATION: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'CUSTOMER' +
        '_CLASSIFICATION'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[CUSTOMER_CLASSIFICATION]('
