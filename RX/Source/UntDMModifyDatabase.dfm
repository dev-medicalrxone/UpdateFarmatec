      '       begin '
      
        '         DECLARE MyCursor CURSOR FOR SELECT CANTIDADDESPACHADA, ' +
        'PRODUCT_ID from MEZCLAS where NO_TRANS = @MEZCLA_TRAN_NO;'
      '         OPEN MyCursor'
      '         FETCH NEXT FROM MyCursor'
      '         INTO @QTY,@PRODUCTID'
      '         WHILE @@FETCH_STATUS = 0'
      '         BEGIN'
      
        '           Update InventarioPiso set QTYINVENTARIO = QTYINVENTAR' +
        'IO - @QTY where PRODUCTNO = @PRODUCTID;'
      '           FETCH NEXT FROM MyCursor'
      '           INTO @QTY,@PRODUCTID'
      '         END'
      '         CLOSE MyCursor'
      '         DEALLOCATE MyCursor'
      '       end;'
      '     end;'
      '  commit'
      'end;')
    Left = 496
    Top = 384
  end
