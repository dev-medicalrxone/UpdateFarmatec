  object TRANSFER_PROD: TFDQuery
    AfterExecute = TRANSFER_PRODAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'TRANSFER' +
        '_PROD'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[TRANSFER_PROD]('
      #9'[PRODUCTNO] [int] NULL,'
      #9'[TRANSFERID] [int] NULL,'
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      ' CONSTRAINT [PK_TRANSFER_PROD] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY]'
      'END;')
    Left = 4576
    Top = 248
  end
  object LOCK_UNLOCK: TFDQuery
    AfterExecute = LOCK_UNLOCKAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[LOCK_UNLOCK]'
      'ON [dbo].[OTC]'
      'AFTER INSERT, UPDATE, DELETE'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    BEGIN TRY'
      
        '        --------------------------------------------------------' +
        '------------'
      
        '        -- 2) INSERT/UPDATE behavior: when RECORD_LOCKED changes' +
        ', sync lock'
      
        '        --------------------------------------------------------' +
        '------------'
      '        IF (UPDATE(RECORD_LOCKED))'
      '        BEGIN'
      
        '            -- Materialize rows that represent a lock/unlock cha' +
        'nge'
      '            CREATE TABLE #LockRows ('
      '                NUMERORECETA   BIGINT NULL,'
      '                NUMEROCLIENTE  INT    NULL,'
      '                RECORD_LOCKED  BIT    NULL,'
      '                INSTANCIA      INT    NULL'
      '            );'
      ''
      '            -- INSERT rows (no matching deleted row)'
      
        '            INSERT INTO #LockRows (NUMERORECETA, NUMEROCLIENTE, ' +
        'RECORD_LOCKED, INSTANCIA)'
      '            SELECT'
      '                i.NUMERORECETA,'
      '                i.NUMEROCLIENTE,'
      '                i.RECORD_LOCKED,'
      '                i.INSTANCIA'
      '            FROM inserted i'
      '            LEFT JOIN deleted d'
      '              ON d.OTCNUMBER = i.OTCNUMBER'
      '            WHERE d.OTCNUMBER IS NULL;'
      ''
      '            -- UPDATE rows where RECORD_LOCKED actually changed'
      
        '            INSERT INTO #LockRows (NUMERORECETA, NUMEROCLIENTE, ' +
        'RECORD_LOCKED, INSTANCIA)'
      '            SELECT'
      '                i.NUMERORECETA,'
      '                i.NUMEROCLIENTE,'
      '                i.RECORD_LOCKED,'
      '                i.INSTANCIA'
      '            FROM inserted i'
      '            JOIN deleted d'
      '              ON d.OTCNUMBER = i.OTCNUMBER'
      
        '            WHERE ISNULL(i.RECORD_LOCKED, 0) <> ISNULL(d.RECORD_' +
        'LOCKED, 0);'
      ''
      
        '            -- Update PRESCRIPTIONS (group to avoid multi-row du' +
        'plicates)'
      '            UPDATE p'
      '            SET p.RECORD_LOCKED = lr.RECORD_LOCKED,'
      '                p.INSTANCIA     = lr.INSTANCIA'
      '            FROM dbo.PRESCRIPTIONS p'
      '            JOIN ('
      '                SELECT'
      '                    NUMERORECETA,'
      
        '                    RECORD_LOCKED = MAX(CONVERT(INT, RECORD_LOCK' +
        'ED)),'
      '                    INSTANCIA     = MAX(ISNULL(INSTANCIA,0))'
      '                FROM #LockRows'
      '                WHERE NUMERORECETA IS NOT NULL'
      '                GROUP BY NUMERORECETA'
      '            ) lr'
      '              ON lr.NUMERORECETA = p.NUMERORECETA;'
      ''
      '            -- Update PACIENTES'
      '            UPDATE pa'
      '            SET pa.RECORD_LOCKED = lr.RECORD_LOCKED,'
      '                pa.INSTANCIA     = lr.INSTANCIA'
      '            FROM dbo.PACIENTES pa'
      '            JOIN ('
      '                SELECT'
      '                    NUMEROCLIENTE,'
      
        '                    RECORD_LOCKED = MAX(CONVERT(INT, RECORD_LOCK' +
        'ED)),'
      '                    INSTANCIA     = MAX(ISNULL(INSTANCIA,0))'
      '                FROM #LockRows'
      '                WHERE NUMEROCLIENTE IS NOT NULL'
      '                GROUP BY NUMEROCLIENTE'
      '            ) lr'
      '              ON lr.NUMEROCLIENTE = pa.NUMEROCLIENTE;'
      '        END'
      '    END TRY'
      '    BEGIN CATCH'
      '        THROW;'
      '    END CATCH'
      'END;')
    Left = 4560
    Top = 760
  end
  object LOCK_UNLOCK_DEL: TFDQuery
    AfterExecute = LOCK_UNLOCK_DELAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[LOCK_UNLOCK_DEL]'
      '   ON [dbo].[OTC] '
      '   AFTER DELETE'
      'AS '
      'declare @NO_RX BIGINT'
      'declare @NO_CLIENTE INT'
      'declare @OTCNUMBER INT'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  begin transaction'
      
        #9'SELECT @NO_RX = NUMERORECETA, @NO_CLIENTE = NUMEROCLIENTE, @OTC' +
        'NUMBER = OTCNUMBER  FROM deleted;'
      
        #9'Update PRESCRIPTIONS set RECORD_LOCKED = 0, INSTANCIA = 0 WHERE' +
        ' NUMERORECETA = @NO_RX;'
      
        #9'Update PACIENTES set RECORD_LOCKED = 0, INSTANCIA = 0 WHERE NUM' +
        'EROCLIENTE = @NO_CLIENTE;'
      #9'delete from COB_A where OTCNUMBER = @OTCNUMBER;'
      '  commit;'
      'END;')
    Left = 4560
    Top = 840
  end
  object INSERT_PRINT_QUERIES: TFDQuery
    AfterExecute = INSERT_PRINT_QUERIESAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER[dbo].[INSERT_PRINT_QUERIES] ON [dbo].[OTC]'
      '   FOR INSERT'
      'AS '
      'SET NOCOUNT ON'
      'DECLARE @OTCNUMBER INT'
      'DECLARE @ATENDIDAPOR CHAR(4)'
      'DECLARE @IMPRIMIR CHAR(1)'
      'begin'
      #9'begin transaction'
      
        #9'Select @OTCNUMBER = OTCNUMBER, @ATENDIDAPOR = ATENDIDOPOR, @IMP' +
        'RIMIR = PRINT_Q FROM INSERTED;'
      #9'IF @IMPRIMIR = '#39'T'#39' '
      #9'begin'
      #9#9'INSERT INTO [dbo].[PRINT_QUERIES]'
      #9#9'([RX_ID]'
      #9#9',[COPIES]'
      #9#9',[RX_OTC]'
      #9#9',[LABEL_NAME]'
      #9#9',[TYPIST]'
      #9#9',[PRINTTOSCREEN])'
      #9#9'VALUES'
      #9#9'(@OTCNUMBER, 1, '#39'RX'#39', '#39'DEFAULT'#39', @ATENDIDAPOR, 0);  '
      #9'end;'
      #9'commit'
      'end;')
    Left = 640
    Top = 104
  end
