        'SELECT        dbo.INVENTARIOPISO.PRODUCTNO, dbo.ORDER_DETAIL.DES' +
        'CRIPTION, dbo.ORDER_DETAIL.NDC, dbo.ORDER_DETAIL.QTYRECEIVED, db' +
        'o.INVENTARIOPISO.CONTROLADO, dbo.INVENTARIOPISO.INITIAL_QTY, '
      
