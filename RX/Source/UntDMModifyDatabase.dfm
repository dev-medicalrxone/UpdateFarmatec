      #9'end;'
      #9'if @build_only_one = 1'
      #9'begin'
      
        #9#9'DECLARE MyCursorD0 CURSOR FOR SELECT FORMAT(FECHAOTC, '#39'yyyyMMd' +
        'd'#39'), isnull(NUMERORECETA,0), isnull(PRIMARYCAREPROVIDQUALIFIER,'#39 +
        #39'), '
      #9#9'isnull(NDC,'#39#39'), isnull(PRODUCTSERVIDQUAL,'#39'03'#39'),'
      
        #9#9'isnull(ASSOC_RX_SERVICE_REF_NO,'#39#39'), FORMAT (ASSOC_RX_SERVICE_D' +
        'ATE, '#39'yyyyMMdd'#39'), '
      
        #9#9'isnull(METRICDECIMALQUANTITY,0), isnull(CODIGOREFILLNUEVO,0), ' +
        'isnull(DAYS_SUPPLY,0), isnull(DAW,0), '
      
        #9#9'isnull(OTHERCOVERAGECODE,'#39#39'), isnull(SPECIAL_PACK_INDI_429_DT,' +
        #39#39'), '
      
        #9#9'isnull(ORG_PRES_PROD_SIDQ,'#39#39'), isnull(ORG_PROS_PROD_SERVID,'#39#39')' +
        ', '
      #9#9'isnull(ORG_PRESC_QTY,0), isnull(UNIT_OF_MEASURE,'#39#39'), '
      #9#9'isnull(LEVELOFSERVICE,0), isnull(PRIOR_AUTH_TYPE_CODE,'#39#39'), '
