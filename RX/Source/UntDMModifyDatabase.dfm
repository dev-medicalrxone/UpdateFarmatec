      #9'if @PrecioaVenderCash = 0'
      #9'begin'
      #9'  SELECT @PrecioaVenderCash = @INV_PRICE;'
      #9'end;'
      ''
      ' '#9'if (@TYPE = '#39'INJ'#39') OR (@TYPE = '#39'PQ'#39')'
      #9'begin'
      
        '        Select @UnitPrice = ((@INV_PRICE / @PackageSize) / @Metr' +
        'icSize) * 1;'
      
        '        Select @INV_RBP = ((@PrecioaVenderHP / @PackageSize) / @' +
        'MetricSize) * @QTY;'
      
        '        Select @RetailPrice =  ((@PrecioaVenderCash / @PackageSi' +
        'ze) / @MetricSize) * @QTY;'
      
        '        Select @cost = ((@INV_COST / @PackageSize) / @MetricSize' +
        ') * @QTY;'
      '        Select @MetricQuantity = @QTY * 2;'
      '        Select @MetricDecimalQuantity = (@QTY * 2) * 100;'
      #9#9'if @PRICE_TABLE_ID >= 0'
      #9#9'begin'#9#9' '
      
        #9#9'  Execute GET_PRICE_TABLE_VALUE @PRICE_TABLE_ID, @INV_RBP, @Re' +
        'tailPrice, @NEW_AWP = @BillingPrice OUTPUT, @NEW_RetailPrice = @' +
        'RetailPrice OUTPUT, @DispFee = @Disp_Fee OUTPUT;'
      
        #9#9'  Select @GossAmountDue = (@BillingPrice + @DISPFEEADDON + @IN' +
        'CENTIVE_AMOUNT_SUB + @OTHERAMOUNTCLAIMEDSUB + @FLAT_SALES_TAXSUB' +
        ' + @PERCENTAGE_SALES_TAX_SUB);'
      
        #9#9'  Select @UsualCustomary = @GossAmountDue * @USUAL_CUSTOMARY_M' +
        'ULT;'
      #9#9'end;'
      #9'end;'
      ''
      '    if (@TYPE <> '#39'CR'#39') and'
      '    (@TYPE <> '#39'GE'#39') and'
      '    (@TYPE <> '#39'ML'#39') and'
      '    (@TYPE <> '#39'FR'#39') and'
      '    (@TYPE <> '#39'OI'#39') and'
      '    (@TYPE <> '#39'SU'#39') and'
      '    (@TYPE <> '#39'OZ'#39') and'
      '    (@TYPE <> '#39'LQ'#39') and'
      '    (@TYPE <> '#39'PQ'#39') and'
      '    (@TYPE <> '#39'PA'#39') and'
      '    (@TYPE <> '#39'CRE'#39') and'
      '    (@TYPE <> '#39'GEL'#39') and'
      '    (@TYPE <> '#39'SOL'#39') and'
      '    (@TYPE <> '#39'OIN'#39') and'
      '    (@TYPE <> '#39'SUS'#39') and'
      '    (@TYPE <> '#39'LIQ'#39') and'
      '    (@TYPE <> '#39'SYR'#39') and'
      '    (@TYPE <> '#39'ELI'#39') and'
      '    (@TYPE <> '#39'TDM'#39') '
      '    begin'
      
        #9#9'Select @UnitPrice = isNull((1 * (@INV_PRICE /@PackageSize)) / ' +
        '@MetricSize,0);'
      
        #9#9'Select @INV_RBP = isNull((@QTY * (@PrecioaVenderHP / @PackageS' +
        'ize)) / @MetricSize,0);'
      
        #9#9'select @RetailPrice = isNull((@QTY * (@PrecioaVenderCash / @Pa' +
        'ckageSize)) / @MetricSize,0);'
      
        #9#9'Select @Cost = isNull((@QTY * (@INV_COST /'#9'@PackageSize)) /@Me' +
        'tricSize,0);'
      #9#9'Select @MetricQuantity = @QTY;'
      #9'    Select @MetricDecimalQuantity = @QTY * 100;'
      #9#9'if @PRICE_TABLE_ID >= 0'
      #9#9'begin'#9#9' '
      
        #9#9'  Execute GET_PRICE_TABLE_VALUE @PRICE_TABLE_ID, @INV_RBP, @Re' +
        'tailPrice, @NEW_AWP = @BillingPrice OUTPUT, @NEW_RetailPrice = @' +
        'RetailPrice OUTPUT, @DispFee = @Disp_Fee OUTPUT;'
      
        #9#9'  Select @GossAmountDue = (@BillingPrice + @DISPFEEADDON + @IN' +
        'CENTIVE_AMOUNT_SUB + @OTHERAMOUNTCLAIMEDSUB + @FLAT_SALES_TAXSUB' +
        ' + @PERCENTAGE_SALES_TAX_SUB);'
      
        #9#9'  Select @UsualCustomary = @GossAmountDue * @USUAL_CUSTOMARY_M' +
        'ULT;'
      #9#9'end;'
      '    end;'
      ''
      '    if (@TYPE = '#39'CR'#39') or'
      '    (@TYPE = '#39'GE'#39') or'
      '    (@TYPE = '#39'SO'#39') or'
      '    (@TYPE = '#39'FR'#39') or'
      '    (@TYPE = '#39'OI'#39') or'
      '    (@TYPE = '#39'SU'#39') or'
      '    (@TYPE = '#39'CRE'#39') or'
      '    (@TYPE = '#39'GEL'#39') or'
      '    (@TYPE = '#39'SOL'#39') or'
