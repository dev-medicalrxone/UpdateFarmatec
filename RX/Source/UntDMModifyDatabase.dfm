      '           ([TIPO]'
      '           ,[FECHA_EXPIRACION]'
      '           ,[CODIGO]'
      '           ,[COSTO]'
      '           ,[RBP]'
      '           ,[ESPECIAL]'
      '           ,[DEPARTAMENTO]'
      '           ,[LOTE]'
      '           ,[PRECIO]'
      '           ,[COMESPECIAL]'
