        'tion or suspension intended for irrigation purposes.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42980'#39', N'#39'Salve'#39', N'#39'A semi' +
        '-solid composed of a thick fat or wax-based ointment or cerate w' +
        'ith a consistency somewhere between an ointment and a plaster.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45244'#39', N'#39'Semisolid'#39', N'#39'A ' +
