        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'LOG_SURE' +
        'SCRIPTS'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[LOG_SURESCRIPTS]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[MESSAGE_ID] [varchar](50) NULL,'
      #9'[TIME] [datetime] NULL,'
      #9'[TYPIST] [nchar](3) NULL,'
      #9'[NOTE] [varchar](max) NULL,'
      #9'[CODE] [char](1) NULL,'
      ' CONSTRAINT [PK_LOG_SURESCRIPTS] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY] TEXTIMAGE_ON [PRIMARY];'
      
        'ALTER TABLE [dbo].[LOG_SURESCRIPTS] ADD  CONSTRAINT [DF_LOG_SURE' +
        'SCRIPTS_TIME]  DEFAULT (getdate()) FOR [TIME];'
      'END;')
    Left = 4560
    Top = 1104
  end
  object INSERT_Surescripts_LOG: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[INSERT_Surescripts_LOG]'
      '   ON  [dbo].[Surescripts]'
      '   AFTER INSERT,DELETE,UPDATE'
      'AS '
      'declare @Drug varchar(81)'
      'declare @Log_Message varchar(max)'
      'declare @MedicationID int'
      'declare @MessageID varchar(50)'
      'declare @Atendida_por char(3)'
      'declare @PatientID int'
      'declare @PrescriberID int'
      'declare @Rx_Status int'
      'declare @Count int'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9'IF UPDATE(MedicationID) '
      #9'begin'
      
        #9#9'select @Drug = Medication, @MedicationID = MedicationID, @Mess' +
        'ageID = MessageID, @Atendida_por = Atendida_por from inserted;'
      #9#9'if @MedicationID > 0'
      #9#9'begin'
      
        #9#9#9'set @Log_Message = CONCAT('#39'Drug selected: '#39', @Drug, '#39' Product' +
        ' ID: '#39', @MedicationID);'
      
        #9#9#9'EXECUTE SURESCRIPTS_INSERT_LOG @MessageID, @Atendida_por, @Lo' +
        'g_Message, '#39'M'#39';'#9'  '
      #9#9'end;'
      #9'end;'
      #9'if UPDATE(PatientID)'
      #9'begin'
      
        #9#9'select @PatientID = PatientID, @MessageID = MessageID, @Atendi' +
        'da_por = Atendida_por from inserted;'
      #9#9'if @PatientID > 0'
      #9#9'begin'
      
        #9#9#9'set @Log_Message = CONCAT('#39'Patient ID selected: '#39', @PatientID' +
        ');'
      
        #9#9#9'EXECUTE SURESCRIPTS_INSERT_LOG @MessageID, @Atendida_por, @Lo' +
        'g_Message, '#39'M'#39';'#9'  '
      #9#9'end;'
      #9'end;'
      #9'if UPDATE(PrescriberID)'
      #9'begin'
      
        #9#9'select @PrescriberID = PrescriberID, @MessageID = MessageID, @' +
        'Atendida_por = Atendida_por from inserted;'
      #9#9'if @PrescriberID > 0'
      #9#9'begin'
      
        #9#9#9'set @Log_Message = CONCAT('#39'Prescriber ID selected: '#39', @Prescr' +
        'iberID);'
      
        #9#9#9'EXECUTE SURESCRIPTS_INSERT_LOG @MessageID, @Atendida_por, @Lo' +
        'g_Message, '#39'M'#39';'#9'  '
      #9#9'end;'
      #9'end;'
      #9'if UPDATE(Rx_Status)'
      #9'begin'
      
        #9'  Select @Rx_Status = rx_status, @MessageID = MessageID, @Atend' +
        'ida_por = Atendida_por from inserted;'
      #9'  if @Rx_Status = 6'
      #9'  begin'
      #9#9'set @Log_Message = '#39'ePrescribe was canceled'#39';'
      
        #9#9'EXECUTE SURESCRIPTS_INSERT_LOG @MessageID, @Atendida_por, @Log' +
        '_Message, '#39'M'#39';'
      #9'  end;'
      #9'  if @Rx_Status = 1'
      #9'  begin'
      
        #9#9'select @Count = COUNT(*) from LOG_SURESCRIPTS where MESSAGE_ID' +
        ' = @MessageID and rtrim(NOTE) = '#39'ePrescribe was processed'#39';'
      #9#9'if @Count = 0'
      #9#9'begin'
      #9#9#9'set @Log_Message = '#39'ePrescribe was processed'#39';'
      
        #9#9#9'EXECUTE SURESCRIPTS_INSERT_LOG @MessageID, @Atendida_por, @Lo' +
        'g_Message, '#39'M'#39';'
      #9#9'end;'
      #9'  end;'
      #9'end;'
      #9'Commit;'
      'END;')
    Left = 3968
    Top = 1120
  end
