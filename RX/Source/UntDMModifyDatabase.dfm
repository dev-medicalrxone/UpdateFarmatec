      ' @PLAN_MEDICO  char(3),'
      ' @PRODUCT_ID  int,'
      ' @NO_HORA  int,'
      ' @NUMEROPLAN  int,'
      ' @LOTE CHAR(12),'
      ' @BATCH_REFILLREQ_DATE DATE,'
      ' @PRICE_TABLE_ID INTEGER,'
      ' @RX_OTC NCHAR(2),'
      ' @WF_TYPED NCHAR(30),'
      ' @MEZCLA_TRAN_NO int,'
      ' @FACILITY_ID int,'
      ' @FECHAULTIMOREFILL BIT,'
      ' @BATCH_NUMBER_BILLING INT,'
      ' @BATCH_NUMBER INT,'
      ' @INSTANCIA INT, '
      ' @IMPRIMIR BIT,'
      ' @GROSSAMOUNTDUE FLOAT,'
      ' @OTHERAMOUNTCLAIMEDSUBCOUNT int,'
      ' @OTAMCLDSUBCOUNTQUAL nchar(2),'
      ' @OTHERAMOUNTCLAIMEDSUB Float,'
      ' @CLAIM_STATUS INT,'
      ' @TERMINADA BIT,'
      ' @FECHAEXPIRACION DATE,'
      ' @DISPENSINGFEE float,'
      ' @COMPDOSAGE_FORM_DESC_CODE CHAR(2),'
      ' @COMPDISP_UNIT_FORM_INDI CHAR(1),'
      ' @DAW INT,'
      ' @OTHERCOVERAGECODE CHAR(1),'
      ' @ALCHEMY_PRODUCTID int,'
      ' @marketedproductid int,'
      ' @PLANESMEDICOSNO int,'
      ' @MESSAGEID NCHAR(40),'
      ' @OTCCurrent_Identity INT OUTPUT,'
      ' @ADHERENCE BIT,'
      ' @DELIVERY BIT,'
      ' @LEVEL_OF_SERVICE INT,'
      ' @GUID VARCHAR(36),'
      ' @UNIT_PRICE FLOAT,'
      ' @RELATED_OTC_NUMBER INT,'
      ' @PRODUCTSERVIDQUAL char(2),'
      ' @MedRestrict_ID int = 0'
      ')'
      'AS'
      'DECLARE @Current_Identity INTEGER;'
      'DECLARE @NOREFILL INTEGER;'
      'DECLARE @QTY_TO_INSERT FLOAT;'
      'DECLARE @CONTROLADO CHAR(4);'
      'DECLARE @PAPER_CLAIM bit;'
      'DECLARE @ISCONTROLLED BIT;'
      'DECLARE @TIME_RX datetime;'
      'DECLARE @OTCNUMBER INTEGER;'
      'DECLARE @INV_QTY_TODATE DECIMAL(18,2);'
      'DECLARE @SUB_CLARIF_CODE CHAR(2);'
      'DECLARE @MYREFILL_UPDATE_SMARTPICKUP BIT;'
      'SET NOCOUNT ON'
      'BEGIN'
      #9'begin transaction '
      
        #9'SELECT @MYREFILL_UPDATE_SMARTPICKUP = MYREFILL_UPDATE_SMARTPICK' +
        'UP FROM CREDITDEBITSETUP;'
      
        #9'set @TIME_RX = CONVERT(DATETIME, CONVERT(CHAR(8), @FECHAOTC, 11' +
        '2) + '#39' '#39' + CONVERT(CHAR(8), GETDATE(), 108))'
      
        #9'Select @CONTROLADO = CONTROLADO, @INV_QTY_TODATE = QTYINVENTARI' +
        'O FROM INVENTARIOPISO WHERE PRODUCTNO = @PRODUCT_ID;'
      #9'IF (RTRIM(@CONTROLADO) = '#39'RX'#39') or'
      #9'(RTRIM(@CONTROLADO) = '#39'OTC'#39') or'
      
        #9'(RTRIM(@CONTROLADO) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @IS' +
        'CONTROLLED = 1;'
      
        #9'SELECT @PAPER_CLAIM = PAPER_CLAIM, @SUB_CLARIF_CODE = SCC_420_D' +
        'K FROM PLANESMEDICOS WHERE PLANESMEDICOSNO = @PLANESMEDICOSNO;--' +
        'ABREVIATURA = @PLAN_MEDICO;'
      #9'IF @RX_STATUS = '#39'R'#39
      
        #9#9'Select @NOREFILL = count(*) + 1 from OTC where NumeroReceta = ' +
        '@NUMERORECETA and RX_STATUS = '#39'R'#39' AND PLAN_MEDICO <> '#39'CAS'#39' and R' +
        'X_STATUS <> '#39'P'#39
      #9'ELSE'
      #9#9'Select @NOREFILL = 0;'
      #9'IF ( @PLAN_MEDICO = '#39'CAS'#39' ) OR ( @PAPER_CLAIM = 1 )'
      #9#9'Select @QTY_TO_INSERT = @QTY'
      #9'else'
      #9#9'Select @QTY_TO_INSERT = 0;'
      '        if @RX_STATUS = '#39'C'#39
      ' '#9'begin'
      
        #9'  SELECT @OTCNUMBER =  MAX(OTCNUMBER) FROM OTC  where numerorec' +
        'eta = @NUMERORECETA; '
      
        #9'  select @NOREFILL = CODIGOREFILLNUEVO FROM OTC WHERE OTCNUMBER' +
        ' = @OTCNUMBER; '
      #9'end;'
      
        #9'INSERT INTO OTC (NDC, MEDICAMENTO, TOTAL, ATENDIDOPOR, COBRADO,' +
        ' FECHAOTC,'
      
        #9'NUMERORECETA, RX, COSTOVENTA, QTY, QTY_TEMP, METRICDECIMALQUANT' +
        'ITY, NUMEROCLIENTE, MEDICAMENTOMIX,  NUMEROTRANSACCION,'
      
        #9'PAGO_PLAN, DEDUCIBLE, NUMERO_AUTORIZACION, PARTIAL_COMPLETION, ' +
        'RX_STATUS, NO_REF_DISPENSADO,'
      
        #9'INGREDIENT_COST_PAID, INCENTIVE_FEE_PAID, DISPENSING_FEE_PAID, ' +
        'OTHER_AMOUNT_PAID, AMOUNT_COPAY_COINS,'
      
        #9'GANANCIA, PHARMACIST, DAYS_SUPPLY, PAGADA, PRECIOFACTURACION, P' +
        'LAN_MEDICO, PRODUCT_ID,'
      
        #9'NO_HORA, NUMEROPLAN, TIME_RX, LOTE, SIGNATURE_LINK, BATCH_REFIL' +
        'LREQ_DATE, PRICE_TABLE_ID, WF_TYPED,'
      
        #9'MEZCLA_TRAN_NO,FACILITY_ID, BATCH_NUMBER_BILLING, INSTANCIA, TE' +
        'RMINADA, IMPRIMIR, BATCH_NUMBER, GROSSAMOUNTDUE, CODIGOREFILLNUE' +
        'VO,'
      
        #9'OTHERAMOUNTCLAIMEDSUBCOUNT, OTAMCLDSUBCOUNTQUAL, OTHERAMOUNTCLA' +
        'IMEDSUB, CLAIM_STATUS, FECHAEXPIRACION, DISPENSINGFEE,'
      
        #9'COMPDOSAGE_FORM_DESC_CODE, COMPDISP_UNIT_FORM_INDI, DAW, OTHERC' +
        'OVERAGECODE, ALCHEMY_PRODUCTID, MARKETEDPRODUCTID, PLANESMEDICOS' +
        'NO, CONTROLADO, '
      
        #9'MessageID, RECORD_LOCKED, ADHERENCE, DELIVERY, LEVELOFSERVICE, ' +
        'GUID, UNIT_PRICE, INV_QTY_TODATE, RELATED_OTC_NUMBER, PRODUCTSER' +
        'VIDQUAL, MedRestrict_ID)'
      
        #9'Values (@NDC,@MEDICAMENTO,@TOTAL,@ATENDIDOPOR,@COBRADO,@FECHAOT' +
        'C,'
      
        #9'@NUMERORECETA,@RX,@COSTOVENTA, @QTY_TO_INSERT,@QTY, (@QTY * 100' +
        '0), @NUMEROCLIENTE,@MEDICAMENTOMIX,@NUMEROTRANSACCION,'
      
        #9'@PAGO_PLAN,@DEDUCIBLE,@NUMERO_AUTORIZACION,@PARTIAL_COMPLETION,' +
        '@RX_STATUS,@NO_REF_DISPENSADO,'
      
        #9'@INGREDIENT_COST_PAID,@INCENTIVE_FEE_PAID,@DISPENSING_FEE_PAID,' +
        '@OTHER_AMOUNT_PAID,@AMOUNT_COPAY_COINS,'
      
        #9'@GANANCIA,@PHARMACIST,@DAYS_SUPPLY,@PAGADA,@PRECIOFACTURACION,@' +
        'PLAN_MEDICO,@PRODUCT_ID,'
      
        #9'@NO_HORA, @NUMEROPLAN, @TIME_RX, @LOTE, 1, @TIME_RX, @PRICE_TAB' +
        'LE_ID, @WF_TYPED,'
      
        #9'@MEZCLA_TRAN_NO, @FACILITY_ID, @BATCH_NUMBER_BILLING, @INSTANCI' +
        'A, @TERMINADA, @IMPRIMIR, @BATCH_NUMBER, @GROSSAMOUNTDUE, @NOREF' +
        'ILL,'
      
        #9'@OTHERAMOUNTCLAIMEDSUBCOUNT, @OTAMCLDSUBCOUNTQUAL, @OTHERAMOUNT' +
        'CLAIMEDSUB, 0, @FECHAEXPIRACION, @DISPENSINGFEE,'
      
        #9'@COMPDOSAGE_FORM_DESC_CODE, @COMPDISP_UNIT_FORM_INDI, @DAW, @OT' +
        'HERCOVERAGECODE, @ALCHEMY_PRODUCTID, @marketedproductid, @PLANES' +
        'MEDICOSNO, LTRIM(@CONTROLADO), '
      
        #9'@MESSAGEID, 0, @ADHERENCE, @DELIVERY, @LEVEL_OF_SERVICE, @GUID,' +
        ' @UNIT_PRICE, @INV_QTY_TODATE, @RELATED_OTC_NUMBER, @PRODUCTSERV' +
        'IDQUAL, isNull(@MedRestrict_ID,0));'
      
        #9'--IF @FECHAULTIMOREFILL = 1 UPDATE PRESCRIPTIONS SET FECHAULTIM' +
        'OREFILL = GETDATE() WHERE NUMERORECETA = @NUMERORECETA;'
      #9'set @OTCCurrent_Identity = SCOPE_IDENTITY();'#9
      #9'if rtrim(@SUB_CLARIF_CODE) > '#39#39
      #9'begin'
      
        #9'  insert into SUB_CLARIFICATION_CODE (SCC_420_DK, NUMERORECETA,' +
        ' OTCNUMBER) values (@SUB_CLARIF_CODE, @NUMERORECETA, @OTCCurrent' +
        '_Identity);'
      #9'end;'#9
      #9'IF @MYREFILL_UPDATE_SMARTPICKUP = 0'
      #9'begin'
      #9#9'EXEC RX_UPDATE_REFILL_QUERY @NUMERORECETA; '
      #9'end;'
      
        #9'EXECUTE INSERT_LOG '#39'RX DETAIL CREATED '#39', '#39'A'#39', @NDC, @ATENDIDOPO' +
        'R, @PHARMACIST, @NUMERORECETA, @OTCCurrent_Identity, 0,@NUMEROCL' +
        'IENTE,0,@PLANESMEDICOSNO,@NUMEROPLAN,@PRODUCT_ID,'#39'R'#39','#39#39',@ISCONTR' +
        'OLLED,1;'
      #9'commit;'
      'end;')
    Left = 1000
    Top = 216
  end
  object INSERT_PRINT_Q: TFDQuery
    AfterExecute = INSERT_PRINT_QAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INSERT_PRINT_Q] @RX_ID BIGINT, @COPIES I' +
        'NT, @RX_OTC NCHAR(3), '
      
        '@LABEL_NAME NCHAR(50), @TYPIST nchar(4), @PRINTTOSCREEN BIT, @PA' +
        'TIENT NCHAR(45), @INDICATIONS NCHAR(296),'
      
        '@PRINTER_ID NCHAR(1), @PRINT_TYPE INT, @TRANS_NO INT, @TRANS_TYP' +
        'E NCHAR(4), @FINAL_RECEIPT BIT, @EMAIL NCHAR(80),'
      
        '@MOBILE_PHONE NCHAR(10), @CUSTOMER_NUMBER INT, @DELIVERY BIT, @Q' +
        'UOTE BIT, @PRINT_PAT_EDU BIT, @PRINTER_IP NCHAR(15)'
      'AS'
      'DECLARE @USER CHAR(3)'
      'SET NOCOUNT ON'
      'begin'
      '  begin transaction'
      '    SELECT @USER = SUBSTRING(@TYPIST,1,3);'
      '    INSERT INTO [dbo].[PRINT_QUERIES]'
      #9#9'([RX_ID]'
      #9#9',[COPIES]'
      #9#9',[RX_OTC]'
      #9#9',[LABEL_NAME]'
      #9#9',[TYPIST]'
      #9#9',[PRINTTOSCREEN]'
      #9#9',[PATIENT]'
      #9#9',[INDICATIONS]'
      #9#9',[PRINTER_ID]'
      #9#9',[PRINT_TYPE]'
      #9#9',[TRANSACTION_NUMBER]'
      #9#9',[TRANS_TYPE]'
      #9#9',[FINAL_RECEIPT]'
      #9#9',[EMAIL]'
      #9#9',[MOBILE_PHONE]'
      #9#9',[CUSTOMER_NUMBER]'
      #9#9',[DELIVERY]'
      #9#9',[QUOTE]'
      #9#9',[PRINT_PATIENT_EDUCATION]'
      #9#9',[PRINTER_IP])'
      '     VALUES'
      
        '        (@RX_ID,@COPIES,@RX_OTC,@LABEL_NAME,@TYPIST, @PRINTTOSCR' +
        'EEN, @PATIENT, @INDICATIONS, @PRINTER_ID, '
      
        #9#9'@PRINT_TYPE, @TRANS_NO, @TRANS_TYPE, @FINAL_RECEIPT, @EMAIL, @' +
        'MOBILE_PHONE, @CUSTOMER_NUMBER, '
      #9#9'@DELIVERY, @QUOTE, @PRINT_PAT_EDU, @PRINTER_IP);'
      '  commit;'
      'end;')
    Left = 1008
    Top = 312
  end
  object INSERT_RESPONSE: TFDQuery
    AfterExecute = INSERT_RESPONSEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INSERT_RESPONSE] @NORX BIGINT,  @RESPUES' +
        'TA_STR VARCHAR(MAX),  @TYPIST NCHAR(3), @OTCNUMBER INTEGER'
