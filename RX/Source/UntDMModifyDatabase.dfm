        '@DAYS_SUPPLY INT, @COMPOUNDCODE INT, @FECHARECETA DATE, @FECHAOT' +
        'C DATE, @NUMEROREFILLSAUTORIZADOS INT,'
      
        '@CANTIDADRECETADA FLOAT, @SPECIAL_PACK_INDI_429_DT NCHAR(2), @OR' +
        'G_PRES_PROD_SIDQ CHAR(2),'
      
        '@ORG_PROS_PROD_SERVID CHAR(2), @ORG_PRESC_QTY INT, @SPIDN_454_EK' +
        ' NCHAR(12), '
      
        '@PRIOR_AUTH_TYPE_CODE CHAR(1), @IATID_463_EW NCHAR(2), @IAID_464' +
        '_EX NCHAR(11), @DISPENSING_STATUS NCHAR(1),'
      
        '@QTY_INTENDED_DISP INT, @DAYS_SUPPLY_INTEND_DISP INT, @DRC_357_N' +
        'V NCHAR(2), @PAI_391_MT NCHAR(2),'
      
        '@ROUTEOFADMIN_995_E2 NCHAR(11), @COMPOUND_TYPE_996_G1 NCHAR(2), ' +
        '@ASSOC_RX_SERVICE_REF_NO NCHAR(7), '
      '@ASSOC_RX_SERVICE_DATE DATE'
      'AS'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        '    UPDATE OTC SET RXNUMBERSRNQ = @RXNUMBERSRNQ, PRODUCTSERVIDQU' +
        'AL = @PRODUCTSERVIDQUAL, NDC = @NDC, DAW = @DAW,'
      
        '    OTHERCOVERAGECODE = @OTHERCOVERAGECODE, UNIT_OF_MEASURE = @U' +
        'NIT_OF_MEASURE, LEVELOFSERVICE = @LEVELOFSERVICE,'
      
        #9'PRIORAUTHORIZATION = @PRIORAUTHORIZATION, PST_147_U7 = @PST_147' +
        '_U7, CODIGOREFILLNUEVO = @CODIGOREFILLNUEVO,'
      
        #9'DAYS_SUPPLY = @DAYS_SUPPLY, FECHAOTC = @FECHAOTC, SPECIAL_PACK_' +
        'INDI_429_DT = @SPECIAL_PACK_INDI_429_DT,'
      
        #9'ORG_PRES_PROD_SIDQ = @ORG_PRES_PROD_SIDQ, ORG_PROS_PROD_SERVID ' +
        '= @ORG_PROS_PROD_SERVID, ORG_PRESC_QTY = @ORG_PRESC_QTY,'
      
        #9'SPIDN_454_EK = @SPIDN_454_EK, PRIOR_AUTH_TYPE_CODE = @PRIOR_AUT' +
        'H_TYPE_CODE, IATID_463_EW = @IATID_463_EW,'
      
        #9'IAID_464_EX = @IAID_464_EX, DISPENSING_STATUS = @DISPENSING_STA' +
        'TUS, QTY_INTENDED_DISP = @QTY_INTENDED_DISP,'
      
        #9'DAYS_SUPPLY_INTEND_DISP = @DAYS_SUPPLY_INTEND_DISP, DRC_357_NV ' +
        '= @DRC_357_NV,PAI_391_MT = @PAI_391_MT,'
      
        '       ROUTEOFADMIN_995_E2 = @ROUTEOFADMIN_995_E2, COMPOUND_TYPE' +
        '_996_G1 = @COMPOUND_TYPE_996_G1, '
      
        #9'ASSOC_RX_SERVICE_REF_NO = @ASSOC_RX_SERVICE_REF_NO, ASSOC_RX_SE' +
        'RVICE_DATE = @ASSOC_RX_SERVICE_DATE'
      #9'WHERE OTCNUMBER  = @OTCNUMBER'
      #9'COMMIT'
      #9'BEGIN TRANSACTION'
      
        #9'UPDATE PRESCRIPTIONS SET RXORIGINCODE = @RXORIGINCODE, COMPOUND' +
        'CODE = @COMPOUNDCODE, FECHARECETA = @FECHARECETA,'
      
        #9'NUMEROREFILLSAUTORIZADOS = @NUMEROREFILLSAUTORIZADOS, CANTIDADR' +
        'ECETADA = @CANTIDADRECETADA '
