  object QUpdateOTC: TFDQuery
    AfterExecute = QUpdateOTCAfterExecute
    Connection = FDConnection1
    Left = 2480
    Top = 112
  end
  object UPDATE_PRESCRIPTION_ALL: TFDQuery
    AfterExecute = UPDATE_PRESCRIPTION_ALLAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE  PROCEDURE [dbo].[UPDATE_PRESCRIPTION_ALL] '
      #9'  (@FECHARECETA NCHAR(11),'
      #9'  @LICENCIA VARCHAR(15),'
      #9'  @PRESCRIBERIDQUALIFIER VARCHAR(2),'
      #9'  @RXORIGINCODE VARCHAR(1),'
      #9'  @NUMEROCLIENTE INT,'
      #9'  @SPI NCHAR(13),'
      #9'  @BATCH_NUMBER_BILLING INT,'
      #9'  @NUMERODOCTOR INT,'
      #9'  @NOPATPLAN INT,'
      #9'  @PM CHAR(3),'
      #9'  @LABEL_NAME NCHAR(20),'
      #9'  @CLAIM_STATUS INT, '
      #9'  @PLANESMEDICOSNO INT,'
      #9'  @PRICE_TABLE_ID INT,'
      #9'  @IMPRIMIR BIT,'
      #9'  @IMPRIMIR_BLISTER BIT)'
      'AS'
      'DECLARE @OTCNUMBER INT'
      'DECLARE @QTY float'
      'DECLARE @PRODUCT_ID INT'
      'DECLARE @UNIT_PRICE float'
      'DECLARE @Retail_Price float'
      'DECLARE @Usual_Customary float'
      'DECLARE @Cost_ float'
      'DECLARE @Metric_Quantity float'
      'DECLARE @Metric_DecimalQuantity float'
      'DECLARE @Billing_Price float'
      'DECLARE @DISPENSINGFEE float'
      'DECLARE @GrossAmount_Due float'
      'DECLARE @PRICE_TABLE_ID_OLD INT'
      'DECLARE @RECORD_COUNT INT'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    IF @BATCH_NUMBER_BILLING > 0'
      '    begin'
      '        begin transaction'
      
        #9#9'    SELECT @RECORD_COUNT = COUNT(*) FROM OTC WHERE BATCH_NUMBE' +
        'R_BILLING = @BATCH_NUMBER_BILLING;'
      #9#9#9'--IF @RECORD_COUNT > 1'
      #9#9#9'--begin'
      
        #9#9#9'--  SELECT @PRICE_TABLE_ID_OLD = PRICE_TABLE_ID FROM OTC WHER' +
        'E BATCH_NUMBER_BILLING = @BATCH_NUMBER_BILLING and PRICE_TABLE_I' +
        'D <> @PRICE_TABLE_ID;'
      #9#9#9'--end;'
      #9#9#9'UPDATE PRESCRIPTIONS SET '
      #9#9#9'FECHARECETA = @FECHARECETA, '
      
        #9#9#9'LICENCIA = @LICENCIA, PRESCRIBERIDQUALIFIER = @PRESCRIBERIDQU' +
        'ALIFIER,'
      
        #9#9#9'RXORIGINCODE = @RXORIGINCODE, NUMEROCLIENTE = @NUMEROCLIENTE,' +
        ' SPI = @SPI,  '
      
        #9#9#9'NUMERODOCTOR = @NUMERODOCTOR, BATCH_NUMBER = @BATCH_NUMBER_BI' +
        'LLING'
      #9#9#9'WHERE BATCH_NUMBER = @BATCH_NUMBER_BILLING;'
      
        #9#9#9'IF (@RECORD_COUNT > 1) -- and  (@PRICE_TABLE_ID_OLD <> @PRICE' +
        '_TABLE_ID)'
      #9#9#9'begin'
      
        #9#9#9#9'DECLARE MyCursor CURSOR FOR SELECT OTCNUMBER, QTY_TEMP, PROD' +
        'UCT_ID from OTC where BATCH_NUMBER_BILLING = @BATCH_NUMBER_BILLI' +
        'NG;'
      #9#9#9#9'OPEN MyCursor'
      #9#9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9#9'INTO @OTCNUMBER, @QTY, @PRODUCT_ID '
      #9#9#9#9'WHILE @@FETCH_STATUS = 0'
      #9#9#9#9'BEGIN'
      
        #9#9#9#9#9'EXEC dbo.RX_CALCULATE_PRICE @OTCNUMBER, @PRODUCT_ID, @QTY, ' +
        '@PRICE_TABLE_ID, '
      #9#9#9#9#9'@UnitPrice = @UNIT_PRICE OUTPUT, '
      #9#9#9#9#9'@RetailPrice = @Retail_Price OUTPUT,'
      #9#9#9#9#9'@UsualCustomary = @Usual_Customary OUTPUT,'
      #9#9#9#9#9'@Cost = @Cost_ OUTPUT,'
      #9#9#9#9#9'@MetricQuantity = @Metric_Quantity,'
      #9#9#9#9#9'@MetricDecimalQuantity = @Metric_DecimalQuantity OUTPUT, '
      #9#9#9#9#9'@BillingPrice = @Billing_Price OUTPUT,'
      #9#9#9#9#9'@Disp_Fee = @DISPENSINGFEE OUTPUT,'
      #9#9#9#9#9'@GossAmountDue = @GrossAmount_Due OUTPUT;'#9#9'    '
      #9#9#9#9#9'IF @PM <> '#39'CAS'#39' SET @QTY = 0;'
      #9#9#9#9#9
      #9#9#9#9#9'UPDATE OTC SET NUMEROCLIENTE = '
      #9#9#9#9#9'@NUMEROCLIENTE, PLAN_MEDICO = @PM, '
      #9#9#9#9#9'PLANESMEDICOSNO = @PLANESMEDICOSNO, '
      #9#9#9#9#9'IMPRIMIR = @IMPRIMIR,'
      #9#9#9#9#9'NUMEROPLAN = @NOPATPLAN, '
      #9#9#9#9#9'LABEL_NAME = @LABEL_NAME, '
      #9#9#9#9#9'CLAIM_STATUS = @CLAIM_STATUS, '
      #9#9#9#9#9'PRICE_TABLE_ID = @PRICE_TABLE_ID,'
      #9#9#9#9#9'UNIT_PRICE = @UNIT_PRICE, '
      #9#9#9#9#9'TOTAL = @Usual_Customary, -- @Retail_Price, '
      #9#9#9#9#9'COSTOVENTA = @Cost_,'
      #9#9#9#9#9'PRECIOFACTURACION = @Billing_Price, '
      #9#9#9#9#9'DISPENSINGFEE = @DISPENSINGFEE, '
      #9#9#9#9#9'GROSSAMOUNTDUE = @GrossAmount_Due,'#9#9#9#9#9
      #9#9#9#9#9'QTY = @QTY'
      #9#9#9#9#9'WHERE OTCNUMBER = @OTCNUMBER; '#9#9#9#9#9
      #9#9#9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9#9#9'INTO @OTCNUMBER, @QTY, @PRODUCT_ID;'#9#9#9#9#9
      #9#9#9#9'END'
      #9#9#9#9'CLOSE MyCursor'
      #9#9#9#9'DEALLOCATE MyCursor'
      #9#9#9'end'
      #9#9#9'else'
      #9#9#9'begin'
      
        #9#9#9#9'UPDATE OTC SET NUMEROCLIENTE = @NUMEROCLIENTE, PLAN_MEDICO =' +
        ' @PM, PLANESMEDICOSNO = @PLANESMEDICOSNO, IMPRIMIR = @IMPRIMIR,'
      
        #9#9#9#9'NUMEROPLAN = @NOPATPLAN, LABEL_NAME = @LABEL_NAME, CLAIM_STA' +
        'TUS = @CLAIM_STATUS '
      #9#9#9#9'--PRICE_TABLE_ID = @PRICE_TABLE_ID '
      
        #9#9#9#9'WHERE BATCH_NUMBER_BILLING = @BATCH_NUMBER_BILLING and CLAIM' +
        '_STATUS <> 1;'
      #9#9#9'end;'
      '        commit transaction;'
      '    end;'
      'END;')
    Left = 2488
    Top = 200
  end
