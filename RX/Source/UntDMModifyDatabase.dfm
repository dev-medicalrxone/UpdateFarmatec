      'CREATE TABLE [dbo].[RXDATA]('
      #9'[PHAR_NO] [int] NULL,'
      #9'[PHAR_ZIP] [varchar](9) NULL,'
      #9'[RX_NO] [int] NULL,'
      #9'[HIN] [varchar](9) NULL,'
