        '_CLASSIFICATION'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[CUSTOMER_CLASSIFICATION]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[CLIENT_CASSIFICATION] [nchar](20) NULL,'
      ' CONSTRAINT [PK_CUSTOMER_CLASSIFICATION] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY]'
      'END;')
    Left = 5192
    Top = 1120
  end
  object QUICK_RX_ADD_NEWRX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE  PROCEDURE [dbo].[QUICK_RX_ADD_NEWRX] @PATIENT_ID INT, @P' +
        'RESCRIBER_ID INT, @WF_TYPED NCHAR(30), '
      
        '@INSTANCIA INT, @RXDATE DATE, @LEVELOFSERVICE INT, @GUID VARCHAR' +
        '(36) OUTPUT, @PRICE_TABLE_ID int, '
      '@QUICK_RX_ID INT, @TYPIST CHAR(3), @OTCNUMBER INT'
      'AS'
      'DECLARE @PAT_NOPLAN INT '
      'DECLARE @BATCH_NUMBER_LOCAL INT '
      'DECLARE @MEDICATION_ID INT'
      'DECLARE @NPI NCHAR(15)'
      'DECLARE @PRESCRIBER_ID_QUALIFIER CHAR(2)'
      'DECLARE @MESSAGE_ID VARCHAR(40)'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @QTY DECIMAL(18,2)'
      'DECLARE @NumberOfRefills INT'
      'DECLARE @Medication VARCHAR(30)'
      'DECLARE @COMPOUND INT'
      'DECLARE @NDC CHAR(11)'
      'DECLARE @ETIQUETA NCHAR(296)'
      'DECLARE @SIG NCHAR(296)'
      'DECLARE @LOTE CHAR(12)'
      'DECLARE @FACILITY_ID INT'
      'DECLARE @CLAIM_STATUS INT'
      'DECLARE @PLANMEDICO CHAR(3)'
      'DECLARE @TERMINADA BIT'
      'DECLARE @NUMEROAUTO CHAR(20)'
      'DECLARE @FECH_EXPI DATE'
      'DECLARE @ALCHAMY_ID INT'
      'DECLARE @LABELSCODENO INT'
      'DECLARE @NORX_LOCAL BIGINT'
      'DECLARE @OTCNUMBER_LOCAL INT'
      'DECLARE @UNIT_PRICE DECIMAL(18,2)'
      'DECLARE @Retail_Price DECIMAL(18,2)'
      'DECLARE @Usual_Customary DECIMAL(18,2)'
      'DECLARE @Cost_ DECIMAL(18,2)'
      'DECLARE @Billing_Price DECIMAL(18,2)'
      'DECLARE @DISPENSINGFEE DECIMAL(18,2)'
      'DECLARE @GrossAmount_Due DECIMAL(18,2)'
      'DECLARE @Metric_Quantity DECIMAL(18,2)'
      'DECLARE @Metric_DecimalQuantity DECIMAL(18,2)'
      'DECLARE @NO_HORA INT'
      'DECLARE @NO_RECORDS INT'
      'DECLARE @CONTROLLED CHAR(4) '
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @EXTRA_INFO VARCHAR(MAX)'
      'DECLARE @OTC_DATE VARCHAR(10)'
      'DECLARE @STRENGTH CHAR(25)'
      'DECLARE @ADHERENCE BIT'
      'DECLARE @DELIVERY BIT'
      'DECLARE @DAYS_SUPPLY INT'
      'DECLARE @DAW INT'
      'DECLARE @NO_RX BIGINT'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9#9'SET @MESSAGE_ID = '#39#39';'
      #9#9'SET @NumberOfRefills = 0;'
      #9#9'SELECT @NO_HORA = FORMAT(getdate(), '#39'HH'#39');'
      ''
      
        #9#9'SELECT @NO_RECORDS = COUNT(*) FROM PATPLAN WHERE NUMEROCLIENTE' +
        ' = @PATIENT_ID AND INSURANCE_INDEX = 1;'
      #9#9'IF @NO_RECORDS > 0'
      #9#9'begin'#9#9'  '
      
        #9#9'  SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = isnull(NUMERO' +
        'PLAN,0) FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND INSUR' +
        'ANCE_INDEX = 1;'
      #9#9'end'
      #9#9'else'
      #9#9'begin'#9#9'  '
      
        #9#9'  SELECT @NO_RECORDS = COUNT(*) FROM PATPLAN WHERE NUMEROCLIEN' +
        'TE = @PATIENT_ID AND PLANMEDICO <> '#39'CAS'#39' and ACTIVO = 1;   '
      #9#9'  if @NO_RECORDS > 0'
      
        #9#9'    SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = NUMEROPLAN ' +
        'FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND PLANMEDICO <>' +
        ' '#39'CAS'#39' and ACTIVO = 1;'
      #9#9'  else'
      
        #9#9'    SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = NUMEROPLAN ' +
        'FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND PLANMEDICO = ' +
        #39'CAS'#39'; '
      #9#9'end;'
      #9#9'IF @PLANMEDICO = '#39'CAS'#39' '
      #9#9'begin'
      #9#9'  SET @CLAIM_STATUS = 0;'
      #9#9'  SET @TERMINADA = 1;'
      #9#9'  SET @NUMEROAUTO = '#39'N/A'#39';'
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      #9#9'  SET @CLAIM_STATUS = 5;'
      #9#9'  SET @TERMINADA = 0;'
      #9#9'  SET @NUMEROAUTO = '#39#39';'#9'  '
      #9#9'end;'
      ''
      
        #9#9'SELECT @FACILITY_ID = FACILITY_ID, @ADHERENCE = ISNULL(ADHEREN' +
        'CE,0), @DELIVERY = ISNULL(DELIVERY,0) FROM PACIENTES WHERE NUMER' +
        'OCLIENTE = @PATIENT_ID;'
      #9#9'if (@LEVELOFSERVICE = 2) '
      #9#9'begin'
      #9#9'  set @DELIVERY = 1;'
      #9#9'end;'#9#9
      #9#9'IF @OTCNUMBER = 0'
      #9#9'BEGIN'
      
        #9#9'  SELECT @MEDICATION_ID = PRODUCT_ID, @QTY = Qty, @PRESCRIBER_' +
        'ID = PRESCRIBER_ID, @LABELSCODENO = LABELCODESNO, @DAYS_SUPPLY =' +
        ' DAYS_SUPPLY, @DAW = DAW'
      #9#9'  from QUICK_RX where ID = @QUICK_RX_ID;'
      '        END'
      #9#9'ELSE'
      #9#9'BEGIN'
      
        #9#9'  SELECT @MEDICATION_ID = PRODUCT_ID, @QTY = Qty, @NO_RX = NUM' +
        'ERORECETA,  @DAYS_SUPPLY = DAYS_SUPPLY, @DAW = DAW'
      #9#9'  from OTC where OTCNUMBER = @OTCNUMBER;'#9
      
        #9#9'  SELECT @PRESCRIBER_ID = NUMERODOCTOR, @LABELSCODENO = LABELC' +
        'ODESNO, @ETIQUETA = ETIQUETA, @SIG = SIG FROM PRESCRIPTIONS WHER' +
        'E NUMERORECETA = @NO_RX;'
      #9#9'END;'
      ''
      
        #9#9'SELECT @NPI = NPI, @PRESCRIBER_ID_QUALIFIER = PRESCRIBER_ID_QU' +
        'ALIFIER FROM DOCTOR WHERE NUMERODOCTOR = @PRESCRIBER_ID;'
      #9#9'if @GUID  = '#39#39
      #9#9'begin'
      #9#9'  SELECT @GUID = NEWID();  '#9
      #9#9'end'#9
      #9#9'if @LABELSCODENO > 0'
      #9#9'begin'
      
        #9#9#9'SELECT @ETIQUETA = RTRIM(SPANISH), @SIG = RTRIM(CODIGOS) FROM' +
        ' LABELCODES WHERE LABELCODESNO = @LABELSCODENO;'
      #9#9'end;'
      
        #9#9'SELECT @Medication = UPPER(substring(DESCRIPCION,1,30)), @STRE' +
        'NGTH = STRENGTH, @NDC = NDC, @LOTE = LOTE, @FECH_EXPI = FECHA_EX' +
        'PIRACION, @ALCHAMY_ID = ALCHEMY_PRODUCTID, @CONTROLLED = CONTROL' +
        'ADO FROM INVENTARIOPISO WHERE PRODUCTNO = @MEDICATION_ID;'
      #9#9'IF rtrim(@STRENGTH) > '#39#39
      #9#9'begin'
      
        #9#9#9'Set @Medication = CONCAT(rtrim(@Medication), '#39' '#39', rtrim(@STRE' +
        'NGTH));  '
      #9#9#9'--Set @Medication = SUBSTRING(@Medication, 1,30); '
      #9#9'end;'
      
        #9#9'IF RTRIM(@CONTROLLED) = '#39'RX'#39' SET @ISCONTROLLED = 0 ELSE SET @I' +
        'SCONTROLLED = 1;'
      #9#9'SET @COMPOUND = 1;'
      #9#9'IF @NDC = '#39'00000000000'#39' '
      #9#9'begin'
      #9#9#9'SET @COMPOUND = 2;'
      #9#9'end;'
      #9#9#9
      #9#9'INSERT INTO PRESCRIPTIONS (NUMEROCLIENTE, NUMERODOCTOR,'
      #9#9'NUMEROREFILLSAUTORIZADOS, MEDICAMENTO, PRESCRIBERIDQUALIFIER,'
      
        #9#9'MessageID, FECHARECETA, CANTIDADRECETADA, COMPOUNDCODE, PRODUC' +
        'T_ID,'
      
        #9#9'NDC, LABELCODESNO, ETIQUETA, SIG, DAYS_SUPPLY, GUID, INFORMACI' +
        'ON_EXT,'
      #9#9'RXORIGINCODE, SCANED_RX_LINK, LICENCIA, SPI) '
      #9#9'VALUES '
      #9#9'(@PATIENT_ID, @PRESCRIBER_ID, '
      #9#9'@NumberOfRefills, @Medication, @PRESCRIBER_ID_QUALIFIER, '
      #9#9'@MESSAGE_ID, @RXDATE, @QTY, @COMPOUND, @MEDICATION_ID,'
      
        #9#9'@NDC, @LABELSCODENO, @ETIQUETA, @SIG, @DAYS_SUPPLY, @GUID, @EX' +
        'TRA_INFO, '
      #9#9'1, 0, @NPI, @SPI);'
      #9#9'SET @NORX_LOCAL=SCOPE_IDENTITY();'
      ''
      #9#9'/* PRICE SECTION */'
      
        #9#9'EXEC dbo.RX_CALCULATE_PRICE 0, @MEDICATION_ID, @QTY, @PRICE_TA' +
        'BLE_ID, '
      #9#9'@UnitPrice = @UNIT_PRICE OUTPUT, '
      #9#9'@RetailPrice = @Retail_Price OUTPUT,'
      #9#9'@UsualCustomary = @Usual_Customary OUTPUT,'
      #9#9'@Cost = @Cost_ OUTPUT,'
      #9#9'@MetricQuantity = @Metric_Quantity,'
      #9#9'@MetricDecimalQuantity = @Metric_DecimalQuantity OUTPUT, '
      #9#9'@BillingPrice = @Billing_Price OUTPUT,'
      #9#9'@Disp_Fee = @DISPENSINGFEE OUTPUT,'
      #9#9'@GossAmountDue = @GrossAmount_Due OUTPUT;'
      ''
      
        #9#9'if @PLANMEDICO = '#39'CAS'#39' Select @Usual_Customary = @Retail_Price' +
        ';'
      #9#9'/* */'
      #9#9'SELECT @OTC_DATE = CONVERT(VARCHAR, GETDATE(), 101);'
      
        #9#9'EXEC INSERT_OTC @NDC, @MEDICATION, @Usual_Customary, @TYPIST, ' +
        #39'F'#39', @OTC_DATE, @NORX_LOCAL, '#39#39', @Cost_, @QTY, @PATIENT_ID, '#39#39',0' +
        ',0,0,'
      
        #9#9'@NUMEROAUTO,'#39#39','#39'N'#39',0,0,0,0,0,0,0,'#39#39',@DAYS_SUPPLY, '#39'F'#39', @Billin' +
        'g_Price, @PLANMEDICO, @MEDICATION_ID,@NO_HORA, @PAT_NOPLAN, @LOT' +
        'E, '#39'01/01/2020'#39', '
      
        #9#9'@PRICE_TABLE_ID,'#39#39',@WF_TYPED, 0, @FACILITY_ID, 0, 0, @BATCH_NU' +
        'MBER_LOCAL, '
      
        #9#9'@INSTANCIA, 1,@GrossAmount_Due, 0, '#39#39', 0, @CLAIM_STATUS, @TERM' +
        'INADA, @FECH_EXPI, @DISPENSINGFEE,'#39#39','#39#39', @DAW,'#39'0'#39','
      
        #9#9'@ALCHAMY_ID,0,@MESSAGE_ID, @OTCCurrent_Identity = @OTCNUMBER_L' +
        'OCAL OUTPUT, '
      
        #9#9'@ADHERENCE = @ADHERENCE, @DELIVERY = @DELIVERY, @LEVEL_OF_SERV' +
        'ICE = @LEVELOFSERVICE, @GUID = @GUID, @UNIT_PRICE = @UNIT_PRICE;' +
        #9#9#9
      #9#9'DELETE FROM OTC WHERE GUID = @GUID AND NDC = '#39#39';'
      #9#9'IF @OTCNUMBER > 0'
      #9#9'BEGIN'
      
        #9#9#9'UPDATE PRESCRIPTIONS SET NUMERODOCTOR = @PRESCRIBER_ID, LICEN' +
        'CIA = @NPI, SPI = @SPI, PRESCRIBERIDQUALIFIER = @PRESCRIBER_ID_Q' +
        'UALIFIER  WHERE GUID  = @GUID;'
      #9#9'END;'
      
        #9#9'EXECUTE INSERT_LOG '#39'QuickRx Annotated'#39', '#39'A'#39', @NDC, @TYPIST,  '#39 +
        #39', @NORX_LOCAL, @OTCNUMBER_LOCAL, @PRESCRIBER_ID, @PATIENT_ID,0,' +
        '0,0,@MEDICATION_ID,'#39'R'#39','#39#39',@ISCONTROLLED,1;'#9#9#9
      #9#9#9
      #9'commit;'
      'END;')
    Left = 5416
    Top = 1088
  end
  object FN_RX_NEXTREFILL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE FUNCTION dbo.FN_RX_NEXTREFILL (@RX_NO BIGINT)'
      'RETURNS VARCHAR(15)'
      'AS'
      'BEGIN'
      '    DECLARE'
      '        @TotalRecetado         FLOAT,'
      '        @CANTIDAD_RECETADA     FLOAT,'
      '        @TOTAL_DISPENSADO      FLOAT,'
      '        @CANTIDAD_DISPONIBLE   FLOAT,'
      '        @PROXIMOREFILL         VARCHAR(15),'
      '        @CONTROLADO            CHAR(4),'
      '        @RX_DATE               DATETIME,'
      '        @CONTROLED_RX_EXPI_DAYS INT,'
      '        @RX_EXPI_DAYS          INT,'
      '        @ACTIVE_RX             BIT,'
      '        @NO_AUTHO_REFILLS      INT,'
      '        @FECHAULTIMOREFILL     DATETIME,'
      '        @DAYS_SUPPLY           INT,'
      '        @EXPIRED               BIT,'
      '        @QTY                   DECIMAL(18,2),'
      '        @RX_STATUS             CHAR(1),'
      '        @CLAIM_STATUS          INT,'
      '        @DAYS                  INT;'
      '        '
      ''
      '    -- Defaults (avoid NULL surprises)'
      '    SET @PROXIMOREFILL = '#39'N/A'#39';'
      '    SET @EXPIRED = 0;'
      ''
      '    -- Setup'
      '    SELECT'
      '        @RX_EXPI_DAYS = RX_EXPIRATION_DAYS,'
      '        @CONTROLED_RX_EXPI_DAYS = RX_CONTROLED_EXPIRATION_DAYS'
      '    FROM CREDITDEBITSETUP;'
      ''
      '    -- OTC'
      '    SELECT'
      '        @CONTROLADO   = CONTROLADO,'
      '        @QTY          = ISNULL(QTY, 0),'
      '        @RX_STATUS    = RX_STATUS,'
      '        @CLAIM_STATUS = CLAIM_STATUS'
      '    FROM OTC'
      '    WHERE NUMERORECETA = @RX_NO;'
      ''
      '    -- PRESCRIPTIONS'
      '    SELECT'
      '        @ACTIVE_RX           = ACTIVE,'
      '        @RX_DATE             = FECHARECETA,'
      '        @CANTIDAD_RECETADA   = ISNULL(CANTIDADRECETADA, 0),'
      
        '        @NO_AUTHO_REFILLS    = ISNULL(NUMEROREFILLSAUTORIZADOS, ' +
        '0),'
      '        @CANTIDAD_DISPONIBLE = ISNULL(CANTIDAD_DISPONIBLE, 0),'
      '        @FECHAULTIMOREFILL   = FECHAULTIMOREFILL,'
      '        @DAYS_SUPPLY         = ISNULL(DAYS_SUPPLY, 0)'
      
        '        --@TOTAL_DISPENSADO    = ISNULL(TOTAL_DISPENSADO, 0)  --' +
        ' <-- adjust to your real column name'
      '    FROM PRESCRIPTIONS'
      '    WHERE NUMERORECETA = @RX_NO;'
      ''
      '    -- If no prescription row found, keep N/A'
      '    IF @ACTIVE_RX IS NULL'
      '        RETURN @PROXIMOREFILL;'
      ''
      '    -- Inactive'
      '    IF @ACTIVE_RX = 0'
      '        RETURN '#39'INACTIVE RX'#39';'
      ''
      '    -- Total prescribed'
      '    SET @TotalRecetado ='
      '        CASE WHEN @NO_AUTHO_REFILLS > 0'
      
        '             THEN (@CANTIDAD_RECETADA * @NO_AUTHO_REFILLS) + @CA' +
        'NTIDAD_RECETADA'
      '             ELSE @CANTIDAD_RECETADA'
      '        END;'
      ''
      '    -- Expiration logic'
      '    IF @RX_DATE IS NOT NULL'
      '    BEGIN'
      '        DECLARE @expDays INT;'
      ''
      
        '        -- Your intent seems: CONTROLADO = '#39'RX'#39' or blank => use ' +
        'normal expiration.'
      
        '        -- If controlled is something else => use controlled exp' +
        'iration.'
      '        SET @expDays ='
      
        '            CASE WHEN RTRIM(ISNULL(@CONTROLADO, '#39#39')) IN ('#39'RX'#39','#39#39 +
        ')'
      '                 THEN ISNULL(@RX_EXPI_DAYS, 365)'
      '                 ELSE ISNULL(@CONTROLED_RX_EXPI_DAYS, 180)'
      '            END;'
      ''
      '        IF DATEADD(DAY, @expDays, @RX_DATE) < GETDATE()'
      '        BEGIN'
      '            SET @EXPIRED = 1;'
      '            RETURN '#39'EXPIRED'#39';'
      '        END'
      '    END'
      ''
      '    -- No refills / nothing available'
      '    IF (@CANTIDAD_DISPONIBLE = 0) OR (@NO_AUTHO_REFILLS = 0)'
      '        RETURN '#39'N/A'#39';'
      ''
      '    -- Next refill timing'
      '    IF (@FECHAULTIMOREFILL IS NOT NULL) AND (@DAYS_SUPPLY > 0)'
      
        '       AND (DATEADD(DAY, @DAYS_SUPPLY, @FECHAULTIMOREFILL) >= GE' +
        'TDATE())'
      '       AND (@TotalRecetado <> @CANTIDAD_DISPONIBLE)'
      '    BEGIN'
      
        '        SET @DAYS = DATEDIFF(DAY, GETDATE(), DATEADD(DAY, @DAYS_' +
        'SUPPLY, @FECHAULTIMOREFILL));'
      '        RETURN CONCAT('#39'IN '#39', @DAYS, '#39' DAYS'#39');'
      '    END'
      ''
      '    -- Special rule'
      
        '    IF (@RX_STATUS = '#39'N'#39') AND (@QTY = 0) AND (@CLAIM_STATUS <> 1' +
        ')'
      '        RETURN '#39'N/A'#39';'
      ''
      '    RETURN '#39'READY'#39';'
      'END;')
    Left = 5416
    Top = 1200
  end
  object INVENTORY_INOUT_REPORT: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'INVENTOR' +
        'Y_INOUT_REPORT'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[INVENTORY_INOUT_REPORT]('
      #9'[description] [nchar](35) NULL,'
      #9'[strenght] [nchar](25) NULL,'
      #9'[form] [nchar](3) NULL,'
      #9'[size] [decimal](18, 2) NULL,'
      #9'[qty_orderd] [decimal](18, 2) NULL,'
      #9'[qty_received] [decimal](18, 2) NULL,'
      #9'[qty_sold] [decimal](18, 2) NULL,'
      #9'[unit_cost] [decimal](18, 2) NULL,'
      #9'[extended_cost] [decimal](18, 2) NULL,'
      #9'[invoice_number] [nchar](30) NULL,'
      #9'[rx_number] [bigint] NULL,'
      #9'[id] [int] IDENTITY(1,1) NOT NULL,'
      #9'[transaction_date] [date] NULL,'
      #9'[po] [nchar](15) NULL,'
      #9'[customer_supplier] [nchar](45) NULL,'
      #9'[expiration_date] [date] NULL,'
      #9'[inventory] [decimal](18, 2) NULL,'
      ' CONSTRAINT [PK_INVENTORY_INOUT_REPORT] PRIMARY KEY CLUSTERED '
      '('
      #9'[id] ASC'
      
