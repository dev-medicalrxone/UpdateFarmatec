      '         @CODIGOBARRASTR           CHAR(14),'
      '         @DESCRIPCIONSTR           CHAR(35),'
      '         @CASA_FARMACEUTICASTR     CHAR(35),'
      '         @ROUTEOFADMINISTRATIONSTR CHAR(16),'
      '         @CONTROLADOSTR            CHAR(4),'
      '         @STRENGTHSTR              CHAR(25),'
