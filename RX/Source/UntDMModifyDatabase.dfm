  object NEXT_ID: TFDQuery
    AfterExecute = NEXT_IDAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[NEXT_ID] @OPTION VARCHAR(15), @ID INTEGE' +
        'R OUTPUT'
      'AS'
      'DECLARE @CURRENT_APPRISS_TN INT'
      'DECLARE @NO Integer;'
      'DECLARE @REFERENCE_NO INT;'
      'begin'
      '  begin transaction'
      '  IF @OPTION = '#39'MessageID'#39' '
      '  begin'
      #9'  Update NEXT_RXNUMBER SET MessageID = MessageID + 1;'
      #9'  Select @ID = (MessageID) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'APPRISS'#39' '
      '  begin'
      
        #9'  SELECT @CURRENT_APPRISS_TN = APPRISS_TRANSACTION_NUMBER FROM ' +
        'NEXT_RXNUMBER;'
      #9'  IF (@CURRENT_APPRISS_TN IS NULL) OR (@CURRENT_APPRISS_TN = 0)'
      #9'  begin'
      #9'   SELECT @CURRENT_APPRISS_TN = MAX(OTCNUMBER) FROM OTC; '
      
        #9'   Update NEXT_RXNUMBER set APPRISS_TRANSACTION_NUMBER = @CURRE' +
        'NT_APPRISS_TN;'
      #9'  end;'
      
        #9'  Update NEXT_RXNUMBER SET APPRISS_TRANSACTION_NUMBER = APPRISS' +
        '_TRANSACTION_NUMBER + 1 Select @ID = (APPRISS_TRANSACTION_NUMBER' +
        ') FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'MAIN_COURSE_ID'#39
      '  begin'
      #9'  Update NEXT_RXNUMBER SET MAIN_COURSE_ID = MAIN_COURSE_ID + 1;'
      #9'  Select @ID = (MAIN_COURSE_ID) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'BARCODE'#39
      '  begin'
      #9'  Update NEXT_RXNUMBER SET BARCODE = BARCODE + 1;'
      #9'  Select @ID = (BARCODE) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'INSTANCIA'#39
      '  begin'
      #9'Select @NO = INSTANCIA FROM NEXT_RXNUMBER'
      #9'if @NO < 5000'
      #9'begin'
      #9#9'Update NEXT_RXNUMBER SET INSTANCIA = INSTANCIA + 1;'
      #9#9'Select @ID = (INSTANCIA) FROM NEXT_RXNUMBER;'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'Update NEXT_RXNUMBER SET INSTANCIA = 1;'
      #9#9'Select @ID= (INSTANCIA) FROM NEXT_RXNUMBER;'
      #9'end'
      '  end;'
      '  if @OPTION = '#39'MEZCLA_TRAN_NO'#39
      '  begin'
      #9'Update NEXT_RXNUMBER SET MEZCLA_TRAN_NO = MEZCLA_TRAN_NO + 1;'
      #9'Select @ID = (MEZCLA_TRAN_NO) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'PARATA'#39
      '  begin'
      #9'Update NEXT_RXNUMBER SET PARATA = PARATA + 1;'
      #9'Select @ID = (PARATA) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'RX_TRAN_NO'#39
      '  begin'
      #9'Update NEXT_RXNUMBER SET RX_TRAN_NO = RX_TRAN_NO + 1;'
      #9'Select @ID = (RX_TRAN_NO) FROM NEXT_RXNUMBER;'
      '  end;'
      '  if @OPTION = '#39'REFERENCE_NO'#39
      '  begin'
      #9'Select @REFERENCE_NO = REFERENCE_NO from NEXT_RXNUMBER;'
      #9'if @REFERENCE_NO >= 999999 '
      #9'begin'
      #9'  Update NEXT_RXNUMBER SET REFERENCE_NO = 0;'
      #9'end;'
      #9'Update NEXT_RXNUMBER SET REFERENCE_NO = REFERENCE_NO + 1;'
      #9'Select @ID = (REFERENCE_NO) FROM NEXT_RXNUMBER;'
      '  end;'
      '  commit'
      'end;')
    Left = 3976
    Top = 656
  end
  object SURESCRIPTS_UPDATE_RXSTATUS: TFDQuery
    AfterExecute = SURESCRIPTS_UPDATE_RXSTATUSAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SURESCRIPTS_UPDATE_RXSTATUS]'
      '    @MessageID          VARCHAR(50),'
      '    @Rx_status          INT,'
      '    @RxReferenceNumber  BIGINT,'
      '    @SPI                NCHAR(13),'
      '    @NOTE               VARCHAR(MAX),'
      '    @USER               CHAR(3),'
      '    @GUID               NCHAR(36)'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      
        '    SET XACT_ABORT ON;  -- important: auto-abort transaction on ' +
        'many runtime errors'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- GUID path (preferred if GUID is provided)'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        IF NULLIF(LTRIM(RTRIM(@GUID)), '#39#39') IS NOT NULL'
      '        BEGIN'
      
        '            -- Delete labels for all MessageIDs under this GUID ' +
        '(set-based)'
      '            DELETE L'
      '            FROM dbo.Surescriptsrx_label AS L'
      '            INNER JOIN dbo.Surescripts AS S'
      '                ON L.MessageID = S.MessageID'
      '            WHERE S.GUID = @GUID;'
      ''
      
        '            -- Update Surescripts rows for this GUID (do not tou' +
        'ch rows already finalized = 8)'
      '            UPDATE dbo.Surescripts'
      '            SET Rx_status          = @Rx_status,'
      '                RxReferenceNumber  = 0,'
      '                PatientID          = 0,'
      '                PrescriberID       = 0,'
      '                MedicationID       = 0,'
      '                Atendida_por       = '#39#39','
      '                GUID               = '#39#39' '
      '            WHERE GUID = @GUID'
      '              AND Rx_Status <> 8;'
      '        END'
      '        ELSE'
      '        BEGIN'
      
        '            ----------------------------------------------------' +
        '-------------'
      '            -- MessageID path'
      
        '            ----------------------------------------------------' +
        '-------------'
      '            IF (@Rx_status = 5) OR (@Rx_status = 0)'
      '            BEGIN'
      '                UPDATE dbo.Surescripts'
      '                SET Rx_status          = @Rx_status,'
      '                    RxReferenceNumber  = 0,'
      '                    PatientID          = 0,'
      '                    PrescriberID       = 0,'
      '                    MedicationID       = 0,'
      '                    Atendida_por       = '#39#39
      
        '                WHERE LTRIM(RTRIM(MessageID)) = LTRIM(RTRIM(@Mes' +
        'sageID));'
      '            END'
      '            ELSE'
      '            BEGIN'
      '                UPDATE dbo.Surescripts'
      '                SET Rx_status         = @Rx_status,'
      '                    RxReferenceNumber = @RxReferenceNumber'
      
        '                WHERE LTRIM(RTRIM(MessageID)) = LTRIM(RTRIM(@Mes' +
        'sageID));'
      '            END;'
      ''
      '            IF @Rx_status <> 2'
      '            BEGIN'
      '                DELETE FROM dbo.SurescriptsRX_LABEL'
      '                WHERE MessageID = @MessageID;'
      '            END;'
      '        END;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        -- LOG NOTE (runs for either path). Uses fixed INSERT_LO' +
        'G that will'
      
        '        -- NOT start/commit its own transaction when called insi' +
        'de one.'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        IF @NOTE IS NOT NULL AND NULLIF(LTRIM(RTRIM(@NOTE)), '#39#39')' +
        ' IS NOT NULL'
      '        BEGIN'
      '            DECLARE @NORX BIGINT = 0,'
      '                    @OTCNUMBER INT = 0;'
      ''
      '            SELECT TOP (1)'
      '                @NORX      = ISNULL(o.NUMERORECETA, 0),'
      '                @OTCNUMBER = ISNULL(o.OTCNUMBER, 0)'
      '            FROM dbo.OTC o'
      
        '            WHERE LTRIM(RTRIM(o.MessageID)) = LTRIM(RTRIM(@Messa' +
        'geID))'
      '            ORDER BY o.OTCNUMBER DESC;'
      ''
      '            EXEC dbo.INSERT_LOG'
      '                @DESCRIPCION = '#39'Surescripts Modification'#39','
      '                @CODIGO = '#39'M'#39','
      '                @NDC_BARCODE = '#39#39','
      '                @USUARIO = @USER,'
      '                @SUPERVISOR = '#39#39','
      '                @NO_RX = @NORX,'
      '                @OTCNUMBER = @OTCNUMBER,'
      '                @PRESCRIBER_ID = 0,'
      '                @CUSTOMER_ID = 0,'
      '                @PASSWORD_ID = 0,'
      '                @HEALTH_PLAN_ID = 0,'
      '                @PATIENT_HEALTH_PLAN_ID = 0,'
      '                @DRUG_ID = 0,'
      '                @POS_RX = '#39'R'#39','
      '                @NOTE = @NOTE,'
      '                @CONTROLLED = 0,'
      '                @SUCCESSFUL = 1;'
      '        END;'
      ''
      '        COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF XACT_STATE() <> 0 AND @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 4160
    Top = 480
  end
  object RX_TERMINAR_RECETA: TFDQuery
    AfterExecute = RX_TERMINAR_RECETAAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[RX_TERMINAR_RECETA]'
      #9'@GUID VARCHAR(36), @PRINTER_ID INT, '
      #9'@REVERSAL BIT, @ePRESCRIBE_VERSION CHAR(6),'
      #9'@LABEL_NAME NCHAR(15),'
      #9'@PRINTER_IP NCHAR(15)'
      'AS'
      'DECLARE @OTCNUMBER INT;'
      'DECLARE @PAGO_PLAN FLOAT'
      'DECLARE @DEDUCIBLE FLOAT'
      'DECLARE @NUMERORECETA BIGINT'
      'DECLARE @MESSAGEID NCHAR(40)'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @IMPRIMIR BIT'
      'DECLARE @MYREFILL_UPDATE_SMARTPICKUP BIT'
      'DECLARE @CONTROLLED CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @PRODID INT'
      'DECLARE @PRESCRIBER_ID INT'
      'DECLARE @NOCUSTOMER INT'
      ''
      'BEGIN'
      #9'BEGIN TRAN'
      #9'-- HARD STOP: do not run if GUID is NULL or blank'
      #9'IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9'BEGIN'
      
        #9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or b' +
        'lank.'#39', 16, 1);'
      #9#9'RETURN;'
      #9'END;'
      
        #9'SELECT @MYREFILL_UPDATE_SMARTPICKUP = MYREFILL_UPDATE_SMARTPICK' +
        'UP FROM CREDITDEBITSETUP;'
      
        #9'DECLARE MyCursor CURSOR STATIC LOCAL FOR SELECT OTCNUMBER, PAGO' +
        '_PLAN, DEDUCIBLE, NUMERORECETA, IMPRIMIR, CONTROLADO, PRODUCT_ID' +
        ', NUMEROCLIENTE FROM OTC WHERE GUID = @GUID;'
      #9'OPEN MyCursor'
      #9'FETCH NEXT FROM MyCursor'
      
        #9'INTO @OTCNUMBER, @PAGO_PLAN, @DEDUCIBLE, @NUMERORECETA, @IMPRIM' +
        'IR, @CONTROLLED, @PRODID, @NOCUSTOMER;'
      #9'WHILE @@FETCH_STATUS = 0'
      #9'BEGIN'
      #9#9'IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9#9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9#9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @I' +
        'SCONTROLLED = 1;'
      ''
      
        #9#9'EXEC INVENTORY_CONTROL @OTCNUMBER, @IMPRIMIR, @LABEL_NAME, @PR' +
        'INTER_ID, @REVERSAL, @PRINTER_IP;   '
      #9#9'IF @ePRESCRIBE_VERSION = '#39'201701'#39
      #9#9'begin'
      
        #9#9#9'SELECT @MESSAGEID = MESSAGEID, @SPI = SPI, @PRESCRIBER_ID = N' +
        'UMERODOCTOR FROM PRESCRIPTIONS WHERE NUMERORECETA = @NUMERORECET' +
        'A;'
      #9#9#9'if @MESSAGEID > '#39#39
      #9#9#9'begin'
      
        #9#9#9#9'EXEC SURESCRIPTS_UPDATE_RXSTATUS @MESSAGEID, 1, @NUMERORECET' +
        'A, @SPI,'#39#39', '#39#39', '#39#39';'
      #9#9#9'end;'
      #9#9'end;'
      
        #9#9'UPDATE LOG SET CONTROLLED = @ISCONTROLLED, DRUG_ID = @PRODID, ' +
        'PRESCRIBER_ID = @PRESCRIBER_ID, CUSTOMER_ID = @NOCUSTOMER WHERE ' +
        'NO_RX = @NUMERORECETA and RTRIM(DESCRIPCION) = '#39'RX DETAIL CREATE' +
        'D'#39'; '
      
        #9#9'UPDATE OTC SET GUID = '#39#39', RECORD_LOCKED = 0, INSTANCIA = 0 WHE' +
        'RE OTCNUMBER = @OTCNUMBER;'
      #9#9'IF @MYREFILL_UPDATE_SMARTPICKUP = 0'
      #9#9'begin'
      #9#9'  EXEC RX_UPDATE_REFILL_QUERY @NUMERORECETA; '
      #9#9'end;'
      #9#9'FETCH NEXT FROM MyCursor'
      
        #9#9'INTO @OTCNUMBER, @PAGO_PLAN, @DEDUCIBLE, @NUMERORECETA, @IMPRI' +
        'MIR, @CONTROLLED, @PRODID, @NOCUSTOMER;'
      #9'END;'
      #9'CLOSE MyCursor'
      #9'DEALLOCATE MyCursor'
      #9'COMMIT'
      'END;')
    Left = 4168
    Top = 568
  end
