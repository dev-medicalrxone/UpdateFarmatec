  object INVENTORY_ERX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INVENTORY_ERX]'
      #9#9'@sRXNum  VARCHAR(12),'
      #9#9'@NDC VARCHAR(15),'
      #9#9'@InvReg BIT,'
      #9#9'@Inv340B BIT,'
      #9#9'@InvLTC BIT,'
      #9#9'@QTY NUMERIC(18,3)'
      'AS'
      'BEGIN'
      #9'    DECLARE @iIDDrug INTEGER=0,'
      #9#9#9#9'@sInvREG NUMERIC(18,3)=0,'
      #9#9#9#9'@sInv340B NUMERIC(18,3)=0,'
      #9#9#9#9'@sInvLTC NUMERIC(18,3)=0,'
      #9#9#9#9'@SQL VARCHAR(MAX)'
      ''
      #9#9'SET NOCOUNT ON;'
      ''
      #9#9'SELECT @QTY = @QTY*(-1);'
      ''
      
        #9#9'SELECT @iIDDrug=IV.ID_DRUG,@sInvREG=ON_HAND_QT,@sInv340B=INVLT' +
        'C_QT,@sInvLTC=INV340B_QT '
      '        FROM [EasyRx].[DBO].[drugs] DR'
      
        #9#9#9'INNER JOIN [EasyRx].[DBO].[INVENTORY] IV on IV.ID_DRUG=DR.GEN' +
        'ERIC_LNK'
      '        WHERE DR.NDC=@NDC'
      ''
      #9#9'--actualiza el inventario'
      #9#9'UPDATE IV SET '
      #9#9#9' INVLTC_QT = INVLTC_QT + IIF(@InvLTC=1 ,@QTY,0)'
      #9#9#9',INV340B_QT = INV340B_QT + IIF(@Inv340B=1, @QTY,0)'
      #9#9#9',ON_HAND_QT = ON_HAND_QT + IIF(@InvReg=1, @QTY,0)'
      #9#9'FROM [EasyRx].[DBO].[INVENTORY] IV WHERE ID_DRUG = @iIDDrug'
      ''
      
        #9#9'INSERT INTO [EasyRx].[DBO].[InvModHist] (ID_DRUG,DateHist,QTYH' +
        'ist,ModifHist,NotesHist,RX,TypeInv,PrevInv)'
      
        #9#9'SELECT @iIDDrug ,GETDATE(),@QTY,'#39'SRV'#39',IIF(@QTY>0,'#39'Others Rec.'#39 +
        ','#39'Others'#39'),@sRXNum ,'
      
        #9#9'IIF(@InvLTC=1,'#39'LTC'#39',IIF(@Inv340B=1,'#39'340B'#39','#39'REG'#39')),IIF(@InvLTC=' +
        '1,@sInvLTC,IIF(@Inv340B=1,@sInv340B,@sInvREG))      '
      'END')
    Left = 6408
    Top = 288
  end
  object PRODUCT_SIGNATURE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'PRODUCT_' +
        'SIGNATURE'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[PRODUCT_SIGNATURE]('
      #9'[ENCRYPTED_SIGNATURE] [text] NULL,'
      '      [SIGNATURE_DATE] [date] NULL,'
      '      [SIGNATURE_USER] [nchar](3) NULL,'
      '      [TRANSACTIONNUMBER] [int] NOT NULL,'
      '      [PICKEDUP_BY] [nchar](45) NULL,'
      '      [PICKEDUP_ID] [nchar](20) NULL,'
      '      [IMAGE_SIGNATURE] [image] NULL,'
      '      [PICKEDUP_ADDRESS] [text] NULL,'
      '      [PICKEDUP_ID_TYPE] [nchar](30) NULL,'
      'PRIMARY KEY CLUSTERED '
      '('
      #9'[TRANSACTIONNUMBER] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY] TEXTIMAGE_ON [PRIMARY]    '
      'END;          ')
    Left = 6416
    Top = 408
  end
  object INSERT_PRODUCT_SIGNATURE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_PRODUCT_SIGNATURE]'
      '('
      '@IMAGE_SIGNATURE image,'
      '@SIGNATURE_DATE DATE,'
      '@SIGNATURE_USER NCHAR(3),'
      '@PICKEDUP_ID NCHAR(20),'
      '@PICKEDUP_BY NCHAR(45),'
      '@TRANSACTIONNUMBER INT,'
      '@PICKEDUP_ADDRESS nchar(80),'
      '@PICKEDUP_ID_TYPE nchar(15)'
      ')'
      'AS'
      'DECLARE @TOKEN NCHAR(30)'
      'declare @Existingdate datetime'
      'SET NOCOUNT ON'
      'BEGIN   '
      #9'begin transaction'
      #9'INSERT INTO [dbo].[PRODUCT_SIGNATURE]'
      #9#9#9'([IMAGE_SIGNATURE]'
      #9#9#9',[SIGNATURE_DATE]'
      #9#9#9',[SIGNATURE_USER]'
      #9#9#9',[PICKEDUP_ID]'
      #9#9'    ,[PICKEDUP_BY]'
      #9#9#9',[TRANSACTIONNUMBER]'
      #9#9#9',[PICKEDUP_ADDRESS]'
      #9#9#9',[PICKEDUP_ID_TYPE])'
      #9#9'VALUES'
      #9#9#9'(@IMAGE_SIGNATURE,'
      #9#9#9'@SIGNATURE_DATE,'
      #9#9#9'@SIGNATURE_USER,'
      #9#9#9'@PICKEDUP_ID,'
      #9#9#9'@PICKEDUP_BY,'
      #9#9#9'@TRANSACTIONNUMBER,'
      #9#9#9'@PICKEDUP_ADDRESS,'
      #9#9#9'@PICKEDUP_ID_TYPE);'
      #9'commit;'
      'END;')
    Left = 6408
    Top = 512
  end
  object PSEUDO_SALES_LOG: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[PSEUDO_SALES_LOG]'
      'AS'
      
        'SELECT     dbo.PRODUCT_SIGNATURE.ENCRYPTED_SIGNATURE, dbo.PRODUC' +
        'T_SIGNATURE.SIGNATURE_DATE, dbo.PRODUCT_SIGNATURE.SIGNATURE_USER' +
        ', dbo.PRODUCT_SIGNATURE.TRANSACTIONNUMBER, dbo.PRODUCT_SIGNATURE' +
        '.PICKEDUP_BY, '
      
        '                  dbo.PRODUCT_SIGNATURE.PICKEDUP_ID, dbo.TRANSAC' +
        'TIONDETAIL.PRODDESCRIPTION, dbo.TRANSACTIONDETAIL.QTY, dbo.TRANS' +
        'ACTIONDETAIL.UPC, dbo.TRANSACTIONDETAIL.pseudo, dbo.TRANSACTIOND' +
        'ETAIL.pep_spray'
      'FROM        dbo.PRODUCT_SIGNATURE INNER JOIN'
      
        '                  dbo.TRANSACTIONDETAIL ON dbo.PRODUCT_SIGNATURE' +
        '.TRANSACTIONNUMBER = dbo.TRANSACTIONDETAIL.TRANSACTIONNUMBER')
    Left = 6424
    Top = 624
  end
  object WF_UPDATE_PICKUP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE  PROCEDURE dbo.WF_UPDATE_PICKUP ('
      #9'@DBName nchar(20),'
      #9'@OTCNUMBER integer,'
      #9'@USER CHAR(3))'
      'as'
      'BEGIN'
      '    DECLARE @SQL NVARCHAR(500);'
      #9'DECLARE @NUMEROCLIENTE integer;'
      #9'DECLARE @RXNO int;'
      #9'DECLARE @PRODUCTNO integer;'
      #9'DECLARE @DESCRIPTION NCHAR(30);'
      #9'DECLARE @ISCONTROLLED BIT;'
      #9'DECLARE @DATE_ DATETIME;'
      #9'DECLARE @TIME_ DATETIME;'
      #9'DECLARE @CODE CHAR(1);'
      #9'DECLARE @ISCONTROLED BIT;'
      #9'DECLARE @TOKEN NCHAR(30);'
      #9'DECLARE @COBRADO CHAR(1)'
      #9'SET @CODE = '#39'U'#39';'
      #9'SET @COBRADO = '#39'T'#39';'
      
        #9'SELECT @RXNO = RX_NUMBER, @PRODUCTNO = PRUDUCT_ID  FROM WILLCAL' +
        'L WHERE OTC_NUMBER = @OTCNUMBER;'
      
        #9'SET @TOKEN = @USER + '#39' '#39' + convert(varchar,  getdate(), 101) + ' +
        #39' '#39' + convert(varchar,  getdate(), 114) '
      
        #9'---------------------------------------------------------------' +
        '----------------------------------------------------------'
      
        #9'set @SQL = '#39'Update ['#39' + @DBName + '#39'].dbo.OTC set WF_CASHIER = @' +
        'TOKEN, WC_PICKUP = 1, COBRADO = @COBRADO Where OTCNUMBER = @OTCN' +
        'UMBER'#39';'
      
        #9'exec sp_executesql @SQL, N'#39'@TOKEN NCHAR(30), @COBRADO CHAR(1), ' +
        '@OTCNUMBER INTEGER'#39', @TOKEN, @COBRADO, @OTCNUMBER;'
      
        #9'set @SQL = '#39'insert into ['#39' + @DBName + '#39'].dbo.log (DESCRIPCION,' +
        ' CODIGO, USUARIO,NO_RX, OTCNUMBER, CUSTOMER_ID, DRUG_ID, FECHA, ' +
        'HORA)  '
      
        #9'VALUES ( @DESCRIPTION, @CODE, @USER, @NORX, @OTCNUMBER, @NUMERO' +
        'CLIENTE, @PRODUCTNO, @DATE_, @TIME_)'#39';'
      #9'set @DESCRIPTION = '#39'RX PICKED UP BY SMARTPICKUP'#39';'
      #9'set @DATE_ = getdate();'
      #9'set @TIME_ = GETDATE();'
      
        #9'exec sp_executesql @SQL, N'#39'@DESCRIPTION NCHAR(30), @CODE CHAR(1' +
        '),@USER CHAR(3),@NORX integer, @OTCNUMBER integer, @NUMEROCLIENT' +
        'E integer, @PRODUCTNO integer, @DATE_ datetime, @TIME_ datetime'#39 +
        ',  '
      
        #9'@DESCRIPTION, @CODE, @user, @RXNO, @OTCNUMBER, @NUMEROCLIENTE, ' +
        '@PRODUCTNO, @DATE_, @TIME_; '
      #9'set @DESCRIPTION = '#39'RX POS PAID FOR'#39';'
      
        #9'exec sp_executesql @SQL, N'#39'@DESCRIPTION NCHAR(30), @CODE CHAR(1' +
        '),@USER CHAR(3),@NORX integer, @OTCNUMBER integer, @NUMEROCLIENT' +
        'E integer, @PRODUCTNO integer, @DATE_ datetime, @TIME_ datetime'#39 +
        ',  '
      
        #9'@DESCRIPTION, @CODE, @user, @RXNO, @OTCNUMBER, @NUMEROCLIENTE, ' +
        '@PRODUCTNO, @DATE_, @TIME_; '
      'END'
      '')
    Left = 6448
    Top = 728
  end
  object HCPCSCodes: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'HCPCSCod' +
        'es'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[HCPCSCodes]('
      #9'[CODE] [varchar](10) NULL,'
      #9'[DESCRIPTION] [varchar](200) NULL,'
      #9'[FEE] [varchar](12) NOT NULL,'
      #9'[MAXUNITS] [varchar](12) NOT NULL,'
      #9'[PA] [varchar](12) NOT NULL'
      ') ON [PRIMARY]'
      
        'ALTER TABLE [dbo].[HCPCSCodes] ADD  CONSTRAINT [DF_HCPCSCodes_FE' +
        'E]  DEFAULT ('#39#39') FOR [FEE]'
      
        'ALTER TABLE [dbo].[HCPCSCodes] ADD  CONSTRAINT [DF_HCPCSCodes_MA' +
        'XUNITS]  DEFAULT ('#39#39') FOR [MAXUNITS]'
      
        'ALTER TABLE [dbo].[HCPCSCodes] ADD  CONSTRAINT [DF_HCPCSCodes_PA' +
        ']  DEFAULT ('#39#39') FOR [PA]'
      'END;')
    Left = 6536
    Top = 88
  end
  object D0_BuildTransFile_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_BuildTransFile_schema]'
      '    @GUID NCHAR(36),'
      '    @otc_number INT,'
      '    @claim_reversal BIT,'
      '    @multiple_rx BIT,'
      '    @schema CHAR(3),'
      '    @build_only_one BIT,'
      '    @SendText VARCHAR(MAX) OUTPUT,'
      '    @rxpayload VARCHAR(MAX) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    /* ========================================================='
      '       DECLARATIONS'
      
        '       =========================================================' +
        ' */'
      '    DECLARE @send_str VARCHAR(MAX) = '#39#39';'
      '    DECLARE @segment_separator CHAR(1) = CHAR(30);'
      '    DECLARE @FS CHAR(1) = CHAR(28);'
      ''
      '    DECLARE @TransactionCount INT = 1;'
      '    DECLARE @TransactionCode CHAR(2);'
      '    DECLARE @rxcounter INT = 1;'
      '    DECLARE @RowsToBuild INT = 1;'
      ''
      '    -- OTC / RX values'
      '    DECLARE @norx BIGINT;'
      '    DECLARE @datefilled CHAR(8);'
      '    DECLARE @DateRXWritten DATE;'
      '    DECLARE @drug_sig NVARCHAR(296);'
      '    DECLARE @drug_name VARCHAR(30);'
      '    DECLARE @new_ref_code SMALLINT;'
      '    DECLARE @customer_no INT;'
      '    DECLARE @planesmedicosno INT;'
      '    DECLARE @nopatplan INT;'
      '    DECLARE @insurance_name VARCHAR(50);'
      '    DECLARE @insurance_code VARCHAR(10);'
      '    DECLARE @schedule_drug NCHAR(4);'
      '    DECLARE @ing_cost DECIMAL(18,2);'
      '    DECLARE @gross_amount_due DECIMAL(18,2);'
      '    DECLARE @ref_remaining INT;'
      '    DECLARE @rx_expiration_date DATE;'
      '    DECLARE @LTC BIT;'
      ''
      '    -- Pharmacy / insurance header values'
      '    DECLARE @bin_number CHAR(6);'
      '    DECLARE @SoftwareVendorID CHAR(10);'
      '    DECLARE @ProcessorControl CHAR(10);'
      '    DECLARE @ServiceProvIDQual CHAR(2);'
      '    DECLARE @ServiceProvID VARCHAR(15);'
      '    DECLARE @LTCServiceProvIDQual CHAR(2);'
      '    DECLARE @LTCServiceProvID VARCHAR(15);'
      ''
      '    -- Prescriber / payload values'
      '    DECLARE @prescriber_no INT;'
      '    DECLARE @presc_dea VARCHAR(15);'
      '    DECLARE @presc_npi VARCHAR(15);'
      ''
      '    -- Coupon / helpers'
      '    DECLARE @cupon_type CHAR(2);'
      '    DECLARE @cupon_number NCHAR(15);'
      '    DECLARE @cupon_amt DECIMAL(18,2);'
      ''
      '    -- Segment strings'
      '    DECLARE @seg01_str VARCHAR(MAX);'
      '    DECLARE @seg03_str VARCHAR(MAX);'
      '    DECLARE @seg04_str VARCHAR(MAX);'
      '    DECLARE @seg05_str VARCHAR(4000);'
      '    DECLARE @seg06_str VARCHAR(1000);'
      '    DECLARE @seg07_str VARCHAR(MAX);'
      '    DECLARE @seg08_str VARCHAR(500);'
      '    DECLARE @seg10_str VARCHAR(1000);'
      '    DECLARE @seg11_str VARCHAR(MAX);'
      '    DECLARE @clinicalstr VARCHAR(2000);'
      ''
      '    -- Payload values'
      '    DECLARE @pat_id CHAR(20);'
      '    DECLARE @x_pat_id NVARCHAR(MAX);'
      '    DECLARE @x_drug_sig NVARCHAR(MAX);'
      '    DECLARE @x_drug_name NVARCHAR(MAX);'
      '    DECLARE @x_presc_dea NVARCHAR(MAX);'
      '    DECLARE @x_presc_npi NVARCHAR(MAX);'
      '    DECLARE @x_insurance_name NVARCHAR(MAX);'
      '    DECLARE @x_insurance_code NVARCHAR(MAX);'
      '    DECLARE @x_schedule_drug NVARCHAR(MAX);'
      ''
      '    /* ========================================================='
      '       INITIALIZATION'
      
        '       =========================================================' +
        ' */'
      '    SET @SendText = '#39#39';'
      '    SET @rxpayload = '#39'<ArrayOfExtraPayloadData>'#39';'
      ''
      '    SET @TransactionCode ='
      '        CASE WHEN @claim_reversal = 1 THEN '#39'B2'#39' ELSE '#39'B1'#39' END;'
      ''
      '    IF (@build_only_one = 1) OR (@claim_reversal = 1)'
      '    BEGIN'
      '        SET @RowsToBuild = 1;'
      '        SET @TransactionCount = 1;'
      '    END'
      '    ELSE'
      '    BEGIN'
      '        IF @multiple_rx = 1'
      '        BEGIN'
      '            SELECT @RowsToBuild = COUNT(*)'
      '            FROM dbo.OTC'
      '            WHERE GUID = @GUID;'
      ''
      '            IF @RowsToBuild > 4'
      '                SET @RowsToBuild = 4;'
      '        END'
      '        ELSE'
      '            SET @RowsToBuild = 1;'
      ''
      '        SET @TransactionCount = @RowsToBuild;'
      '    END'
      ''
      '    /* ========================================================='
      '       MAIN RX LOOP'
      
        '       =========================================================' +
        ' */'
      '    WHILE @rxcounter <= @RowsToBuild'
      '    BEGIN'
      '        /* -----------------------------------------------------'
      '           RESET PER RX'
      
        '           -----------------------------------------------------' +
        ' */'
      '        SET @seg01_str = '#39#39';'
      '        SET @seg03_str = '#39#39';'
      '        SET @seg04_str = '#39#39';'
      '        SET @seg05_str = '#39#39';'
      '        SET @seg06_str = '#39#39';'
      '        SET @seg07_str = '#39#39';'
      '        SET @seg08_str = '#39#39';'
      '        SET @seg10_str = '#39#39';'
      '        SET @seg11_str = '#39#39';'
      '        SET @clinicalstr = '#39#39';'
      ''
      '        SET @pat_id = '#39#39';'
      '        SET @presc_dea = '#39#39';'
      '        SET @presc_npi = '#39#39';'
      ''
      '        /* -----------------------------------------------------'
      '           LOAD OTC'
      
        '           -----------------------------------------------------' +
        ' */'
      '        IF @build_only_one = 1'
      '        BEGIN'
      '            SELECT'
      
        '                @datefilled       = CONVERT(CHAR(8), O.FECHAOTC,' +
        ' 112),'
      '                @norx             = ISNULL(O.NUMERORECETA, 0),'
      
        '                @new_ref_code     = ISNULL(O.CODIGOREFILLNUEVO, ' +
        '0),'
      '                @otc_number       = ISNULL(O.OTCNUMBER, 0),'
      '                @drug_name        = ISNULL(O.MEDICAMENTO, '#39#39'),'
      '                @schedule_drug    = ISNULL(O.CONTROLADO, '#39#39'),'
      '                @insurance_code   = ISNULL(O.PLAN_MEDICO, '#39#39'),'
      
        '                @planesmedicosno  = ISNULL(O.PLANESMEDICOSNO, 0)' +
        ','
      '                @nopatplan        = ISNULL(O.NUMEROPLAN, 0),'
      '                @customer_no      = ISNULL(O.NUMEROCLIENTE, 0),'
      
        '                @ing_cost         = ISNULL(O.PRECIOFACTURACION, ' +
        '0),'
      '                @gross_amount_due = ISNULL(O.GROSSAMOUNTDUE, 0),'
      '                @cupon_type       = ISNULL(O.CUPONTYPE, '#39#39'),'
      '                @cupon_number     = ISNULL(O.CUPON_NUMBER, '#39#39'),'
      '                @cupon_amt        = ISNULL(O.CUPON_VALUE_AMT, 0)'
      '            FROM dbo.OTC O'
      '            WHERE O.OTCNUMBER = @otc_number;'
      '        END'
      '        ELSE'
      '        BEGIN'
      '            SELECT'
      
        '                @datefilled       = CONVERT(CHAR(8), O.FECHAOTC,' +
        ' 112),'
      '                @norx             = ISNULL(O.NUMERORECETA, 0),'
      
        '                @new_ref_code     = ISNULL(O.CODIGOREFILLNUEVO, ' +
        '0),'
      '                @otc_number       = ISNULL(O.OTCNUMBER, 0),'
      '                @drug_name        = ISNULL(O.MEDICAMENTO, '#39#39'),'
      '                @schedule_drug    = ISNULL(O.CONTROLADO, '#39#39'),'
      '                @insurance_code   = ISNULL(O.PLAN_MEDICO, '#39#39'),'
      
        '                @planesmedicosno  = ISNULL(O.PLANESMEDICOSNO, 0)' +
        ','
      '                @nopatplan        = ISNULL(O.NUMEROPLAN, 0),'
      '                @customer_no      = ISNULL(O.NUMEROCLIENTE, 0),'
      
        '                @ing_cost         = ISNULL(O.PRECIOFACTURACION, ' +
        '0),'
      '                @gross_amount_due = ISNULL(O.GROSSAMOUNTDUE, 0),'
      '                @cupon_type       = ISNULL(O.CUPONTYPE, '#39#39'),'
      '                @cupon_number     = ISNULL(O.CUPON_NUMBER, '#39#39'),'
      '                @cupon_amt        = ISNULL(O.CUPON_VALUE_AMT, 0)'
      '            FROM dbo.OTC O'
      '            WHERE O.GUID = @GUID'
      '            ORDER BY O.OTCNUMBER'
      '            OFFSET (@rxcounter - 1) ROWS FETCH NEXT 1 ROW ONLY;'
      '        END'
      ''
      '        IF ISNULL(@otc_number, 0) = 0'
      '            BREAK;'
      ''
      '        /* -----------------------------------------------------'
      '           LOAD PRESCRIPTION'
      
        '           -----------------------------------------------------' +
        ' */'
      '        SELECT'
      '            @DateRXWritten = P.FECHARECETA,'
      '            @drug_sig = ISNULL(P.ETIQUETA, '#39#39'),'
      
        '            @ref_remaining = ISNULL(P.NUMEROREFILLSAUTORIZADOS, ' +
        '0) - ISNULL(@new_ref_code, 0),'
      '            @LTC = ISNULL(P.LTC, 0)'
      '        FROM dbo.PRESCRIPTIONS P'
      '        WHERE P.NUMERORECETA = @norx;'
      ''
      '        /* -----------------------------------------------------'
      '           LOAD PLAN / TRANSACTION HEADER DATA ON FIRST RX ONLY'
      
        '           -----------------------------------------------------' +
        ' */'
      '        IF @rxcounter = 1'
      '        BEGIN'
      '            SELECT'
      
        '                @bin_number = CONCAT(ISNULL(PM.BINNUMBER, '#39#39'), S' +
        'PACE(6), NULL),'
      
        '                @SoftwareVendorID = CONCAT(ISNULL(PM.SOFTWARE_VE' +
        'NDOR_ID, '#39#39'), SPACE(10), NULL),'
      
        '                @ServiceProvID = CONCAT(ISNULL(PM.NUMEROFARMACIA' +
        ', '#39#39'), SPACE(15), NULL),'
      
        '                @ProcessorControl = CONCAT(ISNULL(PM.PROCESSORCO' +
        'NTROL, '#39#39'), SPACE(10), NULL),'
      
        '                @ServiceProvIDQual = CONCAT(ISNULL(PM.SERVICE_PR' +
        'OVIDER_ID_QUAL, '#39#39'), SPACE(2), NULL),'
      '                @insurance_name = ISNULL(PM.NOMBRE, '#39#39'),'
      
        '                @LTCServiceProvID = CONCAT(ISNULL(PM.LTC_SERVICE' +
        '_PROVIDER_ID, '#39#39'), SPACE(15), NULL),'
      
        '                @LTCServiceProvIDQual = CONCAT(ISNULL(PM.LTC_SER' +
        'VICE_PROVIDER_QUAL, '#39#39'), SPACE(2), NULL)'
      '            FROM dbo.PLANESMEDICOS PM'
      '            WHERE PM.PLANESMEDICOSNO = @planesmedicosno;'
      ''
      '            IF @LTC = 0'
      
        '                SET @send_str = @bin_number + '#39'D0'#39' + @Transactio' +
        'nCode + @ProcessorControl'
      
        '                              + CAST(@TransactionCount AS VARCHA' +
        'R(10))'
      
        '                              + @ServiceProvIDQual + @ServicePro' +
        'vID + @datefilled + @SoftwareVendorID;'
      '            ELSE'
      
        '                SET @send_str = @bin_number + '#39'D0'#39' + @Transactio' +
        'nCode + @ProcessorControl'
      
        '                              + CAST(@TransactionCount AS VARCHA' +
        'R(10))'
      
        '                              + @LTCServiceProvIDQual + @LTCServ' +
        'iceProvID + @datefilled + @SoftwareVendorID;'
      ''
      '            EXEC dbo.D0_SEG04_Insurance_schema'
      '                  @otc_number      = @otc_number'
      '                , @schema          = @schema'
      '                , @TransactionCode = @TransactionCode'
      '                , @segment_str     = @seg04_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg04_str, '#39#39');'
      ''
      '            IF @claim_reversal = 0'
      '            BEGIN'
      '                EXEC dbo.D0_SEG01_Patient_schema'
      '                      @otc_number      = @otc_number'
      '                    , @schema          = @schema'
      '                    , @TransactionCode = @TransactionCode'
      '                    , @segment_str     = @seg01_str OUTPUT;'
      ''
      '                SET @send_str += ISNULL(@seg01_str, '#39#39');'
      '            END'
      '        END'
      ''
      '        /* -----------------------------------------------------'
      '           CLAIM SEPARATOR'
      
        '           -----------------------------------------------------' +
        ' */'
      '        SET @send_str += CHAR(29);'
      ''
      '        /* -----------------------------------------------------'
      '           SEGMENT 07'
      
        '           -----------------------------------------------------' +
        ' */'
      '        EXEC dbo.D0_SEG07_Claim_schema'
      '              @otc_number      = @otc_number'
      '            , @schema          = @schema'
      '            , @TransactionCode = @TransactionCode'
      '            , @segment_str     = @seg07_str OUTPUT;'
      ''
      '        SET @send_str += ISNULL(@seg07_str, '#39#39');'
      ''
      '        /* -----------------------------------------------------'
      '           SEGMENT 11'
      
        '           -----------------------------------------------------' +
        ' */'
      '        IF @claim_reversal = 0'
      '        BEGIN'
      '            EXEC dbo.D0_SEG11_Pricing_schema'
      '                  @otc_number      = @otc_number'
      '                , @schema          = @schema'
      '                , @TransactionCode = @TransactionCode'
      '                , @segment_str     = @seg11_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg11_str, '#39#39');'
      ''
      '            /* -------------------------------------------------'
      '               SEGMENT 02 (KEPT INLINE, PER YOUR REQUEST)'
      
        '               -------------------------------------------------' +
        ' */'
      '            SET @send_str += @segment_separator + @FS + '#39'AM02'#39';'
      ''
      '            IF @LTC = 1'
      '            BEGIN'
      
        '                IF RTRIM(ISNULL(@LTCServiceProvIDQual, '#39#39')) <> '#39 +
        #39
      
        '                    SET @send_str += @FS + '#39'EY'#39' + RTRIM(UPPER(@L' +
        'TCServiceProvIDQual));'
      ''
      '                IF RTRIM(ISNULL(@LTCServiceProvID, '#39#39')) <> '#39#39
      
        '                    SET @send_str += @FS + '#39'E9'#39' + RTRIM(UPPER(@L' +
        'TCServiceProvID));'
      '            END'
      '            ELSE'
      '            BEGIN'
      '                IF RTRIM(ISNULL(@ServiceProvIDQual, '#39#39')) <> '#39#39
      
        '                    SET @send_str += @FS + '#39'EY'#39' + RTRIM(UPPER(@S' +
        'erviceProvIDQual));'
      ''
      '                IF RTRIM(ISNULL(@ServiceProvID, '#39#39')) <> '#39#39
      
        '                    SET @send_str += @FS + '#39'E9'#39' + RTRIM(UPPER(@S' +
        'erviceProvID));'
      '            END'
      ''
      '            /* -------------------------------------------------'
      '               SEGMENT 03'
      
        '               -------------------------------------------------' +
        ' */'
      '            EXEC dbo.D0_SEG03_Prescriber_schema'
      '                  @otc_number      = @otc_number'
      '                , @schema          = @schema'
      '                , @TransactionCode = @TransactionCode'
      '                , @segment_str     = @seg03_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg03_str, '#39#39');'
      '        END'
      ''
      '        /* -----------------------------------------------------'
      '           SEGMENT 05 COB'
      
        '           -----------------------------------------------------' +
        ' */'
      '        EXEC dbo.D0_SEG05_COB_schema'
      '              @otc_number      = @otc_number'
      '            , @schema          = @schema'
      '            , @TransactionCode = @TransactionCode'
      '            , @segment_str     = @seg05_str OUTPUT;'
      ''
      '        SET @send_str += ISNULL(@seg05_str, '#39#39');'
      ''
      '        /* -----------------------------------------------------'
      '           OTHER SEGMENTS'
      
        '           -----------------------------------------------------' +
        ' */'
      '        IF @TransactionCode = '#39'B1'#39
      '        BEGIN'
      '            EXEC dbo.D0_SEG06_WorkersComp_schema'
      '                  @otc_number      = @otc_number'
      '                , @schema          = @schema'
      '                , @TransactionCode = @TransactionCode'
      '                , @segment_str     = @seg06_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg06_str, '#39#39');'
      ''
      '            EXEC dbo.D0_SEG08_DUR_schema'
      '                  @otc_number      = @otc_number'
      '                , @schema          = @schema'
      '                , @TransactionCode = @TransactionCode'
      '                , @segment_str     = @seg08_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg08_str, '#39#39');'
      ''
      '            IF RTRIM(ISNULL(@cupon_type, '#39#39')) <> '#39#39
      '            BEGIN'
      
        '                SET @send_str += @segment_separator + @FS + '#39'AM0' +
        '9'#39';'
      ''
      '                IF RTRIM(ISNULL(@cupon_type, '#39#39')) <> '#39#39
      
        '                    SET @send_str += @FS + '#39'KE'#39' + RTRIM(UPPER(@c' +
        'upon_type));'
      ''
      '                IF RTRIM(ISNULL(@cupon_number, '#39#39')) <> '#39#39
      
        '                    SET @send_str += @FS + '#39'ME'#39' + RTRIM(UPPER(@c' +
        'upon_number));'
      ''
      '                IF ISNULL(@cupon_amt, 0) > 0'
      
        '                    SET @send_str += @FS + '#39'NE'#39' + RTRIM(dbo.fn_D' +
        '0_GetFloatCharacter(@cupon_amt));'
      '            END'
      ''
      
        '            /* -------------------------------------------------' +
        '----'
      '             SEGMENT 10 - COMPOUND'
      
        '            ----------------------------------------------------' +
        '- */'
      '            EXEC dbo.D0_SEG10_Compound_schema'
      '                  @otc_number   = @otc_number'
      '                , @segment_str  = @seg10_str OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@seg10_str, '#39#39');'
      '            '
      '            EXEC dbo.D0_Clinical_Segment'
      '                  @otcnumber   = @otc_number'
      '                , @clinical_str = @clinicalstr OUTPUT;'
      ''
      '            SET @send_str += ISNULL(@clinicalstr, '#39#39');'
      '            '
      '        END'
      ''
      '        /* -----------------------------------------------------'
      '           PAYLOAD SUPPORT DATA'
      
        '           -----------------------------------------------------' +
        ' */'
      '        SELECT'
      '            @pat_id = ISNULL(PA.IDENTIFICACION, '#39#39')'
      '        FROM dbo.PACIENTES PA'
      '        WHERE PA.NUMEROCLIENTE = @customer_no;'
      ''
      '        SELECT'
      '            @prescriber_no = ISNULL(P.NUMERODOCTOR, 0)'
      '        FROM dbo.PRESCRIPTIONS P'
      '        WHERE P.NUMERORECETA = @norx;'
      ''
      '        SELECT'
      '            @presc_dea = ISNULL(D.DEA_FEDERAL, '#39#39'),'
      '            @presc_npi = ISNULL(D.NPI, '#39#39')'
      '        FROM dbo.DOCTOR D'
      '        WHERE D.NUMERODOCTOR = @prescriber_no;'
      ''
      
        '        IF RTRIM(ISNULL(@schedule_drug, '#39#39')) IN ('#39'RX'#39', '#39'OTC'#39', '#39'D' +
        'ME'#39')'
      
        '            SET @rx_expiration_date = DATEADD(DAY, 365, @DateRXW' +
        'ritten);'
      '        ELSE'
      
        '            SET @rx_expiration_date = DATEADD(DAY, 180, @DateRXW' +
        'ritten);'
      ''
      '        SELECT @x_pat_id = ('
      
        '            SELECT CAST(ISNULL(@pat_id, '#39#39') AS NVARCHAR(MAX)) AS' +
        ' [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_drug_sig = ('
      
        '            SELECT CAST(ISNULL(@drug_sig, '#39#39') AS NVARCHAR(MAX)) ' +
        'AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_drug_name = ('
      
        '            SELECT CAST(ISNULL(@drug_name, '#39#39') AS NVARCHAR(MAX))' +
        ' AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_presc_dea = ('
      
        '            SELECT CAST(ISNULL(@presc_dea, '#39#39') AS NVARCHAR(MAX))' +
        ' AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_presc_npi = ('
      
        '            SELECT CAST(ISNULL(@presc_npi, '#39#39') AS NVARCHAR(MAX))' +
        ' AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_insurance_name = ('
      
        '            SELECT CAST(ISNULL(@insurance_name, '#39#39') AS NVARCHAR(' +
        'MAX)) AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_insurance_code = ('
      
        '            SELECT CAST(ISNULL(@insurance_code, '#39#39') AS NVARCHAR(' +
        'MAX)) AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SELECT @x_schedule_drug = ('
      
        '            SELECT CAST(ISNULL(@schedule_drug, '#39#39') AS NVARCHAR(M' +
        'AX)) AS [text()]'
      '            FOR XML PATH('#39#39'), TYPE'
      '        ).value('#39'.'#39', '#39'NVARCHAR(MAX)'#39');'
      ''
      '        SET @rxpayload += '#39'<ExtraPayloadData>'#39';'
      
        '        SET @rxpayload += '#39'<RxNumber>'#39' + RTRIM(CAST(@norx AS VAR' +
        'CHAR(10))) + '#39'</RxNumber>'#39';'
      
        '        SET @rxpayload += '#39'<FillNumber>'#39' + RTRIM(CAST(ISNULL(@ne' +
        'w_ref_code,0) AS VARCHAR(10))) + '#39'</FillNumber>'#39';'
      
        '        SET @rxpayload += '#39'<AWP>'#39' + RTRIM(CAST(ISNULL(@gross_amo' +
        'unt_due,0) AS VARCHAR(20))) + '#39'</AWP>'#39';'
      '        SET @rxpayload += '#39'<NHFlag></NHFlag>'#39';'
      '        SET @rxpayload += '#39'<Language>ENG</Language>'#39';'
      '        SET @rxpayload += '#39'<GenericFlag>Y</GenericFlag>'#39';'
      
        '        SET @rxpayload += '#39'<AAC>'#39' + RTRIM(CAST(ISNULL(@ing_cost,' +
        '0) AS VARCHAR(20))) + '#39'</AAC>'#39';'
      
        '        SET @rxpayload += '#39'<PatientId>'#39' + ISNULL(@x_pat_id,'#39#39') +' +
        ' '#39'</PatientId>'#39';'
      
        '        SET @rxpayload += '#39'<DrugSig>'#39' + ISNULL(@x_drug_sig,'#39#39') +' +
        ' '#39'</DrugSig>'#39';'
      
        '        SET @rxpayload += '#39'<DrugName>'#39' + ISNULL(@x_drug_name,'#39#39')' +
        ' + '#39'</DrugName>'#39';'
      
        '        SET @rxpayload += '#39'<PrescDEA>'#39' + ISNULL(@x_presc_dea,'#39#39')' +
        ' + '#39'</PrescDEA>'#39';'
      
        '        SET @rxpayload += '#39'<PrescNPI>'#39' + ISNULL(@x_presc_npi,'#39#39')' +
        ' + '#39'</PrescNPI>'#39';'
      
        '        SET @rxpayload += '#39'<PlanName>'#39' + ISNULL(@x_insurance_nam' +
        'e,'#39#39') + '#39'</PlanName>'#39';'
      
        '        SET @rxpayload += '#39'<PlanCode>'#39' + ISNULL(@x_insurance_cod' +
        'e,'#39#39') + '#39'</PlanCode>'#39';'
      '        SET @rxpayload += '#39'<NHPhone></NHPhone>'#39';'
      '        SET @rxpayload += '#39'<InvName></InvName>'#39';'
      
        '        SET @rxpayload += '#39'<DrugSched>'#39' + ISNULL(@x_schedule_dru' +
        'g,'#39#39') + '#39'</DrugSched>'#39';'
      
        '        SET @rxpayload += '#39'<RefillsRemain>'#39' + RTRIM(CAST(ISNULL(' +
        '@ref_remaining,0) AS VARCHAR(10))) + '#39'</RefillsRemain>'#39';'
      
        '        SET @rxpayload += '#39'<ExpirationDate>'#39' + CONVERT(VARCHAR(1' +
        '0), @rx_expiration_date, 101) + '#39'</ExpirationDate>'#39';'
      
        '        SET @rxpayload += '#39'<NHWing></NHWing><NHRoom></NHRoom><NH' +
        'Bed></NHBed><RxOtc>R</RxOtc></ExtraPayloadData>'#39';'
      ''
      '        SET @rxcounter += 1;'
      '    END'
      ''
      '    SET @SendText = @send_str;'
      '    SET @rxpayload += '#39'</ArrayOfExtraPayloadData>'#39';'
      'END')
    Left = 7200
    Top = 96
  end
  object D0_COB_segment_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'Create Procedure [dbo].[D0_COB_segment_schema] @otc_number int, ' +
        ' @schema char(3), @TransactionCode char(2),'
      '@COB_string varchar(4000) OUTPUT'
      'as'
      'declare @temp_value char(20)'
      'declare @cobA_counter int =1;'
      'declare @cobA_totalrows int'
      'declare @TotalRows int'
      'declare @counter_segments int'
      'declare @defaultvalue nchar(20)'
      'declare @field int'
      'declare @ncpdp char(6)'
      '-- COB_A ----------------------------'
      'declare @COBATotalRows int;'
      'declare @segment_separator char(1);'
      'declare @FS char(1);'
      'declare @COB_338_5C char(2)'
      'declare @COB_339_6C char(2)'
      'declare @COB_340_7C char(10)'
      'declare @COB_443_E8 date '
      'declare @COB_993_A7 nchar(30)'
      'declare @COB_Bcount int'
      'declare @notrans int'
      '--COB_B------------------------------'
      'declare @COBBTotalRows int;'
      'declare @cobB_counter int =1;'
      'declare @cobB_totalrows int'
      'declare @COB_342_HC char(2)'
      'declare @COB_431_DV float'
      '--COB_C------------------------------'
      'declare @cobC_counter int =1;'
      'declare @cobC_totalrows int'
      'declare @COB_Ccount int'
      'declare @COB_472_6E NCHAR(3)'
      'DECLARE @BatchSize INT = 1; -- Process one row at a time'
      'DECLARE @Offset INT = 0;'
      'DECLARE @ID INT'
      '--COB_D------------------------------'
      'declare @cobD_counter int =1;'
      'declare @cobD_totalrows int'
      'declare @COB_Dcount int '
      'declare @COB_351_NP char(2)'
      'declare @COB_352_NQ float'
      'declare @cob_segment_string varchar(500)'
      '--COB_E-------------------------------'
      'declare @cobE_counter int =1;'
      'declare @cobE_totalrows int'
      'declare @COB_Ecount int'
      'declare @COB_393_MV char(2)'
      'declare @COB_394_MW float'
      'declare @RowCounter int'
      'declare @StatusDescription VARCHAR(50);'
      'begin'
      '  '#9'SET NOCOUNT ON;'
      #9'set @RowCounter = 0;'
      
        #9'select @cobA_totalrows = count(*) from COB_A where otcnumber = ' +
        '@otc_number'
      #9'if @cobA_totalrows > 0'
      #9'begin'
      #9#9'set @segment_separator = char(30);'
      #9#9'set @FS = char(28);'
      #9#9'set @COB_string = @segment_separator + @FS + '#39'AM'#39' + '#39'05'#39';'
      
        #9#9'set @COB_string +=  @FS + '#39'4C'#39' + cast(@cobA_totalrows as varch' +
        'ar) -- 337-4C'
      #9#9'while @cobA_counter <= @cobA_totalrows'
      #9#9'begin'
      
        #9#9#9'Select @COB_338_5C = COB_338_5C, @COB_339_6C = COB_339_6C, @C' +
        'OB_340_7C = COB_340_7C, @COB_443_E8 = COB_443_E8, '
      #9#9#9#9#9'@COB_993_A7 = COB_993_A7, @notrans = NOTRANS from COB_A '
      #9#9#9'where OTCNUMBER = @otc_number'
      #9#9#9'order by NOTRANS'
      #9#9#9'OFFSET @cobA_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      
        #9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 = r' +
        'trim(@schema) and SEGMENT = '#39'05'#39' and TR = @TransactionCode;'#9#9#9' '
      #9#9#9'set @counter_segments = 1;'#9
      #9#9#9'if @TotalRows > 0'
      #9#9#9'begin'
      #9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9'begin'
      #9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'
      #9#9#9#9'FROM [dbo].[INSSCHEMA]'
      
        #9#9#9#9'where SCHEMA1 = @schema and SEGMENT = '#39'05'#39' and TR = @Transac' +
        'tionCode'
      #9#9#9#9'ORDER BY [ID]'
      #9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      
        #9#9#9#9'Select @ncpdp = rtrim(NCPDP) FROM NCPDP WHERE FIELD = @FIELD' +
        ';'
      
        #9#9#9#9'IF (@ncpdp = '#39'338-5C'#39') and (@COB_338_5C > '#39#39') set @COB_strin' +
        'g += @FS + '#39'5C'#39' + rtrim(upper(@COB_338_5C)) else'
      #9#9#9#9'if @TransactionCode <> '#39'B2'#39
      #9#9#9'    begin'
      
        #9#9#9#9#9'IF (@ncpdp = '#39'339-6C'#39') and (@COB_339_6C > '#39#39') set @COB_stri' +
        'ng += @FS + '#39'6C'#39' + rtrim(upper(@COB_339_6C)) else'
      
        #9#9#9#9#9'IF (@ncpdp = '#39'340-7C'#39') and (@COB_340_7C > '#39#39') set @COB_stri' +
        'ng += @FS + '#39'7C'#39' + rtrim(upper(@COB_340_7C)) else'
      
        #9#9#9#9#9'IF (@ncpdp = '#39'443-E8'#39') and (@COB_340_7C > '#39#39') set @COB_stri' +
        'ng += @FS + '#39'E8'#39' + FORMAT(@COB_443_E8, '#39'yyyyMMdd'#39') else'
      
        #9#9#9#9#9'IF (@ncpdp = '#39'993-A7'#39') and (@COB_340_7C > '#39#39') set @COB_340_' +
        '7C += @FS + '#39'A7'#39' + rtrim(upper(@COB_340_7C));'
      #9#9#9#9'end;'
      #9#9#9#9'SET @counter_segments = @counter_segments + 1;'
      #9#9#9'end;'
      #9#9#9'end;'
      #9#9#9'if @TransactionCode <> '#39'B2'#39
      #9#9#9'begin'
      
        #9#9#9#9'--COB_B ----------------------------------------------------' +
        '-------'
      #9#9#9#9'set @cobB_counter = 1'
      
        #9#9#9#9'select @cobB_totalrows = count(*) from COB_B where NOTRANS =' +
        ' @notrans;'
      #9#9#9#9'if @cobB_totalrows > 0 '
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'HB'#39' + rtrim(CAST(@cobB_totalrows ' +
        'AS VARCHAR(2))) ; -- 341-HB'#9#9#9#9
      #9#9#9#9#9'While @cobB_counter <= @cobB_totalrows'
      #9#9#9#9#9'begin'
      
        #9#9#9#9#9#9'Select @COB_342_HC = COB_342_HC, @COB_431_DV  = COB_431_DV' +
        ' from COB_B '
      #9#9#9#9#9#9'where NOTRANS = @notrans'
      #9#9#9#9#9#9'order by NOTRANS'
      #9#9#9#9#9#9'OFFSET @cobB_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'#9
      
        #9#9#9#9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 ' +
        '= rtrim(@schema) and SEGMENT = '#39'05'#39' and TR = @TransactionCode;'
      #9#9#9#9#9#9'set @counter_segments = 1;'#9#9#9#9#9#9#9#9#9'    '
      #9#9#9#9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'
      #9#9#9#9#9#9#9'FROM [dbo].[INSSCHEMA]'
      
        #9#9#9#9#9#9#9'where SCHEMA1 = @schema and SEGMENT = '#39'05'#39' and TR = @Tran' +
        'sactionCode'
      #9#9#9#9#9#9#9'ORDER BY [ID]'
      #9#9#9#9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      
        #9#9#9#9#9#9#9'Select @ncpdp = rtrim(NCPDP) FROM NCPDP WHERE FIELD = @FI' +
        'ELD;'
      #9#9#9#9#9#9#9'if (@ncpdp = '#39'342-HC'#39') and (rtrim(@COB_342_HC) > '#39#39') '
      #9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9'set @COB_string += @FS + '#39'HC'#39' + rtrim(upper(@COB_342_HC))' +
        '; '
      #9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'if (@ncpdp = '#39'431-DV'#39') '
      #9#9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9#9'if @COB_431_DV >= 0 '
      #9#9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9#9'  exec dbo.D0_GetFloatCharacter @COB_431_DV, @outputToke' +
        'n = @temp_value output;'
      
        #9#9#9#9#9#9#9#9'  set @COB_string +=  @FS + '#39'DV'#39' + rtrim(@temp_value); -' +
        '- 431-DV'
      #9#9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'SET @counter_segments = @counter_segments + 1;'
      #9#9#9#9#9#9'end'
      #9#9#9#9#9#9'set @cobB_counter = @cobB_counter + 1;'
      #9#9#9#9#9'end;'#9
      #9#9#9#9'end;'
      
        #9#9#9#9'--COB_C ----------------------------------------------------' +
        '-------'
      #9#9#9#9'-- Get total row count'#9#9#9
      
        #9#9#9#9'SELECT @TotalRows = COUNT(*) FROM dbo.COB_C where NOTRANS = ' +
        '@notrans;'
      #9#9#9#9'if @TotalRows > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'5E'#39' + rtrim(CAST(@TotalRows AS VA' +
        'RCHAR(2))); --471-5E'
      #9#9#9#9#9'WHILE @Offset < @TotalRows'
      #9#9#9#9#9'BEGIN'
      #9#9#9#9#9#9'-- Read one record with OFFSET-FETCH'
      #9#9#9#9#9#9'SELECT @ID = ID, @COB_472_6E = isNull(COB_472_6E,'#39#39') '
      #9#9#9#9#9#9'FROM dbo.COB_C '
      #9#9#9#9#9#9'where NOTRANS = @NOTRANS'
      #9#9#9#9#9#9'ORDER BY ID'
      #9#9#9#9#9#9'OFFSET @Offset ROWS FETCH NEXT @BatchSize ROWS ONLY;'
      
        #9#9#9#9#9#9'If @COB_472_6E > '#39#39' set @COB_string += @FS + '#39'6E'#39' + rtrim(' +
        'upper(@COB_472_6E));'
      #9#9#9#9#9#9'SET @Offset = @Offset + @BatchSize;'
      #9#9#9#9#9'END'
      #9#9#9#9'end;'
      
        #9#9#9#9'--COB_D ----------------------------------------------------' +
        '-------'
      
        #9#9#9#9'select @cobD_totalrows = count(*) from COB_D where NOTRANS =' +
        ' @notrans; '
      #9#9#9#9'if @cobD_totalrows > 0'
      #9#9#9#9'begin'
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'NR'#39' + rtrim(CAST(@cobD_totalrows ' +
        'AS VARCHAR(2))); --353-NR'#9#9#9#9
      
        #9#9#9#9#9'Select @COB_351_NP = COB_351_NP, @COB_352_NQ = COB_352_NQ  ' +
        'FROM COB_D '
      #9#9#9#9#9'where NOTRANS = @notrans   '
      #9#9#9#9#9'order by NOTRANS'
      #9#9#9#9#9'OFFSET @cobD_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'#9#9#9#9
      #9#9#9#9#9'while @cobD_counter <= @cobD_totalrows'
      #9#9#9#9#9'BEGIN'#9#9#9#9#9#9#9#9' '
      
        #9#9#9#9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 ' +
        '= @schema and SEGMENT = '#39'05'#39' and TR = @TransactionCode;'#9
      #9#9#9#9#9#9'set @counter_segments = 1;'
      #9#9#9#9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'#9
      
        #9#9#9#9#9#9#9'FROM [dbo].[INSSCHEMA] where SCHEMA1 = @schema and SEGMEN' +
        'T = '#39'05'#39' and TR = @TransactionCode'
      #9#9#9#9#9#9#9'ORDER BY [ID]'
      #9#9#9#9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      ''
      
        #9#9#9#9#9#9#9'Select @ncpdp = NCPDP FROM NCPDP WHERE FIELD = @FIELD;'#9#9#9 +
        #9#9#9
      #9#9#9#9#9#9#9'if @ncpdp = '#39'351-NP'#39' '
      #9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9#9'if @COB_351_NP > '#39#39' set @COB_string += @FS + '#39'NP'#39' + rtri' +
        'm(upper(@COB_351_NP)); -- 351-NP  '
      #9#9#9#9#9#9#9'end'
      #9#9#9#9#9#9#9'else'
      #9#9#9#9#9#9#9'if @ncpdp = '#39'352-NQ'#39' '
      #9#9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9#9'if @COB_352_NQ >= 0 '
      #9#9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_352_NQ, @outputToken' +
        ' = @temp_value output;'
      
        #9#9#9#9#9#9#9#9#9'set @COB_string += @FS + '#39'NQ'#39' + rtrim(@temp_value); -- ' +
        '352-NQ'
      #9#9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'set @counter_segments = @counter_segments + 1;'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'set @cobD_counter = @cobD_counter + 1;'
      #9#9#9#9#9'end;'
      #9#9#9#9'end;'
      #9#9#9
      
        #9#9#9#9'--COB_E-----------------------------------------------------' +
        '-------------'
      
        #9#9#9#9'select @cobE_totalrows = count(*) from COB_E where NOTRANS =' +
        ' @notrans; '
      #9#9#9#9'if @cobE_totalrows > 0'
      #9#9#9#9'begin'#9#9#9#9
      
        #9#9#9#9#9'set @COB_string += @FS + '#39'MU'#39' + rtrim(CAST(@cobD_totalrows ' +
        'AS VARCHAR(2))); --392-MU'
      
        #9#9#9#9#9'SELECT @COB_393_MV = COB_393_MV, @COB_394_MW = COB_394_MW F' +
        'ROM COB_E '
      #9#9#9#9#9'where NOTRANS = @notrans'
      #9#9#9#9#9'order by NOTRANS'
      #9#9#9#9#9'OFFSET @cobE_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      #9#9#9#9#9'while @cobE_counter <= @cobE_totalrows'
      #9#9#9#9#9'BEGIN'
      
        #9#9#9#9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 ' +
        '= @schema and SEGMENT = '#39'05'#39' and TR = @TransactionCode;'#9#9#9' '
      #9#9#9#9#9#9'set @counter_segments = 1;'
      #9#9#9#9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'
      #9#9#9#9#9#9#9'FROM [dbo].[INSSCHEMA]'
      
        #9#9#9#9#9#9#9'where SCHEMA1 = @schema and SEGMENT = '#39'05'#39' and TR = @Tran' +
        'sactionCode'
      #9#9#9#9#9#9#9'ORDER BY [ID]'
      #9#9#9#9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      #9#9#9#9#9#9#9'Select @ncpdp = NCPDP FROM NCPDP WHERE FIELD = @FIELD;'
      #9#9#9#9#9#9#9'if @ncpdp = '#39'393-MV'#39' '
      #9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9#9'if @COB_393_MV > '#39#39' set @COB_string += @FS + '#39'MV'#39' + rtri' +
        'm(upper(@COB_393_MV)); -- 393-MV  '
      #9#9#9#9#9#9#9'end'
      #9#9#9#9#9#9#9'else'
      #9#9#9#9#9#9#9'if @ncpdp = '#39'394-MW'#39' '
      #9#9#9#9#9#9#9'begin'
      #9#9#9#9#9#9#9#9'if @COB_394_MW >= 0 '
      #9#9#9#9#9#9#9#9'begin'
      
        #9#9#9#9#9#9#9#9#9'exec dbo.D0_GetFloatCharacter @COB_394_MW, @outputToken' +
        ' = @temp_value output;'
      
        #9#9#9#9#9#9#9#9#9'set @COB_string += @FS + '#39'MW'#39' + rtrim(@temp_value); -- ' +
        '394-MW'
      #9#9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'end;'
      #9#9#9#9#9#9#9'set @counter_segments = @counter_segments + 1;'
      #9#9#9#9#9#9'end;'
      #9#9#9#9#9#9'set @cobE_counter = @cobE_counter + 1;'
      #9#9#9#9#9'end'
      #9#9#9#9'end;'#9
      #9#9#9'end;'#9
      #9#9#9'SET @cobA_counter = @cobA_counter + 1;'
      #9#9'end;'#9#9#9#9
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @COB_string = '#39#39';'
      #9'end;'
      'end;')
    Left = 6688
    Top = 160
  end
  object D0_DUR_Segment_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[D0_DUR_Segment_schema] @otcnumber int, @' +
        'billing_type char(2), '
      
        '@schema char(3), @TransactionCode char(2), @dur_str varchar(500)' +
        ' output '
      'AS'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @reasonfor_servcode char(2)'
      'declare @prof_serv_code char(2)'
      'declare @resu_ofserv_code char(2)'
      'declare @dur_ppslevel_ofeffort char(2)'
      'declare @dur_coagent_idqual char(2)'
      'declare @dur_coagent_id char(19)'
      'declare @counter int'
      '--------------------------------'
      'declare @dur_counter int =1;'
      'declare @dur_totalrows int'
      'declare @TotalRows int'
      'declare @counter_segments int'
      'declare @defaultvalue nchar(20)'
      'declare @field int'
      'declare @ncpdp char(6)'
      ''
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      #9'set @counter = 1;'
      
        #9'Select @dur_totalrows = count(*) from DUR_PPS with (NOLOCK) whe' +
        're OTCNUMBER = @otcnumber;'
      #9'if @dur_totalrows > 0'
      #9'begin'
      #9#9'set @dur_str = @segment_separator + @FS + '#39'AM'#39' + '#39'08'#39';'#9#9#9#9
      #9#9'while @dur_counter <= @dur_totalrows'
      #9#9'begin'
      
        #9#9#9'SELECT @reasonfor_servcode = REASONFOR_SERVCODE, @prof_serv_c' +
        'ode = PROF_SERVICE_CODE, '
      
        #9#9#9'@resu_ofserv_code = RESULT_OFSERVICE_CODE, @dur_ppslevel_ofef' +
        'fort = DUR_PPSLEVELOFEFFORT, '
      #9#9#9'@dur_coagent_idqual = DUR_COAGENT_IDQUAL, '
      #9#9#9'@dur_coagent_id = DUR_COAGENTID '
      #9#9#9'from DUR_PPS where OTCNUMBER = @otcnumber'
      #9#9#9'order by OTCNUMBER'
      #9#9#9'OFFSET @dur_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      #9#9
      
        #9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 = @' +
        'schema and SEGMENT = '#39'08'#39' and TR = @TransactionCode;'#9#9#9' '
      #9#9#9'set @counter_segments = 1;'
      #9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9'begin'
      #9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'
      #9#9#9#9'FROM [dbo].[INSSCHEMA]'
      
        #9#9#9#9'where SCHEMA1 = @schema and SEGMENT = '#39'08'#39' and TR = @Transac' +
        'tionCode'
      #9#9#9#9'ORDER BY [ID]'
      #9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      #9#9#9#9'Select @ncpdp = NCPDP FROM NCPDP WHERE FIELD = @FIELD;'
      
        #9#9#9#9'if (@ncpdp = '#39'473-7E'#39') and (@counter > '#39#39') set @dur_str += @' +
        'FS + '#39'7E'#39' + cast(@counter as varchar) else -- 473-7E;'
      
        #9#9#9#9'if (@ncpdp = '#39'439-E4'#39') and (rtrim(upper(@reasonfor_servcode)' +
        ') > '#39#39')  set @dur_str += @FS + '#39'E4'#39' + rtrim(upper(@reasonfor_ser' +
        'vcode)) else -- 439-E4'
      
        #9#9#9#9'if (@ncpdp = '#39'440-E5'#39') and (rtrim(upper(@prof_serv_code)) > ' +
        #39#39')  set @dur_str += @FS + '#39'E5'#39' + rtrim(upper(@prof_serv_code)) ' +
        'else -- 44'#216'-E5'
      
        #9#9#9#9'if (@ncpdp = '#39'441-E6'#39') and (rtrim(upper(@resu_ofserv_code)) ' +
        '> '#39#39')  set @dur_str += @FS + '#39'E6'#39' + rtrim(upper(@resu_ofserv_cod' +
        'e)) else -- 441-E6'
      
        #9#9#9#9'if (@ncpdp = '#39'474-8E'#39') and (rtrim(upper(@dur_ppslevel_ofeffo' +
        'rt)) > '#39#39')  set @dur_str += @FS + '#39'8E'#39' + rtrim(upper(@dur_ppslev' +
        'el_ofeffort)) else -- 474-8E'
      
        #9#9#9#9'if (@ncpdp = '#39'475-J9'#39') and (rtrim(upper(@dur_coagent_idqual)' +
        ') > '#39#39')  set @dur_str += @FS + '#39'J9'#39' + rtrim(upper(@dur_coagent_i' +
        'dqual)) else -- 475-J9'
      
        #9#9#9#9'if (@ncpdp = '#39'476-H6'#39') and (rtrim(upper(@dur_coagent_id)) > ' +
        #39#39')  set @dur_str += @FS + '#39'H6'#39' + rtrim(upper(@dur_coagent_id));' +
        ' -- 475-J9'
      #9#9#9#9'SET @counter_segments = @counter_segments + 1;'
      #9#9#9'end;'
      #9#9#9'set @dur_counter = @dur_counter + 1;'#9#9#9
      #9#9'end;'
      #9'end'
      #9'else'
      #9'begin'
      #9'  set @dur_str = '#39#39';'
      #9'end;'
      'END;')
    Left = 6680
    Top = 248
  end
  object D0_Workers_compensation_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[D0_Workers_compensation_schema] @otcnumb' +
        'er int, '
      
        '@schema char(3), @TransactionCode char(2), @workers_comp_str var' +
        'char(1000) output '
      'AS'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @date_of_injury date'
      'declare @emp_name nchar(30)'
      'declare @emp_street_add nchar(30)'
      'declare @emp_city nchar(20)'
      'declare @emp_state char(2)'
      'declare @emp_zip nchar(15)'
      'declare @emp_phone nchar(10)'
      'declare @emp_contact_name nchar(30)'
      'declare @carrier_id nchar(10)'
      'declare @claim_ref_id nchar(30)'
      'declare @bill_entity_typeindi char(2)'
      'declare @pay_to_qual char(2)'
      'declare @pay_to_id nchar(15)'
      'declare @pay_to_name nchar(20)'
      'declare @pay_to_street nchar(30)'
      'declare @pay_to_city nchar(20)'
      'declare @pay_to_state char(2)'
      'declare @pay_to_zip nchar(15)'
      'declare @gen_eq_prodid_qual char(2)'
      'declare @gen_eq_prodid nchar(19)'
      '----------------------------------'
      'declare @wc_counter int =1;'
      'declare @wc_totalrows int'
      'declare @TotalRows int'
      'declare @counter_segments int'
      'declare @defaultvalue nchar(20)'
      'declare @field int'
      'declare @ncpdp char(6)'
      ''
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      
        #9'select @wc_totalrows = count(*) from WORKERS_COMPENSATION_SEGME' +
        'NT where OTC_NUMBER = @otcnumber;'
      #9'set @workers_comp_str = '#39#39';'
      #9'if @wc_totalrows > 0'
      #9'begin'
      
        #9#9'set @workers_comp_str = @segment_separator + @FS + '#39'AM'#39' + '#39'06'#39 +
        ';'#9'  '#9
      #9#9'while @wc_counter <= @wc_totalrows'
      #9#9'begin'
      
        #9#9#9'SELECT @date_of_injury = DATE_OF_INJURY, @emp_name = EMPLOYER' +
        '_NAME, @emp_street_add = EMP_STREET_ADDRESS,'
      
        #9#9#9'@emp_city = EMP_CITY, @emp_state = EMP_STATE, @emp_zip = EMP_' +
        'ZIP, @emp_phone = EMP_PHONE, @emp_contact_name = EMP_CONTACT_NAM' +
        'E, '
      
        #9#9#9'@carrier_id = CARRIER_ID, @claim_ref_id = CLAIM_REFERENCE_ID,' +
        ' @bill_entity_typeindi = BILLING_ENTITY_TYPE_INDICATOR, '
      
        #9#9#9'@pay_to_qual = PAY_TO_QUALIFIER, @pay_to_id = PAY_TO_ID, @pay' +
        '_to_name = PAY_TO_NAME, @pay_to_street = PAY_TO_STREET_ADDRESS, '
      
        #9#9#9'@pay_to_city = PAY_TO_CITY_ADDRESS, @pay_to_state = PAY_TO_ST' +
        'ATE, @pay_to_zip = PAY_TO_ZIP, '
      
        #9#9#9'@gen_eq_prodid_qual = GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER' +
        ', @gen_eq_prodid = GENERIC_EQUIVALENT_PRODUCT_ID'
      
        #9#9#9'from WORKERS_COMPENSATION_SEGMENT where OTC_NUMBER = @otcnumb' +
        'er'#9#9#9
      #9#9#9'order by OTC_NUMBER'
      #9#9#9'OFFSET @wc_counter - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      
        #9#9#9'SELECT @TotalRows = COUNT(*) FROM INSSCHEMA WHERE SCHEMA1 = @' +
        'schema and SEGMENT = '#39'06'#39' and TR = @TransactionCode;'#9#9#9' '
      #9#9#9'set @counter_segments = 1;'
      #9#9#9'while @counter_segments <= @TotalRows'
      #9#9#9'begin'
      #9#9#9#9'SELECT @field = [FIELD], @defaultvalue = [defaultvalue]'
      #9#9#9#9'FROM [dbo].[INSSCHEMA]'
      
        #9#9#9#9'where SCHEMA1 = @schema and SEGMENT = '#39'06'#39' and TR = @Transac' +
        'tionCode'
      #9#9#9#9'ORDER BY [ID]'
      #9#9#9#9'OFFSET @counter_segments - 1 ROWS FETCH NEXT 1 ROW ONLY;'
      #9#9#9#9'Select @ncpdp = NCPDP FROM NCPDP WHERE FIELD = @FIELD;'
      
        #9#9#9#9'if (@ncpdp = '#39'315-CF'#39') and (rtrim(@emp_name) > '#39#39') set @work' +
        'ers_comp_str += @FS + '#39'CF'#39' + rtrim(upper(@emp_name)) else -- 315' +
        '-CF'
      
        #9#9#9#9'if (@ncpdp = '#39'316-CG'#39') and (rtrim(@emp_street_add) > '#39#39')  se' +
        't @workers_comp_str += @FS + '#39'CG'#39' + rtrim(upper(@emp_street_add)' +
        ') else -- 316-CG'
      
        #9#9#9#9'if (@ncpdp = '#39'317-CH'#39') and (rtrim(@emp_city)  > '#39#39') set @wor' +
        'kers_comp_str += @FS + '#39'CH'#39' + rtrim(upper(@emp_city)) else -- 31' +
        '6-CH'
      
        #9#9#9#9'if (@ncpdp = '#39'318-CI'#39') and (rtrim(@emp_state) > '#39#39') set @wor' +
        'kers_comp_str += @FS + '#39'CI'#39' + rtrim(upper(@emp_state)) else -- 3' +
        '18-CI'
      
        #9#9#9#9'if (@ncpdp = '#39'319-CJ'#39') and (rtrim(@emp_zip) > '#39#39') set @worke' +
        'rs_comp_str += @FS + '#39'CJ'#39' + rtrim(upper(@emp_zip)) else -- 319-C' +
        'J '
      
        #9#9#9#9'if (@ncpdp = '#39'320-CK'#39') and (rtrim(@emp_phone) > '#39#39')  set @wo' +
        'rkers_comp_str += @FS + '#39'CK'#39' + rtrim(upper(@emp_phone)) else -- ' +
        '32'#216'-CK '
      
        #9#9#9#9'if (@ncpdp = '#39'434-DY'#39') and (@date_of_injury > '#39#39') set @worke' +
        'rs_comp_str += @FS + '#39'DY'#39' + FORMAT(@date_of_injury, '#39'yyyyMMdd'#39') ' +
        'else --434-DY'
      
        #9#9#9#9'if (@ncpdp = '#39'321-CL'#39') and (rtrim(@emp_contact_name) > '#39#39') s' +
        'et @workers_comp_str += @FS + '#39'CL'#39' + rtrim(upper(@emp_contact_na' +
        'me)) else -- 321-CL'
      
        #9#9#9#9'if (@ncpdp = '#39'327-CR'#39') and (rtrim(@carrier_id) > '#39#39') set @wo' +
        'rkers_comp_str += @FS + '#39'CR'#39' + rtrim(upper(@carrier_id)) else --' +
        ' 327-CR '
      
        #9#9#9#9'if (@ncpdp = '#39'435-DZ'#39') and (rtrim(@claim_ref_id) > '#39#39') set @' +
        'workers_comp_str += @FS + '#39'DZ'#39' + rtrim(upper(@claim_ref_id)) els' +
        'e -- 435-DZ  '
      
        #9#9#9#9'if (@ncpdp = '#39'117-TR'#39') and (rtrim(@bill_entity_typeindi) > '#39 +
        #39') set @workers_comp_str += @FS + '#39'TR'#39' + rtrim(upper(@bill_entit' +
        'y_typeindi)) else -- 117-TR '
      
        #9#9#9#9'if (@ncpdp = '#39'118-TS'#39') and (rtrim(@pay_to_qual) > '#39#39') set @w' +
        'orkers_comp_str += @FS + '#39'TS'#39' + rtrim(upper(@pay_to_qual)) else ' +
        '-- 118-TS'
      
        #9#9#9#9'if (@ncpdp = '#39'119-TT'#39') and (rtrim(@pay_to_id) > '#39#39') set @wor' +
        'kers_comp_str += @FS + '#39'TT'#39' + rtrim(upper(@pay_to_id)) else -- 1' +
        '19-TT '
      
        #9#9#9#9'if (@ncpdp = '#39'120-TU'#39') and (rtrim(@pay_to_name) > '#39#39') set @w' +
        'orkers_comp_str += @FS + '#39'TU'#39' + rtrim(upper(@pay_to_name)) else ' +
        '-- 12'#216'-TU '
      
        #9#9#9#9'if (@ncpdp = '#39'121-TV'#39') and (rtrim(@pay_to_street) > '#39#39') set ' +
        '@workers_comp_str += @FS + '#39'TV'#39' + rtrim(upper(@pay_to_street)) e' +
        'lse -- 121-TV '
      
        #9#9#9#9'if (@ncpdp = '#39'122-TW'#39') and (rtrim(@pay_to_city) > '#39#39') set @w' +
        'orkers_comp_str += @FS + '#39'TW'#39' + rtrim(upper(@pay_to_city)) else ' +
        '-- 122-TW '
      
        #9#9#9#9'if (@ncpdp = '#39'123-TX'#39') and (rtrim(@pay_to_state) > '#39#39') set @' +
        'workers_comp_str += @FS + '#39'TX'#39' + rtrim(upper(@pay_to_state)) els' +
        'e -- 123-TX '
      
        #9#9#9#9'if (@ncpdp = '#39'124-TY'#39') and (rtrim(@pay_to_zip) > '#39#39') set @wo' +
        'rkers_comp_str += @FS + '#39'TY'#39' + rtrim(upper(@pay_to_zip)) else  -' +
        '- 124-TY'
      
        #9#9#9#9'if (@ncpdp = '#39'125-TZ'#39') and (rtrim(@gen_eq_prodid) > '#39#39') set ' +
        '@workers_comp_str += @FS + '#39'TZ'#39' + rtrim(upper(@gen_eq_prodid)) e' +
        'lse -- 125-TZ'
      
        #9#9#9#9'if (@ncpdp = '#39'126-UA'#39') and (rtrim(@gen_eq_prodid) > '#39#39') set ' +
