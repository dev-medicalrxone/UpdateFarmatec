  object RX_RECALL_EPRESCRIBE_FROMHISTORY: TFDQuery
    AfterExecute = RX_RECALL_EPRESCRIBE_FROMHISTORYAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[RX_RECALL_EPRESCRIBE_FROMHISTORY] @Messa' +
        'geID nchar(40), @USER CHAR(3), @NORX BIGINT, @Medication varchar' +
        '(81)'
      'AS'
      'declare @Note varchar(max)'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      
        #9#9'Update Prescriptions set ePRESCRIBE_IDMess = 0, MessageID = '#39#39 +
        ' where MessageID = RTRIM(@MessageID);'
      
        #9#9'Update Surescripts set Rx_Status = 0, PatientID = 0, Medicatio' +
        'nID = 0, PrescriberID = 0, Medication = @Medication where Messag' +
        'eID = RTRIM(@MessageID);'
      
        #9#9'Set @Note = Concat('#39'ePrescribe: Message ID: '#39', @MessageID, '#39' R' +
        'x Number: '#39', @NORX, '#39' was reclled from history!'#39');'
      
        #9#9'EXECUTE INSERT_LOG '#39'ePrescribe Recalled'#39', '#39'M'#39', '#39#39', @USER,  '#39#39',' +
        ' @NORX, 0, 0,0,0,0,0,0,'#39'R'#39', @Note,0,1;'
      #9'commit   '
      'END')
    Left = 4352
    Top = 144
  end
