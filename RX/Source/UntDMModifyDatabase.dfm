        'N'#39'An ointment intended for administration either on the outer ea' +
        'r or into the auditory canal.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91176'#39', N'#39'Otic Solution'#39', ' +
        'N'#39'A solution intended for administration either on the outer ear' +
        ' or into the auditory canal.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
