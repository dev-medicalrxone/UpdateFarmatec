  object RX_RECALL_EPRESCRIBE_FROMHISTORY: TFDQuery
    AfterExecute = RX_RECALL_EPRESCRIBE_FROMHISTORYAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[RX_RECALL_EPRESCRIBE_FROMHISTORY]'
      '    @MessageID   VARCHAR(50),'
      '    @USER        CHAR(3),'
      '    @Medication  VARCHAR(81)'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    DECLARE'
      '        @CleanMessageID VARCHAR(50),'
      '        @Note VARCHAR(MAX);'
      ''
      '    SET @CleanMessageID = NULLIF(LTRIM(RTRIM(@MessageID)), '#39#39');'
      ''
      '    IF @CleanMessageID IS NULL'
      '        THROW 50001, '#39'MessageID is required.'#39', 1;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRAN;'
      ''
      '        UPDATE dbo.Prescriptions'
      '        SET'
      '            ePRESCRIBE_IDMess = 0,'
      '            MessageID = '#39#39
      '        WHERE MessageID = @CleanMessageID;'
      ''
      '        UPDATE dbo.Surescripts'
      '        SET'
      '            Rx_Status = 0,'
      '            PatientID = 0,'
      '            MedicationID = 0,'
      '            PrescriberID = 0,'
      '            GUID = NULL,'
      '            RxReferenceNumber = 0,'
      '            Medication = @Medication'
      '        WHERE MessageID = @CleanMessageID;'
      ''
      '        IF @@ROWCOUNT = 0'
      
        '            THROW 50002, '#39'No Surescripts record found for this M' +
        'essageID.'#39', 1;'
      ''
      '        SET @Note = CONCAT('
      '            '#39'ePrescribe: Message ID: '#39','
      '            @CleanMessageID,'
      '            '#39' was recalled from history.'#39
      '        );'
      ''
      '        EXEC dbo.INSERT_LOG'
      '            '#39'ePrescribe Recalled'#39','
      '            '#39'M'#39','
      '            '#39#39','
      '            @USER,'
      '            '#39#39','
      '            0,'
      '            0,0,0,0,0,0,0,'
      '            '#39'R'#39','
      '            @Note,'
      '            0,'
      '            1;'
      ''
      '        COMMIT;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK;'
      ''
      '        THROW;'
      '    END CATCH;'
      'END;')
    Left = 4352
    Top = 144
  end
  object INSERT_SCANNED_DOC: TFDQuery
    AfterExecute = INSERT_SCANNED_DOCAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'create PROCEDURE [dbo].[INSERT_SCANNED_DOC]'
      '('
      '@SCANNED_DOC VARBINARY(MAX),'
      '@DESCRIPTION NCHAR(100),'
      '@CUSTOMERNUMBER INT,'
      '@Link_ID INT'
      ')'
      'AS'
      'DECLARE @RX_LINK INT'
      '  '
      'SET NOCOUNT ON'
      'BEGIN '
      '  begin transaction'
      '    INSERT INTO [dbo].[DOCUMENT]'
      '           ([Doc_Description]'
      '           ,[Doc_date]'
      '           ,[Tema]'
      '           ,[Link_ID]'
      '           ,[Doc_Name]'
      #9#9'   ,[CustomerNumber])'
      '     VALUES'
      '           (@DESCRIPTION,'
      '           GETDATE(),'
      '           '#39#39','
      '           @Link_ID,'
      '           @SCANNED_DOC,'
      #9'    @CUSTOMERNUMBER);'
      '  commit '
      'END')
    Left = 4352
    Top = 232
  end
  object OTC_INVENTORY_CONTROL: TFDQuery
    AfterExecute = OTC_INVENTORY_CONTROLAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[OTC_INVENTORY_CONTROL] @OTCNUMBER INT, @' +
        'DELETE BIT'
      'AS'
      'DECLARE @QTY DECIMAL(18,2)'
      'DECLARE @PRODUCTID INT'
      'DECLARE @NDC CHAR(11)'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9'SELECT @QTY = QTY,  @NDC = NDC, @PRODUCTID = PRODUCT_ID FROM OT' +
        'C WHERE OTCNUMBER = @OTCNUMBER;'
      #9'if @NDC <> '#39'00000000000'#39' '
      #9'begin'
      #9#9'if @DELETE = 1 '
      #9#9'begin'
      #9#9#9'Select @QTY = -abs(@QTY);'
      #9#9'end;'
      
        #9#9'Update InventarioPiso set QTYINVENTARIO = QTYINVENTARIO - @QTY' +
        ' where PRODUCTNO = @PRODUCTID;'
      #9'end'
      #9'else'
      #9'begin'
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT CANTIDADDESPACHADA, PRODUCT' +
        '_ID from OTCMEZCLAS where NUMEROOTC = @OTCNUMBER;'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      #9#9'INTO @QTY,@PRODUCTID'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'
      #9#9#9'if @DELETE = 1 set @QTY = -abs(@QTY);--@QTY-(@QTY+@QTY);'
      
        #9#9#9'Update InventarioPiso set QTYINVENTARIO = QTYINVENTARIO - @QT' +
        'Y where PRODUCTNO = @PRODUCTID;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      #9#9#9'INTO @QTY,@PRODUCTID'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'
      #9'end;'
      #9'COMMIT'
      'END')
    Left = 4368
    Top = 312
  end
