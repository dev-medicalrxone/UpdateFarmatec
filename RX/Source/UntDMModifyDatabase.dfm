        #9'  INSERT INTO PACIENTES (NOMBRE, CARDHOLDERID, SEXO, DIRECCION1' +
        ', DIRECCION2,'
      #9'  DEUDA, LIMITECREDITO, INTERES, DIRECCIONFISICA,'
      
