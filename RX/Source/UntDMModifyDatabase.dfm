  object SEARCH_PACIENTES: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.SEARCH_PACIENTES'
      '('
      '    @Search         NVARCHAR(200),'
      '    @OnlyActive     BIT = 1,'
      '    @TopRows        INT = 100'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE '
      '        @SearchTrim      NVARCHAR(200),'
      '        @SearchDigits    NVARCHAR(200),'
      '        @SearchDate      DATETIME,'
      '        @HasDate         BIT,'
      '        @SearchInt       INT,'
      '        @HasInt          BIT;'
      ''
      '    SET @SearchTrim = LTRIM(RTRIM(ISNULL(@Search, '#39#39')));'
      
        '    SET @SearchDigits = REPLACE(REPLACE(REPLACE(REPLACE(@SearchT' +
        'rim, '#39'-'#39', '#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39' '#39', '#39#39');'
      ''
      '    SET @SearchDate = NULL;'
      '    SET @HasDate = 0;'
      '    SET @SearchInt = NULL;'
      '    SET @HasInt = 0;'
      ''
      '    IF ISDATE(@SearchTrim) = 1'
      '    BEGIN'
      '        SET @SearchDate = CAST(@SearchTrim AS DATETIME);'
      '        SET @HasDate = 1;'
      '    END'
      ''
      '    IF @SearchTrim <> '#39#39
      '       AND @SearchTrim NOT LIKE '#39'%[^0-9]%'#39
      '       AND'
      '       ('
      '           LEN(@SearchTrim) < 10'
      
        '           OR (LEN(@SearchTrim) = 10 AND @SearchTrim <= '#39'2147483' +
        '647'#39')'
      '       )'
      '    BEGIN'
      '        SET @SearchInt = CAST(@SearchTrim AS INT);'
      '        SET @HasInt = 1;'
      '    END'
      ''
      '    IF @TopRows IS NULL OR @TopRows <= 0'
      '        SET @TopRows = 100;'
      ''
      '    IF @SearchTrim = '#39#39
      '    BEGIN'
      '        SELECT TOP 0'
      '            P.NUMEROCLIENTE,'
      '            NOMBRE_COMPLETO ='
      '                LTRIM(RTRIM(ISNULL(P.APELLIDOPATERNO,'#39#39'))) +'
      
        '                CASE WHEN LTRIM(RTRIM(ISNULL(P.APELLIDOMATERNO,'#39 +
        #39'))) <> '#39#39' '
      
        '                     THEN '#39' '#39' + LTRIM(RTRIM(P.APELLIDOMATERNO)) ' +
        'ELSE '#39#39' END +'
      '                '#39', '#39' +'
      '                LTRIM(RTRIM(ISNULL(P.NOMBRE,'#39#39'))) +'
      
        '                CASE WHEN LTRIM(RTRIM(ISNULL(P.MIDDLE_NAME,'#39#39')))' +
        ' <> '#39#39' '
      
        '                     THEN '#39' '#39' + LTRIM(RTRIM(P.MIDDLE_NAME)) ELSE' +
        ' '#39#39' END,'
      '            NOMBRE            = LTRIM(RTRIM(P.NOMBRE)),'
      '            MIDDLE_NAME       = LTRIM(RTRIM(P.MIDDLE_NAME)),'
      '            APELLIDOPATERNO   = LTRIM(RTRIM(P.APELLIDOPATERNO)),'
      '            APELLIDOMATERNO   = LTRIM(RTRIM(P.APELLIDOMATERNO)),'
      '            P.FECHANACIMIENTO,'
      '            TELEFONO          = LTRIM(RTRIM(P.TELEFONO)),'
      '            CELULAR           = LTRIM(RTRIM(P.CELULAR)),'
      '            SSN               = LTRIM(RTRIM(P.SSN)),'
      '            IDENTIFICACION    = LTRIM(RTRIM(P.IDENTIFICACION)),'
      '            P.SEXO,'
      '            P.LTC,'
      '            P.ADHERENCE,   -- '#55357#56392' ADDED'
      '            P.ACTIVE'
      '        FROM dbo.PACIENTES P;'
      ''
      '        RETURN;'
      '    END'
      ''
      '    ;WITH Tokens AS'
      '    ('
      '        SELECT Token'
      '        FROM dbo.fn_SplitString(@SearchTrim, N'#39' '#39')'
      '    ),'
      '    Base AS'
      '    ('
      '        SELECT'
      '            P.NUMEROCLIENTE,'
      '            P.NOMBRE,'
      '            P.MIDDLE_NAME,'
      '            P.APELLIDOPATERNO,'
      '            P.APELLIDOMATERNO,'
      '            P.FECHANACIMIENTO,'
      '            P.TELEFONO,'
      '            P.CELULAR,'
      '            P.SSN,'
      '            P.IDENTIFICACION,'
      '            P.SEXO,'
      '            P.LTC,'
      '            P.ADHERENCE,  -- '#55357#56392' ADDED'
      '            P.ACTIVE,'
      ''
      '            NOMBRE_COMPLETO ='
      '                LTRIM(RTRIM(ISNULL(P.APELLIDOPATERNO,'#39#39'))) +'
      
        '                CASE WHEN LTRIM(RTRIM(ISNULL(P.APELLIDOMATERNO,'#39 +
        #39'))) <> '#39#39' '
      
        '                     THEN '#39' '#39' + LTRIM(RTRIM(P.APELLIDOMATERNO)) ' +
        'ELSE '#39#39' END +'
      '                '#39', '#39' +'
      '                LTRIM(RTRIM(ISNULL(P.NOMBRE,'#39#39'))) +'
      
        '                CASE WHEN LTRIM(RTRIM(ISNULL(P.MIDDLE_NAME,'#39#39')))' +
        ' <> '#39#39' '
      
        '                     THEN '#39' '#39' + LTRIM(RTRIM(P.MIDDLE_NAME)) ELSE' +
        ' '#39#39' END,'
      ''
      '            TELEFONO_DIGITS ='
      
        '                REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNU' +
        'LL(P.TELEFONO,'#39#39'))), '#39'-'#39', '#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39' '#39', '#39#39'),'
      ''
      '            CELULAR_DIGITS ='
      
        '                REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNU' +
        'LL(P.CELULAR,'#39#39'))), '#39'-'#39', '#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39' '#39', '#39#39'),'
      ''
      '            SSN_DIGITS ='
      
        '                REPLACE(REPLACE(LTRIM(RTRIM(ISNULL(P.SSN,'#39#39'))), ' +
        #39'-'#39', '#39#39'), '#39' '#39', '#39#39'),'
      ''
      '            IDENTIFICACION_DIGITS ='
      
        '                REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNU' +
        'LL(P.IDENTIFICACION,'#39#39'))), '#39'-'#39', '#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39' '#39', '#39#39 +
        ')'
      '        FROM dbo.PACIENTES P'
      '        WHERE (@OnlyActive = 0 OR P.ACTIVE = 1)'
      '    )'
      '    SELECT TOP (@TopRows)'
      '        B.NUMEROCLIENTE,'
      '        NOMBRE_COMPLETO,'
      '        NOMBRE            = LTRIM(RTRIM(B.NOMBRE)),'
      '        MIDDLE_NAME       = LTRIM(RTRIM(B.MIDDLE_NAME)),'
      '        APELLIDOPATERNO   = LTRIM(RTRIM(B.APELLIDOPATERNO)),'
      '        APELLIDOMATERNO   = LTRIM(RTRIM(B.APELLIDOMATERNO)),'
      '        B.FECHANACIMIENTO,'
      '        TELEFONO          = LTRIM(RTRIM(B.TELEFONO)),'
      '        CELULAR           = LTRIM(RTRIM(B.CELULAR)),'
      '        SSN               = LTRIM(RTRIM(B.SSN)),'
      '        IDENTIFICACION    = LTRIM(RTRIM(B.IDENTIFICACION)),'
      '        B.SEXO,'
      '        B.LTC,'
      '        B.ADHERENCE,  -- '#55357#56392' ADDED'
      '        B.ACTIVE,'
      '        SCORE ='
      '            CASE '
      
        '                WHEN @HasInt = 1 AND B.NUMEROCLIENTE = @SearchIn' +
        't THEN 1000'
      
        '                WHEN UPPER(B.NOMBRE_COMPLETO) = UPPER(@SearchTri' +
        'm) THEN 900'
      
        '                WHEN UPPER(B.NOMBRE_COMPLETO) LIKE '#39'%'#39' + UPPER(@' +
        'SearchTrim) + '#39'%'#39' THEN 800'
      
        '                WHEN B.IDENTIFICACION_DIGITS = @SearchDigits THE' +
        'N 750'
      '                WHEN B.TELEFONO_DIGITS = @SearchDigits THEN 700'
      '                WHEN B.CELULAR_DIGITS = @SearchDigits THEN 700'
      '                WHEN B.SSN_DIGITS = @SearchDigits THEN 650'
      '                WHEN @HasDate = 1'
      
        '                     AND B.FECHANACIMIENTO >= CAST(@SearchDate A' +
        'S DATE)'
      
        '                     AND B.FECHANACIMIENTO < DATEADD(DAY, 1, CAS' +
        'T(@SearchDate AS DATE)) THEN 600'
      '                ELSE 0'
      '            END'
      '    FROM Base B'
      '    WHERE'
      '        (@HasInt = 1 AND B.NUMEROCLIENTE = @SearchInt)'
      '        OR'
      '        ('
      '            @SearchDigits <> '#39#39
      '            AND'
      '            ('
      '                B.TELEFONO_DIGITS LIKE '#39'%'#39' + @SearchDigits + '#39'%'#39
      
        '                OR B.CELULAR_DIGITS LIKE '#39'%'#39' + @SearchDigits + '#39 +
        '%'#39
      '                OR B.SSN_DIGITS LIKE '#39'%'#39' + @SearchDigits + '#39'%'#39
      
        '                OR B.IDENTIFICACION_DIGITS LIKE '#39'%'#39' + @SearchDig' +
        'its + '#39'%'#39
      '            )'
      '        )'
      '        OR'
      '        ('
      
        '            UPPER(LTRIM(RTRIM(ISNULL(B.IDENTIFICACION,'#39#39')))) LIK' +
        'E '#39'%'#39' + UPPER(@SearchTrim) + '#39'%'#39
      '        )'
      '        OR'
      '        ('
      '            @HasDate = 1'
      '            AND B.FECHANACIMIENTO >= CAST(@SearchDate AS DATE)'
      
        '            AND B.FECHANACIMIENTO < DATEADD(DAY, 1, CAST(@Search' +
        'Date AS DATE))'
      '        )'
      '        OR'
      '        ('
      '            NOT EXISTS'
      '            ('
      '                SELECT 1'
      '                FROM Tokens T'
      '                WHERE NOT'
      '                ('
      
        '                    UPPER(LTRIM(RTRIM(ISNULL(B.NOMBRE, '#39#39')))) LI' +
        'KE '#39'%'#39' + UPPER(T.Token) + '#39'%'#39
      
        '                    OR UPPER(LTRIM(RTRIM(ISNULL(B.MIDDLE_NAME, '#39 +
        #39')))) LIKE '#39'%'#39' + UPPER(T.Token + '#39'%'#39')'
      
        '                    OR UPPER(LTRIM(RTRIM(ISNULL(B.APELLIDOPATERN' +
        'O, '#39#39')))) LIKE '#39'%'#39' + UPPER(T.Token) + '#39'%'#39
      
        '                    OR UPPER(LTRIM(RTRIM(ISNULL(B.APELLIDOMATERN' +
        'O, '#39#39')))) LIKE '#39'%'#39' + UPPER(T.Token) + '#39'%'#39
      '                )'
      '            )'
      '        )'
      '    ORDER BY'
      '        SCORE DESC,'
      '        LTRIM(RTRIM(B.APELLIDOPATERNO)),'
      '        LTRIM(RTRIM(B.APELLIDOMATERNO)),'
      '        LTRIM(RTRIM(B.NOMBRE)),'
      '        LTRIM(RTRIM(B.MIDDLE_NAME));'
      'END')
    Left = 7008
    Top = 1288
  end
  object fn_SplitString: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE FUNCTION dbo.fn_SplitString'
      '('
      '    @String NVARCHAR(MAX),'
      '    @Delimiter CHAR(1)'
      ')'
      'RETURNS @Result TABLE (Token NVARCHAR(200))'
      'AS'
      'BEGIN'
      '    DECLARE @Pos INT = 1,'
      '            @NextPos INT,'
      '            @Value NVARCHAR(200);'
      ''
      '    SET @String = LTRIM(RTRIM(@String)) + @Delimiter;'
      ''
      '    WHILE CHARINDEX(@Delimiter, @String, @Pos) > 0'
      '    BEGIN'
      '        SET @NextPos = CHARINDEX(@Delimiter, @String, @Pos);'
      
        '        SET @Value = LTRIM(RTRIM(SUBSTRING(@String, @Pos, @NextP' +
        'os - @Pos)));'
      ''
      '        IF @Value <> '#39#39
      '            INSERT INTO @Result(Token) VALUES (@Value);'
      ''
      '        SET @Pos = @NextPos + 1;'
      '    END'
      ''
      '    RETURN;'
      'END')
    Left = 7008
    Top = 1368
  end
  object VALIDATE_OTC_BATCH_INTEGRITY: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.VALIDATE_OTC_BATCH_INTEGRITY'
      '('
      '    @GUID VARCHAR(36)'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      '    BEGIN'
      '        RAISERROR('#39'GUID is required.'#39', 16, 1);'
      '        RETURN;'
      '    END;'
      ''
      '    CREATE TABLE #BATCH'
      '    ('
      '        OTCNUMBER              INT            NOT NULL,'
      '        OTC_NUMERORECETA       BIGINT         NULL,'
      '        RX_NUMERORECETA        BIGINT         NULL,'
      '        OTC_RX_STATUS          CHAR(1)        NULL,'
      ''
      '        OTC_NUMEROCLIENTE      INT            NULL,'
      '        RX_NUMEROCLIENTE       INT            NULL,'
      ''
      '        OTC_NUMEROPLAN         INT            NULL,'
      '        OTC_PLANESMEDICOSNO    INT            NULL,'
      ''
      '        OTC_NDC                VARCHAR(11)    NULL,'
      '        RX_NDC                 VARCHAR(11)    NULL,'
      ''
      '        OTC_PRODUCT_ID         INT            NULL,'
      '        RX_PRODUCT_ID          INT            NULL,'
      ''
      '        OTC_DAYS_SUPPLY        INT            NULL,'
      '        RX_DAYS_SUPPLY         INT            NULL,'
      ''
      '        OTC_QTY_TEMP           DECIMAL(18,6)  NULL,'
      ''
      '        RX_NUMERODOCTOR        INT            NULL,'
      ''
      '        RX_LTC                 BIT            NULL,'
      '        PATIENT_LTC            BIT            NULL,'
      '        PLAN_LTC               BIT            NULL,'
      '        DRUG_LTC               BIT            NULL'
      '    );'
      ''
      '    INSERT INTO #BATCH'
      '    ('
      '        OTCNUMBER,'
      '        OTC_NUMERORECETA,'
      '        RX_NUMERORECETA,'
      '        OTC_RX_STATUS,'
      '        OTC_NUMEROCLIENTE,'
      '        RX_NUMEROCLIENTE,'
      '        OTC_NUMEROPLAN,'
      '        OTC_PLANESMEDICOSNO,'
      '        OTC_NDC,'
      '        RX_NDC,'
      '        OTC_PRODUCT_ID,'
      '        RX_PRODUCT_ID,'
      '        OTC_DAYS_SUPPLY,'
      '        RX_DAYS_SUPPLY,'
      '        OTC_QTY_TEMP,'
      '        RX_NUMERODOCTOR,'
      '        RX_LTC,'
      '        PATIENT_LTC,'
      '        PLAN_LTC,'
      '        DRUG_LTC'
      '    )'
      '    SELECT'
      '        O.OTCNUMBER,'
      '        O.NUMERORECETA,'
      '        P.NUMERORECETA,'
      '        O.RX_STATUS,'
      '        O.NUMEROCLIENTE,'
      '        P.NUMEROCLIENTE,'
      '        O.NUMEROPLAN,'
      '        O.PLANESMEDICOSNO,'
      '        O.NDC,'
      '        P.NDC,'
      '        O.PRODUCT_ID,'
      '        P.PRODUCT_ID,'
      '        O.DAYS_SUPPLY,'
      '        P.DAYS_SUPPLY,'
      '        O.QTY_TEMP,'
      '        P.NUMERODOCTOR,'
      '        P.LTC,'
      '        PA.LTC,'
      '        PM.LTC,'
      '        I.LTC'
      '    FROM dbo.OTC O'
      '    LEFT JOIN dbo.PRESCRIPTIONS P'
      '        ON P.NUMERORECETA = O.NUMERORECETA'
      '    LEFT JOIN dbo.PACIENTES PA'
      '        ON PA.NUMEROCLIENTE = O.NUMEROCLIENTE'
      '    LEFT JOIN dbo.PLANESMEDICOS PM'
      '        ON PM.PLANESMEDICOSNO = O.PLANESMEDICOSNO'
      '    LEFT JOIN dbo.INVENTARIOPISO I'
      '        ON I.PRODUCTNO = O.PRODUCT_ID'
      '    WHERE O.GUID = @GUID;'
      ''
      '    IF NOT EXISTS (SELECT 1 FROM #BATCH)'
      '    BEGIN'
      '        SELECT'
      '            CAST(0 AS BIT) AS IsValid,'
      '            1 AS ErrorCount;'
      ''
      '        SELECT'
      '            CAST(NULL AS INT) AS OTCNUMBER,'
      '            '#39'ERROR'#39' AS Severity,'
      '            '#39'GUID_NOT_FOUND'#39' AS ErrorCode,'
      '            '#39'GUID'#39' AS FieldName,'
      '            '#39'No OTC rows found for this GUID.'#39' AS Message;'
      '        RETURN;'
      '    END;'
      ''
      '    CREATE CLUSTERED INDEX IX_#BATCH_OTCNUMBER'
      '        ON #BATCH (OTCNUMBER);'
      ''
      '    CREATE INDEX IX_#BATCH_OTC_RX_STATUS'
      '        ON #BATCH (OTC_RX_STATUS);'
      ''
      '    CREATE INDEX IX_#BATCH_OTC_NUMEROCLIENTE'
      '        ON #BATCH (OTC_NUMEROCLIENTE);'
      ''
      '    CREATE INDEX IX_#BATCH_OTC_NUMEROPLAN'
      '        ON #BATCH (OTC_NUMEROPLAN);'
      ''
      '    CREATE INDEX IX_#BATCH_OTC_PLANESMEDICOSNO'
      '        ON #BATCH (OTC_PLANESMEDICOSNO);'
      ''
      '    CREATE TABLE #Errors'
      '    ('
      '        OTCNUMBER   INT          NULL,'
      '        Severity    VARCHAR(10)  NOT NULL,'
      '        ErrorCode   VARCHAR(50)  NOT NULL,'
      '        FieldName   VARCHAR(50)  NOT NULL,'
      '        Message     VARCHAR(500) NOT NULL'
      '    );'
      ''
      '    /* ========================================================='
      '       ROW-LEVEL VALIDATIONS'
      
        '       =========================================================' +
        ' */'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'RX_NOT_FOUND'#39','
      '        '#39'NUMERORECETA'#39','
      '        '#39'No PRESCRIPTIONS row found for this OTC record.'#39
      '    FROM #BATCH B'
      '    WHERE B.RX_NUMERORECETA IS NULL;'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'PATIENT_MISMATCH'#39','
      '        '#39'NUMEROCLIENTE'#39','
      '        '#39'OTC.NUMEROCLIENTE <> PRESCRIPTIONS.NUMEROCLIENTE.'#39
      '    FROM #BATCH B'
      '    WHERE B.RX_NUMERORECETA IS NOT NULL'
      
        '      AND ISNULL(B.OTC_NUMEROCLIENTE, -1) <> ISNULL(B.RX_NUMEROC' +
        'LIENTE, -1);'
      ''
      '    /* Only for NEW prescriptions */'
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'NDC_MISMATCH'#39','
      '        '#39'NDC'#39','
      '        '#39'OTC.NDC <> PRESCRIPTIONS.NDC for NEW prescription.'#39
      '    FROM #BATCH B'
      '    WHERE B.RX_NUMERORECETA IS NOT NULL'
      '      AND B.OTC_RX_STATUS = '#39'N'#39
      
        '      AND ISNULL(LTRIM(RTRIM(B.OTC_NDC)), '#39#39') <> ISNULL(LTRIM(RT' +
        'RIM(B.RX_NDC)), '#39#39');'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'PRODUCT_MISMATCH'#39','
      '        '#39'PRODUCT_ID'#39','
      
        '        '#39'OTC.PRODUCT_ID <> PRESCRIPTIONS.PRODUCT_ID for NEW pres' +
        'cription.'#39
      '    FROM #BATCH B'
      '    WHERE B.RX_NUMERORECETA IS NOT NULL'
      '      AND B.OTC_RX_STATUS = '#39'N'#39
      
        '      AND ISNULL(B.OTC_PRODUCT_ID, -1) <> ISNULL(B.RX_PRODUCT_ID' +
        ', -1);'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'DAYSUPPLY_MISMATCH'#39','
      '        '#39'DAYS_SUPPLY'#39','
      
        '        '#39'OTC.DAYS_SUPPLY <> PRESCRIPTIONS.DAYS_SUPPLY for NEW pr' +
        'escription.'#39
      '    FROM #BATCH B'
      '    WHERE B.RX_NUMERORECETA IS NOT NULL'
      '      AND B.OTC_RX_STATUS = '#39'N'#39
      
        '      AND ISNULL(B.OTC_DAYS_SUPPLY, -1) <> ISNULL(B.RX_DAYS_SUPP' +
        'LY, -1);'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'QTY_TEMP_NULL'#39','
      '        '#39'QTY_TEMP'#39','
      '        '#39'Quantity (QTY_TEMP) cannot be NULL.'#39
      '    FROM #BATCH B'
      '    WHERE B.OTC_QTY_TEMP IS NULL;'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'QTY_TEMP_INVALID'#39','
      '        '#39'QTY_TEMP'#39','
      '        '#39'Quantity (QTY_TEMP) must be greater than zero.'#39
      '    FROM #BATCH B'
      '    WHERE B.OTC_QTY_TEMP IS NOT NULL'
      '      AND B.OTC_QTY_TEMP <= 0;'
      ''
      '    /* ========================================================='
      '       BATCH-LEVEL CONSISTENCY'
      
        '       =========================================================' +
        ' */'
      ''
      
        '    IF EXISTS (SELECT 1 FROM #BATCH WHERE OTC_NUMEROCLIENTE IS N' +
        'ULL)'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_PATIENT_NULL'#39','
      '            '#39'NUMEROCLIENTE'#39','
      
        '            '#39'One or more OTC records in this GUID have a NULL NU' +
        'MEROCLIENTE.'#39
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROCLIENTE IS NULL;'
      '    END;'
      ''
      '    IF (SELECT COUNT(DISTINCT OTC_NUMEROCLIENTE)'
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROCLIENTE IS NOT NULL) > 1'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_PATIENT_MISMATCH'#39','
      '            '#39'NUMEROCLIENTE'#39','
      
        '            '#39'Not all OTC records in this GUID belong to the same' +
        ' patient.'#39
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROCLIENTE IS NOT NULL;'
      '    END;'
      ''
      
        '    IF EXISTS (SELECT 1 FROM #BATCH WHERE OTC_NUMEROPLAN IS NULL' +
        ')'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_PLAN_NULL'#39','
      '            '#39'NUMEROPLAN'#39','
      
        '            '#39'One or more OTC records in this GUID have a NULL NU' +
        'MEROPLAN.'#39
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROPLAN IS NULL;'
      '    END;'
      ''
      '    IF (SELECT COUNT(DISTINCT OTC_NUMEROPLAN)'
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROPLAN IS NOT NULL) > 1'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_PLAN_MISMATCH'#39','
      '            '#39'NUMEROPLAN'#39','
      
        '            '#39'Not all OTC records in this GUID have the same NUME' +
        'ROPLAN.'#39
      '        FROM #BATCH'
      '        WHERE OTC_NUMEROPLAN IS NOT NULL;'
      '    END;'
      ''
      
        '    IF EXISTS (SELECT 1 FROM #BATCH WHERE OTC_PLANESMEDICOSNO IS' +
        ' NULL)'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_INSURANCE_NULL'#39','
      '            '#39'PLANESMEDICOSNO'#39','
      
        '            '#39'One or more OTC records in this GUID have a NULL PL' +
        'ANESMEDICOSNO.'#39
      '        FROM #BATCH'
      '        WHERE OTC_PLANESMEDICOSNO IS NULL;'
      '    END;'
      ''
      '    IF (SELECT COUNT(DISTINCT OTC_PLANESMEDICOSNO)'
      '        FROM #BATCH'
      '        WHERE OTC_PLANESMEDICOSNO IS NOT NULL) > 1'
      '    BEGIN'
      
        '        INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, Fie' +
        'ldName, Message)'
      '        SELECT'
      '            OTCNUMBER,'
      '            '#39'ERROR'#39','
      '            '#39'BATCH_INSURANCE_MISMATCH'#39','
      '            '#39'PLANESMEDICOSNO'#39','
      
        '            '#39'Not all OTC records in this GUID have the same PLAN' +
        'ESMEDICOSNO.'#39
      '        FROM #BATCH'
      '        WHERE OTC_PLANESMEDICOSNO IS NOT NULL;'
      '    END;'
      ''
      '    /* ========================================================='
      '       MASTER TABLE EXISTENCE'
      
        '       =========================================================' +
        ' */'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'PATIENT_NOT_FOUND'#39','
      '        '#39'NUMEROCLIENTE'#39','
      '        '#39'Patient does not exist in PACIENTES.'#39
      '    FROM #BATCH B'
      '    LEFT JOIN dbo.PACIENTES PA'
      '        ON PA.NUMEROCLIENTE = B.OTC_NUMEROCLIENTE'
      '    WHERE B.OTC_NUMEROCLIENTE IS NOT NULL'
      '      AND PA.NUMEROCLIENTE IS NULL;'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'PLAN_NOT_FOUND'#39','
      '        '#39'NUMEROPLAN'#39','
      
        '        '#39'Patient insurance (NUMEROPLAN) does not exist in PATPLA' +
        'N.'#39
      '    FROM #BATCH B'
      '    LEFT JOIN dbo.PATPLAN PP'
      '        ON PP.NUMEROPLAN = B.OTC_NUMEROPLAN'
      '    WHERE B.OTC_NUMEROPLAN IS NOT NULL'
      '      AND PP.NUMEROPLAN IS NULL;'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'INSURANCE_NOT_FOUND'#39','
      '        '#39'PLANESMEDICOSNO'#39','
      '        '#39'Insurance does not exist in PLANESMEDICOS.'#39
      '    FROM #BATCH B'
      '    LEFT JOIN dbo.PLANESMEDICOS PM'
      '        ON PM.PLANESMEDICOSNO = B.OTC_PLANESMEDICOSNO'
      '    WHERE B.OTC_PLANESMEDICOSNO IS NOT NULL'
      '      AND PM.PLANESMEDICOSNO IS NULL;'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'DOCTOR_NOT_FOUND'#39','
      '        '#39'NUMERODOCTOR'#39','
      '        '#39'Prescriber does not exist in DOCTOR.'#39
      '    FROM #BATCH B'
      '    LEFT JOIN dbo.DOCTOR D'
      '        ON D.NUMERODOCTOR = B.RX_NUMERODOCTOR'
      '    WHERE B.RX_NUMERODOCTOR IS NOT NULL'
      '      AND D.NUMERODOCTOR IS NULL;'
      ''
      '    /* ========================================================='
      '       LTC VALIDATION'
      '       Only when PRESCRIPTIONS.LTC = 1'
      
        '       =========================================================' +
        ' */'
      ''
      
        '    INSERT INTO #Errors (OTCNUMBER, Severity, ErrorCode, FieldNa' +
        'me, Message)'
      '    SELECT'
      '        B.OTCNUMBER,'
      '        '#39'ERROR'#39','
      '        '#39'LTC_MISMATCH'#39','
      '        '#39'LTC'#39','
      
        '        '#39'LTC mismatch: PRESCRIPTIONS.LTC is set but Patient, Pla' +
        'n, or Drug is not LTC.'#39
      '    FROM #BATCH B'
      '    WHERE ISNULL(B.RX_LTC, 0) = 1'
      '      AND'
      '      ('
      '          ISNULL(B.PATIENT_LTC, 0) <> 1'
      '          OR ISNULL(B.PLAN_LTC, 0) <> 1'
      '          OR ISNULL(B.DRUG_LTC, 0) <> 1'
      '      );'
      ''
      '    /* ========================================================='
      '       SUMMARY'
      
        '       =========================================================' +
        ' */'
      ''
      '    SELECT'
      
        '        CAST(CASE WHEN EXISTS (SELECT 1 FROM #Errors WHERE Sever' +
        'ity = '#39'ERROR'#39')'
      '             THEN 0 ELSE 1 END AS BIT) AS IsValid,'
      
        '        SUM(CASE WHEN Severity = '#39'ERROR'#39' THEN 1 ELSE 0 END) AS E' +
        'rrorCount'
      '    FROM #Errors;'
      ''
      '    SELECT'
      '        OTCNUMBER,'
      '        Severity,'
      '        ErrorCode,'
      '        FieldName,'
      '        Message'
      '    FROM #Errors'
      '    ORDER BY OTCNUMBER, ErrorCode;'
      'END;')
    Left = 7024
    Top = 1472
  end
  object GET_PACIENTE_BY_ID: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE OR ALTER PROCEDURE dbo.GET_PACIENTE_BY_ID'
      '('
      '    @NUMEROCLIENTE INT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    SELECT'
      '        P.*'
      '    FROM dbo.PACIENTES P'
      '    WHERE P.NUMEROCLIENTE = @NUMEROCLIENTE;'
      'END')
    Left = 7024
    Top = 1552
  end
  object SEARCH_GLOBAL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SEARCH_GLOBAL]'
      '    @Search NVARCHAR(100)'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE'
      '        @RawSearch      NVARCHAR(100),'
      '        @SearchText     NVARCHAR(100),'
      '        @Prefix         NVARCHAR(20),'
      '        @DigitsOnly     NVARCHAR(100),'
      '        @IsNumeric      BIT,'
      '        @SearchMode     NVARCHAR(20),'
      '        @SearchInt      INT,'
      '        @SearchUpper    NVARCHAR(100),'
      '        @pos            INT,'
      '        @next           INT,'
      '        @len            INT,'
      '        @Token          NVARCHAR(50),'
      '        @Tail           NVARCHAR(100);'
      ''
      '    DECLARE @Tokens TABLE'
      '    ('
      '        Token NVARCHAR(50) NOT NULL'
      '    );'
      ''
      '    SET @RawSearch   = LTRIM(RTRIM(ISNULL(@Search, '#39#39')));'
      '    SET @SearchText  = '#39#39';'
      '    SET @Prefix      = '#39#39';'
      '    SET @DigitsOnly  = '#39#39';'
      '    SET @IsNumeric   = 0;'
      '    SET @SearchMode  = '#39'AUTO'#39';'
      '    SET @SearchInt   = NULL;'
      '    SET @SearchUpper = '#39#39';'
      '    SET @Tail        = '#39#39';'
      ''
      '    IF @RawSearch = '#39#39
      '    BEGIN'
      '        SELECT TOP 0'
      '            CAST(NULL AS VARCHAR(20))  AS ResultType,'
      '            CAST(NULL AS VARCHAR(20))  AS MatchType,'
      '            CAST(NULL AS INT)          AS RankScore,'
      '            CAST(NULL AS INT)          AS NumeroCliente,'
      '            CAST(NULL AS VARCHAR(100)) AS PatientName,'
      '            CAST(NULL AS VARCHAR(20))  AS Identificacion,'
      '            CAST(NULL AS VARCHAR(20))  AS Telefono,'
      '            CAST(NULL AS INT)          AS NumeroReceta,'
      '            CAST(NULL AS INT)          AS OTCNumber,'
      '            CAST(NULL AS DATETIME)     AS FechaOTC,'
      '            CAST(NULL AS VARCHAR(300)) AS DisplayText;'
      '        RETURN;'
      '    END;'
      ''
      '    SET @SearchUpper = UPPER(@RawSearch);'
      ''
      
        '    /* detect prefix with NO separator, but only when unambiguou' +
        's */'
      '    IF LEFT(@SearchUpper, 4) = '#39'NAME'#39
      '    BEGIN'
      '        SET @Prefix = '#39'NAME'#39';'
      
        '        SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, 5, L' +
        'EN(@RawSearch))));'
      '    END'
      '    ELSE IF LEFT(@SearchUpper, 3) = '#39'TEL'#39
      '    BEGIN'
      
        '        SET @Tail = SUBSTRING(@SearchUpper, 4, LEN(@SearchUpper)' +
        ');'
      '        IF @Tail <> '#39#39' AND @Tail NOT LIKE '#39'%[^0-9]%'#39
      '        BEGIN'
      '            SET @Prefix = '#39'TEL'#39';'
      
        '            SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, ' +
        '4, LEN(@RawSearch))));'
      '        END'
      '        ELSE'
      '            SET @SearchText = @RawSearch;'
      '    END'
      '    ELSE IF LEFT(@SearchUpper, 2) = '#39'PN'#39
      '    BEGIN'
      
        '        SET @Tail = SUBSTRING(@SearchUpper, 3, LEN(@SearchUpper)' +
        ');'
      '        IF @Tail <> '#39#39' AND @Tail NOT LIKE '#39'%[^0-9]%'#39
      '        BEGIN'
      '            SET @Prefix = '#39'PN'#39';'
      
        '            SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, ' +
        '3, LEN(@RawSearch))));'
      '        END'
      '        ELSE'
      '            SET @SearchText = @RawSearch;'
      '    END'
      '    ELSE IF LEFT(@SearchUpper, 2) = '#39'RX'#39
      '    BEGIN'
      
        '        SET @Tail = SUBSTRING(@SearchUpper, 3, LEN(@SearchUpper)' +
        ');'
      '        IF @Tail <> '#39#39' AND @Tail NOT LIKE '#39'%[^0-9]%'#39
      '        BEGIN'
      '            SET @Prefix = '#39'RX'#39';'
      
        '            SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, ' +
        '3, LEN(@RawSearch))));'
      '        END'
      '        ELSE'
      '            SET @SearchText = @RawSearch;'
      '    END'
      '    ELSE IF LEFT(@SearchUpper, 2) = '#39'ID'#39
      '    BEGIN'
      
        '        SET @Tail = SUBSTRING(@SearchUpper, 3, LEN(@SearchUpper)' +
        ');'
      '        IF @Tail <> '#39#39' AND @Tail NOT LIKE '#39'%[^0-9]%'#39
      '        BEGIN'
      '            SET @Prefix = '#39'ID'#39';'
      
        '            SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, ' +
        '3, LEN(@RawSearch))));'
      '        END'
      '        ELSE'
      '            SET @SearchText = @RawSearch;'
      '    END'
      '    ELSE IF LEFT(@SearchUpper, 1) = '#39'P'#39
      '    BEGIN'
      
        '        SET @Tail = SUBSTRING(@SearchUpper, 2, LEN(@SearchUpper)' +
        ');'
      '        IF @Tail <> '#39#39' AND @Tail NOT LIKE '#39'%[^0-9]%'#39
      '        BEGIN'
      '            SET @Prefix = '#39'P'#39';'
      
        '            SET @SearchText = LTRIM(RTRIM(SUBSTRING(@RawSearch, ' +
        '2, LEN(@RawSearch))));'
      '        END'
      '        ELSE'
      '            SET @SearchText = @RawSearch;'
      '    END'
      '    ELSE'
      '    BEGIN'
      '        SET @SearchText = @RawSearch;'
      '    END;'
      ''
      '    IF @Prefix = '#39'PN'#39
      '        SET @SearchMode = '#39'PN'#39';'
      '    ELSE IF @Prefix = '#39'RX'#39
      '        SET @SearchMode = '#39'RX'#39';'
      '    ELSE IF @Prefix = '#39'P'#39
      '        SET @SearchMode = '#39'P'#39';'
      '    ELSE IF @Prefix = '#39'TEL'#39
      '        SET @SearchMode = '#39'TEL'#39';'
      '    ELSE IF @Prefix = '#39'ID'#39
      '        SET @SearchMode = '#39'ID'#39';'
      '    ELSE IF @Prefix = '#39'NAME'#39
      '        SET @SearchMode = '#39'NAME'#39';'
      '    ELSE'
      '        SET @SearchMode = '#39'AUTO'#39';'
      ''
      '    SET @DigitsOnly = @SearchText;'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39'('#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39')'#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39'-'#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39' '#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39'.'#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39'/'#39', '#39#39');'
      '    SET @DigitsOnly = REPLACE(@DigitsOnly, '#39'+'#39', '#39#39');'
      ''
      '    IF @DigitsOnly <> '#39#39' AND @DigitsOnly NOT LIKE '#39'%[^0-9]%'#39
      '    BEGIN'
      '        SET @IsNumeric = 1;'
      ''
      '        IF LEN(@DigitsOnly) < 10'
      '            SET @SearchInt = CONVERT(INT, @DigitsOnly);'
      
        '        ELSE IF LEN(@DigitsOnly) = 10 AND @DigitsOnly <= '#39'214748' +
        '3647'#39
      '            SET @SearchInt = CONVERT(INT, @DigitsOnly);'
      '        ELSE'
      '            SET @SearchInt = NULL;'
      '    END;'
      ''
      '    SET @SearchUpper = UPPER(LTRIM(RTRIM(@SearchText)));'
      ''
      '    /* tokenize for name search */'
      '    IF @SearchUpper <> '#39#39
      '    BEGIN'
      '        SET @pos = 1;'
      '        SET @len = LEN(@SearchUpper);'
      ''
      '        WHILE @pos <= @len'
      '        BEGIN'
      
        '            WHILE @pos <= @len AND SUBSTRING(@SearchUpper, @pos,' +
        ' 1) = '#39' '#39
      '                SET @pos = @pos + 1;'
      ''
      '            IF @pos > @len'
      '                BREAK;'
      ''
      '            SET @next = CHARINDEX('#39' '#39', @SearchUpper, @pos);'
      ''
      '            IF @next = 0'
      '                SET @next = @len + 1;'
      ''
      
        '            SET @Token = LTRIM(RTRIM(SUBSTRING(@SearchUpper, @po' +
        's, @next - @pos)));'
      ''
      '            IF @Token <> '#39#39
      '                INSERT INTO @Tokens (Token) VALUES (@Token);'
      ''
      '            SET @pos = @next + 1;'
      '        END;'
      '    END;'
      ''
      '    ;WITH Results AS'
      '    ('
      '        /* PN = prescription number */'
      '        SELECT'
      '            ResultType     = '#39'PRESCRIPTION'#39','
      '            MatchType      = '#39'PN'#39','
      '            RankScore      = CASE'
      
        '                                WHEN @SearchMode = '#39'PN'#39'   AND @S' +
        'earchInt IS NOT NULL AND PR.NUMERORECETA = @SearchInt THEN 1000'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @S' +
        'earchInt IS NOT NULL AND PR.NUMERORECETA = @SearchInt THEN 900'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = PR.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = PR.NUMERORECETA,'
      '            OTCNumber      = CAST(NULL AS INT),'
      '            FechaOTC       = CAST(NULL AS DATETIME),'
      
        '            DisplayText    = '#39'PN'#39' + CAST(PR.NUMERORECETA AS VARC' +
        'HAR(20)) +'
      '                             '#39' | '#39' +'
      '                             LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      
        '                                '#39', '#39' + RTRIM(ISNULL(PA.NOMBRE, '#39 +
        #39'))'
      '                             ))'
      '        FROM dbo.PRESCRIPTIONS PR'
      '        LEFT JOIN dbo.PACIENTES PA'
      '            ON PA.NUMEROCLIENTE = PR.NUMEROCLIENTE'
      '        WHERE'
      '            @IsNumeric = 1'
      '            AND @SearchInt IS NOT NULL'
      '            AND'
      '            ('
      
        '                (@SearchMode = '#39'PN'#39'   AND PR.NUMERORECETA = @Sea' +
        'rchInt)'
      '                OR'
      
        '                (@SearchMode = '#39'AUTO'#39' AND PR.NUMERORECETA = @Sea' +
        'rchInt)'
      '            )'
      ''
      '        UNION ALL'
      ''
      '        /* RX = OTCNUMBER */'
      '        SELECT'
      '            ResultType     = '#39'PRESCRIPTION'#39','
      '            MatchType      = '#39'RX'#39','
      '            RankScore      = CASE'
      
        '                                WHEN @SearchMode = '#39'RX'#39'   AND @S' +
        'earchInt IS NOT NULL AND O.OTCNUMBER = @SearchInt THEN 800'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @S' +
        'earchInt IS NOT NULL AND O.OTCNUMBER = @SearchInt THEN 700'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = O.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = O.NUMERORECETA,'
      '            OTCNumber      = O.OTCNUMBER,'
      '            FechaOTC       = O.FECHAOTC,'
      
        '            DisplayText    = '#39'RX'#39' + CAST(O.OTCNUMBER AS VARCHAR(' +
        '20)) +'
      
        '                             '#39' | PN'#39' + CAST(O.NUMERORECETA AS VA' +
        'RCHAR(20)) +'
      '                             '#39' | '#39' +'
      '                             LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      
        '                                '#39', '#39' + RTRIM(ISNULL(PA.NOMBRE, '#39 +
        #39'))'
      '                             ))'
      '        FROM dbo.OTC O'
      '        LEFT JOIN dbo.PACIENTES PA'
      '            ON PA.NUMEROCLIENTE = O.NUMEROCLIENTE'
      '        WHERE'
      '            @IsNumeric = 1'
      '            AND @SearchInt IS NOT NULL'
      '            AND'
      '            ('
      
        '                (@SearchMode = '#39'RX'#39'   AND O.OTCNUMBER = @SearchI' +
        'nt)'
      '                OR'
      
        '                (@SearchMode = '#39'AUTO'#39' AND O.OTCNUMBER = @SearchI' +
        'nt)'
      '            )'
      ''
      '        UNION ALL'
      ''
      '        /* P = patient number */'
      '        SELECT'
      '            ResultType     = '#39'PATIENT'#39','
      '            MatchType      = '#39'P'#39','
      '            RankScore      = CASE'
      
        '                                WHEN @SearchMode = '#39'P'#39'    AND @S' +
        'earchInt IS NOT NULL AND PA.NUMEROCLIENTE = @SearchInt THEN 600'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @S' +
        'earchInt IS NOT NULL AND PA.NUMEROCLIENTE = @SearchInt THEN 500'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = PA.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = CAST(NULL AS INT),'
      '            OTCNumber      = CAST(NULL AS INT),'
      '            FechaOTC       = CAST(NULL AS DATETIME),'
      
        '            DisplayText    = '#39'P'#39' + CAST(PA.NUMEROCLIENTE AS VARC' +
        'HAR(20)) +'
      '                             '#39' | '#39' +'
      '                             LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      
        '                                '#39', '#39' + RTRIM(ISNULL(PA.NOMBRE, '#39 +
        #39'))'
      '                             ))'
      '        FROM dbo.PACIENTES PA'
      '        WHERE'
      '            @IsNumeric = 1'
      '            AND @SearchInt IS NOT NULL'
      '            AND'
      '            ('
      
        '                (@SearchMode = '#39'P'#39'    AND PA.NUMEROCLIENTE = @Se' +
        'archInt)'
      '                OR'
      
        '                (@SearchMode = '#39'AUTO'#39' AND PA.NUMEROCLIENTE = @Se' +
        'archInt)'
      '            )'
      ''
      '        UNION ALL'
      ''
      '        /* TEL = phone */'
      '        SELECT'
      '            ResultType     = '#39'PATIENT'#39','
      '            MatchType      = '#39'TEL'#39','
      '            RankScore      = CASE'
      
        '                                WHEN @SearchMode = '#39'TEL'#39' THEN 40' +
        '0'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @I' +
        'sNumeric = 1 AND LEN(@DigitsOnly) >= 7 THEN 300'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = PA.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = CAST(NULL AS INT),'
      '            OTCNumber      = CAST(NULL AS INT),'
      '            FechaOTC       = CAST(NULL AS DATETIME),'
      '            DisplayText    = '#39'TEL'#39' +'
      '                             LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))) +'
      '                             '#39' | '#39' +'
      '                             LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      
        '                                '#39', '#39' + RTRIM(ISNULL(PA.NOMBRE, '#39 +
        #39'))'
      '                             ))'
      '        FROM dbo.PACIENTES PA'
      '        WHERE'
      '            ('
      '                (@SearchMode = '#39'TEL'#39')'
      '                OR'
      
        '                (@SearchMode = '#39'AUTO'#39' AND @IsNumeric = 1 AND LEN' +
        '(@DigitsOnly) >= 7)'
      '            )'
      '            AND'
      '            ('
      
        '                REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RT' +
        'RIM(ISNULL(PA.TELEFONO, '#39#39'))), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39' '#39 +
        ', '#39#39'), '#39'.'#39', '#39#39') LIKE '#39'%'#39' + @DigitsOnly + '#39'%'#39
      
        '                OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM' +
        '(RTRIM(ISNULL(PA.CELULAR, '#39#39'))), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39 +
        ' '#39', '#39#39'), '#39'.'#39', '#39#39') LIKE '#39'%'#39' + @DigitsOnly + '#39'%'#39
      
        '                OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM' +
        '(RTRIM(ISNULL(PA.NIGHT_PHONE, '#39#39'))), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39 +
        '), '#39' '#39', '#39#39'), '#39'.'#39', '#39#39') LIKE '#39'%'#39' + @DigitsOnly + '#39'%'#39
      
        '                OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM' +
        '(RTRIM(ISNULL(PA.PRIMARY_TELEPHONE, '#39#39'))), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39 +
        '-'#39', '#39#39'), '#39' '#39', '#39#39'), '#39'.'#39', '#39#39') LIKE '#39'%'#39' + @DigitsOnly + '#39'%'#39
      '            )'
      ''
      '        UNION ALL'
      ''
      '        /* ID = identification */'
      '        SELECT'
      '            ResultType     = '#39'PATIENT'#39','
      '            MatchType      = '#39'ID'#39','
      '            RankScore      = CASE'
      '                                WHEN @SearchMode = '#39'ID'#39' THEN 350'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @I' +
        'sNumeric = 1 AND LEN(@DigitsOnly) >= 4 THEN 250'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = PA.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = CAST(NULL AS INT),'
      '            OTCNumber      = CAST(NULL AS INT),'
      '            FechaOTC       = CAST(NULL AS DATETIME),'
      '            DisplayText    = '#39'ID'#39' +'
      '                             LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.IDENTIFIC' +
        'ACION, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.SSN, '#39#39'))' +
        ', '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CARDHOLDE' +
        'RID, '#39#39')), '#39#39')'
      '                             ))) +'
      '                             '#39' | '#39' +'
      '                             LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      
        '                                '#39', '#39' + RTRIM(ISNULL(PA.NOMBRE, '#39 +
        #39'))'
      '                             ))'
      '        FROM dbo.PACIENTES PA'
      '        WHERE'
      '            ('
      '                (@SearchMode = '#39'ID'#39')'
      '                OR'
      
        '                (@SearchMode = '#39'AUTO'#39' AND @IsNumeric = 1 AND LEN' +
        '(@DigitsOnly) >= 4)'
      '            )'
      '            AND'
      '            ('
      
        '                LTRIM(RTRIM(ISNULL(PA.IDENTIFICACION, '#39#39'))) LIKE' +
        ' '#39'%'#39' + @SearchText + '#39'%'#39
      
        '                OR LTRIM(RTRIM(ISNULL(PA.SSN, '#39#39'))) LIKE '#39'%'#39' + @' +
        'SearchText + '#39'%'#39
      
        '                OR LTRIM(RTRIM(ISNULL(PA.CARDHOLDERID, '#39#39'))) LIK' +
        'E '#39'%'#39' + @SearchText + '#39'%'#39
      '            )'
      ''
      '        UNION ALL'
      ''
      '        /* NAME = tokenized patient name search */'
      '        SELECT'
      '            ResultType     = '#39'PATIENT'#39','
      '            MatchType      = '#39'NAME'#39','
      '            RankScore      = CASE'
      
        '                                WHEN @SearchMode = '#39'NAME'#39' THEN 2' +
        '00'
      
        '                                WHEN @SearchMode = '#39'AUTO'#39' AND @I' +
        'sNumeric = 0 THEN 150'
      '                                ELSE 0'
      '                             END,'
      '            NumeroCliente  = PA.NUMEROCLIENTE,'
      '            PatientName    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )),'
      
        '            Identificacion = LTRIM(RTRIM(ISNULL(PA.IDENTIFICACIO' +
        'N, '#39#39'))),'
      '            Telefono       = LTRIM(RTRIM(COALESCE('
      
        '                                NULLIF(RTRIM(ISNULL(PA.TELEFONO,' +
        ' '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.CELULAR, ' +
        #39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.NIGHT_PHO' +
        'NE, '#39#39')), '#39#39'),'
      
        '                                NULLIF(RTRIM(ISNULL(PA.PRIMARY_T' +
        'ELEPHONE, '#39#39')), '#39#39')'
      '                             ))),'
      '            NumeroReceta   = CAST(NULL AS INT),'
      '            OTCNumber      = CAST(NULL AS INT),'
      '            FechaOTC       = CAST(NULL AS DATETIME),'
      '            DisplayText    = LTRIM(RTRIM('
      
        '                                RTRIM(ISNULL(PA.APELLIDOPATERNO,' +
        ' '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'APELLIDOMATERNO, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.APELLID' +
        'OMATERNO)'
      '                                     ELSE '#39#39
      '                                END +'
      '                                '#39', '#39' +'
      '                                RTRIM(ISNULL(PA.NOMBRE, '#39#39')) +'
      
        '                                CASE WHEN LTRIM(RTRIM(ISNULL(PA.' +
        'MIDDLE_NAME, '#39#39'))) <> '#39#39
      
        '                                     THEN '#39' '#39' + RTRIM(PA.MIDDLE_' +
        'NAME)'
      '                                     ELSE '#39#39
      '                                END'
      '                             )) +'
      
        '                             '#39' | P'#39' + CAST(PA.NUMEROCLIENTE AS V' +
        'ARCHAR(20))'
      '        FROM dbo.PACIENTES PA'
      '        WHERE'
      '            ('
      '                (@SearchMode = '#39'NAME'#39')'
      '                OR'
      '                (@SearchMode = '#39'AUTO'#39' AND @IsNumeric = 0)'
      '            )'
      '            AND'
      '            ('
      '                EXISTS (SELECT 1 FROM @Tokens)'
      '                AND NOT EXISTS'
      '                ('
      '                    SELECT 1'
      '                    FROM @Tokens T'
      '                    WHERE'
      
        '                        UPPER(RTRIM(ISNULL(PA.NOMBRE, '#39#39'))) NOT ' +
        'LIKE '#39'%'#39' + T.Token + '#39'%'#39
      
        '                        AND UPPER(RTRIM(ISNULL(PA.MIDDLE_NAME, '#39 +
        #39'))) NOT LIKE '#39'%'#39' + T.Token + '#39'%'#39
      
        '                        AND UPPER(RTRIM(ISNULL(PA.APELLIDOPATERN' +
        'O, '#39#39'))) NOT LIKE '#39'%'#39' + T.Token + '#39'%'#39
      
        '                        AND UPPER(RTRIM(ISNULL(PA.APELLIDOMATERN' +
        'O, '#39#39'))) NOT LIKE '#39'%'#39' + T.Token + '#39'%'#39
      '                )'
      '            )'
      '    ),'
      '    Ranked AS'
      '    ('
      '        SELECT'
      '            ResultType,'
      '            MatchType,'
      '            RankScore,'
      '            NumeroCliente,'
      '            PatientName,'
      '            Identificacion,'
      '            Telefono,'
      '            NumeroReceta,'
      '            OTCNumber,'
      '            FechaOTC,'
      '            DisplayText,'
      '            RN = ROW_NUMBER() OVER'
      '            ('
      '                PARTITION BY'
      '                    ResultType,'
      
        '                    ISNULL(CAST(NumeroCliente AS VARCHAR(20)), '#39 +
        #39'),'
      
        '                    ISNULL(CAST(NumeroReceta AS VARCHAR(20)), '#39#39 +
        '),'
      '                    ISNULL(CAST(OTCNumber AS VARCHAR(20)), '#39#39')'
      '                ORDER BY RankScore DESC, PatientName'
      '            )'
      '        FROM Results'
      '        WHERE RankScore > 0'
      '    )'
      '    SELECT TOP 100'
      '        ResultType,'
      '        MatchType,'
      '        RankScore,'
      '        NumeroCliente,'
      '        PatientName,'
      '        Identificacion,'
      '        Telefono,'
      '        NumeroReceta,'
      '        OTCNumber,'
      '        FechaOTC,'
      '        DisplayText'
      '    FROM Ranked'
      '    WHERE RN = 1'
      '    ORDER BY'
      '        RankScore DESC,'
      '        PatientName,'
      '        NumeroReceta,'
      '        OTCNumber;'
      'END;')
    Left = 7016
    Top = 1648
  end
  object fn_D0_GetFloatCharacter: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE FUNCTION dbo.fn_D0_GetFloatCharacter'
      '('
      '    @tokenvalue DECIMAL(18,2)'
      ')'
      'RETURNS VARCHAR(20)'
      'AS'
      'BEGIN'
      '    DECLARE @outputToken     VARCHAR(20);'
      '    DECLARE @token           VARCHAR(20);'
      '    DECLARE @len             INT;'
      '    DECLARE @last_chr        CHAR(1);'
      '    DECLARE @str_output      VARCHAR(20);'
      '    DECLARE @spec_character  CHAR(1);'
      ''
      '    IF @tokenvalue IS NULL'
      '        RETURN NULL;'
      ''
      '    IF @tokenvalue = 0'
      '        RETURN '#39'{'#39';'
      ''
      
        '    SET @token = REPLACE(CONVERT(VARCHAR(20), CONVERT(DECIMAL(18' +
        ',2), @tokenvalue)), '#39'.'#39', '#39#39');'
      '    SET @len = LEN(@token);'
      '    SET @last_chr = SUBSTRING(@token, @len, 1);'
      '    SET @str_output = SUBSTRING(@token, 1, @len - 1);'
      ''
      '    SET @spec_character ='
      '        CASE @last_chr'
      '            WHEN '#39'0'#39' THEN '#39'{'#39
      '            WHEN '#39'1'#39' THEN '#39'A'#39
      '            WHEN '#39'2'#39' THEN '#39'B'#39
      '            WHEN '#39'3'#39' THEN '#39'C'#39
      '            WHEN '#39'4'#39' THEN '#39'D'#39
      '            WHEN '#39'5'#39' THEN '#39'E'#39
      '            WHEN '#39'6'#39' THEN '#39'F'#39
      '            WHEN '#39'7'#39' THEN '#39'G'#39
      '            WHEN '#39'8'#39' THEN '#39'H'#39
      '            WHEN '#39'9'#39' THEN '#39'I'#39
      '        END;'
      ''
      '    RETURN @str_output + @spec_character;'
      'END;'
      '')
    Left = 7200
    Top = 184
  end
  object D0_SEG01_Patient_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.D0_SEG01_Patient_schema'
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(MAX) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      ''
      '    DECLARE @customer_no INT;'
      '    DECLARE @defaultvalue NVARCHAR(100);'
      '    DECLARE @ncpdp CHAR(6);'
      '    DECLARE @RowNo INT, @TotalRows INT;'
      ''
      '    DECLARE'
      '          @pat_id_qualifier VARCHAR(8) = '#39#39
      '        , @pat_id           VARCHAR(20) = '#39#39
      '        , @dob              CHAR(8)     = '#39#39
      '        , @gender           CHAR(1)     = '#39#39
      '        , @pat_name         VARCHAR(12) = '#39#39
      '        , @pat_ln           VARCHAR(15) = '#39#39
      '        , @pat_address      VARCHAR(30) = '#39#39
      '        , @pat_city         VARCHAR(20) = '#39#39
      '        , @pat_state        CHAR(2)     = '#39#39
      '        , @pat_zipcode      VARCHAR(5)  = '#39#39
      '        , @pat_telephone    VARCHAR(10) = '#39#39
      '        , @pat_cel          VARCHAR(10) = '#39#39
      '        , @pat_place_of_service VARCHAR(2) = '#39#39
      '        , @pat_employer_id  VARCHAR(15) = '#39#39
      '        , @pat_pregnancy_indi CHAR(1)   = '#39#39
      '        , @pat_email        VARCHAR(80) = '#39#39
      '        , @pat_residence    VARCHAR(2)  = '#39#39';'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      '    SELECT @customer_no = O.NUMEROCLIENTE'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    IF @customer_no IS NULL'
      '        RETURN;'
      ''
      '    SELECT'
      '          @pat_id_qualifier = ISNULL(P.PATIENT_ID_QUAL, '#39#39')'
      '        , @pat_id           = ISNULL(P.IDENTIFICACION, '#39#39')'
      
        '        , @dob              = CONVERT(CHAR(8), P.FECHANACIMIENTO' +
        ', 112)'
      '        , @gender           = CAST(ISNULL(P.SEXO, 0) AS CHAR(1))'
      '        , @pat_name         = RTRIM(ISNULL(P.NOMBRE, '#39#39'))'
      
        '        , @pat_ln           = RTRIM(ISNULL(P.APELLIDOPATERNO, '#39#39 +
        '))'
      '        , @pat_address      = RTRIM(ISNULL(P.DIRECCION1, '#39#39'))'
      '        , @pat_city         = RTRIM(ISNULL(P.CIUDAD, '#39#39'))'
      '        , @pat_state        = ISNULL(P.ESTADO, '#39#39')'
      
        '        , @pat_zipcode      = ISNULL(SUBSTRING(P.CODIGOPOSTAL,1,' +
        '5), '#39#39')'
      '        , @pat_telephone    = CONCAT('
      
        '                                SUBSTRING(ISNULL(P.TELEFONO,'#39#39'),' +
        '2,3),'
      
        '                                SUBSTRING(ISNULL(P.TELEFONO,'#39#39'),' +
        '6,3),'
      
        '                                SUBSTRING(ISNULL(P.TELEFONO,'#39#39'),' +
        '10,4))'
      '        , @pat_cel          = CONCAT('
      
        '                                SUBSTRING(ISNULL(P.CELULAR,'#39#39'),2' +
        ',3),'
      
        '                                SUBSTRING(ISNULL(P.CELULAR,'#39#39'),6' +
        ',3),'
      
        '                                SUBSTRING(ISNULL(P.CELULAR,'#39#39'),1' +
        '0,4))'
      '        , @pat_place_of_service = ISNULL(P.PLACE_OF_SERVICE,'#39#39')'
      '        , @pat_employer_id  = ISNULL(P.EMPLOYER_ID,'#39#39')'
      '        , @pat_pregnancy_indi = ISNULL(P.PREGNANCY_IDICATOR,'#39#39')'
      '        , @pat_email        = ISNULL(P.EMAIL,'#39#39')'
      '        , @pat_residence    = ISNULL(P.PATIENT_RESIDENCE,'#39#39')'
      '    FROM dbo.PACIENTES P'
      '    WHERE P.NUMEROCLIENTE = @customer_no;'
      ''
      '    IF RTRIM(ISNULL(@pat_telephone,'#39#39')) = '#39#39
      '        SET @pat_telephone = @pat_cel;'
      ''
      
        '    IF OBJECT_ID('#39'tempdb..#SEG01'#39') IS NOT NULL DROP TABLE #SEG01' +
        ';'
      ''
      '    SELECT'
      '          ROW_NUMBER() OVER (ORDER BY S.ID) AS RowNo'
      '        , RTRIM(N.NCPDP) AS NCPDP'
      
        '        , NULLIF(LTRIM(RTRIM(ISNULL(S.DefaultValue, '#39#39'))), '#39#39') A' +
        'S DefaultValue'
      '    INTO #SEG01'
      '    FROM dbo.INSSCHEMA S'
      '    INNER JOIN dbo.NCPDP N'
      '        ON N.FIELD = S.FIELD'
      '    WHERE S.SCHEMA1 = RTRIM(@schema)'
      '      AND S.SEGMENT = '#39'01'#39
      '      AND S.TR = @TransactionCode;'
      ''
      '    SELECT @TotalRows = COUNT(*) FROM #SEG01;'
      ''
      '    IF @TotalRows = 0'
      '        RETURN;'
      ''
      '    SET @segment_str = @SEG + @FS + '#39'AM01'#39';'
      '    SET @RowNo = 1;'
      ''
      '    WHILE @RowNo <= @TotalRows'
      '    BEGIN'
      '        SELECT'
      '              @ncpdp = NCPDP'
      '            , @defaultvalue = DefaultValue'
      '        FROM #SEG01'
      '        WHERE RowNo = @RowNo;'
      ''
      '        IF @ncpdp = '#39'331-CX'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CX'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@pat_id_qualifier,'#39#39')) <> '#39#39' T' +
        'HEN @FS + '#39'CX'#39' + RTRIM(@pat_id_qualifier)'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'332-CY'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CY'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_id,'#39#39')) <> '#39#39' THEN @FS + ' +
        #39'CY'#39' + RTRIM(UPPER(@pat_id))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'304-C4'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'C4'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@dob,'#39#39')) <> '#39#39' THEN @FS + '#39'C4' +
        #39' + @dob'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'305-C5'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'C5'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@gender,'#39#39')) <> '#39#39' THEN @FS + ' +
        #39'C5'#39' + @gender'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'310-CA'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CA'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_name,'#39#39')) <> '#39#39' THEN @FS ' +
        '+ '#39'CA'#39' + RTRIM(UPPER(@pat_name))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'311-CB'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CB'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_ln,'#39#39')) <> '#39#39' THEN @FS + ' +
        #39'CB'#39' + RTRIM(UPPER(@pat_ln))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'322-CM'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CM'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_address,'#39#39')) <> '#39#39' THEN @' +
        'FS + '#39'CM'#39' + RTRIM(UPPER(@pat_address))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'323-CN'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CN'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_city,'#39#39')) <> '#39#39' THEN @FS ' +
        '+ '#39'CN'#39' + RTRIM(UPPER(@pat_city))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'324-CO'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CO'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_state,'#39#39')) <> '#39#39' THEN @FS' +
        ' + '#39'CO'#39' + RTRIM(UPPER(@pat_state))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'325-CP'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CP'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@pat_zipcode,'#39#39')) <> '#39#39' THEN @' +
        'FS + '#39'CP'#39' + RTRIM(@pat_zipcode)'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'326-CQ'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CQ'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@pat_telephone,'#39#39')) <> '#39#39' THEN' +
        ' @FS + '#39'CQ'#39' + RTRIM(@pat_telephone)'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'307-C7'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'C7'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_place_of_service,'#39#39')) <> ' +
        #39#39' THEN @FS + '#39'C7'#39' + RTRIM(UPPER(@pat_place_of_service))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'333-CZ'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'CZ'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_employer_id,'#39#39')) <> '#39#39' TH' +
        'EN @FS + '#39'CZ'#39' + RTRIM(UPPER(@pat_employer_id))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'335-2C'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2C'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN (@gender = '#39'2'#39') AND (@pat_pregnancy_indi IN' +
        ' ('#39'1'#39','#39'2'#39')) THEN @FS + '#39'2C'#39' + RTRIM(UPPER(@pat_pregnancy_indi))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'350-HN'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'HN'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_email,'#39#39')) <> '#39#39' THEN @FS' +
        ' + '#39'HN'#39' + RTRIM(UPPER(@pat_email))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'384-4X'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'4X'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@pat_residence,'#39#39')) <> '#39#39' THEN' +
        ' @FS + '#39'4X'#39' + RTRIM(UPPER(@pat_residence))'
      '                ELSE '#39#39' END;'
      ''
      '        SET @RowNo += 1;'
      '    END'
      'END;'
      '')
    Left = 7200
    Top = 280
  end
  object D0_SEG07_Claim_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.D0_SEG07_Claim_schema'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(MAX) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      '    DECLARE @norx BIGINT;'
      '    DECLARE @ndc CHAR(11);'
      '    DECLARE @alt_ndc CHAR(11);'
      '    DECLARE @prod_serv_qualifier CHAR(2);'
      '    DECLARE @assc_rx_servirefno CHAR(7);'
      '    DECLARE @assc_rx_servirefdate CHAR(8);'
      '    DECLARE @met_dec_qty INT;'
      '    DECLARE @alt_qty DECIMAL(18,2);'
      '    DECLARE @new_ref_code SMALLINT;'
      '    DECLARE @days_supply INT;'
      '    DECLARE @comp_code INT;'
      '    DECLARE @daw SMALLINT;'
      '    DECLARE @no_refill_auth INT;'
      '    DECLARE @rx_origin_code CHAR(1);'
      '    DECLARE @OtherCoverageCode CHAR(1);'
      '    DECLARE @spec_pack_indi CHAR(2);'
      '    DECLARE @org_pros_prod_servid VARCHAR(30);'
      '    DECLARE @org_presc_qty INT;'
      '    DECLARE @unit_of_meassure CHAR(2);'
      '    DECLARE @level_of_service INT;'
      '    DECLARE @prior_auth_type_code CHAR(1);'
      '    DECLARE @prior_auth CHAR(11);'
      '    DECLARE @IATID_463_EW CHAR(2);'
      '    DECLARE @IAID_464_EX CHAR(11);'
      '    DECLARE @rx_disp_status CHAR(1);'
      '    DECLARE @qty_int_disp INT;'
      '    DECLARE @days_supply_int_disp INT;'
      '    DECLARE @DRC_357_NV CHAR(2);'
      '    DECLARE @PAI_391_MT CHAR(2);'
      '    DECLARE @rout_of_admin CHAR(11);'
      '    DECLARE @compound_type CHAR(12);'
      '    DECLARE @PST_147_U7 CHAR(2);'
      '    DECLARE @DateRXWritten DATE;'
      '    DECLARE @qty_prescribed INT;'
      '    DECLARE @shedule_rx_id_no NCHAR(12);'
      ''
      '    DECLARE @seg07_counter INT = 1;'
      '    DECLARE @seg07_total INT = 0;'
      '    DECLARE @ncpdp CHAR(6);'
      '    DECLARE @defaultvalue NVARCHAR(100);'
      '    DECLARE @value VARCHAR(100);'
      ''
      '    DECLARE @subclarif_rows INT = 0;'
      '    DECLARE @subclarif_count INT = 1;'
      '    DECLARE @sub_clarification_code CHAR(2);'
      '    DECLARE @nxdk_str VARCHAR(MAX) = '#39#39';'
      '    DECLARE @nxdk_exists BIT = 0;'
      '    DECLARE @nxdk_inserted BIT = 0;'
      '    DECLARE @has_415_DF BIT = 0;'
      ''
      '    SELECT'
      '          @norx                 = ISNULL(O.NUMERORECETA, 0)'
      '        , @ndc                  = ISNULL(O.NDC, '#39#39')'
      '        , @alt_ndc              = ISNULL(O.ALT_NDC, '#39#39')'
      
        '        , @prod_serv_qualifier  = ISNULL(O.PRODUCTSERVIDQUAL, '#39'0' +
        '3'#39')'
      
        '        , @assc_rx_servirefno   = ISNULL(O.ASSOC_RX_SERVICE_REF_' +
        'NO, '#39#39')'
      
        '        , @assc_rx_servirefdate = CONVERT(CHAR(8), O.ASSOC_RX_SE' +
        'RVICE_DATE, 112)'
      
        '        , @met_dec_qty          = ISNULL(O.METRICDECIMALQUANTITY' +
        ', 0)'
      '        , @alt_qty              = ISNULL(O.ALT_QTY, 0)'
      '        , @new_ref_code         = ISNULL(O.CODIGOREFILLNUEVO, 0)'
      '        , @days_supply          = ISNULL(O.DAYS_SUPPLY, 0)'
      '        , @daw                  = ISNULL(O.DAW, 0)'
      
        '        , @OtherCoverageCode    = ISNULL(O.OTHERCOVERAGECODE, '#39#39 +
        ')'
      
        '        , @spec_pack_indi       = ISNULL(O.SPECIAL_PACK_INDI_429' +
        '_DT, '#39#39')'
      
        '        , @org_pros_prod_servid = ISNULL(O.ORG_PROS_PROD_SERVID,' +
        ' '#39#39')'
      '        , @org_presc_qty        = ISNULL(O.ORG_PRESC_QTY, 0)'
      '        , @unit_of_meassure     = ISNULL(O.UNIT_OF_MEASURE, '#39#39')'
      '        , @level_of_service     = ISNULL(O.LEVELOFSERVICE, 0)'
      
        '        , @prior_auth_type_code = ISNULL(O.PRIOR_AUTH_TYPE_CODE,' +
        ' '#39#39')'
      
        '        , @prior_auth           = ISNULL(O.PRIORAUTHORIZATION, '#39 +
        #39')'
      '        , @IATID_463_EW         = ISNULL(O.IATID_463_EW, '#39#39')'
      '        , @IAID_464_EX          = ISNULL(O.IAID_464_EX, '#39#39')'
      
        '        , @rx_disp_status       = ISNULL(O.DISPENSING_STATUS, '#39#39 +
        ')'
      '        , @qty_int_disp         = ISNULL(O.QTY_INTENDED_DISP, 0)'
      
        '        , @days_supply_int_disp = ISNULL(O.DAYS_SUPPLY_INTEND_DI' +
        'SP, 0)'
      '        , @DRC_357_NV           = ISNULL(O.DRC_357_NV, '#39#39')'
      '        , @PAI_391_MT           = ISNULL(O.PAI_391_MT, '#39#39')'
      
        '        , @rout_of_admin        = ISNULL(O.ROUTEOFADMIN_995_E2, ' +
        #39#39')'
      
        '        , @compound_type        = ISNULL(O.COMPOUND_TYPE_996_G1,' +
        ' '#39#39')'
      '        , @PST_147_U7           = ISNULL(O.PST_147_U7, '#39'1'#39')'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    IF ISNULL(@norx, 0) = 0'
      '        RETURN;'
      ''
      '    SELECT'
      '          @DateRXWritten    = P.FECHARECETA'
      '        , @comp_code        = ISNULL(P.COMPOUNDCODE, 0)'
      
        '        , @no_refill_auth   = ISNULL(P.NUMEROREFILLSAUTORIZADOS,' +
        ' 0)'
      '        , @rx_origin_code   = ISNULL(P.RXORIGINCODE, '#39#39')'
      
        '        , @qty_prescribed   = FLOOR(ISNULL(P.CANTIDADRECETADA, 0' +
        ')) * 1000'
      '        , @shedule_rx_id_no = ISNULL(P.SCHEDULE_RX_ID_NO, '#39#39')'
      '    FROM dbo.PRESCRIPTIONS P'
      '    WHERE P.NUMERORECETA = @norx;'
      ''
      '    IF LTRIM(RTRIM(ISNULL(@alt_ndc, '#39#39'))) <> '#39#39
      '        SET @ndc = @alt_ndc;'
      ''
      '    IF OBJECT_ID('#39'tempdb..#SCC'#39') IS NOT NULL DROP TABLE #SCC;'
      ''
      '    SELECT'
      '          RowNo = ROW_NUMBER() OVER ('
      '                    ORDER BY ISNULL(SCC_420_DK, '#39#39'),'
      '                             ISNULL(NUMERORECETA, 0),'
      '                             ISNULL(OTCNUMBER, 0)'
      '                  )'
      '        , SCC_420_DK'
      '    INTO #SCC'
      '    FROM dbo.SUB_CLARIFICATION_CODE'
      '    WHERE OTCNUMBER = @otc_number;'
      ''
      '    SELECT @subclarif_rows = COUNT(*) FROM #SCC;'
      ''
      
        '    SET @nxdk_exists = CASE WHEN @subclarif_rows > 0 THEN 1 ELSE' +
        ' 0 END;'
      ''
      '    IF @nxdk_exists = 1'
      '    BEGIN'
      
        '        SET @nxdk_str = @FS + '#39'NX'#39' + CAST(@subclarif_rows AS VAR' +
        'CHAR(10));'
      ''
      '        WHILE @subclarif_count <= @subclarif_rows'
      '        BEGIN'
      '            SELECT @sub_clarification_code = SCC_420_DK'
      '            FROM #SCC'
      '            WHERE RowNo = @subclarif_count;'
      ''
      '            IF RTRIM(ISNULL(@sub_clarification_code, '#39#39')) <> '#39#39
      
        '                SET @nxdk_str += @FS + '#39'DK'#39' + RTRIM(@sub_clarifi' +
        'cation_code);'
      ''
      '            SET @subclarif_count += 1;'
      '        END;'
      '    END;'
      ''
      '    DROP TABLE #SCC;'
      ''
      '    SET @segment_str = @SEG + @FS + '#39'AM07'#39';'
      ''
      
        '    IF OBJECT_ID('#39'tempdb..#SEG07'#39') IS NOT NULL DROP TABLE #SEG07' +
        ';'
      ''
      '    SELECT'
      '          RowNo = ROW_NUMBER() OVER (ORDER BY S.ID)'
      '        , S.FIELD'
      '        , RTRIM(N.NCPDP) AS NCPDP'
      
        '        , NULLIF(LTRIM(RTRIM(ISNULL(S.DefaultValue, '#39#39'))), '#39#39') A' +
        'S DefaultValue'
      '    INTO #SEG07'
      '    FROM dbo.INSSCHEMA S'
      '    INNER JOIN dbo.NCPDP N'
      '        ON N.FIELD = S.FIELD'
      '    WHERE S.SCHEMA1 = RTRIM(@schema)'
      '      AND S.SEGMENT = '#39'07'#39
      '      AND S.TR = @TransactionCode'
      '    ORDER BY S.ID;'
      ''
      '    SELECT @seg07_total = COUNT(*) FROM #SEG07;'
      ''
      '    IF EXISTS (SELECT 1 FROM #SEG07 WHERE NCPDP = '#39'415-DF'#39')'
      '        SET @has_415_DF = 1;'
      ''
      '    WHILE @seg07_counter <= @seg07_total'
      '    BEGIN'
      '        SELECT'
      '              @ncpdp = NCPDP'
      '            , @defaultvalue = DefaultValue'
      '        FROM #SEG07'
      '        WHERE RowNo = @seg07_counter;'
      ''
      '        IF @ncpdp = '#39'455-EM'#39
      '        BEGIN'
      '            SET @value = COALESCE(@defaultvalue, '#39'1'#39');'
      '            SET @segment_str += @FS + '#39'EM'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'402-D2'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, RTRIM(CAST(@nor' +
        'x AS VARCHAR(10))));'
      '            IF RTRIM(@value) <> '#39#39
      '                SET @segment_str += @FS + '#39'D2'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'436-E1'#39
      '        BEGIN'
      '            SET @value = COALESCE('
      '                @defaultvalue,'
      
        '                CASE WHEN @comp_code = 1 THEN RTRIM(ISNULL(@prod' +
        '_serv_qualifier, '#39'03'#39')) ELSE '#39'00'#39' END'
      '            );'
      ''
      '            SET @segment_str += @FS + '#39'E1'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'407-D7'#39
      '        BEGIN'
      '            SET @value = COALESCE('
      '                @defaultvalue,'
      
        '                CASE WHEN @comp_code = 1 THEN RTRIM(ISNULL(@ndc,' +
        ' '#39#39')) ELSE '#39'0'#39' END'
      '            );'
      ''
      '            SET @segment_str += @FS + '#39'D7'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'456-EN'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@assc_rx_servirefno, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'EN'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'457-EP'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@assc_rx_servirefdate, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'EP'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'442-E7'#39
      '        BEGIN'
      '            IF @defaultvalue IS NOT NULL'
      
        '                SET @segment_str += @FS + '#39'E7'#39' + RTRIM(@defaultv' +
        'alue);'
      '            ELSE'
      '            BEGIN'
      '                IF @alt_qty > 0'
      
        '                    SET @met_dec_qty = CAST(@alt_qty * 1000 AS I' +
        'NT);'
      ''
      '                IF @met_dec_qty > 0'
      
        '                    SET @segment_str += @FS + '#39'E7'#39' + RTRIM(CAST(' +
        '@met_dec_qty AS VARCHAR(10)));'
      '            END'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'403-D3'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, RTRIM(CAST(@new' +
        '_ref_code AS VARCHAR(2))));'
      '            SET @segment_str += @FS + '#39'D3'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'405-D5'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @days' +
        '_supply > 0 THEN RTRIM(CAST(@days_supply AS VARCHAR(3))) END);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'D5'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'406-D6'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @comp' +
        '_code > 0 THEN RTRIM(CAST(@comp_code AS VARCHAR(1))) END);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'D6'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'408-D8'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, RTRIM(CAST(@daw' +
        ' AS VARCHAR(1))));'
      '            SET @segment_str += @FS + '#39'D8'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'414-DE'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @Date' +
        'RXWritten IS NOT NULL THEN CONVERT(CHAR(8), @DateRXWritten, 112)' +
        ' END);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'DE'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'415-DF'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, RTRIM(CAST(@no_' +
        'refill_auth AS VARCHAR(2))));'
      '            SET @segment_str += @FS + '#39'DF'#39' + RTRIM(@value);'
      ''
      '            IF @nxdk_inserted = 0 AND @nxdk_exists = 1'
      '            BEGIN'
      '                SET @segment_str += @nxdk_str;'
      '                SET @nxdk_inserted = 1;'
      '            END'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'419-DJ'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@rx_origin_code, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'DJ'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'460-ET'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @qty_' +
        'prescribed > 0 THEN RTRIM(CAST(@qty_prescribed AS VARCHAR(10))) ' +
        'END);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'ET'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'308-C8'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@OtherCoverageCode, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C8'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'429-DT'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@spec_pack_indi, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'DT'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'445-EA'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@org_pros_prod_servid, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EA'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'446-EB'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @org_' +
        'presc_qty > 0 THEN RTRIM(CAST(@org_presc_qty AS VARCHAR(10))) EN' +
        'D);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'EB'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'454-EK'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@shedule_rx_id_no, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EK'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'600-28'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@unit_of_meassure, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'28'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'418-DI'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, RTRIM(CAST(@lev' +
        'el_of_service AS VARCHAR(10))));'
      '            SET @segment_str += @FS + '#39'DI'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'461-EU'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@prior_auth_type_code, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EU0'#39' + RTRIM(UPPER(@v' +
        'alue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'462-EV'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@prior_auth, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EV'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'463-EW'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@IATID_463_EW, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EW'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'464-EX'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@IAID_464_EX, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'EX'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'343-HD'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@rx_disp_status, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'HD'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'344-HF'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @qty_' +
        'int_disp > 0 THEN RTRIM(CAST(@qty_int_disp AS VARCHAR(10))) END)' +
        ';'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'HF'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'345-HG'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, CASE WHEN @days' +
        '_supply_int_disp > 0 THEN RTRIM(CAST(@days_supply_int_disp AS VA' +
        'RCHAR(10))) END);'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      '                SET @segment_str += @FS + '#39'HG'#39' + RTRIM(@value);'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'357-NV'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@DRC_357_NV, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'NV'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'391-MT'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@PAI_391_MT, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'MT'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'995-E2'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@rout_of_admin, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'E2'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'996-G1'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@compound_type, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'G1'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF @ncpdp = '#39'147-U7'#39
      '        BEGIN'
      
        '            SET @value = COALESCE(@defaultvalue, NULLIF(RTRIM(IS' +
        'NULL(@PST_147_U7, '#39#39')), '#39#39'));'
      '            IF RTRIM(ISNULL(@value, '#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'U7'#39' + RTRIM(UPPER(@va' +
        'lue));'
      '        END'
      ''
      '        ELSE IF RTRIM(ISNULL(@defaultvalue, '#39#39')) <> '#39#39
      '        BEGIN'
      
        '            SET @segment_str += @FS + RIGHT(@ncpdp, 2) + RTRIM(@' +
        'defaultvalue);'
      '        END;'
      ''
      '        SET @seg07_counter += 1;'
      '    END;'
      ''
      
        '    IF @nxdk_inserted = 0 AND @nxdk_exists = 1 AND @has_415_DF =' +
        ' 0'
      '    BEGIN'
      '        SET @segment_str += @nxdk_str;'
      '        SET @nxdk_inserted = 1;'
      '    END;'
      ''
      '    DROP TABLE #SEG07;'
      'END;')
    Left = 7208
    Top = 696
  end
  object D0_SEG03_Prescriber_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.D0_SEG03_Prescriber_schema'
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(MAX) OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      ''
      '    DECLARE @norx BIGINT, @prescriber_no INT;'
      
        '    DECLARE @defaultvalue NVARCHAR(100), @ncpdp CHAR(6), @RowNo ' +
        'INT, @TotalRows INT;'
      ''
      '    DECLARE'
      '          @presc_id_qualifier VARCHAR(2) = '#39#39
      '        , @presc_id           VARCHAR(15) = '#39#39
      '        , @presc_telephone    VARCHAR(10) = '#39#39
      '        , @presc_ln           VARCHAR(15) = '#39#39
      '        , @presc_name         VARCHAR(12) = '#39#39
      '        , @primarycareprov_idqual VARCHAR(2) = '#39#39
      '        , @primarycareprov_id VARCHAR(15) = '#39#39
      '        , @primarycareprov_ln VARCHAR(15) = '#39#39
      '        , @presc_address      VARCHAR(30) = '#39#39
      '        , @presc_city         VARCHAR(20) = '#39#39
      '        , @presc_state        VARCHAR(2) = '#39#39
      '        , @presc_zipcode      VARCHAR(5) = '#39#39';'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      '    SELECT'
      '          @norx = O.NUMERORECETA'
      
        '        , @primarycareprov_idqual = ISNULL(O.PRIMARYCAREPROVIDQU' +
        'ALIFIER, '#39#39')'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    IF @norx IS NULL'
      '        RETURN;'
      ''
      '    SELECT'
      '          @presc_id = ISNULL(P.LICENCIA, '#39#39')'
      '        , @prescriber_no = ISNULL(P.NUMERODOCTOR, 0)'
      '    FROM dbo.PRESCRIPTIONS P'
      '    WHERE P.NUMERORECETA = @norx;'
      ''
      '    SELECT'
      
        '          @presc_id_qualifier = ISNULL(D.PRESCRIBER_ID_QUALIFIER' +
        ', '#39#39')'
      '        , @presc_telephone = CONCAT('
      '                SUBSTRING(ISNULL(D.TELEFONO,'#39#39'),2,3),'
      '                SUBSTRING(ISNULL(D.TELEFONO,'#39#39'),6,3),'
      '                SUBSTRING(ISNULL(D.TELEFONO,'#39#39'),10,4))'
      '        , @presc_ln       = ISNULL(D.APELLIDO_PATERNO, '#39#39')'
      '        , @presc_address  = ISNULL(D.DIRECCION, '#39#39')'
      '        , @presc_city     = ISNULL(D.CITY, '#39#39')'
      '        , @presc_state    = ISNULL(D.ESTADO, '#39#39')'
      
        '        , @presc_zipcode  = ISNULL(SUBSTRING(D.CODIGO_POSTAL,1,5' +
        '), '#39#39')'
      '        , @presc_name     = ISNULL(D.NOMBRE, '#39#39')'
      '    FROM dbo.DOCTOR D'
      '    WHERE D.NUMERODOCTOR = @prescriber_no;'
      ''
      
        '    IF OBJECT_ID('#39'tempdb..#SEG03'#39') IS NOT NULL DROP TABLE #SEG03' +
        ';'
      ''
      '    SELECT'
      '          ROW_NUMBER() OVER (ORDER BY S.ID) AS RowNo'
      '        , RTRIM(N.NCPDP) AS NCPDP'
      
        '        , NULLIF(LTRIM(RTRIM(ISNULL(S.DefaultValue, '#39#39'))), '#39#39') A' +
        'S DefaultValue'
      '    INTO #SEG03'
      '    FROM dbo.INSSCHEMA S'
      '    INNER JOIN dbo.NCPDP N'
      '        ON N.FIELD = S.FIELD'
      '    WHERE S.SCHEMA1 = RTRIM(@schema)'
      '      AND S.SEGMENT = '#39'03'#39
      '      AND S.TR = @TransactionCode;'
      ''
      '    SELECT @TotalRows = COUNT(*) FROM #SEG03;'
      '    IF @TotalRows = 0 RETURN;'
      ''
      '    SET @segment_str = @SEG + @FS + '#39'AM03'#39';'
      '    SET @RowNo = 1;'
      ''
      '    WHILE @RowNo <= @TotalRows'
      '    BEGIN'
      '        SELECT '
      '              @ncpdp = NCPDP'
      '            , @defaultvalue = DefaultValue'
      '        FROM #SEG03'
      '        WHERE RowNo = @RowNo;'
      ''
      '        IF @ncpdp = '#39'466-EZ'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'EZ'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_id_qualifier,'#39#39')) <> '#39#39 +
        ' THEN @FS + '#39'EZ'#39' + RTRIM(UPPER(@presc_id_qualifier))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'411-DB'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'DB'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_id,'#39#39')) <> '#39#39' THEN @FS ' +
        '+ '#39'DB'#39' + RTRIM(UPPER(@presc_id))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'427-DR'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'DR'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_ln,'#39#39')) <> '#39#39' THEN @FS ' +
        '+ '#39'DR'#39' + RTRIM(UPPER(@presc_ln))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'498-PM'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'PM'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@presc_telephone,'#39#39')) <> '#39#39' TH' +
        'EN @FS + '#39'PM'#39' + RTRIM(@presc_telephone)'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'468-2E'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2E'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@primarycareprov_idqual,'#39#39')) <' +
        '> '#39#39' THEN @FS + '#39'2E'#39' + RTRIM(UPPER(@primarycareprov_idqual))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'421-DL'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'DL'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@primarycareprov_id,'#39#39')) <> '#39#39 +
        ' THEN @FS + '#39'DL'#39' + RTRIM(UPPER(@primarycareprov_id))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'470-4E'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'4E'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@primarycareprov_ln,'#39#39')) <> '#39#39 +
        ' THEN @FS + '#39'4E'#39' + RTRIM(UPPER(@primarycareprov_ln))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'364-2J'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2J'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_name,'#39#39')) <> '#39#39' THEN @F' +
        'S + '#39'2J'#39' + RTRIM(UPPER(@presc_name))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'365-2K'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2K'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_address,'#39#39')) <> '#39#39' THEN' +
        ' @FS + '#39'2K'#39' + RTRIM(UPPER(@presc_address))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'366-2M'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2M'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_city,'#39#39')) <> '#39#39' THEN @F' +
        'S + '#39'2M'#39' + RTRIM(UPPER(@presc_city))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'367-2N'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2N'#39' + RTRIM(UPPER(@defaultvalue))'
      
        '                WHEN RTRIM(ISNULL(@presc_state,'#39#39')) <> '#39#39' THEN @' +
        'FS + '#39'2N'#39' + RTRIM(UPPER(@presc_state))'
      '                ELSE '#39#39' END;'
      ''
      '        ELSE IF @ncpdp = '#39'368-2P'#39
      '            SET @segment_str += CASE'
      
        '                WHEN RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39' THEN ' +
        '@FS + '#39'2P'#39' + RTRIM(@defaultvalue)'
      
        '                WHEN RTRIM(ISNULL(@presc_zipcode,'#39#39')) <> '#39#39' THEN' +
        ' @FS + '#39'2P'#39' + RTRIM(@presc_zipcode)'
      '                ELSE '#39#39' END;'
      ''
      '        SET @RowNo += 1;'
      '    END;'
      'END;')
    Left = 7192
    Top = 368
  end
  object D0_SEG04_Insurance_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_SEG04_Insurance_schema]'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(MAX) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Variables'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @customer_no INT;'
      '    DECLARE @nopatplan INT;'
      '    DECLARE @planesmedicosno INT;'
      ''
      '    DECLARE @cardholder_id VARCHAR(20) = '#39#39';'
      '    DECLARE @person_code CHAR(3) = '#39#39';'
      '    DECLARE @group_id VARCHAR(15) = '#39#39';'
      '    DECLARE @relationship CHAR(1) = '#39#39';'
      '    DECLARE @other_coverage CHAR(1) = '#39#39';'
      '    DECLARE @medicaid_indicator CHAR(1) = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Schema loop vars'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @ncpdp CHAR(6);'
      '    DECLARE @defaultvalue NCHAR(20);'
      '    DECLARE @counter INT = 1;'
      '    DECLARE @total INT = 0;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load OTC'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT'
      '          @customer_no     = O.NUMEROCLIENTE'
      '        , @nopatplan       = O.NUMEROPLAN'
      '        , @planesmedicosno = O.PLANESMEDICOSNO'
      '        , @other_coverage= ISNULL(O.OTHERCOVERAGECODE, '#39#39')'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    IF ISNULL(@customer_no, 0) = 0'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load PATPLAN (patient insurance)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT'
      '          @cardholder_id = ISNULL(PP.CARDHOLDERID, '#39#39')'
      '        , @person_code   = ISNULL(PP.PERSONCODE, '#39#39')'
      '        , @group_id      = ISNULL(PP.NOGRUPO, '#39#39')'
      '        , @relationship  = ISNULL(PP.RELACION, '#39#39')        '
      
        '        , @medicaid_indicator = ISNULL(PP.MEDICAID_INDICATOR, '#39#39 +
        ')'
      '    FROM dbo.PATPLAN PP'
      '    WHERE PP.NUMEROPLAN = @nopatplan;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load PLANESMEDICOS (plan master)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    --SELECT'
      
        '    --    @medicaid_indicator = ISNULL(PM.MEDICAID_INDICATOR, '#39#39 +
        ')'
      '    --FROM dbo.PLANESMEDICOS PM'
      '    --WHERE PM.PLANESMEDICOSNO = @planesmedicosno;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @segment_str = @SEG + @FS + '#39'AM04'#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load schema once'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#SEG04'#39') IS NOT NULL'
      '        DROP TABLE #SEG04;'
      ''
      '    SELECT'
      '          RowNo = ROW_NUMBER() OVER (ORDER BY S.ID)'
      '        , RTRIM(N.NCPDP) AS NCPDP'
      '        , S.DefaultValue'
      '    INTO #SEG04'
      '    FROM dbo.INSSCHEMA S'
      '    INNER JOIN dbo.NCPDP N'
      '        ON N.FIELD = S.FIELD'
      '    WHERE S.SCHEMA1 = @schema'
      '      AND S.SEGMENT = '#39'04'#39
      '      AND S.TR = @TransactionCode'
      '    ORDER BY S.ID;'
      ''
      '    SELECT @total = COUNT(*) FROM #SEG04;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build segment in schema order'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    WHILE @counter <= @total'
      '    BEGIN'
      '        SELECT'
      '              @ncpdp = NCPDP'
      '            , @defaultvalue = DefaultValue'
      '        FROM #SEG04'
      '        WHERE RowNo = @counter;'
      ''
      '        IF (@ncpdp = '#39'302-C2'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@cardholder_id,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C2'#39' + RTRIM(UPPER(@ca' +
        'rdholder_id));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C2'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        ELSE IF (@ncpdp = '#39'303-C3'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@person_code,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C3'#39' + RTRIM(UPPER(@pe' +
        'rson_code));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C3'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        ELSE IF (@ncpdp = '#39'301-C1'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@group_id,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C1'#39' + RTRIM(UPPER(@gr' +
        'oup_id));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C1'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        ELSE IF (@ncpdp = '#39'306-C6'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@relationship,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C6'#39' + RTRIM(UPPER(@re' +
        'lationship));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C6'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        ELSE IF (@ncpdp = '#39'308-C8'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@other_coverage,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C8'#39' + RTRIM(UPPER(@ot' +
        'her_coverage));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C8'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        ELSE IF (@ncpdp = '#39'309-C9'#39')'
      '        BEGIN'
      '            IF RTRIM(ISNULL(@medicaid_indicator,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C9'#39' + RTRIM(UPPER(@me' +
        'dicaid_indicator));'
      '            ELSE IF RTRIM(ISNULL(@defaultvalue,'#39#39')) <> '#39#39
      
        '                SET @segment_str += @FS + '#39'C9'#39' + RTRIM(UPPER(@de' +
        'faultvalue));'
      '        END'
      ''
      '        SET @counter += 1;'
      '    END'
      ''
      '    DROP TABLE #SEG04;'
      'END')
    Left = 7200
    Top = 448
  end
  object D0_SEG11_Pricing_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.D0_SEG11_Pricing_schema'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(MAX) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Output'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @segment_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Pricing values'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @ing_cost                DECIMAL(18,2) = 0;'
      '    DECLARE @disp_fee                DECIMAL(18,2) = 0;'
      '    DECLARE @pat_paid_amount         DECIMAL(18,2) = 0;'
      '    DECLARE @incentive_amount_sub    DECIMAL(18,2) = 0;'
      '    DECLARE @usual_customary_charge  DECIMAL(18,2) = 0;'
      '    DECLARE @gross_amount_due        DECIMAL(18,2) = 0;'
      '    DECLARE @basis_of_cost           CHAR(2) = '#39#39';'
      '    DECLARE @medicaid_paid_amount    DECIMAL(18,2) = 0;'
      '    DECLARE @other_amount_count      INT = 0;'
      '    DECLARE @other_amount_claim_qual CHAR(2) = '#39#39';'
      '    DECLARE @other_amount_claim_sub  DECIMAL(18,2) = 0;'
      '    DECLARE @prof_serv_fee           DECIMAL(18,2) = 0;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Schema vars'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @seg11_counter INT = 1;'
      '    DECLARE @seg11_total   INT = 0;'
      '    DECLARE @ncpdp         CHAR(6);'
      '    DECLARE @defaultvalue  NCHAR(20);'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load OTC pricing values once'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT'
      
        '          @ing_cost                = ISNULL(O.PRECIOFACTURACION,' +
        ' 0)'
      '        , @disp_fee                = ISNULL(O.DISPENSINGFEE, 0)'
      
        '        , @pat_paid_amount         = ISNULL(O.PATIENTPAIDAMOUNT,' +
        ' 0)'
      
        '        , @incentive_amount_sub    = ISNULL(O.INCENTIVE_AMOUNT_S' +
        'UB, 0)'
      '        , @usual_customary_charge  = ISNULL(O.TOTAL, 0)'
      '        , @gross_amount_due        = ISNULL(O.GROSSAMOUNTDUE, 0)'
      '        , @basis_of_cost           = ISNULL(O.BASISOFCOST, '#39#39')'
      
        '        , @medicaid_paid_amount    = ISNULL(O.MEDICAID_PAID_AMOU' +
        'NT, 0)'
      
        '        , @other_amount_count      = ISNULL(O.OTHERAMOUNTCLAIMED' +
        'SUBCOUNT, 0)'
      
        '        , @other_amount_claim_qual = ISNULL(O.OTAMCLDSUBCOUNTQUA' +
        'L, '#39#39')'
      
        '        , @other_amount_claim_sub  = ISNULL(O.OTHERAMOUNTCLAIMED' +
        'SUB, 0)'
      
        '        , @prof_serv_fee           = ISNULL(O.PROF_SERV_FEE_SUB,' +
        ' 0)'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    IF @@ROWCOUNT = 0'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @segment_str = @SEG + @FS + '#39'AM11'#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load Segment 11 schema'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#SEG11'#39') IS NOT NULL'
      '        DROP TABLE #SEG11;'
      ''
      '    SELECT'
      '          RowNo = ROW_NUMBER() OVER (ORDER BY S.ID)'
      '        , S.FIELD'
      '        , RTRIM(N.NCPDP) AS NCPDP'
      '        , S.DefaultValue'
      '    INTO #SEG11'
      '    FROM dbo.INSSCHEMA S'
      '    INNER JOIN dbo.NCPDP N'
      '        ON N.FIELD = S.FIELD'
      '    WHERE S.SCHEMA1 = @schema'
      '      AND S.SEGMENT = '#39'11'#39
      '      AND S.TR = @TransactionCode'
      '    ORDER BY S.ID;'
      ''
      '    SELECT @seg11_total = COUNT(*)'
      '    FROM #SEG11;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build fields in schema order'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    WHILE @seg11_counter <= @seg11_total'
      '    BEGIN'
      '        SELECT'
      '              @ncpdp = NCPDP'
      '            , @defaultvalue = DefaultValue'
      '        FROM #SEG11'
      '        WHERE RowNo = @seg11_counter;'
      ''
      '        IF (@ncpdp = '#39'409-D9'#39') AND (@ing_cost >= 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'D9'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@ing_cost));'
      '        END'
      '        ELSE IF (@ncpdp = '#39'412-DC'#39') AND (@disp_fee >= 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'DC'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@disp_fee));'
      '        END'
      '        ELSE IF (@ncpdp = '#39'477-BE'#39') AND (@prof_serv_fee > 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'BE'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@prof_serv_fee));'
      '        END'
      '        ELSE IF (@ncpdp = '#39'433-DX'#39') AND (@pat_paid_amount >= 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'DX'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@pat_paid_amount));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'438-E3'#39') AND (@incentive_amount_sub >' +
        ' 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'E3'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@incentive_amount_sub));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'480-H7'#39') AND (@other_amount_count > 0' +
        ')'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'H7'#39' + RTRIM(CAST(@other_a' +
        'mount_count AS VARCHAR(1)));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'481-H8'#39') AND (@other_amount_count > 0' +
        ') AND (RTRIM(ISNULL(@other_amount_claim_qual, '#39#39')) <> '#39#39')'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'H8'#39' + RTRIM(UPPER(@other_' +
        'amount_claim_qual));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'482-H9'#39') AND (@other_amount_count > 0' +
        ') AND (@other_amount_claim_sub > 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'H9'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@other_amount_claim_sub));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'426-DQ'#39') AND (@usual_customary_charge' +
        ' >= 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'DQ'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@usual_customary_charge));'
      '        END'
      '        ELSE IF (@ncpdp = '#39'430-DU'#39')'
      '        BEGIN'
      
        '            -- Preserve your original business rule from the mai' +
        'n builder'
      '            SET @gross_amount_due ='
      '                ISNULL(@disp_fee, 0) +'
      '                ISNULL(@ing_cost, 0) +'
      '                ISNULL(@incentive_amount_sub, 0) +'
      '                ISNULL(@other_amount_claim_sub, 0) +'
      '                ISNULL(@prof_serv_fee, 0);'
      ''
      '            IF @gross_amount_due >= 0'
      
        '                SET @segment_str += @FS + '#39'DU'#39' + RTRIM(dbo.fn_D0' +
        '_GetFloatCharacter(@gross_amount_due));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'423-DN'#39') AND (RTRIM(ISNULL(@basis_of_' +
        'cost, '#39#39')) <> '#39#39')'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'DN'#39' + RTRIM(UPPER(@basis_' +
        'of_cost));'
      '        END'
      
        '        ELSE IF (@ncpdp = '#39'113-N3'#39') AND (@medicaid_paid_amount >' +
        ' 0)'
      '        BEGIN'
      
        '            SET @segment_str += @FS + '#39'N3'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@medicaid_paid_amount));'
      '        END'
      '        ELSE IF RTRIM(ISNULL(@defaultvalue, '#39#39')) <> '#39#39
      '        BEGIN'
      
        '            SET @segment_str += @FS + RIGHT(@ncpdp, 2) + RTRIM(@' +
        'defaultvalue);'
      '        END'
      ''
      '        SET @seg11_counter += 1;'
      '    END'
      ''
      '    DROP TABLE #SEG11;'
      'END'
      '')
    Left = 7224
    Top = 976
  end
  object D0_SEG05_COB_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_SEG05_COB_schema]'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(4000) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @WorkCOBString VARCHAR(MAX) = '#39#39';'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Schema fields + DefaultValue for Segment 05'
      
        '    -- If DefaultValue has value, it overrides the COB table val' +
        'ue.'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE'
      
        '        @D338 VARCHAR(100), @D339 VARCHAR(100), @D340 VARCHAR(10' +
        '0),'
      '        @D443 VARCHAR(100), @D993 VARCHAR(100),'
      '        @D342 VARCHAR(100), @D431 VARCHAR(100),'
      '        @D472 VARCHAR(100),'
      '        @D351 VARCHAR(100), @D352 VARCHAR(100),'
      '        @D393 VARCHAR(100), @D394 VARCHAR(100);'
      ''
      '    ;WITH S AS'
      '    ('
      '        SELECT'
      '            RTRIM(N.NCPDP) AS NCPDP,'
      
        '            NULLIF(LTRIM(RTRIM(ISNULL(I.DefaultValue, '#39#39'))), '#39#39')' +
        ' AS DefaultValue'
      '        FROM dbo.INSSCHEMA I'
      '        JOIN dbo.NCPDP N'
      '          ON N.FIELD = I.FIELD'
      '        WHERE I.SCHEMA1 = RTRIM(@schema)'
      '          AND I.SEGMENT = '#39'05'#39
      '          AND I.TR = @TransactionCode'
      '    )'
      '    SELECT'
      
        '        @D338 = MAX(CASE WHEN NCPDP = '#39'338-5C'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D339 = MAX(CASE WHEN NCPDP = '#39'339-6C'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D340 = MAX(CASE WHEN NCPDP = '#39'340-7C'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D443 = MAX(CASE WHEN NCPDP = '#39'443-E8'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D993 = MAX(CASE WHEN NCPDP = '#39'993-A7'#39' THEN DefaultValue' +
        ' END),'
      ''
      
        '        @D342 = MAX(CASE WHEN NCPDP = '#39'342-HC'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D431 = MAX(CASE WHEN NCPDP = '#39'431-DV'#39' THEN DefaultValue' +
        ' END),'
      ''
      
        '        @D472 = MAX(CASE WHEN NCPDP = '#39'472-6E'#39' THEN DefaultValue' +
        ' END),'
      ''
      
        '        @D351 = MAX(CASE WHEN NCPDP = '#39'351-NP'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D352 = MAX(CASE WHEN NCPDP = '#39'352-NQ'#39' THEN DefaultValue' +
        ' END),'
      ''
      
        '        @D393 = MAX(CASE WHEN NCPDP = '#39'393-MV'#39' THEN DefaultValue' +
        ' END),'
      
        '        @D394 = MAX(CASE WHEN NCPDP = '#39'394-MW'#39' THEN DefaultValue' +
        ' END)'
      '    FROM S;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Parent set COB_A'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#A'#39') IS NOT NULL DROP TABLE #A;'
      ''
      '    SELECT'
      '        rn = ROW_NUMBER() OVER (ORDER BY NOTRANS, OTCNUMBER),'
      '        NOTRANS,'
      '        COB_338_5C,'
      '        COB_339_6C,'
      '        COB_340_7C,'
      '        COB_443_E8,'
      '        COB_993_A7'
      '    INTO #A'
      '    FROM dbo.COB_A'
      '    WHERE OTCNUMBER = @otc_number;'
      ''
      '    IF NOT EXISTS (SELECT 1 FROM #A)'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Child sets'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#B'#39') IS NOT NULL DROP TABLE #B;'
      '    IF OBJECT_ID('#39'tempdb..#C'#39') IS NOT NULL DROP TABLE #C;'
      '    IF OBJECT_ID('#39'tempdb..#D'#39') IS NOT NULL DROP TABLE #D;'
      '    IF OBJECT_ID('#39'tempdb..#E'#39') IS NOT NULL DROP TABLE #E;'
      ''
      '    SELECT'
      
        '        rn = ROW_NUMBER() OVER (PARTITION BY NOTRANS ORDER BY ID' +
        '),'
      '        NOTRANS,'
      '        COB_342_HC,'
      '        COB_431_DV'
      '    INTO #B'
      '    FROM dbo.COB_B'
      '    WHERE NOTRANS IN (SELECT NOTRANS FROM #A);'
      ''
      '    SELECT'
      
        '        rn = ROW_NUMBER() OVER (PARTITION BY NOTRANS ORDER BY ID' +
        '),'
      '        NOTRANS,'
      '        COB_472_6E'
      '    INTO #C'
      '    FROM dbo.COB_C'
      '    WHERE NOTRANS IN (SELECT NOTRANS FROM #A);'
      ''
      '    SELECT'
      
        '        rn = ROW_NUMBER() OVER (PARTITION BY NOTRANS ORDER BY ID' +
        '),'
      '        NOTRANS,'
      '        COB_351_NP,'
      '        COB_352_NQ'
      '    INTO #D'
      '    FROM dbo.COB_D'
      '    WHERE NOTRANS IN (SELECT NOTRANS FROM #A);'
      ''
      '    SELECT'
      
        '        rn = ROW_NUMBER() OVER (PARTITION BY NOTRANS ORDER BY ID' +
        '),'
      '        NOTRANS,'
      '        COB_393_MV,'
      '        COB_394_MW'
      '    INTO #E'
      '    FROM dbo.COB_E'
      '    WHERE NOTRANS IN (SELECT NOTRANS FROM #A);'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @TotalA INT;'
      '    SELECT @TotalA = COUNT(*) FROM #A;'
      ''
      '    SET @WorkCOBString = @SEG + @FS + '#39'AM05'#39
      
        '                       + @FS + '#39'4C'#39' + CAST(@TotalA AS VARCHAR(10' +
        ')); -- 337-4C'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Loop parent rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @i INT = 1;'
      '    DECLARE @notrans INT;'
      ''
      '    DECLARE @338 CHAR(2);'
      '    DECLARE @339 CHAR(2);'
      '    DECLARE @340 CHAR(10);'
      '    DECLARE @443 DATE;'
      '    DECLARE @993 NVARCHAR(30);'
      ''
      '    DECLARE @cntB INT;'
      '    DECLARE @cntC INT;'
      '    DECLARE @cntD INT;'
      '    DECLARE @cntE INT;'
      ''
      '    DECLARE @ChildText VARCHAR(MAX);'
      ''
      '    WHILE @i <= @TotalA'
      '    BEGIN'
      '        SELECT'
      '            @notrans = NOTRANS,'
      '            @338     = COB_338_5C,'
      '            @339     = COB_339_6C,'
      '            @340     = COB_340_7C,'
      '            @443     = COB_443_E8,'
      '            @993     = COB_993_A7'
      '        FROM #A'
      '        WHERE rn = @i;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- COB_A fields'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        IF COALESCE(@D338, NULLIF(RTRIM(ISNULL(@338, '#39#39')), '#39#39')) ' +
        'IS NOT NULL'
      
        '            SET @WorkCOBString += @FS + '#39'5C'#39' + RTRIM(UPPER(COALE' +
        'SCE(@D338, @338)));'
      ''
      '        IF @TransactionCode <> '#39'B2'#39
      '        BEGIN'
      
        '            IF COALESCE(@D339, NULLIF(RTRIM(ISNULL(@339, '#39#39')), '#39 +
        #39')) IS NOT NULL'
      
        '                SET @WorkCOBString += @FS + '#39'6C'#39' + RTRIM(UPPER(C' +
        'OALESCE(@D339, @339)));'
      ''
      
        '            IF COALESCE(@D340, NULLIF(RTRIM(ISNULL(@340, '#39#39')), '#39 +
        #39')) IS NOT NULL'
      
        '                SET @WorkCOBString += @FS + '#39'7C'#39' + RTRIM(UPPER(C' +
        'OALESCE(@D340, @340)));'
      ''
      
        '            IF COALESCE(@D443, CASE WHEN @443 IS NOT NULL THEN C' +
        'ONVERT(CHAR(8), @443, 112) END) IS NOT NULL'
      
        '                SET @WorkCOBString += @FS + '#39'E8'#39' + RTRIM(COALESC' +
        'E(@D443, CONVERT(CHAR(8), @443, 112)));'
      ''
      
        '            IF COALESCE(@D993, NULLIF(RTRIM(ISNULL(@993, '#39#39')), '#39 +
        #39')) IS NOT NULL'
      
        '                SET @WorkCOBString += @FS + '#39'A7'#39' + RTRIM(UPPER(C' +
        'OALESCE(@D993, @993)));'
      ''
      
        '            ----------------------------------------------------' +
        '-------------'
      '            -- COB_B'
      
        '            ----------------------------------------------------' +
        '-------------'
      
        '            SELECT @cntB = COUNT(*) FROM #B WHERE NOTRANS = @not' +
        'rans;'
      ''
      '            IF ISNULL(@cntB, 0) > 0'
      '            BEGIN'
      
        '                SET @WorkCOBString += @FS + '#39'HB'#39' + CAST(@cntB AS' +
        ' VARCHAR(2)); -- 341-HB'
      ''
      '                SET @ChildText = ISNULL(('
      '                    SELECT'
      '                        CASE'
      
        '                            WHEN COALESCE(@D342, NULLIF(RTRIM(IS' +
        'NULL(B.COB_342_HC, '#39#39')), '#39#39')) IS NOT NULL'
      
        '                                THEN @FS + '#39'HC'#39' + RTRIM(UPPER(CO' +
        'ALESCE(@D342, B.COB_342_HC)))'
      '                            ELSE '#39#39
      '                        END'
      '                        +'
      '                        CASE'
      '                            WHEN @D431 IS NOT NULL'
      '                                THEN @FS + '#39'DV'#39' + RTRIM(@D431)'
      
        '                            WHEN B.COB_431_DV IS NOT NULL AND B.' +
        'COB_431_DV >= 0'
      
        '                                THEN @FS + '#39'DV'#39' + dbo.fn_D0_GetF' +
        'loatCharacter(B.COB_431_DV)'
      '                            ELSE '#39#39
      '                        END'
      '                    FROM #B B'
      '                    WHERE B.NOTRANS = @notrans'
      '                    ORDER BY B.rn'
      '                    FOR XML PATH('#39#39'), TYPE'
      '                ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      '                SET @WorkCOBString += @ChildText;'
      '            END;'
      ''
      
        '            ----------------------------------------------------' +
        '-------------'
      '            -- COB_C'
      
        '            ----------------------------------------------------' +
        '-------------'
      
        '            SELECT @cntC = COUNT(*) FROM #C WHERE NOTRANS = @not' +
        'rans;'
      ''
      '            IF ISNULL(@cntC, 0) > 0'
      '            BEGIN'
      
        '                SET @WorkCOBString += @FS + '#39'5E'#39' + CAST(@cntC AS' +
        ' VARCHAR(2)); -- 471-5E'
      ''
      '                SET @ChildText = ISNULL(('
      '                    SELECT'
      '                        CASE'
      
        '                            WHEN COALESCE(@D472, NULLIF(RTRIM(IS' +
        'NULL(C.COB_472_6E, '#39#39')), '#39#39')) IS NOT NULL'
      
        '                                THEN @FS + '#39'6E'#39' + RTRIM(UPPER(CO' +
        'ALESCE(@D472, C.COB_472_6E)))'
      '                            ELSE '#39#39
      '                        END'
      '                    FROM #C C'
      '                    WHERE C.NOTRANS = @notrans'
      '                    ORDER BY C.rn'
      '                    FOR XML PATH('#39#39'), TYPE'
      '                ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      '                SET @WorkCOBString += @ChildText;'
      '            END;'
      ''
      
        '            ----------------------------------------------------' +
        '-------------'
      '            -- COB_D'
      
        '            ----------------------------------------------------' +
        '-------------'
      
        '            SELECT @cntD = COUNT(*) FROM #D WHERE NOTRANS = @not' +
        'rans;'
      ''
      '            IF ISNULL(@cntD, 0) > 0'
      '            BEGIN'
      
        '                SET @WorkCOBString += @FS + '#39'NR'#39' + CAST(@cntD AS' +
        ' VARCHAR(2)); -- 353-NR'
      ''
      '                SET @ChildText = ISNULL(('
      '                    SELECT'
      '                        CASE'
      
        '                            WHEN COALESCE(@D351, NULLIF(RTRIM(IS' +
        'NULL(D.COB_351_NP, '#39#39')), '#39#39')) IS NOT NULL'
      
        '                                THEN @FS + '#39'NP'#39' + RTRIM(UPPER(CO' +
        'ALESCE(@D351, D.COB_351_NP)))'
      '                            ELSE '#39#39
      '                        END'
      '                        +'
      '                        CASE'
      '                            WHEN @D352 IS NOT NULL'
      '                                THEN @FS + '#39'NQ'#39' + RTRIM(@D352)'
      
        '                            WHEN D.COB_352_NQ IS NOT NULL AND D.' +
        'COB_352_NQ >= 0'
      
        '                                THEN @FS + '#39'NQ'#39' + dbo.fn_D0_GetF' +
        'loatCharacter(D.COB_352_NQ)'
      '                            ELSE '#39#39
      '                        END'
      '                    FROM #D D'
      '                    WHERE D.NOTRANS = @notrans'
      '                    ORDER BY D.rn'
      '                    FOR XML PATH('#39#39'), TYPE'
      '                ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      '                SET @WorkCOBString += @ChildText;'
      '            END;'
      ''
      
        '            ----------------------------------------------------' +
        '-------------'
      '            -- COB_E'
      
        '            ----------------------------------------------------' +
        '-------------'
      
        '            SELECT @cntE = COUNT(*) FROM #E WHERE NOTRANS = @not' +
        'rans;'
      ''
      '            IF ISNULL(@cntE, 0) > 0'
      '            BEGIN'
      
        '                SET @WorkCOBString += @FS + '#39'MU'#39' + CAST(@cntE AS' +
        ' VARCHAR(2)); -- 392-MU'
      ''
      '                SET @ChildText = ISNULL(('
      '                    SELECT'
      '                        CASE'
      
        '                            WHEN COALESCE(@D393, NULLIF(RTRIM(IS' +
        'NULL(E.COB_393_MV, '#39#39')), '#39#39')) IS NOT NULL'
      
        '                                THEN @FS + '#39'MV'#39' + RTRIM(UPPER(CO' +
        'ALESCE(@D393, E.COB_393_MV)))'
      '                            ELSE '#39#39
      '                        END'
      '                        +'
      '                        CASE'
      '                            WHEN @D394 IS NOT NULL'
      '                                THEN @FS + '#39'MW'#39' + RTRIM(@D394)'
      
        '                            WHEN E.COB_394_MW IS NOT NULL AND E.' +
        'COB_394_MW >= 0'
      
        '                                THEN @FS + '#39'MW'#39' + dbo.fn_D0_GetF' +
        'loatCharacter(E.COB_394_MW)'
      '                            ELSE '#39#39
      '                        END'
      '                    FROM #E E'
      '                    WHERE E.NOTRANS = @notrans'
      '                    ORDER BY E.rn'
      '                    FOR XML PATH('#39#39'), TYPE'
      '                ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      '                SET @WorkCOBString += @ChildText;'
      '            END;'
      '        END;'
      ''
      '        SET @i += 1;'
      '    END;'
      ''
      '    SET @segment_str = LEFT(ISNULL(@WorkCOBString, '#39#39'), 4000);'
      'END;'
      '')
    Left = 7208
    Top = 536
  end
  object D0_SEG08_DUR_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_SEG08_DUR_schema]'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(500) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @segment_separator CHAR(1) = CHAR(30);'
      '    DECLARE @FS CHAR(1) = CHAR(28);'
      '    DECLARE @work_str VARCHAR(MAX) = '#39#39';'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Detect schema fields + DefaultValue'
      '    -- If DefaultValue has value, it overrides DUR_PPS value.'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE'
      '          @D473 VARCHAR(100)'
      '        , @D439 VARCHAR(100)'
      '        , @D440 VARCHAR(100)'
      '        , @D441 VARCHAR(100)'
      '        , @D474 VARCHAR(100)'
      '        , @D475 VARCHAR(100)'
      '        , @D476 VARCHAR(100);'
      ''
      '    ;WITH S AS'
      '    ('
      '        SELECT'
      '              RTRIM(N.NCPDP) AS NCPDP'
      
        '            , NULLIF(LTRIM(RTRIM(ISNULL(I.DefaultValue, '#39#39'))), '#39 +
        #39') AS DefaultValue'
      '        FROM dbo.INSSCHEMA I'
      '        INNER JOIN dbo.NCPDP N'
      '            ON N.FIELD = I.FIELD'
      '        WHERE I.SCHEMA1 = RTRIM(@schema)'
      '          AND I.SEGMENT = '#39'08'#39
      '          AND I.TR = @TransactionCode'
      '    )'
      '    SELECT'
      
        '          @D473 = NULLIF(MAX(CASE WHEN NCPDP = '#39'473-7E'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D439 = NULLIF(MAX(CASE WHEN NCPDP = '#39'439-E4'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D440 = NULLIF(MAX(CASE WHEN NCPDP = '#39'440-E5'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D441 = NULLIF(MAX(CASE WHEN NCPDP = '#39'441-E6'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D474 = NULLIF(MAX(CASE WHEN NCPDP = '#39'474-8E'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D475 = NULLIF(MAX(CASE WHEN NCPDP = '#39'475-J9'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      
        '        , @D476 = NULLIF(MAX(CASE WHEN NCPDP = '#39'476-H6'#39' THEN ISN' +
        'ULL(DefaultValue, '#39#39') ELSE '#39#39' END), '#39#39')'
      '    FROM S;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load DUR rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#DUR'#39') IS NOT NULL DROP TABLE #DUR;'
      ''
      '    SELECT'
      '          rn = ROW_NUMBER() OVER (ORDER BY OTCNUMBER)'
      '        , REASONFOR_SERVCODE'
      '        , PROF_SERVICE_CODE'
      '        , RESULT_OFSERVICE_CODE'
      '        , DUR_PPSLEVELOFEFFORT'
      '        , DUR_COAGENT_IDQUAL'
      '        , DUR_COAGENTID'
      '    INTO #DUR'
      '    FROM dbo.DUR_PPS WITH (NOLOCK)'
      '    WHERE OTCNUMBER = @otc_number;'
      ''
      '    IF NOT EXISTS (SELECT 1 FROM #DUR)'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str = @segment_separator + @FS + '#39'AM08'#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      
        '    -- Build segment without FOR XML because CHAR(28) is not leg' +
        'al XML.'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @i INT = 1;'
      '    DECLARE @total INT;'
      '    DECLARE @reason VARCHAR(100);'
      '    DECLARE @prof VARCHAR(100);'
      '    DECLARE @result VARCHAR(100);'
      '    DECLARE @level VARCHAR(100);'
      '    DECLARE @coAgentQual VARCHAR(100);'
      '    DECLARE @coAgentId VARCHAR(100);'
      ''
      '    SELECT @total = COUNT(*) FROM #DUR;'
      ''
      '    WHILE @i <= @total'
      '    BEGIN'
      '        SELECT'
      '              @reason = REASONFOR_SERVCODE'
      '            , @prof = PROF_SERVICE_CODE'
      '            , @result = RESULT_OFSERVICE_CODE'
      '            , @level = DUR_PPSLEVELOFEFFORT'
      '            , @coAgentQual = DUR_COAGENT_IDQUAL'
      '            , @coAgentId = DUR_COAGENTID'
      '        FROM #DUR'
      '        WHERE rn = @i;'
      ''
      '        IF COALESCE(@D473, CAST(@i AS VARCHAR(10))) IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'7E'#39' + RTRIM(COALESCE(@D473, ' +
        'CAST(@i AS VARCHAR(10))));'
      ''
      
        '        IF COALESCE(@D439, NULLIF(RTRIM(ISNULL(@reason, '#39#39')), '#39#39 +
        ')) IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'E4'#39' + RTRIM(UPPER(COALESCE(@' +
        'D439, @reason)));'
      ''
      
        '        IF COALESCE(@D440, NULLIF(RTRIM(ISNULL(@prof, '#39#39')), '#39#39'))' +
        ' IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'E5'#39' + RTRIM(UPPER(COALESCE(@' +
        'D440, @prof)));'
      ''
      
        '        IF COALESCE(@D441, NULLIF(RTRIM(ISNULL(@result, '#39#39')), '#39#39 +
        ')) IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'E6'#39' + RTRIM(UPPER(COALESCE(@' +
        'D441, @result)));'
      ''
      
        '        IF COALESCE(@D474, NULLIF(RTRIM(ISNULL(@level, '#39#39')), '#39#39')' +
        ') IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'8E'#39' + RTRIM(UPPER(COALESCE(@' +
        'D474, @level)));'
      ''
      
        '        IF COALESCE(@D475, NULLIF(RTRIM(ISNULL(@coAgentQual, '#39#39')' +
        '), '#39#39')) IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'J9'#39' + RTRIM(UPPER(COALESCE(@' +
        'D475, @coAgentQual)));'
      ''
      
        '        IF COALESCE(@D476, NULLIF(RTRIM(ISNULL(@coAgentId, '#39#39')),' +
        ' '#39#39')) IS NOT NULL'
      
        '            SET @work_str += @FS + '#39'H6'#39' + RTRIM(UPPER(COALESCE(@' +
        'D476, @coAgentId)));'
      ''
      '        SET @i += 1;'
      '    END;'
      ''
      '    SET @segment_str = LEFT(@work_str, 500);'
      'END;')
    Left = 7208
    Top = 776
  end
  object D0_SEG10_Compound_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_SEG10_Compound_schema]'
      '('
      '      @otc_number   INT'
      '    , @segment_str  VARCHAR(MAX) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      ''
      '    DECLARE @count INT = 0;'
      '    DECLARE @comp_dos_form_des_code CHAR(2) = '#39#39';'
      '    DECLARE @comp_unit_form_indi CHAR(1) = '#39#39';'
      ''
      '    DECLARE'
      '        @product_id_qualifier VARCHAR(2),'
      '        @ndc VARCHAR(11),'
      '        @metricquantity INT,'
      '        @awp DECIMAL(18,2),'
      '        @basis_of_cost VARCHAR(2);'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      '    SELECT'
      
        '          @comp_dos_form_des_code = ISNULL(O.COMPDOSAGE_FORM_DES' +
        'C_CODE, '#39#39')'
      
        '        , @comp_unit_form_indi    = ISNULL(O.COMPDISP_UNIT_FORM_' +
        'INDI, '#39#39')'
      '    FROM dbo.OTC O'
      '    WHERE O.OTCNUMBER = @otc_number;'
      ''
      '    SELECT @count = COUNT(*)'
      '    FROM dbo.MEZCLAS M'
      '    WHERE M.OTCNUMBER = @otc_number;'
      ''
      '    IF ISNULL(@count, 0) = 0'
      '        RETURN;'
      ''
      '    SET @segment_str = @SEG + @FS + '#39'AM10'#39';'
      ''
      '    IF RTRIM(ISNULL(@comp_dos_form_des_code, '#39#39')) <> '#39#39
      
        '        SET @segment_str += @FS + '#39'EF'#39' + RTRIM(UPPER(@comp_dos_f' +
        'orm_des_code));'
      ''
      '    IF RTRIM(ISNULL(@comp_unit_form_indi, '#39#39')) <> '#39#39
      
        '        SET @segment_str += @FS + '#39'EG'#39' + RTRIM(UPPER(@comp_unit_' +
        'form_indi));'
      ''
      
        '    SET @segment_str += @FS + '#39'EC'#39' + CAST(@count AS VARCHAR(10))' +
        ';'
      ''
      '    DECLARE CurCompound CURSOR LOCAL FAST_FORWARD FOR'
      '        SELECT'
      '              ISNULL(M.PRODUCT_ID_QUALIFIER, '#39#39')'
      '            , ISNULL(M.NDC, '#39#39')'
      '            , ISNULL(CAST(M.METRICQUANTITY AS INT), 0)'
      '            , CAST(ISNULL(M.AWP, 0) AS DECIMAL(18,2))'
      '            , ISNULL(M.ING_BASIS_OFCOST_DET, '#39#39')'
      '        FROM dbo.MEZCLAS M'
      '        WHERE M.OTCNUMBER = @otc_number'
      '        ORDER BY M.MEZCLASNO;'
      ''
      '    OPEN CurCompound;'
      ''
      '    FETCH NEXT FROM CurCompound'
      
        '    INTO @product_id_qualifier, @ndc, @metricquantity, @awp, @ba' +
        'sis_of_cost;'
      ''
      '    WHILE @@FETCH_STATUS = 0'
      '    BEGIN'
      '        IF RTRIM(ISNULL(@product_id_qualifier, '#39#39')) <> '#39#39
      
        '            SET @segment_str += @FS + '#39'RE'#39' + RTRIM(UPPER(@produc' +
        't_id_qualifier));'
      ''
      '        IF RTRIM(ISNULL(@ndc, '#39#39')) <> '#39#39
      '            SET @segment_str += @FS + '#39'TE'#39' + RTRIM(UPPER(@ndc));'
      ''
      '        IF ISNULL(@metricquantity, 0) > 0'
      
        '            SET @segment_str += @FS + '#39'ED'#39' + CAST(@metricquantit' +
        'y AS VARCHAR(20));'
      ''
      '        IF ISNULL(@awp, 0) > 0'
      
        '            SET @segment_str += @FS + '#39'EE'#39' + RTRIM(dbo.fn_D0_Get' +
        'FloatCharacter(@awp));'
      ''
      '        IF RTRIM(ISNULL(@basis_of_cost, '#39#39')) <> '#39#39
      
        '            SET @segment_str += @FS + '#39'UE'#39' + RTRIM(UPPER(@basis_' +
        'of_cost));'
      ''
      '        FETCH NEXT FROM CurCompound'
      
        '        INTO @product_id_qualifier, @ndc, @metricquantity, @awp,' +
        ' @basis_of_cost;'
      '    END;'
      ''
      '    CLOSE CurCompound;'
      '    DEALLOCATE CurCompound;'
      'END;')
    Left = 7216
    Top = 872
  end
  object D0_SEG06_WorkersComp_schema: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[D0_SEG06_WorkersComp_schema]'
      '('
      '      @otc_number       INT'
      '    , @schema           CHAR(3)'
      '    , @TransactionCode  CHAR(2)'
      '    , @segment_str      VARCHAR(1000) OUTPUT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @SEG CHAR(1) = CHAR(30);'
      '    DECLARE @FS  CHAR(1) = CHAR(28);'
      '    DECLARE @work_str VARCHAR(MAX) = '#39#39';'
      ''
      '    SET @segment_str = '#39#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Detect schema fields for Segment 06'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE'
      '          @Has315 BIT = 0   -- 315-CF'
      '        , @Has316 BIT = 0   -- 316-CG'
      '        , @Has317 BIT = 0   -- 317-CH'
      '        , @Has318 BIT = 0   -- 318-CI'
      '        , @Has319 BIT = 0   -- 319-CJ'
      '        , @Has320 BIT = 0   -- 320-CK'
      '        , @Has434 BIT = 0   -- 434-DY'
      '        , @Has321 BIT = 0   -- 321-CL'
      '        , @Has327 BIT = 0   -- 327-CR'
      '        , @Has435 BIT = 0   -- 435-DZ'
      '        , @Has117 BIT = 0   -- 117-TR'
      '        , @Has118 BIT = 0   -- 118-TS'
      '        , @Has119 BIT = 0   -- 119-TT'
      '        , @Has120 BIT = 0   -- 120-TU'
      '        , @Has121 BIT = 0   -- 121-TV'
      '        , @Has122 BIT = 0   -- 122-TW'
      '        , @Has123 BIT = 0   -- 123-TX'
      '        , @Has124 BIT = 0   -- 124-TY'
      '        , @Has125 BIT = 0   -- 125-TZ'
      '        , @Has126 BIT = 0;  -- 126-UA'
      ''
      '    ;WITH S AS'
      '    ('
      '        SELECT RTRIM(N.NCPDP) AS NCPDP'
      '        FROM dbo.INSSCHEMA I'
      '        INNER JOIN dbo.NCPDP N'
      '            ON N.FIELD = I.FIELD'
      '        WHERE I.SCHEMA1 = RTRIM(@schema)'
      '          AND I.SEGMENT = '#39'06'#39
      '          AND I.TR = @TransactionCode'
      '    )'
      '    SELECT'
      
        '          @Has315 = MAX(CASE WHEN NCPDP = '#39'315-CF'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has316 = MAX(CASE WHEN NCPDP = '#39'316-CG'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has317 = MAX(CASE WHEN NCPDP = '#39'317-CH'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has318 = MAX(CASE WHEN NCPDP = '#39'318-CI'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has319 = MAX(CASE WHEN NCPDP = '#39'319-CJ'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has320 = MAX(CASE WHEN NCPDP = '#39'320-CK'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has434 = MAX(CASE WHEN NCPDP = '#39'434-DY'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has321 = MAX(CASE WHEN NCPDP = '#39'321-CL'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has327 = MAX(CASE WHEN NCPDP = '#39'327-CR'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has435 = MAX(CASE WHEN NCPDP = '#39'435-DZ'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has117 = MAX(CASE WHEN NCPDP = '#39'117-TR'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has118 = MAX(CASE WHEN NCPDP = '#39'118-TS'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has119 = MAX(CASE WHEN NCPDP = '#39'119-TT'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has120 = MAX(CASE WHEN NCPDP = '#39'120-TU'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has121 = MAX(CASE WHEN NCPDP = '#39'121-TV'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has122 = MAX(CASE WHEN NCPDP = '#39'122-TW'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has123 = MAX(CASE WHEN NCPDP = '#39'123-TX'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has124 = MAX(CASE WHEN NCPDP = '#39'124-TY'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has125 = MAX(CASE WHEN NCPDP = '#39'125-TZ'#39' THEN 1 ELSE 0' +
        ' END)'
      
        '        , @Has126 = MAX(CASE WHEN NCPDP = '#39'126-UA'#39' THEN 1 ELSE 0' +
        ' END)'
      '    FROM S;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load workers comp rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF OBJECT_ID('#39'tempdb..#WC'#39') IS NOT NULL'
      '        DROP TABLE #WC;'
      ''
      '    SELECT'
      '          rn = ROW_NUMBER() OVER (ORDER BY OTC_NUMBER)'
      '        , DATE_OF_INJURY'
      '        , EMPLOYER_NAME'
      '        , EMP_STREET_ADDRESS'
      '        , EMP_CITY'
      '        , EMP_STATE'
      '        , EMP_ZIP'
      '        , EMP_PHONE'
      '        , EMP_CONTACT_NAME'
      '        , CARRIER_ID'
      '        , CLAIM_REFERENCE_ID'
      '        , BILLING_ENTITY_TYPE_INDICATOR'
      '        , PAY_TO_QUALIFIER'
      '        , PAY_TO_ID'
      '        , PAY_TO_NAME'
      '        , PAY_TO_STREET_ADDRESS'
      '        , PAY_TO_CITY_ADDRESS'
      '        , PAY_TO_STATE'
      '        , PAY_TO_ZIP'
      '        , GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER'
      '        , GENERIC_EQUIVALENT_PRODUCT_ID'
      '    INTO #WC'
      '    FROM dbo.WORKERS_COMPENSATION_SEGMENT'
      '    WHERE OTC_NUMBER = @otc_number;'
      ''
      '    IF NOT EXISTS (SELECT 1 FROM #WC)'
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Segment header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str = @SEG + @FS + '#39'AM06'#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Build repeating rows'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SET @work_str += ISNULL('
      '    ('
      '        SELECT'
      '              CASE'
      
        '                  WHEN @Has315 = 1 AND RTRIM(ISNULL(W.EMPLOYER_N' +
        'AME, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CF'#39' + RTRIM(UPPER(W.EMPLOYER_N' +
        'AME))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has316 = 1 AND RTRIM(ISNULL(W.EMP_STREET' +
        '_ADDRESS, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CG'#39' + RTRIM(UPPER(W.EMP_STREET' +
        '_ADDRESS))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has317 = 1 AND RTRIM(ISNULL(W.EMP_CITY, ' +
        #39#39')) <> '#39#39
      '                      THEN @FS + '#39'CH'#39' + RTRIM(UPPER(W.EMP_CITY))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has318 = 1 AND RTRIM(ISNULL(W.EMP_STATE,' +
        ' '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CI'#39' + RTRIM(UPPER(W.EMP_STATE)' +
        ')'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has319 = 1 AND RTRIM(ISNULL(W.EMP_ZIP, '#39 +
        #39')) <> '#39#39
      '                      THEN @FS + '#39'CJ'#39' + RTRIM(UPPER(W.EMP_ZIP))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has320 = 1 AND RTRIM(ISNULL(W.EMP_PHONE,' +
        ' '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CK'#39' + RTRIM(UPPER(W.EMP_PHONE)' +
        ')'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has434 = 1 AND W.DATE_OF_INJURY IS NOT N' +
        'ULL'
      
        '                      THEN @FS + '#39'DY'#39' + CONVERT(CHAR(8), W.DATE_' +
        'OF_INJURY, 112)'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has321 = 1 AND RTRIM(ISNULL(W.EMP_CONTAC' +
        'T_NAME, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CL'#39' + RTRIM(UPPER(W.EMP_CONTAC' +
        'T_NAME))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has327 = 1 AND RTRIM(ISNULL(W.CARRIER_ID' +
        ', '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'CR'#39' + RTRIM(UPPER(W.CARRIER_ID' +
        '))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has435 = 1 AND RTRIM(ISNULL(W.CLAIM_REFE' +
        'RENCE_ID, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'DZ'#39' + RTRIM(UPPER(W.CLAIM_REFE' +
        'RENCE_ID))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has117 = 1 AND RTRIM(ISNULL(W.BILLING_EN' +
        'TITY_TYPE_INDICATOR, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TR'#39' + RTRIM(UPPER(W.BILLING_EN' +
        'TITY_TYPE_INDICATOR))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has118 = 1 AND RTRIM(ISNULL(W.PAY_TO_QUA' +
        'LIFIER, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TS'#39' + RTRIM(UPPER(W.PAY_TO_QUA' +
        'LIFIER))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has119 = 1 AND RTRIM(ISNULL(W.PAY_TO_ID,' +
        ' '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TT'#39' + RTRIM(UPPER(W.PAY_TO_ID)' +
        ')'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has120 = 1 AND RTRIM(ISNULL(W.PAY_TO_NAM' +
        'E, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TU'#39' + RTRIM(UPPER(W.PAY_TO_NAM' +
        'E))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has121 = 1 AND RTRIM(ISNULL(W.PAY_TO_STR' +
        'EET_ADDRESS, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TV'#39' + RTRIM(UPPER(W.PAY_TO_STR' +
        'EET_ADDRESS))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has122 = 1 AND RTRIM(ISNULL(W.PAY_TO_CIT' +
        'Y_ADDRESS, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TW'#39' + RTRIM(UPPER(W.PAY_TO_CIT' +
        'Y_ADDRESS))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has123 = 1 AND RTRIM(ISNULL(W.PAY_TO_STA' +
        'TE, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TX'#39' + RTRIM(UPPER(W.PAY_TO_STA' +
        'TE))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has124 = 1 AND RTRIM(ISNULL(W.PAY_TO_ZIP' +
        ', '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TY'#39' + RTRIM(UPPER(W.PAY_TO_ZIP' +
        '))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has125 = 1 AND RTRIM(ISNULL(W.GENERIC_EQ' +
        'UIVALENT_PRODUCT_ID_QUALIFIER, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'TZ'#39' + RTRIM(UPPER(W.GENERIC_EQ' +
        'UIVALENT_PRODUCT_ID_QUALIFIER))'
      '                  ELSE '#39#39
      '              END'
      '            + CASE'
      
        '                  WHEN @Has126 = 1 AND RTRIM(ISNULL(W.GENERIC_EQ' +
        'UIVALENT_PRODUCT_ID, '#39#39')) <> '#39#39
      
        '                      THEN @FS + '#39'UA'#39' + RTRIM(UPPER(W.GENERIC_EQ' +
        'UIVALENT_PRODUCT_ID))'
      '                  ELSE '#39#39
      '              END'
      '        FROM #WC W'
      '        ORDER BY W.rn'
      '        FOR XML PATH('#39#39'), TYPE'
      '    ).value('#39'.'#39', '#39'varchar(max)'#39'), '#39#39');'
      ''
      '    SET @segment_str = LEFT(@work_str, 1000);'
      ''
      '    IF LEN(@segment_str) <= 6'
      '        SET @segment_str = '#39#39';'
      'END')
    Left = 7208
    Top = 616
  end
  object PATIENT_LOOKUP: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.PATIENT_LOOKUP'
      '('
      '    @Token      VARCHAR(200),'
      '    @OnlyActive BIT = 0'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE'
      '        @TokenTrim      VARCHAR(200),'
      '        @WorkToken      VARCHAR(200),'
      '        @RawToken1      VARCHAR(100),'
      '        @RawToken2      VARCHAR(100),'
      '        @RawToken3      VARCHAR(100),'
      '        @RawToken4      VARCHAR(100),'
      '        @Token1         VARCHAR(100),'
      '        @Token2         VARCHAR(100),'
      '        @Token3         VARCHAR(100),'
      '        @Token4         VARCHAR(100),'
      '        @NumeroCliente  INT,'
      '        @p1             INT,'
      '        @p2             INT,'
      '        @p3             INT,'
      '        @i              INT;'
      ''
      '    SET @TokenTrim = LTRIM(RTRIM(ISNULL(@Token, '#39#39')));'
      '    SET @WorkToken = @TokenTrim;'
      ''
      '    SET @RawToken1 = '#39#39';'
      '    SET @RawToken2 = '#39#39';'
      '    SET @RawToken3 = '#39#39';'
      '    SET @RawToken4 = '#39#39';'
      ''
      '    SET @Token1 = '#39#39';'
      '    SET @Token2 = '#39#39';'
      '    SET @Token3 = '#39#39';'
      '    SET @Token4 = '#39#39';'
      ''
      '    SET @NumeroCliente = 0;'
      ''
      '    IF @TokenTrim = '#39#39
      '        RETURN;'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- 1) Force NumeroCliente with *12345'
      
        '    ------------------------------------------------------------' +
        '---------'
      '    IF LEFT(@TokenTrim, 1) = '#39'*'#39
      '    BEGIN'
      '        SET @i = 2;'
      '        WHILE @i <= LEN(@TokenTrim)'
      '        BEGIN'
      '            IF SUBSTRING(@TokenTrim, @i, 1) >= '#39'0'#39
      '               AND SUBSTRING(@TokenTrim, @i, 1) <= '#39'9'#39
      '            BEGIN'
      
        '                SET @NumeroCliente = (@NumeroCliente * 10) + CAS' +
        'T(SUBSTRING(@TokenTrim, @i, 1) AS INT);'
      '            END'
      '            ELSE'
      '            BEGIN'
      '                BREAK;'
      '            END'
      '            SET @i = @i + 1;'
      '        END'
      ''
      '        IF @NumeroCliente > 0'
      '        BEGIN'
      '            SELECT *'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE NumeroCliente = @NumeroCliente'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      
        '            ORDER BY ApellidoPaterno, ApellidoMaterno, Nombre, M' +
        'IDDLE_NAME;'
      ''
      '            RETURN;'
      '        END'
      '    END'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- 2) If numeric only, try NumeroCliente ONLY if it fits INT'
      
        '    ------------------------------------------------------------' +
        '---------'
      '    IF @TokenTrim NOT LIKE '#39'%[^0-9]%'#39
      '    BEGIN'
      '        IF LEN(@TokenTrim) < 10'
      
        '           OR (LEN(@TokenTrim) = 10 AND @TokenTrim <= '#39'214748364' +
        '7'#39')'
      '        BEGIN'
      '            SET @NumeroCliente = CAST(@TokenTrim AS INT);'
      ''
      '            IF EXISTS'
      '            ('
      '                SELECT 1'
      '                FROM dbo.PACIENTES WITH (NOLOCK)'
      '                WHERE NumeroCliente = @NumeroCliente'
      '                  AND ('
      '                        @OnlyActive = 0'
      
        '                        OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(' +
        'ACTIVE, 0) = 1)'
      '                      )'
      '            )'
      '            BEGIN'
      '                SELECT *'
      '                FROM dbo.PACIENTES WITH (NOLOCK)'
      '                WHERE NumeroCliente = @NumeroCliente'
      '                  AND ('
      '                        @OnlyActive = 0'
      
        '                        OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(' +
        'ACTIVE, 0) = 1)'
      '                      )'
      
        '                ORDER BY ApellidoPaterno, ApellidoMaterno, Nombr' +
        'e, MIDDLE_NAME;'
      ''
      '                RETURN;'
      '            END'
      '        END'
      '    END'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- Normalize spaces'
      
        '    ------------------------------------------------------------' +
        '---------'
      '    WHILE CHARINDEX('#39'  '#39', @WorkToken) > 0'
      '        SET @WorkToken = REPLACE(@WorkToken, '#39'  '#39', '#39' '#39');'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- Split into up to 4 tokens'
      
        '    ------------------------------------------------------------' +
        '---------'
      '    SET @p1 = CHARINDEX('#39' '#39', @WorkToken);'
      ''
      '    IF @p1 = 0'
      '    BEGIN'
      '        SET @RawToken1 = @WorkToken;'
      '    END'
      '    ELSE'
      '    BEGIN'
      
        '        SET @RawToken1 = LTRIM(RTRIM(LEFT(@WorkToken, @p1 - 1)))' +
        ';'
      
        '        SET @WorkToken = LTRIM(RTRIM(SUBSTRING(@WorkToken, @p1 +' +
        ' 1, LEN(@WorkToken))));'
      ''
      '        SET @p2 = CHARINDEX('#39' '#39', @WorkToken);'
      '        IF @p2 = 0'
      '        BEGIN'
      '            SET @RawToken2 = @WorkToken;'
      '        END'
      '        ELSE'
      '        BEGIN'
      
        '            SET @RawToken2 = LTRIM(RTRIM(LEFT(@WorkToken, @p2 - ' +
        '1)));'
      
        '            SET @WorkToken = LTRIM(RTRIM(SUBSTRING(@WorkToken, @' +
        'p2 + 1, LEN(@WorkToken))));'
      ''
      '            SET @p3 = CHARINDEX('#39' '#39', @WorkToken);'
      '            IF @p3 = 0'
      '            BEGIN'
      '                SET @RawToken3 = @WorkToken;'
      '            END'
      '            ELSE'
      '            BEGIN'
      
        '                SET @RawToken3 = LTRIM(RTRIM(LEFT(@WorkToken, @p' +
        '3 - 1)));'
      
        '                SET @RawToken4 = LTRIM(RTRIM(SUBSTRING(@WorkToke' +
        'n, @p3 + 1, LEN(@WorkToken))));'
      '            END'
      '        END'
      '    END'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- 3) Numeric-style single token search:'
      
        '    -- CardholderID -> Identificacion -> Socio -> Telefono/Celul' +
        'ar'
      
        '    ------------------------------------------------------------' +
        '---------'
      '    IF @RawToken1 <> '#39#39
      '       AND @RawToken2 = '#39#39
      '       AND @RawToken3 = '#39#39
      '       AND @RawToken4 = '#39#39
      '       AND @RawToken1 NOT LIKE '#39'%[^0-9()]%'#39
      '    BEGIN'
      '        IF EXISTS'
      '        ('
      '            SELECT 1'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE CardholderID = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      '        )'
      '        BEGIN'
      '            SELECT *'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE CardholderID = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      
        '            ORDER BY ApellidoPaterno, ApellidoMaterno, Nombre, M' +
        'IDDLE_NAME;'
      ''
      '            RETURN;'
      '        END'
      ''
      '        IF EXISTS'
      '        ('
      '            SELECT 1'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE Identificacion = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      '        )'
      '        BEGIN'
      '            SELECT *'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE Identificacion = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      
        '            ORDER BY ApellidoPaterno, ApellidoMaterno, Nombre, M' +
        'IDDLE_NAME;'
      ''
      '            RETURN;'
      '        END'
      ''
      '        IF EXISTS'
      '        ('
      '            SELECT 1'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE Socio = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      '        )'
      '        BEGIN'
      '            SELECT *'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE Socio = @RawToken1'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      
        '            ORDER BY ApellidoPaterno, ApellidoMaterno, Nombre, M' +
        'IDDLE_NAME;'
      ''
      '            RETURN;'
      '        END'
      ''
      '        IF EXISTS'
      '        ('
      '            SELECT 1'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE ('
      
        '                    REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(Telef' +
        'ono,'#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39' '#39', '#39#39') = @RawToken1'
      
        '                 OR REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(Celul' +
        'ar,'#39#39'),  '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39' '#39', '#39#39') = @RawToken1'
      '                  )'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      '        )'
      '        BEGIN'
      '            SELECT *'
      '            FROM dbo.PACIENTES WITH (NOLOCK)'
      '            WHERE ('
      
        '                    REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(Telef' +
        'ono,'#39#39'), '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39' '#39', '#39#39') = @RawToken1'
      
        '                 OR REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(Celul' +
        'ar,'#39#39'),  '#39'('#39', '#39#39'), '#39')'#39', '#39#39'), '#39'-'#39', '#39#39'), '#39' '#39', '#39#39') = @RawToken1'
      '                  )'
      '              AND ('
      '                    @OnlyActive = 0'
      
        '                    OR (ISNULL(DECEASED, 0) <> 1 AND ISNULL(ACTI' +
        'VE, 0) = 1)'
      '                  )'
      
        '            ORDER BY ApellidoPaterno, ApellidoMaterno, Nombre, M' +
        'IDDLE_NAME;'
      ''
      '            RETURN;'
      '        END'
      '    END'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- Normalize tokens for name search'
      '    -- Supports O'#39'NEAL / DE JESUS / DE-JESUS'
      
        '    ------------------------------------------------------------' +
        '---------'
      
        '    SET @Token1 = UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RT' +
        'RIM(ISNULL(@RawToken1,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39'.'#39',' +
        ' '#39#39'));'
      
        '    SET @Token2 = UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RT' +
        'RIM(ISNULL(@RawToken2,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39'.'#39',' +
        ' '#39#39'));'
      
        '    SET @Token3 = UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RT' +
        'RIM(ISNULL(@RawToken3,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39'.'#39',' +
        ' '#39#39'));'
      
        '    SET @Token4 = UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RT' +
        'RIM(ISNULL(@RawToken4,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39'.'#39',' +
        ' '#39#39'));'
      ''
      
        '    ------------------------------------------------------------' +
        '---------'
      '    -- 4 tokens:'
      '    -- ApellidoPaterno + ApellidoMaterno + Nombre + MIDDLE_NAME'
      
        '    ------------------------------------------------------------' +
        '---------'
      
        '    IF @Token1 <> '#39#39' AND @Token2 <> '#39#39' AND @Token3 <> '#39#39' AND @To' +
        'ken4 <> '#39#39
      '    BEGIN'
      '        SELECT TOP (50) *'
      '        FROM dbo.PACIENTES P WITH (NOLOCK)'
      
        '        WHERE UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(' +
        'ISNULL(P.ApellidoPaterno,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39 +
        '.'#39', '#39#39')) LIKE @Token1 + '#39'%'#39
      
        '          AND UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(' +
        'ISNULL(P.ApellidoMaterno,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39 +
        '.'#39', '#39#39')) LIKE @Token2 + '#39'%'#39
      
        '          AND UPPER(REPLACE(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(' +
        'ISNULL(P.Nombre,'#39#39'))), '#39#39#39#39', '#39#39'), '#39' '#39', '#39#39'), '#39'-'#39', '#39#39'), '#39'.'#39', '#39#39')) ' +
        'LIKE @Token3 + '#39'%'#39
      
