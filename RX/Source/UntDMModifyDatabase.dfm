      ';'
      
        'INSERT [dbo].[HCPCSCodes] ([CODE], [DESCRIPTION], [FEE], [MAXUNI' +
        'TS], [PA]) VALUES (N'#39'A4565  '#39', N'#39'SLINGS'#39', N'#39#39', N'#39#39', N'#39#39')'
