  object D0_BuidTransFile: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE procedure [dbo].[D0_BuidTransFile] @GUID NCHAR(36), @otc_' +
        'number int, '
      '@claim_reversal bit, @multiple_rx bit,'
      
        '@build_only_one bit, @SendText varchar(4000) output, @rxpayload ' +
        'varchar(4000) output'
      'AS'
      '--Rx data ----------------------'
      'declare @send_str varchar(max);'
      'declare @header char(1000);'
      'declare @healthplan char(1000);'
      'declare @segment_separator char(1)'
      'declare @FS char(1)'
      'declare @count int'
      'declare @TransactionCount int'
      'declare @TransactionCode char(2)'
      'declare @norx bigint'
      'declare @datefilled char(8)'
      'declare @DateRXWritten date'
      'declare @drug_sig nchar(296)'
      'declare @drug_name varchar(30) '
      'declare @qty_prescribed integer'
      'declare @nopatplan int'
      'declare @selectStatement char(30)'
      'declare @LTC bit'
      '-- third party Insurance segment--'
      'declare @bin_number char(6)'
      'declare @insurance_name varchar(15) '
      'declare @insurance_code varchar(3)'
      'declare @SoftwareVendorID char(10)'
      'declare @ProcessorControl char(10) '
      'declare @ServiceProvIDQual char(2) '
      'declare @ServiceProvID varchar(15)'
      'declare @LTCServiceProvIDQual char(2) '
      'declare @LTCServiceProvID varchar(15)'
      'declare @enviar_campo_et bit '
      'declare @planesmedicosno int'
      '-----------------'
      '-- Patient health plan Information --'
      'declare @GroupNumber char(15)'
      'declare @CardHolderID char(20)'
      'declare @PersonCode char(3)'
      'declare @RelationShipCode char(1)'
      'declare @HomePlan char(3)'
      'declare @ElegibilityClarificationCode char(1)'
      'declare @FacilityID char(10)'
      'declare @PlanId char(8)'
      'declare @medigap_id char(20)'
      'declare @medicaid_indicator char(2)'
      'declare @PAAI char(2)'
      'declare @CMSPD char(1)'
      'declare @medicaid_id_number char(20)'
      'declare @medicaid_agency_number char(15)'
      'declare @ch_first_name char(12)'
      'declare @ch_last_name char(15)'
      '-------------------------'
      '-- Patient Information --'
      'declare @customer_no int'
      'declare @pat_id_qualifier char(2)'
      'declare @pat_name char(12)'
      'declare @pat_ln char(15)'
      'declare @pat_id char(20)'
      'declare @dob char(8)'
      'declare @gender char(1)'
      'declare @pat_address char(30)'
      'declare @pat_city char(20)'
      'declare @pat_state char(2)'
      'declare @pat_zipcode char(5)'
      'declare @pat_telephone char(10)'
      'declare @pat_cel char(10)'
      'declare @pat_place_of_service char(2)'
      'declare @pat_employer_id char(15)'
      'declare @pat_pregnancy_indi char(1)'
      'declare @pat_email char(80)'
      'declare @pat_residence char(2)'
      '---------------------------'
      '-- Prescriber Information'
      'declare @prescriber_no int'
      'declare @presc_id_qualifier char(2)'
      'declare @presc_id char(15)'
      'declare @presc_telephone char(10)'
      'declare @presc_ln char(15)'
      'declare @presc_name char(12)'
      'declare @primarycareprov_idqual char(2)'
      'declare @primarycareprov_id char(15)'
      'declare @primarycareprov_ln char(15)'
      'declare @presc_address char(30) '
      'declare @presc_city char(20)'
      'declare @presc_state char(2)'
      'declare @presc_zipcode char(5)'
      'declare @presc_dea varchar(15)'
      'declare @presc_npi varchar(15)'
      '-- Claim segment -----------'
      'declare @ndc char(11)'
      'declare @prod_serv_qualifier char(2)'
      'declare @assc_rx_servirefno char(7)'
      'declare @assc_rx_servirefdate char(8)'
      'declare @met_dec_qty int'
      'declare @new_ref_code smallint'
      'declare @days_supply int'
      'declare @comp_code int'
      'declare @daw smallint'
      'declare @no_refill_auth int'
      'declare @rx_origin_code char(1)'
      'declare @OtherCoverageCode char(1)'
      'declare @spec_pack_indi char(2)'
      'declare @org_pres_prod_sidq char(2)'
      'declare @org_pros_prod_servid char(2) '
      'declare @org_presc_qty int'
      'declare @unit_of_meassure char(2)'
      'declare @level_of_service int'
      'declare @prior_auth_type_code char(1)'
      'declare @prior_auth char(11)'
      'declare @IATID_463_EW char(2)'
      'declare @IAID_464_EX char(11)'
      'declare @rx_disp_status char(1) '
      'declare @qty_int_disp int'
      'declare @days_supply_int_disp int'
      'declare @DRC_357_NV char(2)'
      'declare @PAI_391_MT char(2)'
      'declare @rout_of_admin char(11)'
      'declare @compound_type char(12)'
      'declare @PST_147_U7 char(2)'
      'declare @schedule_drug nchar(4)'
      'declare @ref_remaining int'
      'declare @rx_expiration_date date'
      'declare @cupon_type char(2) '
      'declare @cupon_number nchar(15)'
      'declare @cupon_amt decimal(18,2)'
      'declare @shedule_rx_id_no nchar(12)'
      '-- Pricing segment ----------------'
      'declare @temp_value char(20)'
      'declare @ing_cost decimal(18,2)'
      'declare @disp_fee decimal(18,2)'
      'declare @pat_paid_amount decimal(18,2)'
      'declare @incentive_amount_sub decimal(18,2)'
      'declare @usual_customary_charge decimal(18,2)'
      'declare @gross_amount_due decimal(18,2)'
      'declare @basis_of_cost char(2)'
      'declare @medicaid_paid_amount decimal(18,2)'
      'declare @other_amount_count int'
      'declare @other_amount_claim_qual char(2)'
      'declare @other_amount_claim_sub decimal(18,2)'
      'declare @prof_serv_fee decimal(18,2)'
      '--COB segment ----------------------- '
      'declare @cob_count int'
      'declare @COBstring varchar(4000)'
      '--DUR PPS Segment--------------------'
      'declare @dur_pps_segment_str varchar(500)'
      '--Workers Comp Segment------------------'
      'declare @workers_compstr varchar(1000)'
      '--Compound Segment----------------------'
      'declare @compoundstr varchar(1000)'
      '--Clinical Segment----------------------'
      'declare @clinicalstr varchar(1000)'
      '--SubClarificationCode------------------'
      'declare @subclarif_count int'
      'declare @sub_clarification_code char(2)'
      ''
      'begin'
      '    SET NOCOUNT ON;'
      '    set @SendText = '#39#39';'
      #9'set @send_str = '#39#39';'
      #9'set @count = 1;'
      #9'set @segment_separator = char(30);'
      #9'set @FS = char(28);'
      '    set @rxpayload = '#39'<ArrayOfExtraPayloadData>'#39';'
      #9'if @claim_reversal = 1 '
      #9#9'set @TransactionCode = '#39'B2'#39
      #9'else'
      #9#9'set @TransactionCode = '#39'B1'#39';'
      ''
      #9'if rtrim(@pat_telephone) = '#39#39' set @pat_telephone = @pat_cel;'
      #9'if (@build_only_one = 1) or (@claim_reversal = 1)  '
      #9'begin'
      #9#9'set @TransactionCount = 1;'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'if @multiple_rx = 1'
      #9#9'begin'
      
        #9#9#9'select @TransactionCount = count(*) from otc where GUID = @GU' +
        'ID;'
      #9#9#9'if @TransactionCount > 4 set @TransactionCount = 4;'
