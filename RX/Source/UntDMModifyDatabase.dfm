        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48538'#39', N'#39'Strip'#39', N'#39'A dos' +
        'ing unit equal to the amount of active ingredient(s) contained i' +
        'n a strip.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48539'#39', N'#39'Suppository'#39', N' +
        #39'A dosing unit equal to the amount of active ingredient(s) conta' +
        'ined in a suppository.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C53504'#39', N'#39'Swab'#39', N'#39'A dosi' +
        'ng unit equal to the amount of active ingredient(s) contained in' +
        ' a swab.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48540'#39', N'#39'Syringe'#39', N'#39'A d' +
        'osing unit equal to the amount of active ingredient(s) contained' +
        ' in a single syringe.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48542'#39', N'#39'Tablet'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in a tablet.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48548'#39', N'#39'Troche'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in a troche.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C44278'#39', N'#39'Unit'#39', N'#39'A sing' +
        'le undivided thing occurring in the composition of something els' +
        'e.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C38046'#39', N'#39'Unspecified'#39', N' +
        #39'Not stated explicitly or in detail.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48551'#39', N'#39'Vial'#39', N'#39'A dosi' +
        'ng unit equal to the amount of active ingredient(s) contained in' +
        ' a single vial.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C121847'#39', N'#39'C48552'#39', N'#39'Wafer'#39', N'#39'A dos' +
        'ing unit equal to the amount of active ingredient(s) contained i' +
        'n a wafer.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C37907'#39', N'#39'Age-Months'#39', N'#39'T' +
        'he length of a persons life stated in months since birth.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C37908'#39', N'#39'Age-Years'#39', N'#39'Th' +
        'e length of a persons life stated in years since birth.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49673'#39', N'#39'Beats per Minute' +
        #39', N'#39'The number of heartbeats measured per minute time.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C16358'#39', N'#39'Body Mass Index'#39 +
        ', N'#39'An individuals weight in kilograms divided by the square of ' +
        'the height in meters.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25157'#39', N'#39'Body Surface Are' +
        'a'#39', N'#39'A measure of the 2-dimensional extent of the body surface ' +
        '(i.e. the skin).  Body surface area (BSA) can be calculated by m' +
        'athematical formula or from a chart that relates height to weigh' +
        't.  BSA is often an important factor in dosing.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C81328'#39', N'#39'Body Weight'#39', N'#39 +
        'The weight of a subject.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49674'#39', N'#39'Breaths per Minu' +
        'te'#39', N'#39'The number of breaths (inhalation and exhalation) taken p' +
        'er minute time.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49668'#39', N'#39'Centimeter'#39', N'#39'A' +
        ' basic unit of length in the former CGS version of metric system' +
        ' equal to one hundredth of a meter or approximately 0.393 700 78' +
        '7 inch.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25301'#39', N'#39'Day'#39', N'#39'The time' +
        ' for Earth to make a complete rotation on its axis; ordinarily d' +
        'ivided into twenty-four hours equal to 86 400 seconds. This also' +
        ' refers to a specific day.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C42559'#39', N'#39'Degree Celsius'#39',' +
        ' N'#39'A unit of temperature of the temperature scale designed so th' +
        'at the freezing point of water is 0 degrees and the boiling poin' +
        't is 100 degrees at standard atmospheric pressure. The current o' +
        'fficial definition of the Celsius sets 0.01 C to be at the tripl' +
        'e point of water and a degree to be 1/273.16 of the difference i' +
        'n temperature between the triple point of water and absolute zer' +
        'o. One degree Celsius represents the same temperature difference' +
        ' as one Kelvin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C44277'#39', N'#39'Degree Fahrenhei' +
        't'#39', N'#39'A unit of temperature of the temperature scale designed so' +
        ' that the freezing point of water is 32 degrees and the boiling ' +
        'point is 212 degrees placing the boiling and melting points of w' +
        'ater 180 degrees apart. One degree Fahrenheit is 5/9ths of a kel' +
        'vin (or of a degree Celsius) and minus 40 degrees Fahrenheit is ' +
        'equal to minus 40 degrees Celsius.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25299'#39', N'#39'Diastolic Blood ' +
        'Pressure'#39', N'#39'The minimum pressure exerted into the systemic arte' +
        'rial circulation during cardiac ventricular relaxation and filli' +
        'ng.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C48155'#39', N'#39'Gram'#39', N'#39'The met' +
        'ric unit of mass equal to one thousandth of a kilogram. One gram' +
        ' equals approximately 15.432 grains or 0.035 273 966 ounce.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49677'#39', N'#39'Heart Rate'#39', N'#39'T' +
        'he number of heartbeats per unit of time usually expressed as be' +
        'ats per minute.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25347'#39', N'#39'Height'#39', N'#39'The v' +
        'ertical measurement or distance from the base to the top of an o' +
        'bject; the vertical dimension of extension.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C48500'#39', N'#39'Inch'#39', N'#39'A tradi' +
        'tional unit of length equal to 1/12 of a foot or 2.54 centimeter' +
        's.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C28252'#39', N'#39'Kilogram'#39', N'#39'A b' +
        'asic SI unit of mass. It is defined as the mass of an internatio' +
        'nal prototype in the form of a platinum-iridium cylinder kept at' +
        ' Sevres in France. A kilogram is equal to 1000 grams and 2.204 6' +
        '22 6 pounds.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49679'#39', N'#39'Mean Arterial Pr' +
        'essure'#39', N'#39'The mean pressure of the blood within the arterial ci' +
        'rculation. The arterial pressure may be directly measured by ins' +
        'ertion of an intra-arterial catheter connected to a transducer. ' +
        'The mean arterial pressure (MAP) can be calculated by subsequent' +
        ' analysis of the waveform. MAP can be approximated without an in' +
        'vasive procedure using the following formula: diastolic pressure' +
        ' plus 1/3 of the pulse pressure where pulse pressure is systolic' +
        ' pressure - diastolic pressure.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49670'#39', N'#39'Millimeter of Me' +
        'rcury'#39', N'#39'A non-SI unit of pressure equal to 133332 Pa or 1.316E' +
        '10-3 standard atmosphere. Use of this unit is generally deprecat' +
        'ed by ISO and IUPAC.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C29846'#39', N'#39'Month'#39', N'#39'One of' +
        ' the 12 divisions of a year as determined by a calendar. It corr' +
        'esponds to the unit of time of approximately to one cycle of the' +
        ' moons phases about 30 days or 4 weeks.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25613'#39', N'#39'Percentage'#39', N'#39'A' +
        ' fraction or ratio with 100 understood as the denominator.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C48531'#39', N'#39'Pound'#39', N'#39'The tr' +
        'aditional unit of mass. By international agreement one avoirdupo' +
        'is pound is equal to exactly 0.453 592 37 kilogram 16 ounces or ' +
        '1.215 28 troy pounds.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49676'#39', N'#39'Pulse Rate'#39', N'#39'T' +
        'he rate of the pulse as observed in an artery expressed as beats' +
        ' per minute. It can be measured at several anatomical sites incl' +
        'uding the wrist neck temple groin behind the knees or on top of ' +
        'the foot.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C49678'#39', N'#39'Respiratory Rate' +
        #39', N'#39'The rate of breathing (inhalation and exhalation) measured ' +
        'within in a unit time usually expressed as breaths per minute.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C87054'#39', N'#39'Sagittal Abdomin' +
        'al Diameter'#39', N'#39'A standard measure of visceral obesity or abdomi' +
        'nal fat which is measured from the patients back to upper abdome' +
        'n between the bottom of the rib cage and the top of the pelvic a' +
        'rea. This measurement may be taken with the patient standing or ' +
        'in the supine position.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C42569'#39', N'#39'Square Meter'#39', N' +
        #39'A SI unit of area measurement equal to a square whose sides are' +
        ' one meter long. Square meter is equal to 10000 square centimete' +
        'rs; 0.01 are; 1.196 square yards; 10.76 square feet; 1550 square' +
        ' inches.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25298'#39', N'#39'Systolic Blood P' +
        'ressure'#39', N'#39'The maximum pressure exerted into the systemic arter' +
        'ial circulation during the contraction of the left ventricle of ' +
        'the heart.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C25206'#39', N'#39'Temperature'#39', N'#39 +
        'A measure of the average kinetic energy of a system of particles' +
        '. Temperature may be quantified in the context of thermodynamics' +
        ' as the potential of one system to transfer thermal energy to an' +
        'other system until both systems reach a state of thermal equilib' +
        'rium.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C38046'#39', N'#39'Unspecified'#39', N'#39 +
        'Not stated explicitly or in detail.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C91101'#39', N'#39'C29848'#39', N'#39'Year'#39', N'#39'A perio' +
        'd of time that it takes for Earth to make a complete revolution ' +
        'around the sun approximately 365 days; a specific one year perio' +
        'd.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C62412'#39', N'#39'Applicator'#39', N'#39'A' +
        ' dosing unit equal to the amount of active ingredient(s) contain' +
        'ed in a single applicator.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48475'#39', N'#39'Bar'#39', N'#39'A dosing' +
        ' unit equal to the amount of active ingredient(s) contained in a' +
        ' bar.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C54564'#39', N'#39'Blister'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in a blister.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C64696'#39', N'#39'Caplet'#39', N'#39'A dos' +
        'ing unit equal to the amount of active ingredient(s) contained i' +
        'n a caplet.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48480'#39', N'#39'Capsule'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in a capsule.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C64933'#39', N'#39'Each'#39', N'#39'Used to' +
        ' refer to every member of a group of people or things considered' +
        ' individually.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C53499'#39', N'#39'Film'#39', N'#39'A dosin' +
        'g unit equal to the amount of active ingredient(s) contained in ' +
        'a film.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48155'#39', N'#39'Gram'#39', N'#39'The met' +
        'ric unit of mass equal to one thousandth of a kilogram. One gram' +
        ' equals approximately 15.432 grains or 0.035 273 966 ounce.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C69124'#39', N'#39'Gum'#39', N'#39'A dosing' +
        ' unit equal to the amount of active ingredient(s) contained in a' +
        ' gum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48499'#39', N'#39'Implant'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in an implant.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C62276'#39', N'#39'Insert'#39', N'#39'A dos' +
        'ing unit equal to the amount of active ingredient(s) contained i' +
        'n an insert.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C28252'#39', N'#39'Kilogram'#39', N'#39'A b' +
        'asic SI unit of mass. It is defined as the mass of an internatio' +
        'nal prototype in the form of a platinum-iridium cylinder kept at' +
        ' Sevres in France. A kilogram is equal to 1000 grams and 2.204 6' +
        '22 6 pounds.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48504'#39', N'#39'Kit'#39', N'#39'A dosing' +
        ' unit equal to the amount of active ingredient(s) contained in a' +
        ' kit.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C120263'#39', N'#39'Lancet'#39', N'#39'A sm' +
        'all sharp needle-like instrument that is used to puncture the sk' +
        'in.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48505'#39', N'#39'Liter'#39', N'#39'The no' +
        'n-SI unit of volume accepted for use with the SI. One liter is e' +
        'qual to cubic decimeter or one thousandth of cubic meter or 1000' +
        ' cubic centimeters or approximately 61.023 744 cubic inches.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48506'#39', N'#39'Lozenge'#39', N'#39'A do' +
        'sing unit equal to the amount of active ingredient(s) contained ' +
        'in a lozenge.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C28253'#39', N'#39'Milligram'#39', N'#39'A ' +
        'metric unit of mass equal to one thousandth of a gram or 1000 mi' +
        'crograms. One milligram equals approximately 0.015 432 grain or ' +
        '35.274 x 10E-6 ounce.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C28254'#39', N'#39'Milliliter'#39', N'#39'A' +
        ' unit of volume equal to one millionth (10E-6) of a cubic meter ' +
        'one thousandth of a liter one cubic centimeter or 0.061023 7 cub' +
        'ic inch. A cubic centimeter is the CGS unit of volume.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48521'#39', N'#39'Packet'#39', N'#39'A dos' +
        'ing unit equal to the amount of active ingredient(s) contained i' +
        'n a packet.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C65032'#39', N'#39'Pad'#39', N'#39'A dosing' +
        ' unit equal to the amount of active ingredient(s) contained in a' +
        ' pad.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C48524'#39', N'#39'Patch'#39', N'#39'A dosi' +
        'ng unit equal to the amount of active ingredient(s) contained in' +
        ' a patch.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C120216'#39', N'#39'Pen Needle'#39', N'#39 +
        'A single use hollow needle embedded in a plastic hub which is th' +
        'en attached to a preloaded syringe (pen) to facilitate the deliv' +
        'ery of medication.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89510'#39', N'#39'C62609'#39', N'#39'Ring'#39', N'#39'A dosin' +
        'g unit equal to the amount of active ingredient(s) contained in ' +
        'a ring.'#39')'
      
