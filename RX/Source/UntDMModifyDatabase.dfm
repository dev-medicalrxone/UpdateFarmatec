        '),  @INCENTIVE_AMOUNT_SUB FLOAT,'
      
        '@OTHERAMOUNTCLAIMEDSUBCOUNT INT, @OTAMCLDSUBCOUNTQUAL NCHAR(2), ' +
        '@OTHERAMOUNTCLAIMEDSUB FLOAT, '
      
        '@PRECIOVENTA FLOAT, @BASISOFCOST CHAR(2), @GROSSAMOUNTDUE FLOAT,' +
        ' @MEDICAID_PAID_AMOUNT FLOAT  '
      'AS'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      
        #9'UPDATE OTC SET PRECIOFACTURACION = @PRECIOFACTURACION, DISPENSI' +
        'NGFEE = @DISPENSINGFEE, '
      
        #9'PROF_SERV_FEE_SUB = @PROF_SERV_FEE_SUB, PATIENTPAIDAMOUNT=  @PA' +
        'TIENTPAIDAMOUNT, FLAT_SALES_TAXSUB = @FLAT_SALES_TAXSUB, '
      
        #9'PERCENTAGE_SALES_TAX_SUB = @PERCENTAGE_SALES_TAX_SUB, PERCENTAG' +
        'E_SALES_TAX_RATE = @PERCENTAGE_SALES_TAX_RATE, '
      
        #9'PER_SALESTAX_BASIS_SUB = @PER_SALESTAX_BASIS_SUB, INCENTIVE_AMO' +
        'UNT_SUB = @INCENTIVE_AMOUNT_SUB,'
      
        '        OTHERAMOUNTCLAIMEDSUBCOUNT = @OTHERAMOUNTCLAIMEDSUBCOUNT' +
        ', OTAMCLDSUBCOUNTQUAL = @OTAMCLDSUBCOUNTQUAL, '
      
        #9'OTHERAMOUNTCLAIMEDSUB = @OTHERAMOUNTCLAIMEDSUB,  TOTAL = @PRECI' +
        'OVENTA, BASISOFCOST = @BASISOFCOST, '
      
        #9'GROSSAMOUNTDUE = @GROSSAMOUNTDUE, MEDICAID_PAID_AMOUNT = @MEDIC' +
        'AID_PAID_AMOUNT '
