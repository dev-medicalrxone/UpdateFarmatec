      '           ,[PAY_TO_STREET_ADDRESS]'
      '           ,[PAY_TO_CITY_ADDRESS]'
      '           ,[PAY_TO_STATE]'
      '           ,[PAY_TO_ZIP]'
      '           ,[GENERIC_EQUIVALENT_PRODUCT_ID_QUALIFIER]'
      '           ,[GENERIC_EQUIVALENT_PRODUCT_ID]'
      '           ,[OTC_NUMBER])'
      '     VALUES'
      '           (@DATE_OF_INJURY'
      '           ,@EMPLOYER_NAME'
      '           ,@EMP_STREET_ADDRESS'
      '           ,@EMP_CITY'
      '           ,@EMP_STATE'
      '           ,@EMP_ZIP'
      '           ,@EMP_PHONE'
