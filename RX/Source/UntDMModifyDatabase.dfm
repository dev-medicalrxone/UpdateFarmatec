        'r(@medigap_id)); -- 359-2A'
      
        #9#9#9#9'if @medicaid_indicator > '#39#39' set @send_str += @FS + '#39'2B'#39' + @m' +
        'edicaid_indicator; -- 36'#216'-2B'
      
        #9#9#9#9'if @PAAI > '#39#39' set @send_str += @FS + '#39'2D'#39' + @PAAI;  -- 361-2' +
