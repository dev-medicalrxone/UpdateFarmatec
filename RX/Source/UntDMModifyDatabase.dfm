  object INSERT_CASH_PLAN_EMPTY: TFDQuery
    AfterExecute = INSERT_CASH_PLAN_EMPTYAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INSERT_CASH_PLAN_EMPTY] @NOCLIENTE INTEG' +
        'ER'
      '  AS '
      'DECLARE @NO_PLAN INTEGER'
      'DECLARE @IDENTIFICACION CHAR(20)'
      'DECLARE @NAME CHAR(12)'
      'DECLARE @LAST_NAME CHAR(15)'
      'DECLARE @PLANESMEDICOSNO INT'
      'BEGIN'
      '    SET NOCOUNT ON; '
      '    begin transaction'
      
        '       SELECT @IDENTIFICACION = IDENTIFICACION, @NAME = NOMBRE, ' +
        '@LAST_NAME = APELLIDOPATERNO FROM PACIENTES WHERE NUMEROCLIENTE ' +
        '= @NOCLIENTE;'
      
        '       SELECT @NO_PLAN = ISNULL(NUMEROPLAN,0) FROM PATPLAN WHERE' +
        ' NUMEROCLIENTE = @NOCLIENTE AND PLANMEDICO = '#39'CAS'#39';'
      '       if @@ROWCOUNT = 0  '
      '       begin'
      
        #9#9#9'SELECT @PLANESMEDICOSNO = PLANESMEDICOSNO FROM PLANESMEDICOS ' +
        'WHERE ABREVIATURA = '#39'CAS'#39';'
      
        #9#9#9'INSERT INTO PATPLAN (NUMEROCLIENTE, PLANMEDICO, RELACION, INA' +
        'CTIVE_DATE, CARDHOLDERID, CH_FIRSTNAME, CH_LASTNAME, ACTIVO, INS' +
        'URANCE_INDEX, PLANESMEDICOSNO)'
      
        #9#9#9'VALUES (@NOCLIENTE, '#39'CAS'#39', 1, '#39'01/01/2099'#39', @IDENTIFICACION, ' +
        '@NAME, @LAST_NAME, 1, -1, @PLANESMEDICOSNO);'
      '       end;'
      '    commit;'
      'END;')
    Left = 3000
    Top = 48
  end
  object INSERT_DISPPILL: TFDQuery
    AfterExecute = INSERT_DISPPILLAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'create PROCEDURE INSERT_DISPPILL @NORX BIGINT,  @CODES NCHAR(100' +
        '), @NOCLIENTE INT,'
      '@DRUG VARCHAR(30), @OTCNUMBER INT, @LABELCODESNO INT'
      'AS'
      'DECLARE @FOUND integer'
      'begin'
      '  SET NOCOUNT ON'
      '  begin transaction '
      
        '  SELECT @FOUND = COUNT(*) from DISPILL where NUMERORECETA = @NO' +
        'RX;'
      '  if @FOUND = 0'
      '  begin'
      '    INSERT INTO [dbo].[DISPILL]'
      '           ([NUMERORECETA]'
      '           ,[FECHA]'
      '           ,[PRINTED]'
      '           ,[CODES]'
      '           ,[NUMEROCLIENTE]'
      '           ,[DRUG]'
      '           ,[OTCNUMBER]'
      '           ,[LABELCODESNO])'
      '     VALUES'
      '           (@NORX'
      '           ,GETDATE()'
      '           ,0'
      '           ,@CODES'
      '           ,@NOCLIENTE'
      '           ,@DRUG'
      '           ,@OTCNUMBER'
      '           ,@LABELCODESNO);'
      '  end'
      '  else'
      '  begin'
      
        '    Update DISPILL set NUMEROCLIENTE = @NOCLIENTE, DRUG = @DRUG,' +
        ' LABELCODESNO = @LABELCODESNO, CODES = @CODES'
      #9'WHERE NUMERORECETA = @NORX;'
      '  end; '
      '  commit;'
      'end;')
    Left = 3008
    Top = 120
  end
  object NEXT_APPRISS_TN: TFDQuery
    AfterExecute = NEXT_APPRISS_TNAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'create PROCEDURE [dbo].[NEXT_APPRISS_TN] @APPRISS_TN INTEGER OUT' +
        'PUT '
      'AS '
      'DECLARE @CURRENT_APPRISS_TN INT'
      'begin '
      '  begin transaction'
      
        '  SELECT @CURRENT_APPRISS_TN = APPRISS_TRANSACTION_NUMBER FROM N' +
        'EXT_RXNUMBER;'
      '  IF (@CURRENT_APPRISS_TN IS NULL) OR (@CURRENT_APPRISS_TN = 0)'
      '  begin'
      '   SELECT @CURRENT_APPRISS_TN = MAX(OTCNUMBER) FROM OTC; '
      
        '   Update NEXT_RXNUMBER set APPRISS_TRANSACTION_NUMBER = @CURREN' +
        'T_APPRISS_TN;'
      '  end;'
      
        '  Update NEXT_RXNUMBER SET APPRISS_TRANSACTION_NUMBER = APPRISS_' +
        'TRANSACTION_NUMBER + 1 Select @APPRISS_TN = (APPRISS_TRANSACTION' +
        '_NUMBER) FROM NEXT_RXNUMBER;'
      '  commit'
      'end')
    Left = 3008
    Top = 216
  end
