      #9#9'isnull(IAID_464_EX,'#39#39'), isnull(DISPENSING_STATUS,'#39#39'), '
      
        #9#9'isnull(QTY_INTENDED_DISP,0), isnull(DAYS_SUPPLY_INTEND_DISP,0)' +
        ', '
      
        #9#9'isnull(DRC_357_NV,'#39#39'), isnull(PAI_391_MT,'#39#39'), isnull(ROUTEOFAD' +
        'MIN_995_E2,'#39#39'), '
      #9#9'isnull(COMPOUND_TYPE_996_G1,'#39#39'), isnull(PST_147_U7,'#39#39'),'
      #9#9'isnull(PRECIOFACTURACION,0), isnull(DISPENSINGFEE,0), '
      #9#9'isnull(PATIENTPAIDAMOUNT,0), isnull(INCENTIVE_AMOUNT_SUB,0), '
      
        #9#9'isnull(TOTAL,0), isnull(GROSSAMOUNTDUE,0), isnull(BASISOFCOST,' +
        #39#39'), '
      
        #9#9'isnull(MEDICAID_PAID_AMOUNT,0), isnull(OTHERAMOUNTCLAIMEDSUBCO' +
        'UNT,0), '
      
        #9#9'isnull(OTAMCLDSUBCOUNTQUAL,'#39#39'),'#9'isnull(OTHERAMOUNTCLAIMEDSUB,0' +
        '), '
      
        #9#9'isnull(OTCNUMBER,'#39#39'), isnull(MEDICAMENTO,'#39#39'), isnull(CONTROLAD' +
        'O,'#39#39'), '
      
        #9#9'isnull(CUPONTYPE,'#39#39'), isnull(CUPON_NUMBER,'#39#39'), isnull(CUPON_VA' +
        'LUE_AMT,0),'
      #9#9'isnull(PLAN_MEDICO,'#39#39'), isnull(PLANESMEDICOSNO, 0),'
      #9#9'isnull(NUMEROPLAN,0), isnull(NumeroCliente,0),'
      #9#9'isnull(PROF_SERV_FEE_SUB,0), isnull(qty_temp,0)'
      
        #9#9'from OTC where OTCNUMBER = @otc_number;-- and (convert(varchar' +
        ', FECHAOTC, 101) = convert(varchar, getdate(), 101)); '
      #9'end'
      #9'else'
      #9'begin'
      
        #9#9'DECLARE MyCursorD0 CURSOR FOR SELECT top(4) FORMAT(FECHAOTC, '#39 +
        'yyyyMMdd'#39'), isnull(NUMERORECETA,0), isnull(PRIMARYCAREPROVIDQUAL' +
        'IFIER,'#39#39'), '
      #9#9'isnull(NDC,'#39#39'), isnull(PRODUCTSERVIDQUAL,'#39'03'#39'),'
      
        #9#9'isnull(ASSOC_RX_SERVICE_REF_NO,'#39#39'), FORMAT (ASSOC_RX_SERVICE_D' +
        'ATE, '#39'yyyyMMdd'#39'), '
      
        #9#9'isnull(METRICDECIMALQUANTITY,0), isnull(CODIGOREFILLNUEVO,0), ' +
        'isnull(DAYS_SUPPLY,0), isnull(DAW,0), '
      
        #9#9'isnull(OTHERCOVERAGECODE,'#39#39'), isnull(SPECIAL_PACK_INDI_429_DT,' +
        #39#39'), '
      
        #9#9'isnull(ORG_PRES_PROD_SIDQ,'#39#39'), isnull(ORG_PROS_PROD_SERVID,'#39#39')' +
        ', '
      #9#9'isnull(ORG_PRESC_QTY,0), isnull(UNIT_OF_MEASURE,'#39#39'), '
      #9#9'isnull(LEVELOFSERVICE,0), isnull(PRIOR_AUTH_TYPE_CODE,'#39#39'), '
      #9#9'isnull(PRIORAUTHORIZATION,'#39#39'), isnull(IATID_463_EW,'#39#39'), '
      #9#9'isnull(IAID_464_EX,'#39#39'), isnull(DISPENSING_STATUS,'#39#39'), '
      
        #9#9'isnull(QTY_INTENDED_DISP,0), isnull(DAYS_SUPPLY_INTEND_DISP,0)' +
        ', '
      
        #9#9'isnull(DRC_357_NV,'#39#39'), isnull(PAI_391_MT,'#39#39'), isnull(ROUTEOFAD' +
        'MIN_995_E2,'#39#39'), '
      #9#9'isnull(COMPOUND_TYPE_996_G1,'#39#39'), isnull(PST_147_U7,'#39#39'),'
      #9#9'isnull(PRECIOFACTURACION,0), isnull(DISPENSINGFEE,0), '
      #9#9'isnull(PATIENTPAIDAMOUNT,0), isnull(INCENTIVE_AMOUNT_SUB,0), '
      
        #9#9'isnull(TOTAL,0), isnull(GROSSAMOUNTDUE,0), isnull(BASISOFCOST,' +
        #39#39'), '
      
        #9#9'isnull(MEDICAID_PAID_AMOUNT,0), isnull(OTHERAMOUNTCLAIMEDSUBCO' +
        'UNT,0), '
      
        #9#9'isnull(OTAMCLDSUBCOUNTQUAL,'#39#39'),'#9'isnull(OTHERAMOUNTCLAIMEDSUB,0' +
        '), '
      
        #9#9'isnull(OTCNUMBER,'#39#39'), isnull(MEDICAMENTO,'#39#39'), isnull(CONTROLAD' +
        'O,'#39#39'), '
      
        #9#9'isnull(CUPONTYPE,'#39#39'), isnull(CUPON_NUMBER,'#39#39'), isnull(CUPON_VA' +
        'LUE_AMT,0),'
      #9#9'isnull(PLAN_MEDICO,'#39#39'), isnull(PLANESMEDICOSNO, 0),'
      #9#9'isnull(NUMEROPLAN,0), isnull(NumeroCliente,0),'
      #9#9'isnull(PROF_SERV_FEE_SUB,0), isnull(qty_temp,0)'
      
        #9#9'from OTC where GUID = @GUID;-- and (convert(varchar, FECHAOTC,' +
        ' 101) = convert(varchar, getdate(), 101)) order by NUMERORECETA;' +
        ' '
      #9'end;'
      '  '#9'OPEN MyCursorD0'
      #9'FETCH NEXT FROM MyCursorD0'
      
        #9'INTO @datefilled, @norx, @primarycareprov_idqual, @ndc, @prod_s' +
        'erv_qualifier, '
      
        #9'@assc_rx_servirefno, @assc_rx_servirefdate, @met_dec_qty, @new_' +
        'ref_code, @days_supply, @daw, '
      
        #9'@OtherCoverageCode, @spec_pack_indi, @org_pres_prod_sidq, @org_' +
        'pros_prod_servid, @org_presc_qty,'
      
        #9'@unit_of_meassure, @level_of_service, @prior_auth_type_code, @p' +
        'rior_auth, @IATID_463_EW,'
      
        #9'@IAID_464_EX, @rx_disp_status, @qty_int_disp, @days_supply_int_' +
        'disp, @DRC_357_NV,'
      #9'@PAI_391_MT, @rout_of_admin, @compound_type, @PST_147_U7,'
      
        #9'@ing_cost, @disp_fee, @pat_paid_amount, @incentive_amount_sub, ' +
        '@usual_customary_charge,'
      
        #9'@gross_amount_due, @basis_of_cost, @medicaid_paid_amount, @othe' +
        'r_amount_count, @other_amount_claim_qual,'
      
        #9'@other_amount_claim_sub, @otc_number, @drug_name, @schedule_dru' +
        'g, @cupon_type, @cupon_number, @cupon_amt,'
      
        #9'@insurance_code, @planesmedicosno, @nopatplan, @customer_no, @p' +
        'rof_serv_fee, @qty_temp  '
      #9'WHILE @@FETCH_STATUS = 0'
      #9'BEGIN'#9#9#9
      
        #9#9'Select @DateRXWritten = FECHARECETA, @comp_code = COMPOUNDCODE' +
        ', @no_refill_auth = isNull(NUMEROREFILLSAUTORIZADOS,0),'
      
        #9#9'@ref_remaining = isNull(NUMEROREFILLSAUTORIZADOS,0) - isnull(@' +
        'new_ref_code,0),'
      
        #9#9'@rx_origin_code = RXORIGINCODE, @drug_sig = ETIQUETA, @qty_pre' +
        'scribed = (FLOOR(CANTIDADRECETADA) *1000),'
      #9#9'@shedule_rx_id_no = SCHEDULE_RX_ID_NO, @LTC = isnull(LTC,0)'
      #9#9'from PRESCRIPTIONS where NUMERORECETA = @norx;'
      #9#9'if @Count = 1'
      #9#9'begin'#9#9'    '
      
        #9#9#9'select @pat_id_qualifier = CONCAT(isNull(PATIENT_ID_QUAL,'#39#39'),' +
        'SPACE(6),NULL), '
      
        #9#9#9'@pat_id = isnull(CONCAT(isNull(IDENTIFICACION,'#39#39'),SPACE(20),N' +
        'ULL),'#39#39'),'
      #9#9#9'@pat_name = CONCAT(isNull(NOMBRE,'#39#39'),SPACE(12),NULL), '
      #9#9#9'@pat_ln = CONCAT(isNull(APELLIDOPATERNO,'#39#39'),SPACE(15),NULL),'
      #9#9#9'@dob = FORMAT (FECHANACIMIENTO, '#39'yyyyMMdd'#39'), '
      #9#9#9'@gender = isNull(SEXO,0), '
      #9#9#9'@pat_address = rtrim(isnull(DIRECCION1,'#39#39')), '
      #9#9#9'@pat_city = rtrim(isnull(ciudad,'#39#39')),'
      #9#9#9'@pat_state = isnull(ESTADO,'#39#39'), '
      #9#9#9'@pat_zipcode = isnull(SUBSTRING(CODIGOPOSTAL,1,5),'#39#39'), '
      
        #9#9#9'@pat_telephone = concat(substring(isnull(telefono,'#39#39'), 2, 3),' +
        ' '
      #9#9#9'substring(isnull(telefono,'#39#39'), 6, 3), '
      #9#9#9'substring(isnull(telefono,'#39#39'), 10, 4)),'
      #9#9#9'@pat_cel = concat(substring(isnull(CELULAR,'#39#39'), 2, 3), '
      #9#9#9'substring(isnull(CELULAR,'#39#39'), 6, 3), '
      #9#9#9'substring(isnull(CELULAR,'#39#39'), 10, 4)),'
      #9#9#9'@pat_place_of_service = isnull(PLACE_OF_SERVICE,'#39#39'), '
      #9#9#9'@pat_pregnancy_indi = isnull(PREGNANCY_IDICATOR,'#39#39'), '
      #9#9#9'@pat_employer_id = isnull(EMPLOYER_ID,'#39#39'),'
      #9#9#9'@pat_email = isNull(EMAIL,'#39#39'), '
      #9#9#9'@pat_residence = isNull(PATIENT_RESIDENCE,'#39#39')'
      #9#9#9'from PACIENTES where NUMEROCLIENTE = @customer_no;'
      ''
      
        #9#9#9'select @bin_number = CONCAT(isNull(BINNUMBER,'#39#39'),SPACE(6),NUL' +
        'L), @SoftwareVendorID = CONCAT(isNull(SOFTWARE_VENDOR_ID,'#39#39'),SPA' +
        'CE(10),NULL),'
      
        #9#9#9'@ServiceProvID = CONCAT(isNull(NUMEROFARMACIA,'#39#39'),SPACE(15),N' +
        'ULL), @ProcessorControl = CONCAT(isNull(PROCESSORCONTROL,'#39#39'),SPA' +
        'CE(10),NULL),'
      
        #9#9#9'@ServiceProvIDQual = CONCAT(isNull(SERVICE_PROVIDER_ID_QUAL,'#39 +
        #39'),SPACE(2),NULL), @multiple_rx = MULTIPLE_RX_CLAIMS, @insurance' +
        '_name = NOMBRE,'
      
        #9#9#9'@insurance_code = ABREVIATURA, @enviar_campo_et = ENVIAR_CAMP' +
        'O_ET, '
      
        #9#9#9'@LTCServiceProvID = CONCAT(isNull(LTC_SERVICE_PROVIDER_ID,'#39#39')' +
        ',SPACE(15),NULL), '
      
        #9#9#9'@LTCServiceProvIDQual = CONCAT(isNull(LTC_SERVICE_PROVIDER_QU' +
        'AL,'#39#39'),SPACE(2),NULL)'
      
        #9#9#9'from PLANESMEDICOS where PLANESMEDICOSNO = @planesmedicosno; ' +
        '--ABREVIATURA = rtrim(@insurance_code);'#9
      #9#9#9
      
        #9#9#9'select @GroupNumber = CONCAT(isNull(NOGRUPO,'#39#39'),SPACE(15),NUL' +
        'L), @CardHolderID = CARDHOLDERID, -- CONCAT(isNull(@CardHolderID' +
        ','#39#39'),SPACE(20),NULL),'
      
        #9#9#9'@PersonCode = CONCAT(isNull(PersonCode,'#39#39'),SPACE(2),NULL), @R' +
        'elationShipCode = isNull(RELACION,0),'
      
        #9#9#9'@HomePlan = CONCAT(isNull(HOME_PLAN,'#39#39'),SPACE(3),NULL), @Eleg' +
        'ibilityClarificationCode = isNull(ELIGIBILITY_CLARIF_CODE,'#39#39'),'
      
        #9#9#9'@FacilityID = CONCAT(isNull(FACILITY_ID,'#39#39'),SPACE(10),NULL), ' +
        '@PlanId = CONCAT(isNull(PLAN_ID,'#39#39'),SPACE(8),NULL),'
      
        #9#9#9'@medigap_id = CONCAT(isNull(MEDIGAP_ID,'#39#39'),SPACE(20),NULL), @' +
        'medicaid_indicator = CONCAT(isNull(MEDICAID_INDICATOR,'#39#39'),SPACE(' +
        '2),NULL),'
      
        #9#9#9'@PAAI = CONCAT(isNull(PAAI,'#39#39'),SPACE(2),NULL), @CMSPD = isNul' +
        'l(PP997_G2,'#39#39'), '
      
        #9#9#9'@medicaid_id_number = CONCAT(isNull(MEDICAID_ID_NUMBER,'#39#39'),SP' +
        'ACE(20),NULL),'
      
        #9#9#9'@medicaid_agency_number = CONCAT(isNull(MEDICAID_AGENCY_NUMBE' +
        'R,'#39#39'),SPACE(15),NULL),'
      
        #9#9#9'@ch_first_name = CONCAT(isNull(CH_FIRSTNAME,'#39#39'),SPACE(12),NUL' +
        'L),'
      #9#9#9'@ch_last_name = CONCAT(isNull(CH_LASTNAME,'#39#39'),SPACE(12),NULL)'
      #9#9#9'from PATPLAN where NUMEROPLAN = @nopatplan;'#9#9#9
      
        #9#9#9'--Header-----------------------------------------------------' +
        '--------------------'
      #9#9#9'if @LTC = 0 --FALSE'
      #9#9#9'begin'
      
        #9#9'   '#9#9'Set @send_str = @bin_number + '#39'D0'#39' + @TransactionCode + @' +
        'ProcessorControl + cast(@TransactionCount as varchar) + @Service' +
        'ProvIDQual + @ServiceProvID + @datefilled + @SoftwareVendorID;'#9#9 +
        #9#9#9#9
      #9#9#9'end'
      #9#9#9'else'
      #9#9#9'begin'
      
        #9#9#9#9'Set @send_str = @bin_number + '#39'D0'#39' + @TransactionCode + @Pro' +
        'cessorControl + cast(@TransactionCount as varchar) + @LTCService' +
        'ProvIDQual + @LTCServiceProvID + @datefilled + @SoftwareVendorID' +
        ';'#9#9#9
      #9#9#9'end;'
      
        #9#9#9'--Insurance segment 04 --------------------------------------' +
