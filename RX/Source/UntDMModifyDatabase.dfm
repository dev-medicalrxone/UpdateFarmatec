        'al Solution'#39', N'#39'A solution that requires reconstitution with a s' +
        'uitable solvent and is intended for oral administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69046'#39', N'#39'Rectal'#39', N'#39'A sub' +
        'stance intended for administration in or around the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
