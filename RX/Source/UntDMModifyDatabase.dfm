  object CALC_RXDISPONIBLE_PRESCRIPTION: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE TRIGGER [dbo].[CALC_RXDISPONIBLE_PRESCRIPTION] ON [dbo].[' +
        'PRESCRIPTIONS]'
      'AFTER UPDATE'
      'AS'
      'SET NOCOUNT ON'
      'DECLARE @TDISPENSADO FLOAT'
      'DECLARE @TRECETADO FLOAT'
      'DECLARE @NORX INT'
      'DECLARE @NOREFAUTO INT'
      'DECLARE @RX_STATUS CHAR(1)'
      'begin'
      '  begin transaction'
      
        '  IF ( UPDATE (CANTIDADRECETADA) OR UPDATE (NumeroRefillsAutoriz' +
        'ados) )'
      '  BEGIN '
      '    Select @NORX = NUMERORECETA FROM inserted;'
      
        '    select  @NOREFAUTO = NumeroRefillsAutorizados FROM PRESCRIPT' +
        'IONS WHERE NUMERORECETA = @NORX;'
      
        #9'Select @TDISPENSADO = ISNULL(sum(qty),0) from OTC where NUMEROR' +
        'ECETA = @NORX AND RX_STATUS <> '#39'C'#39';'
      
        #9'Select @TRECETADO = CANTIDADRECETADA FROM PRESCRIPTIONS WHERE N' +
        'UMERORECETA = @NORX; '
      #9'if (Select @NOREFAUTO) > 0  '
      '    begin'
      
        '      select @TRECETADO = @TRECETADO + (@TRECETADO * @NOREFAUTO)' +
        '                    '
      '    end'
      
        '    Update PRESCRIPTIONS set CANTIDAD_DISPONIBLE = ISNULL(@TRECE' +
        'TADO - @TDISPENSADO, 0) where NUMERORECETA = @NORX;'
      '  END;'
      '  commit'
      'end;')
    Left = 1856
    Top = 880
  end
  object ORDER_TOTAL: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[ORDER_TOTAL] '
      '   ON  [dbo].[ORDER_DETAIL]'
      '   FOR INSERT,UPDATE,DELETE'
      'AS '
      'DECLARE @TOTAL_SENT FLOAT;'
      'DECLARE @ORDERID INT;'
      'set nocount on'
      'BEGIN'
      #9'begin transaction'
      
        #9'  IF UPDATE (TOTAL_VALUE) select @ORDERID = ORDERID FROM INSERT' +
        'ED'
      #9'  ELSE'
      #9'  select @ORDERID = ORDERID FROM deleted;'
      
        #9'  SELECT @TOTAL_SENT = ISNULL(sum(TOTAL_VALUE), 0) FROM ORDER_D' +
        'ETAIL WHERE ORDERID = @ORDERID;'#9
      
        #9'  Update ORDER_HEADER set RECEIVED =  @TOTAL_SENT WHERE ORDERID' +
        ' = @ORDERID;'
      #9'commit'
      'END')
    Left = 1992
    Top = 80
  end
