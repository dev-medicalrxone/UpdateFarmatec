  object RECALL_RX: TFDQuery
    AfterExecute = RECALL_RXAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE Procedure [dbo].[RECALL_RX] (@OTCNUMBER INT, @NUMERORECET' +
        'A BIGINT, @INSERTRX BIT, @INSERTOTC BIT, @USER CHAR(3))'
      'AS'
      'DECLARE @CONTROLADO CHAR(4)'
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @NOCLIENTE INT'
      'DECLARE @PRODUCT_NO INT'
      'begin'
      '  begin transaction'
      
        '  SELECT @CONTROLADO = CONTROLADO, @NOCLIENTE = NUMEROCLIENTE, @' +
        'PRODUCT_NO = PRODUCT_ID FROM OTC_HISTORY WHERE OTCNUMBER = @OTCN' +
        'UMBER;  '
      
        '  IF RTRIM(@CONTROLADO) = '#39'RX'#39' SET @ISCONTROLLED = 0 ELSE SET @I' +
        'SCONTROLLED = 1;'
      '  if @INSERTRX = 1'
      '  begin'
      '    set identity_insert dbo.Prescriptions ON;'
      '    INSERT INTO [dbo].[PRESCRIPTIONS]'
      '           ([NUMERODOCTOR],[NUMEROCLIENTE]'
      
        '           ,[NUMEROREFILLSAUTORIZADOS],[MEDICAMENTO],[RXORIGINCO' +
        'DE]'
      '           ,[COMPOUNDCODE],[FECHAULTIMOREFILL]'
      '           ,[FECHARECETA] ,[LICENCIA]'
      '           ,[NDC],[PRODUCT_ID]'
      
        '           ,[REFILL_AUTOMATICO],[PRESCRIBERIDQUALIFIER],[SCANED_' +
        'RX_LINK],[INFORMACION_EXT]'
      '           ,[NUMERORECETA],[ePRESCRIBE_IDMess]'
      '           ,[LABELCODESNO],[SPI],[MessageID],[CANTIDADRECETADA]'
      '           ,[ETIQUETA],[ACTIVE],[SIG]'
      '           ,[CANTIDAD_DISPONIBLE],[DAYS_SUPPLY],[INSTANCIA]'
      #9#9'   ,[CANCELED_BY_PRESCRIBER],[VETERINARY],[GUID]) '
      '       Select NUMERODOCTOR,NUMEROCLIENTE'
      '           ,NUMEROREFILLSAUTORIZADOS,MEDICAMENTO,RXORIGINCODE'
      '           ,COMPOUNDCODE,FECHAULTIMOREFILL'
      '           ,FECHARECETA,LICENCIA'
      '           ,NDC,PRODUCT_ID'
      
        '           ,REFILL_AUTOMATICO,PRESCRIBERIDQUALIFIER,SCANED_RX_LI' +
        'NK,INFORMACION_EXT'
      '           ,NUMERORECETA,ePRESCRIBE_IDMess'
      '           ,LABELCODESNO,SPI,MessageID,CANTIDADRECETADA'
      '           ,ETIQUETA,ACTIVE,SIG'
      '           ,CANTIDAD_DISPONIBLE,DAYS_SUPPLY,INSTANCIA '
      #9#9'   ,CANCELED_BY_PRESCRIBER,VETERINARY,GUID'
      
        '           FROM PRESCRIPTIONS_HISTORY WHERE NUMERORECETA = @NUME' +
        'RORECETA;'
      '    set identity_insert dbo.Prescriptions OFF;'
      
        '    delete from PRESCRIPTIONS_HISTORY where NUMERORECETA = @NUME' +
        'RORECETA; '#9'    '
      '  end;'
      '  if @INSERTOTC = 1'
      '  begin'
      '    set identity_insert dbo.otc ON;'
      '    INSERT INTO [dbo].[OTC]'
      
        '           ([OTCNUMBER],[TOTAL],[COBRADO],[FECHAOTC],[RX],[COSTO' +
        'VENTA],[NUMEROCLIENTE],[MEDICAMENTOMIX]'
      
        '           ,[NUMEROTRANSACCION],[PAGO_PLAN],[DEDUCIBLE],[PARTIAL' +
        '_COMPLETION],[RX_STATUS]'
      
        '           ,[NO_REF_DISPENSADO],[INGREDIENT_COST_PAID],[INCENTIV' +
        'E_FEE_PAID],[DISPENSING_FEE_PAID]'
      
        '           ,[OTHER_AMOUNT_PAID],[AMOUNT_COPAY_COINS],[GANANCIA],' +
        '[PHARMACIST],[DAYS_SUPPLY]'
      
        '           ,[PAGADA],[PRECIOFACTURACION],[PRODUCT_ID],[TIME_RX],' +
        '[NO_HORA],[NUMEROPLAN]'
      
        '           ,[OTC_BARCODE],[PLAN_MEDICO],[NUMERO_AUTORIZACION],[M' +
        'EDICAMENTO],[NDC]'
      
        '           ,[ATENDIDOPOR],[LOTE],[METRICDECIMALQUANTITY],[SIGNAT' +
        'URE_LINK],[PICKEDUPBY_RELETION]'
      
        '           ,[PICKEDUP_ID],[CHECKED],[PICKEDUPBY_RELATION],[TXR],' +
        '[PS_521_FL],[PS_523_FN]'
      
        '           ,[PS_512_FC],[PS_513_FD],[PS_517_FH],[PS_518_FI],[PS_' +
        '520_FK],[PS_514_FE]'
      
        '           ,[PS_346_HH],[PS_347_HJ],[PS_348_HK],[PS_571_NZ],[PS_' +
        '575_EQ],[PS_574_2Y]'
      
        '           ,[PS_572_4U],[PS_577_G3],[PS_133_UJ],[PS_134_UK],[PS_' +
        '135_UM],[PS_136_UN]'
      
        '           ,[PS_137_UP],[USUARIO_NO],[MEZCLA_TRAN_NO],[NUMEROREC' +
        'ETA],[REFILL_REMINDED]'
      
        '           ,[BATCH_NUMBER],[AUDITED],[PRICE_TABLE_ID],[WC_PICKUP' +
        '],[EP_TRANSACTION_NUMBER]'
      
        '           ,[REFILL_NOTIFIED],[UNIT_PRICE],[WF_TYPED],[WF_BILLED' +
        '],[WF_PRINTED],[WF_CHECKED]'
      
        '           ,[WF_DELIVERED],[WF_FILLED],[MED_CHART],[WF_STORAGE],' +
        '[PRINT_Q],[WFSTORAGE]'
      
        '           ,[ADHERENCE],[FACILITY_ID],[CLAIM_STATUS],[BILL_LATTE' +
        'R],[WF_CASHIER],[WF_SIGNATURE]'
      
        '           ,[ALCHEMY_PRODUCTID],[MARKETEDPRODUCTID],[WF_REVERSE]' +
        ',[PA],[PDN_SENT],[REFILL_REQ_TRANSNO]'
      
        '           ,[BATCH_REFILLREQ_DATE],[PRIORAUTHORIZATION],[QTY],[B' +
        'ASISOFCOST],[CLINICIDNUMBER]'
      
        '           ,[DIAGNOSISCODE],[DURCONFLICTCODE],[DURINTERVENTIONCO' +
        'DE],[DUROUTCOMECODE],[LEVELOFSERVICE]'
      
        '           ,[PRIMARYPRESCRIBER],[RXDENIALCLARIF],[RXDENIALOVERRI' +
        'DE],[DISPENSINGFEE],[GROSSAMOUNTDUE]'
      '           ,[PATIENTPAIDAMOUNT],[SALESTAX],[OTAMCLDSUBCOUNTQUAL]'
      
        '           ,[PRODUCTSERVIDQUAL],[PROVIDERID],[UNIT_DOSE_INDICATO' +
        'R],[UNIT_OF_MEASURE],[SUB_CLARIF_CODE]'
      
        '           ,[OTHERCOVERAGECODE],[SERVICEPROVIDQUALIFIER],[OP_AMO' +
        'UNTPAIDCOUNT],[OP_REJECTCOUNT]'
      
        '           ,[COB_OTHERPAYMENTCOUNT],[COMPDOSAGE_FORM_DESC_CODE],' +
        '[COMPDISP_UNIT_FORM_INDI]'
      
        '           ,[COMPROUTE_OF_ADMINISTRATION],[COMPING_COMP_COUNT],[' +
        'DISPENSING_STATUS],[QTY_INTENDED_DISP]'
      
        '           ,[DAYS_SUPPLY_INTEND_DISP],[FLAT_SALES_TAXSUB],[ASSOC' +
        '_RX_SERVICE_DATE],[ASSOC_RX_SERVICE_REF_NO]'
      
        '           ,[CUPONTYPE],[CUPON_NUMBER],[CUPON_VALUE_AMT],[PRIMAR' +
        'YCAREPROVIDQUALIFIER],[PRIMARYCAREPROVID]'
      
        '           ,[PRIMARYCAREPROVLASTNAME],[IAID_464_EX],[DRC_357_NV]' +
        ',[PAI_391_MT],[COMPOUND_TYPE_996_G1]'
      
        '           ,[PST_147_U7],[SCCD_354_NX],[PRAC_353_NR],[BSC_392_MU' +
        '],[SPECIAL_PACK_INDI_429_DT]'
      
        '           ,[ROUTEOFADMIN_995_E2],[WC_117_TR],[WC_118_TS],[WC_11' +
        '9_TT],[WC_120_TU],[WC_121_TV]'
      
        '           ,[WC_122_TW],[WC_123_TX],[WC_124_TY],[WC_125_TZ],[WC_' +
        '126_UA],[PRIMARYCAREPROVLOCATIONCODE]'
      
        '           ,[PATIENTLOCATION],[PRESC_SRNM],[PS_558_AW],[PS_559_A' +
        'X],[REVENUE_CODE],[DAW]'
      
        '           ,[BATCH_NUMBER_BILLING],[TERMINADA],[MEDICAID_PAID_AM' +
        'OUNT],[PMC_459_ER],[PMCC_458_SE]'
      
        '           ,[SPIDN_454_EK],[IATID_463_EW],[CONTROLADO],[DAYS_SUP' +
        'LY],[CODIGOREFILLNUEVO],[RXNUMBERSRNQ]'
      
        '           ,[TRANSACTION_CODE],[MEDICAMENTOORIGINAL],[ROBOT],[LA' +
        'BEL_NAME],[FECHAEXPIRACION],[IMPRIMIR]'
      
        '           ,[INSTANCIA],[ORG_PROS_PROD_SERVID],[ORG_PRESC_QTY],[' +
        'ORG_PRES_PROD_SIDQ],[PRIOR_AUTH_TYPE_CODE]'
      
        '           ,[INCENTIVE_AMOUNT_SUB],[PROF_SERV_FEE_SUB],[PERCENTA' +
        'GE_SALES_TAX_SUB],[PERCENTAGE_SALES_TAX_RATE]'
      
        '           ,[OTHERAMOUNTCLAIMEDSUB],[QTY_TEMP],[OTHERAMOUNTCLAIM' +
        'EDSUBCOUNT],[PER_SALESTAX_BASIS_SUB],[WC_DATE_OF_INJURY]'
      
        '           ,[WC_EMPLOYER_NAME],[WC_EMPLOYER_STREET],[WC_EMPLOYER' +
        '_CITY],[WC_EMPLOYER_STATE],[WC_EMPLOYER_CONTACT]'
      
        '           ,[WC_EMLPOYER_ZIP],[WC_CARRIER_ID],[WC_CLAIMREF_ID],[' +
        'WC_EMPLOYER_PHONE], [PLANESMEDICOSNO], [APPRISS_SENT]'
      #9#9'   ,[APPRISS_VOID],[DELIVERY],[IOU],[POST_DATE])'
      
        '     SELECT OTCNUMBER,TOTAL,COBRADO,FECHAOTC,RX,COSTOVENTA,NUMER' +
        'OCLIENTE,MEDICAMENTOMIX,NUMEROTRANSACCION,PAGO_PLAN'
      
        '           ,DEDUCIBLE,PARTIAL_COMPLETION,RX_STATUS,NO_REF_DISPEN' +
        'SADO,INGREDIENT_COST_PAID,INCENTIVE_FEE_PAID,DISPENSING_FEE_PAID'
      
        '           ,OTHER_AMOUNT_PAID,AMOUNT_COPAY_COINS,GANANCIA,PHARMA' +
        'CIST,DAYS_SUPPLY,PAGADA,PRECIOFACTURACION,PRODUCT_ID,TIME_RX'
      
        '           ,NO_HORA,NUMEROPLAN,OTC_BARCODE,PLAN_MEDICO,NUMERO_AU' +
        'TORIZACION,MEDICAMENTO,NDC,ATENDIDOPOR,LOTE, METRICDECIMALQUANTI' +
        'TY'
      
        '           ,SIGNATURE_LINK,PICKEDUPBY_RELETION,PICKEDUP_ID,CHECK' +
        'ED,PICKEDUPBY_RELATION,TXR ,PS_521_FL,PS_523_FN,PS_512_FC'
      
        '           ,PS_513_FD,PS_517_FH,PS_518_FI,PS_520_FK,PS_514_FE,PS' +
        '_346_HH,PS_347_HJ,PS_348_HK,PS_571_NZ,PS_575_EQ'
      
        '           ,PS_574_2Y,PS_572_4U,PS_577_G3, PS_133_UJ,PS_134_UK,P' +
        'S_135_UM,PS_136_UN,PS_137_UP,USUARIO_NO,MEZCLA_TRAN_NO,NUMEROREC' +
        'ETA'
      
        '           ,REFILL_REMINDED,BATCH_NUMBER,AUDITED,PRICE_TABLE_ID,' +
        'WC_PICKUP,EP_TRANSACTION_NUMBER,REFILL_NOTIFIED,UNIT_PRICE'
      
        '           ,WF_TYPED,WF_BILLED,WF_PRINTED,WF_CHECKED,WF_DELIVERE' +
        'D,WF_FILLED,MED_CHART,WF_STORAGE,PRINT_Q,WFSTORAGE,ADHERENCE'
      
        '           ,FACILITY_ID,CLAIM_STATUS,BILL_LATTER,WF_CASHIER,WF_S' +
        'IGNATURE,ALCHEMY_PRODUCTID,MARKETEDPRODUCTID,WF_REVERSE,PA,PDN_S' +
        'ENT'
      
        '           ,REFILL_REQ_TRANSNO,BATCH_REFILLREQ_DATE,PRIORAUTHORI' +
        'ZATION,QTY,BASISOFCOST,CLINICIDNUMBER,DIAGNOSISCODE,DURCONFLICTC' +
        'ODE'
      
        '           ,DURINTERVENTIONCODE,DUROUTCOMECODE,LEVELOFSERVICE,PR' +
        'IMARYPRESCRIBER,RXDENIALCLARIF,RXDENIALOVERRIDE,DISPENSINGFEE,GR' +
        'OSSAMOUNTDUE'
      
        '           ,PATIENTPAIDAMOUNT,SALESTAX,OTAMCLDSUBCOUNTQUAL,PRODU' +
        'CTSERVIDQUAL,PROVIDERID,UNIT_DOSE_INDICATOR'
      
        '           ,UNIT_OF_MEASURE,SUB_CLARIF_CODE,OTHERCOVERAGECODE,SE' +
        'RVICEPROVIDQUALIFIER,OP_AMOUNTPAIDCOUNT,OP_REJECTCOUNT,COB_OTHER' +
        'PAYMENTCOUNT,COMPDOSAGE_FORM_DESC_CODE'
      
        '           ,COMPDISP_UNIT_FORM_INDI,COMPROUTE_OF_ADMINISTRATION,' +
        'COMPING_COMP_COUNT,DISPENSING_STATUS,QTY_INTENDED_DISP,DAYS_SUPP' +
        'LY_INTEND_DISP,FLAT_SALES_TAXSUB'
      
        '           ,ASSOC_RX_SERVICE_DATE,ASSOC_RX_SERVICE_REF_NO,CUPONT' +
        'YPE,CUPON_NUMBER,CUPON_VALUE_AMT,PRIMARYCAREPROVIDQUALIFIER,PRIM' +
        'ARYCAREPROVID,PRIMARYCAREPROVLASTNAME'
      
        '           ,IAID_464_EX,DRC_357_NV,PAI_391_MT,COMPOUND_TYPE_996_' +
        'G1,PST_147_U7,SCCD_354_NX,PRAC_353_NR,BSC_392_MU,SPECIAL_PACK_IN' +
        'DI_429_DT,ROUTEOFADMIN_995_E2,WC_117_TR'
      
        '           ,WC_118_TS,WC_119_TT,WC_120_TU,WC_121_TV,WC_122_TW,WC' +
        '_123_TX,WC_124_TY,WC_125_TZ,WC_126_UA,PRIMARYCAREPROVLOCATIONCOD' +
        'E,PATIENTLOCATION,PRESC_SRNM'
      
        '           ,PS_558_AW,PS_559_AX,REVENUE_CODE,DAW,BATCH_NUMBER_BI' +
        'LLING,TERMINADA,MEDICAID_PAID_AMOUNT,PMC_459_ER,PMCC_458_SE,SPID' +
        'N_454_EK,IATID_463_EW,CONTROLADO'
      
        '           ,DAYS_SUPLY,CODIGOREFILLNUEVO,RXNUMBERSRNQ ,TRANSACTI' +
        'ON_CODE,MEDICAMENTOORIGINAL,ROBOT,LABEL_NAME,FECHAEXPIRACION,IMP' +
        'RIMIR,INSTANCIA,ORG_PROS_PROD_SERVID,ORG_PRESC_QTY'
      
        '           ,ORG_PRES_PROD_SIDQ,PRIOR_AUTH_TYPE_CODE,INCENTIVE_AM' +
        'OUNT_SUB,PROF_SERV_FEE_SUB,PERCENTAGE_SALES_TAX_SUB,PERCENTAGE_S' +
        'ALES_TAX_RATE,OTHERAMOUNTCLAIMEDSUB,QTY_TEMP'
      
        '           ,OTHERAMOUNTCLAIMEDSUBCOUNT,PER_SALESTAX_BASIS_SUB,WC' +
        '_DATE_OF_INJURY,WC_EMPLOYER_NAME,WC_EMPLOYER_STREET,WC_EMPLOYER_' +
        'CITY,WC_EMPLOYER_STATE,WC_EMPLOYER_CONTACT,WC_EMLPOYER_ZIP'
      
        '           ,WC_CARRIER_ID,WC_CLAIMREF_ID,WC_EMPLOYER_PHONE,PLANE' +
        'SMEDICOSNO,APPRISS_SENT'
      #9#9'   ,APPRISS_VOID,DELIVERY,IOU,POST_DATE'
      '        FROM OTC_HISTORY WHERE OTCNUMBER = @OTCNUMBER;'
      '        set identity_insert dbo.otc OFF;'
      
        '       EXECUTE INSERT_LOG '#39'RX RECALLED'#39', '#39'U'#39', '#39#39', @USER,  '#39#39', @N' +
        'UMERORECETA, @OTCNUMBER,0,@NOCLIENTE,0,0,0,@PRODUCT_NO,'#39'R'#39','#39#39',@I' +
        'SCONTROLLED,1;'
      '     Delete from OTC_HISTORY where OTCNUMBER = @OTCNUMBER;'
      '  end;'
      '  commit'
      'end;')
    Left = 2704
    Top = 1016
  end
