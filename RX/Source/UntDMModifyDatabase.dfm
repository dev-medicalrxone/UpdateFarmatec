      #9#9#9',[FOODITEM]'
      #9#9#9',[NONEBC]'
      #9#9#9',[COBRAR_TAX]'
      #9#9#9',[INV340B_QT]'
      #9#9#9',[INVLTC_QT]'
      #9#9#9',[GENERIC_LNK]'
      #9#9#9',[SPI]'
      #9#9#9',[AP_FRM_SIG]'
      #9#9#9',[AP_MTH_SIG]'
      #9#9#9',[Drug340B]'
      #9#9#9',[FactorSig]'
      #9#9#9',[DF_QTY]'
      #9#9#9',[LTC]'
      #9#9#9',[UNIT_OF_MEASURE]'
      #9#9#9',[HCPCS_CODE]'
      #9#9#9',[PRODUCTSERVIDQUAL]) '
      #9#9'  Values'
      #9#9#9'(@TIPO'
      #9#9#9',@FECHA_EXPIRACION'
      #9#9#9',@COSTO'
      #9#9#9',@RBP'
