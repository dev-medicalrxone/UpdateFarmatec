  object qryUpdatePatPlanIndex: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'Update PATPLAN set INSURANCE_INDEX = 2;'
      'Update PATPLAN set INSURANCE_INDEX = 0 where ACTIVO = 0;'
      'Update PATPLAN set INSURANCE_INDEX = 1 where PLAN_PRIMARIO = 1;'
      
        'Update PATPLAN set INSURANCE_INDEX = 2 where PLAN_PRIMARIO <> 1 ' +
        'and ACTIVO = 1;'
      
        'update PATPLAN set INSURANCE_INDEX = -1 where PLANMEDICO = '#39'CAS'#39 +
        ';')
    Left = 6696
    Top = 728
  end
  object DELETE_COB_DEPENDENTS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER DELETE_COB_DEPENDENTS '
      '   ON  dbo.COB_A'
      '   AFTER DELETE'
      'AS '
      'DECLARE @NOTRANS INTEGER;'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION;'
      #9'SELECT @NOTRANS = NOTRANS FROM DELETED;'
      #9'DELETE FROM COB_B WHERE NOTRANS = @NOTRANS;'
      #9'DELETE FROM COB_C WHERE NOTRANS = @NOTRANS;'
      #9'DELETE FROM COB_D WHERE NOTRANS = @NOTRANS;'
      #9'DELETE FROM COB_E WHERE NOTRANS = @NOTRANS;'
      '    COMMIT;'
      'END;')
    Left = 6696
    Top = 832
  end
