  object CREATE_FIX_CONTROLADO: TFDQuery
    AfterExecute = CREATE_FIX_CONTROLADOAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[FIX_CONTROLADO] '
      'AS'
      '  DECLARE @NORX BIGINT'
      '  DECLARE @OTCNUMBER INT'
      '  DECLARE @CONTROLADO CHAR(3)'
      '  DECLARE @PRODUCT_ID INT'
      '  DECLARE @DAW VARCHAR(1)'
      '  SET NOCOUNT ON'
      'begin'
      '  begin transaction'
      '     begin '
      
        '       DECLARE MyCursor CURSOR FOR Select NUMERORECETA, PRODUCT_' +
        'ID, OTCNUMBER from OTC WITH (NOLOCK) WHERE NUMERORECETA > 0 AND ' +
        '((CONTROLADO IS NULL) OR (LTRIM(CONTROLADO) = '#39#39'));'
      
        #9'   --DECLARE MyCursor CURSOR FOR Select NUMERORECETA, PRODUCT_I' +
        'D, @OTCNUMBER from OTC WITH (NOLOCK) WHERE NUMERORECETA = 440270' +
        ';'
      '       OPEN MyCursor'
      '       FETCH NEXT FROM MyCursor'
      '       INTO @NORX, @PRODUCT_ID, @OTCNUMBER '
      '       WHILE @@FETCH_STATUS = 0'
      '       BEGIN'
      
        '         Select @CONTROLADO = CONTROLADO FROM INVENTARIOPISO WHE' +
        'RE PRODUCTNO = @PRODUCT_ID;'
      '         IF (@CONTROLADO > '#39#39') '
      '         begin '
      '           begin transaction'
      
        '           Update OTC set CONTROLADO = @CONTROLADO where OTCNUMB' +
        'ER = @OTCNUMBER;'
      '           commit;'
      '         end;'
      '         FETCH NEXT FROM MyCursor'
      '         INTO @NORX, @PRODUCT_ID, @OTCNUMBER'
      '       END'
      '       CLOSE MyCursor'
      '       DEALLOCATE MyCursor'
      '     end;'
      '     begin '
      '       UPDATE PRESCRIPTIONS SET DAW = 0 WHERE DAW = '#39'.'#39';'
      
        '       DECLARE MyCursor CURSOR FOR Select NUMERORECETA, DAW from' +
        ' PRESCRIPTIONS WITH (NOLOCK) ORDER BY NUMERORECETA;'
      '       OPEN MyCursor'
      '       FETCH NEXT FROM MyCursor'
      '       INTO @NORX, @DAW '
      '       WHILE @@FETCH_STATUS = 0'
      '       BEGIN'
      '         IF (ISNUMERIC(LTRIM(@DAW)) = 1)'
      ' '#9' begin '
      #9'    begin transaction'
      
        #9'      Update OTC set DAW = CONVERT(INTEGER, @DAW) where NUMEROR' +
        'ECETA = @NORX and ((DAW IS NULL) OR (LTRIM(DAW) = '#39#39'));'
      #9'    Commit;'
      '          end;'
      '         FETCH NEXT FROM MyCursor'
      '         INTO @NORX, @DAW '
      '       END'
      '       CLOSE MyCursor'
      '       DEALLOCATE MyCursor'
      '     end;'
      '  commit'
      'end')
    Left = 2848
    Top = 360
  end
  object FIX_CONTROLADO: TFDStoredProc
