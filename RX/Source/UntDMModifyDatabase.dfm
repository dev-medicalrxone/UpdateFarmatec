        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91183'#39', N'#39'Rectal Powder'#39', ' +
        'N'#39'A powder intended for administration to the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C91184'#39', N'#39'Rectal Spray'#39', N' +
        #39'A spray intended for administration to the rectum.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68989'#39', N'#39'Rectal Supposito' +
        'ry'#39', N'#39'A suppository intended for administration within the rect' +
        'um.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42978'#39', N'#39'Resin Gum'#39', N'#39'A ' +
        'semi-solid composed of a mixture of gum and a plant based hydroc' +
        'arbon.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C60988'#39', N'#39'Ring'#39', N'#39'A solid' +
        ' composed active and/or inert ingredient(s) of in the shape of a' +
        ' hoop.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42979'#39', N'#39'Rinse'#39', N'#39'A solu' +
        'tion or suspension intended for irrigation purposes.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42980'#39', N'#39'Salve'#39', N'#39'A semi' +
        '-solid composed of a thick fat or wax-based ointment or cerate w' +
        'ith a consistency somewhere between an ointment and a plaster.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45244'#39', N'#39'Semisolid'#39', N'#39'A ' +
        'substance with properties of both a solid and a liquid in terms ' +
        'of viscosity and rigidity. Semi-solids include but are not limit' +
        'ed to ointments creams pastes and gels.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42981'#39', N'#39'Shampoo'#39', N'#39'A so' +
        'lution or suspension composed of an anionic surfactant and inten' +
        'ded for administration to the hair and/or scalp.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42982'#39', N'#39'Shampoo Suspensi' +
        'on'#39', N'#39'A suspension composed of anionic surfactant and intended ' +
        'for administration to the hair and/or scalp.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C28276'#39', N'#39'Skin Patch'#39', N'#39'A' +
        ' patch intended for administration to the skin.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42983'#39', N'#39'Soap'#39', N'#39'An anio' +
        'nic surfactant for cleansing.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C64909'#39', N'#39'Soft Capsule'#39', N' +
        #39'A capsule composed of active and/or inert ingredient(s) covered' +
        ' with a soft outer shell which is usually prepared from gelatin.' +
        #39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C45235'#39', N'#39'Solid'#39', N'#39'A subs' +
        'tance having definite shape and volume manufactured for the admi' +
        'nistration of active and/or inert ingredient(s). Solids include ' +
        'tablets capsules powders granules and certain suppositories.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42984'#39', N'#39'Soluble Film'#39', N' +
        #39'A film that will dissolve in a liquid solvent to form a solutio' +
        'n.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42985'#39', N'#39'Soluble Tablet'#39',' +
        ' N'#39'A tablet that will dissolve in a liquid solvent to form a sol' +
        'ution.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42986'#39', N'#39'Solution'#39', N'#39'A c' +
        'lear homogeneous liquid composed of one or more chemical substan' +
        'ces dissolved in a solvent or mixture of mutually miscible solve' +
        'nts.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C69028'#39', N'#39'Solution for Rec' +
        'onstitution'#39', N'#39'A solution intended for reconstitution before ad' +
        'ministration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42987'#39', N'#39'Solution for Slu' +
        'sh'#39', N'#39'A solution composed of an iced saline slurry with or with' +
        'out active and/or inert ingredient(s) intended to induce regiona' +
        'l hypothermia from the point of administration.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47912'#39', N'#39'Sponge'#39', N'#39'A sol' +
        'id composed of a porous interlacing absorbent usually shape reta' +
        'ining material such as cellulose wood fibers or plastic polymer ' +
        'form.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42989'#39', N'#39'Spray'#39', N'#39'A solu' +
        'tion or suspension composed of active and/or inert ingredient(s)' +
        ' in oil or water typically dispensed from an atomizer or nebuliz' +
        'er.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42990'#39', N'#39'Spray Suspension' +
        #39', N'#39'A spray composed of a suspension that contains active and/o' +
        'r inert ingredient(s).'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C68946'#39', N'#39'Sprinkle Capsule' +
        #39', N'#39'A capsule composed active and/or inert ingredient(s) of as ' +
        'small pellet-like granules. The capsule is intended to be broken' +
        ' open facilitating the scattering of the granules into soft food' +
        's although it may also be swallowed whole.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42991'#39', N'#39'Stick'#39', N'#39'A soli' +
        'd composed active and/or inert ingredient(s) in a long slender c' +
        'ylindrical shape.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C47914'#39', N'#39'Strip'#39', N'#39'A soli' +
        'd composed of active and/or inert ingredient(s) in a long narrow' +
        ' piece of material.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42751'#39', N'#39'Sublingual Table' +
        't'#39', N'#39'A tablet intended for administration under the tongue.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42992'#39', N'#39'Sugar Coated Tab' +
        'let'#39', N'#39'A tablet covered with sugar.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
        ', [Definition]) VALUES (N'#39'C89508'#39', N'#39'C42993'#39', N'#39'Suppository'#39', N'#39 +
        'A solid or semi-solid composed of active and/or inert ingredient' +
        '(s) in a wax fat or a glycerin gelatin jelly and that is conical' +
        ' or oval in shape. It is intended to be inserted into a body ori' +
        'fice.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
