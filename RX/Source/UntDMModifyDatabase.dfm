  object UPDATE_OTC_HEALTHPLAN: TFDQuery
    AfterExecute = UPDATE_OTC_HEALTHPLANAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[UPDATE_OTC_HEALTHPLAN]'
      '    @OTCNUMBER INT,'
      '    @PRICETABLEID INT,'
      '    @HEALTHPLAN NCHAR(3),'
      '    @NOPLAN INT,'
      '    @CLAIM_STATUS INT,'
      '    @NO_RX BIGINT,'
      '    @USER CHAR(3),'
      '    @PHARMACIST NCHAR(3),'
      '    @PLANESMEDICOSNO INT,'
      '    @Note VARCHAR(MAX),'
      
        '    @UPDATE_ALL BIT  -- kept for compatibility; ignored for safe' +
        'ty'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      '    SET XACT_ABORT ON;'
      ''
      '    BEGIN TRY'
      '        BEGIN TRANSACTION;'
      ''
      '        -- Lock the candidate row and ensure exactly one match'
      '        DECLARE @MatchCount INT;'
      ''
      '        SELECT @MatchCount = COUNT_BIG(*)'
      '        FROM dbo.OTC WITH (UPDLOCK, HOLDLOCK)'
      '        WHERE OTCNumber = @OTCNUMBER;'
      ''
      '        IF @MatchCount = 0'
      
        '            THROW 50001, '#39'UPDATE_OTC_HEALTHPLAN: No row found fo' +
        'r given OTCNumber. No update performed.'#39', 1;'
      ''
      '        IF @MatchCount > 1'
      
        '            THROW 50002, '#39'UPDATE_OTC_HEALTHPLAN: Multiple rows m' +
        'atched this OTCNumber. Update aborted for safety.'#39', 1;'
      ''
      '        -- Update the one and only row'
      '        UPDATE dbo.OTC'
      '           SET PLAN_MEDICO     = @HEALTHPLAN,'
      '               PLANESMEDICOSNO = @PLANESMEDICOSNO,'
      '               CLAIM_STATUS    = @CLAIM_STATUS,'
      '               NUMEROPLAN      = @NOPLAN,'
      '               PRICE_TABLE_ID  = @PRICETABLEID'
      '         WHERE OTCNumber = @OTCNUMBER;'
      ''
      '        -- Double-check exactly 1 row updated'
      '        IF @@ROWCOUNT <> 1'
      
        '            THROW 50003, '#39'UPDATE_OTC_HEALTHPLAN: Safety check fa' +
        'iled (rowcount <> 1). Update aborted.'#39', 1;'
      ''
      '        -- Log (for the same OTCNumber you updated)'
      '        EXEC dbo.INSERT_LOG'
      '             '#39'Health Plan changed'#39', '#39'U'#39', '#39#39', @USER, @PHARMACIST,'
      '             @NO_RX, @OTCNUMBER,'
      '             0,0,0,0,0,0,'#39'R'#39', @Note, 0, 1;'
      ''
      '        COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        -- Bubble up the error'
      '        THROW;'
      '    END CATCH'
      'END;')
    Left = 2304
    Top = 360
  end
  object INSERT_LOG: TFDQuery
    AfterExecute = INSERT_LOGAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE dbo.INSERT_LOG'
      '('
      '    @DESCRIPCION CHAR(30),'
      '    @CODIGO CHAR(1),'
      '    @NDC_BARCODE CHAR(13),'
      '    @USUARIO CHAR(3),'
      '    @SUPERVISOR VARCHAR(3),'
      '    @NO_RX BIGINT,'
      '    @OTCNUMBER INT,'
      '    @PRESCRIBER_ID INT,'
      '    @CUSTOMER_ID INT,'
      '    @PASSWORD_ID INT,'
      '    @HEALTH_PLAN_ID INT,'
      '    @PATIENT_HEALTH_PLAN_ID INT,'
      '    @DRUG_ID INT,'
      '    @POS_RX CHAR(1),'
      '    @NOTE VARCHAR(MAX),'
      '    @CONTROLLED BIT,'
      '    @SUCCESSFUL BIT'
      ')'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    DECLARE @startedTran bit = 0;'
      ''
      '    BEGIN TRY'
      
        '        -- Start a transaction ONLY if caller didn'#39't already sta' +
        'rt one'
      '        IF @@TRANCOUNT = 0'
      '        BEGIN'
      '            SET @startedTran = 1;'
      '            BEGIN TRANSACTION;'
      '        END'
      ''
      '        INSERT INTO dbo.[LOG]'
      '        ('
      
        '            CODIGO, NDC_BARCODE, FECHA, USUARIO, DESCRIPCION, SU' +
        'PERVISOR,'
      
        '            NO_RX, OTCNUMBER, PRESCRIBER_ID, CUSTOMER_ID, PASSWO' +
        'RD_ID,'
      
        '            HEALTH_PLAN_ID, PATIENT_HEALTH_PLAN_ID, DRUG_ID, POS' +
        '_RX,'
      '            NOTE, CONTROLLED, SUCCESSFUL'
      '        )'
      '        VALUES'
      '        ('
      
        '            @CODIGO, @NDC_BARCODE, GETDATE(), @USUARIO, @DESCRIP' +
        'CION, @SUPERVISOR,'
      
        '            @NO_RX, @OTCNUMBER, @PRESCRIBER_ID, @CUSTOMER_ID, @P' +
        'ASSWORD_ID,'
      
        '            @HEALTH_PLAN_ID, @PATIENT_HEALTH_PLAN_ID, @DRUG_ID, ' +
        '@POS_RX,'
      '            @NOTE, @CONTROLLED, @SUCCESSFUL'
      '        );'
      ''
      '        IF @startedTran = 1'
      '            COMMIT TRANSACTION;'
      '    END TRY'
      '    BEGIN CATCH'
      '        IF @startedTran = 1 AND @@TRANCOUNT > 0'
      '            ROLLBACK TRANSACTION;'
      ''
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 2312
    Top = 424
  end
  object INSERT_PRESCRIPTIONS1: TFDQuery
    AfterExecute = INSERT_PRESCRIPTIONS1AfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_PRESCRIPTIONS] '
      ' @FECHARECETA DATE, '
      ' @NO_HORA INT, @WF_TYPED NCHAR(30), @INSTANCIA INT, '
      ' @USER CHAR(3), '
      ' @NORX BIGINT OUTPUT, @GUID VARCHAR(36) OUTPUT,'
      ' @LEVEL_OF_SERVICE INT, '
      ' @DELIVERY BIT '
      ' AS'
      ' declare @NO_CLIENTE INT'
      ' DECLARE @NUMERODOCTOR INT'
      ' DECLARE @LICENCIA VARCHAR(15)'
      ' DECLARE @PRESCRIBERIDQUALIFIER VARCHAR(2) '
      ' DECLARE @DATE_OF_SERVICE VARCHAR(10)'
      ' DECLARE @ORIGINCODE CHAR(1)'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9'  SET @NO_CLIENTE = 0;'
      #9'  SET @ORIGINCODE = '#39'1'#39';'
      #9'  if @GUID  = '#39#39
      #9'  begin'
      #9'    SELECT @GUID = NEWID();  '#9
      #9'  end'
      #9'  else'
      #9'  begin'#9'    '
      
        #9#9'SELECT @NO_CLIENTE = NUMEROCLIENTE FROM OTC WHERE GUID = @GUID' +
        ';'
      
        #9#9'SELECT @PRESCRIBERIDQUALIFIER = PRESCRIBERIDQUALIFIER, @LICENC' +
        'IA = LICENCIA, '
      
        #9#9'  @NUMERODOCTOR = NUMERODOCTOR, @ORIGINCODE = RXORIGINCODE FRO' +
        'M PRESCRIPTIONS WHERE GUID = @GUID; '
      #9'  end;'
      
        #9'  INSERT INTO PRESCRIPTIONS (NUMEROCLIENTE, NUMERODOCTOR, LICEN' +
        'CIA, PRESCRIBERIDQUALIFIER, '
      
        #9'  MessageID, FECHARECETA, RXORIGINCODE, SCANED_RX_LINK, SPI, CA' +
        'NTIDADRECETADA,'
      
        #9'  DAW,NUMEROREFILLSAUTORIZADOS,MEDICAMENTO,COMPOUNDCODE,PRODUCT' +
        '_ID,NDC,LABELCODESNO,ETIQUETA,SIG,'
      #9'  DIASSUPLIDOS,DAYS_SUPPLY, INSTANCIA, GUID) '
      
        #9'  VALUES (@NO_CLIENTE, @NUMERODOCTOR, @LICENCIA, @PRESCRIBERIDQ' +
        'UALIFIER, '
      #9'  '#39#39', @FECHARECETA, @ORIGINCODE, 0, '#39#39', 0,'
      #9'  '#39#39',0, '#39#39',1,0,'#39#39',0,'#39#39','#39#39',0,0, @INSTANCIA, @GUID);'
      #9'  SET @NORX=SCOPE_IDENTITY();'
      #9'  select @DATE_OF_SERVICE = convert(varchar, getdate(), 101);'
      
        #9'  EXEC INSERT_OTC '#39#39', '#39#39', 0, @USER, '#39'F'#39', @DATE_OF_SERVICE, @NOR' +
        'X, '#39#39', 0, 0, @NO_CLIENTE, '#39#39', 1, 0, 0,'#39#39','#39#39','#39'N'#39',0,0,0,0,0,0,0,'#39#39 +
        ',0,'#39'F'#39',0,'#39#39',0,'
      
        #9'  @NO_HORA, 0, '#39#39', @FECHARECETA, 0, '#39#39', @WF_TYPED, 0, 0, FALSE,' +
        ' 0, 0, @INSTANCIA, 1, 0,0,'#39#39', 0,0,0, '
      
        #9'  '#39'01/01/2000'#39',0,'#39#39','#39#39',0, '#39'0'#39',0,0,'#39#39','#39#39',1,@DELIVERY,@LEVEL_OF_S' +
        'ERVICE, @GUID, 0;     '
      #9'COMMIT;'
      'END;')
    Left = 5816
    Top = 128
  end
  object CANCEL_NEW_RX: TFDQuery
    AfterExecute = CANCEL_NEW_RXAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[CANCEL_NEW_RX] @GUID VARCHAR(36) '
      'AS'
      'DECLARE @NORX BIGINT'
      'DECLARE @OTC_NUMBER INT'#9
      'DECLARE @ATENDIDAPOR CHAR(3)'
      'DECLARE @PHARMACIST CHAR(3) '
      'DECLARE @QTY FLOAT'
      'DECLARE @MessageID VARCHAR(50)'
      'DECLARE @SCAN_RX_LINK INT'
      'DECLARE @NUMEROCLIENTE INT'
      'DECLARE @PRODUCT_ID INT'
      'DECLARE @NUMERODOCTOR INT'
      'DECLARE @CLAIM_STATUS INT'
      'DECLARE @DRUG NCHAR(30)'
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  BEGIN TRANSACTION'#9
      #9'-- HARD STOP: do not run if GUID is NULL or blank'
      #9'IF @GUID IS NULL OR LTRIM(RTRIM(@GUID)) = '#39#39
      #9'BEGIN'
      
        #9#9'RAISERROR('#39'Parameter @GUID is required and cannot be NULL or b' +
        'lank.'#39', 16, 1);'
      #9#9'RETURN;'
      #9'END;'#9
      
        #9'DECLARE MyCursor CURSOR FOR SELECT NUMERORECETA, QTY, OTCNUMBER' +
        ', '
      
        #9'ATENDIDOPOR, PHARMACIST, ISNULL(NUMEROCLIENTE,0), ISNULL(PRODUC' +
        'T_ID,0), CLAIM_STATUS, MEDICAMENTO FROM OTC WHERE GUID = @GUID;'
      #9'OPEN MyCursor'
      #9'FETCH NEXT FROM MyCursor'
      
        #9'INTO @NORX, @QTY, @OTC_NUMBER, @ATENDIDAPOR, @PHARMACIST, @NUME' +
        'ROCLIENTE, @PRODUCT_ID, @CLAIM_STATUS, @DRUG '
      #9'WHILE @@FETCH_STATUS = 0'
      #9'begin'
      
        #9#9'Select @SCAN_RX_LINK = SCANED_RX_LINK, @MessageID = MessageID,' +
        ' @NUMERODOCTOR = NUMERODOCTOR from PRESCRIPTIONS where NUMEROREC' +
        'ETA = @NORX;'
      #9#9'if (@CLAIM_STATUS <> 0) and (rtrim(@DRUG) > '#39#39')  '
      #9#9'begin'
      
        #9#9#9'UPDATE OTC SET GUID = '#39#39', RECORD_LOCKED = 0 where OTCNUMBER =' +
        ' @OTC_NUMBER;'
      #9#9#9'IF RTRIM(@MessageID) > '#39#39
      #9#9#9'BEGIN'
      
        #9#9#9#9'Update Surescripts set Rx_status = 1 where RxReferenceNumber' +
        ' = @NORX;'
      #9#9#9'END;'
      #9#9'end'
      #9#9'else'
      #9#9'begin'#9#9#9
      #9#9#9'DELETE FROM RX_CLINICAL_ALERT WHERE OTCNUMBER = @OTC_NUMBER;'
      
        #9#9#9'DELETE FROM RX_CLINICAL_APPROVAL WHERE OTCNUMBER = @OTC_NUMBE' +
        'R;'
      #9#9#9'DELETE FROM PRESCRIPTIONS WHERE NUMERORECETA = @NORX;'
      #9#9#9'DELETE FROM DISPILL WHERE NUMERORECETA = @NORX;'
      
        #9#9#9'EXECUTE INSERT_LOG '#39'RX DISCARTED ON NEWRX '#39', '#39'D'#39', '#39#39', @ATENDI' +
        'DAPOR,  @PHARMACIST, @NORX, @OTC_NUMBER,@NUMERODOCTOR,@NUMEROCLI' +
        'ENTE,0,0,0,@PRODUCT_ID,'#39'R'#39','#39#39',0,1;'
      #9#9#9'IF @SCAN_RX_LINK > 0'
      #9#9#9'BEGIN'
      
        #9#9#9#9'UPDATE REFILL_QUERY SET RX_STATUS = 0 WHERE SCAN_RX_LINK = @' +
        'SCAN_RX_LINK AND RX_STATUS <> 3;'
      #9#9#9'END;'
      #9#9#9'IF RTRIM(@MessageID) > '#39#39
      #9#9#9'BEGIN'
      
        #9#9#9#9'Update Surescripts set Rx_status = 0, RxReferenceNumber = 0,' +
        ' PatientID = 0, PrescriberID = 0,  MedicationID = 0, Atendida_po' +
        'r = '#39#39
      #9#9#9#9'where RxReferenceNumber = @NORX;'
      #9#9#9'END;'
      #9#9'end;'
      #9#9'FETCH NEXT FROM MyCursor'
      
        #9#9'INTO @NORX, @QTY, @OTC_NUMBER, @ATENDIDAPOR, @PHARMACIST, @NUM' +
        'EROCLIENTE, @PRODUCT_ID, @CLAIM_STATUS, @DRUG'
      #9'end'
      #9'CLOSE MyCursor'
      #9'DEALLOCATE MyCursor'
      '  COMMIT;'
      'END;')
    Left = 2856
    Top = 544
  end
  object UPDATE_OTC_BATCH: TFDQuery
    AfterExecute = UPDATE_OTC_BATCHAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[UPDATE_OTC_BATCH] @GUID VARCHAR(36), @OT' +
        'CNUMBER INT,'
      
        '  @RETAIL_PRICE FLOAT, @QTY FLOAT, @AWP FLOAT, @COST FLOAT, @FEC' +
        'HAOTC DATE, @DAYS_SUPPLY INT,'
      
        '  @IMPRIMIR BIT, @BATCH_REFILLREQ_DATE DATE, @GROSSAMOUNTDUE FLO' +
        'AT, @DISPENSINGFEE FLOAT,'
      
        '  @ASSOC_RX_SERVICE_DATE DATE, @ASSOC_RX_SERVICE_REF_NO NCHAR(7)' +
        ', @QTY_INTENDED_DISP INT,'
      
        '  @DAYS_SUPPLY_INTEND_DISP int, @DISPENSING_STATUS char(1), @LOT' +
        'E CHAR(12), @FECHA_EXPI DATE,'
      
        '  @ATENDIDAPOR CHAR(3), @INSTANCIA INT, @DAW SMALLINT, @OTHERCOV' +
        'ERAGECODE CHAR(1), '
      '  @PRODUCTSERVIDQUAL char(2)'
      'AS'
      'DECLARE @NOREFILL INTEGER '
      'DECLARE @RX_STATUS CHAR(1)'
      'DECLARE @NEW_TIME_RX DATETIME'
      'DECLARE @NORX BIGINT'
      'DECLARE @DISPENSED_QTY FLOAT;'
      'DECLARE @MAXOTCNUMBER INT;'
      'DECLARE @QTY_PRESCRIBED FLOAT;'
      'DECLARE @QTY_PREV_DISP FLOAT;'
      'DECLARE @PRODUCTNO INT;'
      'DECLARE @INV_QTY_TODATE DECIMAL(18,2);'
      'DECLARE @PLAN_MEDICO CHAR(3); '
      'BEGIN'
      '  SET NOCOUNT ON;'
      '  BEGIN TRANSACTION;  '
      
        #9'  Select @NEW_TIME_RX = cast(@FECHAOTC as datetime) + cast(CONV' +
        'ERT(VARCHAR(8),GETDATE(),108) as datetime)'
      
        #9'  SELECT @RX_STATUS = RX_STATUS, @NORX = NUMERORECETA, @PRODUCT' +
        'NO = PRODUCT_ID FROM OTC WHERE OTCNUMBER = @OTCNUMBER;'
      
        #9'  Select @INV_QTY_TODATE = QTYINVENTARIO FROM INVENTARIOPISO WH' +
        'ERE PRODUCTNO = @PRODUCTNO;'
      #9'  IF (@RX_STATUS = '#39'R'#39') or (@RX_STATUS = '#39'P'#39') '
      #9'  begin'
      
        #9#9'Select @NOREFILL = (Select count(*) from OTC where NumeroRecet' +
        'a = @NORX and RX_STATUS = '#39'R'#39' AND PLAN_MEDICO <> '#39'CAS'#39')'
      #9'  end '
      #9'  else'
      #9'  begin'
      #9#9'Select @NOREFILL = 0;'
      #9'  end; '
      
        #9'  UPDATE OTC SET GUID = @GUID, TERMINADA = 0, FECHAOTC = @FECHA' +
        'OTC,'
      
        #9'  TOTAL = @RETAIL_PRICE, PRECIOFACTURACION = @AWP, DAYS_SUPPLY ' +
        '= @DAYS_SUPPLY,'
      
        #9'  IMPRIMIR = @IMPRIMIR, CODIGOREFILLNUEVO = @NOREFILL, METRICDE' +
        'CIMALQUANTITY = (@QTY * 1000), '
      
        #9'  BATCH_REFILLREQ_DATE = GETDATE(), QTY_TEMP = @QTY, TIME_RX = ' +
        '@NEW_TIME_RX,--'#39'12/12/2019'#39
      
        #9'  GROSSAMOUNTDUE = @GROSSAMOUNTDUE, DISPENSINGFEE = @DISPENSING' +
        'FEE, COSTOVENTA = @COST,'
      
        #9'  DISPENSING_STATUS = @DISPENSING_STATUS, QTY_INTENDED_DISP = @' +
        'QTY_INTENDED_DISP,  '
      
        #9'  ASSOC_RX_SERVICE_DATE = GETDATE(), ASSOC_RX_SERVICE_REF_NO = ' +
        '@ASSOC_RX_SERVICE_REF_NO,--@ASSOC_RX_SERVICE_DATE'
      
        #9'  DAYS_SUPPLY_INTEND_DISP = @DAYS_SUPPLY_INTEND_DISP, ATENDIDOP' +
        'OR = @ATENDIDAPOR,'
      
        #9'  INSTANCIA = @INSTANCIA, RECORD_LOCKED = 1, DAW = @DAW, INV_QT' +
        'Y_TODATE = @INV_QTY_TODATE,'
      
        #9'  BATCH_NUMBER_BILLING = @INSTANCIA, FECHAEXPIRACION = @FECHA_E' +
        'XPI, LOTE = @LOTE,'
      
        #9'  OTHERCOVERAGECODE = @OTHERCOVERAGECODE, PRODUCTSERVIDQUAL = @' +
        'PRODUCTSERVIDQUAL'
      #9'  WHERE OTCNUMBER = @OTCNUMBER AND CLAIM_STATUS <> 1; '
      #9'  if ltrim(@LOTE) > '#39#39
      #9'  begin'
      
        #9#9' Update INVENTARIOPISO set LOTE = @LOTE, FECHA_EXPIRACION = @F' +
        'ECHA_EXPI WHERE PRODUCTNO = @PRODUCTNO;'
      #9'  end;'
      '  commit;'
      'END;')
    Left = 2320
    Top = 656
  end
