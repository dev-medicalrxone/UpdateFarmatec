  object SURESCRIPTS_TRANS_TYPE: TFDQuery
    AfterExecute = SURESCRIPTS_TRANS_TYPEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SURESCRIPTS_TRANS_TYPE] '
      '@RelatedMessageID VARCHAR(50),'
      
        '@TransactionType nchar(20), @RXDATA VARCHAR(MAX),  @Message_ID V' +
        'archar(50),'
      '@Number_of_Refills INT'
      'AS'
      'DECLARE @PATIENT VARCHAR(75)'
      'DECLARE @Prescriber VARCHAR(75)'
      'DECLARE @Medication varchar(81)'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @PATDOB DATE'
      'DECLARE @PrescriberOrderNumber NCHAR(35)'
      'DECLARE @RxReferenceNumber bigint'
      'DECLARE @GUID UNIQUEIDENTIFIER'
      'DECLARE @ValidDigitalSignature bit'
      'DECLARE @Substitution smallint'
      'DECLARE @Qty decimal(18,2),'
      #9'@PatientID INT=0,'
      #9'@PrescriberID INT=0,'
      #9'@MedicationID INT=0'
      #9#9
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'Begin Transaction;'
      #9'--SET @GUID = NEWID();'
      #9'--SELECT @Message_ID = REPLACE(@GUID, '#39'-'#39', '#39#39');'
      
        #9'SELECT @PATIENT = Patient, @Medication = Medication, @SPI = SPI' +
        ', @PATDOB = PatDOB, @Prescriber = Prescriber,'
      
        #9'@PrescriberOrderNumber = PrescriberOrderNumber, @RxReferenceNum' +
        'ber = RxReferenceNumber, @ValidDigitalSignature = ValidDigitalSi' +
        'gnature, @Substitution = Substitution,'
      #9'@Qty = Qty,'
      #9'@PatientID =PatientID,'
      #9'@PrescriberID =PrescriberID,'
      #9'@MedicationID=MedicationID'#9
      #9'FROM Surescripts WHERE MessageID = @RelatedMessageID'
      ''
      
        #9'Insert into Surescripts (RX_DATA, MessageID, RelatedMessageID, ' +
        'Patient, Prescriber, Medication, DateReceived, Rx_Status, SPI, P' +
        'atDOB, '
      #9'TransactionType, PrescriberOrderNumber, '
      
        #9'RxReferenceNumber, ValidDigitalSignature, NumberOfRefills, Subs' +
        'titution, Qty'#9',PatientID ,PrescriberID ,MedicationID'#9')'
      
        #9'values (@RXDATA, @MESSAGE_ID, @RelatedMessageID,  @PATIENT, @Pr' +
        'escriber, @Medication, getdate(), 3, @SPI, @PATDOB, @Transaction' +
        'Type, @PrescriberOrderNumber, '
      
        #9'@RxReferenceNumber, @ValidDigitalSignature, @Number_of_Refills,' +
        ' @Substitution, @Qty,@PatientID ,@PrescriberID ,@MedicationID);'
      #9'Commit;'
      'END;')
    Left = 3968
    Top = 464
  end
