  object GetNextSequenceNumber: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'IF not EXISTS ('
      '  SELECT 1'
      '  FROM sys.sequences'
      '  WHERE name = '#39'GetNextSequenceNumber'#39
      '    AND schema_id = SCHEMA_ID('#39'dbo'#39')  -- or your schema name'
      ')'
      'BEGIN'
      '  CREATE SEQUENCE GetNextSequenceNumber'
      '    START WITH :ID'
      '    INCREMENT BY 1;'
      'END')
    Left = 6712
    Top = 1168
    ParamData = <
      item
        Name = 'ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
  object RX_INSERT_RX_QUEUE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      ' CREATE procedure [dbo].[RX_INSERT_RX_QUEUE] @SCANNED_RX_ID int,'
      '           @PRIORITY int,'
      '           @PATIENT_ID int,'
      '           @PRESCRIBER_ID int,'
      '           @DRUG_ID int,'
      '           @QTY_PRESCRIBED decimal(18,2),'
      '           @RX_DATE date,'
      '           @SIG nchar(296),'
      '           @DAYS_SUPPLY int,'
      '           @INSURANCE_ID int,'
      '           @REFILLS int,'
      '           @TYPEIST CHAR(3),'
      '           @RXORIGINCODE INT,'
      '           @ID INT OUTPUT,'
      '           @DRUG NCHAR(35),'
      '           @REFILL_QUERY_ID INT'
      'AS'
      'declare @found int'
      'BEGIN'
      '    BEGIN TRANSACTION'
      '    Select @found = count(*) from rx_queue where ID = @ID; '
      '    if @found = 0'
      '    begin'
      '    INSERT INTO [dbo].[RX_QUEUE]'
      '           ([SCANNED_RX_ID]'
      '           ,[PRIORITY]'
      '           ,[PATIENT_ID]'
      '           ,[INSURANCE_ID]'
      '           ,[PRESCRIBER_ID]'
      '           ,[DRUG_ID]'
      '           ,[QTY_PRESCRIBED]'
      '           ,[RX_DATE]'
      '           ,[SIG]'
      '           ,[DAYS_SUPPLY]'
      '           ,[REFILLS]'
      '           ,[TYPEIST]'
      '           ,[RXORIGINCODE]'
      '           ,[DRUG]'
      '           ,[REFILL_QUERY_ID])'
      '     VALUES'
      '           (@SCANNED_RX_ID,'
      '           @PRIORITY,'
      '           @PATIENT_ID,'
      '           @INSURANCE_ID,'
      '           @PRESCRIBER_ID,'
      '           @DRUG_ID,'
      '           @QTY_PRESCRIBED, '
      '           @RX_DATE, '
      '           @SIG,'
      '           @DAYS_SUPPLY,'
      '           @REFILLS,'
      '           @TYPEIST,'
      '           @RXORIGINCODE,'
      '           @DRUG,'
      '           @REFILL_QUERY_ID);'
      '           set @ID = SCOPE_IDENTITY();'
      '    end'
      '    else'
      '    begin'
      '      UPDATE [dbo].[RX_QUEUE]'
      '      SET [PRIORITY] = @PRIORITY'
      '      ,[PATIENT_ID] = @PATIENT_ID'
      '      ,[PRESCRIBER_ID] = @PRESCRIBER_ID'
      '      ,[DRUG_ID] = @DRUG_ID'
      '      ,[QTY_PRESCRIBED] = @QTY_PRESCRIBED'
      '      ,[RX_DATE] = @RX_DATE'
      '      ,[SIG] = @SIG'
      '      ,[DAYS_SUPPLY] = @DAYS_SUPPLY'
      '      ,[INSURANCE_ID] = @INSURANCE_ID'
      '      ,[TYPEIST] = @TYPEIST'
      '      ,[RXORIGINCODE] = @RXORIGINCODE'
      '      ,[REFILLS] = @REFILLS'
      '      ,[DRUG] = @DRUG'
      '       where ID = @ID;    '
      '    end;'
      
        '    Update REFILL_QUERY set PRIORITY =  @PRIORITY where SCAN_RX_' +
        'LINK = @SCANNED_RX_ID;'
      '    COMMIT;'
      'END;')
    Left = 6504
    Top = 1064
  end
  object RX_QUEUE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'RX_QUEUE' +
        #39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[RX_QUEUE]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[SCANNED_RX_ID] [int] NULL,'
      #9'[PRIORITY] [int] NULL,'
      #9'[PATIENT_ID] [int] NULL,'
      #9'[PRESCRIBER_ID] [int] NULL,'
      #9'[DRUG_ID] [int] NULL,'
      #9'[QTY_PRESCRIBED] [decimal](18, 2) NULL,'
      #9'[RX_DATE] [date] NULL,'
      #9'[SIG] [nchar](296) NULL,'
      #9'[DAYS_SUPPLY] [int] NULL,'
      #9'[INSURANCE_ID] [int] NULL,'
      #9'[REFILLS] [int] NULL,'
      #9'[TYPEIST] [nchar](3) NULL,'
      #9'[RXORIGINCODE] [int] NULL,'
      #9'[DRUG] [nchar](35) NULL,'
      ' CONSTRAINT [PK_RX_QUEUE] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRI' +
        'MARY]'
      ') ON [PRIMARY]'
      'END;')
    Left = 6688
    Top = 1272
  end
  object RX_QUEUE_ADD_NEWRX: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[RX_QUEUE_ADD_NEWRX] @PATIENT_ID INT, @PR' +
        'ESCRIBER_ID INT, @WF_TYPED NCHAR(30), '
      
        '@INSTANCIA INT, @RXDATE DATE, @LEVELOFSERVICE INT, @GUID VARCHAR' +
        '(36) OUTPUT, @PRICE_TABLE_ID int'
      'AS'
      'DECLARE @PAT_NOPLAN INT '
      'DECLARE @BATCH_NUMBER_LOCAL INT '
      'DECLARE @MEDICATION_ID INT'
      'DECLARE @NPI NCHAR(15)'
      'DECLARE @PRESCRIBER_ID_QUALIFIER CHAR(2)'
      'DECLARE @MESSAGE_ID VARCHAR(40)'
      'DECLARE @SPI NCHAR(13)'
      'DECLARE @QTY DECIMAL(18,2)'
      'DECLARE @Substitution smallint'
      'DECLARE @NumberOfRefills INT'
      'DECLARE @Medication VARCHAR(30)'
      'DECLARE @COMPOUND INT'
      'DECLARE @NDC CHAR(11)'
      'DECLARE @DAYSSUPPLY INT'
      'DECLARE @ETIQUETA NCHAR(296)'
      'DECLARE @SIG NCHAR(296)'
      'DECLARE @Atendida_por NCHAR(3)'
      'DECLARE @LOTE CHAR(12)'
      'DECLARE @FACILITY_ID INT'
      'DECLARE @CLAIM_STATUS INT'
      'DECLARE @PLANMEDICO CHAR(3)'
      'DECLARE @PLANES_MEDICOS_NO INT'
      'DECLARE @TERMINADA BIT'
      'DECLARE @NUMEROAUTO CHAR(20)'
      'DECLARE @FECH_EXPI DATE'
      'DECLARE @ALCHAMY_ID INT'
      'DECLARE @marketedproductid int;'
      'DECLARE @LABELSCODENO INT'
      'DECLARE @NORX_LOCAL BIGINT'
      'DECLARE @OTCNUMBER_LOCAL INT'
      'DECLARE @UNIT_PRICE DECIMAL(18,2)'
      'DECLARE @Retail_Price DECIMAL(18,2)'
      'DECLARE @Usual_Customary DECIMAL(18,2)'
      'DECLARE @Cost_ DECIMAL(18,2)'
      'DECLARE @Billing_Price DECIMAL(18,2)'
      'DECLARE @DISPENSINGFEE DECIMAL(18,2)'
      'DECLARE @GrossAmount_Due DECIMAL(18,2)'
      'DECLARE @Metric_Quantity DECIMAL(18,2)'
      'DECLARE @Metric_DecimalQuantity DECIMAL(18,2)'
      'DECLARE @NO_HORA INT'
      'DECLARE @NO_RECORDS INT'
      'DECLARE @CONTROLLED CHAR(4) '
      'DECLARE @ISCONTROLLED BIT'
      'DECLARE @EXTRA_INFO VARCHAR(MAX)'
      'DECLARE @OTC_DATE VARCHAR(10)'
      'DECLARE @STRENGTH CHAR(25)'
      'DECLARE @ADHERENCE BIT'
      'DECLARE @DELIVERY BIT'
      'DECLARE @ENFORCE_ORIGIN_CODES BIT'
      'DECLARE @SCHEDULE_RX_ID_NO NCHAR(12)'
      'DECLARE @RELATED_OTC_NUMBER INT = 0'
      'DECLARE @PRODUCTSERVIDQUAL CHAR(2)'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9#9'set @PAT_NOPLAN = 0;'
      
        #9#9'SELECT @ENFORCE_ORIGIN_CODES = isNull(ENFORCE_ORIGIN_CODES,0) ' +
        'FROM CREDITDEBITSETUP;'
      #9#9'IF @ENFORCE_ORIGIN_CODES = 1 '
      #9#9'  set @SCHEDULE_RX_ID_NO = '#39'EEEEEEEE'#39
      #9#9'else'
      #9#9'  set @SCHEDULE_RX_ID_NO = '#39#39';'
      #9#9'SELECT @NO_HORA = FORMAT(getdate(), '#39'HH'#39');'
      ''
      
        #9#9'SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = isnull(NUMEROPL' +
        'AN,0),'
      #9#9'@PLANES_MEDICOS_NO = PLANESMEDICOSNO'
      
        #9#9'FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND INSURANCE_I' +
        'NDEX = 1;'#9#9
      #9#9'if @PAT_NOPLAN = 0'
      #9#9'begin'#9#9'  '
      
        #9#9#9'SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = isnull(NUMEROP' +
        'LAN,0) FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND PLANME' +
        'DICO <> '#39'CAS'#39' and ACTIVO = 1;'
      #9#9'end;'
      #9#9'if @PAT_NOPLAN = 0'
      #9#9'begin'
      
        #9#9#9'SELECT @PLANMEDICO = PLANMEDICO, @PAT_NOPLAN = isnull(NUMEROP' +
        'LAN,0) FROM PATPLAN WHERE NUMEROCLIENTE = @PATIENT_ID AND PLANME' +
        'DICO = '#39'CAS'#39'; '
      #9#9'end;'
      #9#9'IF @PLANMEDICO = '#39'CAS'#39' '
      #9#9'begin'
      #9#9'  SET @CLAIM_STATUS = 0;'
      #9#9'  SET @TERMINADA = 1;'
      #9#9'  SET @NUMEROAUTO = '#39'N/A'#39';'
      #9#9'end'
      #9#9'else'
      #9#9'begin'
      #9#9'  SET @CLAIM_STATUS = 5;'
      #9#9'  SET @TERMINADA = 0;'
      #9#9'  SET @NUMEROAUTO = '#39#39';'#9'  '
      #9#9'end;'
      
        #9#9'--SELECT @PLANES_MEDICOS_NO = ISNULL(PLANESMEDICOSNO,0) FROM P' +
        'LANESMEDICOS WHERE ABREVIATURA = @PLANMEDICO;'
      
        #9#9'SELECT @FACILITY_ID = FACILITY_ID, @ADHERENCE = ISNULL(ADHEREN' +
        'CE,0), @DELIVERY = ISNULL(DELIVERY,0) FROM PACIENTES WHERE NUMER' +
        'OCLIENTE = @PATIENT_ID;'
      #9#9'if (@LEVELOFSERVICE = 2) '
      #9#9'begin'
      #9#9'  set @DELIVERY = 1;'
      #9#9'end;'
      
        #9#9'SELECT @NPI = NPI, @PRESCRIBER_ID_QUALIFIER = PRESCRIBER_ID_QU' +
        'ALIFIER FROM DOCTOR WHERE NUMERODOCTOR = @PRESCRIBER_ID;'
      #9#9'if @GUID  = '#39#39
      #9#9'begin'
      #9#9'  SELECT @GUID = NEWID();  '#9
      #9#9'end'#9
      
        #9#9'DECLARE MyCursor CURSOR FOR SELECT DRUG_ID, QTY_PRESCRIBED, RE' +
        'FILLS, DAYS_SUPPLY, TYPEIST'
      #9#9'from RX_QUEUE where Patient_ID = @PATIENT_ID;'
      #9#9'OPEN MyCursor'
      #9#9'FETCH NEXT FROM MyCursor'
      
        #9#9'INTO @MEDICATION_ID, @QTY, @NumberOfRefills, @DAYSSUPPLY, @Ate' +
        'ndida_por'
      #9#9'WHILE @@FETCH_STATUS = 0'
      #9#9'BEGIN'#9'    '
      
        #9#9#9'SELECT @ETIQUETA = ETIQUETA, @SIG = SIG, @LABELSCODENO = LABE' +
        'LCODESNO FROM SurescriptsRX_LABEL WHERE MessageID = @MESSAGE_ID;'
      
        #9#9#9'SELECT @Medication = UPPER(substring(DESCRIPCION,1,30)), @STR' +
        'ENGTH = STRENGTH, @NDC = NDC, @LOTE = LOTE, @FECH_EXPI = FECHA_E' +
        'XPIRACION, '
      
        #9#9#9'@ALCHAMY_ID = ALCHEMY_PRODUCTID, @marketedproductid = isnull(' +
        'marketedproductid,0), '
      
        #9#9#9'@CONTROLLED = CONTROLADO, @PRODUCTSERVIDQUAL = ISNULL(PRODUCT' +
        'SERVIDQUAL,03) FROM INVENTARIOPISO WHERE PRODUCTNO = @MEDICATION' +
        '_ID;'
      #9#9#9'IF rtrim(@STRENGTH) > '#39#39
      #9#9#9'begin'
      
        #9#9#9'  Set @Medication = CONCAT(rtrim(@Medication), '#39' '#39', rtrim(@ST' +
        'RENGTH));  '
      #9#9#9'  --Set @Medication = SUBSTRING(@Medication, 1,30); '
      #9#9#9'end;'
      #9#9#9'IF (RTRIM(@CONTROLLED) = '#39'RX'#39') or'
      #9#9#9'(RTRIM(@CONTROLLED) = '#39'OTC'#39') or'
      
        #9#9#9'(RTRIM(@CONTROLLED) = '#39'DME'#39') SET @ISCONTROLLED = 0 ELSE SET @' +
        'ISCONTROLLED = 1;'
      #9#9#9'SET @COMPOUND = 1;'
      #9#9#9'IF @NDC = '#39'00000000000'#39' '
      #9#9#9'begin'
      #9#9#9'  SET @COMPOUND = 2;'
      #9#9#9'end;'
      #9#9#9
      #9#9#9'INSERT INTO PRESCRIPTIONS (NUMEROCLIENTE, NUMERODOCTOR, '
      #9#9#9'NUMEROREFILLSAUTORIZADOS, MEDICAMENTO, PRESCRIBERIDQUALIFIER,'
      
        #9#9#9'MessageID, FECHARECETA, CANTIDADRECETADA, COMPOUNDCODE, PRODU' +
        'CT_ID,'
      
        #9#9#9'NDC, LABELCODESNO, ETIQUETA, SIG, DAYS_SUPPLY, GUID, INFORMAC' +
        'ION_EXT,'
      
        #9#9#9'RXORIGINCODE, SCANED_RX_LINK, LICENCIA, SPI, schedule_rx_id_n' +
        'o) '
      #9#9#9'VALUES '
      #9#9#9'(@PATIENT_ID, @PRESCRIBER_ID, '
      #9#9#9'@NumberOfRefills, @Medication, @PRESCRIBER_ID_QUALIFIER, '
      #9#9#9'@MESSAGE_ID, @RXDATE, @QTY, @COMPOUND, @MEDICATION_ID,'
      
        #9#9#9'@NDC, @LABELSCODENO, @ETIQUETA, @SIG, @DAYSSUPPLY, @GUID, @EX' +
        'TRA_INFO, '
      #9#9#9'1, 0, @NPI, @SPI, @SCHEDULE_RX_ID_NO);'
      #9#9#9'SET @NORX_LOCAL=SCOPE_IDENTITY();'
      #9#9#9'if @NORX_LOCAL is null '
      #9#9#9'begin'
      
        #9#9#9'  Select @NORX_LOCAL = NUMERORECETA FROM PRESCRIPTIONS WHERE ' +
        'NUMEROCLIENTE = @PATIENT_ID AND MessageID = @MESSAGE_ID;'
      ' '#9#9#9'end;'
      #9#9#9'/* PRICE SECTION */'
      
        #9#9#9'EXEC dbo.RX_CALCULATE_PRICE 0, @MEDICATION_ID, @QTY, @PRICE_T' +
        'ABLE_ID, '
      #9#9#9'@UnitPrice = @UNIT_PRICE OUTPUT, '
      #9#9#9'@RetailPrice = @Retail_Price OUTPUT,'
      #9#9#9'@UsualCustomary = @Usual_Customary OUTPUT,'
      #9#9#9'@Cost = @Cost_ OUTPUT,'
      #9#9#9'@MetricQuantity = @Metric_Quantity,'
      #9#9#9'@MetricDecimalQuantity = @Metric_DecimalQuantity OUTPUT, '
      #9#9#9'@BillingPrice = @Billing_Price OUTPUT,'
      #9#9#9'@Disp_Fee = @DISPENSINGFEE OUTPUT,'
      #9#9#9'@GossAmountDue = @GrossAmount_Due OUTPUT;'
      
        #9#9#9'if @PLANMEDICO = '#39'CAS'#39' Select @Usual_Customary = @Retail_Pric' +
        'e;'
      #9#9#9'/* */'
      #9#9#9'SELECT @OTC_DATE = CONVERT(VARCHAR, GETDATE(), 101);'
      
        #9#9#9'EXEC INSERT_OTC @NDC, @MEDICATION, @Usual_Customary, @Atendid' +
        'a_por, '#39'F'#39', @OTC_DATE, @NORX_LOCAL, '#39#39', @Cost_, @QTY, @PATIENT_I' +
        'D, '#39#39',0,0,0,'
      
        #9#9#9'@NUMEROAUTO,'#39#39','#39'N'#39',0,0,0,0,0,0,0,'#39#39',@DAYSSUPPLY, '#39'F'#39', @Billin' +
        'g_Price, @PLANMEDICO, @MEDICATION_ID,@NO_HORA, @PAT_NOPLAN, @LOT' +
        'E, '#39'01/01/2020'#39', '
      
        #9#9#9'@PRICE_TABLE_ID,'#39#39',@WF_TYPED, 0, @FACILITY_ID, 0, 0, @BATCH_N' +
        'UMBER_LOCAL, '
      
        #9#9#9'@INSTANCIA, 1,@GrossAmount_Due, 0, '#39#39', 0, @CLAIM_STATUS, @TER' +
        'MINADA, @FECH_EXPI, @DISPENSINGFEE,'#39#39','#39#39', @Substitution,'#39'0'#39','
      
        #9#9#9'@ALCHAMY_ID, @marketedproductid, @PLANES_MEDICOS_NO, @MESSAGE' +
        '_ID, @OTCCurrent_Identity = @OTCNUMBER_LOCAL OUTPUT, '
      
        #9#9#9'@ADHERENCE = @ADHERENCE, @DELIVERY = @DELIVERY, @LEVEL_OF_SER' +
        'VICE = @LEVELOFSERVICE, @GUID = @GUID, @UNIT_PRICE = @UNIT_PRICE' +
        ','
      
        #9#9#9'@RELATED_OTC_NUMBER = @RELATED_OTC_NUMBER, @PRODUCTSERVIDQUAL' +
        ' = @PRODUCTSERVIDQUAL;'
      
        #9#9#9'EXECUTE INSERT_LOG '#39'New Rx Pre-Annotated'#39', '#39'A'#39', @NDC, @Atendi' +
        'da_por,  '#39#39', @NORX_LOCAL, @OTCNUMBER_LOCAL, @PRESCRIBER_ID, @PAT' +
        'IENT_ID,0,0,0,@MEDICATION_ID,'#39'R'#39',@MEDICATION ,@ISCONTROLLED,1;'
      #9#9#9'FETCH NEXT FROM MyCursor'
      
        #9#9#9'INTO @MEDICATION_ID, @QTY, @NumberOfRefills, @DAYSSUPPLY, @At' +
        'endida_por'
      #9#9'END'
      #9#9'CLOSE MyCursor'
      #9#9'DEALLOCATE MyCursor'#9
      #9#9'DELETE FROM RX_QUEUE WHERE PATIENT_ID = @PATIENT_ID;'
      #9#9'DELETE FROM REFILL_QUERY WHERE PATIENT_ID = @PATIENT_ID;'
      ''
      #9'commit;'
      'END;')
    Left = 6696
    Top = 1352
  end
