  object SurescriptsRX_LABEL_INSERT_EDIT: TFDQuery
    AfterExecute = SurescriptsRX_LABEL_INSERT_EDITAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[SurescriptsRX_LABEL_INSERT_EDIT]'
      
        '   @MESSAGEID VARCHAR(50), @SIG NCHAR(296), @ETIQUETA NCHAR(296)' +
        ',  @LABELCODESNO INT,'
      '   @DAYS_SUPPLY INT, @UPDATE_DAYS_SUPPY BIT'
      'AS'
      'DECLARE @NoRecords int'
      'BEGIN'
      '  begin transaction'
      
        #9'  Select @NoRecords = count(*) from SurescriptsRX_LABEL WHERE M' +
        'essageID = @MESSAGEID; '
      #9'  IF @NoRecords > 0'
      
        #9#9'Update SurescriptsRX_LABEL set LABELCODESNO = @LABELCODESNO, S' +
        'IG = @SIG, ETIQUETA = @ETIQUETA WHERE MessageID = @MESSAGEID'
      #9'  ELSE'
      
        #9#9'Insert into SurescriptsRX_LABEL (MessageID, ETIQUETA, SIG, LAB' +
        'ELCODESNO) values (@MESSAGEID, @ETIQUETA,  @SIG, @LABELCODESNO);'
      #9'  IF @UPDATE_DAYS_SUPPY = 1'
      #9'  BEGIN'
      
        #9'    Update Surescripts set DaysSupply = @DAYS_SUPPLY where Mess' +
        'ageID = @MESSAGEID;'
      #9'  END;'
      
        #9'  delete from SurescriptsRX_LABEL where date_created < getdate(' +
        ')-2;'
      '  commit;'
      'END;')
    Left = 3968
    Top = 752
  end
  object EXPORT_TO_RXTEMP1: TFDQuery
    AfterExecute = EXPORT_TO_RXTEMP1AfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[EXPORT_TO_RXTEMP1] '
      ' @NUMERORECETA BIGINT, @OTCNUMBER INT, @TRANS_TYPE CHAR(11), '
      ' @USER CHAR(3), '
      ' @FECHAOTC DATE, @QTY FLOAT, '
      ' @PARTIAL_COMPLETION CHAR(1), @RX_STATUS CHAR(1),'
      ' @PHARMACIST CHAR(3), '
      ' @MEZCLA_TRAN_NO INT, @ShowMarketStatus bit, '
      ' @ForBilling bit,'
      
        ' @FECHA_ULTIMO_REFILL BIT, -- NOTE: verify this matches INSERT_O' +
        'TC parameter type (name suggests DATE but it'#39's BIT)'
      
        ' @CAN_CONTINUE BIT OUTPUT, @CAN_CONTINUE_MESSAGE CHAR(100) OUTPU' +
        'T,  '
      ' @INSTANCIA INT,'
      ' @DEDUCIBLE float OUTPUT,'
      ' @GUID Varchar(36) OUTPUT,'
      ' @BATCH_NUMBER_BILLING INT,'
      ' @NEW_OTCNUMBER INT OUTPUT,'
      ' @ERROR_NO int output,'
      ' @PREVOTCNUMBER INT OUTPUT, '
      ' @CLAIM_STATUS INT OUTPUT'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      
        '    -- Initialize OUTPUTs to avoid caller-side NULL rendering is' +
        'sues'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT'
      '        @CAN_CONTINUE = 0,'
      '        @CAN_CONTINUE_MESSAGE = '#39#39','
      '        @DEDUCIBLE = 0,'
      '        @NEW_OTCNUMBER = 0,'
      '        @ERROR_NO = 0,'
      '        @PREVOTCNUMBER = 0,'
      '        @CLAIM_STATUS = 0;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Local variables'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    DECLARE @NUMEROTRANSACCION INT;'
      '    DECLARE @MEDICAMENTOMIX CHAR(120);'
      '    DECLARE @COST_ FLOAT;'
      '    DECLARE @PRECIO_FACTURACION FLOAT;'
      '    DECLARE @MAXOTC_NUMBER INT;'
      '    DECLARE @COMPOUNDCODE INT;'
      '    DECLARE @FACILITY_ID INT;'
      '    DECLARE @NDC NCHAR(11);'
      '    DECLARE @MEDICAMENTO NCHAR(30);'
      '    DECLARE @NO_HORA CHAR(2);'
      '    DECLARE @LOTE CHAR(12);'
      '    DECLARE @WF_TYPED NCHAR(30);'
      '    DECLARE @ACTIVE_RX BIT;'
      '    DECLARE @QTY_PRESCRIBED DECIMAL(18,2);'
      '    DECLARE @MARKET_STATUS CHAR(10);'
      '    DECLARE @OTC_QTY DECIMAL(18,2);'
      '    DECLARE @NO_REF_AUTO INT;'
      '    DECLARE @CURRENT_REFILL INT;'
      '    DECLARE @TTransRefill INT;'
      '    DECLARE @PLAN_NAME VARCHAR(15);'
      '    DECLARE @CONTROLADO CHAR(4);'
      '    DECLARE @RXDATE DATE;'
      '    DECLARE @RX_EXPIRATION_DAYS int;'
      '    DECLARE @RX_CONTROLED_EXPIRATION_DAYS int;'
      '    DECLARE @INV_PRICE FLOAT;'
      '    DECLARE @INV_COST FLOAT;'
      '    DECLARE @INV_METRIC_SIZE DECIMAL(18,2);'
      '    DECLARE @INV_RBP FLOAT;'
      '    DECLARE @NUMERODOCTOR INT;'
      '    DECLARE @CANTIDAD_DISPONIBLE DECIMAL(18,2);'
      '    DECLARE @DRUGNAME CHAR(35);'
      '    DECLARE @FECHAEXPIRACION DATETIME;'
      '    DECLARE @DISPENSINGFEE FLOAT;'
      '    DECLARE @DAW INT;'
      '    DECLARE @ALCHEMY_PRODUCTID INT;'
      '    DECLARE @MESSAGEID NCHAR(40);'
      '    DECLARE @UNIT_PRICE FLOAT;'
      '    DECLARE @GrossAmount_Due FLOAT;'
      '    DECLARE @Metric_Quantity FLOAT;'
      '    DECLARE @Metric_DecimalQuantity FLOAT;'
      '    DECLARE @Billing_Price FLOAT;'
      '    DECLARE @Retail_Price FLOAT;'
      '    DECLARE @Usual_Customary FLOAT;'
      '    DECLARE @PaperClaim bit;'
      '    DECLARE @BatchNumber int;'
      '    DECLARE @TQTY_ FLOAT;'
      '    DECLARE @TAWP_ FLOAT;'
      '    DECLARE @TRetailPrice_ FLOAT;'
      '    DECLARE @COMPDOSAGE_FORM_DESC_CODE CHAR(2);'
      '    DECLARE @COMPDISP_UNIT_FORM_INDI CHAR(1);'
      '    DECLARE @COMPROUTE_OF_ADMINISTRATION CHAR(2);'
      '    DECLARE @COMPING_COMP_COUNT INT;'
      '    DECLARE @OTHERAMOUNTCLAIMEDSUBCOUNT_ INT;'
      '    DECLARE @OTAMCLDSUBCOUNTQUAL_ CHAR(2);'
      '    DECLARE @OTHERAMOUNTCLAIMEDSUB_ FLOAT;'
      '    DECLARE @ACTIVE_INVENTORY_PRODUCT_STATUS char(1);'
      '    DECLARE @QTY_TEMP FLOAT;'
      '    DECLARE @PRICE_QTY FLOAT;'
      '    DECLARE @PLAN_MEDICO CHAR(3);'
      '    DECLARE @PLAN_MEDICO_NO INT;'
      '    DECLARE @PAT_NO_PLAN INT;'
      '    DECLARE @DAYS_SUPPLY INT;'
      '    DECLARE @NUMEROCLIENTE INT;'
      '    DECLARE @PRODUCT_ID INT;'
      '    DECLARE @NUMEROPLAN INT;'
      '    DECLARE @PRICE_TABLE_ID INT;'
      '    DECLARE @BIN_NUMBER CHAR(6);'
      '    DECLARE @COB_NOTRANS INT;'
      '    DECLARE @OTHERCOVERAGECODE CHAR(1);'
      '    DECLARE @ADHERENCE BIT;'
      '    DECLARE @DELIVERY BIT;'
      '    DECLARE @GUID2 VARCHAR(36);'
      '    DECLARE @OTC_NO2 INT;'
      '    DECLARE @COPAY_BIN_NUMBER CHAR(6);'
      '    DECLARE @marketedproductid int;'
      '    DECLARE @PAGO_PLAN FLOAT;'
      '    DECLARE @LTC BIT;'
      '    DECLARE @LTC_USER BIT;'
      '    DECLARE @PRODUCTSERVIDQUAL CHAR(2);'
      '    DECLARE @PRODUCTSERVIDQUAL_INV CHAR(2);'
      '    DECLARE @COB_COUNT INT;'
      '    DECLARE @NEW_RECORD BIT;'
      '    DECLARE @340B BIT;'
      '    DECLARE @MAXOTC_NUMBER_SECONDARY INT;'
      '    DECLARE @MedRestrict_ID INT;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- GUID output null/blank safe'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF NULLIF(LTRIM(RTRIM(ISNULL(@GUID,'#39#39'))), '#39#39') IS NULL'
      '    BEGIN'
      '        SELECT @GUID = CONVERT(VARCHAR(36), NEWID());'
      '    END;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Setup reads'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT '
      
        '        @RX_CONTROLED_EXPIRATION_DAYS = ISNULL(RX_CONTROLED_EXPI' +
        'RATION_DAYS,0),'
      
        '        @RX_EXPIRATION_DAYS          = ISNULL(RX_EXPIRATION_DAYS' +
        ',0)'
      '    FROM CREDITDEBITSETUP;'
      ''
      '    SELECT @MAXOTC_NUMBER = MAX(OTCNumber)'
      '    FROM OTC'
      '    WHERE NumeroReceta = @NUMERORECETA'
      '      AND RX_STATUS <> '#39'C'#39
      '      AND PLAN_MEDICO <> '#39'CAS'#39';'
      ''
      '    -- Guard: no OTC record found'
      '    IF @MAXOTC_NUMBER IS NULL'
      '    BEGIN'
      '        SET @ERROR_NO = 901;'
      '        SET @CAN_CONTINUE = 0;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'No active OTC record found ' +
        'for this prescription.'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    SET @PREVOTCNUMBER = @MAXOTC_NUMBER;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Load from OTC (fix wrong ISNULL defaults)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT '
      '        @QTY                       = ISNULL(QTY,0),'
      '        @OTC_QTY                   = ISNULL(QTY,0),'
      '        @QTY_TEMP                  = ISNULL(QTY_TEMP,0),'
      '        @MEDICAMENTO               = ISNULL(MEDICAMENTO,'#39#39'),'
      
        '        @COMPDOSAGE_FORM_DESC_CODE = ISNULL(COMPDOSAGE_FORM_DESC' +
        '_CODE,'#39#39'),'
      '        @PLAN_MEDICO               = ISNULL(PLAN_MEDICO,'#39#39'),'
      '        @PLAN_MEDICO_NO            = ISNULL(PLANESMEDICOSNO,0),'
      
        '        @COMPDISP_UNIT_FORM_INDI   = ISNULL(COMPDISP_UNIT_FORM_I' +
        'NDI,'#39#39'),'
      
        '        @COMPROUTE_OF_ADMINISTRATION = ISNULL(COMPROUTE_OF_ADMIN' +
        'ISTRATION,'#39#39'),'
      
        '        @COMPING_COMP_COUNT        = ISNULL(COMPING_COMP_COUNT,0' +
        '),'
      '        @DEDUCIBLE                 = ISNULL(DEDUCIBLE,0),'
      '        @MEDICAMENTOMIX            = ISNULL(MEDICAMENTOMIX,'#39#39'),'
      
        '        @CLAIM_STATUS              = ISNULL(CLAIM_STATUS,0),  --' +
        ' FIX: was ISNULL(...,'#39#39')'
      '        @PAT_NO_PLAN               = ISNULL(NUMEROPLAN,0),'
      '        @DAYS_SUPPLY               = ISNULL(DAYS_SUPPLY,0),'
      '        @NUMEROCLIENTE             = ISNULL(NUMEROCLIENTE,0),'
      '        @PRODUCT_ID                = ISNULL(PRODUCT_ID,0),'
      '        @PRICE_TABLE_ID            = ISNULL(PRICE_TABLE_ID,0),'
      '        @PAGO_PLAN                 = ISNULL(PAGO_PLAN,0),'
      '        @DAW                       = ISNULL(DAW,0),'
      
        '        @marketedproductid         = ISNULL(MARKETEDPRODUCTID,0)' +
        ','
      '        @FACILITY_ID               = ISNULL(FACILITY_ID,0),'
      
        '        @PRODUCTSERVIDQUAL         = ISNULL(PRODUCTSERVIDQUAL,'#39'0' +
        '3'#39'),'
      '        @MedRestrict_ID            = ISNULL(MedRestrict_ID,0)'
      '    FROM OTC'
      '    WHERE OTCNUMBER = @MAXOTC_NUMBER;'
      ''
      '    -- Guard: essential fields'
      
        '    IF @NUMEROCLIENTE IS NULL OR @NUMEROCLIENTE = 0 OR @PRODUCT_' +
        'ID IS NULL OR @PRODUCT_ID = 0'
      '    BEGIN'
      '        SET @ERROR_NO = 902;'
      '        SET @CAN_CONTINUE = 0;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'OTC record is missing patie' +
        'nt or product information.'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF @PLAN_MEDICO_NO = 0'
      '    BEGIN'
      '        SELECT @PLAN_MEDICO_NO = ISNULL(planesmedicosno,0)'
      '        FROM PLANESMEDICOS'
      '        WHERE ABREVIATURA = @PLAN_MEDICO;'
      ''
      '        UPDATE OTC'
      '        SET PLANESMEDICOSNO = @PLAN_MEDICO_NO'
      '        WHERE NUMERORECETA = @NUMERORECETA;'
      '    END;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      
        '    -- COPAY / Secondary branch (keep logic; make sure types are' +
        ' safe)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF (@TRANS_TYPE = '#39'COPAY'#39') OR (@TRANS_TYPE = '#39'Secondary'#39')'
      '    BEGIN'
      '        SET @RX_STATUS = '#39'C'#39';'
      ''
      '        IF @DEDUCIBLE > 0'
      '        BEGIN'
      '            SET @TRANS_TYPE = '#39'COPAY'#39';'
      '            SET @OTHERCOVERAGECODE = '#39'8'#39';'
      '        END'
      '        ELSE'
      '        BEGIN'
      '            SET @OTHERCOVERAGECODE = '#39'3'#39';'
      '        END;'
      ''
      '        SELECT @COPAY_BIN_NUMBER = ISNULL(BINNUMBER,'#39#39')'
      '        FROM PLANESMEDICOS'
      '        WHERE PLANESMEDICOSNO = @PLAN_MEDICO_NO;'
      ''
      '        SELECT @OTC_NO2 = MAX(OTCNUMBER)'
      '        FROM OTC'
      '        WHERE NUMERORECETA = @NUMERORECETA'
      '          AND RX_STATUS = '#39'C'#39';'
      ''
      '        IF @OTC_NO2 > 0'
      '        BEGIN'
      '            SELECT '
      
        '                @MEDICAMENTO               = ISNULL(MEDICAMENTO,' +
        #39#39'),'
      
        '                @COMPDOSAGE_FORM_DESC_CODE = ISNULL(COMPDOSAGE_F' +
        'ORM_DESC_CODE,'#39#39'),'
      
        '                @PLAN_MEDICO               = ISNULL(PLAN_MEDICO,' +
        #39#39'),'
      
        '                @PLAN_MEDICO_NO            = ISNULL(PLANESMEDICO' +
        'SNO,0),'
      
        '                @COMPDISP_UNIT_FORM_INDI   = ISNULL(COMPDISP_UNI' +
        'T_FORM_INDI,'#39#39'),'
      
        '                @COMPROUTE_OF_ADMINISTRATION = ISNULL(COMPROUTE_' +
        'OF_ADMINISTRATION,'#39#39'),'
      
        '                @COMPING_COMP_COUNT        = ISNULL(COMPING_COMP' +
        '_COUNT,0),'
      
        '                @MEDICAMENTOMIX            = ISNULL(MEDICAMENTOM' +
        'IX,'#39#39'),'
      
        '                @CLAIM_STATUS              = ISNULL(CLAIM_STATUS' +
        ',0), -- FIX'
      
        '                @PAT_NO_PLAN               = ISNULL(NUMEROPLAN,0' +
        '),'
      
        '                @DAYS_SUPPLY               = ISNULL(DAYS_SUPPLY,' +
        '0),'
      
        '                @NUMEROCLIENTE             = ISNULL(NUMEROCLIENT' +
        'E,0),'
      
        '                @PRODUCT_ID                = ISNULL(PRODUCT_ID,0' +
        '),'
      
        '                @PRICE_TABLE_ID            = ISNULL(PRICE_TABLE_' +
        'ID,0),'
      '                @DAW                       = ISNULL(DAW,0)'
      '            FROM OTC'
      '            WHERE OTCNUMBER = @OTC_NO2;'
      '        END;'
      '    END;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Plan header'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT '
      '        @PLAN_NAME  = ISNULL(NOMBRE,'#39#39'),'
      '        @PaperClaim = ISNULL(PAPER_CLAIM,0),'
      '        @BIN_NUMBER = ISNULL(BINNUMBER,'#39#39')'
      '    FROM PLANESMEDICOS'
      '    WHERE PLANESMEDICOSNO = @PLAN_MEDICO_NO;'
      ''
      '    IF @PLAN_MEDICO <> '#39'CAS'#39
      '        SELECT @TTransRefill = COUNT(*)'
      '        FROM OTC'
      '        WHERE NumeroReceta = @NUMERORECETA'
      '          AND CLAIM_STATUS = 1'
      '          AND RX_STATUS = '#39'R'#39
      '          AND PLAN_MEDICO <> '#39'CAS'#39';'
      '    ELSE'
      '        SELECT @TTransRefill = COUNT(*)'
      '        FROM OTC'
      '        WHERE NumeroReceta = @NUMERORECETA'
      '          AND RX_STATUS = '#39'R'#39';'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      
        '    -- Load from PRESCRIPTIONS (fix COMPOUNDCODE default + 340B ' +
        'default)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT '
      
        '        @COMPOUNDCODE        = ISNULL(COMPOUNDCODE,0),   -- FIX:' +
        ' was ISNULL(...,'#39#39')'
      '        @ACTIVE_RX           = ISNULL(ACTIVE,0),'
      '        @QTY_PRESCRIBED      = ISNULL(CANTIDADRECETADA,0),'
      
        '        @NO_REF_AUTO         = ISNULL(NUMEROREFILLSAUTORIZADOS,0' +
        '),'
      '        @RXDATE              = FECHARECETA,'
      '        @NUMERODOCTOR        = ISNULL(NUMERODOCTOR,0),'
      '        @CANTIDAD_DISPONIBLE = ISNULL(CANTIDAD_DISPONIBLE,0),'
      '        @MESSAGEID           = ISNULL(MESSAGEID,'#39#39'),'
      '        @LTC                 = ISNULL(LTC,0),'
      
        '        @340B                = ISNULL(F340B,0)           -- FIX:' +
        ' ensure default'
      '    FROM PRESCRIPTIONS'
      '    WHERE NumeroReceta = @NUMERORECETA;'
      ''
      
        '    -- Guard: prescription not found (RXDATE will be NULL if no ' +
        'row)'
      '    IF @RXDATE IS NULL'
      '    BEGIN'
      '        SET @ERROR_NO = 904;'
      '        SET @CAN_CONTINUE = 0;'
      '        SET @CAN_CONTINUE_MESSAGE = '#39'Prescription not found.'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    SET @CURRENT_REFILL = 0;'
      ''
      '    IF @RXDATE > GETDATE()'
      '    BEGIN'
      '        SET @ERROR_NO = 1;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Warning! Post dated prescri' +
        'ptions can not be billed.'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    SELECT @LTC_USER = ISNULL(LTC,0)'
      '    FROM PASSWORDS'
      '    WHERE INICIALES = @USER;'
      ''
      '    IF (@LTC = 1) AND (@LTC_USER = 0)'
      '    BEGIN'
      '        SET @ERROR_NO = 1;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'User not authorazied for LT' +
        'C billing!'#39';'
      '        RETURN;'
      '    END;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      
        '    -- Load from INVENTARIOPISO (guard missing row; default serv' +
        'ice id qual)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    SELECT '
      '        @LOTE        = ISNULL(LOTE,'#39#39'),'
      '        @MARKET_STATUS = RTRIM(ISNULL(MARKET_STATUS,'#39#39')),'
      '        @CONTROLADO  = RTRIM(ISNULL(CONTROLADO,'#39#39')),'
      '        @INV_PRICE   = ISNULL(PRECIO,0),'
      '        @INV_COST    = ISNULL(COSTO,0),'
      '        @NDC         = ISNULL(NDC,'#39#39'),'
      '        @INV_METRIC_SIZE = ISNULL(METRICSIZE,0),'
      '        @INV_RBP     = ISNULL(RBP,0),'
      '        @DRUGNAME    = ISNULL(DESCRIPCION,'#39#39'),'
      
        '        @FECHAEXPIRACION = FECHA_EXPIRACION, -- keep as-is; can ' +
        'be NULL if product doesn'#39't expire'
      '        @ALCHEMY_PRODUCTID = ISNULL(ALCHEMY_PRODUCTID,0),'
      '        @ACTIVE_INVENTORY_PRODUCT_STATUS = ISNULL(STATUS,'#39#39'),'
      '        @PRODUCTSERVIDQUAL_INV = ISNULL(PRODUCTSERVIDQUAL,'#39'03'#39')'
      '    FROM INVENTARIOPISO'
      '    WHERE PRODUCTNO = @PRODUCT_ID;'
      ''
      '    -- Guard: inventory record not found'
      '    IF @NDC IS NULL OR LTRIM(RTRIM(@NDC)) = '#39#39
      '    BEGIN'
      '        SET @ERROR_NO = 903;'
      '        SET @CAN_CONTINUE = 0;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Inventory record not found ' +
        'for this product.'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF RTRIM(ISNULL(@PRODUCTSERVIDQUAL,'#39#39')) = '#39#39
      '        SET @PRODUCTSERVIDQUAL = @PRODUCTSERVIDQUAL_INV;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Existing validations (unchanged)'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    IF @TRANS_TYPE = '#39'retrans'#39
      '    BEGIN'
      '        SET @QTY_TEMP = @QTY_PRESCRIBED;'
      '        IF (@CLAIM_STATUS = 1)'
      '        BEGIN'
      '            SET @ERROR_NO = 1;'
      '            IF @NO_REF_AUTO > 0'
      
        '                SET @CAN_CONTINUE_MESSAGE = '#39'Must add a refill f' +
        'or this prescription!'#39';'
      '            ELSE'
      
        '                SET @CAN_CONTINUE_MESSAGE = '#39'No refill(s) for th' +
        'is prescription!'#39';'
      '            RETURN;'
      '        END;'
      '    END;'
      ''
      '    IF (@TRANS_TYPE = '#39'COPAY'#39') AND (@CLAIM_STATUS = 1)'
      '    BEGIN'
      '        IF @DEDUCIBLE = 0'
      '        BEGIN'
      '            SET @ERROR_NO = 2;'
      
        '            SET @CAN_CONTINUE_MESSAGE = '#39'Error! Prescription has' +
        ' no Patient Pay Amount!'#39';'
      '            RETURN;'
      '        END;'
      '    END;'
      ''
      
        '    IF (NOT EXISTS (SELECT 1 FROM PATPLAN WHERE NUMEROPLAN = @PA' +
        'T_NO_PLAN)) OR (@PAT_NO_PLAN = 0)'
      '    BEGIN'
      '        SET @ERROR_NO = 3;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Patient health plan not fou' +
        'nd!'#39';'
      '        RETURN;'
      '    END;'
      ''
      
        '    IF NOT EXISTS (SELECT 1 FROM DOCTOR WHERE NUMERODOCTOR = @NU' +
        'MERODOCTOR)'
      '    BEGIN'
      '        SET @ERROR_NO = 4;'
      '        SET @CAN_CONTINUE_MESSAGE = '#39'Prescriber not found!'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF @ACTIVE_RX = 0'
      '    BEGIN'
      '        SET @ERROR_NO = 5;'
      '        SET @CAN_CONTINUE_MESSAGE = '#39'Inactive Prescription!'#39';'
      '        RETURN;'
      '    END;'
      ''
      
        '    IF (@TRANS_TYPE <> '#39'Reversal'#39') AND (@TRANS_TYPE <> '#39'COPAY'#39') ' +
        'AND (@CANTIDAD_DISPONIBLE <= 0)'
      '       AND (@TRANS_TYPE <> '#39'Secondary'#39')'
      '    BEGIN'
      '        SET @ERROR_NO = 6;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Pescription has been totall' +
        'y dispensed!'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF @TRANS_TYPE = '#39'Refill'#39
      '    BEGIN'
      '        IF @NO_REF_AUTO = 0'
      '        BEGIN'
      '            SET @ERROR_NO = 7;'
      
        '            SET @CAN_CONTINUE_MESSAGE = '#39'Prescription has no aut' +
        'horized refills!'#39';'
      '            RETURN;'
      '        END;'
      ''
      
        '        IF (@TTransRefill >= @NO_REF_AUTO) AND (@PLAN_MEDICO <> ' +
        #39'CAS'#39')'
      '        BEGIN'
      '            SET @ERROR_NO = 8;'
      '            SET @CAN_CONTINUE_MESSAGE = '#39'No refills available!'#39';'
      '            RETURN;'
      '        END;'
      '    END;'
      ''
      '    IF @PLAN_MEDICO_NO = 0'
      '    BEGIN'
      '        SET @ERROR_NO = 9;'
      '        SET @CAN_CONTINUE_MESSAGE = '#39'Health plan not found!'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF @TRANS_TYPE <> '#39'Reversal'#39
      '    BEGIN'
      
        '        IF (@CONTROLADO = '#39'RX'#39') OR (@CONTROLADO = '#39#39') OR (@CONTR' +
        'OLADO = '#39'OTC'#39') OR (@CONTROLADO = '#39'DME'#39')'
      '        BEGIN'
      
        '            IF GETDATE() > (SELECT DATEADD(DD, @RX_EXPIRATION_DA' +
        'YS, @RXDATE))'
      '            BEGIN'
      '                SET @ERROR_NO = 10;'
      
        '                SET @CAN_CONTINUE_MESSAGE = '#39'Prescription not au' +
        'thorized to be dispensed, older than '#39' '
      
        '                                            + CONVERT(VARCHAR(4)' +
        ', @RX_EXPIRATION_DAYS) + '#39' days!'#39';'
      '                RETURN;'
      '            END;'
      '        END'
      '        ELSE'
      '        BEGIN'
      
        '            IF GETDATE() > (SELECT DATEADD(DD, @RX_CONTROLED_EXP' +
        'IRATION_DAYS, @RXDATE))'
      '            BEGIN'
      '                SET @ERROR_NO = 11;'
      
        '                SET @CAN_CONTINUE_MESSAGE = '#39'Controlled prescrip' +
        'tion not authorized to be dispensed, older than '#39' '
      
        '                                            + CONVERT(VARCHAR(4)' +
        ', @RX_CONTROLED_EXPIRATION_DAYS) + '#39' days!'#39';'
      '                RETURN;'
      '            END;'
      ''
      '            IF @CURRENT_REFILL > @NO_REF_AUTO'
      '            BEGIN'
      '                SET @ERROR_NO = 12;'
      
        '                SET @CAN_CONTINUE_MESSAGE = '#39'Number of refills d' +
        'ispensed for a controlled substance can not exceed 5 refills!'#39';'
      '                RETURN;'
      '            END;'
      '        END;'
      '    END;'
      ''
      '    IF (@ForBilling = 1) AND (@PLAN_MEDICO = '#39'CAS'#39')'
      '    BEGIN'
      '        SET @ERROR_NO = 13;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Cash Prescription, not for ' +
        'billing!'#39';'
      '        RETURN;'
      '    END;'
      ''
      '    IF LEN(@NDC) <> 11'
      '    BEGIN'
      '        SET @ERROR_NO = 14;'
      '        SET @CAN_CONTINUE_MESSAGE = '#39'Invalid NDC length!'#39';'
      '        RETURN;'
      '    END;'
      ''
      
        '    IF (@INV_COST = 0) OR (@INV_METRIC_SIZE = 0) OR (@INV_PRICE ' +
        '= 0) OR (@INV_RBP = 0)'
      '    BEGIN'
      '        SET @ERROR_NO = 15;'
      
        '        SET @CAN_CONTINUE_MESSAGE = '#39'Some product information is' +
        ' missing (cost, metric sizel, price or AWP)!'#39';'
      '        RETURN;'
      '    END;'
      ''
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    -- Transaction section'
      
        '    ------------------------------------------------------------' +
        '-------------'
      '    BEGIN TRANSACTION;'
      ''
      '    SELECT @CAN_CONTINUE = 1;'
      ''
      
        '    SELECT @WF_TYPED = ISNULL(@USER,'#39#39') + '#39' '#39' + FORMAT(GETDATE()' +
        ', '#39'MM/dd/yyyy, hh:mm:ss tt'#39');'
      '    SELECT @NO_HORA = FORMAT(GETDATE(),'#39'hh'#39');'
      ''
      '    SELECT '
      '        @ADHERENCE = ISNULL(ADHERENCE,0),'
      '        @DELIVERY  = ISNULL(DELIVERY,0)'
      '    FROM PACIENTES '
      '    WHERE NUMEROCLIENTE = @NUMEROCLIENTE;'
      ''
      '    IF (@COMPOUNDCODE = 1) AND (@TRANS_TYPE <> '#39'COPAY'#39')'
      '    BEGIN'
      
        '        IF @QTY = 0 SET @PRICE_QTY = @QTY_TEMP ELSE SET @PRICE_Q' +
        'TY = @QTY;'
      ''
      '        EXEC dbo.RX_CALCULATE_PRICE '
      
        '            @OTCNUMBER, @PRODUCT_ID, @PRICE_QTY, @PRICE_TABLE_ID' +
        ', '
      '            @UnitPrice = @UNIT_PRICE OUTPUT, '
      '            @RetailPrice = @Retail_Price OUTPUT,'
      '            @UsualCustomary = @Usual_Customary OUTPUT,'
      '            @Cost = @Cost_ OUTPUT,'
      '            @MetricQuantity = @Metric_Quantity,'
      
        '            @MetricDecimalQuantity = @Metric_DecimalQuantity OUT' +
        'PUT, '
      '            @BillingPrice = @Billing_Price OUTPUT,'
      '            @Disp_Fee = @DISPENSINGFEE OUTPUT,'
      '            @GossAmountDue = @GrossAmount_Due OUTPUT;'
      ''
      
        '        IF @PLAN_MEDICO = '#39'CAS'#39' SELECT @Usual_Customary = @Retai' +
        'l_Price;'
      '    END;'
      ''
      '    IF @TRANS_TYPE = '#39'COPAY'#39
      '    BEGIN'
      '        SET @Billing_Price = @DEDUCIBLE;'
      '        SET @OTHERAMOUNTCLAIMEDSUBCOUNT_ = 0;'
      '        SET @OTAMCLDSUBCOUNTQUAL_ = '#39#39';'
      '        SET @OTHERAMOUNTCLAIMEDSUB_ = 0;'
      '        SET @Usual_Customary = @DEDUCIBLE;'
      '        SET @GrossAmount_Due = @DEDUCIBLE;'
      '        SET @DISPENSINGFEE = 0;'
      '    END'
      '    ELSE'
      '    BEGIN'
      '        SET @OTHERAMOUNTCLAIMEDSUBCOUNT_ = 0;'
      '        SET @OTAMCLDSUBCOUNTQUAL_ = '#39#39';'
      '        SET @OTHERAMOUNTCLAIMEDSUB_ = 0;'
      '        SET @OTHERCOVERAGECODE = '#39'0'#39';'
      '    END;'
      ''
      '    IF @TRANS_TYPE = '#39'Secondary'#39
      '    BEGIN'
      '        UPDATE OTC '
      '        SET PLANESMEDICOSNO_PRIMARY = PLANESMEDICOSNO '
      '        WHERE OTCNUMBER = @OTCNUMBER '
      '          AND PLANESMEDICOSNO_PRIMARY IS NULL;'
      '    END;'
      ''
      
        '    IF (@TRANS_TYPE = '#39'retrans'#39') OR (@OTC_QTY = 0) OR (@CLAIM_ST' +
        'ATUS <> 1)'
      '    BEGIN'
      '        SET @NEW_RECORD = 0;'
      ''
      '        EXEC UPDATE_OTC_BATCH '
      
        '            @GUID, @OTCNUMBER, @Usual_Customary, @QTY_TEMP, @Bil' +
        'ling_Price, @COST_, @FECHAOTC, @DAYS_SUPPLY, 1, '
      '            '#39'01/01/2025'#39', @GrossAmount_Due, @DISPENSINGFEE, '
      
        '            '#39'01/01/2025'#39', '#39#39', 0, 0, '#39'1'#39', @LOTE, @FECHAEXPIRACION' +
        ', @USER, @INSTANCIA, @DAW, @OTHERCOVERAGECODE, @PRODUCTSERVIDQUA' +
        'L;'
      ''
      '        SET @NEW_OTCNUMBER = @OTCNUMBER;'
      '    END'
      '    ELSE'
      '    BEGIN'
      '        SET @NEW_RECORD = 1;'
      ''
      '        EXEC INSERT_OTC '
      
        '            @NDC, @MEDICAMENTO, @Usual_Customary, @USER, '#39'F'#39', @F' +
        'ECHAOTC,'
      
        '            @NUMERORECETA, '#39'R'#39', @Cost_, @QTY, @NUMEROCLIENTE, @M' +
        'EDICAMENTOMIX,'
      
        '            @NUMEROTRANSACCION, 0,0,'#39#39', @PARTIAL_COMPLETION, @RX' +
        '_STATUS,0,0,0,0,0,0,0,'
      
        '            @PHARMACIST, @DAYS_SUPPLY, '#39'F'#39', @Billing_Price, @PLA' +
        'N_MEDICO , @PRODUCT_ID, '
      
        '            @NO_HORA, @PAT_NO_PLAN, @LOTE, '#39#39', @PRICE_TABLE_ID, ' +
        #39'RX'#39', @WF_TYPED, @MEZCLA_TRAN_NO, @FACILITY_ID,'
      
        '            @FECHA_ULTIMO_REFILL, @BATCH_NUMBER_BILLING, 0, @INS' +
        'TANCIA, 1, @GrossAmount_Due,'
      
        '            @OTHERAMOUNTCLAIMEDSUBCOUNT_,@OTAMCLDSUBCOUNTQUAL_,@' +
        'OTHERAMOUNTCLAIMEDSUB_,0,0,@FECHAEXPIRACION,   '
      '            @DISPENSINGFEE, '#39#39','#39#39', @DAW, @OTHERCOVERAGECODE,'
      
        '            @ALCHEMY_PRODUCTID, @marketedproductid, @PLAN_MEDICO' +
        '_NO, @MESSAGEID, @OTCCurrent_Identity = @NEW_OTCNUMBER OUTPUT, '
      
        '            @ADHERENCE = @ADHERENCE, @DELIVERY = @DELIVERY, @LEV' +
        'EL_OF_SERVICE = 0, @GUID = @GUID, @UNIT_PRICE = @UNIT_PRICE,'
      
        '            @RELATED_OTC_NUMBER = @PREVOTCNUMBER, @PRODUCTSERVID' +
        'QUAL = @PRODUCTSERVIDQUAL, @MedRestrict_ID = @MedRestrict_ID;'
      '    END;'
      ''
      '    IF (@TRANS_TYPE = '#39'COPAY'#39') OR (@TRANS_TYPE = '#39'SECONDARY'#39')'
      '    BEGIN'
      '        DELETE FROM COB_A WHERE OTCNUMBER = @NEW_OTCNUMBER;'
      ''
      
        '        INSERT INTO COB_A (NUMERO_RECETA, OTCNUMBER, COB_443_E8,' +
        ' COB_338_5C, COB_339_6C, COB_340_7C) '
      
        '        VALUES (@NUMERORECETA, @NEW_OTCNUMBER, GETDATE(), '#39'01'#39','#39 +
        '03'#39',@COPAY_BIN_NUMBER);'
      ''
      '        SELECT @COB_NOTRANS = IDENT_CURRENT('#39'COB_A'#39');'
      ''
      '        IF @DEDUCIBLE > 0'
      '        BEGIN'
      '            INSERT INTO COB_D (NOTRANS, COB_351_NP, COB_352_NQ) '
      '            VALUES (@COB_NOTRANS, '#39'05'#39', @DEDUCIBLE);'
      '        END;'
      '    END;'
      ''
      '    COMMIT;'
      'END;')
    Left = 3968
    Top = 920
  end
  object RX_COMPOUND_VALUES: TFDQuery
    AfterExecute = RX_COMPOUND_VALUESAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[RX_COMPOUND_VALUES] @NEW_OTCNUMBER INT, ' +
        '@OTCNUMBER INT, @TQTY FLOAT OUTPUT, '
      
        '@TAWP FLOAT OUTPUT, @TRETAIL_PRICE FLOAT OUTPUT, @NEW_MEZCLA_TRA' +
        'N_NO INT OUTPUT, '
      '@TGROSS_AMOUNT_DUE FLOAT OUTPUT'
      'AS'
      'declare @MEZCLA_TRAN_NO INT;'
      'declare @Medicamento char(30);'
      'declare @MetricQty int;'
      'declare @ProductID Int;'
      'declare @ING_BASIS_OFCOST_DET char(2);'
      'declare @PRODUCT_ID_QUALIFIER char(2)'
      'declare @NDC CHAR(11)'
      'declare @NORX BIGINT'
      'declare @CANT_RECETADA FLOAT'
      'declare @CANT_DESPACHADA FLOAT'
      'declare @Lote nchar(12)'
      'declare @FechaExpi date'
      'declare @PRICE_TABLE_ID int'
      'declare @UNIT_PRICE float'
      'declare @Billing_Price FLOAT'
      'declare @Retail_Price FLOAT'
      'declare @Usual_Customary FLOAT'
      'declare @GetCost float'
      'declare @GrossAmount_Due FLOAT'
      'declare @Metric_Quantity FLOAT'
      'declare @Metric_DecimalQuantity FLOAT'
      'declare @DISPENSINGFEE FLOAT'
      'declare @PLAN_MEDICO char(3)'
      'declare @NoRecords int'
      'DECLARE @COMPDOSAGE_FORM_DESC_CODE CHAR(2)'
      'DECLARE @COMPDISP_UNIT_FORM_INDI CHAR(1)'
      'DECLARE @COMPROUTE_OF_ADMINISTRATION CHAR(2)'
      'DECLARE @COMPING_COMP_COUNT INT'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'Begin transaction;'
      
        #9'Select @PRICE_TABLE_ID = PRICE_TABLE_ID, @PLAN_MEDICO = PLAN_ME' +
        'DICO, @COMPDOSAGE_FORM_DESC_CODE = COMPDOSAGE_FORM_DESC_CODE,'
      
        #9'@COMPDISP_UNIT_FORM_INDI = COMPDISP_UNIT_FORM_INDI, @COMPROUTE_' +
        'OF_ADMINISTRATION = COMPROUTE_OF_ADMINISTRATION,'
      
        #9'@COMPING_COMP_COUNT = COMPING_COMP_COUNT, @MEZCLA_TRAN_NO = MEZ' +
        'CLA_TRAN_NO'
      #9'from OTC where OTCNUMBER = @OTCNUMBER;'
      #9#9
      
        #9'DECLARE MyCursor CURSOR FOR SELECT MEDICAMENTO, METRICQUANTITY,' +
        'PRODUCT_ID_QUALIFIER, ING_BASIS_OFCOST_DET, NDC, '
      #9'PRODUCT_ID, NUMERORECETA,CANTIDADRECETADA, CANTIDADDESPACHADA'
      #9'from MEZCLAS where OTCNUMBER = @OTCNUMBER;'
      #9'OPEN MyCursor'
      #9'FETCH NEXT FROM MyCursor'
      
        #9'INTO @MEDICAMENTO, @MetricQty, @PRODUCT_ID_QUALIFIER, @ING_BASI' +
        'S_OFCOST_DET, @NDC, @ProductID, @NORX, @CANT_RECETADA, @CANT_DES' +
        'PACHADA '
      #9'WHILE @@FETCH_STATUS = 0'
      #9'BEGIN'
      
        #9#9'Select @Lote = Lote, @FechaExpi = FECHA_EXPIRACION from INVENT' +
        'ARIOPISO where PRODUCTNO = @ProductID;'
      
        #9#9'EXEC dbo.RX_CALCULATE_PRICE @OTCNUMBER, @ProductID, @CANT_RECE' +
        'TADA, @PRICE_TABLE_ID, '
      #9#9'@UnitPrice = @UNIT_PRICE OUTPUT, '
      #9#9'@RetailPrice = @Retail_Price OUTPUT,'
      #9#9'@UsualCustomary = @Usual_Customary OUTPUT,'
      #9#9'@Cost = @GetCost OUTPUT,'
      #9#9'@MetricQuantity = @Metric_Quantity,'
      #9#9'@MetricDecimalQuantity = @Metric_DecimalQuantity OUTPUT, '
      #9#9'@BillingPrice = @Billing_Price OUTPUT,'
      #9#9'@Disp_Fee = @DISPENSINGFEE OUTPUT,'
      #9#9'@GossAmountDue = @GrossAmount_Due OUTPUT;'
      
        #9#9'if @PLAN_MEDICO = '#39'CAS'#39' Select @Usual_Customary = @Retail_Pric' +
        'e;'
      #9#9#9
      #9#9'INSERT INTO [dbo].[MEZCLAS] '
      #9#9#9'([MEDICAMENTO] ,[METRICQUANTITY],[PRECIOVENTA],[AWP],[COSTO] '
      
        #9#9#9',[PRODUCT_ID_QUALIFIER],[ING_BASIS_OFCOST_DET],[NDC],[PRODUCT' +
        '_ID] --,[NO_TRANS]'
      
        #9#9#9',[NUMERORECETA],[FECHA_MEZCLA],[CANTIDADRECETADA],[CANTIDADDE' +
        'SPACHADA],[OTCNUMBER]'
      #9#9#9', [LOTE],[FECHA_EXPIRACION])'
      
        #9#9#9'VALUES ( @Medicamento, @MetricQty, @Retail_Price, @Billing_Pr' +
        'ice, @GetCost, '
      
        #9#9#9'@PRODUCT_ID_QUALIFIER, @ING_BASIS_OFCOST_DET, @NDC, @ProductI' +
        'D, --@NEW_MEZCLA_TRAN_NO, '
      
        #9#9#9'@NORX, GETDATE(), @CANT_RECETADA, @CANT_RECETADA, @NEW_OTCNUM' +
        'BER, @Lote, @FechaExpi );  '
      #9#9#9
      #9#9#9'set @TQTY = isnull(@TQTY,0) +  @CANT_RECETADA;'
      #9#9#9'set @TAWP = isnull(@TAWP,0) + @Billing_Price;'
      
        #9#9#9'set @TRETAIL_PRICE = isnull(@TRETAIL_PRICE,0) + @Retail_Price' +
        ';'
      
        #9#9#9'set @TGROSS_AMOUNT_DUE = isnull(@TGROSS_AMOUNT_DUE,0) + @Gros' +
        'sAmount_Due;'
      #9#9'FETCH NEXT FROM MyCursor'
      
        #9#9'INTO @MEDICAMENTO, @MetricQty, @PRODUCT_ID_QUALIFIER, @ING_BAS' +
        'IS_OFCOST_DET, @NDC, @ProductID, @NORX, @CANT_RECETADA, @CANT_DE' +
        'SPACHADA'
      #9'END;'
      #9'CLOSE MyCursor'
      #9'DEALLOCATE MyCursor'
      
        '       Update OTC SET QTY_TEMP = @TQTY, PRECIOFACTURACION = @TAW' +
        'P, TOTAL = @TRETAIL_PRICE,  '
      #9'COMPDOSAGE_FORM_DESC_CODE =  @COMPDOSAGE_FORM_DESC_CODE,  '
      #9'COMPDISP_UNIT_FORM_INDI = @COMPDISP_UNIT_FORM_INDI, '
      #9'COMPROUTE_OF_ADMINISTRATION = @COMPROUTE_OF_ADMINISTRATION, '
      #9'COMPING_COMP_COUNT = @COMPING_COMP_COUNT, '
      
        #9'GROSSAMOUNTDUE = @GrossAmount_Due WHERE OTCNUMBER = @NEW_OTCNUM' +
        'BER;'#9
      #9'commit;'#9' '
      'END;')
    Left = 4176
    Top = 920
  end
  object RX_CALCULATE_PRICE: TFDQuery
    AfterExecute = RX_CALCULATE_PRICEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[RX_CALCULATE_PRICE] ( '
      #9'@OTC_NUMBER INT, '
      #9'@PRODUCTID INT, '
      #9'@QTY FLOAT, '
      #9'@PRICE_TABLE_ID INT, '
      #9'@UnitPrice FLOAT OUTPUT, '
      #9'@RetailPrice FLOAT OUTPUT, '
      #9'@UsualCustomary FLOAT OUTPUT,'
      #9'@Cost FLOAT OUTPUT, '
      #9'@MetricQuantity FLOAT OUTPUT, '
      #9'@MetricDecimalQuantity FLOAT OUTPUT,'
      #9'@BillingPrice FLOAT OUTPUT,'
      #9'@Disp_Fee Float OUTPUT,'
      #9'@GossAmountDue Float OUTPUT)'
      #9
      ''
      'AS'
      'DECLARE @USUAL_CUSTOMARY_MULT FLOAT'
      'DECLARE @TYPE CHAR(3)'
      'DECLARE @PackageSize int'
      'DECLARE @INV_PRICE FLOAT'
      'DECLARE @MetricSize FLOAT'
      'DECLARE @INV_COST FLOAT'
      'DECLARE @INV_RBP FLOAT'
      'DECLARE @INV_WAC_PRICE FLOAT'
      'DECLARE @INV_DIRECT_PRICE FLOAT'
      'DECLARE @INV_MAC_PRICE FLOAT'
      'DECLARE @UC_PRICE FLOAT'
      'DECLARE @COST_BASES NCHAR(2)'
      'DECLARE @PrecioaVenderHP FLOAT'
      'DECLARE @PrecioaVenderCash FLOAT'
      'DECLARE @DISPFEEADDON FLOAT'
      'DECLARE @INCENTIVE_AMOUNT_SUB FLOAT'
      'DECLARE @OTHERAMOUNTCLAIMEDSUB FLOAT'
      'DECLARE @FLAT_SALES_TAXSUB FLOAT'
      'DECLARE @PERCENTAGE_SALES_TAX_SUB FLOAT'
      'DECLARE @DISPFEEMULTIPLIER FLOAT'
      'DECLARE @COSTMULTIPLIER FLOAT'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'SET @UnitPrice = 0; '
      #9'SET @RetailPrice = 0; '
      #9'SET @UsualCustomary = 0;'
      #9'SET @Cost = 0; '
      #9'SET @MetricQuantity = 0; '
      #9'SET @MetricDecimalQuantity = 0;'
      #9'SET @BillingPrice = 0;'
      #9'SET @Disp_Fee = 0;'
      #9'SET @GossAmountDue = 0;'
      #9'BEGIN TRANSACTION'
      
        #9'SELECT @TYPE = RTRIM(TIPO), @PackageSize = isnull(PACKAGESIZE,0' +
        '), @INV_PRICE = isnull(PRECIO,0), @MetricSize = isnull(METRICSIZ' +
        'E,0), @INV_COST = isNull(COSTO,0), @INV_RBP = isnull(RBP,0), '
      
        #9'@INV_WAC_PRICE = isnull(WAC_PRICE,0), @INV_DIRECT_PRICE = isnul' +
        'l(DIRECT_PRICE,0), @INV_MAC_PRICE = isnull(MAC_PRICE,0), @UC_PRI' +
        'CE = isnull(UC_PRICE,0) FROM INVENTARIOPISO WHERE PRODUCTNO = @P' +
        'RODUCTID;'
      #9
      #9'if @PRICE_TABLE_ID > 0'
      #9'begin'
      
        #9#9'Select @USUAL_CUSTOMARY_MULT = isNull(USUAL_CUSTOMARY_MULT,0),' +
        ' @COST_BASES = COST_BASES, @DISPFEEADDON = isnull(DISPFEEADDON,0' +
        '), @DISPFEEMULTIPLIER = isnull(DISPFEEMULTIPLIER,0), @COSTMULTIP' +
        'LIER = isnull(COSTMULTIPLIER,0)'
      #9#9'from PRICE_TABLE where PRICE_TABLE_ID = @PRICE_TABLE_ID;'
      #9'end'
      #9'else'
      #9'begin'
      
        #9#9'Select @USUAL_CUSTOMARY_MULT = isNull(USUAL_CUSTOMARY_MULT,0),' +
        ' @COST_BASES = COST_BASES, @DISPFEEADDON = isnull(DISPFEEADDON,0' +
        '), @DISPFEEMULTIPLIER = isnull(DISPFEEMULTIPLIER,0), @COSTMULTIP' +
        'LIER = isnull(COSTMULTIPLIER,0)'
      #9#9'from PRICE_TABLE where DEFAULT_PRICE = 1;'
      #9'end;'
      #9
      #9'if @OTC_NUMBER > 0 '
      #9'begin'
      
        #9#9'Select @INCENTIVE_AMOUNT_SUB = isNull(INCENTIVE_AMOUNT_SUB,0),' +
        ' @OTHERAMOUNTCLAIMEDSUB = isnull(OTHERAMOUNTCLAIMEDSUB,0), @FLAT' +
        '_SALES_TAXSUB = isnull(FLAT_SALES_TAXSUB,0), @PERCENTAGE_SALES_T' +
        'AX_SUB = isNull(PERCENTAGE_SALES_TAX_SUB,0)'
      #9#9'from OTC where OTCNUMBER = @OTC_NUMBER;'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'Set @INCENTIVE_AMOUNT_SUB = 0;'
      #9#9'Set @OTHERAMOUNTCLAIMEDSUB = 0;'
      #9#9'Set @FLAT_SALES_TAXSUB = 0;'
      #9#9'Set @FLAT_SALES_TAXSUB = 0;'
      #9#9'Set @PERCENTAGE_SALES_TAX_SUB = 0;'
      #9'end;'
      #9'if @USUAL_CUSTOMARY_MULT = 0 '
      #9'begin'
      
        #9'  Select @USUAL_CUSTOMARY_MULT = isNull(USUAL_CUSTOMARY_MULT,0)' +
        ', @COST_BASES = COST_BASES from PRICE_TABLE where DEFAULT_PRICE ' +
        '= 1;'
      #9'end;'
      #9'if @USUAL_CUSTOMARY_MULT = 0'
      #9'begin'
      #9#9'Select @USUAL_CUSTOMARY_MULT = 1.5;'
      #9'end;'
      #9'SELECT @PrecioaVenderHP = @INV_RBP;'
      #9'Select @PrecioaVenderCash = @INV_PRICE; '
      #9'if @INV_PRICE > 0 '
      #9'begin'
      #9#9'Select @PrecioaVenderCash = @INV_PRICE;'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'Select @PrecioaVenderCash = @INV_RBP * 1.5;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'01'#39' '
      #9'begin'
      #9'  select @PrecioaVenderHP = @INV_RBP;'
      #9'end;'
      #9'if (@COST_BASES = '#39'02'#39') OR (@COST_BASES = '#39'12'#39') '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @INV_WAC_PRICE;'
      #9#9'Select @PrecioaVenderCash = @INV_WAC_PRICE;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'03'#39' '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @INV_DIRECT_PRICE;'
      #9#9'Select @PrecioaVenderCash = @INV_DIRECT_PRICE;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'05'#39' '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @INV_COST;'
      #9#9'Select @PrecioaVenderCash = @INV_COST;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'06'#39' '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @INV_MAC_PRICE;'
      #9#9'Select @PrecioaVenderCash = @INV_MAC_PRICE;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'07'#39' '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @UC_PRICE;'
      #9#9'Select @PrecioaVenderCash = @UC_PRICE;'
      #9'end;'
      #9'if (@COST_BASES) = '#39'14'#39' '
      #9'begin'
      #9#9'Select @PrecioaVenderHP = @INV_PRICE;'
      #9#9'Select @PrecioaVenderCash = @INV_PRICE;'
      #9'end;'
      #9'if @PrecioaVenderHP = 0'
