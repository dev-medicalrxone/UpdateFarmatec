      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      
        #9'SELECT @NO_RECORDS = COUNT(*) FROM WORKERS_COMPENSATION_SEGMENT' +
        ' WHERE OTC_NUMBER = @OTCNUMBER;'
      #9'IF @NO_RECORDS > 0'
      #9'BEGIN'
      
        #9#9'Update WORKERS_COMPENSATION_SEGMENT set DATE_OF_INJURY = @DATE' +
        '_OF_INJURY, '
