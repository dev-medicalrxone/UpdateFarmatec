  object ADD_EDIT_REFIL_QUERY: TFDQuery
    AfterExecute = ADD_EDIT_REFIL_QUERYAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[ADD_EDIT_REFIL_QUERY]  '
      #9'@TELEFONO NCHAR(10)'
      #9',@PICKUP_DELIVERY_TYPE NCHAR(2) '
      #9',@PICKUP_DATE NCHAR(23)'
      #9',@PICKUP_TIME NCHAR(23)'
      #9',@NOTE NCHAR(256) '
      #9',@NUMERORECETA NCHAR(15)'
      #9',@ORDER_ORIGINATION NCHAR(1)'
      #9',@PICKUP_REMINDER INT'
      #9',@PR_PATIENT_NAME NCHAR(45)'
      #9',@DOB NCHAR(10)'
      #9',@EMAIL NCHAR(80)'
      #9',@RX_IMAGE IMAGE'
      ''
      'AS'
      'DECLARE @NO_RECORDS INT;'
      'DECLARE @MEDICAMENTO NCHAR(30);'
      'DECLARE @LOCAL_SCANED_RX_LINK INT;'
      'DECLARE @CALLDATE NCHAR(23);'
      'DECLARE @CALLTIME NCHAR(23);'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'BEGIN TRANSACTION'
      #9'if @NUMERORECETA > 0 '
      #9'BEGIN'
      
        #9'  SELECT @NO_RECORDS = COUNT(*) FROM REFILL_QUERY WHERE NUMEROR' +
        'ECETA = @NUMERORECETA;'
      #9'END'
      #9'ELSE'
      #9'begin'
      #9'  set @NO_RECORDS = 0;'
      #9'end;'
      #9'SET @CALLDATE = FORMAT (getdate(), '#39'd'#39', '#39'en-us'#39');'
      
        #9'SET @CALLTIME = FORMAT(CAST(GETDATE() AS datetime2), N'#39'hh:mm tt' +
        #39');'
      
        #9'SELECT @MEDICAMENTO = MEDICAMENTO FROM OTC WHERE NUMERORECETA =' +
        ' @NUMERORECETA;'
      #9'if RTRIM(@MEDICAMENTO) = '#39#39' '
      #9'begin'
      #9'  Set @MEDICAMENTO = '#39'Image Sent'#39';'
      #9'end;'
      #9'IF @RX_IMAGE IS not NULL'
      #9'begin'
      
        #9'  Exec SCANED_RX_LINK  @SCANED_RX_LINK = @LOCAL_SCANED_RX_LINK ' +
        'output; '
      
        #9'  Exec [FarmatecImages].dbo.INSERT_SCANNED_RX @RX_IMAGE, @LOCAL' +
        '_SCANED_RX_LINK, 0, 0;'
      #9'end;'
      #9'IF @NO_RECORDS = 0'
      #9'begin'
      #9#9'INSERT INTO [REFILL_QUERY] ([TELEFONO]'
      
        '               ,[PICKUP_DELIVERY_TYPE],[CALLDATE],[PICKUP_DATE],' +
        '[PICKUP_TIME],[CALL_BACK_NUMBER]'
      
        '               ,[NOTE],[NUMERORECETA],[RX_STATUS],[ORDER_ORIGINA' +
        'TION]'
      '               ,[DATE_CREATED],[PICKUP_REMINDER]'
      '               ,[PR_PATIENT_NAME]'
      
        '               ,[PICKED_UP],[CALLTIME],[DOB], [EMAIL], [MEDICAME' +
        'NTO], [SCAN_RX_LINK])'
      '          VALUES'
      #9#9'    (@TELEFONO, @PICKUP_DELIVERY_TYPE, @CALLDATE,'
      #9#9#9'   @PICKUP_DATE,@PICKUP_TIME, @TELEFONO'
      '               ,@NOTE, @NUMERORECETA , 0, @ORDER_ORIGINATION'
      '               ,GETDATE(), @PICKUP_REMINDER'
      '               ,@PR_PATIENT_NAME'
      '               ,0, @CALLTIME ,@DOB, @EMAIL, '
      #9#9#9'   @MEDICAMENTO, @LOCAL_SCANED_RX_LINK )'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'Update Refill_query set Telefono = @TELEFONO,'
      '        PICKUP_DELIVERY_TYPE = @PICKUP_DELIVERY_TYPE,'
      '        CALLDATE = @CALLDATE,'
      '        PICKUP_DATE = @PICKUP_DATE,'
      '        PICKUP_TIME = @PICKUP_TIME,'
      '        NOTE = @NOTE,'
      '        CALLTIME = @CALLTIME,'
      '        EMAIL = @EMAIL,'
      '        MEDICAMENTO = @MEDICAMENTO, '
      '        DOB = @DOB'
      '         WHERE NUMERORECETA = @NUMERORECETA;'#9'  '
      #9'end;'
      
        #9'delete from REFILL_QUERY WHERE DATE_CREATED < GETDATE() - 30 AN' +
        'D RX_STATUS = 0;'
      '   COMMIT;'
      'END;')
    Left = 4968
    Top = 1072
  end
  object CONTROLED_LOG: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'IF NOT EXISTS (SELECT * FROM sys.objects WHERE name =  '#39'CONTROLE' +
        'D_LOG'#39'  )'
      'BEGIN'
      'CREATE TABLE [dbo].[CONTROLED_LOG]('
      #9'[ID] [int] IDENTITY(1,1) NOT NULL,'
      #9'[DATE] [datetime] NULL,'
      #9'[RX_NUMBER] [bigint] NULL,'
      #9'[PATIENT_SUPPLIER] [nchar](50) NULL,'
      #9'[PRESCRIBER] [nchar](50) NULL,'
      #9'[PRESCRIBER_ID] [nchar](15) NULL,'
      #9'[BATCH] [nchar](15) NULL,'
      #9'[EXPIRES] [date] NULL,'
      #9'[BALANCE] [decimal](18, 2) NULL,'
      #9'[SIGNATURE] [image] NULL,'
      #9'[DRUG] [nchar](30) NULL,'
      #9'[NDC] [nchar](11) NULL,'
      #9'[EMPLOYEE] [nchar](3) NULL,'
      #9'[SCHEDULE_TYPE] [nchar](4) NULL,'
      #9'[PRESCRIBER_NUMBER] [int] NULL,'
      #9'[PATIENT_NUMBER] [int] NULL,'
      #9'[QTY_SOLD] [decimal](18, 2) NULL,'
      #9'[PHARMACIST] [nchar](3) NULL,'
      #9'[OTCNUMBER] [int] NULL,'
      #9'[PATIENT_SUPPLIER_ID] [int] NULL,'
      #9'[QTY_PURCHASED] [decimal](18, 2) NULL,'
      #9'[REFILL_DISPENSED] [decimal](18, 2) NULL,'
      ' CONSTRAINT [PK_CONTROLED_LOG] PRIMARY KEY CLUSTERED '
      '('
      #9'[ID] ASC'
      
        ')WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP' +
        '_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFAC' +
        'TOR = 80) ON [PRIMARY]'
      ') ON [PRIMARY] TEXTIMAGE_ON [PRIMARY];'
      
        'ALTER TABLE [dbo].[CONTROLED_LOG] ADD  CONSTRAINT [DF_CONTROLED_' +
        'LOG_QTY_PURCHASED]  DEFAULT ((0)) FOR [QTY_PURCHASED];'
      'END;')
    Left = 4768
    Top = 872
  end
  object ADD_EDIT_CONTROLED_LOG: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[ADD_EDIT_CONTROLED_LOG] '
      '@RX_NUMBER BIGINT, '
      '@patient_supplier nchar(50),'
      '@prescriber nchar(50),'
      '@prescriber_id nchar (15),'
      '@batch nchar(15),'
      '@expires date, '
      '@balance decimal(18, 2), '
      '@drug nchar(30),'
      '@ndc nchar(11),'
      '@employee nchar(3),'
      '@schedule_type nchar(4),'
      '@id integer,'
      '@prescriber_No int,'
      '@patient_no int,'
      '@qty decimal(18,2),'
      '@PATIENT_SUPPLIER_ID INT,'
      '@OTCNUMBER INT,'
      '@QTY_PURCHASED decimal(18,2),'
      '@REFILL_DISPENSED decimal(18,2)'
      'AS'
      'BEGIN'
      #9'-- SET NOCOUNT ON added to prevent extra result sets from'
      #9'-- interfering with SELECT statements.'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      #9'if @id = 0 '
      #9'begin'
      #9#9'INSERT INTO [dbo].[CONTROLED_LOG] '
      #9#9#9'(DATE'
      #9#9#9',RX_NUMBER'
      #9#9#9',PATIENT_SUPPLIER'
      #9#9#9',PRESCRIBER'
      #9#9#9',PRESCRIBER_ID'
      #9#9#9',BATCH'
      #9#9#9',EXPIRES'
      #9#9#9',BALANCE'
      #9#9#9',DRUG'
      #9#9#9',NDC'
      #9#9#9',EMPLOYEE'
      #9#9#9',SCHEDULE_TYPE'
      #9#9#9',PRESCRIBER_NUMBER'
      #9#9#9',PATIENT_NUMBER'
      #9#9#9',QTY_SOLD'
      #9#9#9',PATIENT_SUPPLIER_ID'
      #9#9#9',OTCNUMBER'
      #9#9#9',QTY_PURCHASED'
      #9#9#9',REFILL_DISPENSED)'
      #9#9'VALUES'
      #9#9#9'(GETDATE() , '
      #9#9#9'@RX_NUMBER'
      #9#9#9',@patient_supplier'
      #9#9#9',@prescriber'
      #9#9#9',@prescriber_id'
      #9#9#9',@batch'
      #9#9#9',@expires'
      #9#9#9',@balance'
      #9#9#9',@drug'
      #9#9#9',@ndc'
      #9#9#9',@employee'
      #9#9#9',@schedule_type'
      #9#9#9',@prescriber_No'
      #9#9#9',@patient_no'
      #9#9#9',@qty'
      #9#9#9',@PATIENT_SUPPLIER_ID'
      #9#9#9',@OTCNUMBER'
      #9#9#9',@QTY_PURCHASED'
      #9#9#9',@REFILL_DISPENSED)'
      #9'end'
      #9'else'
      #9'begin'
      #9#9'UPDATE CONTROLED_LOG SET RX_NUMBER = @RX_NUMBER, '
      #9#9'PATIENT_SUPPLIER = @patient_supplier, '
      #9#9'PRESCRIBER = @prescriber,'
      #9#9'PRESCRIBER_ID = @prescriber_id, '
      #9#9'BATCH = @batch, '
      #9#9'EXPIRES = @expires, '
      #9#9'BALANCE = @balance, '
      #9#9'DRUG = @drug, '
      #9#9'NDC = @ndc, '
      #9#9'EMPLOYEE = @employee, '
      #9#9'SCHEDULE_TYPE = @schedule_type,'
      #9#9'QTY_SOLD = @qty,'
      #9#9'PATIENT_SUPPLIER_ID = @PATIENT_SUPPLIER_ID,'
      #9#9'OTCNUMBER = @OTCNUMBER,'
      #9#9'QTY_PURCHASED = @QTY_PURCHASED'
      #9#9'WHERE id = @id;'
      #9'end;'
      #9'Commit;'
      'END')
    Left = 4768
    Top = 976
  end
  object INSERT_EDIT_PRODUCT_IMAGE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE PROCEDURE [dbo].[INSERT_EDIT_PRODUCT_IMAGE] '
      #9'@productId int,'
      '@productImage image'
      'AS'
      'DECLARE @recordCount int'
      'BEGIN'
      #9'SET NOCOUNT ON;'
      #9'begin transaction'
      
        #9'SELECT @recordcount = COUNT (*) from INVENTORY_IMAGE WHERE (PRO' +
        'DUCT_ID = @productId)'
      #9'IF @recordcount = 0'
      #9'BEGIN'
      
        #9'  INSERT INTO INVENTORY_IMAGE (PRODUCT_ID, PROD_IMAGE) VALUES (' +
        '@productId, @productImage)'
      #9'end'
      #9'else '
      #9'begin'
      
        #9'  Update INVENTORY_IMAGE SET PROD_IMAGE = @productImage WHERE P' +
        'RODUCT_ID = @productId;'
      #9'end; '
      #9'commit;'
      'END')
    Left = 4984
    Top = 696
  end
  object FDQuery5: TFDQuery
