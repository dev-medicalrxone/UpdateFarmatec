        #9'  @PATIENT_ID_QUAL, @PREGNANCY_IDICATOR,  @DEUDA_WEB, @LANGUAGE' +
        ', @INFOADICIONAL,'
      
        #9'  @CONSULTA, @CIUDAD, @FECHANACIMIENTO, @NUMEROCLIENTE, @FECHA_' +
