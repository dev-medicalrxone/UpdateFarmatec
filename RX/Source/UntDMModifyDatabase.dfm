      #9#9#9',@CMAXINVENTARIO'
      #9#9#9',@CMININVENTARIO'
      #9#9#9',@CODIGOBARRA'
      #9#9#9',@NUMEROSUPLIDOR'
      #9#9#9',@SUB_DEPARTAMENTO'
      #9#9#9',@DESCRIPCION'
      #9#9#9',@ROUTEOFADMINISTRATION'
      #9#9#9',@CONTROLADO'
