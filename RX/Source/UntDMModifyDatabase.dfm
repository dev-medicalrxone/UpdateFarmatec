      '           ,[EXPIRE_OTHER]'
      '           ,[MARKETEDPRODUCTID]'
      '           ,[MAIN_NDC]'
      '           ,[PSEUDOEPHEDRINE]'
      '           ,[INITIAL_QTY]'
      '           ,[EDITAR_PRECIO]'
      '           ,[QTYINVENTARIO])'
      '     select '
      '           [TIPO]'
      '           ,[FECHA_EXPIRACION]'
      '           ,[CODIGO]'
      '           ,[COSTO]'
      '           ,[RBP]'
      '           ,[ESPECIAL]'
      '           ,[DEPARTAMENTO]'
      '           ,[LOTE]'
      '           ,[PRECIO]'
      '           ,[COMESPECIAL]'
      '           ,[TERMINAESPECIAL]'
      '           ,[PORCIENTODESCUENTO]'
      '           ,[ULTIMOCAMBIO]'
      '           ,[ULTIMAVENTA]'
      '           ,[CMAXINVENTARIO]'
      '           ,[CMININVENTARIO]'
      '           ,@BARCODE'
      '           ,[FOODITEM]'
      '           ,[NONEBC]'
      '           ,[NUMEROSUPLIDOR]'
      '           ,[SUB_DEPARTAMENTO]'
      '           ,[DESCRIPCION]'
      '           ,[ROUTEOFADMINISTRATION]'
      '           ,[CONTROLADO]'
      '           ,[STRENGTH]'
      '           ,[INFOADICIONAL]'
      '           ,[METRICSIZE]'
      '           ,[CAUTION1]'
      '           ,[CAUTION2]'
      '           ,[CAUTION3]'
      '           ,[GENERICNAME]'
      '           ,[TXR]'
      '           ,[BRAND]'
      '           ,[GROUP_PRODUCTNO]'
      '           ,[RECETARIO]'
      '           ,[GROUP_QTY]'
      '           ,[PRECIO_CAJA]'
      '           ,[QTY_CAJA]'
      '           ,[DESCUENTO]'
      '           ,[IMAGE_CODE]'
      '           ,[PACKAGESIZE]'
      '           ,[TXR_EXTENSION]'
      '           ,[STATUS]'
      '           ,[TAXABLE]'
      '           ,[TAXABLE_ESTATAL]'
      '           ,[PRECIO2]'
      '           ,[PO]'
      '           ,[isbn]'
      '           ,[SHOWINDIVIDUAL]'
      '           ,[PRECIO_DACO]'
      '           ,[NDC]'
      '           ,[METRIC_UNIT]'
      '           ,[ROBOT]'
      '           ,[ROBOT_NDC]'
      '           ,[PATROCINIO]'
      '           ,[COBRAR_TAX]'
      '           ,[ALCHEMY_PRODUCTID]'
      '           ,[MARKET_STATUS]'
      '           ,[OUTERPACKAGEUNIT]'
      '           ,[PAKAGE_ID]'
      '           ,[REVENUE_CODE]'
      '           ,[HCPCS]'
      '           ,[CASA_FARMACEUTICA]'
      '           ,[VERSION_DESCRIPTION]'
      '           ,[PAKAGE_DESCRIPTION]'
      '           ,[AllowControledRefills]'
      '           ,[PRECIOVENTA2]'
      '           ,[PRICE_TABLE_ID]'
      '           ,[ESCANEAR_BARCODEALTERNO]'
      '           ,[PRICE_UPDATE]'
      '           ,[ENTER_LAB_RESULTS]'
      '           ,[OVERRIDE_SYSTEM_DEFAULT_PRICE]'
      '           ,[WAC_PRICE]'
      '           ,[MAC_PRICE]'
      '           ,[DIRECT_PRICE]'
      '           ,[UC_PRICE]'
      '           ,[EXPIRE_OPTION]'
      '           ,[EXPIRE_DAYS]'
      '           ,[EXPIRE_OTHER]'
      '           ,[MARKETEDPRODUCTID]'
      '           ,[MAIN_NDC]'
      '           ,[PSEUDOEPHEDRINE]'
      '           ,[INITIAL_QTY]'
      '           ,[EDITAR_PRECIO]'
      '           ,[QTYINVENTARIO]'
      #9#9#9'from INVENTARIOPISO where PRODUCTNO = @PRODUCTNO;'
      #9#9#9'set @PRODUCTID = SCOPE_IDENTITY();'
      '  COMMIT; '
      'END;')
    Left = 2680
    Top = 352
  end
  object INSERT_MEZLCA: TFDQuery
    AfterExecute = INSERT_MEZLCAAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[INSERT_MEZLCA] @MEDICAMENTO NCHAR(30), @' +
        'PRECIOVENTA FLOAT, @AWP FLOAT, @COSTO FLOAT, @PRODUCT_ID_QUALIFI' +
        'ER CHAR(2),'
      
        '@ING_BASIS_OFCOST_DET CHAR(2), @NDC CHAR(11), @PRODUCT_ID INT, @' +
        'NUMERORECETA BIGINT, @FECHA_MEZCLA NCHAR(11), @CANTIDADRECETADA ' +
        'FLOAT,'
      
        '@CANTIDADDESPACHADA FLOAT, @NO_TRANS int, @COMPDOSAGE_FORM_DESC_' +
        'CODE NCHAR(2), @COMPDISP_UNIT_FORM_INDI NCHAR(1), '
      
        '@COMPROUTE_OF_ADMINISTRATION NCHAR(11), @OTCNUMBER INT, @COMPING' +
        '_COMP_COUNT int, @FECHA_EXPIRACION CHAR(10), @LOTE CHAR(12),'
      
        '@TCosto FLOAT OUTPUT, @TPrecioVenta FLOAT OUTPUT, @TAWP FLOAT OU' +
        'TPUT,'
      '@TQTY FLOAT OUTPUT, @TRx INTEGER OUTPUT, @MEZCLASNO INT,'
      '@TRecetado FLOAT'
      'AS '
      'begin'
      '  begin transaction'
      
        '    --SELECT @MEZCLASNO = ISNULL(MEZCLASNO, 0) FROM MEZCLAS WHER' +
        'E NO_TRANS = @NO_TRANS AND PRODUCT_ID = @PRODUCT_ID;'
      #9'IF @MEZCLASNO > 0 '
      #9'begin'
      '          UPDATE [dbo].[MEZCLAS]'
      '          SET [MEDICAMENTO] = @MEDICAMENTO'
      '            ,[METRICQUANTITY] = @CANTIDADDESPACHADA*1000'
      '            ,[PRECIOVENTA] = @PRECIOVENTA'
      '            ,[AWP] = @AWP'
      '            ,[COSTO] = @COSTO'
      '            ,[PRODUCT_ID_QUALIFIER] = @PRODUCT_ID_QUALIFIER'
      '            ,[ING_BASIS_OFCOST_DET] = @ING_BASIS_OFCOST_DET'
      '            ,[NDC] = @NDC'
      '            ,[PRODUCT_ID] = @PRODUCT_ID'
      '            ,[NO_TRANS] = @NO_TRANS'
      '            ,[NUMERORECETA] = @NUMERORECETA'
      '            ,[FECHA_MEZCLA] = @FECHA_MEZCLA'
      '            ,[CANTIDADRECETADA] = @CANTIDADRECETADA'
      '            ,[CANTIDADDESPACHADA] = @CANTIDADDESPACHADA'
      '            ,[LOTE] = @LOTE'
      '            ,[FECHA_EXPIRACION] = @FECHA_EXPIRACION'
      '            ,[OTCNUMBER] = @OTCNUMBER'
      '            WHERE MEZCLASNO = @MEZCLASNO'
      #9'end'
      #9'else'
      #9'begin '
      '      INSERT INTO [dbo].[MEZCLAS]'
      '           ([MEDICAMENTO]'
      '           ,[METRICQUANTITY]'
      '           ,[PRECIOVENTA]'
      '           ,[AWP]'
      '           ,[COSTO]'
      '           ,[PRODUCT_ID_QUALIFIER]'
      '           ,[ING_BASIS_OFCOST_DET]'
      '           ,[NDC]'
      '           ,[PRODUCT_ID]'
      '           ,[NO_TRANS]'
      '           ,[NUMERORECETA]'
      '           ,[FECHA_MEZCLA]'
      '           ,[CANTIDADRECETADA]'
      '           ,[CANTIDADDESPACHADA]'
      '           ,[OTCNUMBER]'
      '           ,[LOTE]'
      '           ,[FECHA_EXPIRACION])'
      '       VALUES'
      '           (@MEDICAMENTO'
      '           ,@CANTIDADDESPACHADA*1000'
      '           ,@PRECIOVENTA'
      '           ,@AWP'
      '           ,@COSTO'
      '           ,@PRODUCT_ID_QUALIFIER'
      '           ,@ING_BASIS_OFCOST_DET'
      '           ,@NDC'
      '           ,@PRODUCT_ID'
      '           ,@NO_TRANS'
      '           ,@NUMERORECETA'
      '           ,@FECHA_MEZCLA'
      '           ,@CANTIDADRECETADA'
      '           ,@CANTIDADDESPACHADA'
      '           ,@OTCNUMBER'
      '           ,@LOTE'
      '           ,@FECHA_EXPIRACION)'
      #9'end;'
      ''
      ''
      
        '    select @TQTY = sum(CANTIDADDESPACHADA), @TCosto = SUM(Costo)' +
        ', @TPrecioVenta = Sum(PrecioVenta), @TRx = COUNT(*),'
      
        '      @TRecetado = SUM(CantidadRecetada), @TAWP = Sum(AWP)  from' +
        ' MEZCLAS where OTCNUMBER = @OTCNUMBER;'
      ''
      
        '    Update OTC set COMPDOSAGE_FORM_DESC_CODE =  @COMPDOSAGE_FORM' +
        '_DESC_CODE, COMPDISP_UNIT_FORM_INDI = @COMPDISP_UNIT_FORM_INDI, ' +
        'ROUTEOFADMIN_995_E2 = @COMPROUTE_OF_ADMINISTRATION, '
      
        #9'   QTY = @TQTY, COSTOVENTA = @TCosto, TOTAL = @TPrecioVenta, PR' +
        'ECIOFACTURACION = @TAWP, COMPING_COMP_COUNT = @TRx Where OTCNUMB' +
        'ER = @OTCNUMBER;'
      ''
      
        '    UPDATE PRESCRIPTIONS SET CANTIDADRECETADA = @TRecetado where' +
        ' NUMERORECETA = @NUMERORECETA; '
      '  '
      '  commit'
      'end')
    Left = 2688
    Top = 448
  end
  object RXDATA: TFDQuery
