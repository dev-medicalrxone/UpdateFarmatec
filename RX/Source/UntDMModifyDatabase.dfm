  object WILLCALL_TOTAL_AMOUNT_DUE: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      
        'CREATE PROCEDURE [dbo].[WILLCALL_TOTAL_AMOUNT_DUE] @BAG_NUMBER I' +
        'NTEGER, @TAmountDue Float output'
      'AS'
      'SET NOCOUNT ON'
      'declare @TCOPAY Float;'
      'declare @TCASH Float;'
      'begin'
      '  begin transaction'
      #9'select @TCOPAY = ISNULL(sum(COPAY), 0) '
      #9'from WILLCALL WHERE CASH_PLAN = 2 AND BAG_NUMBER = @BAG_NUMBER;'
      
        #9'select @TCASH = ISNULL(sum(PRICE), 0) from WILLCALL WHERE CASH_' +
        'PLAN = 1 AND BAG_NUMBER = @BAG_NUMBER;'
      #9'select @TAmountDue = @TCOPAY + @TCASH;'
      '  commit'
      'end')
    Left = 1816
    Top = 240
  end
  object CALC_RXDISPONIBLE: TFDQuery
    AfterExecute = CALC_RXDISPONIBLEAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[CALC_RXDISPONIBLE]'
      'ON [dbo].[OTC]'
      'AFTER INSERT, UPDATE, DELETE'
      'AS'
      'BEGIN'
      '    SET NOCOUNT ON;'
      ''
      '    BEGIN TRY'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- 0) Determine operation type and fast-exit rules'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        DECLARE @isIns bit = CASE WHEN EXISTS (SELECT 1 FROM ins' +
        'erted) THEN 1 ELSE 0 END;'
      
        '        DECLARE @isDel bit = CASE WHEN EXISTS (SELECT 1 FROM del' +
        'eted)  THEN 1 ELSE 0 END;'
      
        '        DECLARE @isUpd bit = CASE WHEN @isIns = 1 AND @isDel = 1' +
        ' THEN 1 ELSE 0 END;'
      ''
      '        /*'
      '            IMPORTANT:'
      
        '            - Cash fills often change CLAIM_STATUS / FECHAOTC / ' +
        'DAYS_SUPPLY without touching QTY or RX_STATUS.'
      
        '            - FECHAULTIMOREFILL should reflect the last dispense' +
        'd date, not only CLAIM_STATUS = 1.'
      
        '            - If RX_STATUS is changed to '#39'C'#39', we MUST recalc (it' +
        ' affects totals and last dispense date).'
      '        */'
      ''
      '        IF @isUpd = 1'
      '        BEGIN'
      
        '            -- Only run if a relevant column was part of the UPD' +
        'ATE statement.'
      
        '            -- (Statement-level check to avoid work on unrelated' +
        ' updates.)'
      '            IF NOT ('
      '                   UPDATE(QTY)'
      '                OR UPDATE(RX_STATUS)'
      '                OR UPDATE(FECHAOTC)'
      '                OR UPDATE(CLAIM_STATUS)'
      '                OR UPDATE(DAYS_SUPPLY)'
      '                OR UPDATE(NUMEROCLIENTE)'
      '                OR UPDATE(NUMERORECETA)'
      '            )'
      '                RETURN;'
      ''
      '            -- Row-level change check (multi-row safe).'
      '            IF NOT EXISTS'
      '            ('
      '                SELECT 1'
      '                FROM inserted i'
      '                JOIN deleted  d ON d.OTCNUMBER = i.OTCNUMBER'
      '                WHERE'
      
        '                       ISNULL(i.QTY,0)                    <> ISN' +
        'ULL(d.QTY,0)'
      
        '                    OR ISNULL(i.RX_STATUS,'#39#39')             <> ISN' +
        'ULL(d.RX_STATUS,'#39#39')'
      
        '                    OR ISNULL(i.CLAIM_STATUS,-1)          <> ISN' +
        'ULL(d.CLAIM_STATUS,-1)'
      
        '                    OR ISNULL(i.FECHAOTC,'#39'19000101'#39')      <> ISN' +
        'ULL(d.FECHAOTC,'#39'19000101'#39')'
      
        '                    OR ISNULL(i.DAYS_SUPPLY,-1)           <> ISN' +
        'ULL(d.DAYS_SUPPLY,-1)'
      
        '                    OR ISNULL(i.NUMEROCLIENTE,-1)         <> ISN' +
        'ULL(d.NUMEROCLIENTE,-1)'
      
        '                    OR ISNULL(i.NUMERORECETA,-1)          <> ISN' +
        'ULL(d.NUMERORECETA,-1)'
      '            )'
      '                RETURN;'
      '        END'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        -- 1) Cascade cleanup for pure DELETE only (never for UP' +
        'DATE)'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        IF @isDel = 1 AND @isIns = 0'
      '        BEGIN'
      
        '            CREATE TABLE #DelOtc (OTCNUMBER INT NOT NULL PRIMARY' +
        ' KEY);'
      
        '            CREATE TABLE #DelRx  (NUMERORECETA BIGINT NOT NULL P' +
        'RIMARY KEY);'
      ''
      
        '            -- Only delete child rows when the OTCNUMBER no long' +
        'er exists in OTC'
      '            INSERT INTO #DelOtc (OTCNUMBER)'
      '            SELECT DISTINCT d.OTCNUMBER'
      '            FROM deleted d'
      '            WHERE d.OTCNUMBER IS NOT NULL'
      
        '              AND NOT EXISTS (SELECT 1 FROM dbo.OTC o WHERE o.OT' +
        'CNUMBER = d.OTCNUMBER);'
      ''
      
        '            -- Only delete child rows when the NUMERORECETA no l' +
        'onger exists in OTC'
      '            INSERT INTO #DelRx (NUMERORECETA)'
      '            SELECT DISTINCT d.NUMERORECETA'
      '            FROM deleted d'
      '            WHERE d.NUMERORECETA IS NOT NULL'
      
        '              AND NOT EXISTS (SELECT 1 FROM dbo.OTC o WHERE o.NU' +
        'MERORECETA = d.NUMERORECETA);'
      ''
      '            -- OTCNUMBER-based deletes'
      
        '            DELETE t FROM dbo.RXDATA t                  JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.CLINICAL_SEGMENT t        JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.CLINICAL_SEGMENT_INFO t   JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.PRIOR_AUTH t              JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.FACILITY_ID t             JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.PROCEDURE_MODIFIER_CODE t JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.DUR_PPS t                 JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.COB_A t                   JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.COB_OTHERPAYMENT t        JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      
        '            DELETE t FROM dbo.SUB_CLARIFICATION_CODE t  JOIN #De' +
        'lOtc d ON d.OTCNUMBER = t.OTCNUMBER;'
      ''
      '            -- NUMERORECETA-based deletes'
      
        '            DELETE t FROM dbo.DISPILL t               JOIN #DelR' +
        'x d ON d.NUMERORECETA = t.NUMERORECETA;'
      
        '            DELETE t FROM dbo.Prescriptions_ByPhone t JOIN #DelR' +
        'x d ON d.NUMERORECETA = t.RXNUM;'
      '        END'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      '        -- 2) Build affected NUMERORECETA set (set-based temp)'
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        CREATE TABLE #ChangedRx (NUMERORECETA BIGINT NOT NULL PR' +
        'IMARY KEY);'
      ''
      '        INSERT INTO #ChangedRx (NUMERORECETA)'
      '        SELECT DISTINCT i.NUMERORECETA'
      '        FROM inserted i'
      '        WHERE @isIns = 1'
      '          AND i.NUMERORECETA IS NOT NULL'
      ''
      '        UNION'
      ''
      '        SELECT DISTINCT d.NUMERORECETA'
      '        FROM deleted d'
      '        WHERE @isDel = 1'
      '          AND d.NUMERORECETA IS NOT NULL;'
      ''
      '        -- If nothing to recalc, exit'
      '        IF NOT EXISTS (SELECT 1 FROM #ChangedRx) RETURN;'
      ''
      
        '        --------------------------------------------------------' +
        '-------------'
      
        '        -- 3) Recalculate PRESCRIPTIONS availability + last disp' +
        'ensed date'
      
        '        --------------------------------------------------------' +
        '-------------'
      '        ;WITH RxBase AS'
      '        ('
      '            SELECT'
      '                p.NUMERORECETA,'
      '                TRECETADO = ISNULL(p.CANTIDADRECETADA, 0),'
      
        '                NOREFAUTO = ISNULL(p.NumeroRefillsAutorizados, 0' +
        ')'
      '            FROM dbo.PRESCRIPTIONS p'
      '            JOIN #ChangedRx r ON r.NUMERORECETA = p.NUMERORECETA'
      '        ),'
      '        Dispensed AS'
      '        ('
      '            SELECT'
      '                o.NUMERORECETA,'
      '                -- Sum dispensed excluding cancelled'
      '                TDISPENSADO ='
      
        '                    SUM(CASE WHEN ISNULL(o.RX_STATUS,'#39#39') <> '#39'C'#39' ' +
        'THEN ISNULL(o.QTY, 0) ELSE 0 END),'
      ''
      
        '                -- Last dispensed date should reflect last non-c' +
        'ancelled dispense (works for CASH too)'
      '                FECHAULTIMOREFILL ='
      
        '                    MAX(CASE WHEN ISNULL(o.RX_STATUS,'#39#39') <> '#39'C'#39' ' +
        'THEN o.FECHAOTC ELSE NULL END),'
      ''
      
        '                DAYS_SUPPLY   = MAX(CASE WHEN ISNULL(o.RX_STATUS' +
        ','#39#39') <> '#39'C'#39' THEN o.DAYS_SUPPLY ELSE NULL END),'
      '                NUMEROCLIENTE = MAX(o.NUMEROCLIENTE)'
      '            FROM dbo.OTC o'
      '            JOIN #ChangedRx r ON r.NUMERORECETA = o.NUMERORECETA'
      '            GROUP BY o.NUMERORECETA'
      '        )'
      '        UPDATE p'
      '        SET'
      '            p.CANTIDAD_DISPONIBLE ='
      
        '                (rb.TRECETADO * (1 + rb.NOREFAUTO)) - ISNULL(d.T' +
        'DISPENSADO, 0),'
      ''
      '            -- only overwrite when we have a value'
      
        '            p.DAYS_SUPPLY       = COALESCE(d.DAYS_SUPPLY, p.DAYS' +
        '_SUPPLY),'
      
        '            p.FECHAULTIMOREFILL = COALESCE(d.FECHAULTIMOREFILL, ' +
        'p.FECHAULTIMOREFILL),'
      
        '            p.NUMEROCLIENTE     = COALESCE(d.NUMEROCLIENTE, p.NU' +
        'MEROCLIENTE)'
      '        FROM dbo.PRESCRIPTIONS p'
      '        JOIN RxBase rb ON rb.NUMERORECETA = p.NUMERORECETA'
      
        '        LEFT JOIN Dispensed d ON d.NUMERORECETA = rb.NUMERORECET' +
        'A;'
      ''
      '    END TRY'
      '    BEGIN CATCH'
      '        THROW;'
      '    END CATCH'
      'END')
    Left = 496
    Top = 24
  end
  object CALC_RXDISPONIBLE_DEL: TFDQuery
    AfterExecute = CALC_RXDISPONIBLE_DELAfterExecute
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE TRIGGER [dbo].[CALC_RXDISPONIBLE_DEL] ON [dbo].[OTC]'
      'AFTER DELETE'
      'AS'
      'SET NOCOUNT ON'
      'DECLARE @TDISPENSADO FLOAT'
      'DECLARE @TRECETADO FLOAT'
      'DECLARE @NORX INT'
      'DECLARE @NOREFAUTO INT'
      'DECLARE @RX_STATUS CHAR(1)'
      'DECLARE @FECHAULTIMOREFILL DATE'
      'DECLARE @OTCNUMBER INT'
      'begin'
      '  begin transaction'
      
        #9'Select @NORX = NUMERORECETA, @RX_STATUS = RX_STATUS FROM DELETE' +
        'D'
      
        #9'select @NOREFAUTO = NumeroRefillsAutorizados FROM PRESCRIPTIONS' +
        ' WHERE NUMERORECETA = @NORX;'
      
        #9'Select @TDISPENSADO = sum(qty) from OTC where NUMERORECETA = @N' +
        'ORX AND RX_STATUS <> '#39'C'#39';'
      
        #9'Select @TRECETADO = CANTIDADRECETADA FROM PRESCRIPTIONS WHERE N' +
        'UMERORECETA = @NORX; '
      #9'if (Select @NOREFAUTO) > 0  '
      #9'begin'
      #9#9'select @TRECETADO = @TRECETADO + (@TRECETADO * @NOREFAUTO)  '
      
        #9#9'select @OTCNUMBER = MAX(OTCNUMBER) FROM OTC WHERE NUMERORECETA' +
        ' = @NORX;'
      #9'end'
      
        #9'SELECT @FECHAULTIMOREFILL = FECHAOTC FROM OTC WHERE OTCNUMBER =' +
        ' @OTCNUMBER; '
      
        #9'Update PRESCRIPTIONS set CANTIDAD_DISPONIBLE = @TRECETADO - @TD' +
        'ISPENSADO, FECHAULTIMOREFILL = @FECHAULTIMOREFILL where NUMERORE' +
        'CETA = @NORX;'
      #9'--================='
      #9'DELETE FROM RXDATA WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM CLINICAL_SEGMENT WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM CLINICAL_SEGMENT_INFO WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM PRIOR_AUTH WHERE OTCNUMBER = @OTCNUMBER;'#9
      #9'DELETE FROM FACILITY_ID WHERE OTCNUMBER = @OTCNUMBER; '
      
        #9'DELETE FROM PROCEDURE_MODIFIER_CODE WHERE OTCNUMBER = @OTCNUMBE' +
        'R;'
      #9'DELETE FROM CLINICAL_SEGMENT_INFO WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM DUR_PPS WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM COB_A WHERE OTCNUMBER = @OTCNUMBER;'
      #9'DELETE FROM COB_OTHERPAYMENT WHERE OTCNUMBER = @OTCNUMBER;'
      
        #9'DELETE FROM SUB_CLARIFICATION_CODE WHERE OTCNUMBER = @OTCNUMBER' +
        ';'
      #9'DELETE FROM DISPILL WHERE NUMERORECETA = @NORX;'
      #9'DELETE FROM Prescriptions_ByPhone WHERE RXNUM = @NORX; '
      '  commit;'
      'end;')
    Left = 496
    Top = 80
  end
