        'phere'#39', N'#39'Polymeric microspheres composed of biocompatible polym' +
        'er that contains active and/or inert ingredient(s) designed for ' +
        'release at a controlled rate.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
