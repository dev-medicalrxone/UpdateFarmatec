        'al Drop'#39', N'#39'A substance that requires reconstitution with a suit' +
        'able solvent and is intended for oral administration in a drop-w' +
        'ise fashion.'#39')'
      
        'INSERT [dbo].[NCI] ([NCItSubsetCode], [NCIt_Code], [Description]' +
