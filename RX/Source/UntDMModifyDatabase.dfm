        '                         dbo.INVENTARIOPISO ON dbo.ORDER_DETAIL.' +
        'NDC = dbo.INVENTARIOPISO.NDC INNER JOIN'
      
        '                         dbo.ORDER_HEADER ON dbo.ORDER_DETAIL.OR' +
        'DERID = dbo.ORDER_HEADER.ORDERID')
