  object OTCCONTROLADOS: TFDQuery
    Connection = FDConnection1
    SQL.Strings = (
      'CREATE VIEW [dbo].[OTCCONTROLADOS]'
      'AS'
      
        'SELECT        OTC_1.OTCNUMBER, OTC_1.NDC, OTC_1.MEDICAMENTO, OTC' +
        '_1.NUMEROTRANSACCION, OTC_1.TOTAL, OTC_1.ATENDIDOPOR, OTC_1.COBR' +
        'ADO, OTC_1.FECHAOTC, OTC_1.NUMERORECETA, OTC_1.RX, '
      
        '                         OTC_1.COSTOVENTA, OTC_1.QTY, INVENTARIO' +
        '_1.CONTROLADO'
      'FROM            dbo.OTC AS OTC_1 INNER JOIN'
      
        '                         dbo.INVENTARIOPISO AS INVENTARIO_1 ON I' +
        'NVENTARIO_1.NDC = OTC_1.NDC'
      
        'WHERE        (OTC_1.CONTROLADO <> '#39'RX'#39') AND (OTC_1.CONTROLADO <>' +
        ' '#39#39')')
    Left = 2008
